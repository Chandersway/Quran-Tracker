# Public runtime configuration; supplied from GitHub Secrets during production builds.
# These values are visible in a built mobile app. Never use a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AUDIO_BASE_URL=
# Build configuration only
EXPO_PROJECT_ID=
# Path to Firebase's Android client configuration (EAS file environment variable in cloud builds).
GOOGLE_SERVICES_JSON=
