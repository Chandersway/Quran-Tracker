{
  "name": "wirdna",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local.ps1",
    "android:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local.ps1",
    "android:compare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-compare.ps1",
    "android:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local.ps1 -EmulatorOnly",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "build:apk:cloud": "npx --yes eas-cli@27.10.0 build --platform android --profile preview",
    "build:aab": "npx --yes eas-cli@27.10.0 build --platform android --profile production",
    "build:ios": "npx --yes eas-cli@27.10.0 build --platform ios --profile production",
    "build:ios:preview": "npx --yes eas-cli@27.10.0 build --platform ios --profile preview",
    "build:status": "npx --yes eas-cli@27.10.0 build:list",
    "release:check": "node scripts/check-config.mjs --release",
    "docs:inventory": "node scripts/build-code-reference.mjs",
    "chat:check": "node scripts/check-realtime-readiness.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.{ts,mjs}\" \"plugins/*.{ts,js}\" App.tsx index.ts app.config.ts metro.config.js eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.{ts,mjs}\" \"plugins/*.{ts,js}\" App.tsx index.ts app.config.ts metro.config.js eslint.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test",
    "export": "expo export --platform all",
    "content:generate": "python scripts/prepare-content.py",
    "config:check": "node scripts/check-config.mjs"
  },
  "dependencies": {
    "@config-plugins/react-native-blob-util": "^14.0.2",
    "@config-plugins/react-native-pdf": "^14.0.2",
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/noto-kufi-arabic": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.25",
    "expo-apple-authentication": "~58.0.3",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-blob-util": "^1.1.1",
    "react-native-pdf": "7.0.5",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.1",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
