[{"sura":65,"ayah":1,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلنَّبِىُّ","translation":"Prophet","transliteration":"l-nabiyu"},{"position":3,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":4,"arabic":"طَلَّقْتُمُ","translation":"you divorce","transliteration":"ṭallaqtumu"},{"position":5,"arabic":"ٱلنِّسَآءَ","translation":"[the] women","transliteration":"l-nisāa"},{"position":6,"arabic":"فَطَلِّقُوهُنَّ","translation":"then divorce them","transliteration":"faṭalliqūhunna"},{"position":7,"arabic":"لِعِدَّتِهِنَّ","translation":"for their waiting period","transliteration":"liʿiddatihinna"},{"position":8,"arabic":"وَأَحْصُوا۟","translation":"and keep count","transliteration":"wa-aḥṣū"},{"position":9,"arabic":"ٱلْعِدَّةَ ۖ","translation":"(of) the waiting period","transliteration":"l-ʿidata"},{"position":10,"arabic":"وَٱتَّقُوا۟","translation":"and fear","transliteration":"wa-ittaqū"},{"position":11,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":12,"arabic":"رَبَّكُمْ ۖ","translation":"your Lord","transliteration":"rabbakum"},{"position":13,"arabic":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":14,"arabic":"تُخْرِجُوهُنَّ","translation":"expel them","transliteration":"tukh'rijūhunna"},{"position":15,"arabic":"مِنۢ","translation":"from","transliteration":"min"},{"position":16,"arabic":"بُيُوتِهِنَّ","translation":"their houses","transliteration":"buyūtihinna"},{"position":17,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":18,"arabic":"يَخْرُجْنَ","translation":"they should leave","transliteration":"yakhruj'na"},{"position":19,"arabic":"إِلَّآ","translation":"except","transliteration":"illā"},{"position":20,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":21,"arabic":"يَأْتِينَ","translation":"they commit","transliteration":"yatīna"},{"position":22,"arabic":"بِفَـٰحِشَةٍۢ","translation":"an immorality","transliteration":"bifāḥishatin"},{"position":23,"arabic":"مُّبَيِّنَةٍۢ ۚ","translation":"clear","transliteration":"mubayyinatin"},{"position":24,"arabic":"وَتِلْكَ","translation":"And these","transliteration":"watil'ka"},{"position":25,"arabic":"حُدُودُ","translation":"(are the) limits","transliteration":"ḥudūdu"},{"position":26,"arabic":"ٱللَّهِ ۚ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":27,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":28,"arabic":"يَتَعَدَّ","translation":"transgresses","transliteration":"yataʿadda"},{"position":29,"arabic":"حُدُودَ","translation":"(the) limits","transliteration":"ḥudūda"},{"position":30,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":31,"arabic":"فَقَدْ","translation":"then certainly","transliteration":"faqad"},{"position":32,"arabic":"ظَلَمَ","translation":"he has wronged","transliteration":"ẓalama"},{"position":33,"arabic":"نَفْسَهُۥ ۚ","translation":"himself","transliteration":"nafsahu"},{"position":34,"arabic":"لَا","translation":"Not","transliteration":"lā"},{"position":35,"arabic":"تَدْرِى","translation":"you know","transliteration":"tadrī"},{"position":36,"arabic":"لَعَلَّ","translation":"Perhaps","transliteration":"laʿalla"},{"position":37,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":38,"arabic":"يُحْدِثُ","translation":"will bring about","transliteration":"yuḥ'dithu"},{"position":39,"arabic":"بَعْدَ","translation":"after","transliteration":"baʿda"},{"position":40,"arabic":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":41,"arabic":"أَمْرًۭا","translation":"a matter","transliteration":"amran"}],"e3rab":"(يا أَيُّهَا) يا حرف نداء ومنادى نكرة مقصودة وها للتنبيه (النَّبِيُّ) بدل (إِذا) ظرفية شرطية غير جازمة (طَلَّقْتُمُ النِّساءَ) ماض وفاعله ومفعوله والجملة في محل جر بالإضافة (فَطَلِّقُوهُنَّ) الفاء رابطة وأمر وفاعله ومفعوله والجملة جواب الشرط لا محل لها (لِعِدَّتِهِنَّ) متعلقان بمحذوف حال (وَأَحْصُوا الْعِدَّةَ) أمر وفاعله ومفعوله والجملة معطوفة على ما قبلها (وَاتَّقُوا اللَّهَ) أمر وفاعله ومفعوله والجملة معطوفة على ما قبلها (رَبَّكُمْ) بدل (لا تُخْرِجُوهُنَّ) مضارع مجزوم بلا الناهية والواو فاعله والهاء مفعول به (مِنْ بُيُوتِهِنَّ) متعلقان بالفعل والجملة استئنافية لا محل لها (وَلا يَخْرُجْنَ) مضارع مبني على السكون لاتصاله بنون النسوة وهو في محل جزم بلا الناهية والنون فاعله والجملة معطوفة على ما قبلها (إِلَّا) حرف حصر (أَنْ يَأْتِينَ) مضارع مبني على السكون في محل نصب بأن والمصدر المؤول من أن والفعل في محل نصب حال (بِفاحِشَةٍ) متعلقان بالفعل (مُبَيِّنَةٍ) صفة (وَتِلْكَ حُدُودُ اللَّهِ) مبتدأ وخبره ولفظ الجلالة مضاف إليه والجملة استئنافية لا محل لها (وَ) الواو حرف استئناف (مِنْ) اسم شرط مبتدأ (يَتَعَدَّ) مضارع مجزوم لأنه فعل الشرط وعلامة جزمه حذف حرف العلة والفاعل مستتر (حُدُودُ اللَّهِ) مفعول به مضاف إلى لفظ الجلالة (فَقَدْ) الفاء رابطة (قد ظَلَمَ) حرف تحقيق وماض فاعله مستتر (نَفْسَهُ) مفعول به والجملة في محل جزم جواب الشرط وجملتا الشرط والجواب خبر المبتدأ من وجملة من..\r\n\r\nاستئنافية لا محل لها (لا) نافية (تَدْرِي) مضارع فاعله مستتر (لَعَلَّ اللَّهَ يُحْدِثُ) لعل واسمها لفظ الجلالة ومضارع فاعله مستتر والجملة خبر لعل (بَعْدَ ذلِكَ) ظرف زمان واسم إشارة في محل جر بالإضافة (أَمْراً) مفعول به والجملة الاسمية سدت مسد مفعولي تدري وجملة تدري استئنافية لا محل لها.\r\n\r\n"},{"sura":65,"ayah":2,"words":[{"position":1,"arabic":"فَإِذَا","translation":"Then when","transliteration":"fa-idhā"},{"position":2,"arabic":"بَلَغْنَ","translation":"they have reached","transliteration":"balaghna"},{"position":3,"arabic":"أَجَلَهُنَّ","translation":"their term","transliteration":"ajalahunna"},{"position":4,"arabic":"فَأَمْسِكُوهُنَّ","translation":"then retain them","transliteration":"fa-amsikūhunna"},{"position":5,"arabic":"بِمَعْرُوفٍ","translation":"with kindness","transliteration":"bimaʿrūfin"},{"position":6,"arabic":"أَوْ","translation":"or","transliteration":"aw"},{"position":7,"arabic":"فَارِقُوهُنَّ","translation":"part with them","transliteration":"fāriqūhunna"},{"position":8,"arabic":"بِمَعْرُوفٍۢ","translation":"with kindness","transliteration":"bimaʿrūfin"},{"position":9,"arabic":"وَأَشْهِدُوا۟","translation":"And take witness","transliteration":"wa-ashhidū"},{"position":10,"arabic":"ذَوَىْ","translation":"two men","transliteration":"dhaway"},{"position":11,"arabic":"عَدْلٍۢ","translation":"just","transliteration":"ʿadlin"},{"position":12,"arabic":"مِّنكُمْ","translation":"among you","transliteration":"minkum"},{"position":13,"arabic":"وَأَقِيمُوا۟","translation":"and establish","transliteration":"wa-aqīmū"},{"position":14,"arabic":"ٱلشَّهَـٰدَةَ","translation":"the testimony","transliteration":"l-shahādata"},{"position":15,"arabic":"لِلَّهِ ۚ","translation":"for Allah","transliteration":"lillahi"},{"position":16,"arabic":"ذَٰلِكُمْ","translation":"That","transliteration":"dhālikum"},{"position":17,"arabic":"يُوعَظُ","translation":"is instructed","transliteration":"yūʿaẓu"},{"position":18,"arabic":"بِهِۦ","translation":"with it","transliteration":"bihi"},{"position":19,"arabic":"مَن","translation":"whoever","transliteration":"man"},{"position":20,"arabic":"كَانَ","translation":"[is]","transliteration":"kāna"},{"position":21,"arabic":"يُؤْمِنُ","translation":"believes","transliteration":"yu'minu"},{"position":22,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":23,"arabic":"وَٱلْيَوْمِ","translation":"and the Day","transliteration":"wal-yawmi"},{"position":24,"arabic":"ٱلْـَٔاخِرِ ۚ","translation":"the Last","transliteration":"l-ākhiri"},{"position":25,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":26,"arabic":"يَتَّقِ","translation":"fears","transliteration":"yattaqi"},{"position":27,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":28,"arabic":"يَجْعَل","translation":"He will make","transliteration":"yajʿal"},{"position":29,"arabic":"لَّهُۥ","translation":"for him","transliteration":"lahu"},{"position":30,"arabic":"مَخْرَجًۭا","translation":"a way out","transliteration":"makhrajan"}],"e3rab":"(فَإِذا) الفاء حرف استئناف وإذا ظرفية شرطية غير جازمة (بَلَغْنَ أَجَلَهُنَّ) ماض وفاعله ومفعوله والجملة في محل جر بالإضافة (فَأَمْسِكُوهُنَّ) الفاء رابطة وأمر وفاعله ومفعوله (بِمَعْرُوفٍ) متعلقان بالفعل والجملة جواب الشرط لا محل لها (أَوْ فارِقُوهُنَّ بِمَعْرُوفٍ) معطوف على ما قبله (وَأَشْهِدُوا) أمر وفاعله (ذَوَيْ) مفعول به منصوب بالياء (عَدْلٍ) مضاف إليه والجملة معطوفة على ما قبلها (مِنْكُمْ) صفة ذوي (وَأَقِيمُوا الشَّهادَةَ) معطوف على ما قبله (لِلَّهِ) متعلقان بالفعل (ذلِكُمْ) اسم إشارة مبتدأ (يُوعَظُ) مضارع مبني للمجهول (بِهِ) متعلقان بالفعل (مَنْ) نائب فاعل والجملة خبر المبتدأ والجملة الاسمية استئنافية لا محل لها (كانَ) كان واسمها المستتر (يُؤْمِنُ) مضارع فاعله مستتر (بِاللَّهِ) متعلقان بالفعل والجملة الفعلية خبر كان وجملة كان صلة من (وَالْيَوْمِ) معطوف على ما قبله (الْآخِرِ) صفة اليوم (وَ) الواو حرف استئناف (مَنْ) اسم شرط مبتدأ (يَتَّقِ اللَّهَ) مضارع مجزوم لأنه فعل الشرط والفاعل مستتر ولفظ الجلالة مفعول به (يَجْعَلْ) مضارع مجزوم لأنه جواب الشرط (لَهُ) متعلقان بالفعل (مَخْرَجاً) مفعول به والجملة جواب الشرط لا محل لها وجملتا الشرط والجواب خبر من وجملة من.. استئنافية لا محل لها.\r\n\r\n"},{"sura":65,"ayah":3,"words":[{"position":1,"arabic":"وَيَرْزُقْهُ","translation":"And He will provide for him","transliteration":"wayarzuq'hu"},{"position":2,"arabic":"مِنْ","translation":"from","transliteration":"min"},{"position":3,"arabic":"حَيْثُ","translation":"where","transliteration":"ḥaythu"},{"position":4,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":5,"arabic":"يَحْتَسِبُ ۚ","translation":"he thinks","transliteration":"yaḥtasibu"},{"position":6,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":7,"arabic":"يَتَوَكَّلْ","translation":"puts his trust","transliteration":"yatawakkal"},{"position":8,"arabic":"عَلَى","translation":"upon","transliteration":"ʿalā"},{"position":9,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":10,"arabic":"فَهُوَ","translation":"then He","transliteration":"fahuwa"},{"position":11,"arabic":"حَسْبُهُۥٓ ۚ","translation":"(is) sufficient for him","transliteration":"ḥasbuhu"},{"position":12,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":13,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":14,"arabic":"بَـٰلِغُ","translation":"(will) accomplish","transliteration":"bālighu"},{"position":15,"arabic":"أَمْرِهِۦ ۚ","translation":"His purpose","transliteration":"amrihi"},{"position":16,"arabic":"قَدْ","translation":"Indeed","transliteration":"qad"},{"position":17,"arabic":"جَعَلَ","translation":"has set","transliteration":"jaʿala"},{"position":18,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":19,"arabic":"لِكُلِّ","translation":"for every","transliteration":"likulli"},{"position":20,"arabic":"شَىْءٍۢ","translation":"thing","transliteration":"shayin"},{"position":21,"arabic":"قَدْرًۭا","translation":"a measure","transliteration":"qadran"}],"e3rab":"(وَيَرْزُقْهُ) معطوف على يجعل مجزوم مثله والهاء مفعول به (مِنْ حَيْثُ) متعلقان بالفعل (لا) نافية (يَحْتَسِبُ) مضارع فاعله مستتر والجملة في محل جر بالإضافة (وَ) الواو حرف عطف (مِنْ) اسم شرط مبتدأ (يَتَوَكَّلْ) مضارع مجزوم لأنه فعل الشرط (عَلَى اللَّهِ) متعلقان بالفعل (فَهُوَ حَسْبُهُ) الفاء رابطة ومبتدأ وخبره والجملة في محل جزم جواب الشرط وجملتا الشرط والجواب خبر من وجملة من..\r\n\r\nمعطوفة على ما قبلها (إِنَّ اللَّهَ بالِغُ) إن واسمها وخبرها (أَمْرِهِ) مضاف إليه والجملة استئنافية لا محل لها (قَدْ جَعَلَ اللَّهُ) قد حرف تحقيق وماض وفاعله (لِكُلِّ) متعلقان بالفعل (شَيْءٍ) مضاف إليه (قَدْراً) مفعول به والجملة حال.\r\n\r\n"},{"sura":65,"ayah":4,"words":[{"position":1,"arabic":"وَٱلَّـٰٓـِٔى","translation":"And those who","transliteration":"wa-allāī"},{"position":2,"arabic":"يَئِسْنَ","translation":"have despaired","transliteration":"ya-is'na"},{"position":3,"arabic":"مِنَ","translation":"of","transliteration":"mina"},{"position":4,"arabic":"ٱلْمَحِيضِ","translation":"the menstruation","transliteration":"l-maḥīḍi"},{"position":5,"arabic":"مِن","translation":"among","transliteration":"min"},{"position":6,"arabic":"نِّسَآئِكُمْ","translation":"your women","transliteration":"nisāikum"},{"position":7,"arabic":"إِنِ","translation":"if","transliteration":"ini"},{"position":8,"arabic":"ٱرْتَبْتُمْ","translation":"you doubt","transliteration":"ir'tabtum"},{"position":9,"arabic":"فَعِدَّتُهُنَّ","translation":"then their waiting period","transliteration":"faʿiddatuhunna"},{"position":10,"arabic":"ثَلَـٰثَةُ","translation":"(is) three","transliteration":"thalāthatu"},{"position":11,"arabic":"أَشْهُرٍۢ","translation":"months","transliteration":"ashhurin"},{"position":12,"arabic":"وَٱلَّـٰٓـِٔى","translation":"and the ones who","transliteration":"wa-allāī"},{"position":13,"arabic":"لَمْ","translation":"not","transliteration":"lam"},{"position":14,"arabic":"يَحِضْنَ ۚ","translation":"[they] menstruated","transliteration":"yaḥiḍ'na"},{"position":15,"arabic":"وَأُو۟لَـٰتُ","translation":"And those who (are)","transliteration":"wa-ulātu"},{"position":16,"arabic":"ٱلْأَحْمَالِ","translation":"pregnant","transliteration":"l-aḥmāli"},{"position":17,"arabic":"أَجَلُهُنَّ","translation":"their term","transliteration":"ajaluhunna"},{"position":18,"arabic":"أَن","translation":"until","transliteration":"an"},{"position":19,"arabic":"يَضَعْنَ","translation":"they deliver","transliteration":"yaḍaʿna"},{"position":20,"arabic":"حَمْلَهُنَّ ۚ","translation":"their burdens","transliteration":"ḥamlahunna"},{"position":21,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":22,"arabic":"يَتَّقِ","translation":"fears","transliteration":"yattaqi"},{"position":23,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":24,"arabic":"يَجْعَل","translation":"He will make","transliteration":"yajʿal"},{"position":25,"arabic":"لَّهُۥ","translation":"for him","transliteration":"lahu"},{"position":26,"arabic":"مِنْ","translation":"of","transliteration":"min"},{"position":27,"arabic":"أَمْرِهِۦ","translation":"his affair","transliteration":"amrihi"},{"position":28,"arabic":"يُسْرًۭا","translation":"ease","transliteration":"yus'ran"}],"e3rab":"(وَاللَّائِي) الواو حرف استئناف واسم الموصول مبتدأ (يَئِسْنَ) مضارع وفاعله والجملة صلة (مِنَ الْمَحِيضِ) متعلقان بالفعل (مِنْ نِسائِكُمْ) متعلقان بمحذوف حال (إِنِ ارْتَبْتُمْ) إن حرف شرط جازم وماض وفاعله والجملة ابتدائية لا محل لها (فَعِدَّتُهُنَّ) الفاء رابطة (عدتهن ثَلاثَةُ) مبتدأ وخبره (أَشْهُرٍ) مضاف إليه والجملة في محل جزم جواب الشرط وجملتا الشرط والجواب خبر المبتدأ اللائي وجملة اللائي.. استئنافية لا محل لها (وَاللَّائِي لَمْ يَحِضْنَ) مبتدأ ومضارع مجزوم بلم والنون فاعله والجملة صلة وخبر المبتدأ محذوف والجملة الاسمية معطوفة على ما قبلها، (وَ) الواو حرف استئناف (أُولاتُ) مبتدأ (الْأَحْمالِ) مضاف إليه (أَجَلُهُنَّ) مبتدأ (أَنْ يَضَعْنَ) مضارع مبني على السكون في محل نصب بأن ونون النسوة فاعله (حَمْلَهُنَّ) مفعول به والمصدر المؤول من أن والفعل في محل رفع خبر أجلهن والجملة الاسمية أجلهن..\r\n\r\nخبر أولات.\r\n\r\n(وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مِنْ أَمْرِهِ يُسْراً): سبق إعرابها.\r\n\r\n"},{"sura":65,"ayah":5,"words":[{"position":1,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":2,"arabic":"أَمْرُ","translation":"(is the) Command","transliteration":"amru"},{"position":3,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":4,"arabic":"أَنزَلَهُۥٓ","translation":"which He has sent down","transliteration":"anzalahu"},{"position":5,"arabic":"إِلَيْكُمْ ۚ","translation":"to you","transliteration":"ilaykum"},{"position":6,"arabic":"وَمَن","translation":"and whoever","transliteration":"waman"},{"position":7,"arabic":"يَتَّقِ","translation":"fears","transliteration":"yattaqi"},{"position":8,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":9,"arabic":"يُكَفِّرْ","translation":"He will remove","transliteration":"yukaffir"},{"position":10,"arabic":"عَنْهُ","translation":"from him","transliteration":"ʿanhu"},{"position":11,"arabic":"سَيِّـَٔاتِهِۦ","translation":"his evil deeds","transliteration":"sayyiātihi"},{"position":12,"arabic":"وَيُعْظِمْ","translation":"and make great","transliteration":"wayuʿ'ẓim"},{"position":13,"arabic":"لَهُۥٓ","translation":"for him","transliteration":"lahu"},{"position":14,"arabic":"أَجْرًا","translation":"(his) reward","transliteration":"ajran"}],"e3rab":"(ذلِكَ أَمْرُ اللَّهِ) مبتدأ وخبره ولفظ الجلالة مضاف إليه والجملة استئنافية لا محل لها (أَنْزَلَهُ) ماض ومفعوله والفاعل مستتر (إِلَيْكُمْ) متعلقان بالفعل والجملة حال، (وَ) الواو حرف استئناف (مَنْ) اسم شرط جازم مبتدأ (يَتَّقِ اللَّهَ) مضارع مجزوم لأنه فعل الشرط وفاعله مستتر ولفظ الجلالة مفعول به (يُكَفِّرْ) مضارع مجزوم لأنه جواب الشرط فاعله مستتر (عَنْهُ) متعلقان بالفعل (سَيِّئاتِهِ) مفعول به والجملة جواب الشرط لا محل لها وجملتا الشرط والجواب خبر المبتدأ من وجملة من.. استئنافية لا محل لها (وَيُعْظِمْ) معطوف على يكفر (لَهُ) متعلقان بالفعل (أَجْراً) مفعول به.\r\n\r\n"},{"sura":65,"ayah":6,"words":[{"position":1,"arabic":"أَسْكِنُوهُنَّ","translation":"Lodge them","transliteration":"askinūhunna"},{"position":2,"arabic":"مِنْ","translation":"from","transliteration":"min"},{"position":3,"arabic":"حَيْثُ","translation":"where","transliteration":"ḥaythu"},{"position":4,"arabic":"سَكَنتُم","translation":"you dwell","transliteration":"sakantum"},{"position":5,"arabic":"مِّن","translation":"(out) of","transliteration":"min"},{"position":6,"arabic":"وُجْدِكُمْ","translation":"your means","transliteration":"wuj'dikum"},{"position":7,"arabic":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":8,"arabic":"تُضَآرُّوهُنَّ","translation":"harm them","transliteration":"tuḍārrūhunna"},{"position":9,"arabic":"لِتُضَيِّقُوا۟","translation":"to distress","transliteration":"lituḍayyiqū"},{"position":10,"arabic":"عَلَيْهِنَّ ۚ","translation":"[on] them","transliteration":"ʿalayhinna"},{"position":11,"arabic":"وَإِن","translation":"And if","transliteration":"wa-in"},{"position":12,"arabic":"كُنَّ","translation":"they are","transliteration":"kunna"},{"position":13,"arabic":"أُو۟لَـٰتِ","translation":"those (who are)","transliteration":"ulāti"},{"position":14,"arabic":"حَمْلٍۢ","translation":"pregnant","transliteration":"ḥamlin"},{"position":15,"arabic":"فَأَنفِقُوا۟","translation":"then spend","transliteration":"fa-anfiqū"},{"position":16,"arabic":"عَلَيْهِنَّ","translation":"on them","transliteration":"ʿalayhinna"},{"position":17,"arabic":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":18,"arabic":"يَضَعْنَ","translation":"they deliver","transliteration":"yaḍaʿna"},{"position":19,"arabic":"حَمْلَهُنَّ ۚ","translation":"their burden","transliteration":"ḥamlahunna"},{"position":20,"arabic":"فَإِنْ","translation":"Then if","transliteration":"fa-in"},{"position":21,"arabic":"أَرْضَعْنَ","translation":"they suckle","transliteration":"arḍaʿna"},{"position":22,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":23,"arabic":"فَـَٔاتُوهُنَّ","translation":"then give them","transliteration":"faātūhunna"},{"position":24,"arabic":"أُجُورَهُنَّ ۖ","translation":"their payment","transliteration":"ujūrahunna"},{"position":25,"arabic":"وَأْتَمِرُوا۟","translation":"and consult","transliteration":"watamirū"},{"position":26,"arabic":"بَيْنَكُم","translation":"among yourselves","transliteration":"baynakum"},{"position":27,"arabic":"بِمَعْرُوفٍۢ ۖ","translation":"with kindness","transliteration":"bimaʿrūfin"},{"position":28,"arabic":"وَإِن","translation":"but if","transliteration":"wa-in"},{"position":29,"arabic":"تَعَاسَرْتُمْ","translation":"you disagree","transliteration":"taʿāsartum"},{"position":30,"arabic":"فَسَتُرْضِعُ","translation":"then may suckle","transliteration":"fasatur'ḍiʿu"},{"position":31,"arabic":"لَهُۥٓ","translation":"for him","transliteration":"lahu"},{"position":32,"arabic":"أُخْرَىٰ","translation":"another (women)","transliteration":"ukh'rā"}],"e3rab":"(أَسْكِنُوهُنَّ) أمر وفاعله ومفعوله (مِنْ حَيْثُ) متعلقان بالفعل (سَكَنْتُمْ) ماض وفاعله والجملة في محل جر بالإضافة (مِنْ وُجْدِكُمْ) بدل من قوله من حيث (وَلا تُضآرُّوهُنَّ) الواو حرف عطف ومضارع مجزوم بلا الناهية وعلامة جزمه حذف النون والواو فاعله والهاء مفعوله والجملة معطوفة على ما قبلها (لِتُضَيِّقُوا) مضارع منصوب بأن مضمرة بعد لام التعليل والواو فاعله والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بالفعل (عَلَيْهِنَّ) متعلقان بالفعل أيضا (وَ) الواو حرف عطف (إِنْ كُنَّ) إن شرطية جازمة وماض ناقص واسمه (أُولاتِ حَمْلٍ) خبره المضاف إلى حمل والجملة ابتدائية لا محل لها (فَأَنْفِقُوا) الفاء رابطة وأمر وفاعله (عَلَيْهِنَّ) متعلقان بالفعل والجملة في محل جزم جواب الشرط (حَتَّى يَضَعْنَ) حتى حرف غاية وجر ومضارع مبني على السكون في محل نصب بأن المضمرة بعد حتى ونون النسوة فاعل والمصدر المؤول من أن والفعل في محل جر بحتى والجار والمجرور متعلقان بالفعل (حَمْلَهُنَّ) مفعول به (فَإِنْ) الفاء حرف عطف (إِنْ) شرطية جازمة (أَرْضَعْنَ) ماض مبني على السكون ونون النسوة فاعله (لَكُمْ) متعلقان بالفعل والجملة ابتدائية لا محل لها (فَآتُوهُنَّ) الفاء رابطة وأمر وفاعله ومفعوله الأول (أُجُورَهُنَّ) مفعول به ثان والجملة في محل جزم جواب الشرط (وَأْتَمِرُوا) الواو حرف عطف وأمر فاعله والجملة معطوفة على ما قبلها (بَيْنَكُمْ) ظرف مكان (بِمَعْرُوفٍ) متعلقان بالفعل (وَإِنْ) شرطية جازمة (تَعاسَرْتُمْ) ماض وفاعله وهو في محل جزم فعل شرط والجملة ابتدائية لا محل لها (فَسَتُرْضِعُ) الفاء رابطة والسين للاستقبال ومضارع مرفوع والجملة في محل جزم جواب الشرط (لَهُ) متعلقان بالفعل (أُخْرى) فاعل.\r\n\r\n"},{"sura":65,"ayah":7,"words":[{"position":1,"arabic":"لِيُنفِقْ","translation":"Let spend","transliteration":"liyunfiq"},{"position":2,"arabic":"ذُو","translation":"owner","transliteration":"dhū"},{"position":3,"arabic":"سَعَةٍۢ","translation":"(of) ample means","transliteration":"saʿatin"},{"position":4,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":5,"arabic":"سَعَتِهِۦ ۖ","translation":"his ample means","transliteration":"saʿatihi"},{"position":6,"arabic":"وَمَن","translation":"and (he) who","transliteration":"waman"},{"position":7,"arabic":"قُدِرَ","translation":"is restricted","transliteration":"qudira"},{"position":8,"arabic":"عَلَيْهِ","translation":"on him","transliteration":"ʿalayhi"},{"position":9,"arabic":"رِزْقُهُۥ","translation":"his provision","transliteration":"riz'quhu"},{"position":10,"arabic":"فَلْيُنفِقْ","translation":"let him spend","transliteration":"falyunfiq"},{"position":11,"arabic":"مِمَّآ","translation":"from what","transliteration":"mimmā"},{"position":12,"arabic":"ءَاتَىٰهُ","translation":"he has been given","transliteration":"ātāhu"},{"position":13,"arabic":"ٱللَّهُ ۚ","translation":"(by) Allah","transliteration":"l-lahu"},{"position":14,"arabic":"لَا","translation":"Does not","transliteration":"lā"},{"position":15,"arabic":"يُكَلِّفُ","translation":"burden","transliteration":"yukallifu"},{"position":16,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":17,"arabic":"نَفْسًا","translation":"any soul","transliteration":"nafsan"},{"position":18,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":19,"arabic":"مَآ","translation":"(with) what","transliteration":"mā"},{"position":20,"arabic":"ءَاتَىٰهَا ۚ","translation":"He has given it","transliteration":"ātāhā"},{"position":21,"arabic":"سَيَجْعَلُ","translation":"Will bring about","transliteration":"sayajʿalu"},{"position":22,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":23,"arabic":"بَعْدَ","translation":"after","transliteration":"baʿda"},{"position":24,"arabic":"عُسْرٍۢ","translation":"hardship","transliteration":"ʿus'rin"},{"position":25,"arabic":"يُسْرًۭا","translation":"ease","transliteration":"yus'ran"}],"e3rab":"(لِيُنْفِقْ) مضارع مجزوم بلام الأمر (ذُو سَعَةٍ) فاعل مضاف إلى سعة والجملة استئنافية لا محل لها (مِنْ سَعَتِهِ) متعلقان بالفعل (وَ) الواو حرف عطف (مِنْ) اسم شرط مبتدأ (قُدِرَ) ماض مبني للمجهول في محل جزم فعل الشرط (عَلَيْهِ) متعلقان بالفعل (رِزْقُهُ) نائب فاعل (فَلْيُنْفِقْ) الفاء رابطة ومضارع مجزوم بلام الأمر والجملة في محل جزم جواب الشرط وجملتا الشرط والجواب خبر من وجملة من..\r\n\r\nمعطوفة على ما قبلها.\r\n\r\n(مِمَّا) متعلقان بالفعل (آتاهُ اللَّهُ) ماض ومفعوله ولفظ الجلالة فاعله والجملة صلة (لا يُكَلِّفُ اللَّهُ) لا نافية ومضارع وفاعله (نَفْساً) مفعوله والجملة استئنافية لا محل لها (إِلَّا) حرف حصر (ما) مفعول به ثان (آتاها) ماض ومفعوله والفاعل مستتر والجملة صلة ما لا محل لها.\r\n\r\n(سَيَجْعَلُ اللَّهُ) السين للاستقبال ومضارع ولفظ الجلالة فاعله والجملة مستأنفة لا محل لها (بَعْدَ عُسْرٍ) ظرف زمان مضاف إلى عسر (يُسْراً) مفعول به.\r\n\r\n"},{"sura":65,"ayah":8,"words":[{"position":1,"arabic":"وَكَأَيِّن","translation":"And how many","transliteration":"waka-ayyin"},{"position":2,"arabic":"مِّن","translation":"of","transliteration":"min"},{"position":3,"arabic":"قَرْيَةٍ","translation":"a town","transliteration":"qaryatin"},{"position":4,"arabic":"عَتَتْ","translation":"rebelled","transliteration":"ʿatat"},{"position":5,"arabic":"عَنْ","translation":"against","transliteration":"ʿan"},{"position":6,"arabic":"أَمْرِ","translation":"(the) Command","transliteration":"amri"},{"position":7,"arabic":"رَبِّهَا","translation":"(of) its Lord","transliteration":"rabbihā"},{"position":8,"arabic":"وَرُسُلِهِۦ","translation":"and His Messengers","transliteration":"warusulihi"},{"position":9,"arabic":"فَحَاسَبْنَـٰهَا","translation":"so We took it to account","transliteration":"faḥāsabnāhā"},{"position":10,"arabic":"حِسَابًۭا","translation":"an account","transliteration":"ḥisāban"},{"position":11,"arabic":"شَدِيدًۭا","translation":"severe","transliteration":"shadīdan"},{"position":12,"arabic":"وَعَذَّبْنَـٰهَا","translation":"and We punished it","transliteration":"waʿadhabnāhā"},{"position":13,"arabic":"عَذَابًۭا","translation":"a punishment","transliteration":"ʿadhāban"},{"position":14,"arabic":"نُّكْرًۭا","translation":"terrible","transliteration":"nuk'ran"}],"e3rab":"(وَ) الواو حرف استئناف (كَأَيِّنْ) اسم كناية بمعنى كثير مبني على السكون في محل رفع مبتدأ (مِنْ) حرف جر زائد (قَرْيَةٍ) تمييز (عَتَتْ) ماض وفاعله مستتر والجملة الفعلية خبر المبتدأ والجملة الاسمية استئنافية لا محل لها (عَنْ أَمْرِ) متعلقان بالفعل (رَبِّها) مضاف إليه (وَرُسُلِهِ) معطوف على ما قبلها، (فَحاسَبْناها) الفاء حرف عطف وماض وفاعله ومفعوله (حِساباً) مفعول مطلق (شَدِيداً) صفة (وَعَذَّبْناها عَذاباً نُكْراً) معطوف على ما قبله.\r\n\r\n"},{"sura":65,"ayah":9,"words":[{"position":1,"arabic":"فَذَاقَتْ","translation":"So it tasted","transliteration":"fadhāqat"},{"position":2,"arabic":"وَبَالَ","translation":"(the bad) consequence","transliteration":"wabāla"},{"position":3,"arabic":"أَمْرِهَا","translation":"(of) its affair","transliteration":"amrihā"},{"position":4,"arabic":"وَكَانَ","translation":"and was","transliteration":"wakāna"},{"position":5,"arabic":"عَـٰقِبَةُ","translation":"(the) end","transliteration":"ʿāqibatu"},{"position":6,"arabic":"أَمْرِهَا","translation":"(of) its affair","transliteration":"amrihā"},{"position":7,"arabic":"خُسْرًا","translation":"loss","transliteration":"khus'ran"}],"e3rab":"(فَذاقَتْ) الفاء حرف عطف وماض فاعله مستتر (وَبالَ) مفعول به والجملة معطوفة على ما قبلها (أَمْرِها) مضاف إليه (وَكانَ عاقِبَةُ) الواو حرف عطف وكان واسمها (أَمْرِها) مضاف إليه (خُسْراً) خبر كان والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":65,"ayah":10,"words":[{"position":1,"arabic":"أَعَدَّ","translation":"Has prepared","transliteration":"aʿadda"},{"position":2,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":3,"arabic":"لَهُمْ","translation":"for them","transliteration":"lahum"},{"position":4,"arabic":"عَذَابًۭا","translation":"a punishment","transliteration":"ʿadhāban"},{"position":5,"arabic":"شَدِيدًۭا ۖ","translation":"severe","transliteration":"shadīdan"},{"position":6,"arabic":"فَٱتَّقُوا۟","translation":"So fear","transliteration":"fa-ittaqū"},{"position":7,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":8,"arabic":"يَـٰٓأُو۟لِى","translation":"O men","transliteration":"yāulī"},{"position":9,"arabic":"ٱلْأَلْبَـٰبِ","translation":"(of) understanding","transliteration":"l-albābi"},{"position":10,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":11,"arabic":"ءَامَنُوا۟ ۚ","translation":"have believed","transliteration":"āmanū"},{"position":12,"arabic":"قَدْ","translation":"Indeed","transliteration":"qad"},{"position":13,"arabic":"أَنزَلَ","translation":"Has sent down","transliteration":"anzala"},{"position":14,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":15,"arabic":"إِلَيْكُمْ","translation":"to you","transliteration":"ilaykum"},{"position":16,"arabic":"ذِكْرًۭا","translation":"a Message","transliteration":"dhik'ran"}],"e3rab":"(أَعَدَّ اللَّهُ) ماض وفاعله (لَهُمْ) متعلقان بالفعل والجملة استئنافية لا محل لها (عَذاباً) مفعول به (شَدِيداً) صفة (فَاتَّقُوا اللَّهَ) الفاء الفصيحة وأمر وفاعله ولفظ الجلالة مفعول به والجملة جواب شرط مقدر لا محل لها.\r\n\r\n(يا أُولِي) يا حرف نداء ومنادى مضاف (الْأَلْبابِ) مضاف إليه (الَّذِينَ) بدل (آمَنُوا) ماض وفاعله (قَدْ) حرف تحقيق والجملة صلة (أَنْزَلَ اللَّهُ) ماض وفاعله (إِلَيْكُمْ) متعلقان بالفعل (ذِكْراً) مفعول به والجملة حال.\r\n\r\n"},{"sura":65,"ayah":11,"words":[{"position":1,"arabic":"رَّسُولًۭا","translation":"A Messenger","transliteration":"rasūlan"},{"position":2,"arabic":"يَتْلُوا۟","translation":"reciting","transliteration":"yatlū"},{"position":3,"arabic":"عَلَيْكُمْ","translation":"to you","transliteration":"ʿalaykum"},{"position":4,"arabic":"ءَايَـٰتِ","translation":"(the) Verses","transliteration":"āyāti"},{"position":5,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":6,"arabic":"مُبَيِّنَـٰتٍۢ","translation":"clear","transliteration":"mubayyinātin"},{"position":7,"arabic":"لِّيُخْرِجَ","translation":"that he may bring out","transliteration":"liyukh'rija"},{"position":8,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":9,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":10,"arabic":"وَعَمِلُوا۟","translation":"and do","transliteration":"waʿamilū"},{"position":11,"arabic":"ٱلصَّـٰلِحَـٰتِ","translation":"righteous deeds","transliteration":"l-ṣāliḥāti"},{"position":12,"arabic":"مِنَ","translation":"from","transliteration":"mina"},{"position":13,"arabic":"ٱلظُّلُمَـٰتِ","translation":"the darkness[es]","transliteration":"l-ẓulumāti"},{"position":14,"arabic":"إِلَى","translation":"towards","transliteration":"ilā"},{"position":15,"arabic":"ٱلنُّورِ ۚ","translation":"the light","transliteration":"l-nūri"},{"position":16,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":17,"arabic":"يُؤْمِنۢ","translation":"believes","transliteration":"yu'min"},{"position":18,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":19,"arabic":"وَيَعْمَلْ","translation":"and does","transliteration":"wayaʿmal"},{"position":20,"arabic":"صَـٰلِحًۭا","translation":"righteous deeds","transliteration":"ṣāliḥan"},{"position":21,"arabic":"يُدْخِلْهُ","translation":"He will admit him","transliteration":"yud'khil'hu"},{"position":22,"arabic":"جَنَّـٰتٍۢ","translation":"(into) Gardens","transliteration":"jannātin"},{"position":23,"arabic":"تَجْرِى","translation":"flow","transliteration":"tajrī"},{"position":24,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":25,"arabic":"تَحْتِهَا","translation":"underneath it","transliteration":"taḥtihā"},{"position":26,"arabic":"ٱلْأَنْهَـٰرُ","translation":"the rivers","transliteration":"l-anhāru"},{"position":27,"arabic":"خَـٰلِدِينَ","translation":"abiding","transliteration":"khālidīna"},{"position":28,"arabic":"فِيهَآ","translation":"therein","transliteration":"fīhā"},{"position":29,"arabic":"أَبَدًۭا ۖ","translation":"forever","transliteration":"abadan"},{"position":30,"arabic":"قَدْ","translation":"Indeed","transliteration":"qad"},{"position":31,"arabic":"أَحْسَنَ","translation":"Has been (granted) good","transliteration":"aḥsana"},{"position":32,"arabic":"ٱللَّهُ","translation":"(by) Allah","transliteration":"l-lahu"},{"position":33,"arabic":"لَهُۥ","translation":"for him","transliteration":"lahu"},{"position":34,"arabic":"رِزْقًا","translation":"provision","transliteration":"riz'qan"}],"e3rab":"(رَسُولًا) مفعول به ولفعل محذوف (يَتْلُوا) مضارع فاعله مستتر والجملة صفة رسولا (عَلَيْكُمْ) متعلقان بالفعل (آياتِ اللَّهِ) مفعول به مضاف إلى لفظ الجلالة (مُبَيِّناتٍ) صفة (لِيُخْرِجَ) مضارع منصوب بأن مضمرة بعد لام التعليل والفاعل مستتر والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بيتلو (الَّذِينَ) مفعول به (آمَنُوا) ماض وفاعله والجملة صلة (وَعَمِلُوا) معطوف على آمنوا (الصَّالِحاتِ) مفعول به (مِنَ الظُّلُماتِ) متعلقان بيخرج (إِلَى النُّورِ) متعلقان بيخرج أيضا (وَ) الواو حرف استئناف (مِنَ) اسم شرط جازم مبتدأ (يُؤْمِنْ) مضارع مجزوم لأنه فعل الشرط والفاعل مستتر (بِاللَّهِ) متعلقان بالفعل (وَيَعْمَلْ) معطوف على يؤمن (صالِحاً) صفة مفعول مطلق محذوف التقدير ويعمل عملا صالحا.\r\n\r\n(يُدْخِلْهُ) مضارع مجزوم لأنه جواب الشرط والفاعل مستتر والهاء مفعول به أول (جَنَّاتٍ) مفعول به ثان والجملة جواب الشرط لا محل لها وجملتا الشرط والجواب خبر المبتدأ من وجملة من.. استئنافية لا محل لها (تَجْرِي) مضارع مرفوع (مِنْ تَحْتِهَا) متعلقان بالفعل (الْأَنْهارُ) فاعل والجملة صفة (خالِدِينَ) حال (فِيها) متعلقان بخالدين (أَبَداً) ظرف زمان (قَدْ) حرف تحقيق (أَحْسَنَ اللَّهُ) ماض ولفظ الجلالة فاعله (لَهُ) متعلقان بالفعل (رِزْقاً) مفعول به والجملة حال.\r\n\r\n"},{"sura":65,"ayah":12,"words":[{"position":1,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"al-lahu"},{"position":2,"arabic":"ٱلَّذِى","translation":"(is) He Who","transliteration":"alladhī"},{"position":3,"arabic":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":4,"arabic":"سَبْعَ","translation":"seven","transliteration":"sabʿa"},{"position":5,"arabic":"سَمَـٰوَٰتٍۢ","translation":"heavens","transliteration":"samāwātin"},{"position":6,"arabic":"وَمِنَ","translation":"and of","transliteration":"wamina"},{"position":7,"arabic":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":8,"arabic":"مِثْلَهُنَّ","translation":"(the) like of them","transliteration":"mith'lahunna"},{"position":9,"arabic":"يَتَنَزَّلُ","translation":"Descends","transliteration":"yatanazzalu"},{"position":10,"arabic":"ٱلْأَمْرُ","translation":"the command","transliteration":"l-amru"},{"position":11,"arabic":"بَيْنَهُنَّ","translation":"between them","transliteration":"baynahunna"},{"position":12,"arabic":"لِتَعْلَمُوٓا۟","translation":"that you may know","transliteration":"litaʿlamū"},{"position":13,"arabic":"أَنَّ","translation":"that","transliteration":"anna"},{"position":14,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":15,"arabic":"عَلَىٰ","translation":"(is) on","transliteration":"ʿalā"},{"position":16,"arabic":"كُلِّ","translation":"every","transliteration":"kulli"},{"position":17,"arabic":"شَىْءٍۢ","translation":"thing","transliteration":"shayin"},{"position":18,"arabic":"قَدِيرٌۭ","translation":"All-Powerful","transliteration":"qadīrun"},{"position":19,"arabic":"وَأَنَّ","translation":"And that","transliteration":"wa-anna"},{"position":20,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":21,"arabic":"قَدْ","translation":"indeed","transliteration":"qad"},{"position":22,"arabic":"أَحَاطَ","translation":"encompasses","transliteration":"aḥāṭa"},{"position":23,"arabic":"بِكُلِّ","translation":"all","transliteration":"bikulli"},{"position":24,"arabic":"شَىْءٍ","translation":"things","transliteration":"shayin"},{"position":25,"arabic":"عِلْمًۢا","translation":"(in) knowledge","transliteration":"ʿil'man"}],"e3rab":"(اللَّهُ الَّذِي) مبتدأ وخبره والجملة استئنافية لا محل لها (خَلَقَ) ماض فاعله مستتر والجملة صلة الذي (سَبْعَ سَماواتٍ) مفعول به مضاف إلى السموات (وَمِنَ الْأَرْضِ) متعلقان بفعل محذوف تقديره وخلق (مِثْلَهُنَّ) مفعول به للفعل المحذوف (يَتَنَزَّلُ الْأَمْرُ) مضارع وفاعله والجملة استئنافية لا محل لها.\r\n\r\n(بَيْنَهُنَّ) ظرف مكان (لِتَعْلَمُوا) مضارع منصوب بأن مضمرة بعد لام التعليل والواو فاعله والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بخلق.\r\n\r\n(أَنَّ اللَّهَ) أن واسمها (عَلى كُلِّ) متعلقان بقدير (شَيْءٍ) مضاف إليه (قَدِيرٌ) خبر أن والمصدر المؤول من أن وما بعدها في محل نصب سد مسد مفعولي تعلموا (وَأَنَّ اللَّهَ) أن واسمها (قَدْ) حرف تحقيق (أَحاطَ) ماض فاعله مستتر والجملة الفعلية خبر أن والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n(بِكُلِّ) متعلقان بالفعل (شَيْءٍ) مضاف إليه (عِلْماً) تمييز.\r\n\r\n"}]