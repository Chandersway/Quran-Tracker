[{"sura":85,"ayah":1,"words":[{"position":1,"arabic":"وَٱلسَّمَآءِ","translation":"By the sky","transliteration":"wal-samāi"},{"position":2,"arabic":"ذَاتِ","translation":"containing","transliteration":"dhāti"},{"position":3,"arabic":"ٱلْبُرُوجِ","translation":"the constellations","transliteration":"l-burūji"}],"e3rab":"(وَالسَّماءِ) جار ومجرور متعلقان بفعل محذوف تقديره أقسم (ذاتِ الْبُرُوجِ) صفة مضافة إلى البروج، والبروج: الكواكب في السماء.\r\n\r\n"},{"sura":85,"ayah":2,"words":[{"position":1,"arabic":"وَٱلْيَوْمِ","translation":"And the Day","transliteration":"wal-yawmi"},{"position":2,"arabic":"ٱلْمَوْعُودِ","translation":"Promised","transliteration":"l-mawʿūdi"}],"e3rab":"(وَالْيَوْمِ) معطوف على السماء (الْمَوْعُودِ) صفة اليوم.\r\n\r\n"},{"sura":85,"ayah":3,"words":[{"position":1,"arabic":"وَشَاهِدٍۢ","translation":"And (the) witness","transliteration":"washāhidin"},{"position":2,"arabic":"وَمَشْهُودٍۢ","translation":"and what is witnessed","transliteration":"wamashhūdin"}],"e3rab":"معطوفان على ما قبلهما.\r\n\r\n"},{"sura":85,"ayah":4,"words":[{"position":1,"arabic":"قُتِلَ","translation":"Destroyed were","transliteration":"qutila"},{"position":2,"arabic":"أَصْحَـٰبُ","translation":"(the) companions","transliteration":"aṣḥābu"},{"position":3,"arabic":"ٱلْأُخْدُودِ","translation":"(of) the pit","transliteration":"l-ukh'dūdi"}],"e3rab":"(قُتِلَ) ماض مبني للمجهول (أَصْحابُ الْأُخْدُودِ) نائب فاعل مضاف إلى الأخدود والجملة الفعلية جواب القسم.\r\n\r\n"},{"sura":85,"ayah":5,"words":[{"position":1,"arabic":"ٱلنَّارِ","translation":"(Of) the fire","transliteration":"al-nāri"},{"position":2,"arabic":"ذَاتِ","translation":"full","transliteration":"dhāti"},{"position":3,"arabic":"ٱلْوَقُودِ","translation":"(of) the fuel","transliteration":"l-waqūdi"}],"e3rab":"(النَّارِ) بدل اشتمال من أصحاب الأخدود (ذاتِ الْوَقُودِ) صفة النار مضافة إلى الوقود.\r\n\r\n"},{"sura":85,"ayah":6,"words":[{"position":1,"arabic":"إِذْ","translation":"When","transliteration":"idh"},{"position":2,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":3,"arabic":"عَلَيْهَا","translation":"by it","transliteration":"ʿalayhā"},{"position":4,"arabic":"قُعُودٌۭ","translation":"(were) sitting","transliteration":"quʿūdun"}],"e3rab":"(إِذْ هُمْ) ظرف زمان ومبتدأ (عَلَيْها) متعلقان بالخبر (قُعُودٌ) خبر والجملة الاسمية في محل جر بالإضافة.\r\n\r\n"},{"sura":85,"ayah":7,"words":[{"position":1,"arabic":"وَهُمْ","translation":"And they","transliteration":"wahum"},{"position":2,"arabic":"عَلَىٰ","translation":"over","transliteration":"ʿalā"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"يَفْعَلُونَ","translation":"they were doing","transliteration":"yafʿalūna"},{"position":5,"arabic":"بِٱلْمُؤْمِنِينَ","translation":"to the believers","transliteration":"bil-mu'minīna"},{"position":6,"arabic":"شُهُودٌۭ","translation":"witnesses","transliteration":"shuhūdun"}],"e3rab":"(وَهُمْ) الواو حرف عطف (هُمْ) مبتدأ (عَلى ما) متعلقان بشهود (يَفْعَلُونَ) مضارع مرفوع والواو فاعله والجملة صلة (بِالْمُؤْمِنِينَ) متعلقان بالفعل (شُهُودٌ) خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":85,"ayah":8,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"نَقَمُوا۟","translation":"they resented","transliteration":"naqamū"},{"position":3,"arabic":"مِنْهُمْ","translation":"[of] them","transliteration":"min'hum"},{"position":4,"arabic":"إِلَّآ","translation":"except","transliteration":"illā"},{"position":5,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":6,"arabic":"يُؤْمِنُوا۟","translation":"they believed","transliteration":"yu'minū"},{"position":7,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":8,"arabic":"ٱلْعَزِيزِ","translation":"the All-Mighty","transliteration":"l-ʿazīzi"},{"position":9,"arabic":"ٱلْحَمِيدِ","translation":"the Praiseworthy","transliteration":"l-ḥamīdi"}],"e3rab":"(وَما) الواو حرف استئناف (ما) نافية (نَقَمُوا) ماض وفاعله (مِنْهُمْ) متعلقان بالفعل والجملة مستأنفة لا محل لها (إِلَّا) حرف استثناء (أَنْ يُؤْمِنُوا) مضارع منصوب بأن والواو فاعله والمصدر المؤول من أن والفعل في محل نصب مفعول به (بِاللَّهِ) متعلقان بالفعل (الْعَزِيزِ الْحَمِيدِ) بدلان من لفظ الجلالة.\r\n\r\n"},{"sura":85,"ayah":9,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"The One Who","transliteration":"alladhī"},{"position":2,"arabic":"لَهُۥ","translation":"for Him","transliteration":"lahu"},{"position":3,"arabic":"مُلْكُ","translation":"(is) the dominion","transliteration":"mul'ku"},{"position":4,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"(of) the heavens","transliteration":"l-samāwāti"},{"position":5,"arabic":"وَٱلْأَرْضِ ۚ","translation":"and the earth","transliteration":"wal-arḍi"},{"position":6,"arabic":"وَٱللَّهُ","translation":"and Allah","transliteration":"wal-lahu"},{"position":7,"arabic":"عَلَىٰ","translation":"on","transliteration":"ʿalā"},{"position":8,"arabic":"كُلِّ","translation":"every","transliteration":"kulli"},{"position":9,"arabic":"شَىْءٍۢ","translation":"thing","transliteration":"shayin"},{"position":10,"arabic":"شَهِيدٌ","translation":"(is) a Witness","transliteration":"shahīdun"}],"e3rab":"(الَّذِي) بدل ثالث من لفظ الجلالة (لَهُ) خبر مقدم (مُلْكُ) مبتدأ مؤخر والجملة الاسمية صلة (السَّماواتِ) مضاف إليه (وَالْأَرْضِ) معطوف على السموات (وَاللَّهُ) مبتدأ (عَلى كُلِّ) متعلقان بالخبر شهيد (شَيْءٍ) مضاف إليه والجملة حال (شَهِيدٌ) خبر.\r\n\r\n"},{"sura":85,"ayah":10,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"فَتَنُوا۟","translation":"persecuted","transliteration":"fatanū"},{"position":4,"arabic":"ٱلْمُؤْمِنِينَ","translation":"the believing men","transliteration":"l-mu'minīna"},{"position":5,"arabic":"وَٱلْمُؤْمِنَـٰتِ","translation":"and the believing women","transliteration":"wal-mu'm