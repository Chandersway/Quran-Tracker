w","transliteration":"tajrī"},{"position":9,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":10,"arabic":"تَحْتِهَا","translation":"underneath it","transliteration":"taḥtihā"},{"position":11,"arabic":"ٱلْأَنْهَـٰرُ ۚ","translation":"the rivers","transliteration":"l-anhāru"},{"position":12,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":13,"arabic":"ٱلْفَوْزُ","translation":"(is) the success","transliteration":"l-fawzu"},{"position":14,"arabic":"ٱلْكَبِيرُ","translation":"the great","transliteration":"l-kabīru"}],"e3rab":"(إِنَّ الَّذِينَ) إن واسمها (آمَنُوا) ماض وفاعله والجملة الفعلية صلة الذين (وَعَمِلُوا) معطوف على آمنوا (الصَّالِحاتِ) مفعول به (لَهُمْ جَنَّاتٌ) خبر مقدم ومبتدأ مؤخر والجملة الاسمية خبر إن وجملة إن الذين.. مستأنفة لا محل لها.\r\n\r\n(تَجْرِي) مضارع مرفوع (مِنْ تَحْتِهَا) متعلقان بالفعل (الْأَنْهارُ) فاعل والجملة صفة جنات (ذلِكَ الْفَوْزُ) مبتدأ وخبره (الْكَبِيرُ) صفة والجملة الاسمية مستأنفة.\r\n\r\n"},{"sura":85,"ayah":12,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"بَطْشَ","translation":"(the) Grip","transliteration":"baṭsha"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"لَشَدِيدٌ","translation":"(is) surely strong","transliteration":"lashadīdun"}],"e3rab":"(إِنَّ بَطْشَ) إن واسمها (رَبِّكَ) مضاف إليه (لَشَدِيدٌ) اللام المزحلقة (شديد) خبر إن والجملة مستأنفة.\r\n\r\n"},{"sura":85,"ayah":13,"words":[{"position":1,"arabic":"إِنَّهُۥ","translation":"Indeed He","transliteration":"innahu"},{"position":2,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":3,"arabic":"يُبْدِئُ","translation":"originates","transliteration":"yub'di-u"},{"position":4,"arabic":"وَيُعِيدُ","translation":"and repeats","transliteration":"wayuʿīdu"}],"e3rab":"(إِنَّهُ) إن واسمها (هُوَ) ضمير فصل (يُبْدِئُ) مضارع فاعله مستتر والجملة خبر إن وجملة إنه تعليل (وَيُعِيدُ) معطوف على يبدئ.\r\n\r\n"},{"sura":85,"ayah":14,"words":[{"position":1,"arabic":"وَهُوَ","translation":"And He","transliteration":"wahuwa"},{"position":2,"arabic":"ٱلْغَفُورُ","translation":"(is) the Oft-Forgiving","transliteration":"l-ghafūru"},{"position":3,"arabic":"ٱلْوَدُودُ","translation":"the Most Loving","transliteration":"l-wadūdu"}],"e3rab":"(وَهُوَ الْغَفُورُ الْوَدُودُ) مبتدأ وخبران والجملة حال.\r\n\r\n"},{"sura":85,"ayah":15,"words":[{"position":1,"arabic":"ذُو","translation":"Owner (of)","transliteration":"dhū"},{"position":2,"arabic":"ٱلْعَرْشِ","translation":"the Throne","transliteration":"l-ʿarshi"},{"position":3,"arabic":"ٱلْمَجِيدُ","translation":"the Glorious","transliteration":"l-majīdu"}],"e3rab":"(ذُو الْعَرْشِ) ذو خبر ثالث مضاف إلى العرش (الْمَجِيدُ) خبر أيضا.\r\n\r\n"},{"sura":85,"ayah":16,"words":[{"position":1,"arabic":"فَعَّالٌۭ","translation":"Doer","transliteration":"faʿʿālun"},{"position":2,"arabic":"لِّمَا","translation":"of what","transliteration":"limā"},{"position":3,"arabic":"يُرِيدُ","translation":"He intends","transliteration":"yurīdu"}],"e3rab":"(فَعَّالٌ) خبر أيضا (لِما) متعلقان بما قبلهما (يُرِيدُ) مضارع فاعله مستتر والجملة صلة.\r\n\r\n"},{"sura":85,"ayah":17,"words":[{"position":1,"arabic":"هَلْ","translation":"Has","transliteration":"hal"},{"position":2,"arabic":"أَتَىٰكَ","translation":"come to you","transliteration":"atāka"},{"position":3,"arabic":"حَدِيثُ","translation":"(the) story","transliteration":"ḥadīthu"},{"position":4,"arabic":"ٱلْجُنُودِ","translation":"(of) the hosts","transliteration":"l-junūdi"}],"e3rab":"(هَلْ) حرف استفهام (أَتاكَ) ماض ومفعوله (حَدِيثُ الْجُنُودِ) فاعل مضاف إلى الجنود والجملة مستأنفة.\r\n\r\n"},{"sura":85,"ayah":18,"words":[{"position":1,"arabic":"فِرْعَوْنَ","translation":"Firaun","transliteration":"fir'ʿawna"},{"position":2,"arabic":"وَثَمُودَ","translation":"and Thamud","transliteration":"wathamūda"}],"e3rab":"(فِرْعَوْنَ وَثَمُودَ) بدل من الجنود وما بعده معطوف عليه.\r\n\r\n"},{"sura":85,"