[{"sura":95,"ayah":1,"words":[{"position":1,"arabic":"وَٱلتِّينِ","translation":"By the fig","transliteration":"wal-tīni"},{"position":2,"arabic":"وَٱلزَّيْتُونِ","translation":"and the olive","transliteration":"wal-zaytūni"}],"e3rab":"(وَالتِّينِ) جار ومجرور متعلقان بفعل قسم محذوف (وَالزَّيْتُونِ) معطوف على التين.\r\n\r\n"},{"sura":95,"ayah":2,"words":[{"position":1,"arabic":"وَطُورِ","translation":"And (the) Mount","transliteration":"waṭūri"},{"position":2,"arabic":"سِينِينَ","translation":"Sinai","transliteration":"sīnīna"}],"e3rab":"«وَطُورِ» معطوف على ما قبله «سِينِينَ» مضاف إليه.\r\n\r\n"},{"sura":95,"ayah":3,"words":[{"position":1,"arabic":"وَهَـٰذَا","translation":"And this","transliteration":"wahādhā"},{"position":2,"arabic":"ٱلْبَلَدِ","translation":"[the] city","transliteration":"l-baladi"},{"position":3,"arabic":"ٱلْأَمِينِ","translation":"[the] secure","transliteration":"l-amīni"}],"e3rab":"(وَهذَا) اسم إشارة معطوف على ما قبله (الْبَلَدِ) بدل من اسم الإشارة (الْأَمِينِ) صفة البلد.\r\n\r\n"},{"sura":95,"ayah":4,"words":[{"position":1,"arabic":"لَقَدْ","translation":"Indeed","transliteration":"laqad"},{"position":2,"arabic":"خَلَقْنَا","translation":"We created","transliteration":"khalaqnā"},{"position":3,"arabic":"ٱلْإِنسَـٰنَ","translation":"man","transliteration":"l-insāna"},{"position":4,"arabic":"فِىٓ","translation":"in","transliteration":"fī"},{"position":5,"arabic":"أَحْسَنِ","translation":"(the) best","transliteration":"aḥsani"},{"position":6,"arabic":"تَقْوِيمٍۢ","translation":"mould","transliteration":"taqwīmin"}],"e3rab":"(لَقَدْ) اللام واقعة في جواب القسم (قد) حرف تحقيق (خَلَقْنَا) ماض وفاعله (الْإِنْسانَ) مفعول به (فِي أَحْسَنِ) متعلقان بمحذوف حال (تَقْوِيمٍ) مضاف إليه والجملة جواب القسم.\r\n\r\n"},{"sura":95,"ayah":5,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"رَدَدْنَـٰهُ","translation":"We returned him","transliteration":"radadnāhu"},{"position":3,"arabic":"أَسْفَلَ","translation":"(to the) lowest","transliteration":"asfala"},{"position":4,"arabic":"سَـٰفِلِينَ","translation":"(of the) low","transliteration":"sāfilīna"}],"e3rab":"(ثُمَّ) حرف عطف (رَدَدْناهُ) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها.\r\n\r\n(أَسْفَلَ سافِلِينَ) حال مضاف إلى سافلين.\r\n\r\n"},{"sura":95,"ayah":6,"words":[{"position":1,"arabic":"إِلَّا","translation":"Except","transliteration":"illā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"وَعَمِلُوا۟","translation":"and do","transliteration":"waʿamilū"},{"position":5,"arabic":"ٱلصَّـٰلِحَـٰتِ","translation":"righteous deeds","transliteration":"l-ṣāliḥāti"},{"position":6,"arabic":"فَلَهُمْ","translation":"then for them","transliteration":"falahum"},{"position":7,"arabic":"أَجْرٌ","translation":"(is a) reward","transliteration":"ajrun"},{"position":8,"arabic":"غَيْرُ","translation":"never","transliteration":"ghayru"},{"position":9,"arabic":"مَمْنُونٍۢ","translation":"ending","transliteration":"mamnūnin"}],"e3rab":"(إِلَّا) حرف استثناء (الَّذِينَ) اسم موصول في محل نصب على الاستثناء (آمَنُوا) ماض وفاعله والجملة صلة (وَعَمِلُوا) معطوف على آمنوا (الصَّالِحاتِ) مفعول به (فَلَهُمْ) الفاء حرف استئناف (لهم) خبر مقدم (أَجْرٌ) مبتدأ مؤخر والجملة مستأنفة لا محل لها (غَيْرُ) صفة مضافة إلى (مَمْنُونٍ).\r\n\r\n"},{"sura":95,"ayah":7,"words":[{"position":1,"arabic":"فَمَا","translation":"Then what","transliteration":"famā"},{"position":2,"arabic":"يُكَذِّبُكَ","translation":"causes you to deny","transliteration":"yukadhibuka"},{"position":3,"arabic":"بَعْدُ","translation":"after (this)","transliteration":"baʿdu"},{"position":4,"arabic":"بِٱلدِّينِ","translation":"the judgment","transliteration":"bil-dīni"}],"e3rab":"(فَما) الفاء الفصيحة (ما) اسم استفهام مبتدأ (يُكَذِّبُكَ) مضارع ومفعوله والفاعل مستتر والجملة خبر المبتدأ والجملة الاسمية جواب الشرط المقدر لا محل لها (بَعْدُ) ظرف زمان مبني على الضم (بِالدِّينِ) متعلقان بالفعل.\r\n\r\n"},{"sura":95,"ayah":8,"words":[{"position":1,"arabic":"أَلَيْسَ","translation":"Is not","transliteration":"alaysa"},{"position":2,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":3,"arabic":"بِأَحْكَمِ","translation":"(the) Most Just","transliteration":"bi-aḥkami"},{"position":4,"arabic":"ٱلْحَـٰكِمِينَ","translation":"(of) the Judges","transliteration":"l-ḥākimīna"}],"e3rab":"(أَلَيْسَ اللَّهُ) الهمزة حرف استفهام وتقرير وماض ناقص ولفظ الجلالة اسمه (بِأَحْكَمِ) الباء حرف جر زائد وأحكم مجرور لفظا منصوب محلا خبر ليس (الْحاكِمِينَ) مضاف إليه والجملة مستأنفة لا محل لها.\r\n\r\n"}]