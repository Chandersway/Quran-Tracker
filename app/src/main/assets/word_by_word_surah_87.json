[{"sura":87,"ayah":1,"words":[{"position":1,"arabic":"سَبِّحِ","translation":"Glorify","transliteration":"sabbiḥi"},{"position":2,"arabic":"ٱسْمَ","translation":"(the) name","transliteration":"is'ma"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"ٱلْأَعْلَى","translation":"the Most High","transliteration":"l-aʿlā"}],"e3rab":"(سَبِّحِ) أمر فاعله مستتر (اسْمَ رَبِّكَ) اسم مفعول به مضاف إلى ربك (الْأَعْلَى) صفة ربك والجملة ابتدائية لا محل لها.\r\n\r\n"},{"sura":87,"ayah":2,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"The One Who","transliteration":"alladhī"},{"position":2,"arabic":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":3,"arabic":"فَسَوَّىٰ","translation":"then proportioned","transliteration":"fasawwā"}],"e3rab":"(الَّذِي) صفة ثانية لربك (خَلَقَ) ماض فاعله مستتر والجملة صلة (فَسَوَّى) معطوف على خلق.\r\n\r\n"},{"sura":87,"ayah":3,"words":[{"position":1,"arabic":"وَٱلَّذِى","translation":"And the One Who","transliteration":"wa-alladhī"},{"position":2,"arabic":"قَدَّرَ","translation":"measured","transliteration":"qaddara"},{"position":3,"arabic":"فَهَدَىٰ","translation":"then guided","transliteration":"fahadā"}],"e3rab":"الجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":87,"ayah":4,"words":[{"position":1,"arabic":"وَٱلَّذِىٓ","translation":"And the One Who","transliteration":"wa-alladhī"},{"position":2,"arabic":"أَخْرَجَ","translation":"brings forth","transliteration":"akhraja"},{"position":3,"arabic":"ٱلْمَرْعَىٰ","translation":"the pasture","transliteration":"l-marʿā"}],"e3rab":"الجملة معطوفة على ما قبلها أيضا.\r\n\r\n"},{"sura":87,"ayah":5,"words":[{"position":1,"arabic":"فَجَعَلَهُۥ","translation":"And then makes it","transliteration":"fajaʿalahu"},{"position":2,"arabic":"غُثَآءً","translation":"stubble","transliteration":"ghuthāan"},{"position":3,"arabic":"أَحْوَىٰ","translation":"dark","transliteration":"aḥwā"}],"e3rab":"(فَجَعَلَهُ) ماض ومفعوله الأول والفاعل مستتر (غُثاءً) مفعول به ثان (أَحْوى) حال من المرعى والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":87,"ayah":6,"words":[{"position":1,"arabic":"سَنُقْرِئُكَ","translation":"We will make you recite","transliteration":"sanuq'ri-uka"},{"position":2,"arabic":"فَلَا","translation":"so not","transliteration":"falā"},{"position":3,"arabic":"تَنسَىٰٓ","translation":"you will forget","transliteration":"tansā"}],"e3rab":"(سَنُقْرِئُكَ) السين للاستقبال ومضارع ومفعوله والفاعل مستتر والجملة مستأنفة (فَلا تَنْسى) الفاء حرف تعليل ولا نافية ومضارع فاعله مستتر.\r\n\r\n"},{"sura":87,"ayah":7,"words":[{"position":1,"arabic":"إِلَّا","translation":"Except","transliteration":"illā"},{"position":2,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":3,"arabic":"شَآءَ","translation":"wills","transliteration":"shāa"},{"position":4,"arabic":"ٱللَّهُ ۚ","translation":"Allah","transliteration":"l-lahu"},{"position":5,"arabic":"إِنَّهُۥ","translation":"Indeed, He","transliteration":"innahu"},{"position":6,"arabic":"يَعْلَمُ","translation":"knows","transliteration":"yaʿlamu"},{"position":7,"arabic":"ٱلْجَهْرَ","translation":"the manifest","transliteration":"l-jahra"},{"position":8,"arabic":"وَمَا","translation":"and what","transliteration":"wamā"},{"position":9,"arabic":"يَخْفَىٰ","translation":"is hidden","transliteration":"yakhfā"}],"e3rab":"(إِلَّا) حرف استثناء (ما) اسم موصول في محل نصب على الاستثناء (شاءَ اللَّهُ) ماض ولفظ الجلالة فاعله والجملة صلة (إِنَّهُ) إن واسمها (يَعْلَمُ) مضارع فاعله مستتر (الْجَهْرَ) مفعول به والجملة الفعلية خبر إن والجملة الاسمية تعليلية لا محل لها.\r\n\r\n(وَما) اسم موصول معطوف على الجهر (يَخْفى) مضارع فاعله مستتر والجملة صلة.\r\n\r\n"},{"sura":87,"ayah":8,"words":[{"position":1,"arabic":"وَنُيَسِّرُكَ","translation":"And We will ease you","transliteration":"wanuyassiruka"},{"position":2,"arabic":"لِلْيُسْرَىٰ","translation":"to the ease","transliteration":"lil'yus'rā"}],"e3rab":"(وَنُيَسِّرُكَ) مضارع ومفعوله والفاعل مستتر (لِلْيُسْرى) متعلقان بالفعل، والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":87,"ayah":9,"words":[{"position":1,"arabic":"فَذَكِّرْ","translation":"So remind","transliteration":"fadhakkir"},{"position":2,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":3,"arabic":"نَّفَعَتِ","translation":"benefits","transliteration":"nafaʿati"},{"position":4,"arabic":"ٱلذِّكْرَىٰ","translation":"the reminder","transliteration":"l-dhik'rā"}],"e3rab":"(فَذَكِّرْ) الفاء الفصيحة وأمر فاعله مستتر والجملة جواب شرط مقدر لا محل لها (إِنْ) حرف شرط جازم (نَفَعَتِ) ماض في محل جزم فعل الشرط (الذِّكْرى) فاعل والجملة ابتدائية لا محل لها.\r\n\r\n"},{"sura":87,"ayah":10,"words":[{"position":1,"arabic":"سَيَذَّكَّرُ","translation":"He will pay heed ","transliteration":"sayadhakkaru"},{"position":2,"arabic":"مَن","translation":"(one) who","transliteration":"man"},{"position":3,"arabic":"يَخْشَىٰ","translation":"fears (Allah)","transliteration":"yakhshā"}],"e3rab":"(سَيَذَّكَّرُ) السين للاستقبال ومضارع مرفوع (مَنْ) اسم موصول فاعله والجملة مستأنفة (يَخْشى) مضارع فاعله مستتر والجملة صلة.\r\n\r\n"},{"sura":87,"ayah":11,"words":[{"position":1,"arabic":"وَيَتَجَنَّبُهَا","translation":"And will avoid it","transliteration":"wayatajannabuhā"},{"position":2,"arabic":"ٱلْأَشْقَى","translation":"the wretched one","transliteration":"l-ashqā"}],"e3rab":"(وَيَتَجَنَّبُهَا) مضارع ومفعوله.\r\n\r\n(الْأَشْقَى) فاعل والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":87,"ayah":12,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"The one who","transliteration":"alladhī"},{"position":2,"arabic":"يَصْلَى","translation":"will burn","transliteration":"yaṣlā"},{"position":3,"arabic":"ٱلنَّارَ","translation":"(in) the Fire","transliteration":"l-nāra"},{"position":4,"arabic":"ٱلْكُبْرَىٰ","translation":"[the] great","transliteration":"l-kub'rā"}],"e3rab":"(الَّذِي) اسم موصول صفة الأشقى (يَصْلَى) مضارع فاعله مستتر (النَّارَ) مفعول به (الْكُبْرى) صفة النار والجملة صلة.\r\n\r\n"},{"sura":87,"ayah":13,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":3,"arabic":"يَمُوتُ","translation":"he will die","transliteration":"yamūtu"},{"position":4,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":5,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":6,"arabic":"يَحْيَىٰ","translation":"will live","transliteration":"yaḥyā"}],"e3rab":"(ثُمَّ) حرف عطف (لا) نافية (يَمُوتُ) مضارع فاعله مستتر والجملة معطوفة على ما قبلها (فِيها) متعلقان بالفعل (وَلا) الواو حرف عطف (وَلا) نافية (يَحْيى) معطوف على يموت.\r\n\r\n"},{"sura":87,"ayah":14,"words":[{"position":1,"arabic":"قَدْ","translation":"Certainly","transliteration":"qad"},{"position":2,"arabic":"أَفْلَحَ","translation":"has succeeded","transliteration":"aflaḥa"},{"position":3,"arabic":"مَن","translation":"(one) who","transliteration":"man"},{"position":4,"arabic":"تَزَكَّىٰ","translation":"purifies (himself)","transliteration":"tazakkā"}],"e3rab":"(قَدْ) حرف تحقيق (أَفْلَحَ) ماض (مَنْ) فاعله والجملة مستأنفة (تَزَكَّى) ماض فاعله مستتر والجملة صلة.\r\n\r\n"},{"sura":87,"ayah":15,"words":[{"position":1,"arabic":"وَذَكَرَ","translation":"And remembers","transliteration":"wadhakara"},{"position":2,"arabic":"ٱسْمَ","translation":"(the) name","transliteration":"is'ma"},{"position":3,"arabic":"رَبِّهِۦ","translation":"(of) his Lord","transliteration":"rabbihi"},{"position":4,"arabic":"فَصَلَّىٰ","translation":"and prays","transliteration":"faṣallā"}],"e3rab":"(وَذَكَرَ) ماض فاعله مستتر (اسْمَ رَبِّهِ) مفعول به مضاف إلى ربه والجملة معطوفة على ما قبلها (فَصَلَّى) الفاء حرف عطف وصلى معطوف على ذكر.\r\n\r\n"},{"sura":87,"ayah":16,"words":[{"position":1,"arabic":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":2,"arabic":"تُؤْثِرُونَ","translation":"You prefer","transliteration":"tu'thirūna"},{"position":3,"arabic":"ٱلْحَيَوٰةَ","translation":"the life","transliteration":"l-ḥayata"},{"position":4,"arabic":"ٱلدُّنْيَا","translation":"(of) the world","transliteration":"l-dun'yā"}],"e3rab":"(بَلْ) حرف عطف (تُؤْثِرُونَ) مضارع مرفوع والواو فاعله (الْحَياةَ) مفعول به (الدُّنْيا) صفة.\r\n\r\n"},{"sura":87,"ayah":17,"words":[{"position":1,"arabic":"وَٱلْـَٔاخِرَةُ","translation":"While the Hereafter","transliteration":"wal-ākhiratu"},{"position":2,"arabic":"خَيْرٌۭ","translation":"(is) better","transliteration":"khayrun"},{"position":3,"arabic":"وَأَبْقَىٰٓ","translation":"and everlasting","transliteration":"wa-abqā"}],"e3rab":"(وَالْآخِرَةُ خَيْرٌ) الواو حالية ومبتدأ وخبره والجملة حال وأبقى معطوف على خبر.\r\n\r\n"},{"sura":87,"ayah":18,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"هَـٰذَا","translation":"this","transliteration":"hādhā"},{"position":3,"arabic":"لَفِى","translation":"surely (is) in","transliteration":"lafī"},{"position":4,"arabic":"ٱلصُّحُفِ","translation":"the Scriptures","transliteration":"l-ṣuḥufi"},{"position":5,"arabic":"ٱلْأُولَىٰ","translation":"[the] former","transliteration":"l-ūlā"}],"e3rab":"(إِنَّ هذا) إن واسمها (لَفِي الصُّحُفِ) اللام المزحلقة وفي الصحف خبر إن (الْأُولى) صفة والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":87,"ayah":19,"words":[{"position":1,"arabic":"صُحُفِ","translation":"(The) Scriptures","transliteration":"ṣuḥufi"},{"position":2,"arabic":"إِبْرَٰهِيمَ","translation":"(of) Ibrahim","transliteration":"ib'rāhīma"},{"position":3,"arabic":"وَمُوسَىٰ","translation":"and Musa","transliteration":"wamūsā"}],"e3rab":"(صُحُفِ) بدل من الصحف (إِبْراهِيمَ) مضاف إليه (وَمُوسى) معطوف على إبراهيم.\r\n\r\n"}]