[{"sura":108,"ayah":1,"words":[{"position":1,"arabic":"إِنَّآ","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"أَعْطَيْنَـٰكَ","translation":"We have given you","transliteration":"aʿṭaynāka"},{"position":3,"arabic":"ٱلْكَوْثَرَ","translation":"Al-Kauthar","transliteration":"l-kawthara"}],"e3rab":"(إِنَّا) إن واسمها (أَعْطَيْناكَ) ماض وفاعله ومفعوله الأول (الْكَوْثَرَ) مفعول به ثان والجملة الفعلية خبر إن والجملة الاسمية ابتدائية لا محل لها.\r\n\r\n"},{"sura":108,"ayah":2,"words":[{"position":1,"arabic":"فَصَلِّ","translation":"So pray","transliteration":"faṣalli"},{"position":2,"arabic":"لِرَبِّكَ","translation":"to your Lord","transliteration":"lirabbika"},{"position":3,"arabic":"وَٱنْحَرْ","translation":"and sacrifice","transliteration":"wa-in'ḥar"}],"e3rab":"(فَصَلِّ) الفاء حرف عطف وأمر مبني على حذف حرف العلة والفاعل مستتر (لِرَبِّكَ) متعلقان بالفعل والجملة معطوفة على ما قبلها (وَانْحَرْ) معطوف على ما قبله.\r\n\r\n"},{"sura":108,"ayah":3,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"شَانِئَكَ","translation":"your enemy ","transliteration":"shāni-aka"},{"position":3,"arabic":"هُوَ","translation":"he (is)","transliteration":"huwa"},{"position":4,"arabic":"ٱلْأَبْتَرُ","translation":"the one cut off","transliteration":"l-abtaru"}],"e3rab":"(إِنَّ شانِئَكَ) إن واسمها (هُوَ) ضمير فصل (الْأَبْتَرُ) خبر إن والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"}]