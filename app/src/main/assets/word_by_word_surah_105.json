[{"sura":105,"ayah":1,"words":[{"position":1,"arabic":"أَلَمْ","translation":"Have not","transliteration":"alam"},{"position":2,"arabic":"تَرَ","translation":"you seen","transliteration":"tara"},{"position":3,"arabic":"كَيْفَ","translation":"how","transliteration":"kayfa"},{"position":4,"arabic":"فَعَلَ","translation":"dealt","transliteration":"faʿala"},{"position":5,"arabic":"رَبُّكَ","translation":"your Lord","transliteration":"rabbuka"},{"position":6,"arabic":"بِأَصْحَـٰبِ","translation":"with (the) Companions","transliteration":"bi-aṣḥābi"},{"position":7,"arabic":"ٱلْفِيلِ","translation":"(of the) Elephant","transliteration":"l-fīli"}],"e3rab":"(أَلَمْ تَرَ) الهمزة حرف استفهام تقريري ومضارع مجزوم بلم وعلامة جزمه حذف حرف العلة من آخره والفاعل مستتر (كَيْفَ) اسم استفهام مفعول مطلق (فَعَلَ رَبُّكَ) ماض وفاعله والجملة سدت مسد مفعولي ترى (بِأَصْحابِ) متعلقان بالفعل (الْفِيلِ) مضاف إليه.\r\n\r\n"},{"sura":105,"ayah":2,"words":[{"position":1,"arabic":"أَلَمْ","translation":"Did not","transliteration":"alam"},{"position":2,"arabic":"يَجْعَلْ","translation":"He make","transliteration":"yajʿal"},{"position":3,"arabic":"كَيْدَهُمْ","translation":"their plan","transliteration":"kaydahum"},{"position":4,"arabic":"فِى","translation":"go","transliteration":"fī"},{"position":5,"arabic":"تَضْلِيلٍۢ","translation":"astray","transliteration":"taḍlīlin"}],"e3rab":"(أَلَمْ يَجْعَلْ) الهمزة حرف استفهام تقريري ومضارع مجزوم بلم والفاعل مستتر (كَيْدَهُمْ) مفعول به (فِي تَضْلِيلٍ) متعلقان بالفعل والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":105,"ayah":3,"words":[{"position":1,"arabic":"وَأَرْسَلَ","translation":"And He sent","transliteration":"wa-arsala"},{"position":2,"arabic":"عَلَيْهِمْ","translation":"against them","transliteration":"ʿalayhim"},{"position":3,"arabic":"طَيْرًا","translation":"birds","transliteration":"ṭayran"},{"position":4,"arabic":"أَبَابِيلَ","translation":"(in) flocks","transliteration":"abābīla"}],"e3rab":"(وَأَرْسَلَ) ماض فاعله مستتر (عَلَيْهِمْ) متعلقان بالفعل (طَيْراً) مفعول به (أَبابِيلَ) صفة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":105,"ayah":4,"words":[{"position":1,"arabic":"تَرْمِيهِم","translation":"Striking them","transliteration":"tarmīhim"},{"position":2,"arabic":"بِحِجَارَةٍۢ","translation":"with stones","transliteration":"biḥijāratin"},{"position":3,"arabic":"مِّن","translation":"of","transliteration":"min"},{"position":4,"arabic":"سِجِّيلٍۢ","translation":"baked clay","transliteration":"sijjīlin"}],"e3rab":"(تَرْمِيهِمْ) مضارع ومفعوله والفاعل مستتر (بِحِجارَةٍ) متعلقان بالفعل (مِنْ سِجِّيلٍ) صفة حجارة والجملة صفة ثانية لطيرا.\r\n\r\n"},{"sura":105,"ayah":5,"words":[{"position":1,"arabic":"فَجَعَلَهُمْ","translation":"Then He made them","transliteration":"fajaʿalahum"},{"position":2,"arabic":"كَعَصْفٍۢ","translation":"like straw","transliteration":"kaʿaṣfin"},{"position":3,"arabic":"مَّأْكُولٍۭ","translation":"eaten up","transliteration":"makūlin"}],"e3rab":"(فَجَعَلَهُمْ) ماض ومفعوله والفاعل مستتر (كَعَصْفٍ) متعلقان بالفعل وهما في موضع المفعول الثاني (مَأْكُولٍ) صفة عصف والجملة معطوفة على ما قبلها.\r\n\r\n"}]