[{"sura":91,"ayah":1,"words":[{"position":1,"arabic":"وَٱلشَّمْسِ","translation":"By the sun","transliteration":"wal-shamsi"},{"position":2,"arabic":"وَضُحَىٰهَا","translation":"and its brightness","transliteration":"waḍuḥāhā"}],"e3rab":"(وَالشَّمْسِ) جار ومجرور متعلقان بفعل قسم محذوف (وَضُحاها) معطوف على الشمس.\r\n\r\n"},{"sura":91,"ayah":2,"words":[{"position":1,"arabic":"وَٱلْقَمَرِ","translation":"And the moon","transliteration":"wal-qamari"},{"position":2,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"arabic":"تَلَىٰهَا","translation":"it follows it","transliteration":"talāhā"}],"e3rab":"(وَالْقَمَرِ) معطوف على ما قبله (إِذا) ظرف زمان (تَلاها) ماض ومفعوله والفاعل مستتر والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":91,"ayah":3,"words":[{"position":1,"arabic":"وَٱلنَّهَارِ","translation":"And the day","transliteration":"wal-nahāri"},{"position":2,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"arabic":"جَلَّىٰهَا","translation":"it displays it","transliteration":"jallāhā"}],"e3rab":"معطوفة على ما قبلها والإعراب مماثل.\r\n\r\n"},{"sura":91,"ayah":4,"words":[{"position":1,"arabic":"وَٱلَّيْلِ","translation":"And the night","transliteration":"wa-al-layli"},{"position":2,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"arabic":"يَغْشَىٰهَا","translation":"it covers it","transliteration":"yaghshāhā"}],"e3rab":"معطوفة على ما قبلها.\r\n\r\n"},{"sura":91,"ayah":5,"words":[{"position":1,"arabic":"وَٱلسَّمَآءِ","translation":"And the heaven","transliteration":"wal-samāi"},{"position":2,"arabic":"وَمَا","translation":"and (He) Who","transliteration":"wamā"},{"position":3,"arabic":"بَنَىٰهَا","translation":"constructed it","transliteration":"banāhā"}],"e3rab":"معطوفة على ما قبلها (وَما) مصدرية والمصدر المؤول من ما والفعل في محل جر معطوف على ما قبله.\r\n\r\n"},{"sura":91,"ayah":6,"words":[{"position":1,"arabic":"وَٱلْأَرْضِ","translation":"And the earth","transliteration":"wal-arḍi"},{"position":2,"arabic":"وَمَا","translation":"and by (He) Who","transliteration":"wamā"},{"position":3,"arabic":"طَحَىٰهَا","translation":"spread it","transliteration":"ṭaḥāhā"}],"e3rab":"معطوفة على ما قبلها.\r\n\r\n"},{"sura":91,"ayah":7,"words":[{"position":1,"arabic":"وَنَفْسٍۢ","translation":"And (the) soul","transliteration":"wanafsin"},{"position":2,"arabic":"وَمَا","translation":"and (He) Who","transliteration":"wamā"},{"position":3,"arabic":"سَوَّىٰهَا","translation":"proportioned it","transliteration":"sawwāhā"}],"e3rab":"معطوفة على ما قبلها أيضا.\r\n\r\n"},{"sura":91,"ayah":8,"words":[{"position":1,"arabic":"فَأَلْهَمَهَا","translation":"And He inspired it","transliteration":"fa-alhamahā"},{"position":2,"arabic":"فُجُورَهَا","translation":"(to distinguish) its wickedness","transliteration":"fujūrahā"},{"position":3,"arabic":"وَتَقْوَىٰهَا","translation":"and its righteousness","transliteration":"wataqwāhā"}],"e3rab":"(فَأَلْهَمَها) الفاء حرف عطف وماض ومفعوله الأول والفاعل مستتر (فُجُورَها) مفعول به ثان (وَتَقْواها) معطوف على فجورها والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":91,"ayah":9,"words":[{"position":1,"arabic":"قَدْ","translation":"Indeed","transliteration":"qad"},{"position":2,"arabic":"أَفْلَحَ","translation":"he succeeds","transliteration":"aflaḥa"},{"position":3,"arabic":"مَن","translation":"who","transliteration":"man"},{"position":4,"arabic":"زَكَّىٰهَا","translation":"purifies it","transliteration":"zakkāhā"}],"e3rab":"(قَدْ) حرف تحقيق (أَفْلَحَ مَنْ) ماض وفاعله والجملة جواب القسم (زَكَّاها) ماض ومفعوله والفاعل مستتر والجملة صلة.\r\n\r\n"},{"sura":91,"ayah":10,"words":[{"position":1,"arabic":"وَقَدْ","translation":"And indeed","transliteration":"waqad"},{"position":2,"arabic":"خَابَ","translation":"he fails","transliteration":"khāba"},{"position":3,"arabic":"مَن","translation":"who","transliteration":"man"},{"position":4,"arabic":"دَسَّىٰهَا","translation":"buries it","transliteration":"dassāhā"}],"e3rab":"معطوفة على ما قبلها.\r\n\r\n"},{"sura":91,"ayah":11,"words":[{"position":1,"arabic":"كَذَّبَتْ","translation":"Denied","transliteration":"kadhabat"},{"position":2,"arabic":"ثَمُودُ","translation":"Thamud","transliteration":"thamūdu"},{"position":3,"arabic":"بِطَغْوَىٰهَآ","translation":"by their transgression","transliteration":"biṭaghwāhā"}],"e3rab":"(كَذَّبَتْ ثَمُودُ) ماض وفاعله (بِطَغْواها) متعلقان بالفعل والجملة مستأنفة.\r\n\r\n"},{"sura":91,"ayah":12,"words":[{"position":1,"arabic":"إِذِ","translation":"When","transliteration":"idhi"},{"position":2,"arabic":"ٱنۢبَعَثَ","translation":"(was) sent forth","transliteration":"inbaʿatha"},{"position":3,"arabic":"أَشْقَىٰهَا","translation":"(the) most wicked of them","transliteration":"ashqāhā"}],"e3rab":"(إِذِ) ظرف زمان (انْبَعَثَ أَشْقاها) ماض وفاعله. والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":91,"ayah":13,"words":[{"position":1,"arabic":"فَقَالَ","translation":"But said","transliteration":"faqāla"},{"position":2,"arabic":"لَهُمْ","translation":"to them","transliteration":"lahum"},{"position":3,"arabic":"رَسُولُ","translation":"(the) Messenger","transliteration":"rasūlu"},{"position":4,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":5,"arabic":"نَاقَةَ","translation":"(It is the) she-camel","transliteration":"nāqata"},{"position":6,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":7,"arabic":"وَسُقْيَـٰهَا","translation":"and her drink","transliteration":"wasuq'yāhā"}],"e3rab":"(فَقالَ) ماض مبني على الفتح (لَهُمْ) متعلقان بالفعل (رَسُولُ اللَّهِ) فاعل مضاف إلى لفظ الجلالة والجملة معطوفة على ما قبلها.\r\n\r\n(ناقَةَ) منصوب على التحذير بفعل محذوف (اللَّهِ) لفظ الجلالة مضاف إليه (وَسُقْياها) معطوفة على ناقة.\r\n\r\n"},{"sura":91,"ayah":14,"words":[{"position":1,"arabic":"فَكَذَّبُوهُ","translation":"But they denied him","transliteration":"fakadhabūhu"},{"position":2,"arabic":"فَعَقَرُوهَا","translation":"and they hamstrung her","transliteration":"faʿaqarūhā"},{"position":3,"arabic":"فَدَمْدَمَ","translation":"So destroyed","transliteration":"fadamdama"},{"position":4,"arabic":"عَلَيْهِمْ","translation":"them","transliteration":"ʿalayhim"},{"position":5,"arabic":"رَبُّهُم","translation":"their Lord","transliteration":"rabbuhum"},{"position":6,"arabic":"بِذَنۢبِهِمْ","translation":"for their sin","transliteration":"bidhanbihim"},{"position":7,"arabic":"فَسَوَّىٰهَا","translation":"and leveled them","transliteration":"fasawwāhā"}],"e3rab":"(فَكَذَّبُوهُ) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها (فَعَقَرُوها) عطف على كذبوه بالفاء.\r\n\r\n(فَدَمْدَمَ) ماض مبني على الفتح (عَلَيْهِمْ) متعلقان بالفعل (رَبُّهُمْ) فاعل والجملة معطوفة على ما قبلها (بِذَنْبِهِمْ) متعلقان بالفعل (فَسَوَّاها) ماض ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":91,"ayah":15,"words":[{"position":1,"arabic":"وَلَا","translation":"And not","transliteration":"walā"},{"position":2,"arabic":"يَخَافُ","translation":"He fears","transliteration":"yakhāfu"},{"position":3,"arabic":"عُقْبَـٰهَا","translation":"its consequences","transliteration":"ʿuq'bāhā"}],"e3rab":"(وَلا) الواو حالية (لا) نافية (يَخافُ) مضارع فاعله مستتر (عُقْباها) مفعول به والجملة حال.\r\n\r\n"}]