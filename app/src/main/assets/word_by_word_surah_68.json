[{"sura":68,"ayah":1,"words":[{"position":1,"arabic":"نٓ ۚ","translation":"Nun","transliteration":"noon"},{"position":2,"arabic":"وَٱلْقَلَمِ","translation":"By the pen","transliteration":"wal-qalami"},{"position":3,"arabic":"وَمَا","translation":"and what","transliteration":"wamā"},{"position":4,"arabic":"يَسْطُرُونَ","translation":"they write","transliteration":"yasṭurūna"}],"e3rab":"(ن) حرف لا إعراب له (وَالْقَلَمِ) جار ومجرور متعلقان بفعل قسم محذوف تقديره أقسم (وَما) اسم موصول معطوف على ما قبله (يَسْطُرُونَ) مضارع وفاعله والجملة صلة.\r\n\r\n"},{"sura":68,"ayah":2,"words":[{"position":1,"arabic":"مَآ","translation":"Not","transliteration":"mā"},{"position":2,"arabic":"أَنتَ","translation":"you (are)","transliteration":"anta"},{"position":3,"arabic":"بِنِعْمَةِ","translation":"by (the) Grace","transliteration":"biniʿ'mati"},{"position":4,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":5,"arabic":"بِمَجْنُونٍۢ","translation":"a madman","transliteration":"bimajnūnin"}],"e3rab":"(ما) عاملة عمل ليس (أَنْتَ) اسمها (بِنِعْمَةِ) متعلقان بمجنون (رَبِّكَ) مضاف إليه (بِمَجْنُونٍ) خبر ما مجرور لفظا بالباء الزائدة منصوب محلا والجملة الاسمية جواب القسم لا محل لها.\r\n\r\n"},{"sura":68,"ayah":3,"words":[{"position":1,"arabic":"وَإِنَّ","translation":"And indeed","transliteration":"wa-inna"},{"position":2,"arabic":"لَكَ","translation":"for you","transliteration":"laka"},{"position":3,"arabic":"لَأَجْرًا","translation":"surely (is) a reward","transliteration":"la-ajran"},{"position":4,"arabic":"غَيْرَ","translation":"without","transliteration":"ghayra"},{"position":5,"arabic":"مَمْنُونٍۢ","translation":"end","transliteration":"mamnūnin"}],"e3rab":"(وَإِنَّ) الواو حرف عطف وإن حرف مشبه بالفعل (لَكَ) جار ومجرور خبر مقدم واللام المزحلقة (أجرا) اسم إن المؤخر (غَيْرَ) صفة أجرا (مَمْنُونٍ) مضاف إليه والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":68,"ayah":4,"words":[{"position":1,"arabic":"وَإِنَّكَ","translation":"And indeed, you","transliteration":"wa-innaka"},{"position":2,"arabic":"لَعَلَىٰ","translation":"surely (are)","transliteration":"laʿalā"},{"position":3,"arabic":"خُلُقٍ","translation":"(of) a moral character","transliteration":"khuluqin"},{"position":4,"arabic":"عَظِيمٍۢ","translation":"great","transliteration":"ʿaẓīmin"}],"e3rab":"(وَإِنَّكَ) إن واسمها (لَعَلى) اللام المزحلقة (على خُلُقٍ) خبرها (عَظِيمٍ) صفة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":68,"ayah":5,"words":[{"position":1,"arabic":"فَسَتُبْصِرُ","translation":"So you will see","transliteration":"fasatub'ṣiru"},{"position":2,"arabic":"وَيُبْصِرُونَ","translation":"and they will see","transliteration":"wayub'ṣirūna"}],"e3rab":"(فَسَتُبْصِرُ) السين للاستقبال ومضارع فاعله مستتر والجملة استئنافية لا محل لها (وَيُبْصِرُونَ) مضارع وفاعله والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":68,"ayah":6,"words":[{"position":1,"arabic":"بِأَييِّكُمُ","translation":"Which of you","transliteration":"bi-ayyikumu"},{"position":2,"arabic":"ٱلْمَفْتُونُ","translation":"(is) the afflicted one","transliteration":"l-maftūnu"}],"e3rab":"(بِأَيِّكُمُ) جار ومجرور خبر مقدم (الْمَفْتُونُ) مبتدأ مؤخر والجملة مفعول به لأحد الفعلين السابقين.\r\n\r\n"},{"sura":68,"ayah":7,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"رَبَّكَ","translation":"your Lord","transliteration":"rabbaka"},{"position":3,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":4,"arabic":"أَعْلَمُ","translation":"(is) most knowing","transliteration":"aʿlamu"},{"position":5,"arabic":"بِمَن","translation":"of (he) who","transliteration":"biman"},{"position":6,"arabic":"ضَلَّ","translation":"has strayed","transliteration":"ḍalla"},{"position":7,"arabic":"عَن","translation":"from","transliteration":"ʿan"},{"position":8,"arabic":"سَبِيلِهِۦ","translation":"His way","transliteration":"sabīlihi"},{"position":9,"arabic":"وَهُوَ","translation":"and He","transliteration":"wahuwa"},{"position":10,"arabic":"أَعْلَمُ","translation":"(is) most knowing","transliteration":"aʿlamu"},{"position":11,"arabic":"بِٱلْمُهْتَدِينَ","translation":"of the guided ones","transliteration":"bil-muh'tadīna"}],"e3rab":"(إِنَّ رَبَّكَ) إن واسمها (هُوَ أَعْلَمُ) مبتدأ وخبره والجملة خبر إن (بِمَنْ) متعلقان بأعلم (ضَلَّ) ماض فاعله مستتر والجملة صلة (عَنْ سَبِيلِهِ) متعلقان بالفعل (وَهُوَ أَعْلَمُ) الواو حرف عطف ومبتدأ وخبره والجملة معطوفة على ما قبلها (بِالْمُهْتَدِينَ) متعلقان بأعلم وجملة إن ربك.. تعليلية لا محل لها.\r\n\r\n"},{"sura":68,"ayah":8,"words":[{"position":1,"arabic":"فَلَا","translation":"So (do) not","transliteration":"falā"},{"position":2,"arabic":"تُطِعِ","translation":"obey","transliteration":"tuṭiʿi"},{"position":3,"arabic":"ٱلْمُكَذِّبِينَ","translation":"the deniers","transliteration":"l-mukadhibīna"}],"e3rab":"(فَلا تُطِعِ) الفاء الفصيحة ومضارع مجزوم بلا وفاعله مستتر (الْمُكَذِّبِينَ) مفعول به والجملة جواب شرط مقدر لا محل لها.\r\n\r\n"},{"sura":68,"ayah":9,"words":[{"position":1,"arabic":"وَدُّوا۟","translation":"They wish","transliteration":"waddū"},{"position":2,"arabic":"لَوْ","translation":"that","transliteration":"law"},{"position":3,"arabic":"تُدْهِنُ","translation":"you should compromise","transliteration":"tud'hinu"},{"position":4,"arabic":"فَيُدْهِنُونَ","translation":"so they would compromise","transliteration":"fayud'hinūna"}],"e3rab":"(وَدُّوا) ماض وفاعله (لَوْ تُدْهِنُ) لو مصدرية ومضارع فاعله مستتر ومعنى تدهن تلين لهم والمصدر المؤول من لو والفعل مفعول ودوا والجملة تعليل للنهي لا محل لها (فَيُدْهِنُونَ) الفاء عاطفة ومضارع مرفوع والواو فاعله والجملة خبر لمبتدأ محذوف والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":68,"ayah":10,"words":[{"position":1,"arabic":"وَلَا","translation":"And (do) not","transliteration":"walā"},{"position":2,"arabic":"تُطِعْ","translation":"obey","transliteration":"tuṭiʿ"},{"position":3,"arabic":"كُلَّ","translation":"every","transliteration":"kulla"},{"position":4,"arabic":"حَلَّافٍۢ","translation":"habitual swearer","transliteration":"ḥallāfin"},{"position":5,"arabic":"مَّهِينٍ","translation":"worthless","transliteration":"mahīnin"}],"e3rab":"(وَلا تُطِعْ) الواو حرف عطف ومضارع مجزوم بلا الناهية فاعله مستتر (كُلَّ) مفعوله (حَلَّافٍ) مضاف إليه (مَهِينٍ) صفة لمحذوف والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":68,"ayah":11,"words":[{"position":1,"arabic":"هَمَّازٍۢ","translation":"Defamer","transliteration":"hammāzin"},{"position":2,"arabic":"مَّشَّآءٍۭ","translation":"going about","transliteration":"mashāin"},{"position":3,"arabic":"بِنَمِيمٍۢ","translation":"with malicious gossip","transliteration":"binamīmin"}],"e3rab":"(هَمَّازٍ مَشَّاءٍ) صفتان للمحذوف (بِنَمِيمٍ) متعلقان بمشاء\r\n\r\n"},{"sura":68,"ayah":12,"words":[{"position":1,"arabic":"مَّنَّاعٍۢ","translation":"A preventer","transliteration":"mannāʿin"},{"position":2,"arabic":"لِّلْخَيْرِ","translation":"of (the) good","transliteration":"lil'khayri"},{"position":3,"arabic":"مُعْتَدٍ","translation":"transgressor","transliteration":"muʿ'tadin"},{"position":4,"arabic":"أَثِيمٍ","translation":"sinful","transliteration":"athīmin"}],"e3rab":"(مَنَّاعٍ) صفة أخرى (لِلْخَيْرِ) متعلقان بمناع (مُعْتَدٍ أَثِيمٍ عُتُلٍّ) صفات لنفس المحذوف وهو الأخنس بن شريق\r\n\r\n"},{"sura":68,"ayah":13,"words":[{"position":1,"arabic":"عُتُلٍّۭ","translation":"Cruel","transliteration":"ʿutullin"},{"position":2,"arabic":"بَعْدَ","translation":"after","transliteration":"baʿda"},{"position":3,"arabic":"ذَٰلِكَ","translation":"(all) that","transliteration":"dhālika"},{"position":4,"arabic":"زَنِيمٍ","translation":"utterly useless","transliteration":"zanīmin"}],"e3rab":"(عتل) صفات لنفس المحذوف وهو الأخنس بن شريق (بَعْدَ) ظرف زمان (ذلِكَ) اسم الإشارة مضاف إليه (زَنِيمٍ) صفة أخرى.\r\n\r\n"},{"sura":68,"ayah":14,"words":[{"position":1,"arabic":"أَن","translation":"Because","transliteration":"an"},{"position":2,"arabic":"كَانَ","translation":"(he) is","transliteration":"kāna"},{"position":3,"arabic":"ذَا","translation":"a possessor","transliteration":"dhā"},{"position":4,"arabic":"مَالٍۢ","translation":"(of) wealth","transliteration":"mālin"},{"position":5,"arabic":"وَبَنِينَ","translation":"and children","transliteration":"wabanīna"}],"e3rab":"(أَنْ كانَ) أن حرف مصدري ونصب وماض ناقص اسمه مستتر (ذا) خبره (مالٍ) مضاف إليه (وَبَنِينَ) معطوف على مال.\r\n\r\n"},{"sura":68,"ayah":15,"words":[{"position":1,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":2,"arabic":"تُتْلَىٰ","translation":"are recited","transliteration":"tut'lā"},{"position":3,"arabic":"عَلَيْهِ","translation":"to him","transliteration":"ʿalayhi"},{"position":4,"arabic":"ءَايَـٰتُنَا","translation":"Our Verses","transliteration":"āyātunā"},{"position":5,"arabic":"قَالَ","translation":"he says","transliteration":"qāla"},{"position":6,"arabic":"أَسَـٰطِيرُ","translation":"Stories","transliteration":"asāṭīru"},{"position":7,"arabic":"ٱلْأَوَّلِينَ","translation":"(of) the former (people)","transliteration":"l-awalīna"}],"e3rab":"(إِذا) ظرفية شرطية غير جازمة (تُتْلى) مضارع مبني للمجهول والجملة في محل جر بالإضافة (عَلَيْهِ) متعلقان بالفعل (آياتُنا) نائب فاعل (قالَ) ماض فاعله مستتر (أَساطِيرُ) خبر لمبتدأ محذوف (الْأَوَّلِينَ) مضاف إليه والجملة الفعلية جواب الشرط لا محل لها.\r\n\r\n"},{"sura":68,"ayah":16,"words":[{"position":1,"arabic":"سَنَسِمُهُۥ","translation":"We will brand him","transliteration":"sanasimuhu"},{"position":2,"arabic":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":3,"arabic":"ٱلْخُرْطُومِ","translation":"the snout","transliteration":"l-khur'ṭūmi"}],"e3rab":"(سَنَسِمُهُ) السين للاستقبال ومضارع ومفعوله والفاعل مستتر (عَلَى الْخُرْطُومِ) متعلقان بالفعل والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":68,"ayah":17,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"بَلَوْنَـٰهُمْ","translation":"have tried them","transliteration":"balawnāhum"},{"position":3,"arabic":"كَمَا","translation":"as","transliteration":"kamā"},{"position":4,"arabic":"بَلَوْنَآ","translation":"We tried","transliteration":"balawnā"},{"position":5,"arabic":"أَصْحَـٰبَ","translation":"(the) companions","transliteration":"aṣḥāba"},{"position":6,"arabic":"ٱلْجَنَّةِ","translation":"(of) the garden","transliteration":"l-janati"},{"position":7,"arabic":"إِذْ","translation":"when","transliteration":"idh"},{"position":8,"arabic":"أَقْسَمُوا۟","translation":"they swore","transliteration":"aqsamū"},{"position":9,"arabic":"لَيَصْرِمُنَّهَا","translation":"to pluck its fruit","transliteration":"layaṣrimunnahā"},{"position":10,"arabic":"مُصْبِحِينَ","translation":"(in the) morning","transliteration":"muṣ'biḥīna"}],"e3rab":"(إِنَّا بَلَوْناهُمْ) إن واسمها وماض وفاعله ومفعوله والجملة الفعلية خبر إن والجملة الاسمية استئنافية لا محل لها (كَما) الكاف حرف تشبيه وجر وما مصدرية (بَلَوْنا) ماض وفاعله (أَصْحابَ الْجَنَّةِ) مفعوله المضاف إلى الجنة والمصدر المؤول من ما والفعل في محل جر بالكاف والجار والمجرور متعلقان بمحذوف صفة لمصدر محذوف (إِذْ) ظرف زمان (أَقْسَمُوا) ماض وفاعله والجملة في محل جر بالإضافة (لَيَصْرِمُنَّها) اللام واقعة في جواب القسم ومضارع مرفوع بثبوت النون المحذوفة لتوالي الأمثال والواو المحذوفة فاعل والها مفعول به (مُصْبِحِينَ) حال والجملة جواب القسم لا محل لها.\r\n\r\n"},{"sura":68,"ayah":18,"words":[{"position":1,"arabic":"وَلَا","translation":"And not","transliteration":"walā"},{"position":2,"arabic":"يَسْتَثْنُونَ","translation":"making exception","transliteration":"yastathnūna"}],"e3rab":"لا نافية ومضارع مرفوع والواو فاعله والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":68,"ayah":19,"words":[{"position":1,"arabic":"فَطَافَ","translation":"So there came","transliteration":"faṭāfa"},{"position":2,"arabic":"عَلَيْهَا","translation":"upon it","transliteration":"ʿalayhā"},{"position":3,"arabic":"طَآئِفٌۭ","translation":"a visitation","transliteration":"ṭāifun"},{"position":4,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":5,"arabic":"رَّبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":6,"arabic":"وَهُمْ","translation":"while they","transliteration":"wahum"},{"position":7,"arabic":"نَآئِمُونَ","translation":"were asleep","transliteration":"nāimūna"}],"e3rab":"(فَطافَ) ماض (عَلَيْها) متعلقان بالفعل (طائِفٌ) فاعل (مِنْ رَبِّكَ) متعلقان بطائف والجملة معطوفة على ما قبلها (وَهُمْ نائِمُونَ) مبتدأ وخبره والجملة حال.\r\n\r\n"},{"sura":68,"ayah":20,"words":[{"position":1,"arabic":"فَأَصْبَحَتْ","translation":"So it became","transliteration":"fa-aṣbaḥat"},{"position":2,"arabic":"كَٱلصَّرِيمِ","translation":"as if reaped","transliteration":"kal-ṣarīmi"}],"e3rab":"(فَأَصْبَحَتْ) ماض ناقص اسمه مستتر (كَالصَّرِيمِ) جار ومجرور خبر أصبحت والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":68,"ayah":21,"words":[{"position":1,"arabic":"فَتَنَادَوْا۟","translation":"And they called one another","transliteration":"fatanādaw"},{"position":2,"arabic":"مُصْبِحِينَ","translation":"(at) morning","transliteration":"muṣ'biḥīna"}],"e3rab":"(فَتَنادَوْا) ماض وفاعله (مُصْبِحِينَ) حال والجملة معطوفة على أقسموا.\r\n\r\n"},{"sura":68,"ayah":22,"words":[{"position":1,"arabic":"أَنِ","translation":"That","transliteration":"ani"},{"position":2,"arabic":"ٱغْدُوا۟","translation":"Go early","transliteration":"igh'dū"},{"position":3,"arabic":"عَلَىٰ","translation":"to","transliteration":"ʿalā"},{"position":4,"arabic":"حَرْثِكُمْ","translation":"your crop","transliteration":"ḥarthikum"},{"position":5,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":6,"arabic":"كُنتُمْ","translation":"you would","transliteration":"kuntum"},{"position":7,"arabic":"صَـٰرِمِينَ","translation":"pluck (the) fruit","transliteration":"ṣārimīna"}],"e3rab":"(أَنِ اغْدُوا) أن حرف تفسير وأمر وفاعله والجملة مفسرة لا محل لها (عَلى حَرْثِكُمْ) متعلقان بالفعل (إِنْ كُنْتُمْ) إن شرطية جازمة وكان واسمها (صارِمِينَ) خبرها والجملة ابتدائية لا محل لها وجواب الشرط محذوف.\r\n\r\n"},{"sura":68,"ayah":23,"words":[{"position":1,"arabic":"فَٱنطَلَقُوا۟","translation":"So they went","transliteration":"fa-inṭalaqū"},{"position":2,"arabic":"وَهُمْ","translation":"while they","transliteration":"wahum"},{"position":3,"arabic":"يَتَخَـٰفَتُونَ","translation":"lowered (their) voices","transliteration":"yatakhāfatūna"}],"e3rab":"(فَانْطَلَقُوا) ماض وفاعله والجملة معطوفة على ما قبلها (وَهُمْ) الواو للحال مبتدأ (يَتَخافَتُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر المبتدأ والجملة الاسمية حال.\r\n\r\n"},{"sura":68,"ayah":24,"words":[{"position":1,"arabic":"أَن","translation":"That","transliteration":"an"},{"position":2,"arabic":"لَّا","translation":"Not","transliteration":"lā"},{"position":3,"arabic":"يَدْخُلَنَّهَا","translation":"will enter it","transliteration":"yadkhulannahā"},{"position":4,"arabic":"ٱلْيَوْمَ","translation":"today","transliteration":"l-yawma"},{"position":5,"arabic":"عَلَيْكُم","translation":"upon you","transliteration":"ʿalaykum"},{"position":6,"arabic":"مِّسْكِينٌۭ","translation":"any poor person","transliteration":"mis'kīnun"}],"e3rab":"(أَنْ) مفسرة (لا يَدْخُلَنَّهَا) لا نافية ومضارع مبني على الفتح لاتصاله بنون التوكيد الثقيلة والها مفعول به (الْيَوْمَ) ظرف زمان (عَلَيْكُمْ) متعلقان بالفعل (مِسْكِينٌ) فاعل والجملة مفسرة لا محل لها.\r\n\r\n"},{"sura":68,"ayah":25,"words":[{"position":1,"arabic":"وَغَدَوْا۟","translation":"And they went early","transliteration":"waghadaw"},{"position":2,"arabic":"عَلَىٰ","translation":"with","transliteration":"ʿalā"},{"position":3,"arabic":"حَرْدٍۢ","translation":"determination","transliteration":"ḥardin"},{"position":4,"arabic":"قَـٰدِرِينَ","translation":"able","transliteration":"qādirīna"}],"e3rab":"(وَغَدَوْا) ماض وفاعله والجملة معطوفة على ما قبلها (عَلى حَرْدٍ) متعلقان بالفعل وحرد أي منع الفقراء (قادِرِينَ) حال.\r\n\r\n"},{"sura":68,"ayah":26,"words":[{"position":1,"arabic":"فَلَمَّا","translation":"But when","transliteration":"falammā"},{"position":2,"arabic":"رَأَوْهَا","translation":"they saw it","transliteration":"ra-awhā"},{"position":3,"arabic":"قَالُوٓا۟","translation":"they said","transliteration":"qālū"},{"position":4,"arabic":"إِنَّا","translation":"Indeed, we","transliteration":"innā"},{"position":5,"arabic":"لَضَآلُّونَ","translation":"(are) surely lost","transliteration":"laḍāllūna"}],"e3rab":"(فَلَمَّا) الفاء حرف استئناف (لما) ظرفية شرطية غير جازمة (رَأَوْها) ماض وفاعله ومفعوله والجملة في محل جر بالإضافة (قالُوا) ماض وفاعله والجملة جواب الشرط لا محل لها (إِنَّا) إن واسمها (لَضَالُّونَ) اللام المزحلقة (ضالون) خبرها والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":68,"ayah":27,"words":[{"position":1,"arabic":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":2,"arabic":"نَحْنُ","translation":"We","transliteration":"naḥnu"},{"position":3,"arabic":"مَحْرُومُونَ","translation":"(are) deprived","transliteration":"maḥrūmūna"}],"e3rab":"(بَلْ) حرف عطف وإضراب (نَحْنُ مَحْرُومُونَ) مبتدأ وخبره والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":68,"ayah":28,"words":[{"position":1,"arabic":"قَالَ","translation":"Said","transliteration":"qāla"},{"position":2,"arabic":"أَوْسَطُهُمْ","translation":"(the) most moderate of them","transliteration":"awsaṭuhum"},{"position":3,"arabic":"أَلَمْ","translation":"Did not","transliteration":"alam"},{"position":4,"arabic":"أَقُل","translation":"I tell","transliteration":"aqul"},{"position":5,"arabic":"لَّكُمْ","translation":"you","transliteration":"lakum"},{"position":6,"arabic":"لَوْلَا","translation":"'Why not","transliteration":"lawlā"},{"position":7,"arabic":"تُسَبِّحُونَ","translation":"you glorify (Allah)?'","transliteration":"tusabbiḥūna"}],"e3rab":"(قالَ أَوْسَطُهُمْ) ماض وفاعله والجملة استئنافية لا محل لها (أَلَمْ أَقُلْ) الهمزة للاستفهام ومضارع مجزوم بلم وفاعله مستتر (لَكُمْ) متعلقان بالفعل (لَوْ لا) حرف تحضيض (تُسَبِّحُونَ) مضارع مرفوع والواو فاعله والجملة مقول القول.\r\n\r\n"},{"sura":68,"ayah":29,"words":[{"position":1,"arabic":"قَالُوا۟","translation":"They said","transliteration":"qālū"},{"position":2,"arabic":"سُبْحَـٰنَ","translation":"Glory be","transliteration":"sub'ḥāna"},{"position":3,"arabic":"رَبِّنَآ","translation":"(to) our Lord","transliteration":"rabbinā"},{"position":4,"arabic":"إِنَّا","translation":"Indeed, we","transliteration":"innā"},{"position":5,"arabic":"كُنَّا","translation":"[we] were","transliteration":"kunnā"},{"position":6,"arabic":"ظَـٰلِمِينَ","translation":"wrongdoers","transliteration":"ẓālimīna"}],"e3rab":"(قالُوا) ماض وفاعله والجملة استئنافية لا محل لها (سُبْحانَ) مفعول مطلق لفعل محذوف (رَبِّنا) مضاف إليه (إِنَّا كُنَّا) إن واسمها وكان واسمها (ظالِمِينَ) خبرها والجملة خبر إن وجملة إنا.. تعليل والكلام سبحان.. مقول القول.\r\n\r\n"},{"sura":68,"ayah":30,"words":[{"position":1,"arabic":"فَأَقْبَلَ","translation":"Then approached","transliteration":"fa-aqbala"},{"position":2,"arabic":"بَعْضُهُمْ","translation":"some of them","transliteration":"baʿḍuhum"},{"position":3,"arabic":"عَلَىٰ","translation":"to","transliteration":"ʿalā"},{"position":4,"arabic":"بَعْضٍۢ","translation":"others","transliteration":"baʿḍin"},{"position":5,"arabic":"يَتَلَـٰوَمُونَ","translation":"blaming each other","transliteration":"yatalāwamūna"}],"e3rab":"(فَأَقْبَلَ بَعْضُهُمْ) ماض وفاعله والجملة معطوفة على ما قبلها (عَلى بَعْضٍ) متعلقان بالفعل (يَتَلاوَمُونَ) مضارع مرفوع والواو فاعله والجملة حال.\r\n\r\n"},{"sura":68,"ayah":31,"words":[{"position":1,"arabic":"قَالُوا۟","translation":"They said","transliteration":"qālū"},{"position":2,"arabic":"يَـٰوَيْلَنَآ","translation":"O woe to us","transliteration":"yāwaylanā"},{"position":3,"arabic":"إِنَّا","translation":"Indeed, we","transliteration":"innā"},{"position":4,"arabic":"كُنَّا","translation":"[we] were","transliteration":"kunnā"},{"position":5,"arabic":"طَـٰغِينَ","translation":"transgressors","transliteration":"ṭāghīna"}],"e3rab":"(قالُوا) ماض وفاعله (يا) حرف نداء (وَيْلَنا) منادى مضاف وجملة النداء مقول القول (إِنَّا) إن واسمها (كُنَّا طاغِينَ) كان واسمها وخبرها الجملة خبر إن.\r\n\r\n"},{"sura":68,"ayah":32,"words":[{"position":1,"arabic":"عَسَىٰ","translation":"Perhaps","transliteration":"ʿasā"},{"position":2,"arabic":"رَبُّنَآ","translation":"our Lord","transliteration":"rabbunā"},{"position":3,"arabic":"أَن","translation":"[that]","transliteration":"an"},{"position":4,"arabic":"يُبْدِلَنَا","translation":"will substitute for us","transliteration":"yub'dilanā"},{"position":5,"arabic":"خَيْرًۭا","translation":"a better","transliteration":"khayran"},{"position":6,"arabic":"مِّنْهَآ","translation":"than it","transliteration":"min'hā"},{"position":7,"arabic":"إِنَّآ","translation":"Indeed, we","transliteration":"innā"},{"position":8,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":9,"arabic":"رَبِّنَا","translation":"our Lord","transliteration":"rabbinā"},{"position":10,"arabic":"رَٰغِبُونَ","translation":"turn devoutly","transliteration":"rāghibūna"}],"e3rab":"(عَسى رَبُّنا) ماض ناقص واسمه (أَنْ يُبْدِلَنا) مضارع منصوب بأن ومفعوله الأول والفاعل مستتر (خَيْراً) مفعوله الثاني والمصدر المؤول من أن والفعل خبر عسى (مِنْها) متعلقان بخيرا (إِنَّا) إن واسمها (إِلى رَبِّنا) متعلقان براغبون (راغِبُونَ) خبر إن والجملة الاسمية تعليل وجملة عسى.. مقول القول.\r\n\r\n"},{"sura":68,"ayah":33,"words":[{"position":1,"arabic":"كَذَٰلِكَ","translation":"Such","transliteration":"kadhālika"},{"position":2,"arabic":"ٱلْعَذَابُ ۖ","translation":"(is) the punishment","transliteration":"l-ʿadhābu"},{"position":3,"arabic":"وَلَعَذَابُ","translation":"And surely the punishment","transliteration":"walaʿadhābu"},{"position":4,"arabic":"ٱلْـَٔاخِرَةِ","translation":"(of) the Hereafter","transliteration":"l-ākhirati"},{"position":5,"arabic":"أَكْبَرُ ۚ","translation":"(is) greater","transliteration":"akbaru"},{"position":6,"arabic":"لَوْ","translation":"if","transliteration":"law"},{"position":7,"arabic":"كَانُوا۟","translation":"they","transliteration":"kānū"},{"position":8,"arabic":"يَعْلَمُونَ","translation":"know","transliteration":"yaʿlamūna"}],"e3rab":"(كَذلِكَ) جار ومجرور متعلقان بمحذوف خبر مقدم (الْعَذابُ) مبتدأ مؤخر والجملة استئنافية لا محل لها (وَلَعَذابُ) الواو حالية واللام لام الابتداء (عذاب الْآخِرَةِ) مبتدأ مضاف إلى الآخرة (أَكْبَرُ) خبر والجملة حال (لَوْ) شرطية غير جازمة (كانُوا) كان واسمها (يَعْلَمُونَ) مضارع مرفوع والواو فاعله والجملة خبر كانوا والجملة الفعلية ابتدائية لا محل لها وجواب الشرط محذوف.\r\n\r\n"},{"sura":68,"ayah":34,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"لِلْمُتَّقِينَ","translation":"for the righteous","transliteration":"lil'muttaqīna"},{"position":3,"arabic":"عِندَ","translation":"with","transliteration":"ʿinda"},{"position":4,"arabic":"رَبِّهِمْ","translation":"their Lord","transliteration":"rabbihim"},{"position":5,"arabic":"جَنَّـٰتِ","translation":"(are) Gardens","transliteration":"jannāti"},{"position":6,"arabic":"ٱلنَّعِيمِ","translation":"(of) Delight","transliteration":"l-naʿīmi"}],"e3rab":"(إِنَّ) حرف مشبه بالفعل (لِلْمُتَّقِينَ) متعلقان بمحذوف خبر إن (عِنْدَ رَبِّهِمْ) ظرف مكان مضاف إلى ربهم (جَنَّاتِ) اسم إن المؤخر (النَّعِيمِ) مضاف إليه.\r\n\r\n"},{"sura":68,"ayah":35,"words":[{"position":1,"arabic":"أَفَنَجْعَلُ","translation":"Then will We treat","transliteration":"afanajʿalu"},{"position":2,"arabic":"ٱلْمُسْلِمِينَ","translation":"the Muslims","transliteration":"l-mus'limīna"},{"position":3,"arabic":"كَٱلْمُجْرِمِينَ","translation":"like the criminals","transliteration":"kal-muj'rimīna"}],"e3rab":"(أَفَنَجْعَلُ) الهمزة للاستفهام والفاء حرف عطف ومضارع فاعله مستتر (الْمُسْلِمِينَ) مفعول به أول (كَالْمُجْرِمِينَ) جار ومجرور في موضع المفعول الثاني والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":68,"ayah":36,"words":[{"position":1,"arabic":"مَا","translation":"What","transliteration":"mā"},{"position":2,"arabic":"لَكُمْ","translation":"(is) for you","transliteration":"lakum"},{"position":3,"arabic":"كَيْفَ","translation":"How","transliteration":"kayfa"},{"position":4,"arabic":"تَحْكُمُونَ","translation":"(do) you judge","transliteration":"taḥkumūna"}],"e3rab":"(ما) اسم استفهام مبتدأ (لَكُمْ) جار ومجرور خبر المبتدأ والجملة استفهامية لا محل لها