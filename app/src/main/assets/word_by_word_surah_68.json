,{"position":7,"arabic":"يَوْمِ","translation":"(the) Day","transliteration":"yawmi"},{"position":8,"arabic":"ٱلْقِيَـٰمَةِ ۙ","translation":"(of) the Resurrection","transliteration":"l-qiyāmati"},{"position":9,"arabic":"إِنَّ","translation":"indeed","transliteration":"inna"},{"position":10,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":11,"arabic":"لَمَا","translation":"(is) what","transliteration":"lamā"},{"position":12,"arabic":"تَحْكُمُونَ","translation":"you judge","transliteration":"taḥkumūna"}],"e3rab":"(أَمْ) حرف عطف (لَكُمْ أَيْمانٌ) خبر مقدم ومبتدأ مؤخر (عَلَيْنا) صفة أيمان (بالِغَةٌ) صفة ثانية (إِلى يَوْمِ) متعلقان ببالغة (الْقِيامَةِ) مضاف إليه (إِنَّ) حرف مشبه بالفعل (لَكُمْ) متعلقان بمحذوف خبر إن المقدم (لَما) اللام المزحلقة (ما) موصولية اسم إن المؤخر (تَحْكُمُونَ) مضارع مرفوع بثبوت النون والواو فاعله والجملة الفعلية صلة والجملة الاسمية جواب لقسم ملحوظ من أيمان لا محل لها.\r\n\r\n"},{"sura":68,"ayah":40,"words":[{"position":1,"arabic":"سَلْهُمْ","translation":"Ask them","transliteration":"salhum"},{"position":2,"arabic":"أَيُّهُم","translation":"which of them","transliteration":"ayyuhum"},{"position":3,"arabic":"بِذَٰلِكَ","translation":"for that","transliteration":"bidhālika"},{"position":4,"arabic":"زَعِيمٌ","translation":"(is) responsible","transliteration":"zaʿīmun"}],"e3rab":"(سَلْهُمْ) أمر ومفعوله والفاعل مستتر والجملة استئنافية لا محل لها (أَيُّهُمْ) مبتدأ (بِذلِكَ) متعلقان بالخبر (زَعِيمٌ) خبر مرفوع والجملة الاسمية سدت مسد المفعول الثاني للفعل سل.\r\n\r\n"},{"sura":68,"ayah":41,"words":[{"position":1,"arabic":"أَمْ","translation":"Or","transliteration":"am"},{"position":2,"arabic":"لَهُمْ","translation":"(are) for them","transliteration":"lahum"},{"position":3,"arabic":"شُرَكَآءُ","translation":"partners","transliteration":"shurakāu"},{"position":4,"arabic":"فَلْيَأْتُوا۟","translation":"Then let them bring","transliteration":"falyatū"},{"position":5,"arabic":"بِشُرَكَآئِهِمْ","translation":"their partners","transliteration":"bishurakāihim"},{"position":6,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":7,"arabic":"كَانُوا۟","translation":"they are","transliteration":"kānū"},{"position":8,"arabic":"صَـٰدِقِينَ","translation":"truthful","transliteration":"ṣādiqīna"}],"e3rab":"(أَمْ) حرف عطف (لَهُمْ شُرَكاءُ) خبر مقدم ومبتدأ مؤخر والجملة معطوفة على ما قبلها (فَلْيَأْتُوا) الفاء الفصيحة ومضارع مجزوم بلام الأمر وعلامة جزمه حذف النون والواو فاعله والجملة جواب شرط مقدر لا محل لها (بِشُرَكائِهِمْ) متعلقان بالفعل (إِنْ) حرف شرط جازم (كانُوا صادِقِينَ) كان واسمها وخبرها والجملة ابتدائية لا محل لها وجواب الشرط محذوف.\r\n\r\n"},{"sura":68,"ayah":42,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"يُكْشَفُ","translation":"will be uncovered","transliteration":"yuk'shafu"},{"position":3,"arabic":"عَن","translation":"from","transliteration":"ʿan"},{"position":4,"arabic":"سَاقٍۢ","translation":"the shin","transliteration":"sāqin"},{"position":5,"arabic":"وَيُدْعَوْنَ","translation":"and they will be called","transliteration":"wayud'ʿawna"},{"position":6,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":7,"arabic":"ٱلسُّجُودِ","translation":"prostrate","transliteration":"l-sujūdi"},{"position":8,"arabic":"فَلَا","translation":"but not","transliteration":"falā"},{"position":9,"arabic":"يَسْتَطِيعُونَ","translation":"they will be able","transliteration":"yastaṭīʿūna"}],"e3rab":"(يَوْمَ يُكْشَفُ) ظرف زمان ومضارع مبني للمجهول (عَنْ ساقٍ) متعلقان بالفعل وهما مناب نائب الفاعل والجملة في محل جر بالإضافة (وَيُدْعَوْنَ) مضارع مبني للمجهول والواو نائب فاعل (إِلَى السُّجُودِ) متعلقان بالفعل والجملة معطوفة على ما قبلها (فَلا) لا نافية ومضارع وفاعله والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":68,"ayah":43,"words":[{"position":1,"arabic":"خَـٰشِعَةً","translation":"Humbled","transliteration":"khāshiʿatan"},{"position":2,"arabic":"أَبْصَـٰرُهُمْ","translation":"their eyes","transliteration":"abṣāruhum"},{"position":3,"arabic":"تَرْهَقُهُمْ","translation":"will cover them","transliteration":"tarhaquhum"},{"position":4,"arabic":"ذِلَّةٌۭ ۖ","translation":"humiliation","transliteration":"dhillatun"},{"position":5,"arabic":"وَقَدْ","translation":"And indeed","transliteration":"waqad"},{"position":6,"arabic":"كَانُوا۟","translation":"they were","transliteration":"kānū"},{"position":7,"arabic":"يُدْعَوْنَ","translation":"called","transliteration":"yud'ʿawna"},{"position":8,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":9,"arabic":"ٱلسُّجُودِ","translation":"prostrate","transliteration":"l-sujūdi"},{"position":10,"arabic":"وَهُمْ","translation":"while they","transliteration":"wahum"},{"position":11,"arabic":"سَـٰلِمُونَ","translation":"(were) sound","transliteration":"sālimūna"}],"e3rab":"(خاشِعَةً) حال (أَبْصارُهُمْ) فاعل خاشعة (تَرْهَقُهُمْ ذِلَّةٌ) مضارع ومفعوله وفاعل مؤخر والجملة حال ثانية (وَ) الواو للحال (قَدْ) حرف تحقيق (كانُوا) كان واسمها (يُدْعَوْنَ) مضارع مبني للمجهول والواو نائب فاعل (إِلَى السُّجُودِ) متعلقان بالفعل والجملة خبر كانوا وجملة قد كانوا.. حالية (وَهُمْ سالِمُونَ) مبتدأ وخبره والجملة حال.\r\n\r\n"},{"sura":68,"ayah":44,"words":[{"position":1,"arabic":"فَذَرْنِى","translation":"So leave Me","transliteration":"fadharnī"},{"position":2,"arabic":"وَمَن","translation":"and whoever","transliteration":"waman"},{"position":3,"arabic":"يُكَذِّبُ","translation":"denies","transliteration":"yukadhibu"},{"position":4,"arabic":"بِهَـٰذَا","translation":"this","transliteration":"bihādhā"},{"position":5,"arabic":"ٱلْحَدِيثِ ۖ","translation":"Statement","transliteration":"l-ḥadīthi"},{"position":6,"arabic":"سَنَسْتَدْرِجُهُم","translation":"We will progressively lead them","transliteration":"sanastadrijuhum"},{"position":7,"arabic":"مِّنْ","translation":"from","transliteration":"min"},{"position":8,"arabic":"حَيْثُ","translation":"where","transliteration":"ḥaythu"},{"position":9,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":10,"arabic":"يَعْلَمُونَ","translation":"they know","transliteration":"yaʿlamūna"}],"e3rab":"(فَذَرْنِي) الفاء الفصيحة وأمر ومفعوله والفاعل مستتر ومعنى ذرني دعني والجملة جواب شرط مقدر لا محل لها (وَمَنْ) الواو حرف عطف (مَنْ) اسم موصول معطوف على ياء المتكلم (يُكَذِّبُ) مضارع فاعله مستتر والجملة صلة (بِهذَا) متعلقان بالفعل (الْحَدِيثِ) بدل من اسم الإشارة (سَنَسْتَدْرِجُهُمْ) السين للاستقبال ومضارع ومفعوله والفاعل مستتر والجملة استئنافية لا محل لها (مِنْ حَيْثُ) متعلقان بالفعل (لا يَعْلَمُونَ) لا نافية ومضارع مرفوع والواو فاعله والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":68,"ayah":45,"words":[{"position":1,"arabic":"وَأُمْلِى","translation":"And I will give respite","transliteration":"wa-um'lī"},{"position":2,"arabic":"لَهُمْ ۚ","translation":"to them","transliteration":"lahum"},{"position":3,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":4,"arabic":"كَيْدِى","translation":"My plan","transliteration":"kaydī"},{"position":5,"arabic":"مَتِينٌ","translation":"(is) firm","transliteration":"matīnun"}],"e3rab":"(وَأُمْلِي) مضارع فاعله مستتر ومعناه أمهلهم (لَهُمْ) متعلقان بالفعل والجملة معطوفة على سنستدرجهم (إِنَّ كَيْدِي مَتِينٌ) إن واسمها وخبرها والجملة تعليلية لا محل لها.\r\n\r\n"},{"sura":68,"ayah":46,"words":[{"position":1,"arabic":"أَمْ","translation":"Or","transliteration":"am"},{"position":2,"arabic":"تَسْـَٔلُهُمْ","translation":"you ask them","transliteration":"tasaluhum"},{"position":3,"arabic":"أَجْرًۭا","translation":"a payment","transliteration":"ajran"},{"position":4,"arabic":"فَهُم","translation":"so they","transliteration":"fahum"},{"position":5,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":6,"arabic":"مَّغْرَمٍۢ","translation":"(the) debt","transliteration":"maghramin"},{"position":7,"arabic":"مُّثْقَلُونَ","translation":"(are) burdened","transliteration":"muth'qalūna"}],"e3rab":"(أَمْ) حرف عطف (تَسْئَلُهُمْ) مضارع ومفعوله الأول والفاعل مستتر (أَجْراً) مفعول به ثان والجملة معطوفة على ما قبلها (فَهُمْ) مبتدأ (مِنْ مَغْرَمٍ مُثْقَلُونَ) متعلقان بالخبر (مُثْقَلُونَ) خبر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":68,"ayah":47,"words":[{"position":1,"arabic":"أَمْ","translation":"Or","transliteration":"am"},{"position":2,"arabic":"عِندَهُمُ","translation":"(is) with them","transliteration":"ʿindahumu"},{"position":3,"arabic":"ٱلْغَيْبُ","translation":"the unseen","transliteration":"l-ghaybu"},{"position":4,"arabic":"فَهُمْ","translation":"so they","transliteration":"fahum"},{"position":5,"arabic":"يَكْتُبُونَ","translation":"write it","transliteration":"yaktubūna"}],"e3rab":"(أَمْ) حرف عطف (عِنْدَهُمُ) ظرف مكان متعلق بمحذوف خبر مقدم (الْغَيْبُ) مبتدأ مؤخر والجملة معطوفة على ما قبلها (فَهُمْ يَكْتُبُونَ) مبتدأ ومضارع مرفوع بثبوت النون والواو فاعله والجملة الفعلية خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":68,"ayah":48,"words":[{"position":1,"arabic":"فَٱصْبِرْ","translation":"So be patient","transliteration":"fa-iṣ'bir"},{"position":2,"arabic":"لِحُكْمِ","translation":"for (the) decision","transliteration":"liḥuk'mi"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":5,"arabic":"تَكُن","translation":"be","transliteration":"takun"},{"position":6,"arabic":"كَصَاحِبِ","translation":"like (the) companion","transliteration":"kaṣāḥibi"},{"position":7,"arabic":"ٱلْحُوتِ","translation":"(of) the fish","transliteration":"l-ḥūti"},{"position":8,"arabic":"إِذْ","translation":"when","transliteration":"idh"},{"position":9,"arabic":"نَادَىٰ","translation":"he called out","transliteration":"nādā"},{"position":10,"arabic":"وَهُوَ","translation":"while he","transliteration":"wahuwa"},{"position":11,"arabic":"مَكْظُومٌۭ","translation":"(was) distressed","transliteration":"makẓūmun"}],"e3rab":"(فَاصْبِرْ) الفاء الفصيحة وأمر فاعله مستتر (لِحُكْمِ) متعلقان بالفعل (رَبِّكَ) مضاف إليه والجملة جواب شرط مقدر لا محل لها (وَلا تَكُنْ) الواو حرف عطف ومضارع ناقص مجزوم بلا الناهية واسمه مستتر (كَصاحِبِ) متعلقان بمحذوف خبر تكن (الْحُوتِ) مضاف إليه وهو يونس عليه السلام والجملة معطوفة على ما قبلها (إِذْ) ظرف زمان متعلق بفعل محذوف تقديره اذكر (نادى) ماض فاعله مستتر والجملة في محل جر بالإضافة (وَهُوَ مَكْظُومٌ) مبتدأ وخبره والجملة حال.\r\n\r\n"},{"sura":68,"ayah":49,"words":[{"position":1,"arabic":"لَّوْلَآ","translation":"If not","transliteration":"lawlā"},{"position":2,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":3,"arabic":"تَدَٰرَكَهُۥ","translation":"overtook him","transliteration":"tadārakahu"},{"position":4,"arabic":"نِعْمَةٌۭ","translation":"a Favor","transliteration":"niʿ'matun"},{"position":5,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":6,"arabic":"رَّبِّهِۦ","translation":"his Lord","transliteration":"rabbihi"},{"position":7,"arabic":"لَنُبِذَ","translation":"surely he would have been thrown","transliteration":"lanubidha"},{"position":8,"arabic":"بِٱلْعَرَآءِ","translation":"onto (the) naked shore","transliteration":"bil-ʿarāi"},{"position":9,"arabic":"وَهُوَ","translation":"while he","transliteration":"wahuwa"},{"position":10,"arabic":"مَذْمُومٌۭ","translation":"(was) blamed","transliteration":"madhmūmun"}],"e3rab":"(لَوْ لا) حرف شرط غير جازم (أَنْ تَدارَكَهُ) مضارع منصوب بأن ومفعوله (نِعْمَةٌ) فاعل (مِنْ رَبِّهِ) متعلقان بنعمة والمصدر المؤول من أن والفعل في محل رفع مبتدأ خبره محذوف (لَنُبِذَ) اللام واقعة في جواب الشرط وماض مبني للمجهول ونائب الفاعل مستتر (بِالْعَراءِ) متعلقان بالفعل والجملة جواب الشرط لا محل لها (وَهُوَ مَذْمُومٌ) مبتدأ وخبره والجملة حال.\r\n\r\n"},{"sura":68,"ayah":50,"words":[{"position":1,"arabic":"فَٱجْتَبَـٰهُ","translation":"But chose him","transliteration":"fa-ij'tabāhu"},{"position":2,"arabic":"رَبُّهُۥ","translation":"his Lord","transliteration":"rabbuhu"},{"position":3,"arabic":"فَجَعَلَهُۥ","translation":"and made him","transliteration":"fajaʿalahu"},{"position":4,"arabic":"مِنَ","translation":"of","transliteration":"mina"},{"position":5,"arabic":"ٱلصَّـٰلِحِينَ","translation":"the righteous","transliteration":"l-ṣāliḥīna"}],"e3rab":"(فَاجْتَباهُ) ماض ومفعوله (رَبُّهُ) فاعل والجملة معطوفة على مقدر (فَجَعَلَهُ) ماض ومفعوله الأول والفاعل مستتر (مِنَ الصَّالِحِينَ) متعلقان بالفعل وهما في موضع المفعول الثاني والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":68,"ayah":51,"words":[{"position":1,"arabic":"وَإِن","translation":"And indeed","transliteration":"wa-in"},{"position":2,"arabic":"يَكَادُ","translation":"would almost","transliteration":"yakādu"},{"position":3,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":4,"arabic":"كَفَرُوا۟","translation":"disbelieve","transliteration":"kafarū"},{"position":5,"arabic":"لَيُزْلِقُونَكَ","translation":"surely make you slip","transliteration":"layuz'liqūnaka"},{"position":6,"arabic":"بِأَبْصَـٰرِهِمْ","translation":"with their look","transliteration":"bi-abṣārihim"},{"position":7,"arabic":"لَمَّا","translation":"when","transliteration":"lammā"},{"position":8,"arabic":"سَمِعُوا۟","translation":"they hear","transliteration":"samiʿū"},{"position":9,"arabic":"ٱلذِّكْرَ","translation":"the Message","transliteration":"l-dhik'ra"},{"position":10,"arabic":"وَيَقُولُونَ","translation":"and they say","transliteration":"wayaqūlūna"},{"position":11,"arabic":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":12,"arabic":"لَمَجْنُونٌۭ","translation":"(is) surely mad","transliteration":"lamajnūnun"}],"e3rab":"(وَإِنْ) الواو حرف استئناف (إِنْ) مخففة مهملة (يَكادُ الَّذِينَ) مضارع ناقص واسمه (كَفَرُوا) ماض وفاعله والجملة صلة (لَيُزْلِقُونَكَ) اللام الفارقة ومضارع مرفوع بثبوت النون والواو فاعله والكاف مفعوله (بِأَبْصارِهِمْ) متعلقان بالفعل ومعنى يزلقونك ينظرون نظرا شديدا يكاد أن يصرعك والجملة خبر يكاد وجملة إن يكاد.. استئنافية لا محل لها (لَمَّا) ظرفية حينية (سَمِعُوا الذِّكْرَ) ماض وفاعله ومفعوله والجملة في محل جر بالإضافة (وَيَقُولُونَ) مضارع فاعله مستتر والجملة معطوفة على ما قبلها (إِنَّهُ) إن واسمها (لَمَجْنُونٌ) اللام المزحلقة (مجنون) خبرها والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":68,"ayah":52,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"هُوَ","translation":"it (is)","transliteration":"huwa"},{"position":3,"arabic":"إِلَّا","translation":"but","transliteration":"illā"},{"position":4,"arabic":"ذِكْرٌۭ","translation":"a Reminder","transliteration":"dhik'run"},{"position":5,"arabic":"لِّلْعَـٰلَمِينَ","translation":"to the worlds","transliteration":"lil'ʿālamīna"}],"e3rab":"(وَما) الواو حالية (ما) نافية (هُوَ) مبتدأ (إِلَّا) حرف حصر (ذِكْرٌ) خبر المبتدأ (لِلْعالَمِينَ) جار ومجرور صفة ذكر والجملة حال.\r\n\r\n"}]