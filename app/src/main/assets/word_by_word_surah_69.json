[{"sura":69,"ayah":1,"words":[{"position":1,"arabic":"ٱلْحَآقَّةُ","translation":"The Inevitable Reality","transliteration":"al-ḥāqatu"}],"e3rab":"(الْحَاقَّةُ) مبتدأ أول\r\n\r\n"},{"sura":69,"ayah":2,"words":[{"position":1,"arabic":"مَا","translation":"What","transliteration":"mā"},{"position":2,"arabic":"ٱلْحَآقَّةُ","translation":"(is) the Inevitable Reality","transliteration":"l-ḥāqatu"}],"e3rab":"«الْحَاقَّةُ» مبتدأ أول\r\n\r\n"},{"sura":69,"ayah":3,"words":[{"position":1,"arabic":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"arabic":"أَدْرَىٰكَ","translation":"will make you know","transliteration":"adrāka"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"ٱلْحَآقَّةُ","translation":"(is) the Inevitable Reality","transliteration":"l-ḥāqatu"}],"e3rab":"(وَما أَدْراكَ) اسم استفهام مبتدأ وماض ومفعوله الأول والفاعل مستتر والجملة خبر ما والجملة الاسمية معطوفة على ما قبلها (مَا الْحَاقَّةُ) مبتدأ وخبره والجملة في محل نصب مفعول أدراك الثاني.\r\n\r\n"},{"sura":69,"ayah":4,"words":[{"position":1,"arabic":"كَذَّبَتْ","translation":"Denied","transliteration":"kadhabat"},{"position":2,"arabic":"ثَمُودُ","translation":"Thamud","transliteration":"thamūdu"},{"position":3,"arabic":"وَعَادٌۢ","translation":"and Aad","transliteration":"waʿādun"},{"position":4,"arabic":"بِٱلْقَارِعَةِ","translation":"the Striking Calamity","transliteration":"bil-qāriʿati"}],"e3rab":"(كَذَّبَتْ ثَمُودُ) ماض وفاعله والجملة استئنافية لا محل لها (وَعادٌ) معطوف على ثمود (بِالْقارِعَةِ) متعلقان بكذبت.\r\n\r\n"},{"sura":69,"ayah":5,"words":[{"position":1,"arabic":"فَأَمَّا","translation":"So as for","transliteration":"fa-ammā"},{"position":2,"arabic":"ثَمُودُ","translation":"Thamud","transliteration":"thamūdu"},{"position":3,"arabic":"فَأُهْلِكُوا۟","translation":"they were destroyed","transliteration":"fa-uh'likū"},{"position":4,"arabic":"بِٱلطَّاغِيَةِ","translation":"by the overpowering (blast)","transliteration":"bil-ṭāghiyati"}],"e3rab":"(فَأَمَّا) الفاء حرف استئناف (أما) أداة شرط وتفصيل (ثَمُودُ) مبتدأ (فَأُهْلِكُوا) الفاء واقعة في جواب الشرط وماض مبني للمجهول والواو نائب فاعل والجملة خبر المبتدأ (بِالطَّاغِيَةِ) متعلقان بالفعل وجملة أما مستأنفة لا محل لها.\r\n\r\n"},{"sura":69,"ayah":6,"words":[{"position":1,"arabic":"وَأَمَّا","translation":"And as for","transliteration":"wa-ammā"},{"position":2,"arabic":"عَادٌۭ","translation":"Aad","transliteration":"ʿādun"},{"position":3,"arabic":"فَأُهْلِكُوا۟","translation":"they were destroyed","transliteration":"fa-uh'likū"},{"position":4,"arabic":"بِرِيحٍۢ","translation":"by a wind","transliteration":"birīḥin"},{"position":5,"arabic":"صَرْصَرٍ","translation":"screaming","transliteration":"ṣarṣarin"},{"position":6,"arabic":"عَاتِيَةٍۢ","translation":"violent","transliteration":"ʿātiyatin"}],"e3rab":"(وَأَمَّا عادٌ فَأُهْلِكُوا) سبق إعراب مثيلها (بِرِيحٍ) متعلقان بالفعل (صَرْصَرٍ عاتِيَةٍ) صفتان لريح.\r\n\r\n"},{"sura":69,"ayah":7,"words":[{"position":1,"arabic":"سَخَّرَهَا","translation":"Which He imposed","transliteration":"sakharahā"},{"position":2,"arabic":"عَلَيْهِمْ","translation":"upon them","transliteration":"ʿalayhim"},{"position":3,"arabic":"سَبْعَ","translation":"(for) seven","transliteration":"sabʿa"},{"position":4,"arabic":"لَيَالٍۢ","translation":"nights","transliteration":"layālin"},{"position":5,"arabic":"وَثَمَـٰنِيَةَ","translation":"and eight","transliteration":"wathamāniyata"},{"position":6,"arabic":"أَيَّامٍ","translation":"days","transliteration":"ayyāmin"},{"position":7,"arabic":"حُسُومًۭا","translation":"(in) succession","transliteration":"ḥusūman"},{"position":8,"arabic":"فَتَرَى","translation":"so you would see","transliteration":"fatarā"},{"position":9,"arabic":"ٱلْقَوْمَ","translation":"the people","transliteration":"l-qawma"},{"position":10,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":11,"arabic":"صَرْعَىٰ","translation":"fallen","transliteration":"ṣarʿā"},{"position":12,"arabic":"كَأَنَّهُمْ","translation":"as if they were","transliteration":"ka-annahum"},{"position":13,"arabic":"أَعْجَازُ","translation":"trunks","transliteration":"aʿjāzu"},{"position":14,"arabic":"نَخْلٍ","translation":"(of) date-palms","transliteration":"nakhlin"},{"position":15,"arabic":"خَاوِيَةٍۢ","translation":"hollow","transliteration":"khāwiyatin"}],"e3rab":"(سَخَّرَها) ماض ومفعوله والفاعل مستتر (عَلَيْهِمْ) متعلقان بالفعل (سَبْعَ لَيالٍ) ظرف زمان مضاف إلى ليال والجملة صفة ثالثة لريح (وَثَمانِيَةَ أَيَّامٍ) معطوف على سبع ليال (حُسُوماً) صفة لسبع ليال (فَتَرَى) الفاء حرف عطف (ترى الْقَوْمَ) مضارع ومفعوله والفاعل مستتر (فِيها) متعلقان بالفعل (صَرْعى) حال والجملة معطوفة على ما قبلها (كَأَنَّهُمْ أَعْجازُ) كأن واسمها وخبرها (نَخْلٍ) مضاف إليه (خاوِيَةٍ) صفة أعجاز والجملة حال ثانية.\r\n\r\n"},{"sura":69,"ayah":8,"words":[{"position":1,"arabic":"فَهَلْ","translation":"Then do","transliteration":"fahal"},{"position":2,"arabic":"تَرَىٰ","translation":"you see","transliteration":"tarā"},{"position":3,"arabic":"لَهُم","translation":"of them","transliteration":"lahum"},{"position":4,"arabic":"مِّنۢ","translation":"any","transliteration":"min"},{"position":5,"arabic":"بَاقِيَةٍۢ","translation":"remains","transliteration":"bāqiyatin"}],"e3rab":"(فَهَلْ) الفاء حرف استئناف (هل) حرف استفهام معناه النفي (تَرى) مضارع فاعله مستتر (لَهُمْ) متعلقان بالفعل (مِنْ) حرف جر زائد (باقِيَةٍ) مجرور لفظا بمن الزائدة منصوب محلا مفعول ترى والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":69,"ayah":9,"words":[{"position":1,"arabic":"وَجَآءَ","translation":"And came","transliteration":"wajāa"},{"position":2,"arabic":"فِرْعَوْنُ","translation":"Firaun","transliteration":"fir'ʿawnu"},{"position":3,"arabic":"وَمَن","translation":"and (those)","transliteration":"waman"},{"position":4,"arabic":"قَبْلَهُۥ","translation":"before him","transliteration":"qablahu"},{"position":5,"arabic":"وَٱلْمُؤْتَفِكَـٰتُ","translation":"and the overturned cities","transliteration":"wal-mu'tafikātu"},{"position":6,"arabic":"بِٱلْخَاطِئَةِ","translation":"with sin","transliteration":"bil-khāṭi-ati"}],"e3rab":"(وَجاءَ فِرْعَوْنُ) ماض وفاعله والجملة معطوفة على ما قبلها (وَمَنْ) معطوف على فرعون (قَبْلَهُ) ظرف زمان (وَالْمُؤْتَفِكاتُ) معطوف على ما قبله (بِالْخاطِئَةِ) متعلقان بالفعل جاء.\r\n\r\n"},{"sura":69,"ayah":10,"words":[{"position":1,"arabic":"فَعَصَوْا۟","translation":"And they disobeyed","transliteration":"faʿaṣaw"},{"position":2,"arabic":"رَسُولَ","translation":"(the) Messenger","transliteration":"rasūla"},{"position":3,"arabic":"رَبِّهِمْ","translation":"(of) their Lord","transliteration":"rabbihim"},{"position":4,"arabic":"فَأَخَذَهُمْ","translation":"so He seized them","transliteration":"fa-akhadhahum"},{"position":5,"arabic":"أَخْذَةًۭ","translation":"(with) a seizure","transliteration":"akhdhatan"},{"position":6,"arabic":"رَّابِيَةً","translation":"exceeding","transliteration":"rābiyatan"}],"e3rab":"(فَعَصَوْا) ماض وفاعله (رَسُولَ) مفعوله (رَبِّهِمْ) مضاف إليه والجملة معطوفة على ما قبلها (فَأَخَذَهُمْ) ماض ومفعوله والفاعل مستتر (أَخْذَةً) مفعول مطلق (رابِيَةً) صفة أخذة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":69,"ayah":11,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"لَمَّا","translation":"when","transliteration":"lammā"},{"position":3,"arabic":"طَغَا","translation":"overflowed","transliteration":"ṭaghā"},{"position":4,"arabic":"ٱلْمَآءُ","translation":"the water","transliteration":"l-māu"},{"position":5,"arabic":"حَمَلْنَـٰكُمْ","translation":"We carried you","transliteration":"ḥamalnākum"},{"position":6,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":7,"arabic":"ٱلْجَارِيَةِ","translation":"the sailing (ship)","transliteration":"l-jāriyati"}],"e3rab":"(إِنَّا) إن واسمها (لَمَّا) ظرفية حينية (طَغَى الْماءُ) ماض وفاعله والجملة في محل جر بالإضافة (حَمَلْناكُمْ) ماض وفاعله ومفعوله (فِي الْجارِيَةِ) متعلقان بالفعل والجملة خبر إن وجملة إن.. استئنافية لا محل لها.\r\n\r\n"},{"sura":69,"ayah":12,"words":[{"position":1,"arabic":"لِنَجْعَلَهَا","translation":"That We might make it","transliteration":"linajʿalahā"},{"position":2,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":3,"arabic":"تَذْكِرَةًۭ","translation":"a reminder","transliteration":"tadhkiratan"},{"position":4,"arabic":"وَتَعِيَهَآ","translation":"and would be conscious of it","transliteration":"wataʿiyahā"},{"position":5,"arabic":"أُذُنٌۭ","translation":"an ear","transliteration":"udhunun"},{"position":6,"arabic":"وَٰعِيَةٌۭ","translation":"conscious","transliteration":"wāʿiyatun"}],"e3rab":"(لِنَجْعَلَها) مضارع منصوب بأن مضمرة بعد لام التعليل وها مفعوله الأول والفاعل مستتر (لَكُمْ) متعلقان بتذكرة (تَذْكِرَةً) مفعول به ثان والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بالفعل حملناكم (وَتَعِيَها) معطوف على نجعلها (أُذُنٌ) فاعل (واعِيَةٌ) صفة.\r\n\r\n"},{"sura":69,"ayah":13,"words":[{"position":1,"arabic":"فَإِذَا","translation":"Then when","transliteration":"fa-idhā"},{"position":2,"arabic":"نُفِخَ","translation":"is blown","transliteration":"nufikha"},{"position":3,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":4,"arabic":"ٱلصُّورِ","translation":"the trumpet ","transliteration":"l-ṣūri"},{"position":5,"arabic":"نَفْخَةٌۭ","translation":"a blast","transliteration":"nafkhatun"},{"position":6,"arabic":"وَٰحِدَةٌۭ","translation":"single","transliteration":"wāḥidatun"}],"e3rab":"(فَإِذا) الفاء حرف استئناف (إذا) ظرفية شرطية غير جازمة (نُفِخَ) ماض مبني للمجهول (فِي الصُّورِ) متعلقان بالفعل (نَفْخَةٌ) نائب فاعل (واحِدَةٌ) صفة نفخة والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":69,"ayah":14,"words":[{"position":1,"arabic":"وَحُمِلَتِ","translation":"And are lifted","transliteration":"waḥumilati"},{"position":2,"arabic":"ٱلْأَرْضُ","translation":"the earth","transliteration":"l-arḍu"},{"position":3,"arabic":"وَٱلْجِبَالُ","translation":"and the mountains","transliteration":"wal-jibālu"},{"position":4,"arabic":"فَدُكَّتَا","translation":"and crushed","transliteration":"fadukkatā"},{"position":5,"arabic":"دَكَّةًۭ","translation":"(with) a crushing","transliteration":"dakkatan"},{"position":6,"arabic":"وَٰحِدَةًۭ","translation":"single","transliteration":"wāḥidatan"}],"e3rab":"(وَحُمِلَتِ) ماض مبني للمجهول (الْأَرْضُ) نائب فاعل (وَالْجِبالُ) معطوف على الأرض والجملة معطوفة على ما قبلها (فَدُكَّتا) ماض مبني للمجهول والألف نائب فاعل (دَكَّةً) مفعول مطلق (واحِدَةً) صفة دكة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":69,"ayah":15,"words":[{"position":1,"arabic":"فَيَوْمَئِذٍۢ","translation":"Then (on) that Day","transliteration":"fayawma-idhin"},{"position":2,"arabic":"وَقَعَتِ","translation":"will occur","transliteration":"waqaʿati"},{"position":3,"arabic":"ٱلْوَاقِعَةُ","translation":"the Occurrence","transliteration":"l-wāqiʿatu"}],"e3rab":"(فَيَوْمَئِذٍ) الفاء واقعة في جواب الشرط وظرف زمان مضاف إلى مثله (وَقَعَتِ الْواقِعَةُ) ماض وفاعله والجملة جواب الشرط لا محل لها\r\n\r\n"},{"sura":69,"ayah":16,"words":[{"position":1,"arabic":"وَٱنشَقَّتِ","translation":"And will split","transliteration":"wa-inshaqqati"},{"position":2,"arabic":"ٱلسَّمَآءُ","translation":"the heaven","transliteration":"l-samāu"},{"position":3,"arabic":"فَهِىَ","translation":"so it","transliteration":"fahiya"},{"position":4,"arabic":"يَوْمَئِذٍۢ","translation":"(is on) that Day","transliteration":"yawma-idhin"},{"position":5,"arabic":"وَاهِيَةٌۭ","translation":"frail","transliteration":"wāhiyatun"}],"e3rab":"(وَانْشَقَّتِ السَّماءُ) ماض وفاعله والجملة معطوفة على ما قبلها (فَهِيَ) الفاء حرف عطف (هي) مبتدأ (يَوْمَئِذٍ) ظرف زمان مضاف إلى مثله (واهِيَةٌ) خبر.\r\n\r\n"},{"sura":69,"ayah":17,"words":[{"position":1,"arabic":"وَٱلْمَلَكُ","translation":"And the Angels","transliteration":"wal-malaku"},{"position":2,"arabic":"عَلَىٰٓ","translation":"(will be) on","transliteration":"ʿalā"},{"position":3,"arabic":"أَرْجَآئِهَا ۚ","translation":"its edges","transliteration":"arjāihā"},{"position":4,"arabic":"وَيَحْمِلُ","translation":"and will bear","transliteration":"wayaḥmilu"},{"position":5,"arabic":"عَرْشَ","translation":"(the) Throne","transliteration":"ʿarsha"},{"position":6,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":7,"arabic":"فَوْقَهُمْ","translation":"above them","transliteration":"fawqahum"},{"position":8,"arabic":"يَوْمَئِذٍۢ","translation":"that Day","transliteration":"yawma-idhin"},{"position":9,"arabic":"ثَمَـٰنِيَةٌۭ","translation":"eight","transliteration":"thamāniyatun"}],"e3rab":"(وَالْمَلَكُ) مبتدأ (عَلى أَرْجائِها) متعلقان بمحذوف خبر المبتدأ والجملة استئنافية لا محل لها (وَيَحْمِلُ عَرْشَ رَبِّكَ) مضارع ومفعوله المضاف إلى ربك (فَوْقَهُمْ) ظرف مكان (يَوْمَئِذٍ) يوم ظرف زمان مضاف إلى مثله (ثَمانِيَةٌ) فاعل يحمل والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":69,"ayah":18,"words":[{"position":1,"arabic":"يَوْمَئِذٍۢ","translation":"That Day","transliteration":"yawma-idhin"},{"position":2,"arabic":"تُعْرَضُونَ","translation":"you will be exhibited","transliteration":"tuʿ'raḍūna"},{"position":3,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":4,"arabic":"تَخْفَىٰ","translation":"will be hidden","transliteration":"takhfā"},{"position":5,"arabic":"مِنكُمْ","translation":"among you","transliteration":"minkum"},{"position":6,"arabic":"خَافِيَةٌۭ","translation":"any secret","transliteration":"khāfiyatun"}],"e3rab":"(يَوْمَئِذٍ) يوم ظرف زمان مضاف إلى مثله (تُعْرَضُونَ) مضارع مبني للمجهول مرفوع بثبوت النون والواو نائب فاعل والجملة استئنافية لا محل لها (لا تَخْفى) لا نافية ومضارع (مِنْكُمْ) متعلقان بالفعل (خافِيَةٌ) فاعل والجملة حال.\r\n\r\n"},{"sura":69,"ayah":19,"words":[{"position":1,"arabic":"فَأَمَّا","translation":"Then as for","transliteration":"fa-ammā"},{"position":2,"arabic":"مَنْ","translation":"(him) who","transliteration":"man"},{"position":3,"arabic":"أُوتِىَ","translation":"is given","transliteration":"ūtiya"},{"position":4,"arabic":"كِتَـٰبَهُۥ","translation":"his record","transliteration":"kitābahu"},{"position":5,"arabic":"بِيَمِينِهِۦ","translation":"in his right hand","transliteration":"biyamīnihi"},{"position":6,"arabic":"فَيَقُولُ","translation":"will say","transliteration":"fayaqūlu"},{"position":7,"arabic":"هَآؤُمُ","translation":"Here","transliteration":"hāumu"},{"position":8,"arabic":"ٱقْرَءُوا۟","translation":"read","transliteration":"iq'raū"},{"position":9,"arabic":"كِتَـٰبِيَهْ","translation":"my record","transliteration":"kitābiyah"}],"e3rab":"(فَأَمَّا) الفاء حرف استئناف (أما) حرف شرط وتفصيل (مَنْ) اسم موصول مبتدأ (أُوتِيَ) ماض مبني للمجهول ونائب الفاعل مستتر (كِتابَهُ) مفعول به ثان (بِيَمِينِهِ) متعلقان بالفعل والجملة صلة من (فَيَقُولُ) الفاء واقعة في جواب الشرط ومضارع فاعله مستتر والجملة خبر المبتدأ من (هاؤُمُ) اسم فعل أمر (اقْرَؤُا) أمر مبني على حذف النون والواو فاعله (كِتابِيَهْ) مفعول به والياء مضاف إليه والهاء للسكت والجملة مقول القول.\r\n\r\n"},{"sura":69,"ayah":20,"words":[{"position":1,"arabic":"إِنِّى","translation":"Indeed, I","transliteration":"innī"},{"position":2,"arabic":"ظَنَنتُ","translation":"was certain","transliteration":"ẓanantu"},{"position":3,"arabic":"أَنِّى","translation":"that I","transliteration":"annī"},{"position":4,"arabic":"مُلَـٰقٍ","translation":"(will) meet","transliteration":"mulāqin"},{"position":5,"arabic":"حِسَابِيَهْ","translation":"my account","transliteration":"ḥisābiyah"}],"e3rab":"(إِنِّي) إن واسمها (ظَنَنْتُ) ماض وفاعله والجملة خبر إني والجملة الاسمية مقول القول (أَنِّي مُلاقٍ) أن واسمها وخبرها (حِسابِيَهْ) مفعول به لملاق والياء مضاف إليه والهاء للسكت والمصدر المؤول من أن واسمها وخبرها سد مسد مفعولي ظننت.\r\n\r\n"},{"sura":69,"ayah":21,"words":[{"position":1,"arabic":"فَهُوَ","translation":"So he","transliteration":"fahuwa"},{"position":2,"arabic":"فِى","translation":"(will be) in","transliteration":"fī"},{"position":3,"arabic":"عِيشَةٍۢ","translation":"a life","transliteration":"ʿīshatin"},{"position":4,"arabic":"رَّاضِيَةٍۢ","translation":"pleasant","transliteration":"rāḍiyatin"}],"e3rab":"(فَهُوَ) الفاء حرف استئناف (هو) مبتدأ (فِي عِيشَةٍ) متعلقان بمحذوف خبر المبتدأ (راضِيَةٍ) صفة عيشة والجملة استئنافية لا محل لها\r\n\r\n"},{"sura":69,"ayah":22,"words":[{"position":1,"arabic":"فِى","translation":"In","transliteration":"fī"},{"position":2,"arabic":"جَنَّةٍ","translation":"a Garden","transliteration":"jannatin"},{"position":3,"arabic":"عَالِيَةٍۢ","translation":"elevated","transliteration":"ʿāliyatin"}],"e3rab":"(فِي جَنَّةٍ) بدل من قوله في عيشة (عالِيَةٍ) صفة\r\n\r\n"},{"sura":69,"ayah":23,"words":[{"position":1,"arabic":"قُطُوفُهَا","translation":"Its clusters of fruits","transliteration":"quṭūfuhā"},{"position":2,"arabic":"دَانِيَةٌۭ","translation":"hanging near","transliteration":"dāniyatun"}],"e3rab":"(قُطُوفُها دانِيَةٌ) مبتدأ وخبره والجملة صفة ثانية لجنة.\r\n\r\n"},{"sura":69,"ayah":24,"words":[{"position":1,"arabic":"كُلُوا۟","translation":"Eat","transliteration":"kulū"},{"position":2,"arabic":"وَٱشْرَبُوا۟","translation":"and drink","transliteration":"wa-ish'rabū"},{"position":3,"arabic":"هَنِيٓـًٔۢا","translation":"(in) satisfaction","transliteration":"hanīan"},{"position":4,"arabic":"بِمَآ","translation":"for what","transliteration":"bimā"},{"position":5,"arabic":"أَسْلَفْتُمْ","translation":"you sent before you","transliteration":"aslaftum"},{"position":6,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":7,"arabic":"ٱلْأَيَّامِ","translation":"the days","transliteration":"l-ayāmi"},{"position":8,"arabic":"ٱلْخَالِيَةِ","translation":"past","transliteration":"l-khāliyati"}],"e3rab":"(كُلُوا) أمر مبني على حذف النون والواو فاعله والجملة مقول قول محذوف (وَاشْرَبُوا) معطوف على كلوا (هَنِيئاً) حال (بِما) متعلقان بهنيئا (أَسْلَفْتُمْ) ماض وفاعله والجملة صلة ما (فِي الْأَيَّامِ) متعلقان بالفعل (الْخالِيَةِ) صفة الأيام.\r\n\r\n"},{"sura":69,"ayah":25,"words":[{"position":1,"arabic":"وَأَمَّا","translation":"But as for","transliteration":"wa-ammā"},{"position":2,"arabic":"مَنْ","translation":"(him) who","transliteration":"man"},{"position":3,"arabic":"أُوتِىَ","translation":"is given","transliteration":"ūtiya"},{"position":4,"arabic":"كِتَـٰبَهُۥ","translation":"his record","transliteration":"kitābahu"},{"position":5,"arabic":"بِشِمَالِهِۦ","translation":"in his left hand","transliteration":"bishimālihi"},{"position":6,"arabic":"فَيَقُولُ","translation":"will say","transliteration":"fayaqūlu"},{"position":7,"arabic":"يَـٰلَيْتَنِى","translation":"O! I wish","transliteration":"yālaytanī"},{"position":8,"arabic":"لَمْ","translation":"not","transliteration":"lam"},{"position":9,"arabic":"أُوتَ","translation":"I had been given","transliteration":"ūta"},{"position":10,"arabic":"كِتَـٰبِيَهْ","translation":"my record","transliteration":"kitābiyah"}],"e3rab":"(وَأَمَّا مَنْ أُوتِيَ كِتابَهُ بِشِمالِهِ فَيَقُولُ) انظر الآية 19.\r\n\r\n(يا) حرف تنبيه (لَيْتَنِي) حرف مشبه بالفعل والنون للوقاية والياء اسمها (لَمْ أُوتَ) مضارع مبني للمجهول مجزوم بلم ونائب الفاعل مستتر (كِتابِيَهْ) مفعول به ثان والياء مضاف إليه والهاء للسكت والجملة الفعلية خبر ليت والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":69,"ayah":26,"words":[{"position":1,"arabic":"وَلَمْ","translation":"And not","transliteration":"walam"},{"position":2,"arabic":"أَدْرِ","translation":"I had known","transliteration":"adri"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"حِسَابِيَهْ","translation":"(is) my account","transliteration":"ḥisābiyah"}],"e3rab":"(وَلَمْ أَدْرِ) الواو حرف عطف ومضارع مجزوم بلم والجملة معطوفة على ما قبلها (ما) اسم استفهام مبتدأ (حِسابِيَهْ) خبر والياء مضاف إليه والهاء للسكت والجملة الاسمية سدت مسد مفعولي أدري\r\n\r\n"},{"sura":69,"ayah":27,"words":[{"position":1,"arabic":"يَـٰلَيْتَهَا","translation":"O! I wish it","transliteration":"yālaytahā"},{"position":2,"arabic":"كَانَتِ","translation":"had been","transliteration":"kānati"},{"position":3,"arabic":"ٱلْقَاضِيَةَ","translation":"the end","transliteration":"l-qāḍiyata"}],"e3rab":"(يا) حرف تنبيه (لَيْتَها) ليت واسمها (كانَتِ) ماض ناقص اسمه مستتر (الْقاضِيَةَ) خبر كانت والجملة الفعلية خبر ليت والجملة الاسمية مقول القول\r\n\r\n"},{"sura":69,"ayah":28,"words":[{"position":1,"arabic":"مَآ","translation":"Not","transliteration":"mā"},{"position":2,"arabic":"أَغْنَىٰ","translation":"has availed","transliteration":"aghnā"},{"position":3,"arabic":"عَنِّى","translation":"me","transliteration":"ʿannī"},{"position":4,"arabic":"مَالِيَهْ ۜ","translation":"my wealth","transliteration":"māliyah"}],"e3rab":"(ما أَغْنى) ما نافية وماض (عَنِّي) متعلقان بالفعل (مالِيَهْ) فاعل والجملة مقول القول\r\n\r\n"},{"sura":69,"ayah":29,"words":[{"position":1,"arabic":"هَلَكَ","translation":"Is gone","transliteration":"halaka"},{"position":2,"arabic":"عَنِّى","translation":"from me","transliteration":"ʿannī"},{"position":3,"arabic":"سُلْطَـٰنِيَهْ","translation":"my authority","transliteration":"sul'ṭāniyah"}],"e3rab":"(هَلَكَ) ماض (عَنِّي) متعلقان بالفعل (سُلْطانِيَهْ) فاعل والجملة مقول القول.\r\n\r\n"},{"sura":69,"ayah":30,"words":[{"position":1,"arabic":"خُذُوهُ","translation":"Seize him","transliteration":"khudhūhu"},{"position":2,"arabic":"فَغُلُّوهُ","translation":"and shackle him","transliteration":"faghullūhu"}],"e3rab":"(خُذُوهُ) أمر وفاعله ومفعوله والجملة مقول لقول مقدر (فَغُلُّوهُ) معطوف على خذوه.\r\n\r\n"},{"sura":69,"ayah":31,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"ٱلْجَحِيمَ","translation":"(into) the Hellfire","transliteration":"l-jaḥīma"},{"position":3,"arabic":"صَلُّوهُ","translation":"burn him","transliteration":"ṣallūhu"}],"e3rab":"(ثُمَّ) حرف عطف (الْجَحِيمَ) منصوب بنزع الخافض (صَلُّوهُ) أمر وفاعله ومفعوله والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":69,"ayah":32,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"فِى","translation":"into","transliteration":"fī"},{"position":3,"arabic":"سِلْسِلَةٍۢ","translation":"a chain","transliteration":"sil'silatin"},{"position":4,"arabic":"ذَرْعُهَا","translation":"its length","transliteration":"dharʿuhā"},{"position":5,"arabic":"سَبْعُونَ","translation":"(is) seventy","transliteration":"sabʿūna"},{"position":6,"arabic":"ذِرَاعًۭا","translation":"cubits","transliteration":"dhirāʿan"},{"position":7,"arabic":"فَٱسْلُكُوهُ","translation":"insert him","transliteration":"fa-us'lukūhu"}],"e3rab":"(ثُمَّ) حرف عطف (فِي سِلْسِلَةٍ) متعلقان باسلكوه (ذَرْعُها سَبْعُونَ) مبتدأ وخبره والجملة الاسمية صفة سلسلة (ذِراعاً) تمييز (فَاسْلُكُوهُ) أمر وفاعله ومفعوله والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":69,"ayah":33,"words":[{"position":1,"arabic":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":2,"arabic":"كَانَ","translation":"was","transliteration":"kāna"},{"position":3,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":4,"arabic":"يُؤْمِنُ","translation":"believing","transliteration":"yu'minu"},{"position":5,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":6,"arabic":"ٱلْعَظِيمِ","translation":"the Most Great","transliteration":"l-ʿaẓīmi"}],"e3rab":"(إِنَّهُ كانَ) إن واسمها وماض ناقص اسمه مستتر (لا يُؤْمِنُ) لا نافية ومضارع فاعله مستتر (بِاللَّهِ) متعلقان بالفعل (الْعَظِيمِ) صفة والجملة خبر كان والجملة الفعلية خبر إن والجملة الاسمية تعليلية لا محل لها.\r\n\r\n"},{"sura":69,"ayah":34,"words":[{"position":1,"arabic":"وَلَا","translation":"And (did) not","transliteration":"walā"},{"position":2,"arabic":"يَحُضُّ","translation":"feel the urge","transliteration":"yaḥuḍḍu"},{"position":3,"arabic":"عَلَىٰ","translation":"on","transliteration":"ʿalā"},{"position":4,"arabic":"طَعَامِ","translation":"(the) feeding","transliteration":"ṭaʿāmi"},{"position":5,"arabic":"ٱلْمِسْكِينِ","translation":"(of) the poor","transliteration":"l-mis'kīni"}],"e3rab":"(وَ) الواو حرف عطف (لا يَحُضُّ) نافية ومضارع فاعله مستتر (عَلى طَعامِ) متعلقان بالفعل (الْمِسْكِينِ) مضاف إليه والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":69,"ayah":35,"words":[{"position":1,"arabic":"فَلَيْسَ","translation":"So not","transliteration":"falaysa"},{"position":2,"arabic":"لَهُ","translation":"for him","transliteration":"lahu"},{"position":3,"arabic":"ٱلْيَوْمَ","translation":"today","transliteration":"l-yawma"},{"position":4,"arabic":"هَـٰهُنَا","translation":"here","transliteration":"hāhunā"},{"position":5,"arabic":"حَمِيمٌۭ","translation":"any devoted friend","transliteration":"ḥamīmun"}],"e3rab":"(فَلَيْسَ) الفاء حرف استئناف وماض ناقص (لَهُ) متعلقان بمحذوف خبر ليس المقدم (الْيَوْمَ) ظرف زمان (هاهُنا) ها للتنبيه (هنا) اسم إشارة في محل نصب على الظرفية المكانية (حَمِيمٌ) اسم ليس المؤخر والجملة استئنافية لا محل لها\r\n\r\n"},{"sura":69,"ayah":36,"words":[{"position":1,"arabic":"وَلَا","translation":"And not","transliteration":"walā"},{"position":2,"arabic":"طَعَامٌ","translation":"any food","transliteration":"ṭaʿāmun"},{"position":3,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":4,"arabic":"مِنْ","translation":"from","transliteration":"min"},{"position":5,"arabic":"غِسْلِينٍۢ","translation":"(the) discharge of wounds","transliteration":"ghis'līnin"}],"e3rab":"(وَلا) الواو حرف عطف (لا) نافية (طَعامٌ) معطوف على حميم (إِلَّا) حرف حصر (مِنْ غِسْلِينٍ) متعلقان بمحذوف صفة طعام\r\n\r\n"},{"sura":69,"ayah":37,"words":[{"position":1,"arabic":"لَّا","translation":"Not","transliteration":"lā"},{"position":2,"arabic":"يَأْكُلُهُۥٓ","translation":"will eat it","transliteration":"yakuluhu"},{"position":3,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":4,"arabic":"ٱلْخَـٰطِـُٔونَ","translation":"the sinners","transliteration":"l-khāṭiūna"}],"e3rab":"(لا) نافية (يَأْكُلُهُ) مضارع ومفعوله (إِلَّا) حرف حصر (الْخاطِؤُنَ) فاعل والجملة صفة غسلين.\r\n\r\n"},{"sura":69,"ayah":38,"words":[{"position":1,"arabic":"فَلَآ","translation":"But nay","transliteration":"falā"},{"position":2,"arabic":"أُقْسِمُ","translation":"I swear","transliteration":"uq'simu"},{"position":3,"arabic":"بِمَا","translation":"by what","transliteration":"bimā"},{"position":4,"arabic":"تُبْصِرُونَ","translation":"you see","transliteration":"tub'ṣirūna"}],"e3rab":"(فَلا) الفاء حرف استئناف (لا أُقْسِمُ) لا نافية ومضارع فاعله مستتر والجملة استئنافية لا محل لها (بِما تُبْصِرُونَ) متعلقان بالفعل ومضارع مرفوع والواو فاعله والجملة صلة\r\n\r\n"},{"sura":69,"ayah":39,"words":[{"position":1,"arabic":"وَمَا","translation":"And what","transliteration":"wamā"},{"position":2,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":3,"arabic":"تُبْصِرُونَ","translation":"you see","transliteration":"tub'ṣirūna"}],"e3rab":"(وَ) الواو حرف عطف (ما) معطوفة على ما قبلها (لا تُبْصِرُونَ) لا نافية ومضارع وفاعله والجملة صلة\r\n\r\n"},{"sura":69,"ayah":40,"words":[{"position":1,"arabic":"إِنَّهُۥ","translation":"Indeed, it (is)","transliteration":"innahu"},{"position":2,"arabic":"لَقَوْلُ","translation":"surely (the) Word","transliteration":"laqawlu"},{"position":3,"arabic":"رَسُولٍۢ","translation":"(of) a Messenger","transliteration":"rasūlin"},{"position":4,"arabic":"كَرِيمٍۢ","translation":"noble","transliteration":"karīmin"}],"e3rab":"(إِنَّهُ) إن واسمها (لَقَوْلُ) اللام المزحلقة (قول رَسُولٍ) خبر إن مضاف إلى رسول (كَرِيمٍ) صفة والجملة الاسمية جواب القسم لا محل لها.\r\n\r\n"},{"sura":69,"ayah":41,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"هُوَ","translation":"it","transliteration":"huwa"},{"position":3,"arabic":"بِقَوْلِ","translation":"(is the) word","transliteration":"biqawli"},{"position":4,"arabic":"شَاعِرٍۢ ۚ","translation":"(of) a poet","transliteration":"shāʿirin"},{"position":5,"arabic":"قَلِيلًۭا","translation":"little","transliteration":"qalīlan"},{"position":6,"arabic":"مَّا","translation":"(is) what","transliteration":"mā"},{"position":7,"arabic":"تُؤْمِنُونَ","translation":"you believe","transliteration":"tu'minūna"}],"e3rab":"(وَما) الواو حرف عطف (ما) نافية تعمل عمل ليس (هُوَ) اسمها (بِقَوْلِ) مجرور لفظا بالباء الزائدة منصوب محلا خبر ما (شاعِرٍ) مضاف إليه (قَلِيلًا) صفة مفعول مطلق محذوف (ما) زائدة (تُؤْمِنُونَ) مضارع مرفوع والواو فاعله والجملة تعليلية لا محل لها.\r\n\r\n"},{"sura":69,"ayah":42,"words":[{"position":1,"arabic":"وَلَا","translation":"And not","transliteration":"walā"},{"position":2,"arabic":"بِقَوْلِ","translation":"(it is the) word","transliteration":"biqawli"},{"position":3,"arabic":"كَاهِنٍۢ ۚ","translation":"(of) a soothsayer","transliteration":"kāhinin"},{"position":4,"arabic":"قَلِيلًۭا","translation":"little","transliteration":"qalīlan"},{"position":5,"arabic":"مَّا","translation":"(is) what","transliteration":"mā"},{"position":6,"arabic":"تَذَكَّرُونَ","translation":"you take heed","transliteration":"tadhakkarūna"}],"e3rab":"(وَلا) الواو حرف عطف (لا) زائدة لتأكيد النفي (بِقَوْلِ كاهِنٍ) معطوف على بقول شاعر وما بعده سبق إعراب مثيله.\r\n\r\n"},{"sura":69,"ayah":43,"words":[{"position":1,"arabic":"تَنزِيلٌۭ","translation":"(It is) a revelation","transliteration":"tanzīlun"},{"position":2,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":3,"arabic":"رَّبِّ","translation":"(the) Lord","transliteration":"rabbi"},{"position":4,"arabic":"ٱلْعَـٰلَمِينَ","translation":"(of) the worlds","transliteration":"l-ʿālamīna"}],"e3rab":"(تَنْزِيلٌ) خبر لمبتدأ محذوف (مِنْ رَبِّ) متعلقان بتنزيل (الْعالَمِينَ) مضاف إليه.\r\n\r\n"},{"sura":69,"ayah":44,"words":[{"position":1,"arabic":"وَلَوْ","translation":"And if","transliteration":"walaw"},{"position":2,"arabic":"تَقَوَّلَ","translation":"he (had) fabricated","transliteration":"taqawwala"},{"position":3,"arabic":"عَلَيْنَا","translation":"against Us","transliteration":"ʿalaynā"},{"position":4,"arabic":"بَعْضَ","translation":"some","transliteration":"baʿḍa"},{"position":5,"arabic":"ٱلْأَقَاوِيلِ","translation":"sayings","transliteration":"l-aqāwīli"}],"e3rab":"(وَلَوْ) الواو حرف عطف (لَوْ) شرطية غير جازمة (تَقَوَّلَ) ماض فاعله مستتر (عَلَيْنا) متعلقان بالفعل (بَعْضَ الْأَقاوِيلِ) مفعول به مضاف إلى الأقاويل والجملة ابتدائية لا محل لها.\r\n\r\n"},{"sura":69,"ayah":45,"words":[{"position":1,"arabic":"لَأَخَذْنَا","translation":"Certainly We (would) have seized","transliteration":"la-akhadhnā"},{"position":2,"arabic":"مِنْهُ","translation":"him","transliteration":"min'hu"},{"position":3,"arabic":"بِٱلْيَمِينِ","translation":"by the right hand","transliteration":"bil-yamīni"}],"e3rab":"(لَأَخَذْنا) اللام واقعة في جواب الشرط وماض وفاعله (مِنْهُ) متعلقان بالفعل (بِالْيَمِينِ) متعلقان بالفعل أيضا والجملة جواب الشرط لا محل لها\r\n\r\n"},{"sura":69,"ayah":46,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"لَقَطَعْنَا","translation":"certainly We (would) have cut off","transliteration":"laqaṭaʿnā"},{"position":3,"arabic":"مِنْهُ","translation":"from him","transliteration":"min'hu"},{"position":4,"arabic":"ٱلْوَتِينَ","translation":"the aorta","transliteration":"l-watīna"}],"e3rab":"(ثُمَّ) حرف عطف وجملة (لَقَطَعْنا مِنْهُ الْوَتِينَ) معطوفة على ما قبلها.\r\n\r\n"},{"sura":69,"ayah":47,"words":[{"position":1,"arabic":"فَمَا","translation":"And not","transliteration":"famā"},{"position":2,"arabic":"مِنكُم","translation":"from you","transliteration":"minkum"},{"position":3,"arabic":"مِّنْ","translation":"any","transliteration":"min"},{"position":4,"arabic":"أَحَدٍ","translation":"one","transliteration":"aḥadin"},{"position":5,"arabic":"عَنْهُ","translation":"[from him]","transliteration":"ʿanhu"},{"position":6,"arabic":"حَـٰجِزِينَ","translation":"(who could) prevent (it)","transliteration":"ḥājizīna"}],"e3rab":"(فَما) الفاء حرف عطف (ما) نافية (مِنْكُمْ) خبر مقدم (مِنْ أَحَدٍ) مجرور لفظا بمن الزائدة مرفوع محلا مبتدأ مؤخر (عَنْهُ) متعلقان بما بعدهما (حاجِزِينَ) صفة أحد.\r\n\r\n"},{"sura":69,"ayah":48,"words":[{"position":1,"arabic":"وَإِنَّهُۥ","translation":"And indeed, it","transliteration":"wa-innahu"},{"position":2,"arabic":"لَتَذْكِرَةٌۭ","translation":"(is) surely a reminder","transliteration":"latadhkiratun"},{"position":3,"arabic":"لِّلْمُتَّقِينَ","translation":"for the Allah-fearing","transliteration":"lil'muttaqīna"}],"e3rab":"(وَإِنَّهُ) إن واسمها واللام المزحلقة (تذكرة) خبر إن (لِلْمُتَّقِينَ) متعلقان بتذكرة والجملة معطوفة على جواب القسم.\r\n\r\n"},{"sura":69,"ayah":49,"words":[{"position":1,"arabic":"وَإِنَّا","translation":"And indeed, We","transliteration":"wa-innā"},{"position":2,"arabic":"لَنَعْلَمُ","translation":"surely know","transliteration":"lanaʿlamu"},{"position":3,"arabic":"أَنَّ","translation":"that","transliteration":"anna"},{"position":4,"arabic":"مِنكُم","translation":"among you","transliteration":"minkum"},{"position":5,"arabic":"مُّكَذِّبِينَ","translation":"(are) deniers","transliteration":"mukadhibīna"}],"e3rab":"(وَإِنَّا) إن واسمها (لَنَعْلَمُ) اللام المزحلقة ومضارع فاعله مستتر والجملة خبر إن والجملة الاسمية معطوفة على ما قبلها (أَنَّ) حرف مشبه بالفعل (مِنْكُمْ) خبر أن المقدم (مُكَذِّبِينَ) اسمها المؤخر والمصدر المؤول من أن وما بعدها في محل نصب سد مسد مفعولي نعلم.\r\n\r\n"},{"sura":69,"ayah":50,"words":[{"position":1,"arabic":"وَإِنَّهُۥ","translation":"And indeed, it","transliteration":"wa-innahu"},{"position":2,"arabic":"لَحَسْرَةٌ","translation":"(is) surely a regret","transliteration":"laḥasratun"},{"position":3,"arabic":"عَلَى","translation":"upon","transliteration":"ʿalā"},{"position":4,"arabic":"ٱلْكَـٰفِرِينَ","translation":"the disbelievers","transliteration":"l-kāfirīna"}],"e3rab":"سبق إعراب مثيلها في الآية - 48 -\r\n\r\n"},{"sura":69,"ayah":51,"words":[{"position":1,"arabic":"وَإِنَّهُۥ","translation":"And indeed, it (is)","transliteration":"wa-innahu"},{"position":2,"arabic":"لَحَقُّ","translation":"surely (the) truth","transliteration":"laḥaqqu"},{"position":3,"arabic":"ٱلْيَقِينِ","translation":"(of) certainty","transliteration":"l-yaqīni"}],"e3rab":"(وَإِنَّهُ) إن واسمها واللام المزحلقة (حق الْيَقِينِ) خبر إن المضاف إلى اليقين والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":69,"ayah":52,"words":[{"position":1,"arabic":"فَسَبِّحْ","translation":"So glorify","transliteration":"fasabbiḥ"},{"position":2,"arabic":"بِٱسْمِ","translation":"(the) name","transliteration":"bi-is'mi"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"ٱلْعَظِيمِ","translation":"the Most Great","transliteration":"l-ʿaẓīmi"}],"e3rab":"(فَسَبِّحْ) الفاء الفصيحة وأمر فاعله مستتر (بِاسْمِ) متعلقان بالفعل (رَبِّكَ) مضاف إليه (الْعَظِيمِ) صفة والجملة جواب شرط مقدر لا محل لها.\r\n\r\n"}]