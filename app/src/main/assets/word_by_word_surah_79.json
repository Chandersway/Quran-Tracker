[{"sura":79,"ayah":1,"words":[{"position":1,"arabic":"وَٱلنَّـٰزِعَـٰتِ","translation":"By those who extract","transliteration":"wal-nāziʿāti"},{"position":2,"arabic":"غَرْقًۭا","translation":"violently","transliteration":"gharqan"}],"e3rab":"(وَ) الواو حرف قسم وجر (النَّازِعاتِ) مقسم به مجرور والجار والمجرور متعلقان بفعل قسم محذوف و(غَرْقاً) حال\r\n\r\n"},{"sura":79,"ayah":2,"words":[{"position":1,"arabic":"وَٱلنَّـٰشِطَـٰتِ","translation":"And those who draw out","transliteration":"wal-nāshiṭāti"},{"position":2,"arabic":"نَشْطًۭا","translation":"gently","transliteration":"nashṭan"}],"e3rab":"معطوف على ما قبله\r\n\r\n"},{"sura":79,"ayah":3,"words":[{"position":1,"arabic":"وَٱلسَّـٰبِحَـٰتِ","translation":"And those who glide","transliteration":"wal-sābiḥāti"},{"position":2,"arabic":"سَبْحًۭا","translation":"swimming","transliteration":"sabḥan"}],"e3rab":"معطوف على ما قبله\r\n\r\n"},{"sura":79,"ayah":4,"words":[{"position":1,"arabic":"فَٱلسَّـٰبِقَـٰتِ","translation":"And those who race each other","transliteration":"fal-sābiqāti"},{"position":2,"arabic":"سَبْقًۭا","translation":"(in) a race","transliteration":"sabqan"}],"e3rab":"معطوف على ما قبله\r\n\r\n"},{"sura":79,"ayah":5,"words":[{"position":1,"arabic":"فَٱلْمُدَبِّرَٰتِ","translation":"And those who arrange","transliteration":"fal-mudabirāti"},{"position":2,"arabic":"أَمْرًۭا","translation":"(the) matter","transliteration":"amran"}],"e3rab":"و«فَالْمُدَبِّراتِ» معطوف على ما قبله و«أَمْراً» مفعول به.\r\n\r\n"},{"sura":79,"ayah":6,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"تَرْجُفُ","translation":"will quake","transliteration":"tarjufu"},{"position":3,"arabic":"ٱلرَّاجِفَةُ","translation":"the quaking one","transliteration":"l-rājifatu"}],"e3rab":"(يَوْمَ) ظرف زمان (تَرْجُفُ الرَّاجِفَةُ) مضارع وفاعله والجملة في محل جر بالإضافة\r\n\r\n"},{"sura":79,"ayah":7,"words":[{"position":1,"arabic":"تَتْبَعُهَا","translation":"Follows it","transliteration":"tatbaʿuhā"},{"position":2,"arabic":"ٱلرَّادِفَةُ","translation":"the subsequent","transliteration":"l-rādifatu"}],"e3rab":"(تَتْبَعُهَا) مضارع ومفعوله و(الرَّادِفَةُ) فاعله والجملة حال\r\n\r\n"},{"sura":79,"ayah":8,"words":[{"position":1,"arabic":"قُلُوبٌۭ","translation":"Hearts","transliteration":"qulūbun"},{"position":2,"arabic":"يَوْمَئِذٍۢ","translation":"that Day","transliteration":"yawma-idhin"},{"position":3,"arabic":"وَاجِفَةٌ","translation":"will palpitate","transliteration":"wājifatun"}],"e3rab":"(قُلُوبٌ) مبتدأ و(يَوْمَئِذٍ) ظرف أضيف إلى مثله (واجِفَةٌ) صفة قلوب\r\n\r\n"},{"sura":79,"ayah":9,"words":[{"position":1,"arabic":"أَبْصَـٰرُهَا","translation":"Their eyes","transliteration":"abṣāruhā"},{"position":2,"arabic":"خَـٰشِعَةٌۭ","translation":"humbled","transliteration":"khāshiʿatun"}],"e3rab":"و(أَبْصارُها خاشِعَةٌ) مبتدأ وخبره والجملة خبر قلوب وجملة قلوب مستأنفة.\r\n\r\n"},{"sura":79,"ayah":10,"words":[{"position":1,"arabic":"يَقُولُونَ","translation":"They say","transliteration":"yaqūlūna"},{"position":2,"arabic":"أَءِنَّا","translation":"Will we","transliteration":"a-innā"},{"position":3,"arabic":"لَمَرْدُودُونَ","translation":"indeed be returned","transliteration":"lamardūdūna"},{"position":4,"arabic":"فِى","translation":"to","transliteration":"fī"},{"position":5,"arabic":"ٱلْحَافِرَةِ","translation":"the former state","transliteration":"l-ḥāfirati"}],"e3rab":"(يَقُولُونَ) مضارع وفاعله والجملة خبر مبتدأ محذوف تقديره هم يقولون (أَإِنَّا) الهمزة حرف استفهام وإن واسمها (لَمَرْدُودُونَ) اللام المزحلقة وخبرها و(فِي الْحافِرَةِ) متعلقان بما قبلهما والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":79,"ayah":11,"words":[{"position":1,"arabic":"أَءِذَا","translation":"What! When","transliteration":"a-idhā"},{"position":2,"arabic":"كُنَّا","translation":"we are","transliteration":"kunnā"},{"position":3,"arabic":"عِظَـٰمًۭا","translation":"bones","transliteration":"ʿiẓāman"},{"position":4,"arabic":"نَّخِرَةًۭ","translation":"decayed","transliteration":"nakhiratan"}],"e3rab":"(أَإِذا) الهمزة حرف استفهام و(إِذا) ظرفية شرطية غير جازمة (كُنَّا عِظاماً) كان واسمها وخبرها و(نَخِرَةً) صفة والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":79,"ayah":12,"words":[{"position":1,"arabic":"قَالُوا۟","translation":"They say","transliteration":"qālū"},{"position":2,"arabic":"تِلْكَ","translation":"This","transliteration":"til'ka"},{"position":3,"arabic":"إِذًۭا","translation":"then","transliteration":"idhan"},{"position":4,"arabic":"كَرَّةٌ","translation":"(would be) a return","transliteration":"karratun"},{"position":5,"arabic":"خَاسِرَةٌۭ","translation":"losing","transliteration":"khāsiratun"}],"e3rab":"(قالُوا) ماض وفاعله والجملة مستأنفة و(تِلْكَ) مبتدأ و(إِذاً) حرف جواب وجزاء لا عمل لها و(كَرَّةٌ) خبر و(خاسِرَةٌ) صفة والجملة الاسمية مقول القول\r\n\r\n"},{"sura":79,"ayah":13,"words":[{"position":1,"arabic":"فَإِنَّمَا","translation":"Then only","transliteration":"fa-innamā"},{"position":2,"arabic":"هِىَ","translation":"it","transliteration":"hiya"},{"position":3,"arabic":"زَجْرَةٌۭ","translation":"(will be) a shout","transliteration":"zajratun"},{"position":4,"arabic":"وَٰحِدَةٌۭ","translation":"single","transliteration":"wāḥidatun"}],"e3rab":"(فَإِنَّما) كافة ومكفوفة والفاء استئنافية (هِيَ زَجْرَةٌ) مبتدأ وخبره (واحِدَةٌ) صفة والجملة الاسمية مقول قول محذوف والكلام مستأنف\r\n\r\n"},{"sura":79,"ayah":14,"words":[{"position":1,"arabic":"فَإِذَا","translation":"And behold","transliteration":"fa-idhā"},{"position":2,"arabic":"هُم","translation":"They","transliteration":"hum"},{"position":3,"arabic":"بِٱلسَّاهِرَةِ","translation":"(will be) awakened","transliteration":"bil-sāhirati"}],"e3rab":"(فَإِذا) الفاء حرف عطف و(إذا) فجائية و(هُمْ) مبتدأ و(بِالسَّاهِرَةِ) متعلقان بمحذوف خبر.\r\n\r\n"},{"sura":79,"ayah":15,"words":[{"position":1,"arabic":"هَلْ","translation":"Has","transliteration":"hal"},{"position":2,"arabic":"أَتَىٰكَ","translation":"(there) come to you","transliteration":"atāka"},{"position":3,"arabic":"حَدِيثُ","translation":"(the) story","transliteration":"ḥadīthu"},{"position":4,"arabic":"مُوسَىٰٓ","translation":"(of) Musa","transliteration":"mūsā"}],"e3rab":"(هَلْ) حرف استفهام (أَتاكَ) ماض ومفعوله و(حَدِيثُ) فاعل و(مُوسى) مضاف إليه والجملة مستأنفة لا محل لها\r\n\r\n"},{"sura":79,"ayah":16,"words":[{"position":1,"arabic":"إِذْ","translation":"When","transliteration":"idh"},{"position":2,"arabic":"نَادَىٰهُ","translation":"called him","transliteration":"nādāhu"},{"position":3,"arabic":"رَبُّهُۥ","translation":"his Lord","transliteration":"rabbuhu"},{"position":4,"arabic":"بِٱلْوَادِ","translation":"in the valley","transliteration":"bil-wādi"},{"position":5,"arabic":"ٱلْمُقَدَّسِ","translation":"the sacred","transliteration":"l-muqadasi"},{"position":6,"arabic":"طُوًى","translation":"(of) Tuwa","transliteration":"ṭuwan"}],"e3rab":"و(إِذْ) ظرف زمان (ناداهُ رَبُّهُ) ماض ومفعوله وفاعله والجملة في محل جر بالإضافة و(بِالْوادِ) متعلقان بمحذوف حال (الْمُقَدَّسِ) صفة و(طُوىً) بدل من الوادي.\r\n\r\n"},{"sura":79,"ayah":17,"words":[{"position":1,"arabic":"ٱذْهَبْ","translation":"Go","transliteration":"idh'hab"},{"position":2,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":3,"arabic":"فِرْعَوْنَ","translation":"Firaun","transliteration":"fir'ʿawna"},{"position":4,"arabic":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":5,"arabic":"طَغَىٰ","translation":"(has) transgressed","transliteration":"ṭaghā"}],"e3rab":"(اذْهَبْ) أمر فاعله مستتر والجملة مفسرة للنداء و(إِلى فِرْعَوْنَ) متعلقان بالفعل (إِنَّهُ) إن واسمها (طَغى) ماض فاعله مستتر والجملة الفعلية خبر إن والجملة الاسمية تعليل.\r\n\r\n"},{"sura":79,"ayah":18,"words":[{"position":1,"arabic":"فَقُلْ","translation":"And say","transliteration":"faqul"},{"position":2,"arabic":"هَل","translation":"Would","transliteration":"hal"},{"position":3,"arabic":"لَّكَ","translation":"[for] you","transliteration":"laka"},{"position":4,"arabic":"إِلَىٰٓ","translation":"[to]","transliteration":"ilā"},{"position":5,"arabic":"أَن","translation":"[that]","transliteration":"an"},{"position":6,"arabic":"تَزَكَّىٰ","translation":"purify yourself","transliteration":"tazakkā"}],"e3rab":"(فَقُلْ) الفاء حرف عطف وأمر فاعله مستتر والجملة معطوفة على ما قبلها. و(هَلْ) حرف استفهام و(لَكَ) متعلقان بمحذوف خبر لمبتدأ محذوف التقدير: هل لك سبيل. و(إِلى) حرف جر و(أَنْ) حرف مصدري ونصب (تَزَكَّى) مضارع منصوب بأن والفاعل مستتر والمصدر المؤول من أن والفعل في محل جر بحرف الجر والجار والمجرور متعلقان بالمبتدأ المحذوف والجملة الاسمية المقدرة مقول القول.\r\n\r\n"},{"sura":79,"ayah":19,"words":[{"position":1,"arabic":"وَأَهْدِيَكَ","translation":"And I will guide you","transliteration":"wa-ahdiyaka"},{"position":2,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":3,"arabic":"رَبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":4,"arabic":"فَتَخْشَىٰ","translation":"so you would fear","transliteration":"fatakhshā"}],"e3rab":"ليس لها إعراب\r\n\r\n"},{"sura":79,"ayah":20,"words":[{"position":1,"arabic":"فَأَرَىٰهُ","translation":"Then he showed him","transliteration":"fa-arāhu"},{"position":2,"arabic":"ٱلْـَٔايَةَ","translation":"the sign","transliteration":"l-āyata"},{"position":3,"arabic":"ٱلْكُبْرَىٰ","translation":"the great","transliteration":"l-kub'rā"}],"e3rab":"(فَأَراهُ) الفاء حرف عطف وماض ومفعوله الأول والفاعل مستتر و(الْآيَةَ) مفعول به ثان و(الْكُبْرى) صفة. والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":79,"ayah":21,"words":[{"position":1,"arabic":"فَكَذَّبَ","translation":"But he denied","transliteration":"fakadhaba"},{"position":2,"arabic":"وَعَصَىٰ","translation":"and disobeyed","transliteration":"waʿaṣā"}],"e3rab":"(فَكَذَّبَ) الفاء حرف عطف وماض فاعله مستتر والجملة معطوفة على ما قبلها (وَعَصى) معطوف على كذب\r\n\r\n"},{"sura":79,"ayah":22,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"أَدْبَرَ","translation":"he turned his back","transliteration":"adbara"},{"position":3,"arabic":"يَسْعَىٰ","translation":"striving","transliteration":"yasʿā"}],"e3rab":"(ثُمَّ) حرف عطف (أَدْبَرَ) ماض فاعله مستتر والجملة معطوفة على ما قبلها (يَسْعى) مضارع فاعله مستتر والجملة حال\r\n\r\n"},{"sura":79,"ayah":23,"words":[{"position":1,"arabic":"فَحَشَرَ","translation":"And he gathered","transliteration":"faḥashara"},{"position":2,"arabic":"فَنَادَىٰ","translation":"and called out","transliteration":"fanādā"}],"e3rab":"(فَحَشَرَ فَنادى) معطوفان على ما قبلهما.\r\n\r\n"},{"sura":79,"ayah":24,"words":[{"position":1,"arabic":"فَقَالَ","translation":"Then he said","transliteration":"faqāla"},{"position":2,"arabic":"أَنَا۠","translation":"I am","transliteration":"anā"},{"position":3,"arabic":"رَبُّكُمُ","translation":"your Lord","transliteration":"rabbukumu"},{"position":4,"arabic":"ٱلْأَعْلَىٰ","translation":"the Most High","transliteration":"l-aʿlā"}],"e3rab":"(فَقالَ) الفاء حرف عطف وماض فاعله مستتر والجملة معطوفة على ما قبلها. و(أَنَا رَبُّكُمُ) مبتدأ وخبره و(الْأَعْلى) صفة والجملة مقول القول.\r\n\r\n"},{"sura":79,"ayah":25,"words":[{"position":1,"arabic":"فَأَخَذَهُ","translation":"So seized him","transliteration":"fa-akhadhahu"},{"position":2,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":3,"arabic":"نَكَالَ","translation":"(with) an exemplary punishment","transliteration":"nakāla"},{"position":4,"arabic":"ٱلْـَٔاخِرَةِ","translation":"(for) the last","transliteration":"l-ākhirati"},{"position":5,"arabic":"وَٱلْأُولَىٰٓ","translation":"and the first","transliteration":"wal-ūlā"}],"e3rab":"(فَأَخَذَهُ اللَّهُ) ماض ومفعوله ولفظ الجلالة فاعله والجملة معطوفة على ما قبلها و(نَكالَ الْآخِرَةِ) مفعول مطلق مضاف إلى الآخرة و(الْأُولى) معطوف على الآخرة\r\n\r\n"},{"sura":79,"ayah":26,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":3,"arabic":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":4,"arabic":"لَعِبْرَةًۭ","translation":"surely (is) a lesson","transliteration":"laʿib'ratan"},{"position":5,"arabic":"لِّمَن","translation":"for whoever","transliteration":"liman"},{"position":6,"arabic":"يَخْشَىٰٓ","translation":"fears","transliteration":"yakhshā"}],"e3rab":"(إِنَّ) حرف مشبه بالفعل و(فِي ذلِكَ) خبر إن المقدم (لَعِبْرَةً) اللام المزحلقة واسم إن المؤخر والجملة الاسمية مستأنفة و(لِمَنْ) متعلقان بمحذوف صفة عبرة (يَخْشى) مضارع فاعله مستتر والجملة صلة من.\r\n\r\n"},{"sura":79,"ayah":27,"words":[{"position":1,"arabic":"ءَأَنتُمْ","translation":"Are you","transliteration":"a-antum"},{"position":2,"arabic":"أَشَدُّ","translation":"a more difficult","transliteration":"ashaddu"},{"position":3,"arabic":"خَلْقًا","translation":"creation","transliteration":"khalqan"},{"position":4,"arabic":"أَمِ","translation":"or","transliteration":"ami"},{"position":5,"arabic":"ٱلسَّمَآءُ ۚ","translation":"the heaven","transliteration":"l-samāu"},{"position":6,"arabic":"بَنَىٰهَا","translation":"He constructed it","transliteration":"banāhā"}],"e3rab":"(أَأَنْتُمْ) الهمزة حرف استفهام و(أَنْتُمْ أَشَدُّ) مبتدأ وخبره والجملة مستأنفة و(خَلْقاً) تمييز و(أَمِ) حرف عطف و(السَّماءُ) مبتدأ وخبره محذوف والجملة الاسمية معطوفة على ما قبلها (بَناها) ماض ومفعوله والفاعل مستتر والجملة الفعلية حال\r\n\r\n"},{"sura":79,"ayah":28,"words":[{"position":1,"arabic":"رَفَعَ","translation":"He raised","transliteration":"rafaʿa"},{"position":2,"arabic":"سَمْكَهَا","translation":"its ceiling","transliteration":"samkahā"},{"position":3,"arabic":"فَسَوَّىٰهَا","translation":"and proportioned it","transliteration":"fasawwāhā"}],"e3rab":"(رَفَعَ) ماض فاعله مستتر و(سَمْكَها) مفعول به والجملة مفسرة (فَسَوَّاها) ماض ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":79,"ayah":29,"words":[{"position":1,"arabic":"وَأَغْطَشَ","translation":"And He darkened","transliteration":"wa-aghṭasha"},{"position":2,"arabic":"لَيْلَهَا","translation":"its night","transliteration":"laylahā"},{"position":3,"arabic":"وَأَخْرَجَ","translation":"and brought out","transliteration":"wa-akhraja"},{"position":4,"arabic":"ضُحَىٰهَا","translation":"its brightness","transliteration":"ḍuḥāhā"}],"e3rab":"(وَأَغْطَشَ لَيْلَها) ماض ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها (وَأَخْرَجَ ضُحاها) معطوفة على أغطش ليلها.\r\n\r\n"},{"sura":79,"ayah":30,"words":[{"position":1,"arabic":"وَٱلْأَرْضَ","translation":"And the earth","transliteration":"wal-arḍa"},{"position":2,"arabic":"بَعْدَ","translation":"after","transliteration":"baʿda"},{"position":3,"arabic":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":4,"arabic":"دَحَىٰهَآ","translation":"He spread it","transliteration":"daḥāhā"}],"e3rab":"(وَالْأَرْضَ) مفعول به لفعل محذوف يفسره ما بعده و(بَعْدَ ذلِكَ) ظرف زمان مضاف إلى ذلك. و(دَحاها) ماض ومفعوله والفاعل مستتر والجملة مفسرة\r\n\r\n"},{"sura":79,"ayah":31,"words":[{"position":1,"arabic":"أَخْرَجَ","translation":"He brought forth","transliteration":"akhraja"},{"position":2,"arabic":"مِنْهَا","translation":"from it","transliteration":"min'hā"},{"position":3,"arabic":"مَآءَهَا","translation":"its water","transliteration":"māahā"},{"position":4,"arabic":"وَمَرْعَىٰهَا","translation":"and its pasture","transliteration":"wamarʿāhā"}],"e3rab":"(أَخْرَجَ) ماض فاعله مستتر و(مِنْها) متعلقان بالفعل و(ماءَها) مفعول به (وَمَرْعاها) معطوف على ماءها والجملة حال.\r\n\r\n"},{"sura":79,"ayah":32,"words":[{"position":1,"arabic":"وَٱلْجِبَالَ","translation":"And the mountains","transliteration":"wal-jibāla"},{"position":2,"arabic":"أَرْسَىٰهَا","translation":"He made them firm","transliteration":"arsāhā"}],"e3rab":"«وَالْجِبالَ أَرْساها» كإعراب سابقتها.\r\n\r\n"},{"sura":79,"ayah":33,"words":[{"position":1,"arabic":"مَتَـٰعًۭا","translation":"(As) a provision","transliteration":"matāʿan"},{"position":2,"arabic":"لَّكُمْ","translation":"for you","transliteration":"lakum"},{"position":3,"arabic":"وَلِأَنْعَـٰمِكُمْ","translation":"and for your cattle","transliteration":"wali-anʿāmikum"}],"e3rab":"و(مَتاعاً) مفعول لأجله و(لَكُمْ) متعلقان بما قبلهما (وَلِأَنْعامِكُمْ) معطوفان على لكم.\r\n\r\n"},{"sura":79,"ayah":34,"words":[{"position":1,"arabic":"فَإِذَا","translation":"But when","transliteration":"fa-idhā"},{"position":2,"arabic":"جَآءَتِ","translation":"comes","transliteration":"jāati"},{"position":3,"arabic":"ٱلطَّآمَّةُ","translation":"the Overwhelming Calamity","transliteration":"l-ṭāmatu"},{"position":4,"arabic":"ٱلْكُبْرَىٰ","translation":"the great","transliteration":"l-kub'rā"}],"e3rab":"(فَإِذا) الفاء حرف استئناف وإذا ظرفية شرطية غير جازمة (جاءَتِ الطَّامَّةُ) ماض وفاعله وجواب الشرط محذوف (الْكُبْرى) صفة الطامة والجملة الفعلية في محل جر بالإضافة.\r\n\r\n"},{"sura":79,"ayah":35,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"يَتَذَكَّرُ","translation":"will remember","transliteration":"yatadhakkaru"},{"position":3,"arabic":"ٱلْإِنسَـٰنُ","translation":"man","transliteration":"l-insānu"},{"position":4,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":5,"arabic":"سَعَىٰ","translation":"he strove (for)","transliteration":"saʿā"}],"e3rab":"(يَوْمَ) ظرف زمان بدل من إذا و(يَتَذَكَّرُ الْإِنْسانُ) ماض وفاعله والجملة في محل جر بالإضافة و(ما) مفعول به و(سَعى) ماض فاعله مستتر والجملة صلة.\r\n\r\n"},{"sura":79,"ayah":36,"words":[{"position":1,"arabic":"وَبُرِّزَتِ","translation":"And will be made manifest","transliteration":"waburrizati"},{"position":2,"arabic":"ٱلْجَحِيمُ","translation":"the Hellfire","transliteration":"l-jaḥīmu"},{"position":3,"arabic":"لِمَن","translation":"to (him) who","transliteration":"liman"},{"position":4,"arabic":"يَرَىٰ","translation":"sees","transliteration":"yarā"}],"e3rab":"(وَبُرِّزَتِ) ماض مبني للمجهول و(الْجَحِيمُ) نائب فاعله والجملة معطوفة على ما قبلها. و(لِمَنْ) متعلقان بما قبلهما (يَرى) مضارع فاعله مستتر والجملة صلة من.\r\n\r\n"},{"sura":79,"ayah":37,"words":[{"position":1,"arabic":"فَأَمَّا","translation":"Then as for","transliteration":"fa-ammā"},{"position":2,"arabic":"مَن","translation":"(him) who","transliteration":"man"},{"position":3,"arabic":"طَغَىٰ","translation":"transgressed","transliteration":"ṭaghā"}],"e3rab":"(فَأَمَّا) الفاء حرف استئناف و(أما) أداة شرط وتفصيل و(مَنْ) اسم موصول مبتدأ (طَغى) ماض فاعله مستتر والجملة الفعلية صلة من\r\n\r\n"},{"sura":79,"ayah":38,"words":[{"position":1,"arabic":"وَءَاثَرَ","translation":"And preferred","transliteration":"waāthara"},{"position":2,"arabic":"ٱلْحَيَوٰةَ","translation":"the life","transliteration":"l-ḥayata"},{"position":3,"arabic":"ٱلدُّنْيَا","translation":"(of) the world","transliteration":"l-dun'yā"}],"e3rab":"(وَآثَرَ) معطوف على طغى (الْحَياةَ) مفعول به (الدُّنْيا) صفة\r\n\r\n"},{"sura":79,"ayah":39,"words":[{"position":1,"arabic":"فَإِنَّ","translation":"Then indeed","transliteration":"fa-inna"},{"position":2,"arabic":"ٱلْجَحِيمَ","translation":"the Hellfire","transliteration":"l-jaḥīma"},{"position":3,"arabic":"هِىَ","translation":"it","transliteration":"hiya"},{"position":4,"arabic":"ٱلْمَأْوَىٰ","translation":"(is) the refuge","transliteration":"l-mawā"}],"e3rab":"(فَإِنَّ الْجَحِيمَ) الفاء رابطة وإن واسمها و(هِيَ) ضمير فصل و(الْمَأْوى) خبر إن والجملة الاسمية خبر من.\r\n\r\n"},{"sura":79,"ayah":40,"words":[{"position":1,"arabic":"وَأَمَّا","translation":"But as for","transliteration":"wa-ammā"},{"position":2,"arabic":"مَنْ","translation":"(him) who","transliteration":"man"},{"position":3,"arabic":"خَافَ","translation":"feared","transliteration":"khāfa"},{"position":4,"arabic":"مَقَامَ","translation":"standing","transliteration":"maqāma"},{"position":5,"arabic":"رَبِّهِۦ","translation":"(before) his Lord","transliteration":"rabbihi"},{"position":6,"arabic":"وَنَهَى","translation":"and restrained","transliteration":"wanahā"},{"position":7,"arabic":"ٱلنَّفْسَ","translation":"his soul","transliteration":"l-nafsa"},{"position":8,"arabic":"عَنِ","translation":"from","transliteration":"ʿani"},{"position":9,"arabic":"ٱلْهَوَىٰ","translation":"the vain desires","transliteration":"l-hawā"}],"e3rab":"الآية معطوفا على ما قبلها وإعرابها واضح.\r\n\r\n"},{"sura":79,"ayah":41,"words":[{"position":1,"arabic":"فَإِنَّ","translation":"Then indeed","transliteration":"fa-inna"},{"position":2,"arabic":"ٱلْجَنَّةَ","translation":"Paradise ","transliteration":"l-janata"},{"position":3,"arabic":"هِىَ","translation":"it (is)","transliteration":"hiya"},{"position":4,"arabic":"ٱلْمَأْوَىٰ","translation":"the refuge","transliteration":"l-mawā"}],"e3rab":"الآية معطوفا على ما قبلها وإعرابها واضح.\r\n\r\n"},{"sura":79,"ayah":42,"words":[{"position":1,"arabic":"يَسْـَٔلُونَكَ","translation":"They ask you","transliteration":"yasalūnaka"},{"position":2,"arabic":"عَنِ","translation":"about","transliteration":"ʿani"},{"position":3,"arabic":"ٱلسَّاعَةِ","translation":"the Hour","transliteration":"l-sāʿati"},{"position":4,"arabic":"أَيَّانَ","translation":"when","transliteration":"ayyāna"},{"position":5,"arabic":"مُرْسَىٰهَا","translation":"(is) its arrival","transliteration":"mur'sāhā"}],"e3rab":"(يَسْئَلُونَكَ) مضارع وفاعله ومفعوله و(عَنِ السَّاعَةِ) متعلقان بالفعل والجملة مستأنفة و(أَيَّانَ) اسم استفهام في محل نصب على الظرفية الزمانية متعلق بمحذوف خبر مقدم و(مُرْساها) مبتدأ مؤخر والجملة الاسمية مفعول به ثان ليسألونك\r\n\r\n"},{"sura":79,"ayah":43,"words":[{"position":1,"arabic":"فِيمَ","translation":"In what","transliteration":"fīma"},{"position":2,"arabic":"أَنتَ","translation":"(are) you","transliteration":"anta"},{"position":3,"arabic":"مِن","translation":"[of]","transliteration":"min"},{"position":4,"arabic":"ذِكْرَىٰهَآ","translation":"(to) mention it","transliteration":"dhik'rāhā"}],"e3rab":"و(فِيمَ) خبر مقدم و(أَنْتَ) مبتدأ مؤخر و(مِنْ ذِكْراها) متعلقان بالخبر المحذوف\r\n\r\n"},{"sura":79,"ayah":44,"words":[{"position":1,"arabic":"إِلَىٰ","translation":"To","transliteration":"ilā"},{"position":2,"arabic":"رَبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":3,"arabic":"مُنتَهَىٰهَآ","translation":"(is) its finality","transliteration":"muntahāhā"}],"e3rab":"و(إِلى رَبِّكَ) خبر مقدم و(مُنْتَهاها) مبتدأ مؤخر والجملة مستأنفة\r\n\r\n"},{"sura":79,"ayah":45,"words":[{"position":1,"arabic":"إِنَّمَآ","translation":"Only","transliteration":"innamā"},{"position":2,"arabic":"أَنتَ","translation":"you","transliteration":"anta"},{"position":3,"arabic":"مُنذِرُ","translation":"(are) a warner","transliteration":"mundhiru"},{"position":4,"arabic":"مَن","translation":"(for him) who","transliteration":"man"},{"position":5,"arabic":"يَخْشَىٰهَا","translation":"fears it","transliteration":"yakhshāhā"}],"e3rab":"و(إِنَّما) كافة ومكفوفة و(أَنْتَ مُنْذِرُ) مبتدأ وخبره والجملة مستأنفة و(مَنْ) مضاف إليه و(يَخْشاها) مضارع ومفعوله والفاعل مستتر والجملة صلة من.\r\n\r\n"},{"sura":79,"ayah":46,"words":[{"position":1,"arabic":"كَأَنَّهُمْ","translation":"As though they","transliteration":"ka-annahum"},{"position":2,"arabic":"يَوْمَ","translation":"(the) Day","transliteration":"yawma"},{"position":3,"arabic":"يَرَوْنَهَا","translation":"they see it","transliteration":"yarawnahā"},{"position":4,"arabic":"لَمْ","translation":"not","transliteration":"lam"},{"position":5,"arabic":"يَلْبَثُوٓا۟","translation":"they had remained","transliteration":"yalbathū"},{"position":6,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":7,"arabic":"عَشِيَّةً","translation":"an evening","transliteration":"ʿashiyyatan"},{"position":8,"arabic":"أَوْ","translation":"or","transliteration":"aw"},{"position":9,"arabic":"ضُحَىٰهَا","translation":"a morning thereof","transliteration":"ḍuḥāhā"}],"e3rab":"(كَأَنَّهُمْ) كأن واسمها و(يَوْمَ) ظرف زمان (يَرَوْنَها) مضارع وفاعله ومفعوله والجملة في محل جر بالإضافة (لَمْ يَلْبَثُوا) مضارع مجزوم بلم والواو فاعله والجملة الفعلية خبر كأن والجملة الاسمية مستأنفة لا محل لها (إِلَّا) حرف حصر و(عَشِيَّةً) ظرف زمان (أَوْ) حرف عطف و(ضُحاها) معطوف على عشية.\r\n\r\n"}]