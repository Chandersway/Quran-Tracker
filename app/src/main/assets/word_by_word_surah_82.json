[{"sura":82,"ayah":1,"words":[{"position":1,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":2,"arabic":"ٱلسَّمَآءُ","translation":"the sky","transliteration":"l-samāu"},{"position":3,"arabic":"ٱنفَطَرَتْ","translation":"(is) cleft asunder","transliteration":"infaṭarat"}],"e3rab":"سبق إعرابها في سورة التكوير.\r\n\r\n"},{"sura":82,"ayah":2,"words":[{"position":1,"arabic":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"arabic":"ٱلْكَوَاكِبُ","translation":"the stars","transliteration":"l-kawākibu"},{"position":3,"arabic":"ٱنتَثَرَتْ","translation":"scatter","transliteration":"intatharat"}],"e3rab":"سبق إعرابها في سورة التكوير.\r\n\r\n"},{"sura":82,"ayah":3,"words":[{"position":1,"arabic":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"arabic":"ٱلْبِحَارُ","translation":"the seas","transliteration":"l-biḥāru"},{"position":3,"arabic":"فُجِّرَتْ","translation":"are made to gush forth","transliteration":"fujjirat"}],"e3rab":"سبق إعرابها في سورة التكوير.\r\n\r\n"},{"sura":82,"ayah":4,"words":[{"position":1,"arabic":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"arabic":"ٱلْقُبُورُ","translation":"the graves","transliteration":"l-qubūru"},{"position":3,"arabic":"بُعْثِرَتْ","translation":"are overturned","transliteration":"buʿ'thirat"}],"e3rab":"سبق إعرابها في سورة التكوير.\r\n\r\n"},{"sura":82,"ayah":5,"words":[{"position":1,"arabic":"عَلِمَتْ","translation":"Will know","transliteration":"ʿalimat"},{"position":2,"arabic":"نَفْسٌۭ","translation":"a soul","transliteration":"nafsun"},{"position":3,"arabic":"مَّا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"قَدَّمَتْ","translation":"it has sent forth","transliteration":"qaddamat"},{"position":5,"arabic":"وَأَخَّرَتْ","translation":"and left behind","transliteration":"wa-akharat"}],"e3rab":"سبق إعرابها في سورة التكوير.\r\n\r\n"},{"sura":82,"ayah":6,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلْإِنسَـٰنُ","translation":"man","transliteration":"l-insānu"},{"position":3,"arabic":"مَا","translation":"What","transliteration":"mā"},{"position":4,"arabic":"غَرَّكَ","translation":"has deceived you","transliteration":"gharraka"},{"position":5,"arabic":"بِرَبِّكَ","translation":"concerning your Lord","transliteration":"birabbika"},{"position":6,"arabic":"ٱلْكَرِيمِ","translation":"the Most Noble","transliteration":"l-karīmi"}],"e3rab":"(يا) حرف نداء و(أَيُّهَا) منادى مبني على الضم و(ها) حرف تنبيه و(الْإِنْسانُ) بدل و(ما) اسم استفهام مبتدأ و(غَرَّكَ) ماض ومفعوله والفاعل مستتر والجملة خبر ما و(بِرَبِّكَ) متعلقان بالفعل و(الْكَرِيمِ) صفة.\r\n\r\n"},{"sura":82,"ayah":7,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"Who","transliteration":"alladhī"},{"position":2,"arabic":"خَلَقَكَ","translation":"created you","transliteration":"khalaqaka"},{"position":3,"arabic":"فَسَوَّىٰكَ","translation":"then fashioned you","transliteration":"fasawwāka"},{"position":4,"arabic":"فَعَدَلَكَ","translation":"then balanced you","transliteration":"faʿadalaka"}],"e3rab":"(الَّذِي) صفة ثانية لربك و(خَلَقَكَ) ماض ومفعوله والجملة صلة و(فَسَوَّاكَ) معطوف على خلقك و(فَعَدَلَكَ) معطوف أيضا.\r\n\r\n"},{"sura":82,"ayah":8,"words":[{"position":1,"arabic":"فِىٓ","translation":"In","transliteration":"fī"},{"position":2,"arabic":"أَىِّ","translation":"whatever","transliteration":"ayyi"},{"position":3,"arabic":"صُورَةٍۢ","translation":"form","transliteration":"ṣūratin"},{"position":4,"arabic":"مَّا","translation":"what","transliteration":"mā"},{"position":5,"arabic":"شَآءَ","translation":"He willed","transliteration":"shāa"},{"position":6,"arabic":"رَكَّبَكَ","translation":"He assembled you","transliteration":"rakkabaka"}],"e3rab":"(فِي أَيِّ) متعلقان بركبك و(صُورَةٍ) مضاف إليه و(ما) زائدة (شاءَ) ماض فاعله مستتر والجملة صفة صورة و(رَكَّبَكَ) ماض ومفعوله والفاعل مستتر والجملة حال.\r\n\r\n"},{"sura":82,"ayah":9,"words":[{"position":1,"arabic":"كَلَّا","translation":"Nay","transliteration":"kallā"},{"position":2,"arabic":"بَلْ","translation":"But","transliteration":"bal"},{"position":3,"arabic":"تُكَذِّبُونَ","translation":"you deny","transliteration":"tukadhibūna"},{"position":4,"arabic":"بِٱلدِّينِ","translation":"the Judgment","transliteration":"bil-dīni"}],"e3rab":"(كَلَّا) حرف ردع وزجر و(بَلْ) حرف إضراب انتقالي (تُكَذِّبُونَ) مضارع مرفوع والواو فاعله و(بِالدِّينِ) متعلقان بالفعل، والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":82,"ayah":10,"words":[{"position":1,"arabic":"وَإِنَّ","translation":"And indeed","transliteration":"wa-inna"},{"position":2,"arabic":"عَلَيْكُمْ","translation":"over you","transliteration":"ʿalaykum"},{"position":3,"arabic":"لَحَـٰفِظِينَ","translation":"(are) surely guardians","transliteration":"laḥāfiẓīna"}],"e3rab":"(وَإِنَّ) الواو حالية وإن حرف مشبه بالفعل و(عَلَيْكُمْ) متعلقان بمحذوف خبر إن المقدم (لَحافِظِينَ) اللام المزحلقة و(حافظين) اسم إن المؤخر والجملة حال.\r\n\r\n"},{"sura":82,"ayah":11,"words":[{"position":1,"arabic":"كِرَامًۭا","translation":"Noble","transliteration":"kirāman"},{"position":2,"arabic":"كَـٰتِبِينَ","translation":"recording","transliteration":"kātibīna"}],"e3rab":"صفتان لحافظين.\r\n\r\n"},{"sura":82,"ayah":12,"words":[{"position":1,"arabic":"يَعْلَمُونَ","translation":"They know","transliteration":"yaʿlamūna"},{"position":2,"arabic":"مَا","translation":"whatever","transliteration":"mā"},{"position":3,"arabic":"تَفْعَلُونَ","translation":"you do","transliteration":"tafʿalūna"}],"e3rab":"(يَعْلَمُونَ) مضارع وفاعله و(ما) مفعول به والجملة حال و(تَفْعَلُونَ) مضارع وفاعله والجملة صلة.\r\n\r\n"},{"sura":82,"ayah":13,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلْأَبْرَارَ","translation":"the righteous","transliteration":"l-abrāra"},{"position":3,"arabic":"لَفِى","translation":"(will be) surely in","transliteration":"lafī"},{"position":4,"arabic":"نَعِيمٍۢ","translation":"bliss","transliteration":"naʿīmin"}],"e3rab":"(إِنَّ الْأَبْرارَ) إن واسمها (لَفِي) اللام المزحلقة و(في نَعِيمٍ) متعلقان بمحذوف خبر إن والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":82,"ayah":14,"words":[{"position":1,"arabic":"وَإِنَّ","translation":"And indeed","transliteration":"wa-inna"},{"position":2,"arabic":"ٱلْفُجَّارَ","translation":"the wicked","transliteration":"l-fujāra"},{"position":3,"arabic":"لَفِى","translation":"(will be) surely in","transliteration":"lafī"},{"position":4,"arabic":"جَحِيمٍۢ","translation":"Hellfire","transliteration":"jaḥīmin"}],"e3rab":"معطوفة على ما قبلها والإعراب واضح.\r\n\r\n"},{"sura":82,"ayah":15,"words":[{"position":1,"arabic":"يَصْلَوْنَهَا","translation":"They will burn (in) it","transliteration":"yaṣlawnahā"},{"position":2,"arabic":"يَوْمَ","translation":"(on the) Day","transliteration":"yawma"},{"position":3,"arabic":"ٱلدِّينِ","translation":"(of) the Judgment","transliteration":"l-dīni"}],"e3rab":"(يَصْلَوْنَها) مضارع وفاعله ومفعوله والجملة حال و(يَوْمَ الدِّينِ) ظرف زمان مضاف إلى الدين.\r\n\r\n"},{"sura":82,"ayah":16,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":3,"arabic":"عَنْهَا","translation":"from it","transliteration":"ʿanhā"},{"position":4,"arabic":"بِغَآئِبِينَ","translation":"(will be) absent","transliteration":"bighāibīna"}],"e3rab":"(وَما) الواو حالية و(ما) حجازية تعمل عمل ليس و(هُمْ) اسمها و(عَنْها) متعلقان بما بعدها و(بِغائِبِينَ) مجرور لفظا منصوب محلا خبر ما والجملة حال.\r\n\r\n"},{"sura":82,"ayah":17,"words":[{"position":1,"arabic":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"arabic":"أَدْرَىٰكَ","translation":"can make you know","transliteration":"adrāka"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"يَوْمُ","translation":"(is the) Day","transliteration":"yawmu"},{"position":5,"arabic":"ٱلدِّينِ","translation":"(of) the Judgment","transliteration":"l-dīni"}],"e3rab":"(وَما) الواو حرف استئناف و(ما) اسم استفهام مبتدأ (أَدْراكَ) ماض ومفعوله والفاعل مستتر والجملة الفعلية خبر ما والجملة الاسمية مستأنفة و(ما يَوْمُ) مبتدأ وخبره و(الدِّينِ) مضاف إليه والجملة سدت مسد مفعول أدراك الثاني.\r\n\r\n"},{"sura":82,"ayah":18,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"مَآ","translation":"what","transliteration":"mā"},{"position":3,"arabic":"أَدْرَىٰكَ","translation":"can make you know","transliteration":"adrāka"},{"position":4,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":5,"arabic":"يَوْمُ","translation":"(is the) Day","transliteration":"yawmu"},{"position":6,"arabic":"ٱلدِّينِ","translation":"(of) the Judgment","transliteration":"l-dīni"}],"e3rab":"معطوفة على ما قبلها والإعراب واحد.\r\n\r\n"},{"sura":82,"ayah":19,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":3,"arabic":"تَمْلِكُ","translation":"will have power","transliteration":"tamliku"},{"position":4,"arabic":"نَفْسٌۭ","translation":"a soul","transliteration":"nafsun"},{"position":5,"arabic":"لِّنَفْسٍۢ","translation":"for a soul","transliteration":"linafsin"},{"position":6,"arabic":"شَيْـًۭٔا ۖ","translation":"anything","transliteration":"shayan"},{"position":7,"arabic":"وَٱلْأَمْرُ","translation":"and the Command","transliteration":"wal-amru"},{"position":8,"arabic":"يَوْمَئِذٍۢ","translation":"that Day","transliteration":"yawma-idhin"},{"position":9,"arabic":"لِّلَّهِ","translation":"(will be) with Allah","transliteration":"lillahi"}],"e3rab":"(يَوْمَ) مفعول به لفعل محذوف و(لا) نافية (تَمْلِكُ نَفْسٌ) مضارع وفاعله و(لِنَفْسٍ) متعلقان بالفعل و(شَيْئاً) مفعول به والجملة في محل جر بالإضافة.\r\n\r\n(وَالْأَمْرُ) الواو حرف استئناف و(الْأَمْرُ) مبتدأ و(يَوْمَئِذٍ) ظرف زمان مضاف إلى مثله متعلق بمحذوف خبر المبتدأ و(لِلَّهِ) متعلقان بالخبر المحذوف والجملة الاسمية مستأنفة.\r\n\r\n"}]