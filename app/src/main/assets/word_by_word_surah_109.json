[{"sura":109,"ayah":1,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":3,"arabic":"ٱلْكَـٰفِرُونَ","translation":"disbelievers","transliteration":"l-kāfirūna"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة ابتدائية لا محل لها (يا) حرف نداء (أي) منادى نكرة مقصودة (ها) للتنبيه (الْكافِرُونَ) صفة أو بدل والجملة مقول القول.\r\n\r\n"},{"sura":109,"ayah":2,"words":[{"position":1,"arabic":"لَآ","translation":"Not","transliteration":"lā"},{"position":2,"arabic":"أَعْبُدُ","translation":"I worship","transliteration":"aʿbudu"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"تَعْبُدُونَ","translation":"you worship","transliteration":"taʿbudūna"}],"e3rab":"(لا أَعْبُدُ) لا نافية ومضارع فاعله مستتر (ما) اسم موصول مفعول به والجملة حال (تَعْبُدُونَ) مضارع مرفوع والواو فاعله والجملة صلة.\r\n\r\n"},{"sura":109,"ayah":3,"words":[{"position":1,"arabic":"وَلَآ","translation":"And not","transliteration":"walā"},{"position":2,"arabic":"أَنتُمْ","translation":"you","transliteration":"antum"},{"position":3,"arabic":"عَـٰبِدُونَ","translation":"(are) worshippers","transliteration":"ʿābidūna"},{"position":4,"arabic":"مَآ","translation":"(of) what","transliteration":"mā"},{"position":5,"arabic":"أَعْبُدُ","translation":"I worship","transliteration":"aʿbudu"}],"e3rab":"(وَلا) الواو حرف عطف (لا) نافية (أَنْتُمْ) مبتدأ (عابِدُونَ) خبر والجملة معطوفة على ما قبلها (ما) مفعول به لاسم الفاعل (أَعْبُدُ) مضارع فاعله مستتر والجملة صلة ما.\r\n\r\n"},{"sura":109,"ayah":4,"words":[{"position":1,"arabic":"وَلَآ","translation":"And not","transliteration":"walā"},{"position":2,"arabic":"أَنَا۠","translation":"I am","transliteration":"anā"},{"position":3,"arabic":"عَابِدٌۭ","translation":"a worshipper","transliteration":"ʿābidun"},{"position":4,"arabic":"مَّا","translation":"(of) what","transliteration":"mā"},{"position":5,"arabic":"عَبَدتُّمْ","translation":"you worship","transliteration":"ʿabadttum"}],"e3rab":"(وَلا) الواو حرف عطف (لا) نافية (أَنا عابِدٌ) مبتدأ وخبره والجملة معطوفة على ما قبلها (ما) مفعول به (عَبَدْتُّمْ) ماض وفاعله والجملة صلة.\r\n\r\n"},{"sura":109,"ayah":5,"words":[{"position":1,"arabic":"وَلَآ","translation":"And not","transliteration":"walā"},{"position":2,"arabic":"أَنتُمْ","translation":"you","transliteration":"antum"},{"position":3,"arabic":"عَـٰبِدُونَ","translation":"(are) worshippers","transliteration":"ʿābidūna"},{"position":4,"arabic":"مَآ","translation":"(of) what","transliteration":"mā"},{"position":5,"arabic":"أَعْبُدُ","translation":"I worship","transliteration":"aʿbudu"}],"e3rab":"انظر الآية - 3 - .\r\n\r\n"},{"sura":109,"ayah":6,"words":[{"position":1,"arabic":"لَكُمْ","translation":"For you","transliteration":"lakum"},{"position":2,"arabic":"دِينُكُمْ","translation":"(is) your religion","transliteration":"dīnukum"},{"position":3,"arabic":"وَلِىَ","translation":"and for me","transliteration":"waliya"},{"position":4,"arabic":"دِينِ","translation":"(is) my religion","transliteration":"dīni"}],"e3rab":"(لَكُمْ دِينُكُمْ) لكم خبر مقدم ودينكم مبتدأ مؤخر والجملة الاسمية مستأنفة لا محل لها (وَلِيَ دِينِ) معطوفة على ما قبلها.\r\n\r\n"}]