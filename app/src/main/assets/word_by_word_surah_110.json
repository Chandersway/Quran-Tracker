[{"sura":110,"ayah":1,"words":[{"position":1,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":2,"arabic":"جَآءَ","translation":"comes","transliteration":"jāa"},{"position":3,"arabic":"نَصْرُ","translation":"(the) Help","transliteration":"naṣru"},{"position":4,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":5,"arabic":"وَٱلْفَتْحُ","translation":"and the Victory","transliteration":"wal-fatḥu"}],"e3rab":"(إِذا) ظرفية شرطية غير جازمة (جاءَ نَصْرُ اللَّهِ) ماض وفاعله ولفظ الجلالة مضاف إليه والجملة ابتدائية لا محل لها (وَالْفَتْحُ) معطوف على ما قبله.\r\n\r\n"},{"sura":110,"ayah":2,"words":[{"position":1,"arabic":"وَرَأَيْتَ","translation":"And you see","transliteration":"wara-ayta"},{"position":2,"arabic":"ٱلنَّاسَ","translation":"the people","transliteration":"l-nāsa"},{"position":3,"arabic":"يَدْخُلُونَ","translation":"entering","transliteration":"yadkhulūna"},{"position":4,"arabic":"فِى","translation":"into","transliteration":"fī"},{"position":5,"arabic":"دِينِ","translation":"(the) religion","transliteration":"dīni"},{"position":6,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":7,"arabic":"أَفْوَاجًۭا","translation":"(in) multitudes","transliteration":"afwājan"}],"e3rab":"(وَرَأَيْتَ) ماض وفاعله (النَّاسَ) مفعول به والجملة معطوفة على ما قبلها (يَدْخُلُونَ) مضارع وفاعله (فِي دِينِ اللَّهِ) متعلقان بالفعل ولفظ الجلالة مضاف إليه (أَفْواجاً) حال والجملة حال.\r\n\r\n"},{"sura":110,"ayah":3,"words":[{"position":1,"arabic":"فَسَبِّحْ","translation":"Then glorify","transliteration":"fasabbiḥ"},{"position":2,"arabic":"بِحَمْدِ","translation":"with (the) praises","transliteration":"biḥamdi"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"وَٱسْتَغْفِرْهُ ۚ","translation":"and ask His forgiveness","transliteration":"wa-is'taghfir'hu"},{"position":5,"arabic":"إِنَّهُۥ","translation":"Indeed, He","transliteration":"innahu"},{"position":6,"arabic":"كَانَ","translation":"is","transliteration":"kāna"},{"position":7,"arabic":"تَوَّابًۢا","translation":"Oft-Returning","transliteration":"tawwāban"}],"e3rab":"(فَسَبِّحْ) الفاء رابطة وأمر فاعله مستتر والجملة جواب إذا لا محل لها (بِحَمْدِ) متعلقان بالفعل (رَبِّكَ) مضاف إليه (وَاسْتَغْفِرْهُ) أمر ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها.\r\n\r\n(إِنَّهُ) إن واسمها (كانَ) كان واسمها المستتر (تَوَّاباً) خبرها والجملة الفعلية خبر إن. والجملة الاسمية تعليل لا محل لها.\r\n\r\n"}]