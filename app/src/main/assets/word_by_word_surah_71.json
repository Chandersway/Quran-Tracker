قبله (وَدًّا) مفعول به وما بعده معطوف عليه.\r\n\r\n"},{"sura":71,"ayah":24,"words":[{"position":1,"arabic":"وَقَدْ","translation":"And indeed","transliteration":"waqad"},{"position":2,"arabic":"أَضَلُّوا۟","translation":"they have led astray","transliteration":"aḍallū"},{"position":3,"arabic":"كَثِيرًۭا ۖ","translation":"many","transliteration":"kathīran"},{"position":4,"arabic":"وَلَا","translation":"And not","transliteration":"walā"},{"position":5,"arabic":"تَزِدِ","translation":"increase","transliteration":"tazidi"},{"position":6,"arabic":"ٱلظَّـٰلِمِينَ","translation":"the wrongdoers","transliteration":"l-ẓālimīna"},{"position":7,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":8,"arabic":"ضَلَـٰلًۭا","translation":"(in) error","transliteration":"ḍalālan"}],"e3rab":"(وَقَدْ) الواو حالية (وَقَدْ أَضَلُّوا) قد حرف تحقيق وماض وفاعله (كَثِيراً) مفعول به والجملة حال (وَلا تَزِدِ) الواو حرف عطف ومضارع مجزوم بلا وفاعله مستتر (الظَّالِمِينَ) مفعول به أول (إِلَّا) حرف حصر (ضَلالًا) مفعول به ثان.\r\n\r\n"},{"sura":71,"ayah":25,"words":[{"position":1,"arabic":"مِّمَّا","translation":"Because of","transliteration":"mimmā"},{"position":2,"arabic":"خَطِيٓـَٔـٰتِهِمْ","translation":"their sins","transliteration":"khaṭīātihim"},{"position":3,"arabic":"أُغْرِقُوا۟","translation":"they were drowned","transliteration":"ugh'riqū"},{"position":4,"arabic":"فَأُدْخِلُوا۟","translation":"then made to enter","transliteration":"fa-ud'khilū"},{"position":5,"arabic":"نَارًۭا","translation":"(the) Fire","transliteration":"nāran"},{"position":6,"arabic":"فَلَمْ","translation":"and not","transliteration":"falam"},{"position":7,"arabic":"يَجِدُوا۟","translation":"they found","transliteration":"yajidū"},{"position":8,"arabic":"لَهُم","translation":"for themselves","transliteration":"lahum"},{"position":9,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":10,"arabic":"دُونِ","translation":"besides","transliteration":"dūni"},{"position":11,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":12,"arabic":"أَنصَارًۭا","translation":"any helpers","transliteration":"anṣāran"}],"e3rab":"(مِمَّا) من حرف جر (ما) زائدة (خَطِيئاتِهِمْ) مجرور بمن والجار والمجرور متعلقان بما بعدهما (أُغْرِقُوا) ماض مبني للمجهول والواو نائب فاعل والجملة مستأنفة لا محل لها (فَأُدْخِلُوا) معطوف على أغرقوا (ناراً) مفعول به ثان (فَلَمْ يَجِدُوا) الفاء حرف عطف ومضارع مجزوم بلم والواو فاعله (لَهُمْ) متعلقان بالفعل (مِنْ دُونِ اللَّهِ) من دون حال ولفظ الجلالة مضاف إليه (أَنْصاراً) مفعول به.\r\n\r\n"},{"sura":71,"ayah":26,"words":[{"position":1,"arabic":"وَقَالَ","translation":"And said","transliteration":"waqāla"},{"position":2,"arabic":"نُوحٌۭ","translation":"Nuh","transliteration":"nūḥun"},{"position":3,"arabic":"رَّبِّ","translation":"My Lord","transliteration":"rabbi"},{"position":4,"arabic":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"arabic":"تَذَرْ","translation":"leave","transliteration":"tadhar"},{"position":6,"arabic":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":7,"arabic":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":8,"arabic":"مِنَ","translation":"any","transliteration":"mina"},{"position":9,"arabic":"ٱلْكَـٰفِرِينَ","translation":"(of) the disbelievers","transliteration":"l-kāfirīna"},{"position":10,"arabic":"دَيَّارًا","translation":"(as) an inhabitant","transliteration":"dayyāran"}],"e3rab":"(وَقالَ نُوحٌ) ماض وفاعله والجملة معطوفة على ما قبلها (رَبِّ لا تَذَرْ) منادى مضاف إلى ياء المتكلم المحذوفة للتخفيف ومضارع مجزوم بلا والفاعل مستتر (عَلَى الْأَرْضِ) متعلقان بالفعل (مِنَ الْكافِرِينَ) حال (دَيَّاراً) مفعول به وجملة النداء والجملة الفعلية مقول القول.\r\n\r\n"},{"sura":71,"ayah":27,"words":[{"position":1,"arabic":"إِنَّكَ","translation":"Indeed, You","transliteration":"innaka"},{"position":2,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":3,"arabic":"تَذَرْهُمْ","translation":"You leave them","transliteration":"tadharhum"},{"position":4,"arabic":"يُضِلُّوا۟","translation":"they will mislead","transliteration":"yuḍillū"},{"position":5,"arabic":"عِبَادَكَ","translation":"Your slaves","transliteration":"ʿibādaka"},{"position":6,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":7,"arabic":"يَلِدُوٓا۟","translation":"they will beget","transliteration":"yalidū"},{"position":8,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":9,"arabic":"فَاجِرًۭا","translation":"a wicked","transliteration":"fājiran"},{"position":10,"arabic":"كَفَّارًۭا","translation":"a disbeliever","transliteration":"kaffāran"}],"e3rab":"(إِنَّكَ) إن واسمها (إِنْ تَذَرْهُمْ) إن شرطية جازمة ومضارع مجزوم لأنه فعل الشرط والهاء مفعول به والفاعل مستتر والجملة ابتدائية لا محل لها (يُضِلُّوا) مضارع مجزوم لأنه جواب الشرط والواو فاعله (عِبادَكَ) مفعول به والجملة جواب الشرط لا محل لها والشرط وجوابه خبر إنك والجملة الاسمية مقول القول (وَلا يَلِدُوا) لا نافية ومضارع وفاعله (إِلَّا) حرف حصر (فاجِراً) مفعول به (كَفَّاراً) صفة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":71,"ayah":28,"words":[{"position":1,"arabic":"رَّبِّ","translation":"My Lord","transliteration":"rabbi"},{"position":2,"arabic":"ٱغْفِرْ","translation":"Forgive","transliteration":"igh'fir"},{"position":3,"arabic":"لِى","translation":"me","transliteration":"lī"},{"position":4,"arabic":"وَلِوَٰلِدَىَّ","translation":"and my parents","transliteration":"waliwālidayya"},{"position":5,"arabic":"وَلِمَن","translation":"and whoever","transliteration":"waliman"},{"position":6,"arabic":"دَخَلَ","translation":"enters","transliteration":"dakhala"},{"position":7,"arabic":"بَيْتِىَ","translation":"my house ","transliteration":"baytiya"},{"position":8,"arabic":"مُؤْمِنًۭا","translation":"a believer","transliteration":"mu'minan"},{"position":9,"arabic":"وَلِلْمُؤْمِنِينَ","translation":"and the believing men","transliteration":"walil'mu'minīna"},{"position":10,"arabic":"وَٱلْمُؤْمِنَـٰتِ","translation":"and the believing women","transliteration":"wal-mu'mināti"},{"position":11,"arabic":"وَلَا","translation":"And (do) not","transliteration":"walā"},{"position":12,"arabic":"تَزِدِ","translation":"increase","transliteration":"tazidi"},{"position":13,"arabic":"ٱلظَّـٰلِمِينَ","translation":"the wrongdoers","transliteration":"l-ẓālimīna"},{"position":14,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":15,"arabic":"تَبَارًۢا","translation":"(in) destruction","transliteration":"tabāran"}],"e3rab":"(رَبِّ اغْفِرْ) منادى مضاف إلى ياء المتكلم المحذوفة للتخفيف وفعل دعاء فاعله مستتر (لِي) متعلقان بالفعل (وَلِوالِدَيَّ) معطوف على لي (وَلِمَنْ) معطوفان على أيضا (دَخَلَ) ماض فاعله مستتر (بَيْتِيَ) مفعول به (مُؤْمِناً) حال والجملة صلة (وَلِلْمُؤْمِنِينَ وَالْمُؤْمِناتِ) عطف على ما قبله (وَلا تَزِدِ) مضارع مجزوم بلا فاعله مستتر (الظَّالِمِينَ) مفعول به أول (إِلَّا) حرف حصر (تَباراً) مفعول به ثان والجملة معطوفة على ما قبلها.\r\n\r\n"}]