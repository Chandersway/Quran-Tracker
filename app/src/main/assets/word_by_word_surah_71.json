[{"sura":71,"ayah":1,"words":[{"position":1,"arabic":"إِنَّآ","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"أَرْسَلْنَا","translation":"[We] sent","transliteration":"arsalnā"},{"position":3,"arabic":"نُوحًا","translation":"Nuh","transliteration":"nūḥan"},{"position":4,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":5,"arabic":"قَوْمِهِۦٓ","translation":"his people","transliteration":"qawmihi"},{"position":6,"arabic":"أَنْ","translation":"that","transliteration":"an"},{"position":7,"arabic":"أَنذِرْ","translation":"Warn","transliteration":"andhir"},{"position":8,"arabic":"قَوْمَكَ","translation":"your people","transliteration":"qawmaka"},{"position":9,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":10,"arabic":"قَبْلِ","translation":"before","transliteration":"qabli"},{"position":11,"arabic":"أَن","translation":"[that]","transliteration":"an"},{"position":12,"arabic":"يَأْتِيَهُمْ","translation":"comes to them","transliteration":"yatiyahum"},{"position":13,"arabic":"عَذَابٌ","translation":"a punishment","transliteration":"ʿadhābun"},{"position":14,"arabic":"أَلِيمٌۭ","translation":"painful","transliteration":"alīmun"}],"e3rab":"(إِنَّا أَرْسَلْنا) إن واسمها وماض وفاعله (نُوحاً) مفعوله والجملة الفعلية خبر إن والجملة الاسمية ابتدائية لا محل لها (إِلى قَوْمِهِ) متعلقان بالفعل.\r\n\r\n(أَنْ أَنْذِرْ) حرف تفسير وأمر فاعله مستتر.\r\n\r\n(قَوْمَكَ) مفعول به والجملة الفعلية مفسرة لا محل لها.\r\n\r\n(مِنْ قَبْلِ) متعلقان بالفعل (أَنْ يَأْتِيَهُمْ) مضارع منصوب بأن ومفعوله (عَذابٌ) فاعل (أَلِيمٌ) صفة والمصدر المؤول من أن والفعل في محل جر بالإضافة.\r\n\r\n"},{"sura":71,"ayah":2,"words":[{"position":1,"arabic":"قَالَ","translation":"He said","transliteration":"qāla"},{"position":2,"arabic":"يَـٰقَوْمِ","translation":"O my people","transliteration":"yāqawmi"},{"position":3,"arabic":"إِنِّى","translation":"Indeed, I am","transliteration":"innī"},{"position":4,"arabic":"لَكُمْ","translation":"to you","transliteration":"lakum"},{"position":5,"arabic":"نَذِيرٌۭ","translation":"a warner","transliteration":"nadhīrun"},{"position":6,"arabic":"مُّبِينٌ","translation":"clear","transliteration":"mubīnun"}],"e3rab":"(قالَ) ماض فاعله مستتر والجملة استئنافية لا محل لها (يا) حرف نداء (قَوْمِ إِنِّي) منادى مضاف إلى ياء المتكلم المحذوفة وجملة النداء مقول القول وإن واسمها (لَكُمْ) متعلقان بالخبر (نَذِيرٌ) خبر إنّ (مُبِينٌ) صفة والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":71,"ayah":3,"words":[{"position":1,"arabic":"أَنِ","translation":"That","transliteration":"ani"},{"position":2,"arabic":"ٱعْبُدُوا۟","translation":"Worship","transliteration":"uʿ'budū"},{"position":3,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":4,"arabic":"وَٱتَّقُوهُ","translation":"and fear Him","transliteration":"wa-ittaqūhu"},{"position":5,"arabic":"وَأَطِيعُونِ","translation":"and obey me","transliteration":"wa-aṭīʿūni"}],"e3rab":"(أَنِ اعْبُدُوا اللَّهَ) أن حرف تفسير وأمر وفاعله ولفظ الجلالة مفعوله والجملة مفسرة لا محل لها (وَاتَّقُوهُ وَأَطِيعُونِ) معطوفان على اعبدوا.\r\n\r\n"},{"sura":71,"ayah":4,"words":[{"position":1,"arabic":"يَغْفِرْ","translation":"He will forgive","transliteration":"yaghfir"},{"position":2,"arabic":"لَكُم","translation":"for you","transliteration":"lakum"},{"position":3,"arabic":"مِّن","translation":"[of]","transliteration":"min"},{"position":4,"arabic":"ذُنُوبِكُمْ","translation":"your sins","transliteration":"dhunūbikum"},{"position":5,"arabic":"وَيُؤَخِّرْكُمْ","translation":"and give you respite","transliteration":"wayu-akhir'kum"},{"position":6,"arabic":"إِلَىٰٓ","translation":"for","transliteration":"ilā"},{"position":7,"arabic":"أَجَلٍۢ","translation":"a term","transliteration":"ajalin"},{"position":8,"arabic":"مُّسَمًّى ۚ","translation":"specified","transliteration":"musamman"},{"position":9,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":10,"arabic":"أَجَلَ","translation":"(the) term","transliteration":"ajala"},{"position":11,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":12,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":13,"arabic":"جَآءَ","translation":"it comes","transliteration":"jāa"},{"position":14,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":15,"arabic":"يُؤَخَّرُ ۖ","translation":"is delayed","transliteration":"yu-akharu"},{"position":16,"arabic":"لَوْ","translation":"if","transliteration":"law"},{"position":17,"arabic":"كُنتُمْ","translation":"you","transliteration":"kuntum"},{"position":18,"arabic":"تَعْلَمُونَ","translation":"know","transliteration":"taʿlamūna"}],"e3rab":"(يَغْفِرْ) مضارع مجزوم لأنه جواب الطلب وفاعله مستتر والجملة جواب الطلب لا محل لها (لَكُمْ) متعلقان بالفعل (مِنْ ذُنُوبِكُمْ) متعلقان بالفعل أيضا وهما بمثابة المفعول به (وَيُؤَخِّرْكُمْ) معطوف على ما قبله (إِلى أَجَلٍ) متعلقان بالفعل (مُسَمًّى) صفة (إِنَّ أَجَلَ اللَّهِ) إن واسمها المضاف إلى لفظ الجلالة (إِذا جاءَ) إذا ظرفية شرطية غير جازمة وماض فاعله مستتر والجملة في محل جر بالإضافة (لا يُؤَخَّرُ) نافية ومضارع مبني للمجهول ونائب الفاعل مستتر والجملة جواب الشرط لا محل لها وإذا مع شرطها وجوابها خبر إن والجملة الاسمية تعليل لا محل لها (لَوْ) حرف شرط غير جازم (كُنْتُمْ) كان واسمها (تَعْلَمُونَ) مضارع مرفوع بثبوت النون والواو فاعله والجملة خبر كنتم وجملة كنتم.. ابتدائية لا محل لها.\r\n\r\n"},{"sura":71,"ayah":5,"words":[{"position":1,"arabic":"قَالَ","translation":"He said","transliteration":"qāla"},{"position":2,"arabic":"رَبِّ","translation":"My Lord","transliteration":"rabbi"},{"position":3,"arabic":"إِنِّى","translation":"Indeed, I","transliteration":"innī"},{"position":4,"arabic":"دَعَوْتُ","translation":"invited","transliteration":"daʿawtu"},{"position":5,"arabic":"قَوْمِى","translation":"my people","transliteration":"qawmī"},{"position":6,"arabic":"لَيْلًۭا","translation":"night","transliteration":"laylan"},{"position":7,"arabic":"وَنَهَارًۭا","translation":"and day","transliteration":"wanahāran"}],"e3rab":"(قالَ) ماض فاعله مستتر والجملة استئنافية لا محل لها (رَبِّ) منادى مضاف إلى ياء المتكلم المحذوفة للتخفيف وجملة النداء مقول القول (إِنِّي دَعَوْتُ) إن واسمها وماض وفاعله (قَوْمِي) مفعول به والجملة الفعلية خبر إن (لَيْلًا) ظرف زمان (وَنَهاراً) معطوف على ليلا\r\n\r\n"},{"sura":71,"ayah":6,"words":[{"position":1,"arabic":"فَلَمْ","translation":"But not","transliteration":"falam"},{"position":2,"arabic":"يَزِدْهُمْ","translation":"increased them","transliteration":"yazid'hum"},{"position":3,"arabic":"دُعَآءِىٓ","translation":"my invitation","transliteration":"duʿāī"},{"position":4,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":5,"arabic":"فِرَارًۭا","translation":"(in) flight","transliteration":"firāran"}],"e3rab":"(فَلَمْ يَزِدْهُمْ) الفاء حرف عطف ومضارع مجزوم بلم والهاء مفعوله الأول (دُعائِي) فاعل مؤخر (إِلَّا) حرف حصر (فِراراً) مفعول به ثان والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":71,"ayah":7,"words":[{"position":1,"arabic":"وَإِنِّى","translation":"And indeed, I","transliteration":"wa-innī"},{"position":2,"arabic":"كُلَّمَا","translation":"every time","transliteration":"kullamā"},{"position":3,"arabic":"دَعَوْتُهُمْ","translation":"I invited them","transliteration":"daʿawtuhum"},{"position":4,"arabic":"لِتَغْفِرَ","translation":"that You may forgive","transliteration":"litaghfira"},{"position":5,"arabic":"لَهُمْ","translation":"them","transliteration":"lahum"},{"position":6,"arabic":"جَعَلُوٓا۟","translation":"they put","transliteration":"jaʿalū"},{"position":7,"arabic":"أَصَـٰبِعَهُمْ","translation":"their fingers","transliteration":"aṣābiʿahum"},{"position":8,"arabic":"فِىٓ","translation":"in","transliteration":"fī"},{"position":9,"arabic":"ءَاذَانِهِمْ","translation":"their ears","transliteration":"ādhānihim"},{"position":10,"arabic":"وَٱسْتَغْشَوْا۟","translation":"and covered themselves","transliteration":"wa-is'taghshaw"},{"position":11,"arabic":"ثِيَابَهُمْ","translation":"(with) their garments","transliteration":"thiyābahum"},{"position":12,"arabic":"وَأَصَرُّوا۟","translation":"and persisted","transliteration":"wa-aṣarrū"},{"position":13,"arabic":"وَٱسْتَكْبَرُوا۟","translation":"and were arrogant","transliteration":"wa-is'takbarū"},{"position":14,"arabic":"ٱسْتِكْبَارًۭا","translation":"(with) pride","transliteration":"is'tik'bāran"}],"e3rab":"(وَإِنِّي) الواو حرف عطف وإن واسمها (كُلَّما دَعَوْتُهُمْ) كلما أداة شرط غير جازمة وماض وفاعله ومفعوله والجملة في محل جر بالإضافة (لِتَغْفِرَ) مضارع منصوب بأن مضمرة بعد لام التعليل والمصدر المؤول من أن المضمرة والفعل في محل جر باللام والجار والمجرور متعلقان بالفعل (لَهُمْ) متعلقان بالفعل تغفر (جَعَلُوا أَصابِعَهُمْ) ماض وفاعله ومفعوله (فِي آذانِهِمْ) متعلقان بالفعل وهما في موضع المفعول الثاني والجملة الفعلية جواب الشرط لا محل لها (وَاسْتَغْشَوْا) معطوف على جعلوا (ثِيابَهُمْ) مفعول به (وَأَصَرُّوا وَاسْتَكْبَرُوا) معطوف على استغشوا (اسْتِكْباراً) مفعول مطلق.\r\n\r\n"},{"sura":71,"ayah":8,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"إِنِّى","translation":"indeed, I","transliteration":"innī"},{"position":3,"arabic":"دَعَوْتُهُمْ","translation":"invited them","transliteration":"daʿawtuhum"},{"position":4,"arabic":"جِهَارًۭا","translation":"publicly","transliteration":"jihāran"}],"e3rab":"(ثُمَّ إِنِّي دَعَوْتُهُمْ) ثم حرف عطف وإن واسمها وماض وفاعله ومفعوله (جِهاراً) مفعول مطلق والجملة خبر إن والجملة الاسمية معطوفة على ما قبلها\r\n\r\n"},{"sura":71,"ayah":9,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"إِنِّىٓ","translation":"indeed, I","transliteration":"innī"},{"position":3,"arabic":"أَعْلَنتُ","translation":"announced","transliteration":"aʿlantu"},{"position":4,"arabic":"لَهُمْ","translation":"to them","transliteration":"lahum"},{"position":5,"arabic":"وَأَسْرَرْتُ","translation":"and I confided","transliteration":"wa-asrartu"},{"position":6,"arabic":"لَهُمْ","translation":"to them","transliteration":"lahum"},{"position":7,"arabic":"إِسْرَارًۭا","translation":"secretly","transliteration":"is'rāran"}],"e3rab":"(ثُمَّ) حرف عطف (إِنِّي أَعْلَنْتُ) إن واسمها وماض وفاعله والجملة خبر إن والجملة الاسمية معطوفة على ما قبلها (لَهُمْ) متعلقان بالفعل (وَأَسْرَرْتُ لَهُمْ) معطوف على أعلنت لهم (إِسْراراً) مفعول مطلق.\r\n\r\n"},{"sura":71,"ayah":10,"words":[{"position":1,"arabic":"فَقُلْتُ","translation":"Then I said","transliteration":"faqul'tu"},{"position":2,"arabic":"ٱسْتَغْفِرُوا۟","translation":"Ask forgiveness","transliteration":"is'taghfirū"},{"position":3,"arabic":"رَبَّكُمْ","translation":"(from) your Lord","transliteration":"rabbakum"},{"position":4,"arabic":"إِنَّهُۥ","translation":"Indeed, He","transliteration":"innahu"},{"position":5,"arabic":"كَانَ","translation":"is","transliteration":"kāna"},{"position":6,"arabic":"غَفَّارًۭا","translation":"Oft-Forgiving","transliteration":"ghaffāran"}],"e3rab":"(فَقُلْتُ) الفاء حرف استئناف وماض وفاعله والجملة مستأنفة لا محل لها (اسْتَغْفِرُوا) أمر مبني على حذف النون والواو فاعله (رَبَّكُمْ) مفعول به والجملة مقول القول (إِنَّهُ) إن اسمها (كانَ) ماض ناقص واسمها مستتر (غَفَّاراً) خبر كان والجملة الفعلية خبر إن والجملة الاسمية تعليل لا محل لها\r\n\r\n"},{"sura":71,"ayah":11,"words":[{"position":1,"arabic":"يُرْسِلِ","translation":"He will send down","transliteration":"yur'sili"},{"position":2,"arabic":"ٱلسَّمَآءَ","translation":"(rain from) the sky","transliteration":"l-samāa"},{"position":3,"arabic":"عَلَيْكُم","translation":"upon you","transliteration":"ʿalaykum"},{"position":4,"arabic":"مِّدْرَارًۭا","translation":"(in) abundance","transliteration":"mid'rāran"}],"e3rab":"(يُرْسِلِ) مضارع مجزوم لأنه جواب الطلب والفاعل مستتر (السَّماءَ) مفعول به (عَلَيْكُمْ) متعلقان بالفعل (مِدْراراً) حال والجملة جواب الطلب لا محل لها.\r\n\r\n"},{"sura":71,"ayah":12,"words":[{"position":1,"arabic":"وَيُمْدِدْكُم","translation":"And provide you","transliteration":"wayum'did'kum"},{"position":2,"arabic":"بِأَمْوَٰلٍۢ","translation":"with wealth","transliteration":"bi-amwālin"},{"position":3,"arabic":"وَبَنِينَ","translation":"and children","transliteration":"wabanīna"},{"position":4,"arabic":"وَيَجْعَل","translation":"and make","transliteration":"wayajʿal"},{"position":5,"arabic":"لَّكُمْ","translation":"for you","transliteration":"lakum"},{"position":6,"arabic":"جَنَّـٰتٍۢ","translation":"gardens","transliteration":"jannātin"},{"position":7,"arabic":"وَيَجْعَل","translation":"and make","transliteration":"wayajʿal"},{"position":8,"arabic":"لَّكُمْ","translation":"for you","transliteration":"lakum"},{"position":9,"arabic":"أَنْهَـٰرًۭا","translation":"rivers","transliteration":"anhāran"}],"e3rab":"(وَيُمْدِدْكُمْ) معطوف على يرسل والكاف مفعول به (بِأَمْوالٍ) متعلقان بالفعل (وَبَنِينَ) معطوف على أموال (وَيَجْعَلْ) معطوف على ما قبله (لَكُمْ) متعلقان بالفعل (جَنَّاتٍ) مفعول به (وَيَجْعَلْ لَكُمْ أَنْهاراً) كإعراب سابقه.\r\n\r\n"},{"sura":71,"ayah":13,"words":[{"position":1,"arabic":"مَّا","translation":"What","transliteration":"mā"},{"position":2,"arabic":"لَكُمْ","translation":"(is) for you","transliteration":"lakum"},{"position":3,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":4,"arabic":"تَرْجُونَ","translation":"you attribute","transliteration":"tarjūna"},{"position":5,"arabic":"لِلَّهِ","translation":"to Allah","transliteration":"lillahi"},{"position":6,"arabic":"وَقَارًۭا","translation":"grandeur","transliteration":"waqāran"}],"e3rab":"(ما) اسم استفهام مبتدأ (لَكُمْ) خبر والجملة مقول القول (لا تَرْجُونَ) لا نافية ومضارع وفاعله (لِلَّهِ) متعلقان بالفعل (وَقاراً) مفعول به والجملة الفعلية حال\r\n\r\n"},{"sura":71,"ayah":14,"words":[{"position":1,"arabic":"وَقَدْ","translation":"And indeed","transliteration":"waqad"},{"position":2,"arabic":"خَلَقَكُمْ","translation":"He created you","transliteration":"khalaqakum"},{"position":3,"arabic":"أَطْوَارًا","translation":"(in) stages","transliteration":"aṭwāran"}],"e3rab":"(وَ) الواو حالية (قَدْ خَلَقَكُمْ) حرف تحقيق وماض ومفعوله والفاعل مستتر (أَطْواراً) حال والجملة حالية.\r\n\r\n"},{"sura":71,"ayah":15,"words":[{"position":1,"arabic":"أَلَمْ","translation":"Do not","transliteration":"alam"},{"position":2,"arabic":"تَرَوْا۟","translation":"you see","transliteration":"taraw"},{"position":3,"arabic":"كَيْفَ","translation":"how","transliteration":"kayfa"},{"position":4,"arabic":"خَلَقَ","translation":"did create","transliteration":"khalaqa"},{"position":5,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":6,"arabic":"سَبْعَ","translation":"(the) seven","transliteration":"sabʿa"},{"position":7,"arabic":"سَمَـٰوَٰتٍۢ","translation":"heavens","transliteration":"samāwātin"},{"position":8,"arabic":"طِبَاقًۭا","translation":"(in) layers","transliteration":"ṭibāqan"}],"e3rab":"(أَلَمْ تَرَوْا) الهمزة حرف استفهام ومضارع مجزوم بلم والواو فاعله (كَيْفَ) اسم استفهام حال (خَلَقَ اللَّهُ سَبْعَ) ماض وفاعله ومفعوله (سَماواتٍ) مضاف إليه (طِباقاً) صفة سبع وجملة خلق سدت مسد مفعولي تروا.\r\n\r\n"},{"sura":71,"ayah":16,"words":[{"position":1,"arabic":"وَجَعَلَ","translation":"And made","transliteration":"wajaʿala"},{"position":2,"arabic":"ٱلْقَمَرَ","translation":"the moon","transliteration":"l-qamara"},{"position":3,"arabic":"فِيهِنَّ","translation":"therein","transliteration":"fīhinna"},{"position":4,"arabic":"نُورًۭا","translation":"a light","transliteration":"nūran"},{"position":5,"arabic":"وَجَعَلَ","translation":"and made","transliteration":"wajaʿala"},{"position":6,"arabic":"ٱلشَّمْسَ","translation":"the sun","transliteration":"l-shamsa"},{"position":7,"arabic":"سِرَاجًۭا","translation":"a lamp","transliteration":"sirājan"}],"e3rab":"(وَجَعَلَ) ماض فاعله مستتر (الْقَمَرَ) مفعول به أول (فِيهِنَّ) حال (نُوراً) مفعول به ثان والجملة معطوفة على ما قبلها وما بعده معطوف عليه.\r\n\r\n"},{"sura":71,"ayah":17,"words":[{"position":1,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":2,"arabic":"أَنۢبَتَكُم","translation":"has caused you to grow","transliteration":"anbatakum"},{"position":3,"arabic":"مِّنَ","translation":"from","transliteration":"mina"},{"position":4,"arabic":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":5,"arabic":"نَبَاتًۭا","translation":"(as) a growth","transliteration":"nabātan"}],"e3rab":"(وَاللَّهُ أَنْبَتَكُمْ) الواو حرف عطف ولفظ الجلالة مبتدأ وماض ومفعوله والفاعل مستتر والجملة الفعلية خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها (مِنَ الْأَرْضِ) متعلقان بالفعل (نَباتاً) مفعول مطلق\r\n\r\n"},{"sura":71,"ayah":18,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"يُعِيدُكُمْ","translation":"He will return you","transliteration":"yuʿīdukum"},{"position":3,"arabic":"فِيهَا","translation":"into it","transliteration":"fīhā"},{"position":4,"arabic":"وَيُخْرِجُكُمْ","translation":"and bring you forth","transliteration":"wayukh'rijukum"},{"position":5,"arabic":"إِخْرَاجًۭا","translation":"(a new) bringing forth","transliteration":"ikh'rājan"}],"e3rab":"(ثُمَّ يُعِيدُكُمْ) ثم حرف عطف ومضارع ومفعوله والفاعل مستتر (فِيها) متعلقان بالفعل والجملة معطوفة على ما قبلها (وَيُخْرِجُكُمْ) معطوف على يعيدكم (إِخْراجاً) مفعول مطلق.\r\n\r\n"},{"sura":71,"ayah":19,"words":[{"position":1,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":2,"arabic":"جَعَلَ","translation":"made","transliteration":"jaʿala"},{"position":3,"arabic":"لَكُمُ","translation":"for you","transliteration":"lakumu"},{"position":4,"arabic":"ٱلْأَرْضَ","translation":"the earth","transliteration":"l-arḍa"},{"position":5,"arabic":"بِسَاطًۭا","translation":"an expanse","transliteration":"bisāṭan"}],"e3rab":"(وَاللَّهُ جَعَلَ) لفظ الجلالة مبتدأ وماض فاعله مستتر (لَكُمُ) متعلقان بالفعل (الْأَرْضَ) مفعول به أول (بِساطاً) مفعول به ثان والجملة الفعلية خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها\r\n\r\n"},{"sura":71,"ayah":20,"words":[{"position":1,"arabic":"لِّتَسْلُكُوا۟","translation":"That you may go along","transliteration":"litaslukū"},{"position":2,"arabic":"مِنْهَا","translation":"therein","transliteration":"min'hā"},{"position":3,"arabic":"سُبُلًۭا","translation":"(in) paths","transliteration":"subulan"},{"position":4,"arabic":"فِجَاجًۭا","translation":"wide","transliteration":"fijājan"}],"e3rab":"(لِتَسْلُكُوا) مضارع منصوب بأن مضمرة بعد لام التعليل والواو فاعل والمصدر المؤول من أن المضمرة والفعل في محل جر باللام والجار والمجرور متعلقان بجعل (مِنْها) متعلقان بالفعل (سُبُلًا) مفعول به (فِجاجاً) صفة وتعني فجاجا واسعا.\r\n\r\n"},{"sura":71,"ayah":21,"words":[{"position":1,"arabic":"قَالَ","translation":"Said","transliteration":"qāla"},{"position":2,"arabic":"نُوحٌۭ","translation":"Nuh","transliteration":"nūḥun"},{"position":3,"arabic":"رَّبِّ","translation":"My Lord","transliteration":"rabbi"},{"position":4,"arabic":"إِنَّهُمْ","translation":"Indeed, they","transliteration":"innahum"},{"position":5,"arabic":"عَصَوْنِى","translation":"disobeyed me","transliteration":"ʿaṣawnī"},{"position":6,"arabic":"وَٱتَّبَعُوا۟","translation":"and followed","transliteration":"wa-ittabaʿū"},{"position":7,"arabic":"مَن","translation":"(the one) who","transliteration":"man"},{"position":8,"arabic":"لَّمْ","translation":"(did) not","transliteration":"lam"},{"position":9,"arabic":"يَزِدْهُ","translation":"increase him","transliteration":"yazid'hu"},{"position":10,"arabic":"مَالُهُۥ","translation":"his wealth","transliteration":"māluhu"},{"position":11,"arabic":"وَوَلَدُهُۥٓ","translation":"and his children","transliteration":"wawaladuhu"},{"position":12,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":13,"arabic":"خَسَارًۭا","translation":"(in) loss","transliteration":"khasāran"}],"e3rab":"(قالَ نُوحٌ) ماض وفاعله والجملة مستأنفة لا محل لها (رَبِّ) منادى مضاف إلى ياء المتكلم المحذوفة للتخفيف (إِنَّهُمْ عَصَوْنِي) إن واسمها وماض وفاعله والنون للوقاية والياء مفعول به والجملة خبر إن وجملة النداء وما بعدها مقول القول (وَاتَّبَعُوا) ماض وفاعله (مَنْ) مفعول به والجملة معط