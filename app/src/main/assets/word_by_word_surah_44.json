iteration":"sawāi"},{"position":5,"arabic":"ٱلْجَحِيمِ","translation":"(of) the Hellfire","transliteration":"l-jaḥīmi"}],"e3rab":"(خُذُوهُ) أمر مبني على حذف النون والواو فاعله والهاء مفعوله والجملة مقول قول محذوف (فَاعْتِلُوهُ) الفاء حرف عطف وفعل أمر معطوف على ما قبله (إِلى سَواءِ) متعلقان بالفعل (الْجَحِيمِ) مضاف إليه\r\n\r\n"},{"sura":44,"ayah":48,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"صُبُّوا۟","translation":"pour","transliteration":"ṣubbū"},{"position":3,"arabic":"فَوْقَ","translation":"over","transliteration":"fawqa"},{"position":4,"arabic":"رَأْسِهِۦ","translation":"his head","transliteration":"rasihi"},{"position":5,"arabic":"مِنْ","translation":"of","transliteration":"min"},{"position":6,"arabic":"عَذَابِ","translation":"(the) punishment","transliteration":"ʿadhābi"},{"position":7,"arabic":"ٱلْحَمِيمِ","translation":"(of) the scalding water","transliteration":"l-ḥamīmi"}],"e3rab":"(ثُمَّ) حرف عطف (صُبُّوا) أمر وفاعله (فَوْقَ) ظرف مكان (رَأْسِهِ) مضاف إليه (مِنْ عَذابِ) متعلقان بالفعل (الْحَمِيمِ) مضاف إليه والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":44,"ayah":49,"words":[{"position":1,"arabic":"ذُقْ","translation":"Taste","transliteration":"dhuq"},{"position":2,"arabic":"إِنَّكَ","translation":"Indeed, you","transliteration":"innaka"},{"position":3,"arabic":"أَنتَ","translation":"[you] (were)","transliteration":"anta"},{"position":4,"arabic":"ٱلْعَزِيزُ","translation":"the mighty","transliteration":"l-ʿazīzu"},{"position":5,"arabic":"ٱلْكَرِيمُ","translation":"the noble","transliteration":"l-karīmu"}],"e3rab":"(ذُقْ) أمر فاعله مستتر والجملة مقول قول محذوف (إِنَّكَ) إن واسمها (أَنْتَ) ضمير فصل (الْعَزِيزُ الْكَرِيمُ) خبران والجملة الاسمية تعليلية\r\n\r\n"},{"sura":44,"ayah":50,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"هَـٰذَا","translation":"this","transliteration":"hādhā"},{"position":3,"arabic":"مَا","translation":"(is) what","transliteration":"mā"},{"position":4,"arabic":"كُنتُم","translation":"you used to","transliteration":"kuntum"},{"position":5,"arabic":"بِهِۦ","translation":"[about it]","transliteration":"bihi"},{"position":6,"arabic":"تَمْتَرُونَ","translation":"doubt","transliteration":"tamtarūna"}],"e3rab":"(إِنَّ هذا) إن واسمها (ما) خبرها (كُنْتُمْ) كان واسمها والجملة صلة ما (بِهِ) متعلقان بتمترون (تَمْتَرُونَ) مضارع مرفوع والواو فاعله والجملة خبر كنتم وجملة إن هذا مقول قول مقدر\r\n\r\n"},{"sura":44,"ayah":51,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلْمُتَّقِينَ","translation":"the righteous","transliteration":"l-mutaqīna"},{"position":3,"arabic":"فِى","translation":"(will be) in","transliteration":"fī"},{"position":4,"arabic":"مَقَامٍ","translation":"a place","transliteration":"maqāmin"},{"position":5,"arabic":"أَمِينٍۢ","translation":"secure","transliteration":"amīnin"}],"e3rab":"(إِنَّ الْمُتَّقِينَ) إن واسمها (فِي مَقامٍ) متعلقان بمحذوف خبر إن.\r\n\r\n(أَمِينٍ) صفة.\r\n\r\n"},{"sura":44,"ayah":52,"words":[{"position":1,"arabic":"فِى","translation":"In","transliteration":"fī"},{"position":2,"arabic":"جَنَّـٰتٍۢ","translation":"gardens","transliteration":"jannātin"},{"position":3,"arabic":"وَعُيُونٍۢ","translation":"and springs","transliteration":"waʿuyūnin"}],"e3rab":"(فِي جَنَّاتٍ) بدل من في مقام.\r\n\r\n(وَعُيُونٍ) معطوف على ما قبله\r\n\r\n"},{"sura":44,"ayah":53,"words":[{"position":1,"arabic":"يَلْبَسُونَ","translation":"Wearing garments","transliteration":"yalbasūna"},{"position":2,"arabic":"مِن","translation":"of","transliteration":"min"},{"position":3,"arabic":"سُندُسٍۢ","translation":"fine silk","transliteration":"sundusin"},{"position":4,"arabic":"وَإِسْتَبْرَقٍۢ","translation":"and heavy silk","transliteration":"wa-is'tabraqin"},{"position":5,"arabic":"مُّتَقَـٰبِلِينَ","translation":"facing each other","transliteration":"mutaqābilīna"}],"e3rab":"(يَلْبَسُونَ) مضارع مرفوع والواو 