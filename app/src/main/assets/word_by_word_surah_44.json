[{"sura":44,"ayah":1,"words":[{"position":1,"arabic":"حمٓ","translation":"Ha Meem","transliteration":"hha-meem"}],"e3rab":"» تقدم إعراب مثيله\r\n\r\n"},{"sura":44,"ayah":2,"words":[{"position":1,"arabic":"وَٱلْكِتَـٰبِ","translation":"By the Book","transliteration":"wal-kitābi"},{"position":2,"arabic":"ٱلْمُبِينِ","translation":"the clear","transliteration":"l-mubīni"}],"e3rab":"» تقدم إعراب مثيله\r\n\r\n"},{"sura":44,"ayah":3,"words":[{"position":1,"arabic":"إِنَّآ","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"أَنزَلْنَـٰهُ","translation":"revealed it","transliteration":"anzalnāhu"},{"position":3,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":4,"arabic":"لَيْلَةٍۢ","translation":"a Night","transliteration":"laylatin"},{"position":5,"arabic":"مُّبَـٰرَكَةٍ ۚ","translation":"Blessed","transliteration":"mubārakatin"},{"position":6,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":7,"arabic":"كُنَّا","translation":"[We] are","transliteration":"kunnā"},{"position":8,"arabic":"مُنذِرِينَ","translation":"(ever) warning","transliteration":"mundhirīna"}],"e3rab":"إن واسمها (أَنْزَلْناهُ) ماض وفاعله ومفعوله والجملة خبر إن والجملة الاسمية مستأنفة (فِي لَيْلَةٍ) متعلقان بالفعل (مُبارَكَةٍ) صفة (إِنَّا) إن واسمها (كُنَّا) كان واسمها (مُنْذِرِينَ) خبرها والجملة الفعلية خبر إنا والجملة الاسمية مستأنفة\r\n\r\n"},{"sura":44,"ayah":4,"words":[{"position":1,"arabic":"فِيهَا","translation":"Therein","transliteration":"fīhā"},{"position":2,"arabic":"يُفْرَقُ","translation":"is made distinct","transliteration":"yuf'raqu"},{"position":3,"arabic":"كُلُّ","translation":"every","transliteration":"kullu"},{"position":4,"arabic":"أَمْرٍ","translation":"affair","transliteration":"amrin"},{"position":5,"arabic":"حَكِيمٍ","translation":"wise","transliteration":"ḥakīmin"}],"e3rab":"(فِيها) متعلقان بما بعدهما (يُفْرَقُ) مضارع مبني للمجهول (كُلُّ) نائب فاعل (أَمْرٍ) مضاف إليه (حَكِيمٍ) صفة أمر والجملة مستأنفة\r\n\r\n"},{"sura":44,"ayah":5,"words":[{"position":1,"arabic":"أَمْرًۭا","translation":"A command","transliteration":"amran"},{"position":2,"arabic":"مِّنْ","translation":"from","transliteration":"min"},{"position":3,"arabic":"عِندِنَآ ۚ","translation":"Us","transliteration":"ʿindinā"},{"position":4,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":5,"arabic":"كُنَّا","translation":"[We] are","transliteration":"kunnā"},{"position":6,"arabic":"مُرْسِلِينَ","translation":"(ever) sending","transliteration":"mur'silīna"}],"e3rab":"(أَمْراً) مفعول به لفعل محذوف (مِنْ عِنْدِنا) متعلقان بمحذوف صفة أمرا (إِنَّا) إن واسمها (كُنَّا مُرْسِلِينَ) كان واسمها وخبرها والجملة الفعلية خبر إنا والجملة الاسمية مستأنفة\r\n\r\n"},{"sura":44,"ayah":6,"words":[{"position":1,"arabic":"رَحْمَةًۭ","translation":"As Mercy","transliteration":"raḥmatan"},{"position":2,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":3,"arabic":"رَّبِّكَ ۚ","translation":"your Lord","transliteration":"rabbika"},{"position":4,"arabic":"إِنَّهُۥ","translation":"Indeed, He","transliteration":"innahu"},{"position":5,"arabic":"هُوَ","translation":"[He]","transliteration":"huwa"},{"position":6,"arabic":"ٱلسَّمِيعُ","translation":"(is) the All-Hearer","transliteration":"l-samīʿu"},{"position":7,"arabic":"ٱلْعَلِيمُ","translation":"the All-Knower","transliteration":"l-ʿalīmu"}],"e3rab":"(رَحْمَةً) مفعول لأجله منصوب (مِنْ رَبِّكَ) متعلقان برحمة (إِنَّهُ) إن واسمها (هُوَ) ضمير فصل (السَّمِيعُ الْعَلِيمُ) خبران لإن والجملة الاسمية تعليل\r\n\r\n"},{"sura":44,"ayah":7,"words":[{"position":1,"arabic":"رَبِّ","translation":"Lord","transliteration":"rabbi"},{"position":2,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"(of) the heavens","transliteration":"l-samāwāti"},{"position":3,"arabic":"وَٱلْأَرْضِ","translation":"and the earth","transliteration":"wal-arḍi"},{"position":4,"arabic":"وَمَا","translation":"and whatever","transliteration":"wamā"},{"position":5,"arabic":"بَيْنَهُمَآ ۖ","translation":"(is) between both of them","transliteration":"baynahumā"},{"position":6,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":7,"arabic":"كُنتُم","translation":"you are","transliteration":"kuntum"},{"position":8,"arabic":"مُّوقِنِينَ","translation":"certain","transliteration":"mūqinīna"}],"e3rab":"(رَبِّ) بدل من ربك (السَّماواتِ) مضاف إليه (وَالْأَرْضِ) معطوف على السموات (وَما) معطوف على ما قبله (بَيْنَهُما) ظرف مكان متعلق بمحذوف صلة الموصول (إِنْ) شرطية جازمة (كُنْتُمْ) كان واسمها (مُوقِنِينَ) خبرها وجملة كنتم ابتدائية\r\n\r\n"},{"sura":44,"ayah":8,"words":[{"position":1,"arabic":"لَآ","translation":"(There is) no","transliteration":"lā"},{"position":2,"arabic":"إِلَـٰهَ","translation":"god","transliteration":"ilāha"},{"position":3,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":4,"arabic":"هُوَ","translation":"Him","transliteration":"huwa"},{"position":5,"arabic":"يُحْىِۦ","translation":"He gives life","transliteration":"yuḥ'yī"},{"position":6,"arabic":"وَيُمِيتُ ۖ","translation":"and causes death","transliteration":"wayumītu"},{"position":7,"arabic":"رَبُّكُمْ","translation":"your Lord","transliteration":"rabbukum"},{"position":8,"arabic":"وَرَبُّ","translation":"and (the) Lord","transliteration":"warabbu"},{"position":9,"arabic":"ءَابَآئِكُمُ","translation":"(of) your fathers","transliteration":"ābāikumu"},{"position":10,"arabic":"ٱلْأَوَّلِينَ","translation":"the former","transliteration":"l-awalīna"}],"e3rab":"(لا) نافية تعمل عمل إن (إِلهَ) اسمها وخبرها محذوف (إِلَّا) حرف حصر (هُوَ) بدل من اسم لا (يُحْيِي) مضارع مرفوع فاعله مستتر والجملة حال (وَيُمِيتُ) معطوف على يحيي (رَبُّكُمْ) بدل (وَرَبُّ) معطوف (آبائِكُمُ) مضاف إليه (الْأَوَّلِينَ) صفة\r\n\r\n"},{"sura":44,"ayah":9,"words":[{"position":1,"arabic":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":2,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":3,"arabic":"فِى","translation":"(are) in","transliteration":"fī"},{"position":4,"arabic":"شَكٍّۢ","translation":"doubt ","transliteration":"shakkin"},{"position":5,"arabic":"يَلْعَبُونَ","translation":"playing","transliteration":"yalʿabūna"}],"e3rab":"(بَلْ) حرف إضراب (هُمْ) مبتدأ (فِي شَكٍّ) متعلقان بمحذوف خبر (يَلْعَبُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية حال والجملة الاسمية مستأنفة\r\n\r\n"},{"sura":44,"ayah":10,"words":[{"position":1,"arabic":"فَٱرْتَقِبْ","translation":"Then watch","transliteration":"fa-ir'taqib"},{"position":2,"arabic":"يَوْمَ","translation":"(for the) Day","transliteration":"yawma"},{"position":3,"arabic":"تَأْتِى","translation":"(when) will bring","transliteration":"tatī"},{"position":4,"arabic":"ٱلسَّمَآءُ","translation":"the sky","transliteration":"l-samāu"},{"position":5,"arabic":"بِدُخَانٍۢ","translation":"smoke","transliteration":"bidukhānin"},{"position":6,"arabic":"مُّبِينٍۢ","translation":"visible","transliteration":"mubīnin"}],"e3rab":"(فَارْتَقِبْ) الفاء الفصيحة وأمر فاعله مستتر (يَوْمَ) مفعول به والجملة جواب شرط غير جازم (تَأْتِي) مضارع (السَّماءُ) فاعل (بِدُخانٍ) متعلقان بالفعل (مُبِينٍ) صفة والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":44,"ayah":11,"words":[{"position":1,"arabic":"يَغْشَى","translation":"Enveloping","transliteration":"yaghshā"},{"position":2,"arabic":"ٱلنَّاسَ ۖ","translation":"the people","transliteration":"l-nāsa"},{"position":3,"arabic":"هَـٰذَا","translation":"This","transliteration":"hādhā"},{"position":4,"arabic":"عَذَابٌ","translation":"(will be) a punishment","transliteration":"ʿadhābun"},{"position":5,"arabic":"أَلِيمٌۭ","translation":"painful","transliteration":"alīmun"}],"e3rab":"(يَغْشَى) مضارع فاعله مستتر (النَّاسَ) مفعول به والجملة صفة دخان (هذا عَذابٌ) مبتدأ وخبره (أَلِيمٌ) صفة عذاب والجملة الاسمية مقول قول محذوف\r\n\r\n"},{"sura":44,"ayah":12,"words":[{"position":1,"arabic":"رَّبَّنَا","translation":"Our Lord","transliteration":"rabbanā"},{"position":2,"arabic":"ٱكْشِفْ","translation":"Remove","transliteration":"ik'shif"},{"position":3,"arabic":"عَنَّا","translation":"from us","transliteration":"ʿannā"},{"position":4,"arabic":"ٱلْعَذَابَ","translation":"the punishment","transliteration":"l-ʿadhāba"},{"position":5,"arabic":"إِنَّا","translation":"indeed, we","transliteration":"innā"},{"position":6,"arabic":"مُؤْمِنُونَ","translation":"(are) believers","transliteration":"mu'minūna"}],"e3rab":"(رَبَّنَا) منادى مضاف (اكْشِفْ) فعل دعاء فاعله مستتر (عَنَّا) متعلقان بالفعل (الْعَذابَ) مفعول به وجملة ربنا مقول قول محذوف (إِنَّا) إن واسمها (مُؤْمِنُونَ) خبرها والجملة الاسمية تعليلية\r\n\r\n"},{"sura":44,"ayah":13,"words":[{"position":1,"arabic":"أَنَّىٰ","translation":"How can","transliteration":"annā"},{"position":2,"arabic":"لَهُمُ","translation":"(there be) for them","transliteration":"lahumu"},{"position":3,"arabic":"ٱلذِّكْرَىٰ","translation":"the reminder","transliteration":"l-dhik'rā"},{"position":4,"arabic":"وَقَدْ","translation":"when verily","transliteration":"waqad"},{"position":5,"arabic":"جَآءَهُمْ","translation":"had come to them","transliteration":"jāahum"},{"position":6,"arabic":"رَسُولٌۭ","translation":"a Messenger","transliteration":"rasūlun"},{"position":7,"arabic":"مُّبِينٌۭ","translation":"clear","transliteration":"mubīnun"}],"e3rab":"(أَنَّى) اسم استفهام في محل رفع خبر مقدم (لَهُمُ) متعلقان بمحذوف خبر ثان (الذِّكْرى) مبتدأ مؤخر والجملة الاسمية مقول قول محذوف (وَقَدْ) الواو حالية وقد حرف تحقيق (جاءَهُمْ) ماض ومفعوله (رَسُولٌ) فاعل مؤخر (مُبِينٌ) صفة رسول والجملة حالية\r\n\r\n"},{"sura":44,"ayah":14,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"تَوَلَّوْا۟","translation":"they turned away","transliteration":"tawallaw"},{"position":3,"arabic":"عَنْهُ","translation":"from him","transliteration":"ʿanhu"},{"position":4,"arabic":"وَقَالُوا۟","translation":"and said","transliteration":"waqālū"},{"position":5,"arabic":"مُعَلَّمٌۭ","translation":"One taught","transliteration":"muʿallamun"},{"position":6,"arabic":"مَّجْنُونٌ","translation":"a mad man","transliteration":"majnūnun"}],"e3rab":"(ثُمَّ) حرف عطف (تَوَلَّوْا) ماض وفاعله والجملة معطوفة على ما قبلها (عَنْهُ) متعلقان بالفعل (وَقالُوا) الواو حرف عطف وقالوا معطوف على تولوا (مُعَلَّمٌ) خبر لمبتدأ محذوف (مَجْنُونٌ) خبر ثان والجملة الاسمية مقول القول\r\n\r\n"},{"sura":44,"ayah":15,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"كَاشِفُوا۟","translation":"(will) remove","transliteration":"kāshifū"},{"position":3,"arabic":"ٱلْعَذَابِ","translation":"the punishment","transliteration":"l-ʿadhābi"},{"position":4,"arabic":"قَلِيلًا ۚ","translation":"a little","transliteration":"qalīlan"},{"position":5,"arabic":"إِنَّكُمْ","translation":"indeed, you","transliteration":"innakum"},{"position":6,"arabic":"عَآئِدُونَ","translation":"(will) return","transliteration":"ʿāidūna"}],"e3rab":"(إِنَّا) إن واسمها (كاشِفُوا) خبرها (الْعَذابِ) مضاف إليه والجملة الاسمية مستأنفة (قَلِيلًا) صفة مفعول مطلق محذوف (إِنَّكُمْ عائِدُونَ) إن واسمها وخبرها والجملة الاسمية مستأنفة\r\n\r\n"},{"sura":44,"ayah":16,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"نَبْطِشُ","translation":"We will seize","transliteration":"nabṭishu"},{"position":3,"arabic":"ٱلْبَطْشَةَ","translation":"(with) the seizure","transliteration":"l-baṭshata"},{"position":4,"arabic":"ٱلْكُبْرَىٰٓ","translation":"the greatest","transliteration":"l-kub'rā"},{"position":5,"arabic":"إِنَّا","translation":"indeed, We","transliteration":"innā"},{"position":6,"arabic":"مُنتَقِمُونَ","translation":"(will) take retribution","transliteration":"muntaqimūna"}],"e3rab":"(يَوْمَ) مفعول به لفعل محذوف (نَبْطِشُ) مضارع فاعله مستتر (الْبَطْشَةَ) مفعول به (الْكُبْرى) صفة البطشة والجملة في محل جر بالإضافة (إِنَّا) إن واسمها (مُنْتَقِمُونَ) خبرها والجملة مستأنفة\r\n\r\n"},{"sura":44,"ayah":17,"words":[{"position":1,"arabic":"۞ وَلَقَدْ","translation":"And certainly","transliteration":"walaqad"},{"position":2,"arabic":"فَتَنَّا","translation":"We tried","transliteration":"fatannā"},{"position":3,"arabic":"قَبْلَهُمْ","translation":"before them","transliteration":"qablahum"},{"position":4,"arabic":"قَوْمَ","translation":"(the) people","transliteration":"qawma"},{"position":5,"arabic":"فِرْعَوْنَ","translation":"(of) Firaun","transliteration":"fir'ʿawna"},{"position":6,"arabic":"وَجَآءَهُمْ","translation":"and came to them","transliteration":"wajāahum"},{"position":7,"arabic":"رَسُولٌۭ","translation":"a Messenger","transliteration":"rasūlun"},{"position":8,"arabic":"كَرِيمٌ","translation":"noble","transliteration":"karīmun"}],"e3rab":"(وَلَقَدْ) الواو حرف قسم وجر والمقسم به محذوف واللام واقعة في جواب القسم وقد حرف تحقيق (فَتَنَّا) ماض وفاعله والجملة جواب القسم لا محل لها (قَبْلَهُمْ) ظرف زمان (قَوْمَ) مفعول به (فِرْعَوْنَ) مضاف إليه (وَجاءَهُمْ) الواو حرف عطف وماض ومفعوله (رَسُولٌ) فاعل مؤخر (كَرِيمٌ) صفة رسول والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":44,"ayah":18,"words":[{"position":1,"arabic":"أَنْ","translation":"That","transliteration":"an"},{"position":2,"arabic":"أَدُّوٓا۟","translation":"Deliver","transliteration":"addū"},{"position":3,"arabic":"إِلَىَّ","translation":"to me","transliteration":"ilayya"},{"position":4,"arabic":"عِبَادَ","translation":"(the) servants","transliteration":"ʿibāda"},{"position":5,"arabic":"ٱللَّهِ ۖ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":6,"arabic":"إِنِّى","translation":"Indeed, I am","transliteration":"innī"},{"position":7,"arabic":"لَكُمْ","translation":"to you","transliteration":"lakum"},{"position":8,"arabic":"رَسُولٌ","translation":"a Messenger","transliteration":"rasūlun"},{"position":9,"arabic":"أَمِينٌۭ","translation":"trustworthy","transliteration":"amīnun"}],"e3rab":"(أَنْ) تفسيرية (أَدُّوا) أمر وفاعله والجملة تفسيرية لا محل لها (إِلَيَّ) متعلقان بالفعل (عِبادَ) مفعول به (اللَّهِ) لفظ الجلالة مضاف إليه (إِنِّي) إن واسمها (لَكُمْ) متعلقان بمحذوف حال (رَسُولٌ) خبر إن (أَمِينٌ) صفة والجملة الاسمية تعليلية.\r\n\r\n"},{"sura":44,"ayah":19,"words":[{"position":1,"arabic":"وَأَن","translation":"And that","transliteration":"wa-an"},{"position":2,"arabic":"لَّا","translation":"(do) not","transliteration":"lā"},{"position":3,"arabic":"تَعْلُوا۟","translation":"exalt yourselves","transliteration":"taʿlū"},{"position":4,"arabic":"عَلَى","translation":"against","transliteration":"ʿalā"},{"position":5,"arabic":"ٱللَّهِ ۖ","translation":"Allah","transliteration":"l-lahi"},{"position":6,"arabic":"إِنِّىٓ","translation":"Indeed, I","transliteration":"innī"},{"position":7,"arabic":"ءَاتِيكُم","translation":"[I] have come to you","transliteration":"ātīkum"},{"position":8,"arabic":"بِسُلْطَـٰنٍۢ","translation":"with an authority","transliteration":"bisul'ṭānin"},{"position":9,"arabic":"مُّبِينٍۢ","translation":"clear","transliteration":"mubīnin"}],"e3rab":"(وَأَنْ) الواو حرف عطف وأن معطوفة على ما قبلها (لا تَعْلُوا) مضارع مجزوم بلا الناهية وعلامة جزمه حذف النون والواو فاعل (عَلَى اللَّهِ) متعلقان بالفعل (إِنِّي) إن واسمها (آتِيكُمْ) خبر والجملة الاسمية تعليل (بِسُلْطانٍ) متعلقان بآتيكم (مُبِينٍ) صفة\r\n\r\n"},{"sura":44,"ayah":20,"words":[{"position":1,"arabic":"وَإِنِّى","translation":"And indeed, I","transliteration":"wa-innī"},{"position":2,"arabic":"عُذْتُ","translation":"[I] seek refuge","transliteration":"ʿudh'tu"},{"position":3,"arabic":"بِرَبِّى","translation":"with my Lord","transliteration":"birabbī"},{"position":4,"arabic":"وَرَبِّكُمْ","translation":"and your Lord","transliteration":"warabbikum"},{"position":5,"arabic":"أَن","translation":"lest","transliteration":"an"},{"position":6,"arabic":"تَرْجُمُونِ","translation":"you stone me","transliteration":"tarjumūni"}],"e3rab":"(وَ إِنِّي) الواو حالية وإن واسمها (عُذْتُ) ماض وفاعله والجملة الفعلية خبر إن والجملة الاسمية حالية (بِرَبِّي) متعلقان بالفعل (وَ رَبِّكُمْ) معطوف على بربي (أَنْ تَرْجُمُونِ) مضارع منصوب بأن وعلامة نصبه حذف النون لأنه من الأفعال الخمسة والواو فاعله والنون للوقاية وياء المتكلم المحذوفة مفعول به والمصدر المؤول من أن والفعل في محل جر بحرف جر محذوف والجار والمجرور متعلقان بالفعل عذت\r\n\r\n"},{"sura":44,"ayah":21,"words":[{"position":1,"arabic":"وَإِن","translation":"And if","transliteration":"wa-in"},{"position":2,"arabic":"لَّمْ","translation":"not","transliteration":"lam"},{"position":3,"arabic":"تُؤْمِنُوا۟","translation":"you believe","transliteration":"tu'minū"},{"position":4,"arabic":"لِى","translation":"me","transliteration":"lī"},{"position":5,"arabic":"فَٱعْتَزِلُونِ","translation":"then leave me alone","transliteration":"fa-iʿ'tazilūni"}],"e3rab":"(وَ إِنْ) الواو حرف عطف وإن شرطية جازمة (لَمْ) حرف جازم (تُؤْمِنُوا) مضارع مجزوم بلم وعلامة جزمه حذف النون والواو فاعله والجملة لا محل لها لأنها ابتدائية (لِي) متعلقان بالفعل (فَاعْتَزِلُونِ) الفاء واقعة في جواب الشرط وأمر مبني على حذف النون والواو فاعله والنون للوقاية وياء المتكلم المحذوفة مفعول به والجملة في محل جزم جواب الشرط\r\n\r\n"},{"sura":44,"ayah":22,"words":[{"position":1,"arabic":"فَدَعَا","translation":"So he called","transliteration":"fadaʿā"},{"position":2,"arabic":"رَبَّهُۥٓ","translation":"his Lord","transliteration":"rabbahu"},{"position":3,"arabic":"أَنَّ","translation":"That","transliteration":"anna"},{"position":4,"arabic":"هَـٰٓؤُلَآءِ","translation":"these","transliteration":"hāulāi"},{"position":5,"arabic":"قَوْمٌۭ","translation":"(are) a people","transliteration":"qawmun"},{"position":6,"arabic":"مُّجْرِمُونَ","translation":"criminals","transliteration":"muj'rimūna"}],"e3rab":"(فَدَعا) الفاء حرف عطف وماض فاعله مستتر (رَبَّهُ) مفعول به والجملة معطوفة على جملة مقدرة (أَنَّ هؤُلاءِ قَوْمٌ) أن واسمها وخبرها (مُجْرِمُونَ) صفة قوم والمصدر المؤول من أن وما بعدها في محل نصب بنزع الخافض والجار والمجرور متعلقان بالفعل دعا\r\n\r\n"},{"sura":44,"ayah":23,"words":[{"position":1,"arabic":"فَأَسْرِ","translation":"Then \"Set out","transliteration":"fa-asri"},{"position":2,"arabic":"بِعِبَادِى","translation":"with My slaves","transliteration":"biʿibādī"},{"position":3,"arabic":"لَيْلًا","translation":"(by) night","transliteration":"laylan"},{"position":4,"arabic":"إِنَّكُم","translation":"Indeed, you","transliteration":"innakum"},{"position":5,"arabic":"مُّتَّبَعُونَ","translation":"(will be) followed","transliteration":"muttabaʿūna"}],"e3rab":"(فَأَسْرِ) الفاء الفصيحة وأمر مبني على حذف حرف العلة فاعله مستتر والجملة في محل جزم جواب شرط مقدر (بِعِبادِي) متعلقان بالفعل (لَيْلًا) ظرف زمان (إِنَّكُمْ مُتَّبَعُونَ) إن واسمها وخبرها والجملة الاسمية تعليل\r\n\r\n"},{"sura":44,"ayah":24,"words":[{"position":1,"arabic":"وَٱتْرُكِ","translation":"And leave","transliteration":"wa-ut'ruki"},{"position":2,"arabic":"ٱلْبَحْرَ","translation":"the sea","transliteration":"l-baḥra"},{"position":3,"arabic":"رَهْوًا ۖ","translation":"at rest","transliteration":"rahwan"},{"position":4,"arabic":"إِنَّهُمْ","translation":"Indeed, they","transliteration":"innahum"},{"position":5,"arabic":"جُندٌۭ","translation":"(are) an army","transliteration":"jundun"},{"position":6,"arabic":"مُّغْرَقُونَ","translation":"(to be) drowned","transliteration":"mugh'raqūna"}],"e3rab":"(وَ اتْرُكِ الْبَحْرَ) حرف عطف وأمر ومفعوله والفاعل مستتر (رَهْواً) حال والجملة معطوفة على ما قبلها (إِنَّهُمْ جُنْدٌ) إن واسمها وخبرها (مُغْرَقُونَ) صفة جند والجملة الاسمية تعليل\r\n\r\n"},{"sura":44,"ayah":25,"words":[{"position":1,"arabic":"كَمْ","translation":"How many","transliteration":"kam"},{"position":2,"arabic":"تَرَكُوا۟","translation":"(did) they leave","transliteration":"tarakū"},{"position":3,"arabic":"مِن","translation":"of","transliteration":"min"},{"position":4,"arabic":"جَنَّـٰتٍۢ","translation":"gardens","transliteration":"jannātin"},{"position":5,"arabic":"وَعُيُونٍۢ","translation":"and springs","transliteration":"waʿuyūnin"}],"e3rab":"(كَمْ) خبرية في محل نصب مفعول به مقدم (تَرَكُوا) ماض وفاعله (مِنْ جَنَّاتٍ) متعلقان بمحذوف حال (وَعُيُونٍ) معطوف على جنات.\r\n\r\n"},{"sura":44,"ayah":26,"words":[{"position":1,"arabic":"وَزُرُوعٍۢ","translation":"And cornfields","transliteration":"wazurūʿin"},{"position":2,"arabic":"وَمَقَامٍۢ","translation":"and places","transliteration":"wamaqāmin"},{"position":3,"arabic":"كَرِيمٍۢ","translation":"noble","transliteration":"karīmin"}],"e3rab":"(وَ زُرُوعٍ وَمَقامٍ) معطوفان على جنات (كَرِيمٍ) صفة مقام\r\n\r\n"},{"sura":44,"ayah":27,"words":[{"position":1,"arabic":"وَنَعْمَةٍۢ","translation":"And pleasant things","transliteration":"wanaʿmatin"},{"position":2,"arabic":"كَانُوا۟","translation":"they used to","transliteration":"kānū"},{"position":3,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":4,"arabic":"فَـٰكِهِينَ","translation":"take delight","transliteration":"fākihīna"}],"e3rab":"(وَ نَعْمَةٍ) معطوف على ما قبله (كانُوا) كان واسمها (فِيها) متعلقان بفاكهين (فاكِهِينَ) خبر كانوا والجملة الفعلية صفة نعمة\r\n\r\n"},{"sura":44,"ayah":28,"words":[{"position":1,"arabic":"كَذَٰلِكَ ۖ","translation":"Thus","transliteration":"kadhālika"},{"position":2,"arabic":"وَأَوْرَثْنَـٰهَا","translation":"And We made it (an) inherit(ance)","transliteration":"wa-awrathnāhā"},{"position":3,"arabic":"قَوْمًا","translation":"(for) a people","transliteration":"qawman"},{"position":4,"arabic":"ءَاخَرِينَ","translation":"another","transliteration":"ākharīna"}],"e3rab":"(كَذلِكَ) جار ومجرور متعلقان بمحذوف صفة لمفعول مطلق محذوف (وَ أَوْرَثْناها) الواو حرف عطف وماض وفاعله ومفعوله الأول والجملة معطوفة على ما قبلها (قَوْماً) مفعول به ثان (آخَرِينَ) صفة\r\n\r\n"},{"sura":44,"ayah":29,"words":[{"position":1,"arabic":"فَمَا","translation":"And not","transliteration":"famā"},{"position":2,"arabic":"بَكَتْ","translation":"wept","transliteration":"bakat"},{"position":3,"arabic":"عَلَيْهِمُ","translation":"for them","transliteration":"ʿalayhimu"},{"position":4,"arabic":"ٱلسَّمَآءُ","translation":"the heaven","transliteration":"l-samāu"},{"position":5,"arabic":"وَٱلْأَرْضُ","translation":"and the earth","transliteration":"wal-arḍu"},{"position":6,"arabic":"وَمَا","translation":"and not","transliteration":"wamā"},{"position":7,"arabic":"كَانُوا۟","translation":"they were","transliteration":"kānū"},{"position":8,"arabic":"مُنظَرِينَ","translation":"given respite","transliteration":"munẓarīna"}],"e3rab":"(فَما) الفاء استئنافية وما نافية (بَكَتْ) ماض (عَلَيْهِمُ) متعلقان بالفعل (السَّماءُ) فاعل (وَ الْأَرْضُ) معطوف على السماء والجملة مستأنفة (وَ ما) الواو حرف عطف وما نافية (كانُوا مُنْظَرِينَ) كان واسمها وخبرها والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":44,"ayah":30,"words":[{"position":1,"arabic":"وَلَقَدْ","translation":"And certainly","transliteration":"walaqad"},{"position":2,"arabic":"نَجَّيْنَا","translation":"We saved","transliteration":"najjaynā"},{"position":3,"arabic":"بَنِىٓ","translation":"(the) Children of Israel","transliteration":"banī"},{"position":4,"arabic":"إِسْرَٰٓءِيلَ","translation":"(the) Children of Israel","transliteration":"is'rāīla"},{"position":5,"arabic":"مِنَ","translation":"from","transliteration":"mina"},{"position":6,"arabic":"ٱلْعَذَابِ","translation":"the punishment","transliteration":"l-ʿadhābi"},{"position":7,"arabic":"ٱلْمُهِينِ","translation":"the humiliating","transliteration":"l-muhīni"}],"e3rab":"(وَ لَقَدْ) الواو استئنافية واللام واقعة في جواب القسم وقد حرف تحقيق (نَجَّيْنا) ماض وفاعله (بَنِي) مفعول به منصوب بالياء (إِسْرائِيلَ) مضاف إليه وجملة نجينا جواب القسم لا محل لها والكلام مستأنف (مِنَ الْعَذابِ) متعلقان بنجينا (الْمُهِينِ) صفة\r\n\r\n"},{"sura":44,"ayah":31,"words":[{"position":1,"arabic":"مِن","translation":"From","transliteration":"min"},{"position":2,"arabic":"فِرْعَوْنَ ۚ","translation":"Firaun","transliteration":"fir'ʿawna"},{"position":3,"arabic":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":4,"arabic":"كَانَ","translation":"was","transliteration":"kāna"},{"position":5,"arabic":"عَالِيًۭا","translation":"arrogant","transliteration":"ʿāliyan"},{"position":6,"arabic":"مِّنَ","translation":"among","transliteration":"mina"},{"position":7,"arabic":"ٱلْمُسْرِفِينَ","translation":"the transgressors","transliteration":"l-mus'rifīna"}],"e3rab":"(مِنْ فِرْعَوْنَ) بدل من قوله من العذاب (إِنَّهُ) إن واسمها (كانَ عالِياً) كان وخبرها واسمها مستتر والجملة الفعلية خبر إن (مِنَ الْمُسْرِفِينَ) متعلقان بمحذوف خبر ثان والجملة الاسمية تعليل\r\n\r\n"},{"sura":44,"ayah":32,"words":[{"position":1,"arabic":"وَلَقَدِ","translation":"And certainly","transliteration":"walaqadi"},{"position":2,"arabic":"ٱخْتَرْنَـٰهُمْ","translation":"We chose them","transliteration":"ikh'tarnāhum"},{"position":3,"arabic":"عَلَىٰ","translation":"by","transliteration":"ʿalā"},{"position":4,"arabic":"عِلْمٍ","translation":"knowledge","transliteration":"ʿil'min"},{"position":5,"arabic":"عَلَى","translation":"over","transliteration":"ʿalā"},{"position":6,"arabic":"ٱلْعَـٰلَمِينَ","translation":"the worlds","transliteration":"l-ʿālamīna"}],"e3rab":"(وَ لَقَدِ اخْتَرْناهُمْ) انظر الآية رقم 30 من السورة (عَلى عِلْمٍ) متعلقان بمحذوف حال (عَلَى الْعالَمِينَ) متعلقان بالفعل\r\n\r\n"},{"sura":44,"ayah":33,"words":[{"position":1,"arabic":"وَءَاتَيْنَـٰهُم","translation":"And We gave them","transliteration":"waātaynāhum"},{"position":2,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":3,"arabic":"ٱلْـَٔايَـٰتِ","translation":"the Signs","transliteration":"l-āyāti"},{"position":4,"arabic":"مَا","translation":"that","transliteration":"mā"},{"position":5,"arabic":"فِيهِ","translation":"in it","transliteration":"fīhi"},{"position":6,"arabic":"بَلَـٰٓؤٌۭا۟","translation":"(was) a trial","transliteration":"balāon"},{"position":7,"arabic":"مُّبِينٌ","translation":"clear","transliteration":"mubīnun"}],"e3rab":"(وَ آتَيْناهُمْ) الواو حرف عطف وماض وفاعله ومفعوله الأول والجملة معطوفة على ما قبلها (مِنَ الْآياتِ) متعلقان بالفعل (ما) مفعول به ثان (فِيهِ) متعلقان بمحذوف خبر مقدم (بَلؤُا) مبتدأ مؤخر والجملة صلة (مُبِينٌ) صفة بلاء\r\n\r\n"},{"sura":44,"ayah":34,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"هَـٰٓؤُلَآءِ","tra