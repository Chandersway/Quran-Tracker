[{"sura":51,"ayah":1,"words":[{"position":1,"arabic":"وَٱلذَّٰرِيَـٰتِ","translation":"By those scattering","transliteration":"wal-dhāriyāti"},{"position":2,"arabic":"ذَرْوًۭا","translation":"dispersing","transliteration":"dharwan"}],"e3rab":"(وَالذَّارِياتِ) الواو حرف قسم وجر والذاريات مقسم به مجرور والجار والمجرور متعلقان بفعل قسم محذوف (ذَرْواً) مفعول مطلق والجملة ابتدائية لا محل لها\r\n\r\n"},{"sura":51,"ayah":2,"words":[{"position":1,"arabic":"فَٱلْحَـٰمِلَـٰتِ","translation":"And those carrying","transliteration":"fal-ḥāmilāti"},{"position":2,"arabic":"وِقْرًۭا","translation":"a load","transliteration":"wiq'ran"}],"e3rab":"(فَالْحامِلاتِ) معطوف على الذاريات (وِقْراً) مفعول به لاسم الفاعل\r\n\r\n"},{"sura":51,"ayah":3,"words":[{"position":1,"arabic":"فَٱلْجَـٰرِيَـٰتِ","translation":"And those sailing","transliteration":"fal-jāriyāti"},{"position":2,"arabic":"يُسْرًۭا","translation":"(with) ease","transliteration":"yus'ran"}],"e3rab":"(فَالْجارِياتِ) معطوف على ما قبله (يُسْراً) حال\r\n\r\n"},{"sura":51,"ayah":4,"words":[{"position":1,"arabic":"فَٱلْمُقَسِّمَـٰتِ","translation":"And those distributing","transliteration":"fal-muqasimāti"},{"position":2,"arabic":"أَمْرًا","translation":"Command","transliteration":"amran"}],"e3rab":"(فَالْمُقَسِّماتِ) معطوف على ما قبله (أَمْراً) مفعول به لاسم الفاعل\r\n\r\n"},{"sura":51,"ayah":5,"words":[{"position":1,"arabic":"إِنَّمَا","translation":"Indeed, what","transliteration":"innamā"},{"position":2,"arabic":"تُوعَدُونَ","translation":"you are promised","transliteration":"tūʿadūna"},{"position":3,"arabic":"لَصَادِقٌۭ","translation":"(is) surely true","transliteration":"laṣādiqun"}],"e3rab":"(إِنَّما) إن حرف مشبه بالفعل وما اسمها (تُوعَدُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة صلة (لَصادِقٌ) اللام المزحلقة وصادق خبر إن والجملة الاسمية جواب القسم لا محل لها\r\n\r\n"},{"sura":51,"ayah":6,"words":[{"position":1,"arabic":"وَإِنَّ","translation":"And indeed","transliteration":"wa-inna"},{"position":2,"arabic":"ٱلدِّينَ","translation":"the Judgment","transliteration":"l-dīna"},{"position":3,"arabic":"لَوَٰقِعٌۭ","translation":"(is) surely to occur","transliteration":"lawāqiʿun"}],"e3rab":"(وَإِنَّ) الواو حرف عطف وإن حرف مشبه بالفعل (الدِّينَ) اسمها (لَواقِعٌ) اللام المزحلقة وواقع خبر إن والجملة معطوفة\r\n\r\n"},{"sura":51,"ayah":7,"words":[{"position":1,"arabic":"وَٱلسَّمَآءِ","translation":"By the heaven","transliteration":"wal-samāi"},{"position":2,"arabic":"ذَاتِ","translation":"full of","transliteration":"dhāti"},{"position":3,"arabic":"ٱلْحُبُكِ","translation":"pathways","transliteration":"l-ḥubuki"}],"e3rab":"(وَالسَّماءِ) الواو حرف قسم وجر والسماء مجرور والجار والمجرور متعلقان بفعل محذوف تقديره أقسم (ذاتِ) صفة السماء (الْحُبُكِ) مضاف إليه\r\n\r\n"},{"sura":51,"ayah":8,"words":[{"position":1,"arabic":"إِنَّكُمْ","translation":"Indeed, you","transliteration":"innakum"},{"position":2,"arabic":"لَفِى","translation":"(are) surely in","transliteration":"lafī"},{"position":3,"arabic":"قَوْلٍۢ","translation":"a speech","transliteration":"qawlin"},{"position":4,"arabic":"مُّخْتَلِفٍۢ","translation":"differing","transliteration":"mukh'talifin"}],"e3rab":"(إِنَّكُمْ) إن واسمها (لَفِي قَوْلٍ) اللام المزحلقة وجار ومجرور متعلقان بمحذوف خبر إن (مُخْتَلِفٍ) صفة قول والجملة الاسمية جواب القسم لا محل لها\r\n\r\n"},{"sura":51,"ayah":9,"words":[{"position":1,"arabic":"يُؤْفَكُ","translation":"Deluded away","transliteration":"yu'faku"},{"position":2,"arabic":"عَنْهُ","translation":"from it","transliteration":"ʿanhu"},{"position":3,"arabic":"مَنْ","translation":"(is he) who","transliteration":"man"},{"position":4,"arabic":"أُفِكَ","translation":"is deluded","transliteration":"ufika"}],"e3rab":"(يُؤْفَكُ) مضارع مبني للمجهول (عَنْهُ) متعلقان بالفعل (مَنْ) نائب فاعل (أُفِكَ) ماض مبني للمجهول ونائب الفاعل مستتر والجملة صلة من وجملة يؤفك مستأنفة\r\n\r\n"},{"sura":51,"ayah":10,"words":[{"position":1,"arabic":"قُتِلَ","translation":"Cursed be","transliteration":"qutila"},{"position":2,"arabic":"ٱلْخَرَّٰصُونَ","translation":"the liars","transliteration":"l-kharāṣūna"}],"e3rab":"(قُتِلَ) ماض مبني للمجهو (الْخَرَّاصُونَ) نائب فاعل مرفوع بالواو والجملة مستأنفة\r\n\r\n"},{"sura":51,"ayah":11,"words":[{"position":1,"arabic":"ٱلَّذِينَ","translation":"Those who","transliteration":"alladhīna"},{"position":2,"arabic":"هُمْ","translation":"[they]","transliteration":"hum"},{"position":3,"arabic":"فِى","translation":"(are) in","transliteration":"fī"},{"position":4,"arabic":"غَمْرَةٍۢ","translation":"flood","transliteration":"ghamratin"},{"position":5,"arabic":"سَاهُونَ","translation":"(of) heedlessness","transliteration":"sāhūna"}],"e3rab":"(الَّذِينَ) بدل من الخراصون (هُمْ) مبتدأ (فِي غَمْرَةٍ) متعلقان بما بعدهما (ساهُونَ) خبر والجملة الاسمية صلة الذين لا محل لها\r\n\r\n"},{"sura":51,"ayah":12,"words":[{"position":1,"arabic":"يَسْـَٔلُونَ","translation":"They ask","transliteration":"yasalūna"},{"position":2,"arabic":"أَيَّانَ","translation":"When","transliteration":"ayyāna"},{"position":3,"arabic":"يَوْمُ","translation":"(is the) Day","transliteration":"yawmu"},{"position":4,"arabic":"ٱلدِّينِ","translation":"(of) Judgment","transliteration":"l-dīni"}],"e3rab":"(يَسْئَلُونَ) مضارع مرفوع والواو فاعله (أَيَّانَ) اسم استفهام في محل نصب على الظرفية الزمانية متعلق بمحذوف خبر مقدم (يَوْمُ) مبتدأ مؤخر (الدِّينِ) مضاف إليه والجملة الاسمية سدت مسد مفعولي يسألون والجملة الفعلية مستأنفة.\r\n\r\n"},{"sura":51,"ayah":13,"words":[{"position":1,"arabic":"يَوْمَ","translation":"A Day","transliteration":"yawma"},{"position":2,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":3,"arabic":"عَلَى","translation":"over","transliteration":"ʿalā"},{"position":4,"arabic":"ٱلنَّارِ","translation":"the Fire","transliteration":"l-nāri"},{"position":5,"arabic":"يُفْتَنُونَ","translation":"will be tried","transliteration":"yuf'tanūna"}],"e3rab":"(يَوْمَ) ظرف زمان (هُمْ) مبتدأ (عَلَى النَّارِ) متعلقان ما بعدهما (يُفْتَنُونَ) مضارع مبني للمجهول والواو نائب والجملة الفعلية خبر هم والجملة الاسمية في محل جر بالإضافة\r\n\r\n"},{"sura":51,"ayah":14,"words":[{"position":1,"arabic":"ذُوقُوا۟","translation":"Taste","transliteration":"dhūqū"},{"position":2,"arabic":"فِتْنَتَكُمْ","translation":"your trial","transliteration":"fit'natakum"},{"position":3,"arabic":"هَـٰذَا","translation":"This","transliteration":"hādhā"},{"position":4,"arabic":"ٱلَّذِى","translation":"(is) what","transliteration":"alladhī"},{"position":5,"arabic":"كُنتُم","translation":"you were","transliteration":"kuntum"},{"position":6,"arabic":"بِهِۦ","translation":"for it","transliteration":"bihi"},{"position":7,"arabic":"تَسْتَعْجِلُونَ","translation":"seeking to hasten","transliteration":"tastaʿjilūna"}],"e3rab":"(ذُوقُوا) أمر مبني على حذف النون والواو فاعله والجملة مقول قول محذوف (فِتْنَتَكُمْ) مفعول به (هذَا) مبتدأ (الَّذِي) خبره والجملة الاسمية تعليل (كُنْتُمْ) كان واسمها (بِهِ) متعلقان بما بعدهما (تَسْتَعْجِلُونَ) مضارع مرفوع والواو فاعله والجملة خبر كنتم وجملة كنتم صلة الذي لا محل لها\r\n\r\n"},{"sura":51,"ayah":15,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلْمُتَّقِينَ","translation":"the righteous","transliteration":"l-mutaqīna"},{"position":3,"arabic":"فِى","translation":"(will be) in","transliteration":"fī"},{"position":4,"arabic":"جَنَّـٰتٍۢ","translation":"Gardens","transliteration":"jannātin"},{"position":5,"arabic":"وَعُيُونٍ","translation":"and springs","transliteration":"waʿuyūnin"}],"e3rab":"(إِنَّ الْمُتَّقِينَ) إن واسمها (فِي جَنَّاتٍ) خبرها (وَعُيُونٍ) معطوف على جنات\r\n\r\n"},{"sura":51,"ayah":16,"words":[{"position":1,"arabic":"ءَاخِذِينَ","translation":"Taking","transliteration":"ākhidhīna"},{"position":2,"arabic":"مَآ","translation":"what","transliteration":"mā"},{"position":3,"arabic":"ءَاتَىٰهُمْ","translation":"their Lord has given them","transliteration":"ātāhum"},{"position":4,"arabic":"رَبُّهُمْ ۚ","translation":"their Lord has given them","transliteration":"rabbuhum"},{"position":5,"arabic":"إِنَّهُمْ","translation":"Indeed, they","transliteration":"innahum"},{"position":6,"arabic":"كَانُوا۟","translation":"were","transliteration":"kānū"},{"position":7,"arabic":"قَبْلَ","translation":"before","transliteration":"qabla"},{"position":8,"arabic":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":9,"arabic":"مُحْسِنِينَ","translation":"good-doers","transliteration":"muḥ'sinīna"}],"e3rab":"(آخِذِينَ) حال (ما) مفعول به لآخذين (آتاهُمْ) ماض ومفعوله (رَبُّهُمْ) فاعله والجملة مستأنفة (إِنَّهُمْ) إن واسمها (كانُوا) كان واسمها والجملة الفعلية خبر إن (قَبْلَ) ظرف زمان (ذلِكَ) مضاف إليه (مُحْسِنِينَ) خبر كانوا والجملة الاسمية تعليل\r\n\r\n"},{"sura":51,"ayah":17,"words":[{"position":1,"arabic":"كَانُوا۟","translation":"They used to","transliteration":"kānū"},{"position":2,"arabic":"قَلِيلًۭا","translation":"little","transliteration":"qalīlan"},{"position":3,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":4,"arabic":"ٱلَّيْلِ","translation":"the night","transliteration":"al-layli"},{"position":5,"arabic":"مَا","translation":"[what]","transliteration":"mā"},{"position":6,"arabic":"يَهْجَعُونَ","translation":"sleep","transliteration":"yahjaʿūna"}],"e3rab":"(كانُوا) كان واسمها (قَلِيلًا) صفة مفعول مطلق محذوف (مِنَ اللَّيْلِ) متعلقان بقليلا (ما) زائدة (يَهْجَعُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر كانوا وجملة كانوا بدل من سابقتها\r\n\r\n"},{"sura":51,"ayah":18,"words":[{"position":1,"arabic":"وَبِٱلْأَسْحَارِ","translation":"And in the hours before dawn","transliteration":"wabil-asḥāri"},{"position":2,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":3,"arabic":"يَسْتَغْفِرُونَ","translation":"would ask forgiveness","transliteration":"yastaghfirūna"}],"e3rab":"(وَبِالْأَسْحارِ) الواو حرف عطف وبالأسحار متعلقان بيستغفرون (هُمْ) مبتدأ (يَسْتَغْفِرُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر المبتدأ\r\n\r\n"},{"sura":51,"ayah":19,"words":[{"position":1,"arabic":"وَفِىٓ","translation":"And in","transliteration":"wafī"},{"position":2,"arabic":"أَمْوَٰلِهِمْ","translation":"their wealth","transliteration":"amwālihim"},{"position":3,"arabic":"حَقٌّۭ","translation":"(was the) right","transliteration":"ḥaqqun"},{"position":4,"arabic":"لِّلسَّآئِلِ","translation":"(of) those who asked","transliteration":"lilssāili"},{"position":5,"arabic":"وَٱلْمَحْرُومِ","translation":"and the deprived","transliteration":"wal-maḥrūmi"}],"e3rab":"(وَفِي أَمْوالِهِمْ) متعلقان بمحذوف خبر مقدم (حَقٌّ) مبتدأ مؤخر (لِلسَّائِلِ) متعلقان بحق (وَالْمَحْرُومِ) معطوف على السائل والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":51,"ayah":20,"words":[{"position":1,"arabic":"وَفِى","translation":"And in","transliteration":"wafī"},{"position":2,"arabic":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":3,"arabic":"ءَايَـٰتٌۭ","translation":"(are) signs","transliteration":"āyātun"},{"position":4,"arabic":"لِّلْمُوقِنِينَ","translation":"for those who are certain","transliteration":"lil'mūqinīna"}],"e3rab":"(وَفِي الْأَرْضِ) متعلقان بمحذوف خبر مقدم (آياتٌ) مبتدأ مؤخر (لِلْمُوقِنِينَ) متعلقان بمحذوف صفة آيات والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":51,"ayah":21,"words":[{"position":1,"arabic":"وَفِىٓ","translation":"And in","transliteration":"wafī"},{"position":2,"arabic":"أَنفُسِكُمْ ۚ","translation":"yourselves","transliteration":"anfusikum"},{"position":3,"arabic":"أَفَلَا","translation":"Then will not","transliteration":"afalā"},{"position":4,"arabic":"تُبْصِرُونَ","translation":"you see","transliteration":"tub'ṣirūna"}],"e3rab":"(وَفِي أَنْفُسِكُمْ) الواو حرف عطف وفي أنفسكم متعلقان بمحذوف خبر لمبتدأ محذوف تقديره آيات (أَفَلا) الهمزة للاستفهام والفاء حرف استئناف ولا نافية (تُبْصِرُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية مستأنفة\r\n\r\n"},{"sura":51,"ayah":22,"words":[{"position":1,"arabic":"وَفِى","translation":"And in","transliteration":"wafī"},{"position":2,"arabic":"ٱلسَّمَآءِ","translation":"the heaven","transliteration":"l-samāi"},{"position":3,"arabic":"رِزْقُكُمْ","translation":"(is) your provision","transliteration":"riz'qukum"},{"position":4,"arabic":"وَمَا","translation":"and what","transliteration":"wamā"},{"position":5,"arabic":"تُوعَدُونَ","translation":"you are promised","transliteration":"tūʿadūna"}],"e3rab":"(وَفِي السَّماءِ) الواو حرف عطف وفي السماء خبر مقدم (رِزْقُكُمْ) مبتدأ مؤخر والجملة معطوفة على ما قبلها (وَما) معطوفة على رزقكم (تُوعَدُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة صلة ما لا محل لها\r\n\r\n"},{"sura":51,"ayah":23,"words":[{"position":1,"arabic":"فَوَرَبِّ","translation":"Then by (the) Lord","transliteration":"fawarabbi"},{"position":2,"arabic":"ٱلسَّمَآءِ","translation":"(of) the heaven","transliteration":"l-samāi"},{"position":3,"arabic":"وَٱلْأَرْضِ","translation":"and the earth","transliteration":"wal-arḍi"},{"position":4,"arabic":"إِنَّهُۥ","translation":"indeed, it","transliteration":"innahu"},{"position":5,"arabic":"لَحَقٌّۭ","translation":"(is) surely (the) truth","transliteration":"laḥaqqun"},{"position":6,"arabic":"مِّثْلَ","translation":"(just) as","transliteration":"mith'la"},{"position":7,"arabic":"مَآ","translation":"[what]","transliteration":"mā"},{"position":8,"arabic":"أَنَّكُمْ","translation":"you","transliteration":"annakum"},{"position":9,"arabic":"تَنطِقُونَ","translation":"speak","transliteration":"tanṭiqūna"}],"e3rab":"(فَوَ رَبِّ) الفاء حرف استئناف والواو حرف قسم وجر ورب مجرور بالواو (السَّماءِ) مضاف إليه (وَالْأَرْضِ) معطوف على السماء (إِنَّهُ) إن واسمها (لَحَقٌّ) اللام المزحلقة وحق خبرها والجملة الاسمية جواب القسم لا محل لها (مِثْلَ) حال منصوبة (ما) زائدة (أَنَّكُمْ) أن واسمها (تَنْطِقُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر أن والجملة الاسمية في محل جر بالإضافة\r\n\r\n"},{"sura":51,"ayah":24,"words":[{"position":1,"arabic":"هَلْ","translation":"Has","transliteration":"hal"},{"position":2,"arabic":"أَتَىٰكَ","translation":"reached you","transliteration":"atāka"},{"position":3,"arabic":"حَدِيثُ","translation":"(the) narration","transliteration":"ḥadīthu"},{"position":4,"arabic":"ضَيْفِ","translation":"(of the) guests","transliteration":"ḍayfi"},{"position":5,"arabic":"إِبْرَٰهِيمَ","translation":"(of) Ibrahim","transliteration":"ib'rāhīma"},{"position":6,"arabic":"ٱلْمُكْرَمِينَ","translation":"the honored","transliteration":"l-muk'ramīna"}],"e3rab":"(هَلْ) حرف استفهام (أَتاكَ) ماض ومفعوله (حَدِيثُ) فاعله (ضَيْفِ) مضاف إليه (إِبْراهِيمَ) مضاف إليه (الْمُكْرَمِينَ) صفة ضيف والجملة مستأنفة\r\n\r\n"},{"sura":51,"ayah":25,"words":[{"position":1,"arabic":"إِذْ","translation":"When","transliteration":"idh"},{"position":2,"arabic":"دَخَلُوا۟","translation":"they entered","transliteration":"dakhalū"},{"position":3,"arabic":"عَلَيْهِ","translation":"upon him","transliteration":"ʿalayhi"},{"position":4,"arabic":"فَقَالُوا۟","translation":"and said","transliteration":"faqālū"},{"position":5,"arabic":"سَلَـٰمًۭا ۖ","translation":"Peace","transliteration":"salāman"},{"position":6,"arabic":"قَالَ","translation":"He said","transliteration":"qāla"},{"position":7,"arabic":"سَلَـٰمٌۭ","translation":"Peace","transliteration":"salāmun"},{"position":8,"arabic":"قَوْمٌۭ","translation":"a people","transliteration":"qawmun"},{"position":9,"arabic":"مُّنكَرُونَ","translation":"unknown","transliteration":"munkarūna"}],"e3rab":"(إِذْ) ظرف زمان (دَخَلُوا) ماض وفاعله والجملة في محل جر بالإضافة (عَلَيْهِ) متعلقان بالفعل (فَقالُوا) الفاء حرف عطف وماض وفاعله (سَلاماً) مفعول مطلق والجملة معطوفة على ما قبلها (قالَ) ماض فاعله مستتر (سَلامٌ) مبتدأ خبره محذوف والجملة الاسمية مقول القول (قَوْمٌ) خبر لمبتدأ محذوف (مُنْكَرُونَ) صفة قوم والجملة الاسمية مقول القول\r\n\r\n"},{"sura":51,"ayah":26,"words":[{"position":1,"arabic":"فَرَاغَ","translation":"Then he went","transliteration":"farāgha"},{"position":2,"arabic":"إِلَىٰٓ","translation":"to","transliteration":"ilā"},{"position":3,"arabic":"أَهْلِهِۦ","translation":"his household","transliteration":"ahlihi"},{"position":4,"arabic":"فَجَآءَ","translation":"and came","transliteration":"fajāa"},{"position":5,"arabic":"بِعِجْلٍۢ","translation":"with a calf","transliteration":"biʿij'lin"},{"position":6,"arabic":"سَمِينٍۢ","translation":"fat","transliteration":"samīnin"}],"e3rab":"(فَراغَ) الفاء حرف عطف وماض فاعله مستتر (إِلى أَهْلِهِ) متعلقان بالفعل (فَجاءَ) ماض فاعله مستتر (بِعِجْلٍ) متعلقان بالفعل (سَمِينٍ) صفة عجل والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":51,"ayah":27,"words":[{"position":1,"arabic":"فَقَرَّبَهُۥٓ","translation":"And he placed it near","transliteration":"faqarrabahu"},{"position":2,"arabic":"إِلَيْهِمْ","translation":"[to] them","transliteration":"ilayhim"},{"position":3,"arabic":"قَالَ","translation":"he said","transliteration":"qāla"},{"position":4,"arabic":"أَلَا","translation":"Will not","transliteration":"alā"},{"position":5,"arabic":"تَأْكُلُونَ","translation":"you eat","transliteration":"takulūna"}],"e3rab":"(فَقَرَّبَهُ) الفاء حرف عطف وماض فاعله مستتر (إِلَيْهِمْ) متعلقان بالفعل (قالَ) ماض فاعله مستتر (أَلا) حرف تحضيض (تَأْكُلُونَ) مضارع مرفوع والواو فاعله والجملة مقول القول وجملة قال حالية.\r\n\r\n"},{"sura":51,"ayah":28,"words":[{"position":1,"arabic":"فَأَوْجَسَ","translation":"Then he felt","transliteration":"fa-awjasa"},{"position":2,"arabic":"مِنْهُمْ","translation":"from them","transliteration":"min'hum"},{"position":3,"arabic":"خِيفَةًۭ ۖ","translation":"a fear","transliteration":"khīfatan"},{"position":4,"arabic":"قَالُوا۟","translation":"They said","transliteration":"qālū"},{"position":5,"arabic":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":6,"arabic":"تَخَفْ ۖ","translation":"fear","transliteration":"takhaf"},{"position":7,"arabic":"وَبَشَّرُوهُ","translation":"and they gave him glad tidings","transliteration":"wabasharūhu"},{"position":8,"arabic":"بِغُلَـٰمٍ","translation":"of a son","transliteration":"bighulāmin"},{"position":9,"arabic":"عَلِيمٍۢ","translation":"learned","transliteration":"ʿalīmin"}],"e3rab":"(فَأَوْجَسَ) الفاء حرف استئناف وماض فاعله مستتر (مِنْهُمْ) متعلقان بالفعل (خِيفَةً) مفعول به والجملة مستأنفة (قالُوا) ماض وفاعله والجملة مستأنفة (لا تَخَفْ) مضارع مجزوم بلا والفاعل مستتر والجملة مقول القول (وَبَشَّرُوهُ) ماض وفاعله ومفعوله والجملة معطوفة على قالوا (بِغُلامٍ) متعلقان بالفعل (عَلِيمٍ) صفة\r\n\r\n"},{"sura":51,"ayah":29,"words":[{"position":1,"arabic":"فَأَقْبَلَتِ","translation":"Then came forward","transliteration":"fa-aqbalati"},{"position":2,"arabic":"ٱمْرَأَتُهُۥ","translation":"his wife","transliteration":"im'ra-atuhu"},{"position":3,"arabic":"فِى","translation":"with","transliteration":"fī"},{"position":4,"arabic":"صَرَّةٍۢ","translation":"a loud voice","transliteration":"ṣarratin"},{"position":5,"arabic":"فَصَكَّتْ","translation":"and struck","transliteration":"faṣakkat"},{"position":6,"arabic":"وَجْهَهَا","translation":"her face","transliteration":"wajhahā"},{"position":7,"arabic":"وَقَالَتْ","translation":"and she said","transliteration":"waqālat"},{"position":8,"arabic":"عَجُوزٌ","translation":"An old woman","transliteration":"ʿajūzun"},{"position":9,"arabic":"عَقِيمٌۭ","translation":"barren","transliteration":"ʿaqīmun"}],"e3rab":"(فَأَقْبَلَتِ) حرف عطف وماض (امْرَأَتُهُ) فاعل (فِي صَرَّةٍ) متعلقان بمحذوف حال (فَصَكَّتْ) حرف عطف وماض (وَجْهَها) مفعول به والجملة معطوفة على أقبلت (وَقالَتْ) ماض فاعله مستتر والجملة معطوفة على ما قبلها (عَجُوزٌ) خبر لمبتدأ محذوف (عَقِيمٌ) صفة عجوز والجملة الاسمية مقول القول\r\n\r\n"},{"sura":51,"ayah":30,"words":[{"position":1,"arabic":"قَالُوا۟","translation":"They said","transliteration":"qālū"},{"position":2,"arabic":"كَذَٰلِكِ","translation":"Thus","transliteration":"kadhāliki"},{"position":3,"arabic":"قَالَ","translation":"said","transliteration":"qāla"},{"position":4,"arabic":"رَبُّكِ ۖ","translation":"your Lord","transliteration":"rabbuki"},{"position":5,"arabic":"إِنَّهُۥ","translation":"Indeed, He","transliteration":"innahu"},{"position":6,"arabic":"هُوَ","translation":"[He]","transliteration":"huwa"},{"position":7,"arabic":"ٱلْحَكِيمُ","translation":"(is) the All-Wise","transliteration":"l-ḥakīmu"},{"position":8,"arabic":"ٱلْعَلِيمُ","translation":"the All-Knower","transliteration":"l-ʿalīmu"}],"e3rab":"(قالُوا) ماض وفاعله والجملة مستأنفة (كَذلِكَ) جار ومجرور متعلقان بمحذوف صفة لمفعول مطلق محذوف (قالَ رَبُّكِ) ماض وفاعله والجملة مقول القول (إِنَّهُ) إن واسمها (هُوَ) ضمير فصل (الْحَكِيمُ الْعَلِيمُ) خبران والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":51,"ayah":31,"words":[{"position":1,"arabic":"۞ قَالَ","translation":"He said","transliteration":"qāla"},{"position":2,"arabic":"فَمَا","translation":"Then what","transliteration":"famā"},{"position":3,"arabic":"خَطْبُكُمْ","translation":"(is) your mission","transliteration":"khaṭbukum"},{"position":4,"arabic":"أَيُّهَا","translation":"O messengers","transliteration":"ayyuhā"},{"position":5,"arabic":"ٱلْمُرْسَلُونَ","translation":"O messengers","transliteration":"l-mur'salūna"}],"e3rab":"(قالَ) ماض فاعله مستتر والجملة مستأنفة (فَما) الفاء الفصيحة وما اسم استفهام مبتدأ (خَطْبُكُمْ) خبر والجملة مقول القول (أَيُّهَا) منادى (الْمُرْسَلُونَ) بدل من أي وجملة قال مستأنفة\r\n\r\n"},{"sura":51,"ayah":32,"words":[{"position":1,"arabic":"قَالُوٓا۟","translation":"They said","transliteration":"qālū"},{"position":2,"arabic":"إِنَّآ","translation":"Indeed, we","transliteration":"innā"},{"position":3,"arabic":"أُرْسِلْنَآ","translation":"[we] have been sent","transliteration":"ur'sil'nā"},{"position":4,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":5,"arabic":"قَوْمٍۢ","translation":"a people","transliteration":"qawmin"},{"position":6,"arabic":"مُّجْرِمِينَ","translation":"criminal","transliteration":"muj'rimīna"}],"e3rab":"(قالُوا) ماض وفاعله والجملة مستأنفة (إِنَّا) إن واسمها (أُرْسِلْنا) ماض مبني للمجهول ونا نائب فاعل والجملة خبر إن (إِلى قَوْمٍ) متعلقان بالفعل (مُجْرِمِينَ) صفة والجملة الاسمية مقول القول\r\n\r\n"},{"sura":51,"ayah":33,"words":[{"position":1,"arabic":"لِنُرْسِلَ","translation":"That we may send down","transliteration":"linur'sila"},{"position":2,"arabic":"عَلَيْهِمْ","translation":"upon them","transliteration":"ʿalayhim"},{"position":3,"arabic":"حِجَارَةًۭ","translation":"stones","transliteration":"ḥijāratan"},{"position":4,"arabic":"مِّن","translation":"of","transliteration":"min"},{"position":5,"arabic":"طِينٍۢ","translation":"clay","transliteration":"ṭīnin"}],"e3rab":"(لِنُرْسِلَ) مضارع منصوب بأن مضمرة بعد لام التعليل والفاعل مستتر (عَلَيْهِمْ) متعلقان بالفعل (حِجارَةً) مفعول به (مِنْ طِينٍ) متعلقان بمحذوف صفة حجارة والمصدر المؤول من أن ما وبعدها في محل جر باللام والجار والمجرور متعلقان بأرسلنا.\r\n\r\n"},{"sura":51,"ayah":34,"words":[{"position":1,"arabic":"مُّسَوَّمَةً","translation":"Marked","transliteration":"musawwamatan"},{"position":2,"arabic":"عِندَ","translation":"by your Lord","transliteration":"ʿinda"},{"position":3,"arabic":"رَبِّكَ","translation":"by your Lord","transliteration":"rabbika"},{"position":4,"arabic":"لِلْمُسْرِفِينَ","translation":"for the transgressors","transliteration":"lil'mus'rifīna"}],"e3rab":"(مُسَوَّمَةً) صفة ثانية لحجارة (عِنْدَ) ظرف مكان (رَبِّكَ) مضاف إليه (لِلْمُسْرِفِينَ) متعلقان بمسومة\r\n\r\n"},{"sura":51,"ayah":35,"words":[{"position":1,"arabic":"فَأَخْرَجْنَا","translation":"Then We brought out","transliteration":"fa-akhrajnā"},{"position":2,"arabic":"مَن","translation":"(those) who","transliteration":"man"},{"position":3,"arabic":"كَانَ","translation":"were","transliteration":"kāna"},{"position":4,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":5,"arabic":"مِنَ","translation":"of","transliteration":"mina"},{"position":6,"arabic":"ٱلْمُؤْمِنِينَ","translation":"the believers","transliteration":"l-mu'minīna"}],"e3rab":"(فَأَخْرَجْنا) الفاء حرف استئناف وماض وفاعله (مَنْ) مفعوله والجملة مستأنفة (كانَ) ماض ناقص واسمه محذوف (فِيها) متعلقان بمحذوف خبر كان (مِنَ الْمُؤْمِنِينَ) متعلقان بمحذوف حال وجملة كان صلة من\r\n\r\n"},{"sura":51,"ayah":36,"words":[{"position":1,"arabic":"فَمَا","translation":"But not","transliteration":"famā"},{"position":2,"arabic":"وَجَدْنَا","translation":"We found","transliteration":"wajadnā"},{"position":3,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":4,"arabic":"غَيْرَ","translation":"other than","transliteration":"ghayra"},{"position":5,"arabic":"بَيْتٍۢ","translation":"a house","transliteration":"baytin"},{"position":6,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":7,"arabic":"ٱلْمُسْلِمِينَ","translation":"the Muslims","transliteration":"l-mus'limīna"}],"e3rab":"(فَما) الفاء حرف عطف وما نافية (وَجَدْنا) ماض وفاعله (فِيها) متعلقان بالفعل (غَيْرَ) مفعول به (بَيْتٍ) مضاف إليه (مِنَ الْمُسْلِمِينَ) صفة بيت والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":51,"ayah":37,"words":[{"position":1,"arabic":"وَتَرَكْنَا","translation":"And We left","transliteration":"wataraknā"},{"position":2,"arabic":"فِيهَآ","translation":"therein","transliteration":"fīhā"},{"position":3,"arabic":"ءَايَةًۭ","translation":"a Sign","transliteration":"āyatan"},{"position":4,"arabic":"لِّلَّذِينَ","translation":"for those who","transliteration":"lilladhīna"},{"position":5,"arabic":"يَخَافُونَ","translation":"fear","transliteration":"yakhāfūna"},{"position":6,"arabic":"ٱلْعَذَابَ","translation":"the punishment","transliteration":"l-ʿadhāba"},{"position":7,"arabic":"ٱلْأَلِيمَ","translation":"the painful","transliteration":"l-alīma"}],"e3rab":"(وَتَرَكْنا) حرف عطف وماض وفاعله (فِيها) متعلقان بالفعل (آيَةً) مفعول به (لِلَّذِينَ) متعلقان بمحذوف صفة آية (يَخافُونَ) مضارع مرفوع والواو فاعله (الْعَذابَ) مفعول به (الْأَلِيمَ) صفة وجملة يخافون صلة الذين\r\n\r\n"},{"sura":51,"ayah":38,"words":[{"position":1,"arabic":"وَفِى","translation":"And in","transliteration":"wafī"},{"position":2,"arabic":"مُوسَىٰٓ","translation":"Musa","transliteration":"mūsā"},{"position":3,"arabic":"إِذْ","translation":"when","transliteration":"idh"},{"position":4,"arabic":"أَرْسَلْنَـٰهُ","translation":"We sent him","transliteration":"arsalnāhu"},{"position":5,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":6,"arabic":"فِرْعَوْنَ","translation":"Firaun","transliteration":"fir'ʿawna"},{"position":7,"arabic":"بِسُلْطَـٰنٍۢ","translation":"with an authority","transliteration":"bisul'ṭānin"},{"position":8,"arabic":"مُّبِينٍۢ","translation":"clear","transliteration":"mubīnin"}],"e3rab":"(وَفِي مُوسى) الواو حرف عطف والجار والمجرور معطوفان على فيها (إِذْ) ظرف زمان (أَرْسَلْناهُ) ماض وفاعله ومفعوله والجملة في محل جر بالإضافة (إِلى فِرْعَوْنَ) متعلقان بالفعل (بِسُلْطانٍ) متعلقان بالفعل أيضا (مُبِينٍ) صفة\r\n\r\n"},{"sura":51,"ayah":39,"words":[{"position":1,"arabic":"فَتَوَلَّىٰ","translation":"But he turned away","transliteration":"fatawallā"},{"position":2,"arabic":"بِرُكْنِهِۦ","translation":"with his supporters","transliteration":"biruk'nihi"},{"position":3,"arabic":"وَقَالَ","translation":"and said","transliteration":"waqāla"},{"position":4,"arabic":"سَـٰحِرٌ","translation":"A magician","transliteration":"sāḥirun"},{"position":5,"arabic":"أَوْ","translation":"or","transliteration":"aw"},{"position":6,"arabic":"مَجْنُونٌۭ","translation":"a madman","transliteration":"majnūnun"}],"e3rab":"(فَتَوَلَّى) الفاء حرف عطف وماض فاعله مستتر (بِرُكْنِهِ) متعلقان بالفعل (وَقالَ) ماض فاعله مستتر والجملة معطوفة على ما قبلها (ساحِرٌ) خبر لمبتدأ محذوف (أَوْ) حرف عطف (مَجْنُونٌ) معطوف على ساحر والجملة مقول القول.\r\n\r\n"},{"sura":51,"ayah":40,"words":[{"position":1,"arabic":"فَأَخَذْنَـٰهُ","translation":"So We took him","transliteration":"fa-akhadhnāhu"},{"position":2,"arabic":"وَجُنُودَهُۥ","translation":"and his hosts","transliteration":"wajunūdahu"},{"position":3,"arabic":"فَنَبَذْنَـٰهُمْ","translation":"and threw them","transliteration":"fanabadhnāhum"},{"position":4,"arabic":"فِى","translation":"into","transliteration":"fī"},{"position":5,"arabic":"ٱلْيَمِّ","translation":"the sea","transliteration":"l-yami"},{"position":6,"arabic":"وَهُوَ","translation":"while he","transliteration":"wahuwa"},{"position":7,"arabic":"مُلِيمٌۭ","translation":"(was) blameworthy","transliteration":"mulīmun"}],"e3rab":"(فَأَخَذْناهُ) حرف عطف وماض وفاعله ومفعوله والجملة معطوفة على ما قبلها.\r\n\r\n(وَجُنُودَهُ) معطوف على الضمير فهو منصوب مثله.\r\n\r\n(فَنَبَذْناهُمْ) حرف عطف وماض وفاعله ومفعوله والجملة معطوفة على ما قبلها.\r\n\r\n(فِي الْيَمِّ) متعلقان بالفعل.\r\n\r\n(وَهُوَ) الواو حالية ومبتدأ (مُلِيمٌ) خبره والجملة حال\r\n\r\n"},{"sura":51,"ayah":41,"words":[{"position":1,"arabic":"وَفِى","translation":"And in","transliteration":"wafī"},{"position":2,"arabic":"عَادٍ","translation":"Aad","transliteration":"ʿādin"},{"position":3,"arabic":"إِذْ","translation":"when","transliteration":"idh"},{"position":4,"arabic":"أَرْسَلْنَا","translation":"We sent","transliteration":"arsalnā"},{"position":5,"arabic":"عَلَيْهِمُ","translation":"against them","transliteration":"ʿalayhimu"},{"position":6,"arabic":"ٱلرِّيحَ","translation":"the wind","transliteration":"l-rīḥa"},{"position":7,"arabic":"ٱلْعَقِيمَ","translation":"the barren","transliteration":"l-ʿaqīma"}],"e3rab":"(وَفِي عادٍ إِذْ أَرْسَلْنا) سبق إعرابه (عَلَيْهِمُ) متعلقان بالفعل (الرِّيحَ) مفعول به (الْعَقِيمَ) صفة\r\n\r\n"},{"sura":51,"ayah":42,"words":[{"position":1,"arabic":"مَا","translation":"Not","transliteration":"mā"},{"position":2,"arabic":"تَذَرُ","translation":"it left","transliteration":"tadharu"},{"position":3,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":4,"arabic":"شَىْءٍ","translation":"thing","transliteration":"shayin"},{"position":5,"arabic":"أَتَتْ","translation":"it came","transliteration":"atat"},{"position":6,"arabic":"عَلَيْهِ","translation":"upon it","transliteration":"ʿalayhi"},{"position":7,"arabic":"إِلَّا","translation":"but","transliteration":"illā"},{"position":8,"arabic":"جَعَلَتْهُ","translation":"it made it","transliteration":"jaʿalathu"},{"position":9,"arabic":"كَٱلرَّمِيمِ","translation":"like disintegrated ruins","transliteration":"kal-ramīmi"}],"e3rab":"(ما تَذَرُ) ما نافية ومضارع فاعله مستتر (مِنْ شَيْءٍ) من حرف جر زائد ومجرور لفظا منصوب محلا مفعول تذر (أَتَتْ) ماض فاعله مستتر (عَلَيْهِ) متعلقان بالفعل والجملة صفة شيء (إِلَّا) حرف حصر (جَعَلَتْهُ) ماض ومفعوله والفاعل مستتر والجملة في محل نصب مفعول به ثان لتذر (كَالرَّمِيمِ) الكاف بمعنى مثل مفعول به ثان لجعلته والرميم مضاف إليه وجملة ما تذر حال\r\n\r\n"},{"sura":51,"ayah":43,"words":[{"position":1,"arabic":"وَفِى","translation":"And in","transliteration":"wafī"},{"position":2,"arabic":"ثَمُودَ","translation":"Thamud","transliteration":"thamūda"},{"position":3,"arabic":"إِذْ","translation":"when","transliteration":"idh"},{"position":4,"arabic":"قِيلَ","translation":"was said","transliteration":"qīla"},{"position":5,"arabic":"لَهُمْ","translation":"to them","transliteration":"lahum"},{"position":6,"arabic":"تَمَتَّعُوا۟","translation":"Enjoy (yourselves)","transliteration":"tamattaʿū"},{"position":7,"arabic":"حَتَّىٰ","translation":"for","transliteration":"ḥattā"},{"position":8,"arabic":"حِينٍۢ","translation":"a time","transliteration":"ḥīnin"}],"e3rab":"(وَفِي ثَمُودَ إِذْ) سبق إعراب مثيلها (قِيلَ) ماض مبني للمجهول (لَهُمْ) متعلقان بالفعل (تَمَتَّعُوا) أمر مبني على حذف النون والواو فاعله والجملة مقول القول (حَتَّى حِينٍ) متعلقان بالفعل\r\n\r\n"},{"sura":51,"ayah":44,"words":[{"position":1,"arabic":"فَعَتَوْا۟","translation":"But they rebelled","transliteration":"faʿataw"},{"position":2,"arabic":"عَنْ","translation":"against","transliteration":"ʿan"},{"position":3,"arabic":"أَمْرِ","translation":"(the) Command","transliteration":"amri"},{"position":4,"arabic":"رَبِّهِمْ","translation":"(of) their Lord","transliteration":"rabbihim"},{"position":5,"arabic":"فَأَخَذَتْهُمُ","translation":"so seized them","transliteration":"fa-akhadhathumu"},{"position":6,"arabic":"ٱلصَّـٰعِقَةُ","translation":"the thunderbolt","transliteration":"l-ṣāʿiqatu"},{"position":7,"arabic":"وَهُمْ","translation":"while they","transliteration":"wahum"},{"position":8,"arabic":"يَنظُرُونَ","translation":"were looking","transliteration":"yanẓurūna"}],"e3rab":"(فَعَتَوْا) حرف عطف وماض وفاعله والجملة معطوفة على قيل (فَأَخَذَتْهُمُ الصَّاعِقَةُ) ماض ومفعوله والصاعقة فاعله والجملة معطوفة على عتوا (وَهُمْ) الواو حالية وهم مبتدأ (يَنْظُرُونَ) مضارع مرفوع والواو فاعله والجملة خبر المبتدأ والجملة الاسمية حال.\r\n\r\n"},{"sura":51,"ayah":45,"words":[{"position":1,"arabic":"فَمَا","translation":"Then not","transliteration":"famā"},{"position":2,"arabic":"ٱسْتَطَـٰعُوا۟","translation":"they were able to","transliteration":"is'taṭāʿū"},{"position":3,"arabic":"مِن","translation":"[of]","transliteration":"min"},{"position":4,"arabic":"قِيَامٍۢ","translation":"stand","transliteration":"qiyāmin"},{"position":5,"arabic":"وَمَا","translation":"and not","transliteration":"wamā"},{"position":6,"arabic":"كَانُوا۟","translation":"they could","transliteration":"kānū"},{"position":7,"arabic":"مُنتَصِرِينَ","translation":"help themselves","transliteration":"muntaṣirīna"}],"e3rab":"(فَمَا) الفاء حرف استئناف وما نافية (اسْتَطاعُوا) ماض وفاعله (مِنْ قِيامٍ) من حرف جر زائد ومجرور لفظا منصوب محلا مفعول به والجملة مستأنفة (وَما) حرف عطف وما نافية (كانُوا) كان واسمها (مُنْتَصِرِينَ) خبرها والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":51,"ayah":46,"words":[{"position":1,"arabic":"وَقَوْمَ","translation":"And (the) people","transliteration":"waqawma"},{"position":2,"arabic":"نُوحٍۢ","translation":"(of) Nuh","transliteration":"nūḥin"},{"position":3,"arabic":"مِّن","translation":"before","transliteration":"min"},{"position":4,"arabic":"قَبْلُ ۖ","translation":"before","transliteration":"qablu"},{"position":5,"arabic":"إِنَّهُمْ","translation":"indeed, they","transliteration":"innahum"},{"position":6,"arabic":"كَانُوا۟","translation":"were","transliteration":"kānū"},{"position":7,"arabic":"قَوْمًۭا","translation":"a people","transliteration":"qawman"},{"position":8,"arabic":"فَـٰسِقِينَ","translation":"defiantly disobedient","transliteration":"fāsiqīna"}],"e3rab":"(وَقَوْمَ) الواو حرف عطف وقوم منصوب بفعل مقدر أهلكنا (نُوحٍ) مضاف إليه (مِنْ قَبْلُ) متعلقان بالفعل المقدر (إِنَّهُمْ) إن واسمها (كانُوا) كان واسمها (قَوْماً) خبرها والجملة الفعلية خبر إن (فاسِقِينَ) حال والجملة الاسمية تعليل\r\n\r\n"},{"sura":51,"ayah":47,"words":[{"position":1,"arabic":"وَٱلسَّمَآءَ","translation":"And the heaven","transliteration":"wal-samāa"},{"position":2,"arabic":"بَنَيْنَـٰهَا","translation":"We constructed it","transliteration":"banaynāhā"},{"position":3,"arabic":"بِأَيْي۟دٍۢ","translation":"with strength","transliteration":"bi-aydin"},{"position":4,"arabic":"وَإِنَّا","translation":"and indeed, We","transliteration":"wa-innā"},{"position":5,"arabic":"لَمُوسِعُونَ","translation":"(are) surely (its) Expanders","transliteration":"lamūsiʿūna"}],"e3rab":"(وَالسَّماءَ) الواو حرف استئناف والسماء منصوب على الاشتغال تقديره بنينا السماء والجملة الفعلية مستأنفة (بَنَيْناها) ماض وفاعله ومفعوله (بِأَيْدٍ) متعلقان بالفعل والجملة مفسرة للجملة المقدرة لا محل لها (وَإِنَّا) الواو حالية وإن واسمها (لَمُوسِعُونَ) اللام المزحلقة وخبر إن والجملة الاسمية حال\r\n\r\n"},{"sura":51,"ayah":48,"words":[{"position":1,"arabic":"وَٱلْأَرْضَ","translation":"And the earth","transliteration":"wal-arḍa"},{"position":2,"arabic":"فَرَشْنَـٰهَا","translation":"We have spread it","transliteration":"farashnāhā"},{"position":3,"arabic":"فَنِعْمَ","translation":"how excellent","transliteration":"faniʿ'ma"},{"position":4,"arabic":"ٱلْمَـٰهِدُونَ","translation":"(are) the Spreaders","transliteration":"l-māhidūna"}],"e3rab":"(وَالْأَرْضَ فَرَشْناها) معطوف على السماء بنيناها (فَنِعْمَ) الفاء حرف عطف وماض جامد لإنشاء المدح (الْماهِدُونَ) فاعل\r\n\r\n"},{"sura":51,"ayah":49,"words":[{"position":1,"arabic":"وَمِن","translation":"And of","transliteration":"wamin"},{"position":2,"arabic":"كُلِّ","translation":"every","transliteration":"kulli"},{"position":3,"arabic":"شَىْءٍ","translation":"thing","transliteration":"shayin"},{"position":4,"arabic":"خَلَقْنَا","translation":"We have created","transliteration":"khalaqnā"},{"position":5,"arabic":"زَوْجَيْنِ","translation":"pairs","transliteration":"zawjayni"},{"position":6,"arabic":"لَعَلَّكُمْ","translation":"so that you may","transliteration":"laʿallakum"},{"position":7,"arabic":"تَذَكَّرُونَ","translation":"remember","transliteration":"tadhakkarūna"}],"e3rab":"(وَمِنْ كُلِّ) الواو حرف استئناف وجار ومجرور متعلقان بخلقنا (شَيْءٍ) مضاف إليه (خَلَقْنا) ماض وفاعله (زَوْجَيْنِ) مفعول به والجملة مستأنفة (لَعَلَّكُمْ) لعل واسمها (تَذَكَّرُونَ) مضارع مرفوع والواو فاعله والجملة خبر لعل والجملة الاسمية تعليلية لا محل لها\r\n\r\n"},{"sura":51,"ayah":50,"words":[{"position":1,"arabic":"فَفِرُّوٓا۟","translation":"So flee","transliteration":"fafirrū"},{"position":2,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":3,"arabic":"ٱللَّهِ ۖ","translation":"Allah","transliteration":"l-lahi"},{"position":4,"arabic":"إِنِّى","translation":"indeed, I am","transliteration":"innī"},{"position":5,"arabic":"لَكُم","translation":"to you","transliteration":"lakum"},{"position":6,"arabic":"مِّنْهُ","translation":"from Him","transliteration":"min'hu"},{"position":7,"arabic":"نَذِيرٌۭ","translation":"a warner","transliteration":"nadhīrun"},{"position":8,"arabic":"مُّبِينٌۭ","translation":"clear","transliteration":"mubīnun"}],"e3rab":"(فَفِرُّوا) الفاء الفصيحة وأمر مبني على حذف النون والواو فاعله (إِلَى اللَّهِ) لفظ الجلالة مجرور بإلى وهما متعلقان بالفعل والجملة جواب شرط مقدر لا محل لها (إِنِّي) إن واسمها (لَكُمْ) متعلقان بنذير (مِنْهُ) متعلقان بنذير أيضا (نَذِيرٌ) خبر إن (مُبِينٌ) صفة والجملة الاسمية تعليل\r\n\r\n"},{"sura":51,"ayah":51,"words":[{"position":1,"arabic":"وَلَا","translation":"And (do) not","transliteration":"walā"},{"position":2,"arabic":"تَجْعَلُوا۟","translation":"make","transliteration":"tajʿalū"},{"position":3,"arabic":"مَعَ","translation":"with","transliteration":"maʿa"},{"position":4,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":5,"arabic":"إِلَـٰهًا","translation":"god","transliteration":"ilāhan"},{"position":6,"arabic":"ءَاخَرَ ۖ","translation":"another","transliteration":"ākhara"},{"position":7,"arabic":"إِنِّى","translation":"Indeed, I am","transliteration":"innī"},{"position":8,"arabic":"لَكُم","translation":"to you","transliteration":"lakum"},{"position":9,"arabic":"مِّنْهُ","translation":"from Him","transliteration":"min'hu"},{"position":10,"arabic":"نَذِيرٌۭ","translation":"a warner","transliteration":"nadhīrun"},{"position":11,"arabic":"مُّبِينٌۭ","translation":"clear","transliteration":"mubīnun"}],"e3rab":"(وَلا) الواو حرف عطف ولا ناهية (تَجْعَلُوا) مضارع مجزوم والواو فاعله (مَعَ) ظرف مكان (اللَّهِ) لفظ الجلالة مضاف إليه (إِلهاً) مفعول به (آخَرَ) صفة له والجملة معطوفة على ما قبلها (إِنِّي لَكُمْ مِنْهُ نَذِيرٌ مُبِينٌ) سبق إعرابها.\r\n\r\n"},{"sura":51,"ayah":52,"words":[{"position":1,"arabic":"كَذَٰلِكَ","translation":"Likewise","transliteration":"kadhālika"},{"position":2,"arabic":"مَآ","translation":"not","transliteration":"mā"},{"position":3,"arabic":"أَتَى","translation":"came","transliteration":"atā"},{"position":4,"arabic":"ٱلَّذِينَ","translation":"(to) those","transliteration":"alladhīna"},{"position":5,"arabic":"مِن","translation":"before them","transliteration":"min"},{"position":6,"arabic":"قَبْلِهِم","translation":"before them","transliteration":"qablihim"},{"position":7,"arabic":"مِّن","translation":"any","transliteration":"min"},{"position":8,"arabic":"رَّسُولٍ","translation":"Messenger","transliteration":"rasūlin"},{"position":9,"arabic":"إِلَّا","translation":"but","transliteration":"illā"},{"position":10,"arabic":"قَالُوا۟","translation":"they said","transliteration":"qālū"},{"position":11,"arabic":"سَاحِرٌ","translation":"A magician","transliteration":"sāḥirun"},{"position":12,"arabic":"أَوْ","translation":"or","transliteration":"aw"},{"position":13,"arabic":"مَجْنُونٌ","translation":"a madman","transliteration":"majnūnun"}],"e3rab":"(كَذلِكَ) جار ومجرور متعلقان بمحذوف صفة لمفعول مطلق محذوف (ما) نافية (أَتَى الَّذِينَ) ماض ومفعوله (مِنْ قَبْلِهِمْ) متعلقان بمحذوف صلة الموصول (مِنْ رَسُولٍ) حرف جر زائد ومجرور لفظا مرفوع محلا فاعل أتى (إِلَّا) حرف حصر (قالُوا) ماض وفاعله (ساحِرٌ) خبر لمبتدأ محذوف (أَوْ) حرف عطف (مَجْنُونٌ) معطوف على ساحر وجملة قالوا حال وجملة ما أتى تفسيرية لا محل لها\r\n\r\n"},{"sura":51,"ayah":53,"words":[{"position":1,"arabic":"أَتَوَاصَوْا۟","translation":"Have they transmitted it to them","transliteration":"atawāṣaw"},{"position":2,"arabic":"بِهِۦ ۚ","translation":"Have they transmitted it to them","transliteration":"bihi"},{"position":3,"arabic":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":4,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":5,"arabic":"قَوْمٌۭ","translation":"(are) a people","transliteration":"qawmun"},{"position":6,"arabic":"طَاغُونَ","translation":"transgressing","transliteration":"ṭāghūna"}],"e3rab":"(أَتَواصَوْا) الهمزة حرف استفهام وتوبيخ وماض وفاعله (بِهِ) متعلقان بالفعل والجملة مستأنفة (بَلْ) حرف عطف وإضراب (هُمْ قَوْمٌ) مبتدأ وخبره (طاغُونَ) صفة قوم والجملة الاسمية معطوفة على ما قبلها\r\n\r\n"},{"sura":51,"ayah":54,"words":[{"position":1,"arabic":"فَتَوَلَّ","translation":"So turn away","transliteration":"fatawalla"},{"position":2,"arabic":"عَنْهُمْ","translation":"from them","transliteration":"ʿanhum"},{"position":3,"arabic":"فَمَآ","translation":"for not","transliteration":"famā"},{"position":4,"arabic":"أَنتَ","translation":"you","transliteration":"anta"},{"position":5,"arabic":"بِمَلُومٍۢ","translation":"(are) to be blamed","transliteration":"bimalūmin"}],"e3rab":"(فَتَوَلَّ) الفاء الفصيحة وأمر مبني على حذف حرف العلة والفاعل مستتر (عَنْهُمْ) متعلقان بالفعل والجملة جواب شرط مقدر لا محل لها (فَما) الفاء حرف تعليل وما نافية عاملة عمل ليس (أَنْتَ) اسمها (بِمَلُومٍ) الباء حرف جر زائد وملوم مجرور لفظا منصوب محلا لأنه خبر ما والجملة تعليلية لا محل لها\r\n\r\n"},{"sura":51,"ayah":55,"words":[{"position":1,"arabic":"وَذَكِّرْ","translation":"And remind","transliteration":"wadhakkir"},{"position":2,"arabic":"فَإِنَّ","translation":"for indeed","transliteration":"fa-inna"},{"position":3,"arabic":"ٱلذِّكْرَىٰ","translation":"the reminder","transliteration":"l-dhik'rā"},{"position":4,"arabic":"تَنفَعُ","translation":"benefits","transliteration":"tanfaʿu"},{"position":5,"arabic":"ٱلْمُؤْمِنِينَ","translation":"the believers","transliteration":"l-mu'minīna"}],"e3rab":"(وَذَكِّرْ) الواو حرف عطف وأمر فاعله مستتر (فَإِنَّ الذِّكْرى) الفاء حرف تعليل وإن واسمها (تَنْفَعُ) مضارع فاعله مستتر (الْمُؤْمِنِينَ) مفعول به والجملة الفعلية خبر إن والجملة الاسمية تعليلية لا محل لها.\r\n\r\n"},{"sura":51,"ayah":56,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"خَلَقْتُ","translation":"I have created","transliteration":"khalaqtu"},{"position":3,"arabic":"ٱلْجِنَّ","translation":"the jinn","transliteration":"l-jina"},{"position":4,"arabic":"وَٱلْإِنسَ","translation":"and the mankind","transliteration":"wal-insa"},{"position":5,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":6,"arabic":"لِيَعْبُدُونِ","translation":"that they worship Me","transliteration":"liyaʿbudūni"}],"e3rab":"(وَما) الواو حرف استئناف وما نافية (خَلَقْتُ) ماض وفاعله (الْجِنَّ) مفعول به (وَالْإِنْسَ) معطوف على الجن والجملة مستأنفة (إِلَّا) حرف حصر (لِيَعْبُدُونِ) مضارع منصوب بأن مضمرة بعد لام العاقبة والواو فاعله والنون للوقاية وياء المتكلم المحذوف مفعول به والمصدر المؤول من أن وما بعدها في محل جر باللام والجار والمجرور متعلقان بخلقت\r\n\r\n"},{"sura":51,"ayah":57,"words":[{"position":1,"arabic":"مَآ","translation":"Not","transliteration":"mā"},{"position":2,"arabic":"أُرِيدُ","translation":"I want","transliteration":"urīdu"},{"position":3,"arabic":"مِنْهُم","translation":"from them","transliteration":"min'hum"},{"position":4,"arabic":"مِّن","translation":"any","transliteration":"min"},{"position":5,"arabic":"رِّزْقٍۢ","translation":"provision","transliteration":"riz'qin"},{"position":6,"arabic":"وَمَآ","translation":"and not","transliteration":"wamā"},{"position":7,"arabic":"أُرِيدُ","translation":"I want","transliteration":"urīdu"},{"position":8,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":9,"arabic":"يُطْعِمُونِ","translation":"they (should) feed Me","transliteration":"yuṭ'ʿimūni"}],"e3rab":"(ما) نافية (أُرِيدُ) مضارع فاعله مستتر والجملة حالية (مِنْهُمْ) متعلقان بالفعل (مِنْ رِزْقٍ) من حرف جر زائد ورزق مجرور لفظا منصوب محلا مفعول به (وَما أُرِيدُ) الواو حرف عطف وما أريد معطوف على مثيله (أَنْ يُطْعِمُونِ) مضارع منصوب بأن والواو فاعله والنون للوقاية وياء المتكلم المحذوفة مفعول به والمصدر المؤول من أن وما بعدها في محل نصب مفعول به لأريد\r\n\r\n"},{"sura":51,"ayah":58,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":3,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":4,"arabic":"ٱلرَّزَّاقُ","translation":"(is) the All-Provider","transliteration":"l-razāqu"},{"position":5,"arabic":"ذُو","translation":"Possessor","transliteration":"dhū"},{"position":6,"arabic":"ٱلْقُوَّةِ","translation":"(of) Power","transliteration":"l-quwati"},{"position":7,"arabic":"ٱلْمَتِينُ","translation":"the Strong","transliteration":"l-matīnu"}],"e3rab":"(إِنَّ اللَّهَ) إن ولفظ الجلالة اسمها (هُوَ) ضمير فصل (الرَّزَّاقُ) خبره وجملة هو الرزاق خبر إن وجملة إن اللّه مستأنفة (ذُو) خبر ثان (الْقُوَّةِ) مضاف إليه (الْمَتِينُ) صفة الرزاق\r\n\r\n"},{"sura":51,"ayah":59,"words":[{"position":1,"arabic":"فَإِنَّ","translation":"So indeed","transliteration":"fa-inna"},{"position":2,"arabic":"لِلَّذِينَ","translation":"for those who","transliteration":"lilladhīna"},{"position":3,"arabic":"ظَلَمُوا۟","translation":"do wrong","transliteration":"ẓalamū"},{"position":4,"arabic":"ذَنُوبًۭا","translation":"(is) a portion","transliteration":"dhanūban"},{"position":5,"arabic":"مِّثْلَ","translation":"like","transliteration":"mith'la"},{"position":6,"arabic":"ذَنُوبِ","translation":"(the) portion","transliteration":"dhanūbi"},{"position":7,"arabic":"أَصْحَـٰبِهِمْ","translation":"(of) their companions","transliteration":"aṣḥābihim"},{"position":8,"arabic":"فَلَا","translation":"so let them not ask Me to hasten","transliteration":"falā"},{"position":9,"arabic":"يَسْتَعْجِلُونِ","translation":"so let them not ask Me to hasten","transliteration":"yastaʿjilūni"}],"e3rab":"(فَإِنَّ) الفاء حرف استئناف وحرف مشبه بالفعل (لِلَّذِينَ) خبر إن المقدم (ظَلَمُوا) ماض وفاعله والجملة صلة (ذَنُوباً) اسم إن المؤخر (مِثْلَ) صفة ذنوبا (ذَنُوبِ) مضاف إليه (أَصْحابِهِمْ) مضاف إليه (فَلا) حرف عطف ولا ناهية (يَسْتَعْجِلُونِ) مضارع مجزوم بلا والواو فاعله والنون للوقاية وياء المتكلم المحذوفة مفعول به\r\n\r\n"},{"sura":51,"ayah":60,"words":[{"position":1,"arabic":"فَوَيْلٌۭ","translation":"Then woe","transliteration":"fawaylun"},{"position":2,"arabic":"لِّلَّذِينَ","translation":"to those who","transliteration":"lilladhīna"},{"position":3,"arabic":"كَفَرُوا۟","translation":"disbelieve","transliteration":"kafarū"},{"position":4,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":5,"arabic":"يَوْمِهِمُ","translation":"their Day","transliteration":"yawmihimu"},{"position":6,"arabic":"ٱلَّذِى","translation":"which","transliteration":"alladhī"},{"position":7,"arabic":"يُوعَدُونَ","translation":"they are promised","transliteration":"yūʿadūna"}],"e3rab":"(فَوَيْلٌ) حرف استئناف ومبتدأ (لِلَّذِينَ) خبر والجملة الاسمية مستأنفة (كَفَرُوا) ماض وفاعله والجملة صلة (مِنْ يَوْمِهِمُ) متعلقان بمحذوف صفة ويل (الَّذِي) صفة يومهم (يُوعَدُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة صلة.\r\n\r\n"}]