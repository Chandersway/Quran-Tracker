[{"sura":54,"ayah":1,"words":[{"position":1,"arabic":"ٱقْتَرَبَتِ","translation":"Has come near","transliteration":"iq'tarabati"},{"position":2,"arabic":"ٱلسَّاعَةُ","translation":"the Hour","transliteration":"l-sāʿatu"},{"position":3,"arabic":"وَٱنشَقَّ","translation":"and has split","transliteration":"wa-inshaqqa"},{"position":4,"arabic":"ٱلْقَمَرُ","translation":"the moon","transliteration":"l-qamaru"}],"e3rab":"(اقْتَرَبَتِ السَّاعَةُ) ماض وفاعله والجملة ابتدائية لا محل لها (وَانْشَقَّ الْقَمَرُ) ماض وفاعله والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":54,"ayah":2,"words":[{"position":1,"arabic":"وَإِن","translation":"And if","transliteration":"wa-in"},{"position":2,"arabic":"يَرَوْا۟","translation":"they see","transliteration":"yaraw"},{"position":3,"arabic":"ءَايَةًۭ","translation":"a Sign","transliteration":"āyatan"},{"position":4,"arabic":"يُعْرِضُوا۟","translation":"they turn away","transliteration":"yuʿ'riḍū"},{"position":5,"arabic":"وَيَقُولُوا۟","translation":"and say","transliteration":"wayaqūlū"},{"position":6,"arabic":"سِحْرٌۭ","translation":"Magic","transliteration":"siḥ'run"},{"position":7,"arabic":"مُّسْتَمِرٌّۭ","translation":"continuing","transliteration":"mus'tamirrun"}],"e3rab":"(وَإِنْ يَرَوْا) الواو حرف عطف وإن شرطية ومضارع مجزوم فعل الشرط والواو فاعله (آيَةً) مفعول به والجملة ابتدائية لا محل لها (يُعْرِضُوا) مضارع مجزوم لأنه جواب الشرط وعلامة جزمه حذف النون والواو فاعله والجملة لا محل لها لأنها جواب الشرط (وَيَقُولُوا) معطوف على يعرضوا (سِحْرٌ) خبر لمبتدأ محذوف (مُسْتَمِرٌّ) صفة سحر والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":54,"ayah":3,"words":[{"position":1,"arabic":"وَكَذَّبُوا۟","translation":"And they denied","transliteration":"wakadhabū"},{"position":2,"arabic":"وَٱتَّبَعُوٓا۟","translation":"and followed","transliteration":"wa-ittabaʿū"},{"position":3,"arabic":"أَهْوَآءَهُمْ ۚ","translation":"their desires","transliteration":"ahwāahum"},{"position":4,"arabic":"وَكُلُّ","translation":"but (for) every","transliteration":"wakullu"},{"position":5,"arabic":"أَمْرٍۢ","translation":"matter","transliteration":"amrin"},{"position":6,"arabic":"مُّسْتَقِرٌّۭ","translation":"(will be a) settlement","transliteration":"mus'taqirrun"}],"e3rab":"(وَكَذَّبُوا) ماض وفاعله والجملة معطوفة على ما قبلها (وَاتَّبَعُوا) معطوف على كذبوا (أَهْواءَهُمْ) مفعول به (وَكُلُّ أَمْرٍ مُسْتَقِرٌّ) الواو حرف استئناف ومبتدأ وأمر مضاف إليه ومستقر خبر والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":54,"ayah":4,"words":[{"position":1,"arabic":"وَلَقَدْ","translation":"And certainly","transliteration":"walaqad"},{"position":2,"arabic":"جَآءَهُم","translation":"has come to them","transliteration":"jāahum"},{"position":3,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":4,"arabic":"ٱلْأَنۢبَآءِ","translation":"the information","transliteration":"l-anbāi"},{"position":5,"arabic":"مَا","translation":"wherein","transliteration":"mā"},{"position":6,"arabic":"فِيهِ","translation":"wherein","transliteration":"fīhi"},{"position":7,"arabic":"مُزْدَجَرٌ","translation":"(is) deterrence","transliteration":"muz'dajarun"}],"e3rab":"(وَلَقَدْ) الواو حرف قسم وجر واللام واقعة في جواب القسم وقد حرف تحقيق (جاءَهُمْ) ماض ومفعوله (مِنَ الْأَنْباءِ) متعلقان بالفعل (ما) فاعل والجملة الفعلية جواب القسم لا محل لها (فِيهِ) خبر مقدم (مُزْدَجَرٌ) مبتدأ مؤخر والجملة الاسمية صلة ما.\r\n\r\n"},{"sura":54,"ayah":5,"words":[{"position":1,"arabic":"حِكْمَةٌۢ","translation":"Wisdom","transliteration":"ḥik'matun"},{"position":2,"arabic":"بَـٰلِغَةٌۭ ۖ","translation":"perfect","transliteration":"bālighatun"},{"position":3,"arabic":"فَمَا","translation":"but not","transliteration":"famā"},{"position":4,"arabic":"تُغْنِ","translation":"will avail","transliteration":"tugh'ni"},{"position":5,"arabic":"ٱلنُّذُرُ","translation":"the warnings","transliteration":"l-nudhuru"}],"e3rab":"(حِكْمَةٌ) بدل من ما وبالغة صفة حكمة، (فَما) الفاء حرف استئناف وما نافية (تُغْنِ) مضارع (النُّذُرُ) فاعله والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":54,"ayah":6,"words":[{"position":1,"arabic":"فَتَوَلَّ","translation":"So turn away","transliteration":"fatawalla"},{"position":2,"arabic":"عَنْهُمْ ۘ","translation":"from them","transliteration":"ʿanhum"},{"position":3,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":4,"arabic":"يَدْعُ","translation":"will call","transliteration":"yadʿu"},{"position":5,"arabic":"ٱلدَّاعِ","translation":"the caller","transliteration":"l-dāʿi"},{"position":6,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":7,"arabic":"شَىْءٍۢ","translation":"a thing","transliteration":"shayin"},{"position":8,"arabic":"نُّكُرٍ","translation":"terrible","transliteration":"nukurin"}],"e3rab":"(فَتَوَلَّ) الفاء الفصيحة وأمر مبني على حذف حرف العلة والفاعل مستتر (عَنْهُمْ) متعلقان بالفعل والجملة جواب شرط غير جازم لا محل لها (يَوْمَ) ظرف زمان (يَدْعُ الدَّاعِ) مضارع وفاعله والجملة في محل جر بالإضافة (إِلى شَيْءٍ) متعلقان بالفعل (نُكُرٍ) صفة شيء.\r\n\r\n"},{"sura":54,"ayah":7,"words":[{"position":1,"arabic":"خُشَّعًا","translation":"(Will be) humbled","transliteration":"khushaʿan"},{"position":2,"arabic":"أَبْصَـٰرُهُمْ","translation":"their eyes","transliteration":"abṣāruhum"},{"position":3,"arabic":"يَخْرُجُونَ","translation":"they will come forth","transliteration":"yakhrujūna"},{"position":4,"arabic":"مِنَ","translation":"from","transliteration":"mina"},{"position":5,"arabic":"ٱلْأَجْدَاثِ","translation":"the graves","transliteration":"l-ajdāthi"},{"position":6,"arabic":"كَأَنَّهُمْ","translation":"as if they (were)","transliteration":"ka-annahum"},{"position":7,"arabic":"جَرَادٌۭ","translation":"locusts","transliteration":"jarādun"},{"position":8,"arabic":"مُّنتَشِرٌۭ","translation":"spreading","transliteration":"muntashirun"}],"e3rab":"(خُشَّعاً أَبْصارُهُمْ) حال وأبصارهم فاعل خشعا (يَخْرُجُونَ) مضارع مرفوع بثبوت النون والواو فاعله (مِنَ الْأَجْداثِ) متعلقان بالفعل والجملة حال (كَأَنَّهُمْ) كأن واسمها (جَرادٌ مُنْتَشِرٌ) خبرها ومنتشر صفة جراد والجملة الاسمية حال.\r\n\r\n"},{"sura":54,"ayah":8,"words":[{"position":1,"arabic":"مُّهْطِعِينَ","translation":"Racing ahead","transliteration":"muh'ṭiʿīna"},{"position":2,"arabic":"إِلَى","translation":"towards","transliteration":"ilā"},{"position":3,"arabic":"ٱلدَّاعِ ۖ","translation":"the caller","transliteration":"l-dāʿi"},{"position":4,"arabic":"يَقُولُ","translation":"Will say","transliteration":"yaqūlu"},{"position":5,"arabic":"ٱلْكَـٰفِرُونَ","translation":"the disbelievers","transliteration":"l-kāfirūna"},{"position":6,"arabic":"هَـٰذَا","translation":"This","transliteration":"hādhā"},{"position":7,"arabic":"يَوْمٌ","translation":"(is) a Day","transliteration":"yawmun"},{"position":8,"arabic":"عَسِرٌۭ","translation":"difficult","transliteration":"ʿasirun"}],"e3rab":"(مُهْطِعِينَ) حال (إِلَى الدَّاعِ) متعلقان بما قبلهما.\r\n\r\n(يَقُولُ الْكافِرُونَ) مضارع وفاعله الجملة استئنافية لا محل لها، (هذا يَوْمٌ) مبتدأ وخبره (عَسِرٌ) صفة يوم والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":54,"ayah":9,"words":[{"position":1,"arabic":"۞ كَذَّبَتْ","translation":"Denied","transliteration":"kadhabat"},{"position":2,"arabic":"قَبْلَهُمْ","translation":"before them","transliteration":"qablahum"},{"position":3,"arabic":"قَوْمُ","translation":"(the) people","transliteration":"qawmu"},{"position":4,"arabic":"نُوحٍۢ","translation":"(of) Nuh","transliteration":"nūḥin"},{"position":5,"arabic":"فَكَذَّبُوا۟","translation":"and they denied","transliteration":"fakadhabū"},{"position":6,"arabic":"عَبْدَنَا","translation":"Our slave","transliteration":"ʿabdanā"},{"position":7,"arabic":"وَقَالُوا۟","translation":"and said","transliteration":"waqālū"},{"position":8,"arabic":"مَجْنُونٌۭ","translation":"A madman","transliteration":"majnūnun"},{"position":9,"arabic":"وَٱزْدُجِرَ","translation":"and he was repelled","transliteration":"wa-uz'dujira"}],"e3rab":"(كَذَّبَتْ قَبْلَهُمْ) ماض وظرف زمان (قَوْمُ) فاعله (نُوحٍ) مضاف إليه والجملة استئنافية لا محل لها (فَكَذَّبُوا عَبْدَنا) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها (وَقالُوا) معطوف على كذبوا (مَجْنُونٌ) خبر لمبتدأ محذوف والجملة الاسمية مقول القول (وَازْدُجِرَ) ماض مبني للمجهول ونائب الفاعل مستتر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":54,"ayah":10,"words":[{"position":1,"arabic":"فَدَعَا","translation":"So he called","transliteration":"fadaʿā"},{"position":2,"arabic":"رَبَّهُۥٓ","translation":"his Lord","transliteration":"rabbahu"},{"position":3,"arabic":"أَنِّى","translation":"I am","transliteration":"annī"},{"position":4,"arabic":"مَغْلُوبٌۭ","translation":"one overpowered","transliteration":"maghlūbun"},{"position":5,"arabic":"فَٱنتَصِرْ","translation":"so help","transliteration":"fa-intaṣir"}],"e3rab":"(فَدَعا رَبَّهُ) ماض ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها، (أَنِّي مَغْلُوبٌ) أن واسمها وخبرها والمصدر المؤول من أن وما بعدها في محل نصب بنزع الخافض، (فَانْتَصِرْ) الفاء الفصيحة وأمر فاعله مستتر والجملة الفعلية جواب شرط غير جازم لا محل لها.\r\n\r\n"},{"sura":54,"ayah":11,"words":[{"position":1,"arabic":"فَفَتَحْنَآ","translation":"So We opened","transliteration":"fafataḥnā"},{"position":2,"arabic":"أَبْوَٰبَ","translation":"(the) gates","transliteration":"abwāba"},{"position":3,"arabic":"ٱلسَّمَآءِ","translation":"(of) heaven","transliteration":"l-samāi"},{"position":4,"arabic":"بِمَآءٍۢ","translation":"with water","transliteration":"bimāin"},{"position":5,"arabic":"مُّنْهَمِرٍۢ","translation":"pouring down","transliteration":"mun'hamirin"}],"e3rab":"(فَفَتَحْنا) حرف عطف وماض وفاعله (أَبْوابَ) مفعوله (السَّماءِ) مضاف إليه (بِماءٍ) متعلقان بالفعل (مُنْهَمِرٍ) صفة ماء والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":54,"ayah":12,"words":[{"position":1,"arabic":"وَفَجَّرْنَا","translation":"And We caused to burst","transliteration":"wafajjarnā"},{"position":2,"arabic":"ٱلْأَرْضَ","translation":"the earth","transliteration":"l-arḍa"},{"position":3,"arabic":"عُيُونًۭا","translation":"(with) springs","transliteration":"ʿuyūnan"},{"position":4,"arabic":"فَٱلْتَقَى","translation":"so met","transliteration":"fal-taqā"},{"position":5,"arabic":"ٱلْمَآءُ","translation":"the water(s)","transliteration":"l-māu"},{"position":6,"arabic":"عَلَىٰٓ","translation":"for","transliteration":"ʿalā"},{"position":7,"arabic":"أَمْرٍۢ","translation":"a matter","transliteration":"amrin"},{"position":8,"arabic":"قَدْ","translation":"already","transliteration":"qad"},{"position":9,"arabic":"قُدِرَ","translation":"predestined","transliteration":"qudira"}],"e3rab":"(وَفَجَّرْنَا) حرف عطف وماض وفاعله (الْأَرْضَ) مفعوله (عُيُوناً) تمييز، والجملة معطوفة على ما قبلها، (فَالْتَقَى) معطوف على فجرنا (الْماءُ) فاعل (عَلى أَمْرٍ) متعلقان بالفعل (قَدْ) حرف تحقيق (قُدِرَ) ماض مبني للمجهول والجملة صفة أمر.\r\n\r\n"},{"sura":54,"ayah":13,"words":[{"position":1,"arabic":"وَحَمَلْنَـٰهُ","translation":"And We carried him","transliteration":"waḥamalnāhu"},{"position":2,"arabic":"عَلَىٰ","translation":"on","transliteration":"ʿalā"},{"position":3,"arabic":"ذَاتِ","translation":"(ark) made of planks","transliteration":"dhāti"},{"position":4,"arabic":"أَلْوَٰحٍۢ","translation":"(ark) made of planks","transliteration":"alwāḥin"},{"position":5,"arabic":"وَدُسُرٍۢ","translation":"and nails","transliteration":"wadusurin"}],"e3rab":"(وَحَمَلْناهُ) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها (عَلى ذاتِ) متعلقان بالفعل (أَلْواحٍ) مضاف إليه (وَدُسُرٍ) معطوف على ألواح.\r\n\r\n"},{"sura":54,"ayah":14,"words":[{"position":1,"arabic":"تَجْرِى","translation":"Sailing","transliteration":"tajrī"},{"position":2,"arabic":"بِأَعْيُنِنَا","translation":"before Our eyes","transliteration":"bi-aʿyuninā"},{"position":3,"arabic":"جَزَآءًۭ","translation":"a reward","transliteration":"jazāan"},{"position":4,"arabic":"لِّمَن","translation":"for (he) who","transliteration":"liman"},{"position":5,"arabic":"كَانَ","translation":"was","transliteration":"kāna"},{"position":6,"arabic":"كُفِرَ","translation":"denied","transliteration":"kufira"}],"e3rab":"(تَجْرِي) مضارع فاعله مستتر (بِأَعْيُنِنا) متعلقان بمحذوف حال (جَزاءً) مفعول لأجله والجملة حال.\r\n\r\n(لِمَنْ) متعلقان بجزاء (كانَ) ماض ناقص اسمه مستتر (كُفِرَ) ماض مبني للمجهول وجملة كفر خبر كان وجملة كان كفر صلة من لا محل لها.\r\n\r\n"},{"sura":54,"ayah":15,"words":[{"position":1,"arabic":"وَلَقَد","translation":"And certainly","transliteration":"walaqad"},{"position":2,"arabic":"تَّرَكْنَـٰهَآ","translation":"We left it","transliteration":"taraknāhā"},{"position":3,"arabic":"ءَايَةًۭ","translation":"(as) a Sign","transliteration":"āyatan"},{"position":4,"arabic":"فَهَلْ","translation":"so is (there)","transliteration":"fahal"},{"position":5,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":6,"arabic":"مُّدَّكِرٍۢ","translation":"who will receive admonition","transliteration":"muddakirin"}],"e3rab":"(وَلَقَدْ) انظر الآية رقم- 4- من نفس السورة (تَرَكْناها) ماض وفاعله ومفعوله الأول (آيَةً) مفعوله الثاني والجملة جواب القسم لا محل لها، (فَهَلْ) الفاء حرف استئناف وهل حرف استفهام (مِنْ مُدَّكِرٍ) مجرور لفظا بمن الزائدة مرفوع محلا على أنه مبتدأ خبره محذوف والجملة الاسمية استئنافية لا محل لها.\r\n\r\n"},{"sura":54,"ayah":16,"words":[{"position":1,"arabic":"فَكَيْفَ","translation":"So how","transliteration":"fakayfa"},{"position":2,"arabic":"كَانَ","translation":"was","transliteration":"kāna"},{"position":3,"arabic":"عَذَابِى","translation":"My punishment","transliteration":"ʿadhābī"},{"position":4,"arabic":"وَنُذُرِ","translation":"and My warnings","transliteration":"wanudhuri"}],"e3rab":"(فَكَيْفَ) الفاء حرف استئناف وكيف اسم استفهام خبر كان المقدم (كانَ) ماض ناقص (عَذابِي) اسمه (وَنُذُرِ) معطوف على عذابي.\r\n\r\n"},{"sura":54,"ayah":17,"words":[{"position":1,"arabic":"وَلَقَدْ","translation":"And certainly","transliteration":"walaqad"},{"position":2,"arabic":"يَسَّرْنَا","translation":"We have made easy","transliteration":"yassarnā"},{"position":3,"arabic":"ٱلْقُرْءَانَ","translation":"the Quran","transliteration":"l-qur'āna"},{"position":4,"arabic":"لِلذِّكْرِ","translation":"for remembrance","transliteration":"lildhik'ri"},{"position":5,"arabic":"فَهَلْ","translation":"so is (there)","transliteration":"fahal"},{"position":6,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":7,"arabic":"مُّدَّكِرٍۢ","translation":"who will receive admonition","transliteration":"muddakirin"}],"e3rab":"(وَلَقَدْ) سبق إعرابها في الآية- 4- من السورة (يَسَّرْنَا الْقُرْآنَ) ماض وفاعله ومفعوله والجملة جواب القسم لا محل لها، (لِلذِّكْرِ) متعلقان بالفعل (فَهَلْ مِنْ مُدَّكِرٍ) سبق إعرابها في الآية- 15- من السورة.\r\n\r\n"},{"sura":54,"ayah":18,"words":[{"position":1,"arabic":"كَذَّبَتْ","translation":"Denied","transliteration":"kadhabat"},{"position":2,"arabic":"عَادٌۭ","translation":"Aad","transliteration":"ʿādun"},{"position":3,"arabic":"فَكَيْفَ","translation":"so how","transliteration":"fakayfa"},{"position":4,"arabic":"كَانَ","translation":"was","transliteration":"kāna"},{"position":5,"arabic":"عَذَابِى","translation":"My punishment","transliteration":"ʿadhābī"},{"position":6,"arabic":"وَنُذُرِ","translation":"and My warnings","transliteration":"wanudhuri"}],"e3rab":"(كَذَّبَتْ عادٌ) ماض وفاعله والجملة استئنافية لا محل لها، (فَكَيْفَ كانَ عَذابِي وَنُذُرِ): سبق إعرابها في الآية- 16- من السورة.\r\n\r\n"},{"sura":54,"ayah":19,"words":[{"position":1,"arabic":"إِنَّآ","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"أَرْسَلْنَا","translation":"[We] sent","transliteration":"arsalnā"},{"position":3,"arabic":"عَلَيْهِمْ","translation":"upon them","transliteration":"ʿalayhim"},{"position":4,"arabic":"رِيحًۭا","translation":"a wind","transliteration":"rīḥan"},{"position":5,"arabic":"صَرْصَرًۭا","translation":"furious","transliteration":"ṣarṣaran"},{"position":6,"arabic":"فِى","translation":"on","transliteration":"fī"},{"position":7,"arabic":"يَوْمِ","translation":"a day","transliteration":"yawmi"},{"position":8,"arabic":"نَحْسٍۢ","translation":"(of) misfortune","transliteration":"naḥsin"},{"position":9,"arabic":"مُّسْتَمِرٍّۢ","translation":"continuous","transliteration":"mus'tamirrin"}],"e3rab":"(إِنَّا) إن واسمها، (أَرْسَلْنا) ماض وفاعله (عَلَيْهِمْ) متعلقان بالفعل (رِيحاً) مفعول به (صَرْصَراً) صفة ريحا وجملة أرسلنا.. خبر إن وجملة إنا.. استئنافية لا محل لها (فِي يَوْمِ) متعلقان بأرسلنا (نَحْسٍ) مضاف إليه (مُسْتَمِرٍّ) صفة نحس.\r\n\r\n"},{"sura":54,"ayah":20,"words":[{"position":1,"arabic":"تَنزِعُ","translation":"Plucking out","transliteration":"tanziʿu"},{"position":2,"arabic":"ٱلنَّاسَ","translation":"men","transliteration":"l-nāsa"},{"position":3,"arabic":"كَأَنَّهُمْ","translation":"as if they (were)","transliteration":"ka-annahum"},{"position":4,"arabic":"أَعْجَازُ","translation":"trunks","transliteration":"aʿjāzu"},{"position":5,"arabic":"نَخْلٍۢ","translation":"(of) date-palms","transliteration":"nakhlin"},{"position":6,"arabic":"مُّنقَعِرٍۢ","translation":"uprooted","transliteration":"munqaʿirin"}],"e3rab":"(تَنْزِعُ النَّاسَ) مضارع ومفعوله والفاعل مستتر والجملة صفة ريحا (كَأَنَّهُمْ أَعْجازُ) كأن واسمها وخبرها (نَخْلٍ) مضاف إليه (مُنْقَعِرٍ) صفة أعجاز وجملة كأنهم.. حال.\r\n\r\n"},{"sura":54,"ayah":21,"words":[{"position":1,"arabic":"فَكَيْفَ","translation":"So how","transliteration":"fakayfa"},{"position":2,"arabic":"كَانَ","translation":"was","transliteration":"kāna"},{"position":3,"arabic":"عَذَابِى","translation":"My punishment","transliteration":"ʿadhābī"},{"position":4,"arabic":"وَنُذُرِ","translation":"and My warnings","transliteration":"wanudhuri"}],"e3rab":"تقدم إعرابها\r\n\r\n"},{"sura":54,"ayah":22,"words":[{"position":1,"arabic":"وَلَقَدْ","translation":"And certainly","transliteration":"walaqad"},{"position":2,"arabic":"يَسَّرْنَا","translation":"We have made easy","transliteration":"yassarnā"},{"position":3,"arabic":"ٱلْقُرْءَانَ","translation":"the Quran","transliteration":"l-qur'āna"},{"position":4,"arabic":"لِلذِّكْرِ","translation":"for remembrance","transliteration":"lildhik'ri"},{"position":5,"arabic":"فَهَلْ","translation":"so is (there)","transliteration":"fahal"},{"position":6,"arab