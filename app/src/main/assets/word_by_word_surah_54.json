َ","translation":"Has been sent","transliteration":"a-ul'qiya"},{"position":2,"arabic":"ٱلذِّكْرُ","translation":"the Reminder","transliteration":"l-dhik'ru"},{"position":3,"arabic":"عَلَيْهِ","translation":"to him","transliteration":"ʿalayhi"},{"position":4,"arabic":"مِنۢ","translation":"from","transliteration":"min"},{"position":5,"arabic":"بَيْنِنَا","translation":"among us","transliteration":"bayninā"},{"position":6,"arabic":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":7,"arabic":"هُوَ","translation":"he","transliteration":"huwa"},{"position":8,"arabic":"كَذَّابٌ","translation":"(is) a liar","transliteration":"kadhābun"},{"position":9,"arabic":"أَشِرٌۭ","translation":"insolent","transliteration":"ashirun"}],"e3rab":"(أَأُلْقِيَ) الهمزة حرف استفهام وماض مبني للمجهول (الذِّكْرُ) نائب فاعل (عَلَيْهِ) متعلقان بالفعل (مِنْ بَيْنِنا) متعلقان بمحذوف حال والجملة مقول القول (بَلْ) حرف عطف وانتقال (هُوَ كَذَّابٌ) مبتدأ وخبره (أَشِرٌ) صفة والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":54,"ayah":26,"words":[{"position":1,"arabic":"سَيَعْلَمُونَ","translation":"They will know","transliteration":"sayaʿlamūna"},{"position":2,"arabic":"غَدًۭا","translation":"tomorrow","transliteration":"ghadan"},{"position":3,"arabic":"مَّنِ","translation":"who","transliteration":"mani"},{"position":4,"arabic":"ٱلْكَذَّابُ","translation":"(is) the liar","transliteration":"l-kadhābu"},{"position":5,"arabic":"ٱلْأَشِرُ","translation":"the insolent one","transliteration":"l-ashiru"}],"e3rab":"(سَيَعْلَمُونَ) السين حرف استقبال ومضارع مرفوع بثبوت النون والواو فاعله (غَداً) ظرف زمان (مَنِ الْكَذَّابُ) مبتدأ وخبره (الْأَشِرُ) صفة والجملة الاسمية سدت مسد مفعولي يعلمون.\r\n\r\n"},{"sura":54,"ayah":27,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"مُرْسِلُوا۟","translation":"(are) sending","transliteration":"mur'silū"},{"position":3,"arabic":"ٱلنَّاقَةِ","translation":"the she-camel","transliteration":"l-nāq