teration":"fa-akhadhnāhum"},{"position":5,"arabic":"أَخْذَ","translation":"(with) a seizure","transliteration":"akhdha"},{"position":6,"arabic":"عَزِيزٍۢ","translation":"(of) All-Mighty","transliteration":"ʿazīzin"},{"position":7,"arabic":"مُّقْتَدِرٍ","translation":"(the) Powerful One","transliteration":"muq'tadirin"}],"e3rab":"(كَذَّبُوا) ماض وفاعله (بِآياتِنا) متعلقان بالفعل (كُلِّها) توكيد والجملة استئنافية لا محل لها.\r\n\r\n(فَأَخَذْناهُمْ) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها (أَخْذَ) مفعول مطلق مضاف إلى عزيز (عَزِيزٍ) مضاف إليه (مُقْتَدِرٍ) صفة عزيز.\r\n\r\n"},{"sura":54,"ayah":43,"words":[{"position":1,"arabic":"أَكُفَّارُكُمْ","translation":"Are your disbelievers","transliteration":"akuffārukum"},{"position":2,"arabic":"خَيْرٌۭ","translation":"better","transliteration":"khayrun"},{"position":3,"arabic":"مِّنْ","translation":"than","transliteration":"min"},{"position":4,"arabic":"أُو۟لَـٰٓئِكُمْ","translation":"those","transliteration":"ulāikum"},{"position":5,"arabic":"أَمْ","translation":"or","transliteration":"am"},{"position":6,"arabic":"لَكُم","translation":"for you","transliteration":"lakum"},{"position":7,"arabic":"بَرَآءَةٌۭ","translation":"(is) an exemption","transliteration":"barāatun"},{"position":8,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":9,"arabic":"ٱلزُّبُرِ","translation":"the Scriptures","transliteration":"l-zuburi"}],"e3rab":"(أَكُفَّارُكُمْ خَيْرٌ) الهمزة حرف استفهام إنكاري ومبتدأ وخبره والجملة الاسمية استئنافية لا محل لها (مِنْ أُولئِكُمْ) متعلقان بخير (أَمْ) حرف عطف (لَكُمْ) خبر مقدم (بَراءَةٌ) مبتدأ مؤخر (فِي الزُّبُرِ) متعلقان ببراءة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":54,"ayah":44,"words":[{"position":1,"arabic":"أَمْ","translation":"Or","transliteration":"am"},{"position":2,"arabic":"يَقُولُونَ","translation":"(do) they say","transliteration":"yaqūlūna"},{"position":3,"arabic":"نَحْنُ","translation":"We","transliteration":"naḥnu"},{"position":4,"arabic":"جَمِيعٌۭ","translation":"(are) an assembly","transliteration":"jamīʿun"},{"position":5,"arabic":"مُّنتَصِرٌۭ","translation":"helping (each other)","transliteration":"muntaṣirun"}],"e3rab":"(أَمْ) حرف عطف (يَقُولُونَ) مضارع مرفوع والواو فاعله والجملة معطوفة على ما قبلها (نَحْنُ جَمِيعٌ) مبتدأ وخبره والجملة مقول القول (مُنْتَصِرٌ) صفة جميع.\r\n\r\n"},{"sura":54,"ayah":45,"words":[{"position":1,"arabic":"سَيُهْزَمُ","translation":"Soon will be defeated","transliteration":"sayuh'zamu"},{"position":2,"arabic":"ٱلْجَمْعُ","translation":"(their) assembly","transliteration":"l-jamʿu"},{"position":3,"arabic":"وَيُوَلُّونَ","translation":"and they will turn","transliteration":"wayuwallūna"},{"position":4,"arabic":"ٱلدُّبُرَ","translation":"(their) backs","transliteration":"l-dubura"}],"e3rab":"(سَيُهْزَمُ الْجَمْعُ) السين للاستقبال ومضارع مبني للمجهول ونائب فاعل والجملة استئنافية لا محل لها.\r\n\r\n(وَيُوَلُّونَ) مضارع مرفوع والواو فاعله (الدُّبُرَ) مفعول به والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":54,"ayah":46,"words":[{"position":1,"arabic":"بَلِ","translation":"Nay","transliteration":"bali"},{"position":2,"arabic":"ٱلسَّاعَةُ","translation":"the Hour","transliteration":"l-sāʿatu"},{"position":3,"arabic":"مَوْعِدُهُمْ","translation":"(is) their promised time","transliteration":"mawʿiduhum"},{"position":4,"arabic":"وَٱلسَّاعَةُ","translation":"and the Hour","transliteration":"wal-sāʿatu"},{"position":5,"arabic":"أَدْهَىٰ","translation":"(will be) more grievous","transliteration":"adhā"},{"position":6,"arabic":"وَأَمَرُّ","translation":"and more bitter","transliteration":"wa-amarru"}],"e3rab":"(بَلِ) حرف عطف وإضراب (السَّاعَةُ مَوْعِدُهُمْ) مبتدأ وخبره والجملة استئنافية لا محل لها.\r\n\r\n(وَالسَّاعَةُ أَدْهى) مبتدأ وخبره والجملة معطوفة على ما قبلها (وَأَمَرُّ) معطوف على ما قبله.\r\n\r\n"},{"sura":54,"ayah":47,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلْمُجْرِمِينَ","translation":"the criminals","transliteration":"l-muj'rimīna"},{"position":3,"arabic":"فِى","translation":"(are) in","transliteration":"fī"},{"position":4,"arabic":"ضَلَـٰلٍۢ","translation":"an error","transliteration":"ḍalālin"},{"position":5,"arabic":"وَسُعُرٍۢ","translation":"and madness","transliteration":"wasuʿurin"}],"e3rab":"(إِنَّ الْمُجْرِمِينَ) إن واسمها (فِي ضَلالٍ) خبرها (وَسُعُرٍ) معطوف على ضلال والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":54,"ayah":48,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"يُسْحَبُونَ","translation":"they will be dragged","transliteration":"yus'ḥabūna"},{"position":3,"arabic":"فِى","translation":"into","transliteration":"fī"},{"position":4,"arabic":"ٱلنَّارِ","translation":"the Fire","transliteration":"l-nāri"},{"position":5,"arabic":"عَلَىٰ","translation":"on","transliteration":"ʿalā"},{"position":6,"arabic":"وُجُوهِهِمْ","translation":"their faces","transliteration":"wujūhihim"},{"position":7,"arabic":"ذُوقُوا۟","translation":"Taste","transliteration":"dhūqū"},{"position":8,"arabic":"مَسَّ","translation":"(the) touch","transliteration":"massa"},{"position":9,"arabic":"سَقَرَ","translation":"(of) Hell","transliteration":"saqara"}],"e3rab":"(يَوْمَ يُسْحَبُونَ) ظرف زمان ومضارع مبني للمجهول والواو نائب فاعل والجملة في محل جر بالإضافة (فِي النَّارِ) متعلقان بالفعل (عَلى وُجُوهِهِمْ) متعلقان بالفعل أيضا (ذُوقُوا) أمر مبني على حذف النون والواو فاعله والجملة مقول قول مقدر (مَسَّ) مفعول به مضاف إلى سقر (سَقَرَ) مضاف إليه.\r\n\r\n"},{"sura":54,"ayah":49,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, [We]","transliteration":"innā"},{"position":2,"arabic":"كُلَّ","translation":"every","transliteration":"kulla"},{"position":3,"arabic":"شَىْءٍ","translation":"thing","transliteration":"shayin"},{"position":4,"arabic":"خَلَقْنَـٰهُ","translation":"We created it","transliteration":"khalaqnāhu"},{"position":5,"arabic":"بِقَدَرٍۢ","translation":"by a measure","transliteration":"biqadarin"}],"e3rab":"(إِنَّا) إن واسمها (كُلَّ) مفعول به لفعل محذوف مضاف إلى شيء (شَيْءٍ) مضاف إليه والجملة استئنافية لا محل لها.\r\n\r\n(خَلَقْناهُ) ماض وفاعله ومفعوله (بِقَدَرٍ) متعلقان بمحذوف حال والجملة الفعلية تفسيرية لا محل لها والجملة الفعلية المقدرة خبر إن.\r\n\r\n"},{"sura":54,"ayah":50,"words":[{"position":1,"arabic":"وَمَآ","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"أَمْرُنَآ","translation":"(is) Our Command","transliteration":"amrunā"},{"position":3,"arabic":"إِلَّا","translation":"but","transliteration":"illā"},{"position":4,"arabic":"وَٰحِدَةٌۭ","translation":"one","transliteration":"wāḥidatun"},{"position":5,"arabic":"كَلَمْحٍۭ","translation":"like the twinkling","transliteration":"kalamḥin"},{"position":6,"arabic":"بِٱلْبَصَرِ","translation":"(of) the eye","transliteration":"bil-baṣari"}],"e3rab":"(وَما) الواو حالية وما نافية (أَمْرُنا) مبتدأ (إِلَّا) حرف حصر (واحِدَةٌ) خبر (كَلَمْحٍ) متعلقان بمحذوف حال (بِالْبَصَرِ) متعلقان بلمح والجملة حالية.\r\n\r\n"},{"sura":54,"ayah":51,"words":[{"position":1,"arabic":"وَلَقَدْ","translation":"And certainly","transliteration":"walaqad"},{"position":2,"arabic":"أَهْلَكْنَآ","translation":"We destroyed","transliteration":"ahlaknā"},{"position":3,"arabic":"أَشْيَاعَكُمْ","translation":"your kinds","transliteration":"ashyāʿakum"},{"position":4,"arabic":"فَهَلْ","translation":"so is (there)","transliteration":"fahal"},{"position":5,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":6,"arabic":"مُّدَّكِرٍۢ","translation":"who will receive admonition","transliteration":"muddakirin"}],"e3rab":"(وَلَقَدْ) سبق إعرابها (أَهْلَكْنا أَشْياعَكُمْ) ماض وفاعله ومفعوله والجملة جواب القسم لا محل لها (فَهَلْ مِنْ مُدَّكِرٍ): انظر- 16- الآية.\r\n\r\n"},{"sura":54,"ayah":52,"words":[{"position":1,"arabic":"وَكُلُّ","translation":"And every","transliteration":"wakullu"},{"position":2,"arabic":"شَىْءٍۢ","translation":"thing","transliteration":"shayin"},{"position":3,"arabic":"فَعَلُوهُ","translation":"they did","transliteration":"faʿalūhu"},{"position":4,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":5,"arabic":"ٱلزُّبُرِ","translation":"the written records","transliteration":"l-zuburi"}],"e3rab":"(وَكُلُّ) الواو حرف استئناف ومبتدأ (شَيْءٍ) مضاف إليه (فَعَلُوهُ) ماض وفاعله ومفعوله والجملة صفة شيء و(فِي الزُّبُرِ) متعلقان بمحذوف خبر المبتدأ والجملة الاسمية استئنافية لا محل لها.\r\n\r\n"},{"sura":54,"ayah":53,"words":[{"position":1,"arabic":"وَكُلُّ","translation":"And every","transliteration":"wakullu"},{"position":2,"arabic":"صَغِيرٍۢ","translation":"small","transliteration":"ṣaghīrin"},{"position":3,"arabic":"وَكَبِيرٍۢ","translation":"and big","transliteration":"wakabīrin"},{"position":4,"arabic":"مُّسْتَطَرٌ","translation":"(is) written down","transliteration":"mus'taṭarun"}],"e3rab":"(وَكُلُّ صَغِيرٍ) مبتدأ ومضاف إليه (وَكَبِيرٍ) معطوف على صغير (مُسْتَطَرٌ) خبر والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":54,"ayah":54,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلْمُتَّقِينَ","translation":"the righteous","transliteration":"l-mutaqīna"},{"position":3,"arabic":"فِى","translation":"(will be) in","transliteration":"fī"},{"position":4,"arabic":"جَنَّـٰتٍۢ","translation":"gardens","transliteration":"jannātin"},{"position":5,"arabic":"وَنَهَرٍۢ","translation":"and river","transliteration":"wanaharin"}],"e3rab":"(إِنَّ الْمُتَّقِينَ) إن واسمها (فِي جَنَّاتٍ) متعلقان بمحذوف خبر إن (وَنَهَرٍ) معطوف على ما قبله والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":54,"ayah":55,"words":[{"position":1,"arabic":"فِى","translation":"In","transliteration":"fī"},{"position":2,"arabic":"مَقْعَدِ","translation":"a seat","transliteration":"maqʿadi"},{"position":3,"arabic":"صِدْقٍ","translation":"(of) honor","transliteration":"ṣid'qin"},{"position":4,"arabic":"عِندَ","translation":"near","transliteration":"ʿinda"},{"position":5,"arabic":"مَلِيكٍۢ","translation":"a King","transliteration":"malīkin"},{"position":6,"arabic":"مُّقْتَدِرٍۭ","translation":"Most Powerful","transliteration":"muq'tadirin"}],"e3rab":"(فِي مَقْعَدِ) بدل من قوله في جنات (صِدْقٍ) مضاف إليه (عِنْدَ) ظرف مكان مضاف إلى مليك (مَلِيكٍ) مضاف إليه (مُقْتَدِرٍ) صفة مليك.\r\n\r\n"}]