"translation":"among them","transliteration":"min'hum"},{"position":5,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":6,"arabic":"يُدْخَلَ","translation":"he enters","transliteration":"yud'khala"},{"position":7,"arabic":"جَنَّةَ","translation":"a Garden","transliteration":"jannata"},{"position":8,"arabic":"نَعِيمٍۢ","translation":"(of) Delight","transliteration":"naʿīmin"}],"e3rab":"(أَيَطْمَعُ كُلُّ امْرِئٍ) الهمزة حرف استفهام إنكاري توبيخي ومضارع وفاعله المضاف إلى امرئ (مِنْهُمْ) متعلقان بمحذوف صفة امرئ (أَنْ يُدْخَلَ) مضارع مبني للمجهول منصوب بأن ونائب الفاعل مستتر (جَنَّةَ) مفعول به ثان (نَعِيمٍ) مضاف إليه والمصدر المؤول من أن والفعل منصوب بنزع الخافض والجار والمجرور متعلقان بالفعل يطمع وجملة أيطمع.. استئنافية لا محل لها.\r\n\r\n"},{"sura":70,"ayah":39,"words":[{"position":1,"arabic":"كَلَّآ ۖ","translation":"By no means","transliteration":"kallā"},{"position":2,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":3,"arabic":"خَلَقْنَـٰهُم","translation":"[We] have created them","transliteration":"khalaqnāhum"},{"position":4,"arabic":"مِّمَّا","translation":"from what","transliteration":"mimmā"},{"position":5,"arabic":"يَعْلَمُونَ","translation":"they know","transliteration":"yaʿlamūna"}],"e3rab":"(كَلَّا) حرف ردع وزجر (إِنَّا) إن واسمها (خَلَقْناهُمْ) ماض وفاعله ومفعوله والجملة خبر إن والجملة الاسمية تعليل لا محل لها (مِمَّا) متعلقان بخلقناهم (يَعْلَمُونَ) مضارع مرفوع والواو فاعله والجملة صلة ما.\r\n\r\n"},{"sura":70,"ayah":40,"words":[{"position":1,"arabic":"فَلَآ","translation":"But nay","transliteration":"falā"},{"position":2,"arabic":"أُقْسِمُ","translation":"I swear","transliteration":"uq'simu"},{"position":3,"arabic":"بِرَبِّ","translation":"by (the) Lord","transliteration":"birabbi"},{"position":4,"arabic":"ٱلْمَشَـٰرِقِ","translation":"(of) the risings","transliteration":"l-mashāriqi"},{"position":5,"arabic":"وَٱلْمَغَـٰرِبِ","translation":"and the settings","transliteration":"wal-maghāribi"},{"position":6,"arabic":"إِنَّا","translation":"that We","transliteration":"innā"},{"position":7,"arabic":"لَقَـٰدِرُونَ","translation":"(are) surely Able","transliteration":"laqādirūna"}],"e3rab":"(فَلا) الفاء حرف استئناف (لا أُقْسِمُ) لا نافية ومضارع فاعله مستتر والجملة استئنافية لا محل لها (بِرَبِّ) متعلقان بالفعل (الْمَشارِقِ) مضاف إليه (وَالْمَغارِبِ) معطوف عليه (إِنَّا) إن واسمها (لَقادِرُونَ) اللام المزحلقة (قادرون) خبر والجملة الاسمية جواب القسم لا محل لها.\r\n\r\n"},{"sura":70,"ayah":41,"words":[{"position":1,"arabic":"عَلَىٰٓ","translation":"[On]","transliteration":"ʿalā"},{"position":2,"arabic":"أَن","translation":"to","transliteration":"an"},{"position":3,"arabic":"نُّبَدِّلَ","translation":"[We] replace","transliteration":"nubaddila"},{"position":4,"arabic":"خَيْرًۭا","translation":"(with) better","transliteration":"khayran"},{"position":5,"arabic":"مِّنْهُمْ","translation":"than them","transliteration":"min'hum"},{"position":6,"arabic":"وَمَا","translation":"and not","transliteration":"wamā"},{"position":7,"arabic":"نَحْنُ","translation":"We","transliteration":"naḥnu"},{"position":8,"arabic":"بِمَسْبُوقِينَ","translation":"(are) to be outrun","transliteration":"bimasbūqīna"}],"e3rab":"(عَلى أَنْ نُبَدِّلَ) حرف جر ومضارع منصوب بأن فاعله مستتر والمصدر المؤول من أن والفعل في محل جر بعلى والجار والمجرور متعلقان بقادرون (خَيْراً) مفعول به (مِنْهُمْ) متعلقان بخيرا (وَما) الواو حالية (ما) نافية حجازية (نَحْنُ) اسمها (بِمَسْبُوقِينَ) مجرور لفظا بالباء الزائدة منصوب محلا خبر ما والجملة الاسمية حال.\r\n\r\n"},{"sura":70,"ayah":42,"words":[{"position":1,"arabic":"فَذَرْهُمْ","translation":"So leave them","transliteration":"fadharhum"},{"position":2,"arabic":"يَخُوضُوا۟","translation":"(to) converse vainly","transliteration":"yakhūḍū"},{"position":3,"arabic":"وَيَلْعَبُوا۟","translation":"and amuse themselves","transliteration":"wayalʿabū"},{"position":4,"arabic":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":5,"arabic":"يُلَـٰقُوا۟","translation":"they meet","transliteration":"yulāqū"},{"position":6,"arabic":"يَوْمَهُمُ","translation":"their Day","transliteration":"yawmahumu"},{"position":7,"arabic":"ٱلَّذِى","translation":"which","transliteration":"alladhī"},{"position":8,"arabic":"يُوعَدُونَ","translation":"they are promised","transliteration":"yūʿadūna"}],"e3rab":"(فَذَرْهُمْ) الفاء الفصيحة وأمر فاعله مستتر والهاء مفعول به والجملة جواب شرط مقدر لا محل لها (يَخُوضُوا) مضارع مجزوم لأنه جواب الطلب والواو فاعله (وَيَلْعَبُوا) معطوف على يخوضوا (حَتَّى يُلاقُوا) حتى حرف غاية وجر ومضارع منصوب بأن مضمرة بعد حتى والواو فاعله (يَوْمَهُمُ) مفعول به (الَّذِي) صفة والمصدر المؤول من أن المضمرة والفعل في محل جر بحتى والجار والمجرور متعلقان بيلعبوا (يُوعَدُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة صلة.\r\n\r\n"},{"sura":70,"ayah":43,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"يَخْرُجُونَ","translation":"they will come out","transliteration":"yakhrujūna"},{"position":3,"arabic":"مِنَ","translation":"from","transliteration":"mina"},{"position":4,"arabic":"ٱلْأَجْدَاثِ","translation":"the graves","transliteration":"l-ajdāthi"},{"position":5,"arabic":"سِرَاعًۭا","translation":"rapidly","transliteration":"sirāʿan"},{"position":6,"arabic":"كَأَنَّهُمْ","translation":"as if they (were)","transliteration":"ka-annahum"},{"position":7,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":8,"arabic":"نُصُبٍۢ","translation":"a goal","transliteration":"nuṣubin"},{"position":9,"arabic":"يُوفِضُونَ","translation":"hastening","transliteration":"yūfiḍūna"}],"e3rab":"(يَوْمَ يَخْرُجُونَ) بدل من يومهم ومضارع مرفوع بثبوت النون والواو فاعله والجملة في محل جر بالإضافة (مِنَ الْأَجْداثِ) متعلقان بالفعل (سِراعاً) حال (كَأَنَّهُمْ) كأن واسمها (إِلى نُصُبٍ) متعلقان بما بعدهما (يُوفِضُونَ) مضارع مرفوع والواو فاعله ويوفضون: يسرعون والجملة الفعلية خبر كأن والجملة الاسمية حال ثانية.\r\n\r\n"},{"sura":70,"ayah":44,"words":[{"position":1,"arabic":"خَـٰشِعَةً","translation":"Humbled","transliteration":"khāshiʿatan"},{"position":2,"arabic":"أَبْصَـٰرُهُمْ","translation":"their eyesights","transliteration":"abṣāruhum"},{"position":3,"arabic":"تَرْهَقُهُمْ","translation":"will cover them","transliteration":"tarhaquhum"},{"position":4,"arabic":"ذِلَّةٌۭ ۚ","translation":"humiliation","transliteration":"dhillatun"},{"position":5,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":6,"arabic":"ٱلْيَوْمُ","translation":"(is) the Day","transliteration":"l-yawmu"},{"position":7,"arabic":"ٱلَّذِى","translation":"which","transliteration":"alladhī"},{"position":8,"arabic":"كَانُوا۟","translation":"they were","transliteration":"kānū"},{"position":9,"arabic":"يُوعَدُونَ","translation":"promised","transliteration":"yūʿadūna"}],"e3rab":"(خاشِعَةً) حال (أَبْصارُهُمْ) فاعل خاشعة (تَرْهَقُهُمْ) مضارع ومفعوله (ذِلَّةٌ) فاعل مؤخر والجملة الفعلية حال ثانية (ذلِكَ) اسم الإشارة مبتدأ (الْيَوْمُ) خبره والجملة مستأنفة لا محل لها (الَّذِي) صفة اليوم (كانُوا) كان واسمها (يُوعَدُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة خبر كانوا وجملة كانوا.. صلة موصول.\r\n\r\n"}]