[{"sura":75,"ayah":1,"words":[{"position":1,"arabic":"لَآ","translation":"Nay","transliteration":"lā"},{"position":2,"arabic":"أُقْسِمُ","translation":"I swear","transliteration":"uq'simu"},{"position":3,"arabic":"بِيَوْمِ","translation":"by (the) Day","transliteration":"biyawmi"},{"position":4,"arabic":"ٱلْقِيَـٰمَةِ","translation":"(of) the Resurrection","transliteration":"l-qiyāmati"}],"e3rab":"(لا أُقْسِمُ) زائدة ومضارع فاعله مستتر و(بِيَوْمِ) متعلقان بالفعل و(الْقِيامَةِ) مضاف إليه والجملة ابتدائية لا محل لها\r\n\r\n"},{"sura":75,"ayah":2,"words":[{"position":1,"arabic":"وَلَآ","translation":"And nay","transliteration":"walā"},{"position":2,"arabic":"أُقْسِمُ","translation":"I swear","transliteration":"uq'simu"},{"position":3,"arabic":"بِٱلنَّفْسِ","translation":"by the soul","transliteration":"bil-nafsi"},{"position":4,"arabic":"ٱللَّوَّامَةِ","translation":"self-accusing","transliteration":"l-lawāmati"}],"e3rab":"(وَلا أُقْسِمُ) معطوف على ما قبله و(بِالنَّفْسِ) متعلقان بالفعل و(اللَّوَّامَةِ) صفة.\r\n\r\n"},{"sura":75,"ayah":3,"words":[{"position":1,"arabic":"أَيَحْسَبُ","translation":"Does think","transliteration":"ayaḥsabu"},{"position":2,"arabic":"ٱلْإِنسَـٰنُ","translation":"[the] man","transliteration":"l-insānu"},{"position":3,"arabic":"أَلَّن","translation":"that not","transliteration":"allan"},{"position":4,"arabic":"نَّجْمَعَ","translation":"We will assemble","transliteration":"najmaʿa"},{"position":5,"arabic":"عِظَامَهُۥ","translation":"his bones","transliteration":"ʿiẓāmahu"}],"e3rab":"(أَيَحْسَبُ الْإِنْسانُ) الهمزة حرف استفهام ومضارع وفاعله والجملة مستأنفة لا محل لها و(أن) مخففة من الثقيلة واسمها ضمير الشأن محذوف و(لن نَجْمَعَ) مضارع منصوب بلن والفاعل مستتر و(عِظامَهُ) مفعول به والجملة خبر أن المخففة والمصدر المؤول من أن وما بعدها سد مسد مفعولي يحسب\r\n\r\n"},{"sura":75,"ayah":4,"words":[{"position":1,"arabic":"بَلَىٰ","translation":"Nay","transliteration":"balā"},{"position":2,"arabic":"قَـٰدِرِينَ","translation":"(We are) Able","transliteration":"qādirīna"},{"position":3,"arabic":"عَلَىٰٓ","translation":"on","transliteration":"ʿalā"},{"position":4,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":5,"arabic":"نُّسَوِّىَ","translation":"We can restore","transliteration":"nusawwiya"},{"position":6,"arabic":"بَنَانَهُۥ","translation":"his fingertips","transliteration":"banānahu"}],"e3rab":"و(بَلى) حرف جواب و(قادِرِينَ) حال و(عَلى) حرف جر و(أَنْ نُسَوِّيَ) مضارع منصوب بأن فاعله مستتر و(بَنانَهُ) مفعول به والمصدر المؤول من أن والفعل في محل جر بعلى والجار والمجرور متعلقان بقادرين.\r\n\r\n"},{"sura":75,"ayah":5,"words":[{"position":1,"arabic":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":2,"arabic":"يُرِيدُ","translation":"Desires","transliteration":"yurīdu"},{"position":3,"arabic":"ٱلْإِنسَـٰنُ","translation":"[the] man","transliteration":"l-insānu"},{"position":4,"arabic":"لِيَفْجُرَ","translation":"to give (the) lie","transliteration":"liyafjura"},{"position":5,"arabic":"أَمَامَهُۥ","translation":"(to) what is before him","transliteration":"amāmahu"}],"e3rab":"(بَلْ) حرف إضراب انتقالي و(يُرِيدُ الْإِنْسانُ) مضارع وفاعله والجملة مستأنفة لا محل لها و(لِيَفْجُرَ) مضارع منصوب بأن مضمرة بعد لام التعليل و(أَمامَهُ) ظرف مكان والمصدر المؤول من أن المضمرة والفعل في محل جر باللام والجار والمجرور متعلقان بالفعل.\r\n\r\n"},{"sura":75,"ayah":6,"words":[{"position":1,"arabic":"يَسْـَٔلُ","translation":"He asks","transliteration":"yasalu"},{"position":2,"arabic":"أَيَّانَ","translation":"When","transliteration":"ayyāna"},{"position":3,"arabic":"يَوْمُ","translation":"(is the) Day","transliteration":"yawmu"},{"position":4,"arabic":"ٱلْقِيَـٰمَةِ","translation":"(of) the Resurrection","transliteration":"l-qiyāmati"}],"e3rab":"و(يَسْئَلُ) مضارع فاعله مستتر و(أَيَّانَ) اسم استفهام في محل نصب على الظرفية الزمانية متعلق بمحذوف خبر مقدم و(يَوْمُ) مبتدأ مؤخر مضاف إلى (الْقِيامَةِ) والجملة الاسمية سدت مسد مفعولي يسأل وجملة يسأل.. مستأنفة لا محل لها.\r\n\r\n"},{"sura":75,"ayah":7,"words":[{"po