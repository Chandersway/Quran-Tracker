[{"sura":98,"ayah":1,"words":[{"position":1,"arabic":"لَمْ","translation":"Not","transliteration":"lam"},{"position":2,"arabic":"يَكُنِ","translation":"were","transliteration":"yakuni"},{"position":3,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":4,"arabic":"كَفَرُوا۟","translation":"disbelieved","transliteration":"kafarū"},{"position":5,"arabic":"مِنْ","translation":"from","transliteration":"min"},{"position":6,"arabic":"أَهْلِ","translation":"(the) People","transliteration":"ahli"},{"position":7,"arabic":"ٱلْكِتَـٰبِ","translation":"of the Book","transliteration":"l-kitābi"},{"position":8,"arabic":"وَٱلْمُشْرِكِينَ","translation":"and the polytheists","transliteration":"wal-mush'rikīna"},{"position":9,"arabic":"مُنفَكِّينَ","translation":"to be abandoned","transliteration":"munfakkīna"},{"position":10,"arabic":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":11,"arabic":"تَأْتِيَهُمُ","translation":"(there) comes to them","transliteration":"tatiyahumu"},{"position":12,"arabic":"ٱلْبَيِّنَةُ","translation":"the clear evidence","transliteration":"l-bayinatu"}],"e3rab":"(لَمْ يَكُنِ) مضارع ناقص مجزوم بلم (الَّذِينَ) اسم يكن والجملة ابتدائية لا محل لها (كَفَرُوا) ماض وفاعله والجملة صلة (مِنْ أَهْلِ) متعلقان بمحذوف حال (الْكِتابِ) مضاف إليه (وَالْمُشْرِكِينَ) معطوف على أهل (مُنْفَكِّينَ) خبر يكن (حَتَّى) حرف غاية وجر (تَأْتِيَهُمُ) مضارع منصوب بأن مضمرة بعد حتى والهاء مفعول به (الْبَيِّنَةُ) فاعل والمصدر المؤول من أن والفعل في محل جر بحتى والجار والمجرور متعلقان بمنفكين.\r\n\r\n"},{"sura":98,"ayah":2,"words":[{"position":1,"arabic":"رَسُولٌۭ","translation":"A Messenger","transliteration":"rasūlun"},{"position":2,"arabic":"مِّنَ","translation":"from","transliteration":"mina"},{"position":3,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":4,"arabic":"يَتْلُوا۟","translation":"reciting","transliteration":"yatlū"},{"position":5,"arabic":"صُحُفًۭا","translation":"pages","transliteration":"ṣuḥufan"},{"position":6,"arabic":"مُّطَهَّرَةًۭ","translation":"purified","transliteration":"muṭahharatan"}],"e3rab":"(رَسُولٌ) بدل من البينة (مِنَ اللَّهِ) متعلقان برسول (يَتْلُوا) مضارع فاعله مستتر (صُحُفاً) مفعول به (مُطَهَّرَةً) صفة والجملة صفة رسول.\r\n\r\n"},{"sura":98,"ayah":3,"words":[{"position":1,"arabic":"فِيهَا","translation":"Wherein","transliteration":"fīhā"},{"position":2,"arabic":"كُتُبٌۭ","translation":"(are) writings","transliteration":"kutubun"},{"position":3,"arabic":"قَيِّمَةٌۭ","translation":"correct","transliteration":"qayyimatun"}],"e3rab":"(فِيها) الجار ومجرور خبر مقدم (كُتُبٌ) مبتدأ مؤخر (قَيِّمَةٌ) صفة والجملة صفة صحفا.\r\n\r\n"},{"sura":98,"ayah":4,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"تَفَرَّقَ","translation":"became divided","transliteration":"tafarraqa"},{"position":3,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":4,"arabic":"أُوتُوا۟","translation":"were given","transliteration":"ūtū"},{"position":5,"arabic":"ٱلْكِتَـٰبَ","translation":"the Book","transliteration":"l-kitāba"},{"position":6,"arabic":"إِلَّا","translation":"until","transliteration":"illā"},{"position":7,"arabic":"مِنۢ","translation":"from","transliteration":"min"},{"position":8,"arabic":"بَعْدِ","translation":"after","transliteration":"baʿdi"},{"position":9,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":10,"arabic":"جَآءَتْهُمُ","translation":"came (to) them","transliteration":"jāathumu"},{"position":11,"arabic":"ٱلْبَيِّنَةُ","translation":"(of) the clear evidence","transliteration":"l-bayinatu"}],"e3rab":"(وَما) الواو حرف استئناف (ما) نافية (تَفَرَّقَ الَّذِينَ) ماض وفاعله والجملة مستأنفة لا محل لها.\r\n\r\n(أُوتُوا) ماض مبني للمجهول والواو نائب فاعل (الْكِتابَ) مفعول به والجملة صلة (إِلَّا) حرف حصر (مِنْ بَعْدِ) متعلقان بتفرق (ما جاءَتْهُمُ) ما مصدرية وماض ومفعوله (الْبَيِّنَةُ) فاعل والمصدر المؤول من ما والفعل في محل جر بالإضافة.\r\n\r\n"},{"sura":98,"ayah":5,"words":[{"position":1,"arabic":"وَمَآ","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"أُمِرُوٓا۟","translation":"they were commanded","transliteration":"umirū"},{"position":3,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":4,"arabic":"لِيَعْبُدُوا۟","translation":"to worship","transliteration":"liyaʿbudū"},{"position":5,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":6,"arabic":"مُخْلِصِينَ","translation":"(being) sincere","transliteration":"mukh'liṣīna"},{"position":7,"arabic":"لَهُ","translation":"to Him","transliteration":"lahu"},{"position":8,"arabic":"ٱلدِّينَ","translation":"(in) the religion","transliteration":"l-dīna"},{"position":9,"arabic":"حُنَفَآءَ","translation":"upright","transliteration":"ḥunafāa"},{"position":10,"arabic":"وَيُقِيمُوا۟","translation":"and to establish","transliteration":"wayuqīmū"},{"position":11,"arabic":"ٱلصَّلَوٰةَ","translation":"the prayer","transliteration":"l-ṣalata"},{"position":12,"arabic":"وَيُؤْتُوا۟","translation":"and to give","transliteration":"wayu'tū"},{"position":13,"arabic":"ٱلزَّكَوٰةَ ۚ","translation":"the zakah","transliteration":"l-zakata"},{"position":14,"arabic":"وَذَٰلِكَ","translation":"And that","transliteration":"wadhālika"},{"position":15,"arabic":"دِينُ","translation":"(is the) religion","transliteration":"dīnu"},{"position":16,"arabic":"ٱلْقَيِّمَةِ","translation":"the correct","transliteration":"l-qayimati"}],"e3rab":"(وَما) الواو حالية (ما) نافية (أُمِرُوا) ماض مبني للمجهول والواو نائب فاعل والجملة حال (إِلَّا) حرف حصر (لِيَعْبُدُوا) مضارع منصوب بأن مضمرة بعد لام التعليل والواو فاعل والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بأمروا (اللَّهَ) لفظ الجلالة مفعول به (مُخْلِصِينَ) حال (لَهُ) متعلقان بما قبلهما (الدِّينَ) مفعول به لاسم الفاعل مخلصين (حُنَفاءَ) حال ثانية (وَيُقِيمُوا) معطوف على يعبدوا منصوب مثله (الصَّلاةَ) مفعول به (وَيُؤْتُوا) معطوف على يعبدوا أيضا منصوب مثله (الزَّكاةَ) مفعول به (وَذلِكَ دِينُ) مبتدأ وخبره (الْقَيِّمَةِ) مضاف إليه والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":98,"ayah":6,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"كَفَرُوا۟","translation":"disbelieve","transliteration":"kafarū"},{"position":4,"arabic":"مِنْ","translation":"from","transliteration":"min"},{"position":5,"arabic":"أَهْلِ","translation":"(the) People","transliteration":"ahli"},{"position":6,"arabic":"ٱلْكِتَـٰبِ","translation":"(of) the Book","transliteration":"l-kitābi"},{"position":7,"arabic":"وَٱلْمُشْرِكِينَ","translation":"and the polytheists","transliteration":"wal-mush'rikīna"},{"position":8,"arabic":"فِى","translation":"(will be) in","transliteration":"fī"},{"position":9,"arabic":"نَارِ","translation":"(the) Fire","transliteration":"nāri"},{"position":10,"arabic":"جَهَنَّمَ","translation":"(of) Hell","transliteration":"jahannama"},{"position":11,"arabic":"خَـٰلِدِينَ","translation":"abiding eternally","transliteration":"khālidīna"},{"position":12,"arabic":"فِيهَآ ۚ","translation":"therein","transliteration":"fīhā"},{"position":13,"arabic":"أُو۟لَـٰٓئِكَ","translation":"Those ","transliteration":"ulāika"},{"position":14,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":15,"arabic":"شَرُّ","translation":"(are the) worst","transliteration":"sharru"},{"position":16,"arabic":"ٱلْبَرِيَّةِ","translation":"(of) the creatures","transliteration":"l-bariyati"}],"e3rab":"(إِنَّ الَّذِينَ) إن واسمها (كَفَرُوا) ماض وفاعله والجملة صلة (مِنْ أَهْلِ) متعلقان بمحذوف حال (الْكِتابِ) مضاف إليه (وَالْمُشْرِكِينَ) معطوف على ما قبله (فِي نارِ) خبر إن وجملة إن الذين.. مستأنفة لا محل لها.\r\n\r\n(جَهَنَّمَ) مضاف إليه (خالِدِينَ) حال (فِيها) متعلقان بما قبلهما (أُولئِكَ) مبتدأ (هُمْ) ضمير فصل (شَرُّ الْبَرِيَّةِ) خبر المبتدأ مضاف إلى البرية والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"},{"sura":98,"ayah":7,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"وَعَمِلُوا۟","translation":"and do","transliteration":"waʿamilū"},{"position":5,"arabic":"ٱلصَّـٰلِحَـٰتِ","translation":"righteous deeds","transliteration":"l-ṣāliḥāti"},{"position":6,"arabic":"أُو۟لَـٰٓئِكَ","translation":"those ","transliteration":"ulāika"},{"position":7,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":8,"arabic":"خَيْرُ","translation":"(are the) best","transliteration":"khayru"},{"position":9,"arabic":"ٱلْبَرِيَّةِ","translation":"(of) the creatures","transliteration":"l-bariyati"}],"e3rab":"(إِنَّ الَّذِينَ) إن واسمها (آمَنُوا) ماض وفاعله والجملة صلة (وَعَمِلُوا) معطوف على آمنوا (الصَّالِحاتِ) مفعول به (أُولئِكَ) مبتدأ (هُمْ) ضمير فصل (خَيْرُ الْبَرِيَّةِ) خبر المبتدأ مضاف إلى البرية والجملة الاسمية خبر إن وجملة إن الذين.. مستأنفة لا محل لها.\r\n\r\n"},{"sura":98,"ayah":8,"words":[{"position":1,"arabic":"جَزَآؤُهُمْ","translation":"Their reward","transliteration":"jazāuhum"},{"position":2,"arabic":"عِندَ","translation":"(is) with","transliteration":"ʿinda"},{"position":3,"arabic":"رَبِّهِمْ","translation":"their Lord ","transliteration":"rabbihim"},{"position":4,"arabic":"جَنَّـٰتُ","translation":"Gardens","transliteration":"jannātu"},{"position":5,"arabic":"عَدْنٍۢ","translation":"(of) Eternity","transliteration":"ʿadnin"},{"position":6,"arabic":"تَجْرِى","translation":"flow","transliteration":"tajrī"},{"position":7,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":8,"arabic":"تَحْتِهَا","translation":"underneath them","transliteration":"taḥtihā"},{"position":9,"arabic":"ٱلْأَنْهَـٰرُ","translation":"the rivers","transliteration":"l-anhāru"},{"position":10,"arabic":"خَـٰلِدِينَ","translation":"will abide","transliteration":"khālidīna"},{"position":11,"arabic":"فِيهَآ","translation":"therein","transliteration":"fīhā"},{"position":12,"arabic":"أَبَدًۭا ۖ","translation":"forever","transliteration":"abadan"},{"position":13,"arabic":"رَّضِىَ","translation":"(will be) pleased","transliteration":"raḍiya"},{"position":14,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":15,"arabic":"عَنْهُمْ","translation":"with them","transliteration":"ʿanhum"},{"position":16,"arabic":"وَرَضُوا۟","translation":"and they (will be) pleased","transliteration":"waraḍū"},{"position":17,"arabic":"عَنْهُ ۚ","translation":"with Him","transliteration":"ʿanhu"},{"position":18,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":19,"arabic":"لِمَنْ","translation":"(is) for whoever","transliteration":"liman"},{"position":20,"arabic":"خَشِىَ","translation":"feared","transliteration":"khashiya"},{"position":21,"arabic":"رَبَّهُۥ","translation":"his Lord","transliteration":"rabbahu"}],"e3rab":"(جَزاؤُهُمْ) مبتدأ (عِنْدَ) ظرف مكان (رَبِّهِمْ) مضاف إليه (جَنَّاتُ عَدْنٍ) خبر مضاف إلى عدن، والجملة الاسمية مستأنفة لا محل لها (تَجْرِي) مضارع مرفوع (مِنْ تَحْتِهَا) متعلقان بالفعل (الْأَنْهارُ) فاعل والجملة الفعلية صفة (خالِدِينَ) حال (فِيها) متعلقان بخالدين (أَبَداً) ظرف زمان (رَضِيَ اللَّهُ) ماض وفاعله (عَنْهُمْ) متعلقان بالفعل والجملة مستأنفة لا محل لها.\r\n\r\n(وَرَضُوا عَنْهُ) معطوف على ما قبله (ذلِكَ) مبتدأ (لِمَنْ) متعلقان بمحذوف خبر والجملة الاسمية مستأنفة لا محل لها (خَشِيَ رَبَّهُ) ماض ومفعوله والفاعل مستتر والجملة صلة من لا محل لها.\r\n\r\n"}]