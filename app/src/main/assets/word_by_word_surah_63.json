[{"sura":63,"ayah":1,"words":[{"position":1,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":2,"arabic":"جَآءَكَ","translation":"come to you","transliteration":"jāaka"},{"position":3,"arabic":"ٱلْمُنَـٰفِقُونَ","translation":"the hypocrites","transliteration":"l-munāfiqūna"},{"position":4,"arabic":"قَالُوا۟","translation":"they say","transliteration":"qālū"},{"position":5,"arabic":"نَشْهَدُ","translation":"We testify","transliteration":"nashhadu"},{"position":6,"arabic":"إِنَّكَ","translation":"that you","transliteration":"innaka"},{"position":7,"arabic":"لَرَسُولُ","translation":"(are) surely (the) Messenger","transliteration":"larasūlu"},{"position":8,"arabic":"ٱللَّهِ ۗ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":9,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":10,"arabic":"يَعْلَمُ","translation":"knows","transliteration":"yaʿlamu"},{"position":11,"arabic":"إِنَّكَ","translation":"that you","transliteration":"innaka"},{"position":12,"arabic":"لَرَسُولُهُۥ","translation":"(are) surely His Messenger","transliteration":"larasūluhu"},{"position":13,"arabic":"وَٱللَّهُ","translation":"and Allah","transliteration":"wal-lahu"},{"position":14,"arabic":"يَشْهَدُ","translation":"testifies","transliteration":"yashhadu"},{"position":15,"arabic":"إِنَّ","translation":"that","transliteration":"inna"},{"position":16,"arabic":"ٱلْمُنَـٰفِقِينَ","translation":"the hypocrites","transliteration":"l-munāfiqīna"},{"position":17,"arabic":"لَكَـٰذِبُونَ","translation":"(are) surely liars","transliteration":"lakādhibūna"}],"e3rab":"(إِذا جاءَكَ) إذا ظرفية شرطية غير جازمة وماض ومفعوله (الْمُنافِقُونَ) فاعله والجملة في محل جر بالإضافة (قالُوا) ماض وفاعله والجملة حال (نَشْهَدُ) مضارع فاعله مستتر والجملة مقول القول (إِنَّكَ) إن واسمها (لَرَسُولُ اللَّهِ) اللام المزحلقة وخبرها المضاف إلى لفظ الجلالة والجملة الاسمية جواب نشهد لا محل لها لأنه جرى مجرى القسم.\r\n\r\n(وَاللَّهُ) الواو واو الاعتراض ولفظ الجلالة مبتدأ (يَعْلَمُ) مضارع فاعله مستتر والجملة الفعلية خبر المبتدأ والجملة الاسمية معترضة لا محل لها.\r\n\r\n(إِنَّكَ لَرَسُولُهُ) إن واسمها واللام المزحلقة (رسوله) خبرها وإن واسمها وخبرها سدت مسد مفعولي يعلم.\r\n\r\n(وَاللَّهُ) مبتدأ (يَشْهَدُ) مضارع فاعله مستتر والجملة الفعلية خبر المبتدأ والجملة الاسمية حال.\r\n\r\n(إِنَّ الْمُنافِقِينَ لَكاذِبُونَ) إن واسمها واللام المزحلقة (كاذبون) خبرها.\r\n\r\n"},{"sura":63,"ayah":2,"words":[{"position":1,"arabic":"ٱتَّخَذُوٓا۟","translation":"They take","transliteration":"ittakhadhū"},{"position":2,"arabic":"أَيْمَـٰنَهُمْ","translation":"their oaths","transliteration":"aymānahum"},{"position":3,"arabic":"جُنَّةًۭ","translation":"(as) a cover","transliteration":"junnatan"},{"position":4,"arabic":"فَصَدُّوا۟","translation":"so they turn away","transliteration":"faṣaddū"},{"position":5,"arabic":"عَن","translation":"from","transliteration":"ʿan"},{"position":6,"arabic":"سَبِيلِ","translation":"(the) Way","transliteration":"sabīli"},{"position":7,"arabic":"ٱللَّهِ ۚ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":8,"arabic":"إِنَّهُمْ","translation":"Indeed, [they]","transliteration":"innahum"},{"position":9,"arabic":"سَآءَ","translation":"evil is","transliteration":"sāa"},{"position":10,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":11,"arabic":"كَانُوا۟","translation":"they used to","transliteration":"kānū"},{"position":12,"arabic":"يَعْمَلُونَ","translation":"do","transliteration":"yaʿmalūna"}],"e3rab":"(اتَّخَذُوا) ماض وفاعله والجملة استئنافية لا محل لها (أَيْمانَهُمْ) مفعول به أول (جُنَّةً) مفعول به ثان.\r\n\r\n(فَصَدُّوا) الفاء حرف عطف (صدوا) ماض وفاعله (عَنْ سَبِيلِ اللَّهِ) متعلقان بالفعل ولفظ الجلالة مضاف إليه والجملة معطوفة على ما قبلها (إِنَّهُمْ) إن واسمها (ساءَ) ماض (ما) فاعله وجملة ساء خبر إن.\r\n\r\n(كانُوا) كان واسمها والجملة صلة ما (يَعْمَلُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر كانوا.\r\n\r\n"},{"sura":63,"ayah":3,"words":[{"position":1,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":2,"arabic":"بِأَنَّهُمْ","translation":"(is) because","transliteration":"bi-annahum"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"they believed","transliteration":"āmanū"},{"position":4,"arabic":"ثُمَّ","translation":"then","transliteration":"thumma"},{"position":5,"arabic":"كَفَرُوا۟","translation":"they disbelieved","transliteration":"kafarū"},{"position":6,"arabic":"فَطُبِعَ","translation":"so were sealed","transliteration":"faṭubiʿa"},{"position":7,"arabic":"عَلَىٰ","translation":"[upon]","transliteration":"ʿalā"},{"position":8,"arabic":"قُلُوبِهِمْ","translation":"their hearts","transliteration":"qulūbihim"},{"position":9,"arabic":"فَهُمْ","translation":"so they","transliteration":"fahum"},{"position":10,"arabic":"لَا","translation":"(do) not","transliteration":"lā"},{"position":11,"arabic":"يَفْقَهُونَ","translation":"understand","transliteration":"yafqahūna"}],"e3rab":"(ذلِكَ بِأَنَّهُمْ) مبتدأ والباء حرف جر وأن واسمها (آمَنُوا) ماض وفاعله وجملة آمنوا خبر أن والمصدر المؤول من أن وما بعدها في محل جر بالباء والجار والمجرور متعلقان بمحذوف خبر المبتدأ وجملة ذلك..\r\n\r\nاستئنافية لا محل لها.\r\n\r\n(ثُمَّ) حرف عطف (كَفَرُوا) ماض وفاعله والجملة معطوفة على ما قبلها.\r\n\r\n(فَطُبِعَ) الفاء حرف عطف وماض مبني للمجهول ونائب الفاعل مستتر (عَلى قُلُوبِهِمْ) متعلقان بالفعل والجملة معطوفة على ما قبلها (فَهُمْ) مبتدأ (لا) نافية (يَفْقَهُونَ) مضارع مرفوع والواو فاعله والجملة خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":63,"ayah":4,"words":[{"position":1,"arabic":"۞ وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"arabic":"رَأَيْتَهُمْ","translation":"you see them","transliteration":"ra-aytahum"},{"position":3,"arabic":"تُعْجِبُكَ","translation":"pleases you","transliteration":"tuʿ'jibuka"},{"position":4,"arabic":"أَجْسَامُهُمْ ۖ","translation":"their bodies","transliteration":"ajsāmuhum"},{"position":5,"arabic":"وَإِن","translation":"and if","transliteration":"wa-in"},{"position":6,"arabic":"يَقُولُوا۟","translation":"they speak","transliteration":"yaqūlū"},{"position":7,"arabic":"تَسْمَعْ","translation":"you listen","transliteration":"tasmaʿ"},{"position":8,"arabic":"لِقَوْلِهِمْ ۖ","translation":"to their speech","transliteration":"liqawlihim"},{"position":9,"arabic":"كَأَنَّهُمْ","translation":"as if they (were)","transliteration":"ka-annahum"},{"position":10,"arabic":"خُشُبٌۭ","translation":"pieces of wood","transliteration":"khushubun"},{"position":11,"arabic":"مُّسَنَّدَةٌۭ ۖ","translation":"propped up","transliteration":"musannadatun"},{"position":12,"arabic":"يَحْسَبُونَ","translation":"They think","transliteration":"yaḥsabūna"},{"position":13,"arabic":"كُلَّ","translation":"every","transliteration":"kulla"},{"position":14,"arabic":"صَيْحَةٍ","translation":"shout","transliteration":"ṣayḥatin"},{"position":15,"arabic":"عَلَيْهِمْ ۚ","translation":"(is) against them","transliteration":"ʿalayhim"},{"position":16,"arabic":"هُمُ","translation":"They","transliteration":"humu"},{"position":17,"arabic":"ٱلْعَدُوُّ","translation":"(are) the enemy","transliteration":"l-ʿaduwu"},{"position":18,"arabic":"فَٱحْذَرْهُمْ ۚ","translation":"so beware of them","transliteration":"fa-iḥ'dharhum"},{"position":19,"arabic":"قَـٰتَلَهُمُ","translation":"May destroy them","transliteration":"qātalahumu"},{"position":20,"arabic":"ٱللَّهُ ۖ","translation":"Allah","transliteration":"l-lahu"},{"position":21,"arabic":"أَنَّىٰ","translation":"How","transliteration":"annā"},{"position":22,"arabic":"يُؤْفَكُونَ","translation":"are they deluded","transliteration":"yu'fakūna"}],"e3rab":"(وَ) الواو حرف استئناف (إِذا) ظرفية شرطية غير جازمة (رَأَيْتَهُمْ) ماض وفاعله ومفعوله والجملة في محل جر بالإضافة (تُعْجِبُكَ) مضارع ومفعوله (أَجْسامُهُمْ) فاعله والجملة جواب الشرط لا محل لها وجملة إذا.. استئنافية لا محل لها.\r\n\r\n(وَإِنْ) الواو حرف عطف (إِنْ يَقُولُوا) إن شرطية جازمة ومضارع مجزوم لأنه فعل الشرط والواو فاعله (تَسْمَعْ) مضارع مجزوم لأنه جواب الشرط والفاعل مستتر (لِقَوْلِهِمْ) متعلقان بالفعل.\r\n\r\n(كَأَنَّهُمْ خُشُبٌ) كأن واسمها وخبرها (مُسَنَّدَةٌ) صفة والجملة استئنافية لا محل لها (يَحْسَبُونَ) مضارع مرفوع والواو فاعله والجملة استئنافية لا محل لها (كُلَّ) مفعول به مضاف إلى صيحة (عَلَيْهِمْ) متعلقان بالفعل (هُمُ الْعَدُوُّ) مبتدأ وخبره والجملة استئنافية لا محل لها (فَاحْذَرْهُمْ) الفاء الفصيحة وأمر ومفعوله والفاعل مستتر والجملة جواب الشرط المقدر لا محل لها (قاتَلَهُمُ اللَّهُ) ماض ومفعوله ولفظ الجلالة فاعله والجملة استئنافية لا محل لها (أَنَّى) اسم استفهام حال (يُؤْفَكُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":63,"ayah":5,"words":[{"position":1,"arabic":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"arabic":"قِيلَ","translation":"it is said","transliteration":"qīla"},{"position":3,"arabic":"لَهُمْ","translation":"to them","transliteration":"lahum"},{"position":4,"arabic":"تَعَالَوْا۟","translation":"Come","transliteration":"taʿālaw"},{"position":5,"arabic":"يَسْتَغْفِرْ","translation":"will ask forgiveness","transliteration":"yastaghfir"},{"position":6,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":7,"arabic":"رَسُولُ","translation":"(the) Messenger","transliteration":"rasūlu"},{"position":8,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":9,"arabic":"لَوَّوْا۟","translation":"They turn aside","transliteration":"lawwaw"},{"position":10,"arabic":"رُءُوسَهُمْ","translation":"their heads","transliteration":"ruūsahum"},{"position":11,"arabic":"وَرَأَيْتَهُمْ","translation":"and you see them","transliteration":"wara-aytahum"},{"position":12,"arabic":"يَصُدُّونَ","translation":"turning away","transliteration":"yaṣuddūna"},{"position":13,"arabic":"وَهُم","translation":"while they","transliteration":"wahum"},{"position":14,"arabic":"مُّسْتَكْبِرُونَ","translation":"(are) arrogant","transliteration":"mus'takbirūna"}],"e3rab":"(وَ) الواو عاطفة (إِذا) ظرفية شرطية غير جازمة (قِيلَ) ماض مبني للمجهول والجملة في محل جر بالإضافة (لَهُمْ) متعلقان بالفعل (تَعالَوْا) أمر مبني على حذف النون والواو فاعله والجملة مقول القول (يَسْتَغْفِرْ) مضارع مجزوم لأنه جواب الطلب (لَكُمْ) متعلقان بالفعل (رَسُولُ اللَّهِ) فاعل مضاف إلى لفظ الجلالة والجملة جواب الطلب لا محل لها.\r\n\r\n(لَوَّوْا) ماض وفاعله (رُؤُسَهُمْ) مفعوله والجملة جواب إذا لا محل لها.\r\n\r\n(وَرَأَيْتَهُمْ) الواو حرف عطف وماض وفاعله ومفعوله والجملة معطوفة على ما قبلها.\r\n\r\n(يَصُدُّونَ) مضارع مرفوع والواو فاعله والجملة حال (وَهُمْ مُسْتَكْبِرُونَ) مبتدأ وخبره والجملة حال.\r\n\r\n"},{"sura":63,"ayah":6,"words":[{"position":1,"arabic":"سَوَآءٌ","translation":"(It) is same","transliteration":"sawāon"},{"position":2,"arabic":"عَلَيْهِمْ","translation":"for them","transliteration":"ʿalayhim"},{"position":3,"arabic":"أَسْتَغْفَرْتَ","translation":"whether you ask forgiveness","transliteration":"astaghfarta"},{"position":4,"arabic":"لَهُمْ","translation":"for them","transliteration":"lahum"},{"position":5,"arabic":"أَمْ","translation":"or","transliteration":"am"},{"position":6,"arabic":"لَمْ","translation":"(do) not","transliteration":"lam"},{"position":7,"arabic":"تَسْتَغْفِرْ","translation":"ask forgiveness","transliteration":"tastaghfir"},{"position":8,"arabic":"لَهُمْ","translation":"for them","transliteration":"lahum"},{"position":9,"arabic":"لَن","translation":"Never","transliteration":"lan"},{"position":10,"arabic":"يَغْفِرَ","translation":"will forgive","transliteration":"yaghfira"},{"position":11,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":12,"arabic":"لَهُمْ ۚ","translation":"[to] them","transliteration":"lahum"},{"position":13,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":14,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":15,"arabic":"لَا","translation":"(does) not","transliteration":"lā"},{"position":16,"arabic":"يَهْدِى","translation":"guide","transliteration":"yahdī"},{"position":17,"arabic":"ٱلْقَوْمَ","translation":"the people","transliteration":"l-qawma"},{"position":18,"arabic":"ٱلْفَـٰسِقِينَ","translation":"the defiantly disobedient","transliteration":"l-fāsiqīna"}],"e3rab":"(سَواءٌ) خبر مقدم (عَلَيْهِمْ) متعلقان بسواء (أَسْتَغْفَرْتَ) الهمزة للتسوية وماض وفاعله و(لَهُمْ) متعلقان بالفعل والمصدر المؤول من الهمزة وما بعدها في محل رفع مبتدأ مؤخر.\r\n\r\n(أَمْ) المعادلة (لَمْ تَسْتَغْفِرْ) مضارع مجزوم بلم فاعله مستتر (لَهُمْ) متعلقان بالفعل والجملة معطوفة على ما قبلها.\r\n\r\nوالجملة الاسمية استئنافية لا محل لها.\r\n\r\n(لَنْ يَغْفِرَ) مضارع منصوب بلن (اللَّهُ) لفظ الجلالة فاعله (لَهُمْ) متعلقان بالفعل والجملة الفعلية استئنافية لا محل لها.\r\n\r\n(إِنَّ اللَّهَ) إن ولفظ الجلالة اسمها (لا يَهْدِي) لا نافية ومضارع فاعله مستتر (الْقَوْمَ) مفعول به (الْفاسِقِينَ) صفة القوم والجملة الفعلية خبر إن والجملة الاسمية استئنافية لا محل لها.\r\n\r\n"},{"sura":63,"ayah":7,"words":[{"position":1,"arabic":"هُمُ","translation":"They","transliteration":"humu"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"(are) those who","transliteration":"alladhīna"},{"position":3,"arabic":"يَقُولُونَ","translation":"say","transliteration":"yaqūlūna"},{"position":4,"arabic":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"arabic":"تُنفِقُوا۟","translation":"spend","transliteration":"tunfiqū"},{"position":6,"arabic":"عَلَىٰ","translation":"on","transliteration":"ʿalā"},{"position":7,"arabic":"مَنْ","translation":"(those) who","transliteration":"man"},{"position":8,"arabic":"عِندَ","translation":"(are) with","transliteration":"ʿinda"},{"position":9,"arabic":"رَسُولِ","translation":"(the) Messenger","transliteration":"rasūli"},{"position":10,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":11,"arabic":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":12,"arabic":"يَنفَضُّوا۟ ۗ","translation":"they disband","transliteration":"yanfaḍḍū"},{"position":13,"arabic":"وَلِلَّهِ","translation":"And for Allah","transliteration":"walillahi"},{"position":14,"arabic":"خَزَآئِنُ","translation":"(are the) treasures","transliteration":"khazāinu"},{"position":15,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"(of) the heavens","transliteration":"l-samāwāti"},{"position":16,"arabic":"وَٱلْأَرْضِ","translation":"and the earth","transliteration":"wal-arḍi"},{"position":17,"arabic":"وَلَـٰكِنَّ","translation":"but","transliteration":"walākinna"},{"position":18,"arabic":"ٱلْمُنَـٰفِقِينَ","translation":"the hypocrites","transliteration":"l-munāfiqīna"},{"position":19,"arabic":"لَا","translation":"(do) not","transliteration":"lā"},{"position":20,"arabic":"يَفْقَهُونَ","translation":"understand","transliteration":"yafqahūna"}],"e3rab":"(هُمُ الَّذِينَ) مبتدأ وخبره والجملة استئنافية لا محل لها.\r\n\r\n(يَقُولُونَ) مضارع مرفوع والواو فاعله والجملة صلة.\r\n\r\n(لا تُنْفِقُوا) مضارع مجزوم بلا الناهية والواو فاعله والجملة مقول القول.\r\n\r\n(عَلى مَنْ) متعلقان بالفعل (عِنْدَ رَسُولِ اللَّهِ) ظرف مكان مضاف إلى رسول ولفظ الجلالة مضاف إليه.\r\n\r\n(حَتَّى) حرف غاية وجر (يَنْفَضُّوا) مضارع منصوب بأن مضمرة بعد حتى والواو فاعله والمصدر المؤول من أن والفعل في محل جر بحتى والجار والمجرور متعلقان بتنفقوا. والواو حالية (وَلِلَّهِ) خبر مقدم (خَزائِنُ) مبتدأ مؤخر والجملة حال (السَّماواتِ) مضاف إليه (وَالْأَرْضِ) معطوف عليها.\r\n\r\n(وَلكِنَّ الْمُنافِقِينَ) لكن واسمها (لا) نافية (يَفْقَهُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر لكن والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":63,"ayah":8,"words":[{"position":1,"arabic":"يَقُولُونَ","translation":"They say","transliteration":"yaqūlūna"},{"position":2,"arabic":"لَئِن","translation":"If","transliteration":"la-in"},{"position":3,"arabic":"رَّجَعْنَآ","translation":"we return","transliteration":"rajaʿnā"},{"position":4,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":5,"arabic":"ٱلْمَدِينَةِ","translation":"Al-Madinah","transliteration":"l-madīnati"},{"position":6,"arabic":"لَيُخْرِجَنَّ","translation":"surely, will expel","transliteration":"layukh'rijanna"},{"position":7,"arabic":"ٱلْأَعَزُّ","translation":"the more honorable","transliteration":"l-aʿazu"},{"position":8,"arabic":"مِنْهَا","translation":"from it","transliteration":"min'hā"},{"position":9,"arabic":"ٱلْأَذَلَّ ۚ","translation":"the more humble","transliteration":"l-adhala"},{"position":10,"arabic":"وَلِلَّهِ","translation":"But for Allah","transliteration":"walillahi"},{"position":11,"arabic":"ٱلْعِزَّةُ","translation":"(is) the honor","transliteration":"l-ʿizatu"},{"position":12,"arabic":"وَلِرَسُولِهِۦ","translation":"and for His Messenger","transliteration":"walirasūlihi"},{"position":13,"arabic":"وَلِلْمُؤْمِنِينَ","translation":"and for the believers","transliteration":"walil'mu'minīna"},{"position":14,"arabic":"وَلَـٰكِنَّ","translation":"but","transliteration":"walākinna"},{"position":15,"arabic":"ٱلْمُنَـٰفِقِينَ","translation":"the hypocrites","transliteration":"l-munāfiqīna"},{"position":16,"arabic":"لَا","translation":"(do) not","transliteration":"lā"},{"position":17,"arabic":"يَعْلَمُونَ","translation":"know","transliteration":"yaʿlamūna"}],"e3rab":"(يَقُولُونَ) مضارع مرفوع بثبوت النون والواو فاعله والجملة معطوفة على ما قبلها في المعنى (لَئِنْ) اللام موطئة للقسم المحذوف (إن) شرطية جازمة (رَجَعْنا) ماض في محل جزم فعل الشرط ونا فاعله والجملة ابتدائية لا محل لها (إِلَى الْمَدِينَةِ) متعلقان بالفعل (لَيُخْرِجَنَّ) اللام واقعة في جواب القسم ومضارع مبني على الفتح لاتصاله بنون التوكيد الثقيلة (الْأَعَزُّ) فاعل (مِنْهَا) متعلقان بالفعل (الْأَذَلَّ) مفعول به والجملة جواب القسم لا محل لها.\r\n\r\n(وَ) الواو حالية (لِلَّهِ) خبر مقدم (الْعِزَّةُ) مبتدأ مؤخر والجملة حال (وَلِرَسُولِهِ) معطوف على للّه (وَلِلْمُؤْمِنِينَ) معطوف على للّه.\r\n\r\n(وَلكِنَّ الْمُنافِقِينَ) لكن واسمها (لا) نافية (يَعْلَمُونَ) مضارع وفاعله والجملة الفعلية خبر لكن والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":63,"ayah":9,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"you (who)","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"لَا","translation":"(Let) not","transliteration":"lā"},{"position":5,"arabic":"تُلْهِكُمْ","translation":"divert you","transliteration":"tul'hikum"},{"position":6,"arabic":"أَمْوَٰلُكُمْ","translation":"your wealth","transliteration":"amwālukum"},{"position":7,"arabic":"وَلَآ","translation":"and not","transliteration":"walā"},{"position":8,"arabic":"أَوْلَـٰدُكُمْ","translation":"your children","transliteration":"awlādukum"},{"position":9,"arabic":"عَن","translation":"from","transliteration":"ʿan"},{"position":10,"arabic":"ذِكْرِ","translation":"(the) remembrance","transliteration":"dhik'ri"},{"position":11,"arabic":"ٱللَّهِ ۚ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":12,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":13,"arabic":"يَفْعَلْ","translation":"does","transliteration":"yafʿal"},{"position":14,"arabic":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":15,"arabic":"فَأُو۟لَـٰٓئِكَ","translation":"then those","transliteration":"fa-ulāika"},{"position":16,"arabic":"هُمُ","translation":"[they]","transliteration":"humu"},{"position":17,"arabic":"ٱلْخَـٰسِرُونَ","translation":"(are) the losers","transliteration":"l-khāsirūna"}],"e3rab":"(يا أَيُّهَا الَّذِينَ) منادى نكرة مقصودة وها للتنبيه (الَّذِينَ) بدل والجملة ابتدائية لا محل لها (آمَنُوا) ماض وفاعله والجملة صلة الذين (لا تُلْهِكُمْ) مضارع مجزوم بلا الناهية والكاف مفعول به (أَمْوالُكُمْ) فاعل (وَلا أَوْلادُكُمْ) معطوف على ما قبله والجملة ابتدائية أيضا لا محل لها.\r\n\r\n(عَنْ ذِكْرِ اللَّهِ) متعلقان بالفعل ولفظ الجلالة مضاف إليه.\r\n\r\n(وَ) الواو حرف استئناف (مَنْ يَفْعَلْ) من اسم شرط جازم مبتدأ ومضارع مجزوم لأنه فعل الشرط (ذلِكَ) مفعول به (فَأُولئِكَ) الفاء واقعة في جواب الشرط (أولئك) مبتدأ (هُمُ) ضمير فصل (الْخاسِرُونَ) خبر أولئك والجملة الاسمية في محل جزم جواب الشرط وجملتا الشرط والجواب خبر من. وجملة من يفعل.. استئنافية لا محل لها.\r\n\r\n"},{"sura":63,"ayah":10,"words":[{"position":1,"arabic":"وَأَنفِقُوا۟","translation":"And spend","transliteration":"wa-anfiqū"},{"position":2,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":3,"arabic":"مَّا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"رَزَقْنَـٰكُم","translation":"We have provided you","transliteration":"razaqnākum"},{"position":5,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":6,"arabic":"قَبْلِ","translation":"before","transliteration":"qabli"},{"position":7,"arabic":"أَن","translation":"[that]","transliteration":"an"},{"position":8,"arabic":"يَأْتِىَ","translation":"comes","transliteration":"yatiya"},{"position":9,"arabic":"أَحَدَكُمُ","translation":"(to) one of you","transliteration":"aḥadakumu"},{"position":10,"arabic":"ٱلْمَوْتُ","translation":"the death","transliteration":"l-mawtu"},{"position":11,"arabic":"فَيَقُولَ","translation":"and he says","transliteration":"fayaqūla"},{"position":12,"arabic":"رَبِّ","translation":"My Lord","transliteration":"rabbi"},{"position":13,"arabic":"لَوْلَآ","translation":"Why not","transliteration":"lawlā"},{"position":14,"arabic":"أَخَّرْتَنِىٓ","translation":"You delay me","transliteration":"akhartanī"},{"position":15,"arabic":"إِلَىٰٓ","translation":"for","transliteration":"ilā"},{"position":16,"arabic":"أَجَلٍۢ","translation":"a term","transliteration":"ajalin"},{"position":17,"arabic":"قَرِيبٍۢ","translation":"near","transliteration":"qarībin"},{"position":18,"arabic":"فَأَصَّدَّقَ","translation":"so I would give charity","transliteration":"fa-aṣṣaddaqa"},{"position":19,"arabic":"وَأَكُن","translation":"and be","transliteration":"wa-akun"},{"position":20,"arabic":"مِّنَ","translation":"among","transliteration":"mina"},{"position":21,"arabic":"ٱلصَّـٰلِحِينَ","translation":"the righteous","transliteration":"l-ṣāliḥīna"}],"e3rab":"(وَأَنْفِقُوا) أمر وفاعله والجملة معطوفة على ما قبلها (مِنْ ما) متعلقان بالفعل (رَزَقْناكُمْ) ماض وفاعله ومفعوله والجملة صلة ما (مِنْ قَبْلِ) متعلقان بأنفقوا (أَنْ يَأْتِيَ) مضارع منصوب بأن (أَحَدَكُمُ) مفعول به (الْمَوْتُ) فاعل والمصدر المؤول من أن وما بعدها في محل جر بالإضافة (فَيَقُولَ) الفاء حرف عطف ومضارع معطوف على يأتي منصوب مثله وفاعله مستتر (رَبِّ) منادى مضاف (لَوْ لا) حرف تحضيض بمعنى هلا (أَخَّرْتَنِي) ماض وفاعله ومفعوله (إِلى أَجَلٍ) متعلقان بالفعل (قَرِيبٍ) صفة أجل والجملة الفعلية مقول القول.\r\n\r\n(فَأَصَّدَّقَ) الفاء للسببية ومضارع منصوب بأن مضمرة بعد الفاء والفاعل مستتر والمصدر المؤول من أن والفعل معطوف بالفاء على مصدر مؤول سابق (وَأَكُنْ) الواو حرف عطف ومضارع ناقص مجزوم بعطفه على محل فأصدق واسمه مستتر (مِنَ الصَّالِحِينَ) خبره.\r\n\r\n"},{"sura":63,"ayah":11,"words":[{"position":1,"arabic":"وَلَن","translation":"But never","transliteration":"walan"},{"position":2,"arabic":"يُؤَخِّرَ","translation":"will (be) delayed","transliteration":"yu-akhira"},{"position":3,"arabic":"ٱللَّهُ","translation":"(by) Allah","transliteration":"l-lahu"},{"position":4,"arabic":"نَفْسًا","translation":"a soul","transliteration":"nafsan"},{"position":5,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":6,"arabic":"جَآءَ","translation":"has come","transliteration":"jāa"},{"position":7,"arabic":"أَجَلُهَا ۚ","translation":"its term","transliteration":"ajaluhā"},{"position":8,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":9,"arabic":"خَبِيرٌۢ","translation":"(is) All-Aware","transliteration":"khabīrun"},{"position":10,"arabic":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":11,"arabic":"تَعْمَلُونَ","translation":"you do","transliteration":"taʿmalūna"}],"e3rab":"(وَلَنْ يُؤَخِّرَ) الواو حرف استئناف ومضارع منصوب بلن (اللَّهُ) لفظ الجلالة فاعل (نَفْساً) مفعول به والجملة استئنافية لا محل لها (إِذا جاءَ أَجَلُها) ظرف زمان وماض وفاعله والجملة في محل جر بالإضافة (وَاللَّهُ خَبِيرٌ) مبتدأ وخبره والجملة حال (بِما) متعلقان بخبير (تَعْمَلُونَ) مضارع وفاعله والجملة صلة.\r\n\r\n"}]