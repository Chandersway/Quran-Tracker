[{"sura":103,"ayah":1,"words":[{"position":1,"arabic":"وَٱلْعَصْرِ","translation":"By the time","transliteration":"wal-ʿaṣri"}],"e3rab":"«وَالْعَصْرِ» جار ومجرور متعلقان بفعل قسم محذوف\r\n\r\n"},{"sura":103,"ayah":2,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلْإِنسَـٰنَ","translation":"mankind","transliteration":"l-insāna"},{"position":3,"arabic":"لَفِى","translation":"(is) surely, in","transliteration":"lafī"},{"position":4,"arabic":"خُسْرٍ","translation":"loss","transliteration":"khus'rin"}],"e3rab":"(إِنَّ الْإِنْسانَ) إن واسمها (لَفِي) اللام المزحلقة (في خُسْرٍ) جار ومجرور خبر إن والجملة الاسمية جواب القسم لا محل لها.\r\n\r\n"},{"sura":103,"ayah":3,"words":[{"position":1,"arabic":"إِلَّا","translation":"Except","transliteration":"illā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"وَعَمِلُوا۟","translation":"and do","transliteration":"waʿamilū"},{"position":5,"arabic":"ٱلصَّـٰلِحَـٰتِ","translation":"righteous deeds","transliteration":"l-ṣāliḥāti"},{"position":6,"arabic":"وَتَوَاصَوْا۟","translation":"and enjoin (each other)","transliteration":"watawāṣaw"},{"position":7,"arabic":"بِٱلْحَقِّ","translation":"to the truth","transliteration":"bil-ḥaqi"},{"position":8,"arabic":"وَتَوَاصَوْا۟","translation":"and enjoin (each other)","transliteration":"watawāṣaw"},{"position":9,"arabic":"بِٱلصَّبْرِ","translation":"to [the] patience","transliteration":"bil-ṣabri"}],"e3rab":"(إِلَّا) حرف استثناء (الَّذِينَ) في محل نصب على الاستثناء من الإنسان (آمَنُوا) ماض وفاعله والجملة صلة (وَعَمِلُوا) معطوف على آمنوا (الصَّالِحاتِ) مفعول به (وَتَواصَوْا) معطوف على آمنوا (بِالْحَقِّ) متعلقان بالفعل (وَتَواصَوْا بِالصَّبْرِ) معطوفة على ما قبلها.\r\n\r\n"}]