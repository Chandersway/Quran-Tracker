[{"sura":113,"ayah":1,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"أَعُوذُ","translation":"I seek refuge","transliteration":"aʿūdhu"},{"position":3,"arabic":"بِرَبِّ","translation":"in (the) Lord","transliteration":"birabbi"},{"position":4,"arabic":"ٱلْفَلَقِ","translation":"(of) the dawn","transliteration":"l-falaqi"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة ابتدائية لا محل لها.\r\n\r\n(أَعُوذُ) مضارع فاعله مستتر (بِرَبِّ) متعلقان بالفعل (الْفَلَقِ) مضاف إليه والجملة مقول القول.\r\n\r\n"},{"sura":113,"ayah":2,"words":[{"position":1,"arabic":"مِن","translation":"From","transliteration":"min"},{"position":2,"arabic":"شَرِّ","translation":"(the) evil","transliteration":"sharri"},{"position":3,"arabic":"مَا","translation":"(of) what","transliteration":"mā"},{"position":4,"arabic":"خَلَقَ","translation":"He created","transliteration":"khalaqa"}],"e3rab":"(مِنْ شَرِّ) الجار والمجرور متعلقان بأعوذ (ما) اسم موصول مضاف إليه (خَلَقَ) ماض فاعله مستتر والجملة صلة.\r\n\r\n"},{"sura":113,"ayah":3,"words":[{"position":1,"arabic":"وَمِن","translation":"And from","transliteration":"wamin"},{"position":2,"arabic":"شَرِّ","translation":"(the) evil","transliteration":"sharri"},{"position":3,"arabic":"غَاسِقٍ","translation":"(of) darkness","transliteration":"ghāsiqin"},{"position":4,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":5,"arabic":"وَقَبَ","translation":"it spreads","transliteration":"waqaba"}],"e3rab":"(وَمِنْ شَرِّ) معطوفان على ما قبلهما (غاسِقٍ) مضاف إليه (إِذا) ظرف زمان (وَقَبَ) ماض فاعله مستتر والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":113,"ayah":4,"words":[{"position":1,"arabic":"وَمِن","translation":"And from","transliteration":"wamin"},{"position":2,"arabic":"شَرِّ","translation":"(the) evil","transliteration":"sharri"},{"position":3,"arabic":"ٱلنَّفَّـٰثَـٰتِ","translation":"(of) the blowers","transliteration":"l-nafāthāti"},{"position":4,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":5,"arabic":"ٱلْعُقَدِ","translation":"the knots","transliteration":"l-ʿuqadi"}],"e3rab":"(وَمِنْ شَرِّ النَّفَّاثاتِ) معطوف على ما قبله (فِي الْعُقَدِ) متعلقان بما قبلهما.\r\n\r\n"},{"sura":113,"ayah":5,"words":[{"position":1,"arabic":"وَمِن","translation":"And from","transliteration":"wamin"},{"position":2,"arabic":"شَرِّ","translation":"(the) evil","transliteration":"sharri"},{"position":3,"arabic":"حَاسِدٍ","translation":"(of) an envier","transliteration":"ḥāsidin"},{"position":4,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":5,"arabic":"حَسَدَ","translation":"he envies","transliteration":"ḥasada"}],"e3rab":"(وَمِنْ شَرِّ حاسِدٍ) معطوف على ما قبله (إِذا) ظرف زمان (حَسَدَ) ماض فاعله مستتر والجملة في محل جر بالإضافة.\r\n\r\n"}]