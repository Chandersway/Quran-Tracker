[{"sura":96,"ayah":1,"words":[{"position":1,"arabic":"ٱقْرَأْ","translation":"Read","transliteration":"iq'ra"},{"position":2,"arabic":"بِٱسْمِ","translation":"in (the) name","transliteration":"bi-is'mi"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"ٱلَّذِى","translation":"the One Who","transliteration":"alladhī"},{"position":5,"arabic":"خَلَقَ","translation":"created ","transliteration":"khalaqa"}],"e3rab":"(اقْرَأْ) أمر فاعله مستتر (بِاسْمِ) الباء زائدة (اسم) مفعول به (رَبِّكَ) مضاف إليه (الَّذِي) صفة ربك (خَلَقَ) ماض فاعله مستتر والجملة صلة وجملة اقرأ.. ابتدائية لا محل لها.\r\n\r\n"},{"sura":96,"ayah":2,"words":[{"position":1,"arabic":"خَلَقَ","translation":"He created","transliteration":"khalaqa"},{"position":2,"arabic":"ٱلْإِنسَـٰنَ","translation":"man","transliteration":"l-insāna"},{"position":3,"arabic":"مِنْ","translation":"from","transliteration":"min"},{"position":4,"arabic":"عَلَقٍ","translation":"a clinging substance","transliteration":"ʿalaqin"}],"e3rab":"(خَلَقَ) بدل من سابقه فاعله مستتر (الْإِنْسانَ) مفعول به (مِنْ عَلَقٍ) متعلقان بالفعل.\r\n\r\n"},{"sura":96,"ayah":3,"words":[{"position":1,"arabic":"ٱقْرَأْ","translation":"Read","transliteration":"iq'ra"},{"position":2,"arabic":"وَرَبُّكَ","translation":"and your Lord","transliteration":"warabbuka"},{"position":3,"arabic":"ٱلْأَكْرَمُ","translation":"(is) the Most Generous","transliteration":"l-akramu"}],"e3rab":"(اقْرَأْ) أمر فاعله مستتر والجملة مؤكدة لسابقتها (وَ) الواو حالية (وَرَبُّكَ الْأَكْرَمُ) مبتدأ وخبره والجملة حال.\r\n\r\n"},{"sura":96,"ayah":4,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"The One Who","transliteration":"alladhī"},{"position":2,"arabic":"عَلَّمَ","translation":"taught","transliteration":"ʿallama"},{"position":3,"arabic":"بِٱلْقَلَمِ","translation":"by the pen","transliteration":"bil-qalami"}],"e3rab":"(الَّذِي) صفة ثانية لربك (عَلَّمَ) ماض والفاعل مستتر (بِالْقَلَمِ) متعلقان بالفعل والجملة الفعلية صلة.\r\n\r\n"},{"sura":96,"ayah":5,"words":[{"position":1,"arabic":"عَلَّمَ","translation":"Taught","transliteration":"ʿallama"},{"position":2,"arabic":"ٱلْإِنسَـٰنَ","translation":"man","transliteration":"l-insāna"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"لَمْ","translation":"not","transliteration":"lam"},{"position":5,"arabic":"يَعْلَمْ","translation":"he knew","transliteration":"yaʿlam"}],"e3rab":"(عَلَّمَ) ماض فاعله مستتر وهو بدل من سابقه (الْإِنْسانَ) مفعول به أول (ما) مفعول به ثان (لَمْ يَعْلَمْ) مضارع مجزوم بلم والجملة صلة ما.\r\n\r\n"},{"sura":96,"ayah":6,"words":[{"position":1,"arabic":"كَلَّآ","translation":"Nay","transliteration":"kallā"},{"position":2,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":3,"arabic":"ٱلْإِنسَـٰنَ","translation":"man","transliteration":"l-insāna"},{"position":4,"arabic":"لَيَطْغَىٰٓ","translation":"surely transgresses","transliteration":"layaṭghā"}],"e3rab":"(كَلَّا) حرف ردع وزجر (إِنَّ الْإِنْسانَ) إن واسمها (لَيَطْغى) اللام المزحلقة ومضارع فاعله مستتر والجملة الفعلية خبر إن والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"},{"sura":96,"ayah":7,"words":[{"position":1,"arabic":"أَن","translation":"That","transliteration":"an"},{"position":2,"arabic":"رَّءَاهُ","translation":"he sees himself","transliteration":"raāhu"},{"position":3,"arabic":"ٱسْتَغْنَىٰٓ","translation":"self-sufficient","transliteration":"is'taghnā"}],"e3rab":"(أَنْ رَآهُ) أن حرف مصدري ونصب وماض ومفعوله الأول والفاعل مستتر والمصدر المؤول من أن والفعل في محل نصب مفعول لأجله (اسْتَغْنى) ماض فاعله مستتر والجملة مفعول به ثان.\r\n\r\n"},{"sura":96,"ayah":8,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":3,"arabic":"رَبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":4,"arabic":"ٱلرُّجْعَىٰٓ","translation":"(is) the return","transliteration":"l-ruj'ʿā"}],"e3rab":"(إِنَّ) حرف مشبه بالفعل (إِلى رَبِّكَ) خبر إن المقدم (الرُّجْعى) اسمها المؤخر والجملة مستأنفة.\r\n\r\n"},{"sura":96,"ayah":9,"words":[{"position":1,"arabic":"أَرَءَيْتَ","translation":"Have you seen","transliteration":"ara-ayta"},{"position":2,"arabic":"ٱلَّذِى","translation":"the one who","transliteration":"alladhī"},{"position":3,"arabic":"يَنْهَىٰ","translation":"forbids","transliteration":"yanhā"}],"e3rab":"(أَرَأَيْتَ) الهمزة حرف استفهام وماض وفاعله (الَّذِي) مفعول به (يَنْهى) مضارع فاعله مستتر والجملة صلة.\r\n\r\n"},{"sura":96,"ayah":10,"words":[{"position":1,"arabic":"عَبْدًا","translation":"A slave","transliteration":"ʿabdan"},{"position":2,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"arabic":"صَلَّىٰٓ","translation":"he prays","transliteration":"ṣallā"}],"e3rab":"(عَبْداً) مفعول به (إِذا) ظرف زمان (صَلَّى) ماض فاعله مستتر والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":96,"ayah":11,"words":[{"position":1,"arabic":"أَرَءَيْتَ","translation":"Have you seen","transliteration":"ara-ayta"},{"position":2,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":3,"arabic":"كَانَ","translation":"he is","transliteration":"kāna"},{"position":4,"arabic":"عَلَى","translation":"upon","transliteration":"ʿalā"},{"position":5,"arabic":"ٱلْهُدَىٰٓ","translation":"[the] guidance","transliteration":"l-hudā"}],"e3rab":"(أَرَأَيْتَ) الهمزة حرف استفهام وماض وفاعله (إِنْ) حرف شرط جازم (كانَ) ماض ناقص في محل جزم فعل الشرط واسمه مستتر (عَلَى الْهُدى) متعلقان بمحذوف خبر كان والجملة ابتدائية لا محل لها.\r\n\r\n"},{"sura":96,"ayah":12,"words":[{"position":1,"arabic":"أَوْ","translation":"Or","transliteration":"aw"},{"position":2,"arabic":"أَمَرَ","translation":"he enjoins","transliteration":"amara"},{"position":3,"arabic":"بِٱلتَّقْوَىٰٓ","translation":"[of the] righteousness","transliteration":"bil-taqwā"}],"e3rab":"(أَوْ) حرف عطف (أَمَرَ) ماض فاعله مستتر (بِالتَّقْوى) متعلقان بالفعل والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":96,"ayah":13,"words":[{"position":1,"arabic":"أَرَءَيْتَ","translation":"Have you seen","transliteration":"ara-ayta"},{"position":2,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":3,"arabic":"كَذَّبَ","translation":"he denies","transliteration":"kadhaba"},{"position":4,"arabic":"وَتَوَلَّىٰٓ","translation":"and turns away","transliteration":"watawallā"}],"e3rab":"(أَرَأَيْتَ) الهمزة حرف استفهام وماض وفاعله (إِنْ) حرف شرط جازم (كَذَّبَ) ماض فاعله مستتر (وَتَوَلَّى) معطوف على كذب والجملة ابتدائية لا محل لها.\r\n\r\n"},{"sura":96,"ayah":14,"words":[{"position":1,"arabic":"أَلَمْ","translation":"Does not","transliteration":"alam"},{"position":2,"arabic":"يَعْلَم","translation":"he know","transliteration":"yaʿlam"},{"position":3,"arabic":"بِأَنَّ","translation":"that","transliteration":"bi-anna"},{"position":4,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":5,"arabic":"يَرَىٰ","translation":"sees","transliteration":"yarā"}],"e3rab":"(أَلَمْ يَعْلَمْ) ألم الهمزة حرف استفهام وتقرير ومضارع مجزوم بلم (بِأَنَّ اللَّهَ) الباء حرف جر زائد وأن واسمها (يَرى) مضارع فاعله مستتر والجملة خبر أن والمصدر المؤول من أن وما بعدها سد مسد مفعولي يعلم.\r\n\r\n"},{"sura":96,"ayah":15,"words":[{"position":1,"arabic":"كَلَّا","translation":"Nay","transliteration":"kallā"},{"position":2,"arabic":"لَئِن","translation":"If","transliteration":"la-in"},{"position":3,"arabic":"لَّمْ","translation":"not","transliteration":"lam"},{"position":4,"arabic":"يَنتَهِ","translation":"he desists","transliteration":"yantahi"},{"position":5,"arabic":"لَنَسْفَعًۢا","translation":"surely We will drag him","transliteration":"lanasfaʿan"},{"position":6,"arabic":"بِٱلنَّاصِيَةِ","translation":"by the forelock","transliteration":"bil-nāṣiyati"}],"e3rab":"(كَلَّا) حرف ردع وزجر (لَئِنْ) اللام، موطئة للقسم وإن حرف شرط جازم (لَمْ يَنْتَهِ) مضارع مجزوم بلم وعلامة جزمه حذف حرف العلة (لَنَسْفَعاً) اللام واقعة في جواب القسم ومضارع مبني على الفتح لاتصاله بنون التوكيد الخفيفة والفاعل مستتر (بِالنَّاصِيَةِ) متعلقان بالفعل والجملة جواب القسم لا محل لها وجملة لم ينته ابتدائية لا محل لها.\r\n\r\n"},{"sura":96,"ayah":16,"words":[{"position":1,"arabic":"نَاصِيَةٍۢ","translation":"A forelock","transliteration":"nāṣiyatin"},{"position":2,"arabic":"كَـٰذِبَةٍ","translation":"lying","transliteration":"kādhibatin"},{"position":3,"arabic":"خَاطِئَةٍۢ","translation":"sinful","transliteration":"khāṭi-atin"}],"e3rab":"(ناصِيَةٍ) بدل من الناصية (كاذِبَةٍ خاطِئَةٍ) صفتان.\r\n\r\n"},{"sura":96,"ayah":17,"words":[{"position":1,"arabic":"فَلْيَدْعُ","translation":"Then let him call","transliteration":"falyadʿu"},{"position":2,"arabic":"نَادِيَهُۥ","translation":"his associates","transliteration":"nādiyahu"}],"e3rab":"(فَلْيَدْعُ) الفاء الفصيحة ومضارع مجزوم بلام الأمر وعلامة جزمه حذف حرف العلة والفاعل مستتر (نادِيَهُ) مفعول به والجملة جواب شرط غير جازم لا محل لها.\r\n\r\n"},{"sura":96,"ayah":18,"words":[{"position":1,"arabic":"سَنَدْعُ","translation":"We will call","transliteration":"sanadʿu"},{"position":2,"arabic":"ٱلزَّبَانِيَةَ","translation":"the Angels of Hell","transliteration":"l-zabāniyata"}],"e3rab":"(سَنَدْعُ) السين للاستقبال ومضارع مرفوع بضمة مقدرة على الواو المحذوفة قراءة والفاعل مستتر (الزَّبانِيَةَ) مفعول به. والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":96,"ayah":19,"words":[{"position":1,"arabic":"كَلَّا","translation":"Nay","transliteration":"kallā"},{"position":2,"arabic":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":3,"arabic":"تُطِعْهُ","translation":"obey him","transliteration":"tuṭiʿ'hu"},{"position":4,"arabic":"وَٱسْجُدْ","translation":"But prostrate","transliteration":"wa-us'jud"},{"position":5,"arabic":"وَٱقْتَرِب ۩","translation":"and draw near (to Allah)","transliteration":"wa-iq'tarib"}],"e3rab":"(كَلَّا) حرف ردع وزجر (لا تُطِعْهُ) مضارع مجزوم بلا الناهية والهاء مفعوله والفاعل مستتر والجملة الفعلية مستأنفة (وَاسْجُدْ) فعل أمر فاعله مستتر والجملة معطوفة على ما قبلها (وَاقْتَرِبْ) معطوف على اسجد.\r\n\r\n"}]