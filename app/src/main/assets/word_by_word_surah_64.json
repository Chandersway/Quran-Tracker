[{"sura":64,"ayah":1,"words":[{"position":1,"arabic":"يُسَبِّحُ","translation":"Glorifies","transliteration":"yusabbiḥu"},{"position":2,"arabic":"لِلَّهِ","translation":"[to] Allah","transliteration":"lillahi"},{"position":3,"arabic":"مَا","translation":"whatever","transliteration":"mā"},{"position":4,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":5,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":6,"arabic":"وَمَا","translation":"and whatever","transliteration":"wamā"},{"position":7,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":8,"arabic":"ٱلْأَرْضِ ۖ","translation":"the earth","transliteration":"l-arḍi"},{"position":9,"arabic":"لَهُ","translation":"For Him","transliteration":"lahu"},{"position":10,"arabic":"ٱلْمُلْكُ","translation":"(is the) dominion","transliteration":"l-mul'ku"},{"position":11,"arabic":"وَلَهُ","translation":"and for Him","transliteration":"walahu"},{"position":12,"arabic":"ٱلْحَمْدُ ۖ","translation":"(is) the praise","transliteration":"l-ḥamdu"},{"position":13,"arabic":"وَهُوَ","translation":"And He","transliteration":"wahuwa"},{"position":14,"arabic":"عَلَىٰ","translation":"(is) on","transliteration":"ʿalā"},{"position":15,"arabic":"كُلِّ","translation":"every","transliteration":"kulli"},{"position":16,"arabic":"شَىْءٍۢ","translation":"thing","transliteration":"shayin"},{"position":17,"arabic":"قَدِيرٌ","translation":"All-Powerful","transliteration":"qadīrun"}],"e3rab":"(يُسَبِّحُ) مضارع (لِلَّهِ) متعلقان به والجملة ابتدائية لا محل لها (ما) فاعل (فِي السَّماواتِ) متعلقان بمحذوف صلة الموصول (وَما فِي الْأَرْضِ) معطوف على ما قبله.\r\n\r\n(وَلَهُ) خبر مقدم (الْمُلْكُ) مبتدأ مؤخر والجملة الاسمية حال.\r\n\r\n(وَلَهُ الْحَمْدُ) معطوف على له الملك (وَهُوَ) مبتدأ (عَلى كُلِّ) متعلقان بقدير (شَيْءٍ) مضاف إليه (قَدِيرٌ) خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":64,"ayah":2,"words":[{"position":1,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":2,"arabic":"ٱلَّذِى","translation":"(is) the One Who","transliteration":"alladhī"},{"position":3,"arabic":"خَلَقَكُمْ","translation":"created you","transliteration":"khalaqakum"},{"position":4,"arabic":"فَمِنكُمْ","translation":"and among you","transliteration":"faminkum"},{"position":5,"arabic":"كَافِرٌۭ","translation":"(is) a disbeliever","transliteration":"kāfirun"},{"position":6,"arabic":"وَمِنكُم","translation":"and among you","transliteration":"waminkum"},{"position":7,"arabic":"مُّؤْمِنٌۭ ۚ","translation":"(is) a believer","transliteration":"mu'minun"},{"position":8,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":9,"arabic":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":10,"arabic":"تَعْمَلُونَ","translation":"you do","transliteration":"taʿmalūna"},{"position":11,"arabic":"بَصِيرٌ","translation":"(is) All-Seer","transliteration":"baṣīrun"}],"e3rab":"(هُوَ الَّذِي) مبتدأ وخبره والجملة استئنافية لا محل لها (خَلَقَكُمْ) ماض ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها (فَمِنْكُمْ) الفاء استئنافية وخبر مقدم (كافِرٌ) مبتدأ مؤخر (وَمِنْكُمْ مُؤْمِنٌ) معطوف على منكم كافر (وَاللَّهُ) لفظ الجلالة مبتدأ (بِما) متعلقان ببصير (بَصِيرٌ) خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":64,"ayah":3,"words":[{"position":1,"arabic":"خَلَقَ","translation":"He created","transliteration":"khalaqa"},{"position":2,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":3,"arabic":"وَٱلْأَرْضَ","translation":"and the earth","transliteration":"wal-arḍa"},{"position":4,"arabic":"بِٱلْحَقِّ","translation":"with truth","transliteration":"bil-ḥaqi"},{"position":5,"arabic":"وَصَوَّرَكُمْ","translation":"and He formed you","transliteration":"waṣawwarakum"},{"position":6,"arabic":"فَأَحْسَنَ","translation":"and made good","transliteration":"fa-aḥsana"},{"position":7,"arabic":"صُوَرَكُمْ ۖ","translation":"your forms","transliteration":"ṣuwarakum"},{"position":8,"arabic":"وَإِلَيْهِ","translation":"and to Him","transliteration":"wa-ilayhi"},{"position":9,"arabic":"ٱلْمَصِيرُ","translation":"(is) the final return","transliteration":"l-maṣīru"}],"e3rab":"(خَلَقَ) ماض فاعله مستتر (السَّماواتِ) مفعول به (وَالْأَرْضَ) معطوف على السموات (بِالْحَقِّ) حال والجملة استئنافية لا محل لها.\r\n\r\n(وَصَوَّرَكُمْ) ماض ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها.\r\n\r\n(فَأَحْسَنَ صُوَرَكُمْ) معطوف على صوركم.\r\n\r\n(وَإِلَيْهِ) خبر مقدم (الْمَصِيرُ) مبتدأ مؤخر والجملة حال.\r\n\r\n"},{"sura":64,"ayah":4,"words":[{"position":1,"arabic":"يَعْلَمُ","translation":"He knows","transliteration":"yaʿlamu"},{"position":2,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":3,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":4,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":5,"arabic":"وَٱلْأَرْضِ","translation":"and the earth","transliteration":"wal-arḍi"},{"position":6,"arabic":"وَيَعْلَمُ","translation":"and He knows","transliteration":"wayaʿlamu"},{"position":7,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":8,"arabic":"تُسِرُّونَ","translation":"you conceal","transliteration":"tusirrūna"},{"position":9,"arabic":"وَمَا","translation":"and what","transliteration":"wamā"},{"position":10,"arabic":"تُعْلِنُونَ ۚ","translation":"you declare","transliteration":"tuʿ'linūna"},{"position":11,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":12,"arabic":"عَلِيمٌۢ","translation":"(is) All-Knowing","transliteration":"ʿalīmun"},{"position":13,"arabic":"بِذَاتِ","translation":"of what","transliteration":"bidhāti"},{"position":14,"arabic":"ٱلصُّدُورِ","translation":"(is in) the breasts","transliteration":"l-ṣudūri"}],"e3rab":"(يَعْلَمُ) مضارع فاعله مستتر والجملة استئنافية لا محل لها (ما) مفعول به (فِي السَّماواتِ) متعلقان بمحذوف صلة الموصول (وَالْأَرْضِ) معطوف على السموات.\r\n\r\n(وَيَعْلَمُ ما تُسِرُّونَ وَما تُعْلِنُونَ) معطوف على ما قبله.\r\n\r\n(وَاللَّهُ عَلِيمٌ) مبتدأ وخبره والجملة استئنافية لا محل لها (بِذاتِ) متعلقان بعليم (الصُّدُورِ) مضاف إليه.\r\n\r\n"},{"sura":64,"ayah":5,"words":[{"position":1,"arabic":"أَلَمْ","translation":"Has not","transliteration":"alam"},{"position":2,"arabic":"يَأْتِكُمْ","translation":"come to you","transliteration":"yatikum"},{"position":3,"arabic":"نَبَؤُا۟","translation":"(the) news","transliteration":"naba-u"},{"position":4,"arabic":"ٱلَّذِينَ","translation":"(of) those who","transliteration":"alladhīna"},{"position":5,"arabic":"كَفَرُوا۟","translation":"disbelieved","transliteration":"kafarū"},{"position":6,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":7,"arabic":"قَبْلُ","translation":"before","transliteration":"qablu"},{"position":8,"arabic":"فَذَاقُوا۟","translation":"So they tasted","transliteration":"fadhāqū"},{"position":9,"arabic":"وَبَالَ","translation":"(the bad) consequence","transliteration":"wabāla"},{"position":10,"arabic":"أَمْرِهِمْ","translation":"(of) their affair","transliteration":"amrihim"},{"position":11,"arabic":"وَلَهُمْ","translation":"and for them","transliteration":"walahum"},{"position":12,"arabic":"عَذَابٌ","translation":"(is) a punishment","transliteration":"ʿadhābun"},{"position":13,"arabic":"أَلِيمٌۭ","translation":"painful","transliteration":"alīmun"}],"e3rab":"(أَلَمْ يَأْتِكُمْ) الهمزة للاستفهام الإنكاري التوبيخي ومضارع مجزوم بلم والكاف مفعوله (نَبَأُ الَّذِينَ) فاعله المضاف إلى اسم الموصول (كَفَرُوا) ماض وفاعله والجملة صلة (مِنْ قَبْلُ) متعلقان بمحذوف حال.\r\n\r\n(فَذاقُوا) ماض وفاعله والجملة معطوفة على ما قبلها (وَبالَ) مفعول به (أَمْرِهِمْ) مضاف إليه (وَلَهُمْ) خبر مقدم (عَذابٌ) مبتدأ مؤخر (أَلِيمٌ) صفة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":64,"ayah":6,"words":[{"position":1,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":2,"arabic":"بِأَنَّهُۥ","translation":"(is) because","transliteration":"bi-annahu"},{"position":3,"arabic":"كَانَت","translation":"had","transliteration":"kānat"},{"position":4,"arabic":"تَّأْتِيهِمْ","translation":"come to them","transliteration":"tatīhim"},{"position":5,"arabic":"رُسُلُهُم","translation":"their Messengers","transliteration":"rusuluhum"},{"position":6,"arabic":"بِٱلْبَيِّنَـٰتِ","translation":"with clear proofs","transliteration":"bil-bayināti"},{"position":7,"arabic":"فَقَالُوٓا۟","translation":"but they said","transliteration":"faqālū"},{"position":8,"arabic":"أَبَشَرٌۭ","translation":"Shall human beings","transliteration":"abasharun"},{"position":9,"arabic":"يَهْدُونَنَا","translation":"guide us","transliteration":"yahdūnanā"},{"position":10,"arabic":"فَكَفَرُوا۟","translation":"So they disbelieved","transliteration":"fakafarū"},{"position":11,"arabic":"وَتَوَلَّوا۟ ۚ","translation":"and turned away","transliteration":"watawallaw"},{"position":12,"arabic":"وَّٱسْتَغْنَى","translation":"And can do without them","transliteration":"wa-is'taghnā"},{"position":13,"arabic":"ٱللَّهُ ۚ","translation":"Allah","transliteration":"l-lahu"},{"position":14,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":15,"arabic":"غَنِىٌّ","translation":"(is) Self-sufficient","transliteration":"ghaniyyun"},{"position":16,"arabic":"حَمِيدٌۭ","translation":"Praiseworthy","transliteration":"ḥamīdun"}],"e3rab":"(ذلِكَ بِأَنَّهُ) ذلك مبتدأ والباء حرف جر وأن واسمها (كانَتْ) فعل ماض ناقص اسمه مستتر (تَأْتِيهِمْ) مضارع ومفعوله (رُسُلُهُمْ) فاعله (بِالْبَيِّناتِ) متعلقان بالفعل وجملة كانت.. خبر أن والمصدر المؤول من أن وما بعدها في محل جر بحرف الجر وهما متعلقان بخبر المبتدأ المحذوف وجملة تأتيهم خبر كانت وجملة ذلك.. استئنافية لا محل لها.\r\n\r\n(فَقالُوا) الفاء حرف عطف وماض وفاعله والجملة معطوفة على ما قبلها (أَبَشَرٌ) الهمزة للاستفهام الإنكاري (بَشَرٌ) فاعل لفعل محذوف يفسره المذكور والجملة الاستفهامية مقول القول (يَهْدُونَنا) مضارع وفاعله ومفعوله والجملة مفسرة لا محل لها (فَكَفَرُوا) الفاء حرف عطف وماض وفاعله (وَتَوَلَّوْا) معطوف على كفروا.\r\n\r\n(وَاسْتَغْنَى اللَّهُ) ماض وفاعله والجملة معطوفة على ما قبلها.\r\n\r\n(وَاللَّهُ غَنِيٌّ حَمِيدٌ) مبتدأ وخبران والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":64,"ayah":7,"words":[{"position":1,"arabic":"زَعَمَ","translation":"Claim","transliteration":"zaʿama"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"كَفَرُوٓا۟","translation":"disbelieve","transliteration":"kafarū"},{"position":4,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":5,"arabic":"لَّن","translation":"never","transliteration":"lan"},{"position":6,"arabic":"يُبْعَثُوا۟ ۚ","translation":"will they be raised","transliteration":"yub'ʿathū"},{"position":7,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":8,"arabic":"بَلَىٰ","translation":"Yes","transliteration":"balā"},{"position":9,"arabic":"وَرَبِّى","translation":"by my Lord","transliteration":"warabbī"},{"position":10,"arabic":"لَتُبْعَثُنَّ","translation":"surely you will be raised","transliteration":"latub'ʿathunna"},{"position":11,"arabic":"ثُمَّ","translation":"then","transliteration":"thumma"},{"position":12,"arabic":"لَتُنَبَّؤُنَّ","translation":"surely you will be informed","transliteration":"latunabba-unna"},{"position":13,"arabic":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":14,"arabic":"عَمِلْتُمْ ۚ","translation":"you did","transliteration":"ʿamil'tum"},{"position":15,"arabic":"وَذَٰلِكَ","translation":"And that","transliteration":"wadhālika"},{"position":16,"arabic":"عَلَى","translation":"for","transliteration":"ʿalā"},{"position":17,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":18,"arabic":"يَسِيرٌۭ","translation":"(is) easy","transliteration":"yasīrun"}],"e3rab":"(زَعَمَ الَّذِينَ) ماض وفاعله والجملة استئنافية لا محل لها (كَفَرُوا) ماض وفاعله والجملة صلة الذين (أَنْ) مخففة واسمها ضمير الشأن محذوف (لَنْ يُبْعَثُوا) مضارع مبني للمجهول منصوب بلن والواو نائب فاعل والجملة خبر أن والمصدر المؤول من أن وما بعدها سد مسد مفعولي زعم.\r\n\r\n(قُلْ) أمر فاعله مستتر والجملة استئنافية لا محل لها (بَلى) حرف جواب (وَرَبِّي) جار ومجرور متعلقان بفعل محذوف تقديره أقسم.\r\n\r\n(لَتُبْعَثُنَّ) اللام واقعة في جواب القسم ومضارع مبني للمجهول مرفوع والنون محذوفة لتوالي الأمثال والواو المحذوفة لالتقاء الساكنين نائب فاعل والجملة جواب القسم لا محل لها (ثُمَّ) حرف عطف (لَتُنَبَّؤُنَّ) معطوف على لتبعثن.\r\n\r\n(بِما) متعلقان بالفعل (عَمِلْتُمْ) ماض وفاعله والجملة صلة ما.\r\n\r\n(وَذلِكَ) مبتدأ (عَلَى اللَّهِ) متعلقان بيسير (يَسِيرٌ) خبر المبتدأ والجملة الاسمية استئنافية لا محل لها.\r\n\r\n"},{"sura":64,"ayah":8,"words":[{"position":1,"arabic":"فَـَٔامِنُوا۟","translation":"So believe","transliteration":"faāminū"},{"position":2,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":3,"arabic":"وَرَسُولِهِۦ","translation":"and His Messenger","transliteration":"warasūlihi"},{"position":4,"arabic":"وَٱلنُّورِ","translation":"and the Light","transliteration":"wal-nūri"},{"position":5,"arabic":"ٱلَّذِىٓ","translation":"which","transliteration":"alladhī"},{"position":6,"arabic":"أَنزَلْنَا ۚ","translation":"We have sent down","transliteration":"anzalnā"},{"position":7,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":8,"arabic":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":9,"arabic":"تَعْمَلُونَ","translation":"you do","transliteration":"taʿmalūna"},{"position":10,"arabic":"خَبِيرٌۭ","translation":"(is) All-Aware","transliteration":"khabīrun"}],"e3rab":"(فَآمِنُوا) الفاء الفصيحة وأمر مبني على حذف النون والواو فاعله (بِاللَّهِ) متعلقان بالفعل والجملة جواب الشرط المقدر لا محل لها (وَرَسُولِهِ) معطوف على لفظ الجلالة (وَالنُّورِ) معطوف أيضا (الَّذِي) صفة النور (أَنْزَلْنا) ماض وفاعله والجملة صلة.\r\n\r\n(وَاللَّهُ) الواو حرف استئناف ولفظ الجلالة مبتدأ (بِما) متعلقان بخبير (تَعْمَلُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية صلة (خَبِيرٌ) خبر المبتدأ والجملة الاسمية استئنافية لا محل لها.\r\n\r\n"},{"sura":64,"ayah":9,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"يَجْمَعُكُمْ","translation":"He will assemble you","transliteration":"yajmaʿukum"},{"position":3,"arabic":"لِيَوْمِ","translation":"for (the) Day","transliteration":"liyawmi"},{"position":4,"arabic":"ٱلْجَمْعِ ۖ","translation":"(of) the Assembly","transliteration":"l-jamʿi"},{"position":5,"arabic":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":6,"arabic":"يَوْمُ","translation":"(will be the) Day","transliteration":"yawmu"},{"position":7,"arabic":"ٱلتَّغَابُنِ ۗ","translation":"(of) mutual loss and gain","transliteration":"l-taghābuni"},{"position":8,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":9,"arabic":"يُؤْمِنۢ","translation":"believes","transliteration":"yu'min"},{"position":10,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":11,"arabic":"وَيَعْمَلْ","translation":"and does","transliteration":"wayaʿmal"},{"position":12,"arabic":"صَـٰلِحًۭا","translation":"righteous deeds","transliteration":"ṣāliḥan"},{"position":13,"arabic":"يُكَفِّرْ","translation":"He will remove","transliteration":"yukaffir"},{"position":14,"arabic":"عَنْهُ","translation":"from him","transliteration":"ʿanhu"},{"position":15,"arabic":"سَيِّـَٔاتِهِۦ","translation":"his evil deeds","transliteration":"sayyiātihi"},{"position":16,"arabic":"وَيُدْخِلْهُ","translation":"and He will admit him","transliteration":"wayud'khil'hu"},{"position":17,"arabic":"جَنَّـٰتٍۢ","translation":"(to) Gardens","transliteration":"jannātin"},{"position":18,"arabic":"تَجْرِى","translation":"flow","transliteration":"tajrī"},{"position":19,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":20,"arabic":"تَحْتِهَا","translation":"underneath it","transliteration":"taḥtihā"},{"position":21,"arabic":"ٱلْأَنْهَـٰرُ","translation":"the rivers","transliteration":"l-anhāru"},{"position":22,"arabic":"خَـٰلِدِينَ","translation":"abiding","transliteration":"khālidīna"},{"position":23,"arabic":"فِيهَآ","translation":"therein","transliteration":"fīhā"},{"position":24,"arabic":"أَبَدًۭا ۚ","translation":"forever","transliteration":"abadan"},{"position":25,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":26,"arabic":"ٱلْفَوْزُ","translation":"(is) the success","transliteration":"l-fawzu"},{"position":27,"arabic":"ٱلْعَظِيمُ","translation":"the great","transliteration":"l-ʿaẓīmu"}],"e3rab":"(يَوْمَ يَجْمَعُكُمْ) ظرف زمان ومضارع ومفعوله والفاعل مستتر والجملة في محل جر بالإضافة (لِيَوْمِ) متعلقان بالفعل (الْجَمْعِ) مضاف إليه (ذلِكَ يَوْمُ) مبتدأ وخبره (التَّغابُنِ) مضاف إليه والجملة استئنافية لا محل لها.\r\n\r\n(وَ) الواو استئنافية (مَنْ) اسم شرط جازم مبتدأ (يُؤْمِنْ) مضارع مجزوم لأنه فعل الشرط والفاعل مستتر (بِاللَّهِ) متعلقان بالفعل (وَيَعْمَلْ) معطوف على يؤمن (صالِحاً) مفعول به (يُكَفِّرْ) مضارع مجزوم لأنه جواب الشرط وجملتا الشرط والجواب خبر المبتدأ من وجملة من.. استئنافية لا محل لها.\r\n\r\n(عَنْهُ) متعلقان بالفعل (سَيِّئاتِهِ) مفعول به (وَيُدْخِلْهُ) معطوف على يكفر والهاء مفعوله الأول (جَنَّاتٍ) مفعوله الثاني (تَجْرِي) مضارع فاعله مستتر والجملة صفة جنات.\r\n\r\n(مِنْ تَحْتِهَا) متعلقان بالفعل (الْأَنْهارُ) فاعل (خالِدِينَ) حال (فِيها) متعلقان بخالدين (أَبَداً) ظرف زمان (ذلِكَ الْفَوْزُ) مبتدأ وخبره (الْعَظِيمُ) صفة والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":64,"ayah":10,"words":[{"position":1,"arabic":"وَٱلَّذِينَ","translation":"But those who","transliteration":"wa-alladhīna"},{"position":2,"arabic":"كَفَرُوا۟","translation":"disbelieved","transliteration":"kafarū"},{"position":3,"arabic":"وَكَذَّبُوا۟","translation":"and denied","transliteration":"wakadhabū"},{"position":4,"arabic":"بِـَٔايَـٰتِنَآ","translation":"[in] Our Verses","transliteration":"biāyātinā"},{"position":5,"arabic":"أُو۟لَـٰٓئِكَ","translation":"those","transliteration":"ulāika"},{"position":6,"arabic":"أَصْحَـٰبُ","translation":"(are the) companions","transliteration":"aṣḥābu"},{"position":7,"arabic":"ٱلنَّارِ","translation":"(of) the Fire","transliteration":"l-nāri"},{"position":8,"arabic":"خَـٰلِدِينَ","translation":"abiding forever","transliteration":"khālidīna"},{"position":9,"arabic":"فِيهَا ۖ","translation":"therein","transliteration":"fīhā"},{"position":10,"arabic":"وَبِئْسَ","translation":"And wretched is","transliteration":"wabi'sa"},{"position":11,"arabic":"ٱلْمَصِيرُ","translation":"the destination","transliteration":"l-maṣīru"}],"e3rab":"(وَالَّذِينَ كَفَرُوا) الواو حرف عطف واسم الموصول مبتدأ و(كَفَرُوا) ماض وفاعله والجملة صلة الذين (وَكَذَّبُوا) معطوف على كفروا (بِآياتِنا) متعلقان بالفعل (أُولئِكَ أَصْحابُ) مبتدأ وخبره والجملة الاسمية خبر الذين وجملة الذين.. معطوفة على ما قبلها (النَّارِ) مضاف إليه (خالِدِينَ) حال (فِيها) متعلقان بخالدين (وَبِئْسَ الْمَصِيرُ) ماض جامد وفاعله والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":64,"ayah":11,"words":[{"position":1,"arabic":"مَآ","translation":"Not","transliteration":"mā"},{"position":2,"arabic":"أَصَابَ","translation":"strikes","transliteration":"aṣāba"},{"position":3,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":4,"arabic":"مُّصِيبَةٍ","translation":"disaster","transliteration":"muṣībatin"},{"position":5,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":6,"arabic":"بِإِذْنِ","translation":"by (the) permission","transliteration":"bi-idh'ni"},{"position":7,"arabic":"ٱللَّهِ ۗ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":8,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":9,"arabic":"يُؤْمِنۢ","translation":"believes","transliteration":"yu'min"},{"position":10,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":11,"arabic":"يَهْدِ","translation":"He guides","transliteration":"yahdi"},{"position":12,"arabic":"قَلْبَهُۥ ۚ","translation":"his heart","transliteration":"qalbahu"},{"position":13,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":14,"arabic":"بِكُلِّ","translation":"of every","transliteration":"bikulli"},{"position":15,"arabic":"شَىْءٍ","translation":"thing","transliteration":"shayin"},{"position":16,"arabic":"عَلِيمٌۭ","translation":"(is) All-Knowing","transliteration":"ʿalīmun"}],"e3rab":"(ما) نافية (أَصابَ) ماض والجملة استئنافية لا محل لها (مِنْ) حرف جر زائد (مُصِيبَةٍ) مجرور لفظا مرفوع محلا فاعل أصاب (إِلَّا) حرف حصر (بِإِذْنِ اللَّهِ) متعلقان بأصاب ولفظ الجلالة مضاف إليه.\r\n\r\n(وَ) الواو حرف استئناف (مِنْ) اسم شرط مبتدأ (يُؤْمِنْ) مضارع مجزوم لأنه فعل الشرط (بِاللَّهِ) متعلقان بالفعل (يَهْدِ) مضارع مجزوم لأنه جواب الشرط وعلامة جزمه حذف حرف العلة والفاعل مستتر (قَلْبَهُ) مفعول به والجملة جواب الشرط لا محل لها وجملتا الشرط والجواب خبر المبتدأ من. وجملة من.. استئنافية لا محل لها.\r\n\r\n(وَاللَّهُ) لفظ الجلالة مبتدأ (بِكُلِّ) متعلقان بعليم (شَيْءٍ) مضاف إليه (عَلِيمٌ) خبر والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":64,"ayah":12,"words":[{"position":1,"arabic":"وَأَطِيعُوا۟","translation":"So obey","transliteration":"wa-aṭīʿū"},{"position":2,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":3,"arabic":"وَأَطِيعُوا۟","translation":"and obey","transliteration":"wa-aṭīʿū"},{"position":4,"arabic":"ٱلرَّسُولَ ۚ","translation":"the Messenger","transliteration":"l-rasūla"},{"position":5,"arabic":"فَإِن","translation":"but if","transliteration":"fa-in"},{"position":6,"arabic":"تَوَلَّيْتُمْ","translation":"you turn away","transliteration":"tawallaytum"},{"position":7,"arabic":"فَإِنَّمَا","translation":"then only","transliteration":"fa-innamā"},{"position":8,"arabic":"عَلَىٰ","translation":"upon","transliteration":"ʿalā"},{"position":9,"arabic":"رَسُولِنَا","translation":"Our Messenger","transliteration":"rasūlinā"},{"position":10,"arabic":"ٱلْبَلَـٰغُ","translation":"(is) the conveyance","transliteration":"l-balāghu"},{"position":11,"arabic":"ٱلْمُبِينُ","translation":"clear","transliteration":"l-mubīnu"}],"e3rab":"(وَأَطِيعُوا اللَّهَ) أمر وفاعله ولفظ الجلالة مفعوله والجملة استئنافية لا محل لها.\r\n\r\n(وَأَطِيعُوا الرَّسُولَ) معطوفة على أطيعوا اللّه.\r\n\r\n(فَإِنْ) الفاء حرف استئناف وحرف شرط جازم (تَوَلَّيْتُمْ) ماض وفاعله والجملة ابتدائية لا محل لها.\r\n\r\n(فَإِنَّما) الفاء حرف تعليل (إنما) كافة ومكفوفة (عَلى رَسُولِنَا) خبر مقدم (الْبَلاغُ) مبتدأ مؤخر (الْمُبِينُ) صفة والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":64,"ayah":13,"words":[{"position":1,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"al-lahu"},{"position":2,"arabic":"لَآ","translation":"(there is) no","transliteration":"lā"},{"position":3,"arabic":"إِلَـٰهَ","translation":"god","transliteration":"ilāha"},{"position":4,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":5,"arabic":"هُوَ ۚ","translation":"Him","transliteration":"huwa"},{"position":6,"arabic":"وَعَلَى","translation":"And upon","transliteration":"waʿalā"},{"position":7,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":8,"arabic":"فَلْيَتَوَكَّلِ","translation":"let put (their) trust","transliteration":"falyatawakkali"},{"position":9,"arabic":"ٱلْمُؤْمِنُونَ","translation":"the believers","transliteration":"l-mu'minūna"}],"e3rab":"(اللَّهُ) لفظ الجلالة مبتدأ (لا) نافية للجنس (إِلهَ) اسمها وخبرها محذوف (إِلَّا) حرف حصر (هُوَ) بدل من الضمير المستتر في الخبر المحذوف وجملة لا إله.. خبر لفظ الجلالة.\r\n\r\n(وَ) الواو زائدة (عَلَى اللَّهِ) متعلقان بما بعدهما (فَلْيَتَوَكَّلِ) الفاء حرف استئناف ومضارع مجزوم بلام الأمر (الْمُؤْمِنُونَ) فاعل والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":64,"ayah":14,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"(you) who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوٓا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":5,"arabic":"مِنْ","translation":"from","transliteration":"min"},{"position":6,"arabic":"أَزْوَٰجِكُمْ","translation":"your spouses","transliteration":"azwājikum"},{"position":7,"arabic":"وَأَوْلَـٰدِكُمْ","translation":"and your children","transliteration":"wa-awlādikum"},{"position":8,"arabic":"عَدُوًّۭا","translation":"(are) enemies","transliteration":"ʿaduwwan"},{"position":9,"arabic":"لَّكُمْ","translation":"to you","transliteration":"lakum"},{"position":10,"arabic":"فَٱحْذَرُوهُمْ ۚ","translation":"so beware of them","transliteration":"fa-iḥ'dharūhum"},{"position":11,"arabic":"وَإِن","translation":"But if","transliteration":"wa-in"},{"position":12,"arabic":"تَعْفُوا۟","translation":"you pardon","transliteration":"taʿfū"},{"position":13,"arabic":"وَتَصْفَحُوا۟","translation":"and overlook","transliteration":"wataṣfaḥū"},{"position":14,"arabic":"وَتَغْفِرُوا۟","translation":"and forgive","transliteration":"wataghfirū"},{"position":15,"arabic":"فَإِنَّ","translation":"then indeed","transliteration":"fa-inna"},{"position":16,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":17,"arabic":"غَفُورٌۭ","translation":"(is) Oft-Forgiving","transliteration":"ghafūrun"},{"position":18,"arabic":"رَّحِيمٌ","translation":"Most Merciful","transliteration":"raḥīmun"}],"e3rab":"(يا أَيُّهَا الَّذِينَ آمَنُوا) سبق إعرابها (إِنَّ) حرف مشبه بالفعل (مِنْ أَزْواجِكُمْ) خبر إن المقدم (وَأَوْلادِكُمْ) معطوف على أزواجكم (عَدُوًّا) اسم إن المؤخر (لَكُمْ) متعلقان بعدوا والجملة ابتدائية لا محل لها.\r\n\r\n(فَاحْذَرُوهُمْ) الفاء الفصيحة وأمر وفاعله ومفعوله والجملة جواب الشرط لا محل لها (وَ) الواو حرف عطف (إِنْ تَعْفُوا) إن حرف شرط جازم ومضارع مجزوم لأنه فعل الشرط والواو فاعله (وَتَصْفَحُوا وَتَغْفِرُوا) معطوفان على تعفوا (فَإِنَّ اللَّهَ) الفاء واقعة في جواب الشرط وإن واسمها (غَفُورٌ رَحِيمٌ) خبراها والجملة في محل جزم جواب الشرط.\r\n\r\n"},{"sura":64,"ayah":15,"words":[{"position":1,"arabic":"إِنَّمَآ","translation":"Only","transliteration":"innamā"},{"position":2,"arabic":"أَمْوَٰلُكُمْ","translation":"your wealth","transliteration":"amwālukum"},{"position":3,"arabic":"وَأَوْلَـٰدُكُمْ","translation":"and your children","transliteration":"wa-awlādukum"},{"position":4,"arabic":"فِتْنَةٌۭ ۚ","translation":"(are) a trial","transliteration":"fit'natun"},{"position":5,"arabic":"وَٱللَّهُ","translation":"and Allah ","transliteration":"wal-lahu"},{"position":6,"arabic":"عِندَهُۥٓ","translation":"with Him","transliteration":"ʿindahu"},{"position":7,"arabic":"أَجْرٌ","translation":"(is) a reward","transliteration":"ajrun"},{"position":8,"arabic":"عَظِيمٌۭ","translation":"great","transliteration":"ʿaẓīmun"}],"e3rab":"(إِنَّما) كافة ومكفوفة.\r\n\r\n(أَمْوالُكُمْ) مبتدأ.\r\n\r\n(وَأَوْلادُكُمْ) معطوف على أموالكم.\r\n\r\n(فِتْنَةٌ) خبر المبتدأ والجملة الاسمية استئنافية لا محل لها.\r\n\r\n(وَاللَّهُ عِنْدَهُ) الواو حرف استئناف ولفظ الجلالة مبتدأ وظرف مكان متعلق بمحذوف خبر مقدم.\r\n\r\n(أَجْرٌ) مبتدأ مؤخر.\r\n\r\n(عَظِيمٌ) صفة والجملة خبر المبتدأ وجملة اللّه.. استئنافية لا محل لها.\r\n\r\n"},{"sura":64,"ayah":16,"words":[{"position":1,"arabic":"فَٱتَّقُوا۟","translation":"So fear","transliteration":"fa-ittaqū"},{"position":2,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"ٱسْتَطَعْتُمْ","translation":"you are able","transliteration":"is'taṭaʿtum"},{"position":5,"arabic":"وَٱسْمَعُوا۟","translation":"and listen","transliteration":"wa-is'maʿū"},{"position":6,"arabic":"وَأَطِيعُوا۟","translation":"and obey","transliteration":"wa-aṭīʿū"},{"position":7,"arabic":"وَأَنفِقُوا۟","translation":"and spend","transliteration":"wa-anfiqū"},{"position":8,"arabic":"خَيْرًۭا","translation":"(it is) better","transliteration":"khayran"},{"position":9,"arabic":"لِّأَنفُسِكُمْ ۗ","translation":"for yourselves","transliteration":"li-anfusikum"},{"position":10,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":11,"arabic":"يُوقَ","translation":"is saved","transliteration":"yūqa"},{"position":12,"arabic":"شُحَّ","translation":"(from the) greediness","transliteration":"shuḥḥa"},{"position":13,"arabic":"نَفْسِهِۦ","translation":"(of) his soul","transliteration":"nafsihi"},{"position":14,"arabic":"فَأُو۟لَـٰٓئِكَ","translation":"then those","transliteration":"fa-ulāika"},{"position":15,"arabic":"هُمُ","translation":"[they]","transliteration":"humu"},{"position":16,"arabic":"ٱلْمُفْلِحُونَ","translation":"(are) the successful ones","transliteration":"l-muf'liḥūna"}],"e3rab":"(فَاتَّقُوا اللَّهَ) الفاء الفصيحة وأمر وفاعله ولفظ الجلالة مفعوله والجملة جواب الشرط المقدر لا محل لها (مَا) مصدرية (اسْتَطَعْتُمْ) ماض وفاعله والمصدر المؤول من ما والفعل منصوب بفعل محذوف أي استطاعتكم وجهدكم (وَاسْمَعُوا وَأَطِيعُوا وَأَنْفِقُوا) معطوف على ما قبله (خَيْراً) مفعول بفعل مقدر أي وائتوا خيرا (لِأَنْفُسِكُمْ) متعلقان بخيرا (وَ) الواو حرف استئناف (مَنْ) اسم شرط مبتدأ (يُوقَ) مضارع مجزوم بفعل الشرط وعلامة جزمه حذف حرف العلة ونائب الفاعل مستتر (شُحَّ) مفعول به ثان (نَفْسِهِ) مضاف إليه (فَأُولئِكَ) الفاء واقعة في جواب الشرط واسم الإشارة مبتدأ (هُمُ) ضمير فصل (الْمُفْلِحُونَ) خبر والجملة في محل جزم جواب الشرط وجملتا الشرط والجواب خبر المبتدأ من.\r\n\r\n"},{"sura":64,"ayah":17,"words":[{"position":1,"arabic":"إِن","translation":"If","transliteration":"in"},{"position":2,"arabic":"تُقْرِضُوا۟","translation":"you loan","transliteration":"tuq'riḍū"},{"position":3,"arabic":"ٱللَّهَ","translation":"(to) Allah","transliteration":"l-laha"},{"position":4,"arabic":"قَرْضًا","translation":"a loan","transliteration":"qarḍan"},{"position":5,"arabic":"حَسَنًۭا","translation":"goodly","transliteration":"ḥasanan"},{"position":6,"arabic":"يُضَـٰعِفْهُ","translation":"He will multiply it","transliteration":"yuḍāʿif'hu"},{"position":7,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":8,"arabic":"وَيَغْفِرْ","translation":"and will forgive","transliteration":"wayaghfir"},{"position":9,"arabic":"لَكُمْ ۚ","translation":"you","transliteration":"lakum"},{"position":10,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":11,"arabic":"شَكُورٌ","translation":"(is) Most Appreciative","transliteration":"shakūrun"},{"position":12,"arabic":"حَلِيمٌ","translation":"Most Forbearing","transliteration":"ḥalīmun"}],"e3rab":"(إِنْ تُقْرِضُوا اللَّهَ) إن حرف شرط جازم ومضارع مجزوم لأنه فعل الشرط والواو فاعله ولفظ الجلالة مفعول به (قَرْضاً) مفعول مطلق (حَسَناً) صفة والجملة ابتدائية لا محل لها.\r\n\r\n(يُضاعِفْهُ) مضارع مجزوم لأنه جواب الشرط والهاء مفعوله والفاعل مستتر (لَكُمْ) متعلقان بالفعل والجملة جواب الشرط لا محل لها (وَيَغْفِرْ) معطوف على يضاعفه (لَكُمْ) متعلقان بيغفر.\r\n\r\n(وَاللَّهُ شَكُورٌ حَلِيمٌ) مبتدأ وخبران والجملة حال.\r\n\r\n"},{"sura":64,"ayah":18,"words":[{"position":1,"arabic":"عَـٰلِمُ","translation":"(The) Knower","transliteration":"ʿālimu"},{"position":2,"arabic":"ٱلْغَيْبِ","translation":"(of) the unseen","transliteration":"l-ghaybi"},{"position":3,"arabic":"وَٱلشَّهَـٰدَةِ","translation":"and the witnessed","transliteration":"wal-shahādati"},{"position":4,"arabic":"ٱلْعَزِيزُ","translation":"the All-Mighty","transliteration":"l-ʿazīzu"},{"position":5,"arabic":"ٱلْحَكِيمُ","translation":"the All-Wise","transliteration":"l-ḥakīmu"}],"e3rab":"(عالِمُ) خبر لمبتدأ محذوف (الْغَيْبِ) مضاف إليه (وَالشَّهادَةِ) معطوف على الغيب (الْعَزِيزُ الْحَكِيمُ) خبران لمبتدأ محذوف.\r\n\r\n"}]