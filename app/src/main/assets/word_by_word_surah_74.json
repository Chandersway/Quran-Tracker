tion":1,"arabic":"ذَرْنِى","translation":"Leave Me","transliteration":"dharnī"},{"position":2,"arabic":"وَمَنْ","translation":"and whom","transliteration":"waman"},{"position":3,"arabic":"خَلَقْتُ","translation":"I created","transliteration":"khalaqtu"},{"position":4,"arabic":"وَحِيدًۭا","translation":"alone","transliteration":"waḥīdan"}],"e3rab":"(ذَرْنِي) أمر فاعله مستتر والنون للوقاية وياء المتكلم مفعول به والجملة ابتدائية لا محل لها.\r\n\r\n(وَمَنْ) معطوف على ياء المتكلم و(خَلَقْتُ) ماض وفاعله (وَحِيداً) حال والجملة صلة لا محل لها\r\n\r\n"},{"sura":74,"ayah":12,"words":[{"position":1,"arabic":"وَجَعَلْتُ","translation":"And I granted","transliteration":"wajaʿaltu"},{"position":2,"arabic":"لَهُۥ","translation":"to him","transliteration":"lahu"},{"position":3,"arabic":"مَالًۭا","translation":"wealth","transliteration":"mālan"},{"position":4,"arabic":"مَّمْدُودًۭا","translation":"extensive","transliteration":"mamdūdan"}],"e3rab":"(وَجَعَلْتُ) ماض وفاعله و(لَهُ) متعلقان بالفعل وهما في موضع المفعول الثاني و(مالًا) مفعوله الأول (مَمْدُوداً) صفة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":74,"ayah":13,"words":[{"position":1,"arabic":"وَبَنِينَ","translation":"And children","transliteration":"wabanīna"},{"position":2,"arabic":"شُهُودًۭا","translation":"present","transliteration":"shuhūdan"}],"e3rab":"(وَبَنِينَ) معطوف على مالا و(شُهُوداً) صفة.\r\n\r\n"},{"sura":74,"ayah":14,"words":[{"position":1,"arabic":"وَمَهَّدتُّ","translation":"And I spread","transliteration":"wamahhadttu"},{"position":2,"arabic":"لَهُۥ","translation":"for him","transliteration":"lahu"},{"position":3,"arabic":"تَمْهِيدًۭا","translation":"ease","transliteration":"tamhīdan"}],"e3rab":"(وَمَهَّدْتُ) ماض وفاعله و(لَهُ) متعلقان بالفعل و(تَمْهِيداً) مفعول مطلق والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":74,"ayah":15,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"يَطْمَعُ","translation":"he desires","transliteration":"yaṭmaʿu"},{"position":3,"arabic":"أَنْ","translation":"that","transliteration":"an"},{"position":4,"arabic":"أَزِيدَ","translation":"I (should) add more","transliteration":"azīda"}],"e3rab":"(ثُمَّ) حرف عطف و(يَطْمَعُ) مضارع فاعله مستتر والجملة معطوفة على ما قبلها (أَنْ أَزِيدَ) مضارع منصوب بأن فاعله مستتر والمصدر المؤول من أن والفعل منصوب بنزع الخافض.\r\n\r\n"},{"sura":74,"ayah":16,"words":[{"position":1,"arabic":"كَلَّآ ۖ","translation":"By no means","transliteration":"kallā"},{"position":2,"arabic":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":3,"arabic":"كَانَ","translation":"has been","transliteration":"kāna"},{"position":4,"arabic":"لِـَٔايَـٰتِنَا","translation":"to Our Verses","transliteration":"liāyātinā"},{"position":5,"arabic":"عَنِيدًۭا","translation":"stubborn","transliteration":"ʿanīdan"}],"e3rab":"(كَلَّا إِنَّهُ) حرف ردع وزجر وإن واسمها و(كانَ) ماض ناقص اسمه مستتر و(لِآياتِنا) متعلقان بما بعدهما و(عَنِيداً) خبر كان والجملة الفعلية خبر إن والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"},{"sura":74,"ayah":17,"words":[{"position":1,"arabic":"سَأُرْهِقُهُۥ","translation":"Soon I will cover Him","transliteration":"sa-ur'hiquhu"},{"position":2,"arabic":"صَعُودًا","translation":"(with) a laborious punishment","transliteration":"ṣaʿūdan"}],"e3rab":"(سَأُرْهِقُهُ) السين للاستقبال ومضارع فاعله مستتر والهاء مفعول به أول و(صَعُوداً) مفعول به ثان والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":74,"ayah":18,"words":[{"position":1,"arabic":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":2,"arabic":"فَكَّرَ","translation":"thought","transliteration":"fakkara"},{"position":3,"arabic":"وَقَدَّرَ","translation":"and plotted","transliteration":"waqaddara"}],"e3rab":"(إِنَّهُ فَكَّرَ) إن واسمها وماض فاعله مستتر والجملة خبر إنه والجملة الاسمية تعليل (وَقَدَّرَ) معطوف على فكر\r\n\r\n"},{"sura":74,"ayah":19,"words":[{"position":1,"arabic":"فَقُتِلَ","translation":"So may he be destroyed","transliteration":"faqutila"},{"position":2,