[{"sura":74,"ayah":1,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلْمُدَّثِّرُ","translation":"who covers himself","transliteration":"l-mudathiru"}],"e3rab":"(يا أَيُّهَا) حرف نداء ومنادى مبني على الضم في محل نصب وها حرف تنبيه و(الْمُدَّثِّرُ) بدل من أي والجملة ابتدائية لا محل لها\r\n\r\n"},{"sura":74,"ayah":2,"words":[{"position":1,"arabic":"قُمْ","translation":"Stand up","transliteration":"qum"},{"position":2,"arabic":"فَأَنذِرْ","translation":"and warn","transliteration":"fa-andhir"}],"e3rab":"(قُمْ) أمر فاعله مستتر (فَأَنْذِرْ) أمر معطوف على قم وجملة قم ابتدائية أيضا لا محل لها.\r\n\r\n"},{"sura":74,"ayah":3,"words":[{"position":1,"arabic":"وَرَبَّكَ","translation":"And your Lord","transliteration":"warabbaka"},{"position":2,"arabic":"فَكَبِّرْ","translation":"magnify","transliteration":"fakabbir"}],"e3rab":"(وَرَبَّكَ) مفعول به مقدم (فَكَبِّرْ) الفاء واقعة في جواب شرط محذوف وأمر فاعله مستتر والجملة جواب الشرط لا محل لها.\r\n\r\n"},{"sura":74,"ayah":4,"words":[{"position":1,"arabic":"وَثِيَابَكَ","translation":"And your clothing","transliteration":"wathiyābaka"},{"position":2,"arabic":"فَطَهِّرْ","translation":"purify","transliteration":"faṭahhir"}],"e3rab":"(وَثِيابَكَ) الواو حرف عطف ومفعول به مقدم (فَطَهِّرْ) كإعراب فكبر\r\n\r\n"},{"sura":74,"ayah":5,"words":[{"position":1,"arabic":"وَٱلرُّجْزَ","translation":"And uncleanliness","transliteration":"wal-ruj'za"},{"position":2,"arabic":"فَٱهْجُرْ","translation":"avoid","transliteration":"fa-uh'jur"}],"e3rab":"(وَالرُّجْزَ فَاهْجُرْ) معطوف على ما قبله.\r\n\r\n"},{"sura":74,"ayah":6,"words":[{"position":1,"arabic":"وَلَا","translation":"And (do) not","transliteration":"walā"},{"position":2,"arabic":"تَمْنُن","translation":"confer favor","transliteration":"tamnun"},{"position":3,"arabic":"تَسْتَكْثِرُ","translation":"(to) acquire more","transliteration":"tastakthiru"}],"e3rab":"(وَلا تَمْنُنْ) الواو حرف عطف ومضارع مجزوم بلا الناهية والجم