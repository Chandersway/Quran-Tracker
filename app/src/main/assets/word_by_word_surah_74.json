the right","transliteration":"l-yamīni"}],"e3rab":"و(إِلَّا) أداة استثناء و(أَصْحابَ الْيَمِينِ) مستثنى بإلا مضاف إلى اليمين\r\n\r\n"},{"sura":74,"ayah":40,"words":[{"position":1,"arabic":"فِى","translation":"In","transliteration":"fī"},{"position":2,"arabic":"جَنَّـٰتٍۢ","translation":"Gardens","transliteration":"jannātin"},{"position":3,"arabic":"يَتَسَآءَلُونَ","translation":"asking each other","transliteration":"yatasāalūna"}],"e3rab":"و(فِي جَنَّاتٍ) متعلقان بمحذوف حال و(يَتَساءَلُونَ) مضارع مرفوع والواو فاعله والجملة مستأنفة لا محل لها\r\n\r\n"},{"sura":74,"ayah":41,"words":[{"position":1,"arabic":"عَنِ","translation":"About","transliteration":"ʿani"},{"position":2,"arabic":"ٱلْمُجْرِمِينَ","translation":"the criminals","transliteration":"l-muj'rimīna"}],"e3rab":"و(عَنِ الْمُجْرِمِينَ) متعلقان بما قبلهما\r\n\r\n"},{"sura":74,"ayah":42,"words":[{"position":1,"arabic":"مَا","translation":"What","transliteration":"mā"},{"position":2,"arabic":"سَلَكَكُمْ","translation":"led you","transliteration":"salakakum"},{"position":3,"arabic":"فِى","translation":"into","transliteration":"fī"},{"position":4,"arabic":"سَقَرَ","translation":"Hell","transliteration":"saqara"}],"e3rab":"و(ما) اسم استفهام مبتدأ و(سَلَكَكُمْ) ماض ومفعوله والفاعل مستتر والجملة الفعلية خبر المبتدأ و(فِي سَقَرَ) متعلقان بالفعل والجملة الاسمية مقول لقول محذوف.\r\n\r\n"},{"sura":74,"ayah":43,"words":[{"position":1,"arabic":"قَالُوا۟","translation":"They will say","transliteration":"qālū"},{"position":2,"arabic":"لَمْ","translation":"Not","transliteration":"lam"},{"position":3,"arabic":"نَكُ","translation":"we were","transliteration":"naku"},{"position":4,"arabic":"مِنَ","translation":"of","transliteration":"mina"},{"position":5,"arabic":"ٱلْمُصَلِّينَ","translation":"those who prayed","transliteration":"l-muṣalīna"}],"e3rab":"(قالُوا) ماض وفاعله والجملة مستأنفة لا محل لها و(لَمْ نَكُ) مضارع ناقص مجزوم بلم وعلامة جزمه السكون على النون المحذوفة للتخفيف واسمه مستتر و(مِنَ الْمُصَلِّينَ) خبر نك والجملة الفعلية مقول القول\r\n\r\n"},{"sura":74,"ayah":44,"words":[{"position":1,"arabic":"وَلَمْ","translation":"And not","transliteration":"walam"},{"position":2,"arabic":"نَكُ","translation":"we used to","transliteration":"naku"},{"position":3,"arabic":"نُطْعِمُ","translation":"feed","transliteration":"nuṭ'ʿimu"},{"position":4,"arabic":"ٱلْمِسْكِينَ","translation":"the poor","transliteration":"l-mis'kīna"}],"e3rab":"(وَلَمْ نَكُ) معطوف على سابقه و(نُطْعِمُ) مضارع فاعله مستتر و(الْمِسْكِينَ) مفعول به وجملة نطعم.. خبر نك\r\n\r\n"},{"sura":74,"ayah":45,"words":[{"position":1,"arabic":"وَكُنَّا","translation":"And we used to","transliteration":"wakunnā"},{"position":2,"arabic":"نَخُوضُ","translation":"indulge in vain talk","transliteration":"nakhūḍu"},{"position":3,"arabic":"مَعَ","translation":"with","transliteration":"maʿa"},{"position":4,"arabic":"ٱلْخَآئِضِينَ","translation":"the vain talkers","transliteration":"l-khāiḍīna"}],"e3rab":"(وَكُنَّا) ماض ناقص ونا اسمه و(نَخُوضُ) مضارع فاعله مستتر والجملة خبر كنا وجملة كنا.. معطوفة على ما قبلها و(مَعَ) ظرف مكان مضاف إلى (الْخائِضِينَ)\r\n\r\n"},{"sura":74,"ayah":46,"words":[{"position":1,"arabic":"وَكُنَّا","translation":"And we used to","transliteration":"wakunnā"},{"position":2,"arabic":"نُكَذِّبُ","translation":"deny","transliteration":"nukadhibu"},{"position":3,"arabic":"بِيَوْمِ","translation":"(the) Day","transliteration":"biyawmi"},{"position":4,"arabic":"ٱلدِّينِ","translation":"(of) the Judgment","transliteration":"l-dīni"}],"e3rab":"(وَكُنَّا) معطوف على سابقه و(نُكَذِّبُ) مضارع فاعله مستتر والجملة خبر كنا و(بِيَوْمِ) متعلقان بالفعل (الدِّينِ) مضاف إليه\r\n\r\n"},{"sura":74,"ayah":47,"words":[{"position":1,"arabic":"حَتَّىٰٓ","translation":"Until","transliteration":"ḥattā"},{"position":2,"arabic":"أَتَىٰنَا","translation":"came to us","transliteration":"atānā"},{"position":3,"arabic":"ٱلْيَقِينُ","translation":"the certainty","transliteration":"l-yaqīnu"}],"e3rab":"و(حَتَّى) حرف غاية وجر و(أَتانَا) ماض ومفعوله و(الْيَقِينُ) فاعله والمصدر المؤول من أن المضمرة والفعل في محل جر بحتى والجار والمجرور متعلقان بنكذب.\r\n\r\n"},{"sura":74,"ayah":48,"words":[{"position":1,"arabic":"فَمَا","translation":"Then not","transliteration":"famā"},{"position":2,"arabic":"تَنفَعُهُمْ","translation":"will benefit them","transliteration":"tanfaʿuhum"},{"position":3,"arabic":"شَفَـٰعَةُ","translation":"intercession","transliteration":"shafāʿatu"},{"position":4,"arabic":"ٱلشَّـٰفِعِينَ","translation":"(of) the intercessors","transliteration":"l-shāfiʿīna"}],"e3rab":"(فَما) الفاء حرف استئناف و(ما) نافية و(تَنْفَعُهُمْ) مضارع ومفعوله و(شَفاعَةُ) فاعل مضاف إلى (الشَّافِعِينَ) والجملة مستأنفة لا محل لها\r\n\r\n"},{"sura":74,"ayah":49,"words":[{"position":1,"arabic":"فَمَا","translation":"Then what","transliteration":"famā"},{"position":2,"arabic":"لَهُمْ","translation":"(is) for them","transliteration":"lahum"},{"position":3,"arabic":"عَنِ","translation":"(that) from","transliteration":"ʿani"},{"position":4,"arabic":"ٱلتَّذْكِرَةِ","translation":"the Reminder","transliteration":"l-tadhkirati"},{"position":5,"arabic":"مُعْرِضِينَ","translation":"they (are) turning away","transliteration":"muʿ'riḍīna"}],"e3rab":"(فَما) اسم استفهام مبتدأ و(لَهُمْ) متعلقان بمحذوف خبر المبتدأ والجملة الاسمية مستأنفة لا محل لها و(عَنِ التَّذْكِرَةِ) متعلقان بالحال (مُعْرِضِينَ) حال\r\n\r\n"},{"sura":74,"ayah":50,"words":[{"position":1,"arabic":"كَأَنَّهُمْ","translation":"As if they (were)","transliteration":"ka-annahum"},{"position":2,"arabic":"حُمُرٌۭ","translation":"donkeys","transliteration":"ḥumurun"},{"position":3,"arabic":"مُّسْتَنفِرَةٌۭ","translation":"frightened","transliteration":"mus'tanfiratun"}],"e3rab":"و(كَأَنَّهُمْ حُمُرٌ) كأن واسمها وخبرها (مُسْتَنْفِرَةٌ) صفة والجملة حال\r\n\r\n"},{"sura":74,"ayah":51,"words":[{"position":1,"arabic":"فَرَّتْ","translation":"Fleeing","transliteration":"farrat"},{"position":2,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":3,"arabic":"قَسْوَرَةٍۭ","translation":"a lion","transliteration":"qaswaratin"}],"e3rab":"(فَرَّتْ) ماض فاعله مستتر و(مِنْ قَسْوَرَةٍ) متعلقان بالفعل والجملة صفة ثانية لحمر.\r\n\r\n"},{"sura":74,"ayah":52,"words":[{"position":1,"arabic":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":2,"arabic":"يُرِيدُ","translation":"Desires","transliteration":"yurīdu"},{"position":3,"arabic":"كُلُّ","translation":"every","transliteration":"kullu"},{"position":4,"arabic":"ٱمْرِئٍۢ","translation":"person","transliteration":"im'ri-in"},{"position":5,"arabic":"مِّنْهُمْ","translation":"of them","transliteration":"min'hum"},{"position":6,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":7,"arabic":"يُؤْتَىٰ","translation":"he may be given","transliteration":"yu'tā"},{"position":8,"arabic":"صُحُفًۭا","translation":"pages","transliteration":"ṣuḥufan"},{"position":9,"arabic":"مُّنَشَّرَةًۭ","translation":"spread out","transliteration":"munasharatan"}],"e3rab":"(بَلْ) حرف إضراب و(يُرِيدُ كُلُّ) مضارع وفاعله المضاف إلى (امْرِئٍ) و(مِنْهُمْ) متعلقان بمحذوف صفة امرئ والجملة مستأنفة لا محل لها و(أَنْ يُؤْتى) مضارع مبني للمجهول منصوب بأن ونائب الفاعل مستتر و(صُحُفاً) مفعول به ثان و(مُنَشَّرَةً) صفة صحفا والمصدر المؤول من أن والفعل مفعول به\r\n\r\n"},{"sura":74,"ayah":53,"words":[{"position":1,"arabic":"كَلَّا ۖ","translation":"Nay","transliteration":"kallā"},{"position":2,"arabic":"بَل","translation":"But","transliteration":"bal"},{"position":3,"arabic":"لَّا","translation":"not","transliteration":"lā"},{"position":4,"arabic":"يَخَافُونَ","translation":"they fear","transliteration":"yakhāfūna"},{"position":5,"arabic":"ٱلْـَٔاخِرَةَ","translation":"the Hereafter","transliteration":"l-ākhirata"}],"e3rab":"و(كَلَّا) حرف ردع وزجر و(بَلْ) حرف إضراب و(لا) نافية و(يَخافُونَ) مضارع مرفوع والواو فاعله و(الْآخِرَةَ) مفعول به والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":74,"ayah":54,"words":[{"position":1,"arabic":"كَلَّآ","translation":"Nay","transliteration":"kallā"},{"position":2,"arabic":"إِنَّهُۥ","translation":"Indeed, it","transliteration":"innahu"},{"position":3,"arabic":"تَذْكِرَةٌۭ","translation":"(is) a Reminder","transliteration":"tadhkiratun"}],"e3rab":"(كَلَّا) توكيد لما قبلها و(إِنَّهُ تَذْكِرَةٌ) واسمها وخبرها والجملة ابتدائية لا محل لها\r\n\r\n"},{"sura":74,"ayah":55,"words":[{"position":1,"arabic":"فَمَن","translation":"So whoever","transliteration":"faman"},{"position":2,"arabic":"شَآءَ","translation":"wills","transliteration":"shāa"},{"position":3,"arabic":"ذَكَرَهُۥ","translation":"(may) pay heed to it","transliteration":"dhakarahu"}],"e3rab":"و(فَمَنْ) الفاء حرف عطف و(من) اسم شرط جازم مبتدأ و(شاءَ) ماض فاعله مستتر وهو فعل الشرط و(ذَكَرَهُ) ماض ومفعوله والفاعل مستتر والجملة جواب الشرط لا محل لها وجملتا الشرط والجواب خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها\r\n\r\n"},{"sura":74,"ayah":56,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"يَذْكُرُونَ","translation":"will pay heed","transliteration":"yadhkurūna"},{"position":3,"arabic":"إِلَّآ","translation":"except","transliteration":"illā"},{"position":4,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":5,"arabic":"يَشَآءَ","translation":"wills","transliteration":"yashāa"},{"position":6,"arabic":"ٱللَّهُ ۚ","translation":"Allah","transliteration":"l-lahu"},{"position":7,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":8,"arabic":"أَهْلُ","translation":"(is) worthy","transliteration":"ahlu"},{"position":9,"arabic":"ٱلتَّقْوَىٰ","translation":"to be feared","transliteration":"l-taqwā"},{"position":10,"arabic":"وَأَهْلُ","translation":"and worthy","transliteration":"wa-ahlu"},{"position":11,"arabic":"ٱلْمَغْفِرَةِ","translation":"to forgive","transliteration":"l-maghfirati"}],"e3rab":"(وَما) نافية و(يَذْكُرُونَ) مضارع وفاعله والجملة مستأنفة لا محل لها  و(إِلَّا) حرف استثناء و(أَنْ يَشاءَ اللَّهُ) مضارع منصوب بأن ولفظ الجلالة فاعله والمصدر المؤول من أن والفعل منصوب على الاستثناء و(هُوَ أَهْلُ) مبتدأ وخبره المضاف إلى (التَّقْوى) والجملة الاسمية تعليل لا محل لها و(أَهْلُ الْمَغْفِرَةِ) معطوفة على ما قبلها.\r\n\r\n"}]