[{"sura":76,"ayah":1,"words":[{"position":1,"arabic":"هَلْ","translation":"Has","transliteration":"hal"},{"position":2,"arabic":"أَتَىٰ","translation":"(there) come","transliteration":"atā"},{"position":3,"arabic":"عَلَى","translation":"upon","transliteration":"ʿalā"},{"position":4,"arabic":"ٱلْإِنسَـٰنِ","translation":"man","transliteration":"l-insāni"},{"position":5,"arabic":"حِينٌۭ","translation":"a period","transliteration":"ḥīnun"},{"position":6,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":7,"arabic":"ٱلدَّهْرِ","translation":"time","transliteration":"l-dahri"},{"position":8,"arabic":"لَمْ","translation":"not","transliteration":"lam"},{"position":9,"arabic":"يَكُن","translation":"he was","transliteration":"yakun"},{"position":10,"arabic":"شَيْـًۭٔا","translation":"a thing","transliteration":"shayan"},{"position":11,"arabic":"مَّذْكُورًا","translation":"mentioned","transliteration":"madhkūran"}],"e3rab":"(هَلْ أَتى) حرف استفهام للتشويق وماض و(عَلَى الْإِنْسانِ) متعلقان بالفعل و(حِينٌ) فاعل أتى و(مِنَ الدَّهْرِ) متعلقان بمحذوف صفة حين والجملة ابتدائية لا محل لها. و(لَمْ يَكُنْ) مضارع ناقص مجزوم بلم واسمه مستتر و(شَيْئاً) خبر يكن و(مَذْكُوراً) صفة والجملة حال.\r\n\r\n"},{"sura":76,"ayah":2,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"خَلَقْنَا","translation":"[We] created","transliteration":"khalaqnā"},{"position":3,"arabic":"ٱلْإِنسَـٰنَ","translation":"man","transliteration":"l-insāna"},{"position":4,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":5,"arabic":"نُّطْفَةٍ","translation":"a semen-drop","transliteration":"nuṭ'fatin"},{"position":6,"arabic":"أَمْشَاجٍۢ","translation":"a mixture","transliteration":"amshājin"},{"position":7,"arabic":"نَّبْتَلِيهِ","translation":"(that) We test him","transliteration":"nabtalīhi"},{"position":8,"arabic":"فَجَعَلْنَـٰهُ","translation":"so We made (for) him","transliteration":"fajaʿalnāhu"},{"position":9,"arabic":"سَمِيعًۢا","translation":"hearing","transliteration":"samīʿan"},{"position":10,"arabic":"بَصِيرًا","translation":"and sight","transliteration":"baṣīran"}],"e3rab":"(إِنَّا خَلَقْنَا الْإِنْسانَ) إن واسمها وماض وفاعله ومفعوله والجملة الفعلية خبر إنا والجملة الاسمية مستأنفة لا محل لها و(مِنْ نُطْفَةٍ) متعلقان بالفعل و(أَمْشاجٍ) صفة نطفة و(نَبْتَلِيهِ) مضارع ومفعوله والفاعل مستتر والجملة حال. و(فَجَعَلْناهُ) ماض وفاعله ومفعوله الأول و(سَمِيعاً) مفعول به ثان و(بَصِيراً) صفة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":76,"ayah":3,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"هَدَيْنَـٰهُ","translation":"guided him","transliteration":"hadaynāhu"},{"position":3,"arabic":"ٱلسَّبِيلَ","translation":"(to) the way","transliteration":"l-sabīla"},{"position":4,"arabic":"إِمَّا","translation":"whether","transliteration":"immā"},{"position":5,"arabic":"شَاكِرًۭا","translation":"(he) be grateful","transliteration":"shākiran"},{"position":6,"arabic":"وَإِمَّا","translation":"and whether","transliteration":"wa-immā"},{"position":7,"arabic":"كَفُورًا","translation":"(he) be ungrateful","transliteration":"kafūran"}],"e3rab":"(إِنَّا هَدَيْناهُ) إن واسمها وماض وفاعله ومفعوله الأول و(السَّبِيلَ) مفعوله الثاني والجملة الفعلية خبر إنا والجملة الاسمية تعليل لا محل لها و(إِمَّا) أداة شرط وتفصيل و(شاكِراً) حال (وَإِمَّا كَفُوراً) معطوف على ما قبله.\r\n\r\n"},{"sura":76,"ayah":4,"words":[{"position":1,"arabic":"إِنَّآ","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"أَعْتَدْنَا","translation":"[We] have prepared","transliteration":"aʿtadnā"},{"position":3,"arabic":"لِلْكَـٰفِرِينَ","translation":"for the disbelievers","transliteration":"lil'kāfirīna"},{"position":4,"arabic":"سَلَـٰسِلَا۟","translation":"chains","transliteration":"salāsilā"},{"position":5,"arabic":"وَأَغْلَـٰلًۭا","translation":"and shackles","transliteration":"wa-aghlālan"},{"position":6,"arabic":"وَسَعِيرًا","translation":"and a Blazing Fire","transliteration":"wasaʿīran"}],"e3rab":"(إِنَّا أَعْتَدْنا) إن واسمها وماض وفاعله والجملة الفعلية خبر إنا والجملة الاسمية مستأنفة و(لِلْكافِرِينَ) متعلقان بالفعل و(سَلاسِلَ) مفعول به (وَأَغْلالًا وَسَعِيراً) معطوفان على ما قبلهما.\r\n\r\n"},{"sura":76,"ayah":5,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلْأَبْرَارَ","translation":"the righteous","transliteration":"l-abrāra"},{"position":3,"arabic":"يَشْرَبُونَ","translation":"will drink","transliteration":"yashrabūna"},{"position":4,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":5,"arabic":"كَأْسٍۢ","translation":"a cup","transliteration":"kasin"},{"position":6,"arabic":"كَانَ","translation":"is","transliteration":"kāna"},{"position":7,"arabic":"مِزَاجُهَا","translation":"its mixture","transliteration":"mizājuhā"},{"position":8,"arabic":"كَافُورًا","translation":"(of) Kafur","transliteration":"kāfūran"}],"e3rab":"(إِنَّ الْأَبْرارَ يَشْرَبُونَ) إن واسمها ومضارع مرفوع والواو فاعله و(مِنْ كَأْسٍ) متعلقان بمحذوف صفة لمفعول محذوف والجملة الفعلية خبر إن والجملة الاسمية مستأنفة و(كانَ مِزاجُها كافُوراً) كان واسمها وخبرها والجملة صفة كأس.\r\n\r\n"},{"sura":76,"ayah":6,"words":[{"position":1,"arabic":"عَيْنًۭا","translation":"A spring ","transliteration":"ʿaynan"},{"position":2,"arabic":"يَشْرَبُ","translation":"will drink","transliteration":"yashrabu"},{"position":3,"arabic":"بِهَا","translation":"from it","transliteration":"bihā"},{"position":4,"arabic":"عِبَادُ","translation":"(the) slaves","transliteration":"ʿibādu"},{"position":5,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":6,"arabic":"يُفَجِّرُونَهَا","translation":"causing it to gush forth","transliteration":"yufajjirūnahā"},{"position":7,"arabic":"تَفْجِيرًۭا","translation":"abundantly","transliteration":"tafjīran"}],"e3rab":"(عَيْناً) بدل من كافورا و(يَشْرَبُ) مضارع و(بِها) متعلقان بالفعل و(عِبادُ اللَّهِ) فاعل مضاف إلى لفظ الجلالة والجملة الفعلية صفة عينا و(يُفَجِّرُونَها) مضارع وفاعله ومفعوله والجملة حال و(تَفْجِيراً) مفعول مطلق.\r\n\r\n"},{"sura":76,"ayah":7,"words":[{"position":1,"arabic":"يُوفُونَ","translation":"They fulfill","transliteration":"yūfūna"},{"position":2,"arabic":"بِٱلنَّذْرِ","translation":"the vows","transliteration":"bil-nadhri"},{"position":3,"arabic":"وَيَخَافُونَ","translation":"and fear","transliteration":"wayakhāfūna"},{"position":4,"arabic":"يَوْمًۭا","translation":"a Day ","transliteration":"yawman"},{"position":5,"arabic":"كَانَ","translation":"(which) is","transliteration":"kāna"},{"position":6,"arabic":"شَرُّهُۥ","translation":"its evil","transliteration":"sharruhu"},{"position":7,"arabic":"مُسْتَطِيرًۭا","translation":"widespread","transliteration":"mus'taṭīran"}],"e3rab":"(يُوفُونَ) مضارع مرفوع والواو فاعله و(بِالنَّذْرِ) متعلقان بالفعل والجملة مستأنفة و(وَيَخافُونَ) مضارع وفاعله و(يَوْماً) مفعول به والجملة معطوفة على ما قبلها و(كانَ شَرُّهُ مُسْتَطِيراً) كان واسمها وخبرها والجملة صفة يوما.\r\n\r\n"},{"sura":76,"ayah":8,"words":[{"position":1,"arabic":"وَيُطْعِمُونَ","translation":"And they feed","transliteration":"wayuṭ'ʿimūna"},{"position":2,"arabic":"ٱلطَّعَامَ","translation":"the food","transliteration":"l-ṭaʿāma"},{"position":3,"arabic":"عَلَىٰ","translation":"in spite of","transliteration":"ʿalā"},{"position":4,"arabic":"حُبِّهِۦ","translation":"love (for) it","transliteration":"ḥubbihi"},{"position":5,"arabic":"مِسْكِينًۭا","translation":"(to the) needy","transliteration":"mis'kīnan"},{"position":6,"arabic":"وَيَتِيمًۭا","translation":"and (the) orphan","transliteration":"wayatīman"},{"position":7,"arabic":"وَأَسِيرًا","translation":"and (the) captive","transliteration":"wa-asīran"}],"e3rab":"(وَيُطْعِمُونَ) مضارع مرفوع والواو فاعله و(الطَّعامَ) مفعول به أول والجملة معطوفة على ما قبلها و(عَلى حُبِّهِ) متعلقان بالفعل و(مِسْكِيناً) مفعول به ثان و(يَتِيماً وَأَسِيراً) معطوفان على ما قبلهما.\r\n\r\n"},{"sura":76,"ayah":9,"words":[{"position":1,"arabic":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"position":2,"arabic":"نُطْعِمُكُمْ","translation":"we feed you","transliteration":"nuṭ'ʿimukum"},{"position":3,"arabic":"لِوَجْهِ","translation":"for (the) Countenance","transliteration":"liwajhi"},{"position":4,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":5,"arabic":"لَا","translation":"Not","transliteration":"lā"},{"position":6,"arabic":"نُرِيدُ","translation":"we desire","transliteration":"nurīdu"},{"position":7,"arabic":"مِنكُمْ","translation":"from you","transliteration":"minkum"},{"position":8,"arabic":"جَزَآءًۭ","translation":"any reward","transliteration":"jazāan"},{"position":9,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":10,"arabic":"شُكُورًا","translation":"thanks","transliteration":"shukūran"}],"e3rab":"(إِنَّما نُطْعِمُكُمْ) كافة ومكفوفة ومضارع ومفعوله والفاعل مستتر والجملة مقول قول مقدر و(لِوَجْهِ اللَّهِ) متعلقان بالفعل ولفظ الجلالة مضاف إليه و(لا) نافية و(نُرِيدُ) مضارع فاعله مستتر و(مِنْكُمْ) متعلقان بالفعل و(جَزاءً) مفعول به والجملة حال (وَلا) نافية و(شُكُوراً) معطوف على جزاء.\r\n\r\n"},{"sura":76,"ayah":10,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, we","transliteration":"innā"},{"position":2,"arabic":"نَخَافُ","translation":"fear","transliteration":"nakhāfu"},{"position":3,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":4,"arabic":"رَّبِّنَا","translation":"our Lord","transliteration":"rabbinā"},{"position":5,"arabic":"يَوْمًا","translation":"a Day ","transliteration":"yawman"},{"position":6,"arabic":"عَبُوسًۭا","translation":"harsh","transliteration":"ʿabūsan"},{"position":7,"arabic":"قَمْطَرِيرًۭا","translation":"and distressful","transliteration":"qamṭarīran"}],"e3rab":"(إِنَّا نَخافُ) إن واسمها ومضارع فاعله مستتر و(مِنْ رَبِّنا) متعلقان بالفعل و(يَوْماً) مفعول به و(عَبُوساً) صفة يوما و(قَمْطَرِيراً) صفة ثانية والجملة الفعلية خبر إنا والجملة الاسمية تعليل.\r\n\r\n"},{"sura":76,"ayah":11,"words":[{"position":1,"arabic":"فَوَقَىٰهُمُ","translation":"But will protect them","transliteration":"fawaqāhumu"},{"position":2,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":3,"arabic":"شَرَّ","translation":"(from the) evil","transliteration":"sharra"},{"position":4,"arabic":"ذَٰلِكَ","translation":"(of) that","transliteration":"dhālika"},{"position":5,"arabic":"ٱلْيَوْمِ","translation":"Day","transliteration":"l-yawmi"},{"position":6,"arabic":"وَلَقَّىٰهُمْ","translation":"and will cause them to meet","transliteration":"walaqqāhum"},{"position":7,"arabic":"نَضْرَةًۭ","translation":"radiance","transliteration":"naḍratan"},{"position":8,"arabic":"وَسُرُورًۭا","translation":"and happiness","transliteration":"wasurūran"}],"e3rab":"(فَوَقاهُمُ اللَّهُ) الفاء حرف استئناف وماض ومفعوله الأول ولفظ الجلالة فاعل و(شَرَّ ذلِكَ) مفعول به ثان مضاف إلى اسم الإشارة و(الْيَوْمِ) بدل من اسم الإشارة والجملة مستأنفة (وَلَقَّاهُمْ) معطوف على فوقاهم (نَضْرَةً) مفعول به ثان و(سُرُوراً) معطوف على نضرة.\r\n\r\n"},{"sura":76,"ayah":12,"words":[{"position":1,"arabic":"وَجَزَىٰهُم","translation":"And will reward them","transliteration":"wajazāhum"},{"position":2,"arabic":"بِمَا","translation":"because","transliteration":"bimā"},{"position":3,"arabic":"صَبَرُوا۟","translation":"they were patient","transliteration":"ṣabarū"},{"position":4,"arabic":"جَنَّةًۭ","translation":"(with) a Garden","transliteration":"jannatan"},{"position":5,"arabic":"وَحَرِيرًۭا","translation":"and silk","transliteration":"waḥarīran"}],"e3rab":"(وَجَزاهُمْ) ماض ومفعوله الأول والفاعل مستتر والجملة معطوفة على ما قبلها و(بِما صَبَرُوا) الباء حرف جر وما مصدرية وماض وفاعله والمصدر المؤول من ما والفعل في محل جر بالباء والجار متعلقان بالفعل و(جَنَّةً) مفعول به ثان و(حَرِيراً) معطوف على جنة.\r\n\r\n"},{"sura":76,"ayah":13,"words":[{"position":1,"arabic":"مُّتَّكِـِٔينَ","translation":"Reclining","transliteration":"muttakiīna"},{"position":2,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":3,"arabic":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":4,"arabic":"ٱلْأَرَآئِكِ ۖ","translation":"couches","transliteration":"l-arāiki"},{"position":5,"arabic":"لَا","translation":"Not","transliteration":"lā"},{"position":6,"arabic":"يَرَوْنَ","translation":"they will see","transliteration":"yarawna"},{"position":7,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":8,"arabic":"شَمْسًۭا","translation":"sun","transliteration":"shamsan"},{"position":9,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":10,"arabic":"زَمْهَرِيرًۭا","translation":"freezing cold","transliteration":"zamharīran"}],"e3rab":"(مُتَّكِئِينَ) حال منصوبة و(فِيها) متعلقان بما قبلهما و(عَلَى الْأَرائِكِ) متعلقان بمحذوف حال من الضمير المستتر بمتكئين. و(لا) نافية و(يَرَوْنَ) مضارع مرفوع والواو فاعله و(فِيها) متعلقان بالفعل و(شَمْساً) مفعول به (وَ) الواو حرف عطف و(لا زَمْهَرِيراً) معطوف على شمسا والجملة حال.\r\n\r\n"},{"sura":76,"ayah":14,"words":[{"position":1,"arabic":"وَدَانِيَةً","translation":"And near","transliteration":"wadāniyatan"},{"position":2,"arabic":"عَلَيْهِمْ","translation":"above them","transliteration":"ʿalayhim"},{"position":3,"arabic":"ظِلَـٰلُهَا","translation":"(are) its shades","transliteration":"ẓilāluhā"},{"position":4,"arabic":"وَذُلِّلَتْ","translation":"and will hang low","transliteration":"wadhullilat"},{"position":5,"arabic":"قُطُوفُهَا","translation":"its cluster of fruits","transliteration":"quṭūfuhā"},{"position":6,"arabic":"تَذْلِيلًۭا","translation":"dangling low","transliteration":"tadhlīlan"}],"e3rab":"(وَدانِيَةً) معطوفة على متكئين و(عَلَيْهِمْ) متعلقان بدانية و(ظِلالُها) فاعل دانية و(وَذُلِّلَتْ) ماض مبني للمجهول و(قُطُوفُها) نائب فاعل و(تَذْلِيلًا) مفعول مطلق والجملة معطوفة على دانية.\r\n\r\n"},{"sura":76,"ayah":15,"words":[{"position":1,"arabic":"وَيُطَافُ","translation":"And will be circulated","transliteration":"wayuṭāfu"},{"position":2,"arabic":"عَلَيْهِم","translation":"among them","transliteration":"ʿalayhim"},{"position":3,"arabic":"بِـَٔانِيَةٍۢ","translation":"vessels","transliteration":"biāniyatin"},{"position":4,"arabic":"مِّن","translation":"of","transliteration":"min"},{"position":5,"arabic":"فِضَّةٍۢ","translation":"silver","transliteration":"fiḍḍatin"},{"position":6,"arabic":"وَأَكْوَابٍۢ","translation":"and cups","transliteration":"wa-akwābin"},{"position":7,"arabic":"كَانَتْ","translation":"(that) are","transliteration":"kānat"},{"position":8,"arabic":"قَوَارِيرَا۠","translation":"(of) crystal","transliteration":"qawārīrā"}],"e3rab":"(وَيُطافُ) مضارع مبني للمجهول و(عَلَيْهِمْ) متعلقان بالفعل و(بِآنِيَةٍ) متعلقان بالفعل و(مِنْ فِضَّةٍ) صفة آنية والجملة معطوفة على ما قبلها (وَأَكْوابٍ) معطوف على ما قبله (كانَتْ) ماض ناقص اسمه مستتر و(قَوارِيرَا) خبره والجملة الفعلية صفة أكواب.\r\n\r\n"},{"sura":76,"ayah":16,"words":[{"position":1,"arabic":"قَوَارِيرَا۟","translation":"Crystal-clear","transliteration":"qawārīrā"},{"position":2,"arabic":"مِن","translation":"of","transliteration":"min"},{"position":3,"arabic":"فِضَّةٍۢ","translation":"silver","transliteration":"fiḍḍatin"},{"position":4,"arabic":"قَدَّرُوهَا","translation":"They will determine its","transliteration":"qaddarūhā"},{"position":5,"arabic":"تَقْدِيرًۭا","translation":"measure","transliteration":"taqdīran"}],"e3rab":"(قَوارِيرَا) بدل مما قبله و(مِنْ فِضَّةٍ) صفة قوارير و(قَدَّرُوها) ماض وفاعله ومفعوله و(تَقْدِيراً) مفعول مطلق والجملة حال.\r\n\r\n"},{"sura":76,"ayah":17,"words":[{"position":1,"arabic":"وَيُسْقَوْنَ","translation":"And they will be given to drink","transliteration":"wayus'qawna"},{"position":2,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":3,"arabic":"كَأْسًۭا","translation":"a cup ","transliteration":"kasan"},{"position":4,"arabic":"كَانَ","translation":"is","transliteration":"kāna"},{"position":5,"arabic":"مِزَاجُهَا","translation":"its mixture","transliteration":"mizājuhā"},{"position":6,"arabic":"زَنجَبِيلًا","translation":"(of) Zanjabil","transliteration":"zanjabīlan"}],"e3rab":"(وَيُسْقَوْنَ) حرف عطف ومضارع مبني للمجهول والواو نائب فاعل و(فِيها) متعلقان بالفعل و(كَأْساً) مفعول به ثان والجملة معطوفة على ما قبلها و(كانَ مِزاجُها زَنْجَبِيلًا) كان واسمها وخبرها والجملة صفة كأسا.\r\n\r\n"},{"sura":76,"ayah":18,"words":[{"position":1,"arabic":"عَيْنًۭا","translation":"A spring","transliteration":"ʿaynan"},{"position":2,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":3,"arabic":"تُسَمَّىٰ","translation":"named","transliteration":"tusammā"},{"position":4,"arabic":"سَلْسَبِيلًۭا","translation":"Salsabil","transliteration":"salsabīlan"}],"e3rab":"(عَيْناً) بدل من زنجبيلا و(فِيها) صفة عينا و(تُسَمَّى) مضارع مبني للمجهول ونائب الفاعل مستتر و(سَلْسَبِيلًا) مفعول به ثان والجملة صفة ثانية لعينا.\r\n\r\n"},{"sura":76,"ayah":19,"words":[{"position":1,"arabic":"۞ وَيَطُوفُ","translation":"And will circulate","transliteration":"wayaṭūfu"},{"position":2,"arabic":"عَلَيْهِمْ","translation":"among them","transliteration":"ʿalayhim"},{"position":3,"arabic":"وِلْدَٰنٌۭ","translation":"young boys","transliteration":"wil'dānun"},{"position":4,"arabic":"مُّخَلَّدُونَ","translation":"made eternal","transliteration":"mukhalladūna"},{"position":5,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":6,"arabic":"رَأَيْتَهُمْ","translation":"you see them","transliteration":"ra-aytahum"},{"position":7,"arabic":"حَسِبْتَهُمْ","translation":"you would think them","transliteration":"ḥasib'tahum"},{"position":8,"arabic":"لُؤْلُؤًۭا","translation":"(to be) pearls","transliteration":"lu'lu-an"},{"position":9,"arabic":"مَّنثُورًۭا","translation":"scattered","transliteration":"manthūran"}],"e3rab":"(وَيَطُوفُ) مضارع مرفوع و(عَلَيْهِمْ) متعلقان بالفعل و(وِلْدانٌ) فاعل و(مُخَلَّدُونَ) صفة ولدان والجملة معطوفة على ما قبلها. و(إِذا) ظرفية شرطية غير جازمة و(رَأَيْتَهُمْ) ماض وفاعله ومفعوله والجملة في محل جر بالإضافة و(حَسِبْتَهُمْ) ماض وفاعله ومفعوله الأول و(لُؤْلُؤاً) مفعول به ثان و(مَنْثُوراً) صفة لؤلؤا والجملة جواب الشرط لا محل لها.\r\n\r\n"},{"sura":76,"ayah":20,"words":[{"position":1,"arabic":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"arabic":"رَأَيْتَ","translation":"you look","transliteration":"ra-ayta"},{"position":3,"arabic":"ثَمَّ","translation":"then","transliteration":"thamma"},{"position":4,"arabic":"رَأَيْتَ","translation":"you will see","transliteration":"ra-ayta"},{"position":5,"arabic":"نَعِيمًۭا","translation":"blessings","transliteration":"naʿīman"},{"position":6,"arabic":"وَمُلْكًۭا","translation":"and a kingdom","transliteration":"wamul'kan"},{"position":7,"arabic":"كَبِيرًا","translation":"great","transliteration":"kabīran"}],"e3rab":"(وَإِذا) الواو حرف عطف و(إِذا) ظرفية شرطية غير جازمة و(رَأَيْتَ) ماض وفاعله والجملة في محل جر بالإضافة و(ثَمَّ) ظرف مكان و(رَأَيْتَ) ماض وفاعله و(نَعِيماً) مفعول به (وَمُلْكاً) معطوف على نعيما و(كَبِيراً) صفة والجملة جواب الشرط لا محل لها.\r\n\r\n"},{"sura":76,"ayah":21,"words":[{"position":1,"arabic":"عَـٰلِيَهُمْ","translation":"Upon them","transliteration":"ʿāliyahum"},{"position":2,"arabic":"ثِيَابُ","translation":"(will be) garments","transliteration":"thiyābu"},{"position":3,"arabic":"سُندُسٍ","translation":"(of) fine silk","transliteration":"sundusin"},{"position":4,"arabic":"خُضْرٌۭ","translation":"green","transliteration":"khuḍ'run"},{"position":5,"arabic":"وَإِسْتَبْرَقٌۭ ۖ","translation":"and heavy brocade","transliteration":"wa-is'tabraqun"},{"position":6,"arabic":"وَحُلُّوٓا۟","translation":"And they will be adorned","transliteration":"waḥullū"},{"position":7,"arabic":"أَسَاوِرَ","translation":"(with) bracelets","transliteration":"asāwira"},{"position":8,"arabic":"مِن","translation":"of","transliteration":"min"},{"position":9,"arabic":"فِضَّةٍۢ","translation":"silver","transliteration":"fiḍḍatin"},{"position":10,"arabic":"وَسَقَىٰهُمْ","translation":"and will give them to drink","transliteration":"wasaqāhum"},{"position":11,"arabic":"رَبُّهُمْ","translation":"their Lord","transliteration":"rabbuhum"},{"position":12,"arabic":"شَرَابًۭا","translation":"a drink","transliteration":"sharāban"},{"position":13,"arabic":"طَهُورًا","translation":"pure","transliteration":"ṭahūran"}],"e3rab":"(عالِيَهُمْ) ظرف مكان متعلق بمحذوف خبر مقدم و(ثِيابُ) مبتدأ مؤخر مضاف إلى (سُندُسٍ) و(خُضْرٌ) صفة ثياب والجملة الاسمية مستأنفة و(إِسْتَبْرَقٌ) معطوف على ثياب.\r\n\r\n(وَحُلُّوا) الواو حالية وماض مبني للمجهول ونائب فاعل و(أَساوِرَ) مفعول به ثان و(مِنْ فِضَّةٍ) صفة أساور والجملة حالية.\r\n\r\n(وَسَقاهُمْ) ماض ومفعوله الأول و(رَبُّهُمْ) فاعل و(شَراباً) مفعول به ثان و(طَهُوراً) صفة شرابا والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":76,"ayah":22,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"هَـٰذَا","translation":"this","transliteration":"hādhā"},{"position":3,"arabic":"كَانَ","translation":"is","transliteration":"kāna"},{"position":4,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":5,"arabic":"جَزَآءًۭ","translation":"a reward","transliteration":"jazāan"},{"position":6,"arabic":"وَكَانَ","translation":"and has been","transliteration":"wakāna"},{"position":7,"arabic":"سَعْيُكُم","translation":"your effort","transliteration":"saʿyukum"},{"position":8,"arabic":"مَّشْكُورًا","translation":"appreciated","transliteration":"mashkūran"}],"e3rab":"(إِنَّ هذا كانَ) إن واسمها وماض ناقص اسمه مستتر و(لَكُمْ) متعلقان بالخبر (جَزاءً) خبر وجملة كان خبر إن والجملة مقول قول محذوف (وَكانَ سَعْيُكُمْ مَشْكُوراً) كان واسمها وخبرها والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":76,"ayah":23,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"نَحْنُ","translation":"[We]","transliteration":"naḥnu"},{"position":3,"arabic":"نَزَّلْنَا","translation":"[We] revealed","transliteration":"nazzalnā"},{"position":4,"arabic":"عَلَيْكَ","translation":"to you","transliteration":"ʿalayka"},{"position":5,"arabic":"ٱلْقُرْءَانَ","translation":"the Quran","transliteration":"l-qur'āna"},{"position":6,"arabic":"تَنزِيلًۭا","translation":"progressively","transliteration":"tanzīlan"}],"e3rab":"(إِنَّا) إن واسمها و(نَحْنُ) ضمير فصل و(نَزَّلْنا) ماض وفاعله والجملة خبر إنا والجملة الاسمية مستأنفة و(عَلَيْكَ) متعلقان بالفعل و(الْقُرْآنَ) مفعول به و(تَنْزِيلًا) مفعول مطلق.\r\n\r\n"},{"sura":76,"ayah":24,"words":[{"position":1,"arabic":"فَٱصْبِرْ","translation":"So be patient","transliteration":"fa-iṣ'bir"},{"position":2,"arabic":"لِحُكْمِ","translation":"for (the) Command","transliteration":"liḥuk'mi"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":5,"arabic":"تُطِعْ","translation":"obey","transliteration":"tuṭiʿ"},{"position":6,"arabic":"مِنْهُمْ","translation":"from them","transliteration":"min'hum"},{"position":7,"arabic":"ءَاثِمًا","translation":"any sinner","transliteration":"āthiman"},{"position":8,"arabic":"أَوْ","translation":"or","transliteration":"aw"},{"position":9,"arabic":"كَفُورًۭا","translation":"disbeliever","transliteration":"kafūran"}],"e3rab":"(فَاصْبِرْ) الفاء الفصيحة وأمر فاعله مستتر و(لِحُكْمِ) متعلقان بالفعل و(رَبِّكَ) مضاف إليه والجملة جواب شرط مقدر لا محل لها. و(وَلا تُطِعْ) مضارع مجزوم بلا فاعله مستتر و(مِنْهُمْ) متعلقان بالفعل و(آثِماً) مفعول به و(أَوْ) حرف عطف و(كَفُوراً) معطوف على آثما والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":76,"ayah":25,"words":[{"position":1,"arabic":"وَٱذْكُرِ","translation":"And remember","transliteration":"wa-udh'kuri"},{"position":2,"arabic":"ٱسْمَ","translation":"(the) name","transliteration":"is'ma"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"بُكْرَةًۭ","translation":"morning","transliteration":"buk'ratan"},{"position":5,"arabic":"وَأَصِيلًۭا","translation":"and evening","transliteration":"wa-aṣīlan"}],"e3rab":"(وَاذْكُرِ) أمر فاعله مستتر و(اسْمَ) مفعول به مضاف إلى (رَبِّكَ) مضاف إليه (بُكْرَةً) ظرف زمان (وَأَصِيلًا) معطوف على بكرة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":76,"ayah":26,"words":[{"position":1,"arabic":"وَمِنَ","translation":"And of","transliteration":"wamina"},{"position":2,"arabic":"ٱلَّيْلِ","translation":"the night","transliteration":"al-layli"},{"position":3,"arabic":"فَٱسْجُدْ","translation":"prostrate","transliteration":"fa-us'jud"},{"position":4,"arabic":"لَهُۥ","translation":"to Him","transliteration":"lahu"},{"position":5,"arabic":"وَسَبِّحْهُ","translation":"and glorify Him","transliteration":"wasabbiḥ'hu"},{"position":6,"arabic":"لَيْلًۭا","translation":"a night","transliteration":"laylan"},{"position":7,"arabic":"طَوِيلًا","translation":"long","transliteration":"ṭawīlan"}],"e3rab":"(وَمِنَ اللَّيْلِ) متعلقان باسجد و(فَاسْجُدْ) الفاء زائدة وأمر فاعله مستتر و(لَهُ) متعلقان بالفعل و(وَسَبِّحْهُ) أمر ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها و(لَيْلًا) ظرف زمان و(طَوِيلًا) صفة.\r\n\r\n"},{"sura":76,"ayah":27,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"هَـٰٓؤُلَآءِ","translation":"these","transliteration":"hāulāi"},{"position":3,"arabic":"يُحِبُّونَ","translation":"love","transliteration":"yuḥibbūna"},{"position":4,"arabic":"ٱلْعَاجِلَةَ","translation":"the immediate","transliteration":"l-ʿājilata"},{"position":5,"arabic":"وَيَذَرُونَ","translation":"and leave","transliteration":"wayadharūna"},{"position":6,"arabic":"وَرَآءَهُمْ","translation":"behind them","transliteration":"warāahum"},{"position":7,"arabic":"يَوْمًۭا","translation":"a Day","transliteration":"yawman"},{"position":8,"arabic":"ثَقِيلًۭا","translation":"grave","transliteration":"thaqīlan"}],"e3rab":"(إِنَّ هؤُلاءِ يُحِبُّونَ) إن واسمها ومضارع مرفوع والواو فاعله و(الْعاجِلَةَ) مفعول به والجملة الفعلية خبر إن والجملة الاسمية تعليل، (وَيَذَرُونَ) مضارع وفاعله (وَراءَهُمْ) ظرف مكان و(يَوْماً) مفعول به و(ثَقِيلًا) صفة يوما والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":76,"ayah":28,"words":[{"position":1,"arabic":"نَّحْنُ","translation":"We","transliteration":"naḥnu"},{"position":2,"arabic":"خَلَقْنَـٰهُمْ","translation":"created them","transliteration":"khalaqnāhum"},{"position":3,"arabic":"وَشَدَدْنَآ","translation":"and We strengthened","transliteration":"washadadnā"},{"position":4,"arabic":"أَسْرَهُمْ ۖ","translation":"their forms","transliteration":"asrahum"},{"position":5,"arabic":"وَإِذَا","translation":"and when","transliteration":"wa-idhā"},{"position":6,"arabic":"شِئْنَا","translation":"We will","transliteration":"shi'nā"},{"position":7,"arabic":"بَدَّلْنَآ","translation":"We can change","transliteration":"baddalnā"},{"position":8,"arabic":"أَمْثَـٰلَهُمْ","translation":"their likeness[es]","transliteration":"amthālahum"},{"position":9,"arabic":"تَبْدِيلًا","translation":"(with) a change","transliteration":"tabdīlan"}],"e3rab":"(نَحْنُ خَلَقْناهُمْ) مبتدأ وماض وفاعله ومفعوله والجملة الفعلية خبر المبتدأ والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n(وَشَدَدْنا أَسْرَهُمْ) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها (وَإِذا) ظرفية شرطية غير جازمة و(شِئْنا) ماض وفاعله والجملة في محل جر بالإضافة و(بَدَّلْنا) ماض وفاعله و(أَمْثالَهُمْ) مفعول به و(تَبْدِيلًا) مفعول مطلق والجملة جواب الشرط لا محل لها.\r\n\r\n"},{"sura":76,"ayah":29,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"هَـٰذِهِۦ","translation":"this","transliteration":"hādhihi"},{"position":3,"arabic":"تَذْكِرَةٌۭ ۖ","translation":"(is) a reminder","transliteration":"tadhkiratun"},{"position":4,"arabic":"فَمَن","translation":"so whoever","transliteration":"faman"},{"position":5,"arabic":"شَآءَ","translation":"wills","transliteration":"shāa"},{"position":6,"arabic":"ٱتَّخَذَ","translation":"let him take","transliteration":"ittakhadha"},{"position":7,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":8,"arabic":"رَبِّهِۦ","translation":"his Lord","transliteration":"rabbihi"},{"position":9,"arabic":"سَبِيلًۭا","translation":"a way","transliteration":"sabīlan"}],"e3rab":"سبق إعرابها في الآية - 19 - من سورة المزمل.\r\n\r\n"},{"sura":76,"ayah":30,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"تَشَآءُونَ","translation":"you will","transliteration":"tashāūna"},{"position":3,"arabic":"إِلَّآ","translation":"except","transliteration":"illā"},{"position":4,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":5,"arabic":"يَشَآءَ","translation":"wills","transliteration":"yashāa"},{"position":6,"arabic":"ٱللَّهُ ۚ","translation":"Allah","transliteration":"l-lahu"},{"position":7,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":8,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":9,"arabic":"كَانَ","translation":"is","transliteration":"kāna"},{"position":10,"arabic":"عَلِيمًا","translation":"All-Knower","transliteration":"ʿalīman"},{"position":11,"arabic":"حَكِيمًۭا","translation":"All-Wise","transliteration":"ḥakīman"}],"e3rab":"(وَما) نافية و(تَشاؤُنَ) مضارع مرفوع والواو فاعل والجملة مستأنفة و(إِلَّا) حرف حصر (أَنْ يَشاءَ اللَّهُ) مضارع منصوب بأن ولفظ الجلالة فاعل والمصدر المؤول من أن والفعل في محل جر بالإضافة لظرف محذوف أي إلا وقت مشيئة اللّه و(إِنَّ اللَّهَ كانَ) إن واسمها وماض ناقص اسمه مستتر و(عَلِيماً حَكِيماً) خبران والجملة الفعلية خبر إن والجملة الاسمية تعليلية.\r\n\r\n"},{"sura":76,"ayah":31,"words":[{"position":1,"arabic":"يُدْخِلُ","translation":"He admits","transliteration":"yud'khilu"},{"position":2,"arabic":"مَن","translation":"whom","transliteration":"man"},{"position":3,"arabic":"يَشَآءُ","translation":"He wills","transliteration":"yashāu"},{"position":4,"arabic":"فِى","translation":"into","transliteration":"fī"},{"position":5,"arabic":"رَحْمَتِهِۦ ۚ","translation":"His mercy","transliteration":"raḥmatihi"},{"position":6,"arabic":"وَٱلظَّـٰلِمِينَ","translation":"but (for) the wrongdoers","transliteration":"wal-ẓālimīna"},{"position":7,"arabic":"أَعَدَّ","translation":"He has prepared","transliteration":"aʿadda"},{"position":8,"arabic":"لَهُمْ","translation":"for them","transliteration":"lahum"},{"position":9,"arabic":"عَذَابًا","translation":"a punishment","transliteration":"ʿadhāban"},{"position":10,"arabic":"أَلِيمًۢا","translation":"painful","transliteration":"alīman"}],"e3rab":"(يُدْخِلُ) مضارع فاعله مستتر و(مَنْ) مفعول به والجملة حال و(يَشاءُ) مضارع فاعله مستتر و(فِي رَحْمَتِهِ) متعلقان بالفعل والجملة صلة من (وَالظَّالِمِينَ) مفعول به لفعل محذوف تقديره يعذب والجملة معطوفة على ما قبلها و(أَعَدَّ) ماض فاعله مستتر و(لَهُمْ) متعلقان بالفعل و(عَذاباً) مفعول به و(أَلِيماً) صفة والجملة مفسرة لما قبلها.\r\n\r\n"}]