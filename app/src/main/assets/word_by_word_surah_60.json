[{"sura":60,"ayah":1,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"arabic":"تَتَّخِذُوا۟","translation":"take","transliteration":"tattakhidhū"},{"position":6,"arabic":"عَدُوِّى","translation":"My enemies","transliteration":"ʿaduwwī"},{"position":7,"arabic":"وَعَدُوَّكُمْ","translation":"and your enemies","transliteration":"waʿaduwwakum"},{"position":8,"arabic":"أَوْلِيَآءَ","translation":"(as) allies","transliteration":"awliyāa"},{"position":9,"arabic":"تُلْقُونَ","translation":"offering","transliteration":"tul'qūna"},{"position":10,"arabic":"إِلَيْهِم","translation":"them","transliteration":"ilayhim"},{"position":11,"arabic":"بِٱلْمَوَدَّةِ","translation":"love","transliteration":"bil-mawadati"},{"position":12,"arabic":"وَقَدْ","translation":"while","transliteration":"waqad"},{"position":13,"arabic":"كَفَرُوا۟","translation":"they have disbelieved","transliteration":"kafarū"},{"position":14,"arabic":"بِمَا","translation":"in what","transliteration":"bimā"},{"position":15,"arabic":"جَآءَكُم","translation":"came to you","transliteration":"jāakum"},{"position":16,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":17,"arabic":"ٱلْحَقِّ","translation":"the truth","transliteration":"l-ḥaqi"},{"position":18,"arabic":"يُخْرِجُونَ","translation":"driving out","transliteration":"yukh'rijūna"},{"position":19,"arabic":"ٱلرَّسُولَ","translation":"the Messenger","transliteration":"l-rasūla"},{"position":20,"arabic":"وَإِيَّاكُمْ ۙ","translation":"and yourselves","transliteration":"wa-iyyākum"},{"position":21,"arabic":"أَن","translation":"because","transliteration":"an"},{"position":22,"arabic":"تُؤْمِنُوا۟","translation":"you believe","transliteration":"tu'minū"},{"position":23,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":24,"arabic":"رَبِّكُمْ","translation":"your Lord","transliteration":"rabbikum"},{"position":25,"arabic":"إِن","translation":"If","transliteration":"in"},{"position":26,"arabic":"كُنتُمْ","translation":"you","transliteration":"kuntum"},{"position":27,"arabic":"خَرَجْتُمْ","translation":"come forth","transliteration":"kharajtum"},{"position":28,"arabic":"جِهَـٰدًۭا","translation":"(to) strive","transliteration":"jihādan"},{"position":29,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":30,"arabic":"سَبِيلِى","translation":"My way","transliteration":"sabīlī"},{"position":31,"arabic":"وَٱبْتِغَآءَ","translation":"and (to) seek","transliteration":"wa-ib'tighāa"},{"position":32,"arabic":"مَرْضَاتِى ۚ","translation":"My Pleasure","transliteration":"marḍātī"},{"position":33,"arabic":"تُسِرُّونَ","translation":"You confide","transliteration":"tusirrūna"},{"position":34,"arabic":"إِلَيْهِم","translation":"to them","transliteration":"ilayhim"},{"position":35,"arabic":"بِٱلْمَوَدَّةِ","translation":"love","transliteration":"bil-mawadati"},{"position":36,"arabic":"وَأَنَا۠","translation":"but I Am","transliteration":"wa-anā"},{"position":37,"arabic":"أَعْلَمُ","translation":"most knowing","transliteration":"aʿlamu"},{"position":38,"arabic":"بِمَآ","translation":"of what","transliteration":"bimā"},{"position":39,"arabic":"أَخْفَيْتُمْ","translation":"you conceal","transliteration":"akhfaytum"},{"position":40,"arabic":"وَمَآ","translation":"and what","transliteration":"wamā"},{"position":41,"arabic":"أَعْلَنتُمْ ۚ","translation":"you declare","transliteration":"aʿlantum"},{"position":42,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":43,"arabic":"يَفْعَلْهُ","translation":"does it","transliteration":"yafʿalhu"},{"position":44,"arabic":"مِنكُمْ","translation":"among you","transliteration":"minkum"},{"position":45,"arabic":"فَقَدْ","translation":"then certainly","transliteration":"faqad"},{"position":46,"arabic":"ضَلَّ","translation":"he has strayed","transliteration":"ḍalla"},{"position":47,"arabic":"سَوَآءَ","translation":"(from the) straight","transliteration":"sawāa"},{"position":48,"arabic":"ٱلسَّبِيلِ","translation":"path","transliteration":"l-sabīli"}],"e3rab":"(يا أَيُّهَا) منادى نكرة مقصودة مبني على الضم والها للتنبيه (الَّذِينَ) اسم موصول بدل (آمَنُوا) ماض وفاعله والجملة صلة، (لا تَتَّخِذُوا) مضارع مجزوم بلا الناهية والواو فاعله (عَدُوِّي) مفعول به أول (وَعَدُوَّكُمْ) معطوف على عدوي (أَوْلِياءَ) مفعول به ثان والجملة ابتدائية لا محل لها (تُلْقُونَ) مضارع مرفوع والواو فاعله (إِلَيْهِمْ) متعلقان بالفعل والجملة حال (بِالْمَوَدَّةِ) متعلقان بالفعل أيضا.\r\n\r\n(وَ) الواو حالية (قَدْ كَفَرُوا) حرف تحقيق وماض وفاعله والجملة حال (بِما) متعلقان بالفعل (جاءَكُمْ) ماض ومفعوله والفاعل مستتر (مِنَ الْحَقِّ) حال والجملة صلة.\r\n\r\n(يُخْرِجُونَ) مضارع مرفوع والواو فاعله (الرَّسُولَ) مفعول به (وَإِيَّاكُمْ) معطوف على الرسول والجملة استئنافية لا محل لها، (أَنْ تُؤْمِنُوا) مضارع منصوب بأن والواو فاعله والمصدر المؤول من أن والفعل في محل نصب بنزع الخافض (بِاللَّهِ) متعلقان بالفعل (رَبِّكُمْ) بدل من لفظ الجلالة.\r\n\r\n(أَنْ) شرطية (كُنْتُمْ) ماض ناقص والتاء اسمه (خَرَجْتُمْ) ماض وفاعله والجملة الفعلية خبر كنتم وجملة كنتم.. ابتدائية لا محل لها (جِهاداً) مفعول لأجله، (فِي سَبِيلِي) متعلقان بجهادا، (وَابْتِغاءَ) معطوف على جهادا (مَرْضاتِي) مضاف إليه، (تُسِرُّونَ) مضارع مرفوع والواو فاعله (إِلَيْهِمْ) متعلقان بالفعل (بِالْمَوَدَّةِ) متعلقان بالفعل أيضا والجملة استئنافية لا محل لها.\r\n\r\n(وَ) الواو حالية (أَنَا أَعْلَمُ) مبتدأ وخبره والجملة حال (بِما) متعلقان بأعلم (أَخْفَيْتُمْ) ماض وفاعله والجملة صلة (وَما أَعْلَنْتُمْ) معطوف على ما أخفيتم (وَمَنْ يَفْعَلْهُ) اسم شرط جازم مبتدأ ومضارع مجزوم والهاء مفعوله والفاعل مستتر (مِنْكُمْ) متعلقان بمحذوف حال (فَقَدْ) الفاء رابطة (قَدْ) حرف تحقيق (ضَلَّ) ماض فاعله مستتر (سَواءَ) مفعول به مضاف إلى السبيل (السَّبِيلِ) مضاف إليه والجملة الفعلية في محل جزم جواب الشرط وجملتا الشرط والجواب خبر من وجملة من.. استئنافية لا محل لها.\r\n\r\n"},{"sura":60,"ayah":2,"words":[{"position":1,"arabic":"إِن","translation":"If","transliteration":"in"},{"position":2,"arabic":"يَثْقَفُوكُمْ","translation":"they gain dominance over you","transliteration":"yathqafūkum"},{"position":3,"arabic":"يَكُونُوا۟","translation":"they would be","transliteration":"yakūnū"},{"position":4,"arabic":"لَكُمْ","translation":"to you","transliteration":"lakum"},{"position":5,"arabic":"أَعْدَآءًۭ","translation":"enemies","transliteration":"aʿdāan"},{"position":6,"arabic":"وَيَبْسُطُوٓا۟","translation":"and extend","transliteration":"wayabsuṭū"},{"position":7,"arabic":"إِلَيْكُمْ","translation":"against you","transliteration":"ilaykum"},{"position":8,"arabic":"أَيْدِيَهُمْ","translation":"their hands","transliteration":"aydiyahum"},{"position":9,"arabic":"وَأَلْسِنَتَهُم","translation":"and their tongues","transliteration":"wa-alsinatahum"},{"position":10,"arabic":"بِٱلسُّوٓءِ","translation":"with evil","transliteration":"bil-sūi"},{"position":11,"arabic":"وَوَدُّوا۟","translation":"and they desire","transliteration":"wawaddū"},{"position":12,"arabic":"لَوْ","translation":"that","transliteration":"law"},{"position":13,"arabic":"تَكْفُرُونَ","translation":"you would disbelieve","transliteration":"takfurūna"}],"e3rab":"(إِنْ يَثْقَفُوكُمْ) إن شرطية ومضارع مجزوم بحذف النون والواو فاعله والكاف مفعول به والجملة ابتدائية لا محل لها.\r\n\r\n(يَكُونُوا) مضارع ناقص مجزوم لأنه جواب الشرط والواو اسمه والجملة جواب الشرط لا محل لها (لَكُمْ) متعلقان بالخبر (أَعْداءً) خبر يكونوا (وَيَبْسُطُوا) مضارع معطوف على يكونوا (إِلَيْكُمْ) متعلقان بالفعل (أَيْدِيَهُمْ) مفعول به (وَأَلْسِنَتَهُمْ) معطوف على أيديهم (بِالسُّوءِ) متعلقان بمحذوف حال (وَوَدُّوا) ماض وفاعله والجملة معطوفة على ما قبلها (لَوْ تَكْفُرُونَ) لو مصدرية ومضارع وفاعله والمصدر المؤول من لو وما بعدها مفعول ودوا.\r\n\r\n"},{"sura":60,"ayah":3,"words":[{"position":1,"arabic":"لَن","translation":"Never","transliteration":"lan"},{"position":2,"arabic":"تَنفَعَكُمْ","translation":"will benefit you","transliteration":"tanfaʿakum"},{"position":3,"arabic":"أَرْحَامُكُمْ","translation":"your relatives","transliteration":"arḥāmukum"},{"position":4,"arabic":"وَلَآ","translation":"and not","transliteration":"walā"},{"position":5,"arabic":"أَوْلَـٰدُكُمْ ۚ","translation":"your children","transliteration":"awlādukum"},{"position":6,"arabic":"يَوْمَ","translation":"(on the) Day","transliteration":"yawma"},{"position":7,"arabic":"ٱلْقِيَـٰمَةِ","translation":"(of) the Resurrection","transliteration":"l-qiyāmati"},{"position":8,"arabic":"يَفْصِلُ","translation":"He will judge","transliteration":"yafṣilu"},{"position":9,"arabic":"بَيْنَكُمْ ۚ","translation":"between you","transliteration":"baynakum"},{"position":10,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":11,"arabic":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":12,"arabic":"تَعْمَلُونَ","translation":"you do","transliteration":"taʿmalūna"},{"position":13,"arabic":"بَصِيرٌۭ","translation":"(is) All-Seer","transliteration":"baṣīrun"}],"e3rab":"(لَنْ تَنْفَعَكُمْ) مضارع منصوب بلن ومفعوله (أَرْحامُكُمْ) فاعله (وَلا أَوْلادُكُمْ) معطوف على أرحامكم (يَوْمَ) ظرف زمان (الْقِيامَةِ) مضاف إليه والجملة استئنافية لا محل لها (يَفْصِلُ) مضارع فاعله مستتر (بَيْنَكُمْ) ظرف مكان والجملة استئنافية لا محل لها (وَاللَّهُ) مبتدأ (بِما) متعلقان ببصير (تَعْمَلُونَ) مضارع مرفوع والواو فاعله والجملة صلة (بَصِيرٌ) خبر المبتدأ والجملة الاسمية استئنافية لا محل لها.\r\n\r\n"},{"sura":60,"ayah":4,"words":[{"position":1,"arabic":"قَدْ","translation":"Indeed","transliteration":"qad"},{"position":2,"arabic":"كَانَتْ","translation":"(there) is","transliteration":"kānat"},{"position":3,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":4,"arabic":"أُسْوَةٌ","translation":"an example","transliteration":"us'watun"},{"position":5,"arabic":"حَسَنَةٌۭ","translation":"good","transliteration":"ḥasanatun"},{"position":6,"arabic":"فِىٓ","translation":"in","transliteration":"fī"},{"position":7,"arabic":"إِبْرَٰهِيمَ","translation":"Ibrahim","transliteration":"ib'rāhīma"},{"position":8,"arabic":"وَٱلَّذِينَ","translation":"and those","transliteration":"wa-alladhīna"},{"position":9,"arabic":"مَعَهُۥٓ","translation":"with him","transliteration":"maʿahu"},{"position":10,"arabic":"إِذْ","translation":"when","transliteration":"idh"},{"position":11,"arabic":"قَالُوا۟","translation":"they said","transliteration":"qālū"},{"position":12,"arabic":"لِقَوْمِهِمْ","translation":"to their people","transliteration":"liqawmihim"},{"position":13,"arabic":"إِنَّا","translation":"Indeed, we","transliteration":"innā"},{"position":14,"arabic":"بُرَءَٰٓؤُا۟","translation":"(are) disassociated","transliteration":"buraāu"},{"position":15,"arabic":"مِنكُمْ","translation":"from you","transliteration":"minkum"},{"position":16,"arabic":"وَمِمَّا","translation":"and from what","transliteration":"wamimmā"},{"position":17,"arabic":"تَعْبُدُونَ","translation":"you worship","transliteration":"taʿbudūna"},{"position":18,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":19,"arabic":"دُونِ","translation":"besides","transliteration":"dūni"},{"position":20,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":21,"arabic":"كَفَرْنَا","translation":"We have denied","transliteration":"kafarnā"},{"position":22,"arabic":"بِكُمْ","translation":"you","transliteration":"bikum"},{"position":23,"arabic":"وَبَدَا","translation":"and has appeared","transliteration":"wabadā"},{"position":24,"arabic":"بَيْنَنَا","translation":"between us","transliteration":"baynanā"},{"position":25,"arabic":"وَبَيْنَكُمُ","translation":"and between you","transliteration":"wabaynakumu"},{"position":26,"arabic":"ٱلْعَدَٰوَةُ","translation":"enmity","transliteration":"l-ʿadāwatu"},{"position":27,"arabic":"وَٱلْبَغْضَآءُ","translation":"and hatred","transliteration":"wal-baghḍāu"},{"position":28,"arabic":"أَبَدًا","translation":"forever","transliteration":"abadan"},{"position":29,"arabic":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":30,"arabic":"تُؤْمِنُوا۟","translation":"you believe","transliteration":"tu'minū"},{"position":31,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":32,"arabic":"وَحْدَهُۥٓ","translation":"Alone","transliteration":"waḥdahu"},{"position":33,"arabic":"إِلَّا","translation":"Except","transliteration":"illā"},{"position":34,"arabic":"قَوْلَ","translation":"(the) saying","transliteration":"qawla"},{"position":35,"arabic":"إِبْرَٰهِيمَ","translation":"(of) Ibrahim","transliteration":"ib'rāhīma"},{"position":36,"arabic":"لِأَبِيهِ","translation":"to his father","transliteration":"li-abīhi"},{"position":37,"arabic":"لَأَسْتَغْفِرَنَّ","translation":"Surely I ask forgiveness","transliteration":"la-astaghfiranna"},{"position":38,"arabic":"لَكَ","translation":"for you","transliteration":"laka"},{"position":39,"arabic":"وَمَآ","translation":"but not","transliteration":"wamā"},{"position":40,"arabic":"أَمْلِكُ","translation":"I have power","transliteration":"amliku"},{"position":41,"arabic":"لَكَ","translation":"for you","transliteration":"laka"},{"position":42,"arabic":"مِنَ","translation":"from","transliteration":"mina"},{"position":43,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":44,"arabic":"مِن","translation":"of","transliteration":"min"},{"position":45,"arabic":"شَىْءٍۢ ۖ","translation":"anything","transliteration":"shayin"},{"position":46,"arabic":"رَّبَّنَا","translation":"Our Lord","transliteration":"rabbanā"},{"position":47,"arabic":"عَلَيْكَ","translation":"upon You","transliteration":"ʿalayka"},{"position":48,"arabic":"تَوَكَّلْنَا","translation":"we put our trust","transliteration":"tawakkalnā"},{"position":49,"arabic":"وَإِلَيْكَ","translation":"and to You","transliteration":"wa-ilayka"},{"position":50,"arabic":"أَنَبْنَا","translation":"we turn","transliteration":"anabnā"},{"position":51,"arabic":"وَإِلَيْكَ","translation":"and to You","transliteration":"wa-ilayka"},{"position":52,"arabic":"ٱلْمَصِيرُ","translation":"(is) the final return","transliteration":"l-maṣīru"}],"e3rab":"(قَدْ كانَتْ) حرف تحقيق وماض ناقص (لَكُمْ) خبر كان المقدم (أُسْوَةٌ) اسمها المؤخر (حَسَنَةٌ) صفة أسوة والجملة استئنافية لا محل لها (فِي إِبْراهِيمَ) متعلقان بأسوة (وَالَّذِينَ) معطوف على إبراهيم (مَعَهُ) ظرف مكان (إِذْ) بدل اشتمال من إبراهيم (قالُوا) ماض وفاعله والجملة في محل جر بالإضافة (لِقَوْمِهِمْ) متعلقان بالفعل (إِنَّا بُرَآؤُا) إن واسمها وخبرها والجملة مقول القول (مِنْكُمْ) متعلقان ببرآء.\r\n\r\n(وَمِمَّا تَعْبُدُونَ) معطوفان على منكم ومضارع مرفوع والواو فاعله والجملة صلة، (مِنْ دُونِ) متعلقان بمحذوف حال (اللَّهِ) لفظ الجلالة مضاف إليه.\r\n\r\n(كَفَرْنا) ماض وفاعله (بِكُمْ) متعلقان بالفعل والجملة حال (وَبَدا بَيْنَنا) ماض وظرف مكان و(بَيْنَكُمُ) معطوف على بيننا (الْعَداوَةُ) فاعل (وَالْبَغْضاءُ) معطوف على العداوة (أَبَداً) ظرف زمان (حَتَّى) حرف غاية وجر (تُؤْمِنُوا) مضارع منصوب بأن مضمرة بعد حتى (بِاللَّهِ) متعلقان بالفعل (وَحْدَهُ) حال والمصدر المؤول من أن وما بعدها في محل جر بحتى والجار والمجرور متعلقان ببدا (إِلَّا قَوْلَ) حرف استثناء ومستثنى منصوب (إِبْراهِيمَ) مضاف إليه، (لِأَبِيهِ) متعلقان بقول (لَأَسْتَغْفِرَنَّ) اللام واقعة في جواب قسم محذوف ومضارع مبني على الفتح لاتصاله بنون التوكيد الثقيلة والفاعل مستتر والجملة جواب القسم لا محل لها (لَكَ) متعلقان بالفعل، والواو حالية (ما) نافية (أَمْلِكُ) مضارع فاعله مستتر والجملة حال (لَكَ) متعلقان بالفعل (مِنَ اللَّهِ) متعلقان بالفعل أيضا.\r\n\r\n(مِنْ شَيْءٍ) مجرور لفظا منصوب محلا مفعول به لأملك (رَبَّنا) منادى مضاف (عَلَيْكَ) متعلقان بتوكلنا وجملة النداء مقول القول (تَوَكَّلْنا) ماض وفاعله والجملة مقول القول (وَإِلَيْكَ) متعلقان بما بعدهما، (أَنَبْنا) ماض وفاعله والجملة معطوفة على ما قبلها، (وَإِلَيْكَ) خبر مقدم (الْمَصِيرُ) مبتدأ مؤخر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":60,"ayah":5,"words":[{"position":1,"arabic":"رَبَّنَا","translation":"Our Lord","transliteration":"rabbanā"},{"position":2,"arabic":"لَا","translation":"(do) not","transliteration":"lā"},{"position":3,"arabic":"تَجْعَلْنَا","translation":"make us","transliteration":"tajʿalnā"},{"position":4,"arabic":"فِتْنَةًۭ","translation":"a trial","transliteration":"fit'natan"},{"position":5,"arabic":"لِّلَّذِينَ","translation":"for those who","transliteration":"lilladhīna"},{"position":6,"arabic":"كَفَرُوا۟","translation":"disbelieve","transliteration":"kafarū"},{"position":7,"arabic":"وَٱغْفِرْ","translation":"and forgive","transliteration":"wa-igh'fir"},{"position":8,"arabic":"لَنَا","translation":"us","transliteration":"lanā"},{"position":9,"arabic":"رَبَّنَآ ۖ","translation":"our Lord","transliteration":"rabbanā"},{"position":10,"arabic":"إِنَّكَ","translation":"Indeed You","transliteration":"innaka"},{"position":11,"arabic":"أَنتَ","translation":"[You]","transliteration":"anta"},{"position":12,"arabic":"ٱلْعَزِيزُ","translation":"(are) the All-Mighty","transliteration":"l-ʿazīzu"},{"position":13,"arabic":"ٱلْحَكِيمُ","translation":"the All-Wise","transliteration":"l-ḥakīmu"}],"e3rab":"(رَبَّنا) منادى مضاف (لا تَجْعَلْنا) مضارع مجزوم بلا و(نا) مفعول به أول (فِتْنَةً) مفعول به ثان (لِلَّذِينَ) متعلقان بفتنة والجملتان الندائية والفعلية استئنافيتان لا محل لهما، (كَفَرُوا) ماض وفاعله والجملة صلة، (وَاغْفِرْ) فعل دعاء فاعله مستتر و(لَنا) متعلقان بالفعل (رَبَّنا) توكيد لفظي لما قبله، (إِنَّكَ) إن واسمها (أَنْتَ) ضمير فصل (الْعَزِيزُ الْحَكِيمُ) خبران والجملة الاسمية تعليل والجملة الفعلية معطوفة على ما قبلها.\r\n\r\n"},{"sura":60,"ayah":6,"words":[{"position":1,"arabic":"لَقَدْ","translation":"Certainly","transliteration":"laqad"},{"position":2,"arabic":"كَانَ","translation":"(there) is","transliteration":"kāna"},{"position":3,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":4,"arabic":"فِيهِمْ","translation":"in them","transliteration":"fīhim"},{"position":5,"arabic":"أُسْوَةٌ","translation":"an example","transliteration":"us'watun"},{"position":6,"arabic":"حَسَنَةٌۭ","translation":"good","transliteration":"ḥasanatun"},{"position":7,"arabic":"لِّمَن","translation":"for (he) who","transliteration":"liman"},{"position":8,"arabic":"كَانَ","translation":"is","transliteration":"kāna"},{"position":9,"arabic":"يَرْجُوا۟","translation":"hopeful","transliteration":"yarjū"},{"position":10,"arabic":"ٱللَّهَ","translation":"(in) Allah","transliteration":"l-laha"},{"position":11,"arabic":"وَٱلْيَوْمَ","translation":"and the Day","transliteration":"wal-yawma"},{"position":12,"arabic":"ٱلْـَٔاخِرَ ۚ","translation":"the Last","transliteration":"l-ākhira"},{"position":13,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":14,"arabic":"يَتَوَلَّ","translation":"turns away","transliteration":"yatawalla"},{"position":15,"arabic":"فَإِنَّ","translation":"then indeed","transliteration":"fa-inna"},{"position":16,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":17,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":18,"arabic":"ٱلْغَنِىُّ","translation":"(is) Free of need","transliteration":"l-ghaniyu"},{"position":19,"arabic":"ٱلْحَمِيدُ","translation":"the Praiseworthy","transliteration":"l-ḥamīdu"}],"e3rab":"(لَقَدْ) اللام واقعة في جواب قسم محذوف (قد) حرف تحقيق (كانَ لَكُمْ) كان وجار ومجرور خبرها المقدم (فِيهِمْ) متعلقان بمحذوف خبر ثان (أُسْوَةٌ) اسم كان المؤخر (حَسَنَةٌ) صفة والجملة جواب القسم المقدر لا محل لها.\r\n\r\n(لِمَنْ) بدل من لكم (كانَ) ماض ناقص اسمه مستتر (يَرْجُوا اللَّهَ) مضارع ولفظ الجلالة مفعوله والفاعل مستتر والجملة الفعلية خبر كان وجملة كان.. صلة (وَالْيَوْمَ) معطوف على اللّه (الْآخِرَ) صفة (وَمَنْ) اسم شرط مبتدأ (يَتَوَلَّ) مضارع مجزوم لأنه فعل الشرط والفاعل مستتر (فَإِنَّ اللَّهَ) الفاء رابطة وإن واسمها (هُوَ) ضمير فصل (الْغَنِيُّ الْحَمِيدُ) خبران والجملة في محل جزم جواب الشرط وجملة من.. استئنافية لا محل لها وجملتا الشرط والجواب خبر من.\r\n\r\n"},{"sura":60,"ayah":7,"words":[{"position":1,"arabic":"۞ عَسَى","translation":"Perhaps","transliteration":"ʿasā"},{"position":2,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":3,"arabic":"أَن","translation":"[that]","transliteration":"an"},{"position":4,"arabic":"يَجْعَلَ","translation":"will put","transliteration":"yajʿala"},{"position":5,"arabic":"بَيْنَكُمْ","translation":"between you","transliteration":"baynakum"},{"position":6,"arabic":"وَبَيْنَ","translation":"and between","transliteration":"wabayna"},{"position":7,"arabic":"ٱلَّذِينَ","translation":"those (to) whom","transliteration":"alladhīna"},{"position":8,"arabic":"عَادَيْتُم","translation":"you have been enemies","transliteration":"ʿādaytum"},{"position":9,"arabic":"مِّنْهُم","translation":"among them","transliteration":"min'hum"},{"position":10,"arabic":"مَّوَدَّةًۭ ۚ","translation":"love","transliteration":"mawaddatan"},{"position":11,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":12,"arabic":"قَدِيرٌۭ ۚ","translation":"(is) All-Powerful","transliteration":"qadīrun"},{"position":13,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":14,"arabic":"غَفُورٌۭ","translation":"(is) Oft-Forgiving","transliteration":"ghafūrun"},{"position":15,"arabic":"رَّحِيمٌۭ","translation":"Most Merciful","transliteration":"raḥīmun"}],"e3rab":"(عَسَى اللَّهُ أَنْ يَجْعَلَ) عسى واسمها ومضارع منصوب بأن والمصدر المؤول من أن والفعل خبر عسى وجملة عسى استئنافية لا محل لها.\r\n\r\n(بَيْنَكُمْ) ظرف مكان (وَبَيْنَ) معطوف على بينكم (الَّذِينَ) مضاف إليه، (عادَيْتُمْ) ماض وفاعله والجملة صلة (مِنْهُمْ) متعلقان بمحذوف حال (مَوَدَّةً) مفعول به (وَاللَّهُ قَدِيرٌ) مبتدأ وخبره والجملة استئنافية لا محل لها.\r\n\r\n(وَاللَّهُ غَفُورٌ رَحِيمٌ) مبتدأ وخبران والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":60,"ayah":8,"words":[{"position":1,"arabic":"لَّا","translation":"Not","transliteration":"lā"},{"position":2,"arabic":"يَنْهَىٰكُمُ","translation":"(does) forbid you","transliteration":"yanhākumu"},{"position":3,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":4,"arabic":"عَنِ","translation":"from","transliteration":"ʿani"},{"position":5,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":6,"arabic":"لَمْ","translation":"(do) not","transliteration":"lam"},{"position":7,"arabic":"يُقَـٰتِلُوكُمْ","translation":"fight you","transliteration":"yuqātilūkum"},{"position":8,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":9,"arabic":"ٱلدِّينِ","translation":"the religion","transliteration":"l-dīni"},{"position":10,"arabic":"وَلَمْ","translation":"and (do) not","transliteration":"walam"},{"position":11,"arabic":"يُخْرِجُوكُم","translation":"drive you out","transliteration":"yukh'rijūkum"},{"position":12,"arabic":"مِّن","translation":"of","transliteration":"min"},{"position":13,"arabic":"دِيَـٰرِكُمْ","translation":"your homes","transliteration":"diyārikum"},{"position":14,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":15,"arabic":"تَبَرُّوهُمْ","translation":"you deal kindly","transliteration":"tabarrūhum"},{"position":16,"arabic":"وَتُقْسِطُوٓا۟","translation":"and deal justly","transliteration":"watuq'siṭū"},{"position":17,"arabic":"إِلَيْهِمْ ۚ","translation":"with them","transliteration":"ilayhim"},{"position":18,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":19,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":20,"arabic":"يُحِبُّ","translation":"loves","transliteration":"yuḥibbu"},{"position":21,"arabic":"ٱلْمُقْسِطِينَ","translation":"those who act justly","transliteration":"l-muq'siṭīna"}],"e3rab":"(لا يَنْهاكُمُ اللَّهُ) لا نافية ومضارع ومفعوله ولفظ الجلالة فاعله والجملة استئنافية لا محل لها (عَنِ الَّذِينَ) متعلقان بالفعل (لَمْ يُقاتِلُوكُمْ) مضارع مجزوم بلم والواو فاعله والكاف مفعوله والجملة صلة (فِي الدِّينِ) متعلقان بالفعل.\r\n\r\n(وَلَمْ يُخْرِجُوكُمْ) معطوفة على لم يقاتلوكم وإعرابها مثلها (مِنْ دِيارِكُمْ) متعلقان بالفعل (أَنْ تَبَرُّوهُمْ) مضارع منصوب بأن والواو فاعله والهاء مفعوله والمصدر المؤول من أن والفعل في محل جر بدل اشتمال من الذين (وَتُقْسِطُوا) معطوف على ما قبله (إِلَيْهِمْ) متعلقان بالفعل (إِنَّ اللَّهَ) إن واسمها (يُحِبُّ) مضارع فاعله مستتر (الْمُقْسِطِينَ) مفعول به والجملة الفعلية خبر إن والجملة الاسمية تعليل.\r\n\r\n"},{"sura":60,"ayah":9,"words":[{"position":1,"arabic":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"position":2,"arabic":"يَنْهَىٰكُمُ","translation":"forbids you","transliteration":"yanhākumu"},{"position":3,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":4,"arabic":"عَنِ","translation":"from","transliteration":"ʿani"},{"position":5,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":6,"arabic":"قَـٰتَلُوكُمْ","translation":"fight you","transliteration":"qātalūkum"},{"position":7,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":8,"arabic":"ٱلدِّينِ","translation":"the religion","transliteration":"l-dīni"},{"position":9,"arabic":"وَأَخْرَجُوكُم","translation":"and drive you out","transliteration":"wa-akhrajūkum"},{"position":10,"arabic":"مِّن","translation":"of","transliteration":"min"},{"position":11,"arabic":"دِيَـٰرِكُمْ","translation":"your homes","transliteration":"diyārikum"},{"position":12,"arabic":"وَظَـٰهَرُوا۟","translation":"and support","transliteration":"waẓāharū"},{"position":13,"arabic":"عَلَىٰٓ","translation":"in","transliteration":"ʿalā"},{"position":14,"arabic":"إِخْرَاجِكُمْ","translation":"your expulsion","transliteration":"ikh'rājikum"},{"position":15,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":16,"arabic":"تَوَلَّوْهُمْ ۚ","translation":"you make them allies","transliteration":"tawallawhum"},{"position":17,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":18,"arabic":"يَتَوَلَّهُمْ","translation":"makes them allies","transliteration":"yatawallahum"},{"position":19,"arabic":"فَأُو۟لَـٰٓئِكَ","translation":"then those","transliteration":"fa-ulāika"},{"position":20,"arabic":"هُمُ","translation":"[they]","transliteration":"humu"},{"position":21,"arabic":"ٱلظَّـٰلِمُونَ","translation":"(are) the wrongdoers","transliteration":"l-ẓālimūna"}],"e3rab":"(إِنَّما يَنْهاكُمُ اللَّهُ) إنما كافة ومكفوفة ومضارع ومفعوله ولفظ الجلالة فاعله والجملة لا محل لها.\r\n\r\n(عَنِ الَّذِينَ) متعلقان بالفعل (قاتَلُوكُمْ) ماض وفاعله ومفعوله (فِي الدِّينِ) متعلقان بالفعل والجملة صلة.\r\n\r\n(أَخْرَجُوكُمْ مِنْ دِيارِكُمْ) معطوف على ما قبله (ظاهَرُوا عَلى إِخْراجِكُمْ) معطوف على ما قبله أيضا (أَنْ تَوَلَّوْهُمْ) مضارع منصوب بأن والواو فاعله والهاء مفعوله والمصدر المؤول من أن والفعل في محل جر بدل اشتمال من الذين.\r\n\r\n(وَمَنْ) الواو حرف استئناف واسم شرط مبتدأ (يَتَوَلَّهُمْ) مضارع مجزوم لأنه فعل الشرط والهاء مفعوله (فَأُولئِكَ) الفاء رابطة واسم الإشارة مبتدأ (هُمُ) ضمير فصل (الظَّالِمُونَ) خبر والجملة في محل جزم جواب الشرط وجملتا الشرط والجواب خبر من، وجملة من..\r\n\r\nاستئنافية لا محل لها.\r\n\r\n"},{"sura":60,"ayah":10,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوٓا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":5,"arabic":"جَآءَكُمُ","translation":"come to you","transliteration":"jāakumu"},{"position":6,"arabic":"ٱلْمُؤْمِنَـٰتُ","translation":"the believing women","transliteration":"l-mu'minātu"},{"position":7,"arabic":"مُهَـٰجِرَٰتٍۢ","translation":"(as) emigrants","transliteration":"muhājirātin"},{"position":8,"arabic":"فَٱمْتَحِنُوهُنَّ ۖ","translation":"then examine them","transliteration":"fa-im'taḥinūhunna"},{"position":9,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":10,"arabic":"أَعْلَمُ","translation":"(is) most knowing","transliteration":"aʿlamu"},{"position":11,"arabic":"بِإِيمَـٰنِهِنَّ ۖ","translation":"of their faith","transliteration":"biīmānihinna"},{"position":12,"arabic":"فَإِنْ","translation":"And if","transliteration":"fa-in"},{"position":13,"arabic":"عَلِمْتُمُوهُنَّ","translation":"you know them","transliteration":"ʿalim'tumūhunna"},{"position":14,"arabic":"مُؤْمِنَـٰتٍۢ","translation":"(to be) believers","transliteration":"mu'minātin"},{"position":15,"arabic":"فَلَا","translation":"then (do) not","transliteration":"falā"},{"position":16,"arabic":"تَرْجِعُوهُنَّ","translation":"return them","transliteration":"tarjiʿūhunna"},{"position":17,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":18,"arabic":"ٱلْكُفَّارِ ۖ","translation":"the disbelievers","transliteration":"l-kufāri"},{"position":19,"arabic":"لَا","translation":"Not","transliteration":"lā"},{"position":20,"arabic":"هُنَّ","translation":"they","transliteration":"hunna"},{"position":21,"arabic":"حِلٌّۭ","translation":"(are) lawful","transliteration":"ḥillun"},{"position":22,"arabic":"لَّهُمْ","translation":"for them","transliteration":"lahum"},{"position":23,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":24,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":25,"arabic":"يَحِلُّونَ","translation":"are lawful","transliteration":"yaḥillūna"},{"position":26,"arabic":"لَهُنَّ ۖ","translation":"for them","transliteration":"lahunna"},{"position":27,"arabic":"وَءَاتُوهُم","translation":"But give them","transliteration":"waātūhum"},{"position":28,"arabic":"مَّآ","translation":"what","transliteration":"mā"},{"position":29,"arabic":"أَنفَقُوا۟ ۚ","translation":"they have spent","transliteration":"anfaqū"},{"position":30,"arabic":"وَلَا","translation":"And not","transliteration":"walā"},{"position":31,"arabic":"جُنَاحَ","translation":"any blame","transliteration":"junāḥa"},{"position":32,"arabic":"عَلَيْكُمْ","translation":"upon you","transliteration":"ʿalaykum"},{"position":33,"arabic":"أَن","translation":"if","transliteration":"an"},{"position":34,"arabic":"تَنكِحُوهُنَّ","translation":"you marry them","transliteration":"tankiḥūhunna"},{"position":35,"arabic":"إِذَآ","translation":"when","transliteration":"idhā"},{"position":36,"arabic":"ءَاتَيْتُمُوهُنَّ","translation":"you have given them","transliteration":"ātaytumūhunna"},{"position":37,"arabic":"أُجُورَهُنَّ ۚ","translation":"their (bridal) dues","transliteration":"ujūrahunna"},{"position":38,"arabic":"وَلَا","translation":"And (do) not","transliteration":"walā"},{"position":39,"arabic":"تُمْسِكُوا۟","translation":"hold","transliteration":"tum'sikū"},{"position":40,"arabic":"بِعِصَمِ","translation":"to marriage bonds","transliteration":"biʿiṣami"},{"position":41,"arabic":"ٱلْكَوَافِرِ","translation":"(with) disbelieving women","transliteration":"l-kawāfiri"},{"position":42,"arabic":"وَسْـَٔلُوا۟","translation":"but ask (for)","transliteration":"wasalū"},{"position":43,"arabic":"مَآ","translation":"what","transliteration":"mā"},{"position":44,"arabic":"أَنفَقْتُمْ","translation":"you have spent","transliteration":"anfaqtum"},{"position":45,"arabic":"وَلْيَسْـَٔلُوا۟","translation":"and let them ask","transliteration":"walyasalū"},{"position":46,"arabic":"مَآ","translation":"what","transliteration":"mā"},{"position":47,"arabic":"أَنفَقُوا۟ ۚ","translation":"they have spent","transliteration":"anfaqū"},{"position":48,"arabic":"ذَٰلِكُمْ","translation":"That","transliteration":"dhālikum"},{"position":49,"arabic":"حُكْمُ","translation":"(is the) Judgment","transliteration":"ḥuk'mu"},{"position":50,"arabic":"ٱللَّهِ ۖ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":51,"arabic":"يَحْكُمُ","translation":"He judges","transliteration":"yaḥkumu"},{"position":52,"arabic":"بَيْنَكُمْ ۚ","translation":"between you","transliteration":"baynakum"},{"position":53,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":54,"arabic":"عَلِيمٌ","translation":"(is) All-Knowing","transliteration":"ʿalīmun"},{"position":55,"arabic":"حَكِيمٌۭ","translation":"All-Wise","transliteration":"ḥakīmun"}],"e3rab":"(يا أَيُّهَا الَّذِينَ آمَنُوا) سبق إعرابه، (إِذا) ظرفية شرطية غير جازمة (جاءَكُمُ) ماض ومفعوله و(الْمُؤْمِناتُ) فاعل والجملة في محل جر بالإضافة (مُهاجِراتٍ) حال، (فَامْتَحِنُوهُنَّ) الفاء رابطة وأمر مبني على حذف النون والواو فاعله والهاء مفعوله والجملة جواب الشرط لا محل لها (اللَّهُ أَعْلَمُ) مبتدأ وخبره (بِإِيمانِهِنَّ) متعلقان بأعلم والجملة الاسمية اعتراضية لا محل لها، (فَإِنْ) الفاء حرف عطف (إن) شرطية (عَلِمْتُمُوهُنَّ) ماض وفاعله ومفعول به أول (مُؤْمِناتٍ) مفعول به ثان والجملة ابتدائية لا محل لها.\r\n\r\n(فَلا تَرْجِعُوهُنَّ) الفاء رابطة ومضارع مجزوم بلا الناهية والواو فاعله والهاء مفعوله (إِلَى الْكُفَّارِ) متعلقان بالفعل والجملة في محل جزم جواب الشرط.\r\n\r\n(لا) نافية (هُنَّ حِلٌّ) مبتدأ وخبره و(لَهُمْ) متعلقان بحل والجملة الاسمية تعليل لا محل لها، (وَ) الواو حرف عطف (لا) نافية (هُمْ) مبتدأ (يَحِلُّونَ) مضارع مرفوع والواو فاعله و(لَهُنَّ) متعلقان بالفعل والجملة الفعلية خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n(وَ) الواو حرف عطف (آتُوهُمْ) أمر مبني على حذف النون والواو فاعله والهاء مفعوله الأول (ما) مفعوله الثاني والجملة معطوفة على ما قبلها (أَنْفَقُوا) ماض وفاعله والجملة صلة.\r\n\r\n(وَلا) الواو حرف استئناف (لا) نافية للجنس (جُناحَ) اسمها المبني على الفتح (عَلَيْكُمْ) متعلقان بالخبر المحذوف (أَنْ تَنْكِحُوهُنَّ) مضارع منصوب بأن والواو فاعله والهاء مفعوله والمصدر المؤول من أن والفعل في محل نصب بنزع الخافض والجار والمجرور متعلقان بالخبر المحذوف، (إِذا آتَيْتُمُوهُنَّ) إذا ظرف زمان وماض وفاعله ومفعوله الأول (أُجُورَهُنَّ) مفعوله الثاني والجملة في محل جر بالإضافة.\r\n\r\n(وَلا تُمْسِكُوا) الواو حرف عطف ومضارع مجزوم بلا الناهية والواو فاعله (بِعِصَمِ) متعلقان بالفعل (الْكَوافِرِ) مضاف إليه والجملة معطوفة على ما قبلها.\r\n\r\n(وَسْئَلُوا) الواو حرف عطف وأمر وفاعله والجملة معطوفة على ما قبلها (ما) مفعول به (أَنْفَقْتُمْ) ماض وفاعله والجملة صلة (وَلْيَسْئَلُوا) حرف عطف ومضارع مجزوم بلام الأمر والواو فاعله والجملة معطوفة على ما قبلها (ما) مفعول به (أَنْفَقُوا) ماض وفاعله والجملة صلة و(ذلِكُمْ حُكْمُ) مبتدأ وخبره (اللَّهُ) لفظ الجلالة مضاف إليه والجملة استئنافية لا محل لها.\r\n\r\n(يَحْكُمُ) مضارع فاعله مستتر (بَيْنَكُمْ) ظرف مكان والجملة استئنافية لا محل لها.\r\n\r\n(وَاللَّهُ عَلِيمٌ حَكِيمٌ) مبتدأ وخبران والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":60,"ayah":11,"words":[{"position":1,"arabic":"وَإِن","translation":"And if","transliteration":"wa-in"},{"position":2,"arabic":"فَاتَكُمْ","translation":"have gone from you","transliteration":"fātakum"},{"position":3,"arabic":"شَىْءٌۭ","translation":"any","transliteration":"shayon"},{"position":4,"arabic":"مِّنْ","translation":"of","transliteration":"min"},{"position":5,"arabic":"أَزْوَٰجِكُمْ","translation":"your wives","transliteration":"azwājikum"},{"position":6,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":7,"arabic":"ٱلْكُفَّارِ","translation":"the disbelievers","transliteration":"l-kufāri"},{"position":8,"arabic":"فَعَاقَبْتُمْ","translation":"then your turn comes","transliteration":"faʿāqabtum"},{"position":9,"arabic":"فَـَٔاتُوا۟","translation":"then give","transliteration":"faātū"},{"position":10,"arabic":"ٱلَّذِينَ","translation":"(to) those who","transliteration":"alladhīna"},{"position":11,"arabic":"ذَهَبَتْ","translation":"have gone","transliteration":"dhahabat"},{"position":12,"arabic":"أَزْوَٰجُهُم","translation":"their wives","transliteration":"azwājuhum"},{"position":13,"arabic":"مِّثْلَ","translation":"(the) like","transliteration":"mith'la"},{"position":14,"arabic":"مَآ","translation":"(of) what","transliteration":"mā"},{"position":15,"arabic":"أَنفَقُوا۟ ۚ","translation":"they had spent","transliteration":"anfaqū"},{"position":16,"arabic":"وَٱتَّقُوا۟","translation":"And fear","transliteration":"wa-ittaqū"},{"position":17,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":18,"arabic":"ٱلَّذِىٓ","translation":"(in) Whom","transliteration":"alladhī"},{"position":19,"arabic":"أَنتُم","translation":"you","transliteration":"antum"},{"position":20,"arabic":"بِهِۦ","translation":"[in Him]","transliteration":"bihi"},{"position":21,"arabic":"مُؤْمِنُونَ","translation":"(are) believers","transliteration":"mu'minūna"}],"e3rab":"(وَ) الواو حرف عطف (إِنْ) شرطية (فاتَكُمْ) ماض ومفعوله (شَيْءٌ) فاعله (مِنْ أَزْواجِكُمْ) متعلقان بالفعل (إِلَى الْكُفَّارِ) متعلقان بالفعل أيضا والجملة معطوفة على ما قبلها، (فَعاقَبْتُمْ) ماض وفاعله والجملة معطوفة على ما قبلها، (فَآتُوا) الفاء رابطة وأمر مبني على حذف النون والواو فاعله والجملة في محل جزم جواب الشرط (الَّذِينَ) مفعول به أول (ذَهَبَتْ أَزْواجُهُمْ) ماض وفاعله والجملة صلة (مِثْلَ) مفعول به ثان (ما) مضاف إليه (أَنْفَقُوا) ماض وفاعله والجملة صلة، (وَاتَّقُوا) أمر وفاعله (اللَّهَ) لفظ الجلالة مفعوله والجملة معطوفة على ما قبلها (الَّذِي) صفة اللّه (أَنْتُمْ) مبتدأ (بِهِ) متعلقان بمؤمنون (مُؤْمِنُونَ) خبر والجملة صلة لا محل لها.\r\n\r\n"},{"sura":60,"ayah":12,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلنَّبِىُّ","translation":"Prophet","transliteration":"l-nabiyu"},{"position":3,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":4,"arabic":"جَآءَكَ","translation":"come to you","transliteration":"jāaka"},{"position":5,"arabic":"ٱلْمُؤْمِنَـٰتُ","translation":"the believing women","transliteration":"l-mu'minātu"},{"position":6,"arabic":"يُبَايِعْنَكَ","translation":"pledging to you","transliteration":"yubāyiʿ'naka"},{"position":7,"arabic":"عَلَىٰٓ","translation":"[on]","transliteration":"ʿalā"},{"position":8,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":9,"arabic":"لَّا","translation":"not","transliteration":"lā"},{"position":10,"arabic":"يُشْرِكْنَ","translation":"they will associate","transliteration":"yush'rik'na"},{"position":11,"arabic":"بِٱللَّهِ","translation":"with Allah","transliteration":"bil-lahi"},{"position":12,"arabic":"شَيْـًۭٔا","translation":"anything","transliteration":"shayan"},{"position":13,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":14,"arabic":"يَسْرِقْنَ","translation":"they will steal","transliteration":"yasriq'na"},{"position":15,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":16,"arabic":"يَزْنِينَ","translation":"they will commit adultery","transliteration":"yaznīna"},{"position":17,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":18,"arabic":"يَقْتُلْنَ","translation":"they will kill","transliteration":"yaqtul'na"},{"position":19,"arabic":"أَوْلَـٰدَهُنَّ","translation":"their children","transliteration":"awlādahunna"},{"position":20,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":21,"arabic":"يَأْتِينَ","translation":"they bring","transliteration":"yatīna"},{"position":22,"arabic":"بِبُهْتَـٰنٍۢ","translation":"slander","transliteration":"bibuh'tānin"},{"position":23,"arabic":"يَفْتَرِينَهُۥ","translation":"they invent it","transliteration":"yaftarīnahu"},{"position":24,"arabic":"بَيْنَ","translation":"between","transliteration":"bayna"},{"position":25,"arabic":"أَيْدِيهِنَّ","translation":"their hands","transliteration":"aydīhinna"},{"position":26,"arabic":"وَأَرْجُلِهِنَّ","translation":"and their feet","transliteration":"wa-arjulihinna"},{"position":27,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":28,"arabic":"يَعْصِينَكَ","translation":"they will disobey you","transliteration":"yaʿṣīnaka"},{"position":29,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":30,"arabic":"مَعْرُوفٍۢ ۙ","translation":"(the) right","transliteration":"maʿrūfin"},{"position":31,"arabic":"فَبَايِعْهُنَّ","translation":"then accept their pledge","transliteration":"fabāyiʿ'hunna"},{"position":32,"arabic":"وَٱسْتَغْفِرْ","translation":"and ask forgiveness","transliteration":"wa-is'taghfir"},{"position":33,"arabic":"لَهُنَّ","translation":"for them","transliteration":"lahunna"},{"position":34,"arabic":"ٱللَّهَ ۖ","translation":"(from) Allah","transliteration":"l-laha"},{"position":35,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":36,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":37,"arabic":"غَفُورٌۭ","translation":"(is) Oft-Forgiving","transliteration":"ghafūrun"},{"position":38,"arabic":"رَّحِيمٌۭ","translation":"Most Merciful","transliteration":"raḥīmun"}],"e3rab":"(يا أَيُّهَا) منادى والها للتنبيه (النَّبِيُّ) بدل من المنادى (إِذا) ظرفية شرطية غير جازمة (جاءَكَ) ماض ومفعوله (الْمُؤْمِناتُ) فاعله والجملة في محل جر بالإضافة (يُبايِعْنَكَ) مضارع مبني على السكون لاتصاله بنون النسوة والنون فاعل والكاف مفعول به والجملة حال (عَلى) حرف جر (أَنْ) حرف ناصب (لا) نافية (يُشْرِكْنَ) مضارع مبني على السكون في محل نصب بأن والنون فاعل والمصدر المؤول من أن والفعل في محل جر بعلى والجار والمجرور متعلقان بالفعل (بِاللَّهِ) متعلقان بالفعل (شَيْئاً) مفعول مطلق (وَلا يَسْرِقْنَ وَلا يَزْنِينَ وَلا يَقْتُلْنَ) معطوف على ما قبله، (أَوْلادَهُنَّ) مفعول به (وَلا يَأْتِينَ) معطوف على أن يشركن (بِبُهْتانٍ) متعلقان بالفعل (يَفْتَرِينَهُ) مضارع مبني على السكون لاتصاله بنون النسوة والنون فاعل والهاء مفعول به والجملة حال (بَيْنَ) ظرف مكان مضاف إلى أيديهن و(أَرْجُلِهِنَّ) معطوف على أيديهن.\r\n\r\n(وَلا يَعْصِينَكَ) معطوف على أن لا يشركن (فِي مَعْرُوفٍ) متعلقان بالفعل (فَبايِعْهُنَّ) الفاء رابطة وأمر ومفعوله والفاعل مستتر والجملة جواب الشرط لا محل لها (وَاسْتَغْفِرْ) أمر فاعله مستتر (لَهُنَّ) متعلقان بالفعل (اللَّهَ) لفظ الجلالة مفعول به والجملة معطوفة على ما قبلها لا محل لها مثلها.\r\n\r\n(إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ) إن واسمها وخبراها والجملة تعليل.\r\n\r\n"},{"sura":60,"ayah":13,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"arabic":"تَتَوَلَّوْا۟","translation":"make allies","transliteration":"tatawallaw"},{"position":6,"arabic":"قَوْمًا","translation":"(of) a people","transliteration":"qawman"},{"position":7,"arabic":"غَضِبَ","translation":"(The) wrath","transliteration":"ghaḍiba"},{"position":8,"arabic":"ٱللَّهُ","translation":"(of) Allah","transliteration":"l-lahu"},{"position":9,"arabic":"عَلَيْهِمْ","translation":"(is) upon them","transliteration":"ʿalayhim"},{"position":10,"arabic":"قَدْ","translation":"Indeed","transliteration":"qad"},{"position":11,"arabic":"يَئِسُوا۟","translation":"they despair","transliteration":"ya-isū"},{"position":12,"arabic":"مِنَ","translation":"of","transliteration":"mina"},{"position":13,"arabic":"ٱلْـَٔاخِرَةِ","translation":"the Hereafter","transliteration":"l-ākhirati"},{"position":14,"arabic":"كَمَا","translation":"as","transliteration":"kamā"},{"position":15,"arabic":"يَئِسَ","translation":"despair","transliteration":"ya-isa"},{"position":16,"arabic":"ٱلْكُفَّارُ","translation":"the disbelievers","transliteration":"l-kufāru"},{"position":17,"arabic":"مِنْ","translation":"of","transliteration":"min"},{"position":18,"arabic":"أَصْحَـٰبِ","translation":"(the) companions","transliteration":"aṣḥābi"},{"position":19,"arabic":"ٱلْقُبُورِ","translation":"(of) the graves","transliteration":"l-qubūri"}],"e3rab":"(يا أَيُّهَا الَّذِينَ آمَنُوا) سبق إعرابها.\r\n\r\n(لا تَتَوَلَّوْا) مضارع مجزوم بلا الناهية والواو فاعله (قَوْماً) مفعول به والجملة استئنافية لا محل لها (غَضِبَ اللَّهُ) ماض وفاعله (عَلَيْهِمْ) متعلقان بالفعل والجملة صفة قوما، (قَدْ) حرف تحقيق (يَئِسُوا) ماض وفاعله والجملة حال (مِنَ الْآخِرَةِ) متعلقان بالفعل (كَما يَئِسَ الْكُفَّارُ) كما متعلقان بصفة مفعول مطلق محذوف وماض وفاعله (مِنْ أَصْحابِ) متعلقان بالفعل (الْقُبُورِ) مضاف إليه.\r\n\r\n"}]