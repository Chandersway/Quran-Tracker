[{"sura":107,"ayah":1,"words":[{"position":1,"arabic":"أَرَءَيْتَ","translation":"Have you seen","transliteration":"ara-ayta"},{"position":2,"arabic":"ٱلَّذِى","translation":"the one who","transliteration":"alladhī"},{"position":3,"arabic":"يُكَذِّبُ","translation":"denies","transliteration":"yukadhibu"},{"position":4,"arabic":"بِٱلدِّينِ","translation":"the Judgment","transliteration":"bil-dīni"}],"e3rab":"(أَرَأَيْتَ) الهمزة حرف استفهام وماض وفاعله (الَّذِي) مفعول به والجملة ابتدائية لا محل لها (يُكَذِّبُ) مضارع فاعله مستتر (بِالدِّينِ) متعلقان بالفعل والجملة صلة.\r\n\r\n"},{"sura":107,"ayah":2,"words":[{"position":1,"arabic":"فَذَٰلِكَ","translation":"Then that","transliteration":"fadhālika"},{"position":2,"arabic":"ٱلَّذِى","translation":"(is) the one who","transliteration":"alladhī"},{"position":3,"arabic":"يَدُعُّ","translation":"repulses","transliteration":"yaduʿʿu"},{"position":4,"arabic":"ٱلْيَتِيمَ","translation":"the orphan","transliteration":"l-yatīma"}],"e3rab":"(فَذلِكَ) الفاء الفصيحة واسم الإشارة مبتدأ (الَّذِي) خبره والجملة جواب شرط مقدر لا محل لها.\r\n\r\n(يَدُعُّ) مضارع فاعله مستتر (الْيَتِيمَ) مفعول به والجملة صلة.\r\n\r\n"},{"sura":107,"ayah":3,"words":[{"position":1,"arabic":"وَلَا","translation":"And (does) not","transliteration":"walā"},{"position":2,"arabic":"يَحُضُّ","translation":"feel the urge","transliteration":"yaḥuḍḍu"},{"position":3,"arabic":"عَلَىٰ","translation":"to","transliteration":"ʿalā"},{"position":4,"arabic":"طَعَامِ","translation":"feed","transliteration":"ṭaʿāmi"},{"position":5,"arabic":"ٱلْمِسْكِينِ","translation":"the poor","transliteration":"l-mis'kīni"}],"e3rab":"(وَلا) الواو حرف عطف (لا) نافية (يَحُضُّ) مضارع فاعله مستتر (عَلى طَعامِ) متعلقان بالفعل (الْمِسْكِينِ) مضاف إليه. والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":107,"ayah":4,"words":[{"position":1,"arabic":"فَوَيْلٌۭ","translation":"So woe","transliteration":"fawaylun"},{"position":2,"arabic":"لِّلْمُصَلِّينَ","translation":"to those who pray","transliteration":"lil'muṣallīna"}],"e3rab":"(فَوَيْلٌ) الفاء للسببية (ويل) مبتدأ (لِلْمُصَلِّينَ) خبر المبتدأ.\r\n\r\n"},{"sura":107,"ayah":5,"words":[{"position":1,"arabic":"ٱلَّذِينَ","translation":"Those who","transliteration":"alladhīna"},{"position":2,"arabic":"هُمْ","translation":"[they]","transliteration":"hum"},{"position":3,"arabic":"عَن","translation":"about","transliteration":"ʿan"},{"position":4,"arabic":"صَلَاتِهِمْ","translation":"their prayers","transliteration":"ṣalātihim"},{"position":5,"arabic":"سَاهُونَ","translation":"(are) neglectful","transliteration":"sāhūna"}],"e3rab":"(الَّذِينَ) صفة المصلين (هُمْ) مبتدأ (عَنْ صَلاتِهِمْ) متعلقان بالخبر (ساهُونَ) خبر والجملة صلة.\r\n\r\n"},{"sura":107,"ayah":6,"words":[{"position":1,"arabic":"ٱلَّذِينَ","translation":"Those who","transliteration":"alladhīna"},{"position":2,"arabic":"هُمْ","translation":"[they]","transliteration":"hum"},{"position":3,"arabic":"يُرَآءُونَ","translation":"make show","transliteration":"yurāūna"}],"e3rab":"(الَّذِينَ) بدل من الذين السابقة (هُمْ) مبتدأ (يُراؤُنَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر المبتدأ والجملة الاسمية صلة.\r\n\r\n"},{"sura":107,"ayah":7,"words":[{"position":1,"arabic":"وَيَمْنَعُونَ","translation":"And they deny","transliteration":"wayamnaʿūna"},{"position":2,"arabic":"ٱلْمَاعُونَ","translation":"[the] small kindnesses","transliteration":"l-māʿūna"}],"e3rab":"(وَيَمْنَعُونَ) مضارع وفاعله والمفعول الأول محذوف تقديره الناس (الْماعُونَ) مفعول به ثان والجملة معطوفة على ما قبلها.\r\n\r\n"}]