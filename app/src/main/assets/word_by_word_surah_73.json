[{"sura":73,"ayah":1,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلْمُزَّمِّلُ","translation":"who wraps himself","transliteration":"l-muzamilu"}],"e3rab":"(يا أَيُّهَا) حرف نداء ومنادى مبني على الضم في محل نصب وها حرف تنبيه و(الْمُزَّمِّلُ) بدل من أي\r\n\r\n"},{"sura":73,"ayah":2,"words":[{"position":1,"arabic":"قُمِ","translation":"Stand","transliteration":"qumi"},{"position":2,"arabic":"ٱلَّيْلَ","translation":"(in) the night","transliteration":"al-layla"},{"position":3,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":4,"arabic":"قَلِيلًۭا","translation":"a little","transliteration":"qalīlan"}],"e3rab":"(قُمِ) أمر فاعله مستتر (اللَّيْلَ) ظرف زمان والجملة الفعلية ابتدائية لا محل لها كجملة النداء و(إِلَّا) أداة استثناء (قَلِيلًا) مستثنى منصوب\r\n\r\n"},{"sura":73,"ayah":3,"words":[{"position":1,"arabic":"نِّصْفَهُۥٓ","translation":"Half of it","transliteration":"niṣ'fahu"},{"position":2,"arabic":"أَوِ","translation":"or","transliteration":"awi"},{"position":3,"arabic":"ٱنقُصْ","translation":"lessen","transliteration":"unquṣ"},{"position":4,"arabic":"مِنْهُ","translation":"from it","transliteration":"min'hu"},{"position":5,"arabic":"قَلِيلًا","translation":"a little","transliteration":"qalīlan"}],"e3rab":"و(نِصْفَهُ) بدل من الليل (أَوِ) حرف عطف (انْقُصْ) أمر فاعله مستتر (مِنْهُ) متعلقان بالفعل (قَلِيلًا) صفة لمحذوف تقديره زمانا\r\n\r\n"},{"sura":73,"ayah":4,"words":[{"position":1,"arabic":"أَوْ","translation":"Or","transliteration":"aw"},{"position":2,"arabic":"زِدْ","translation":"add","transliteration":"zid"},{"position":3,"arabic":"عَلَيْهِ","translation":"to it","transliteration":"ʿalayhi"},{"position":4,"arabic":"وَرَتِّلِ","translation":"and recite","transliteration":"warattili"},{"position":5,"arabic":"ٱلْقُرْءَانَ","translation":"the Quran","transliteration":"l-qur'āna"},{"position":6,"arabic":"تَرْتِيلًا","translation":"(with) measured rhythmic recitation","transliteration":"tartīlan"}],"e3rab":"(أَوْ) حرف عطف (زِدْ) معطوف على انقص و(عَلَيْهِ) متعلقان بالفعل (وَرَتِّلِ) أمر فاعله مستتر و(الْقُرْآنَ) مفعول به و(تَرْتِيلًا) مفعول مطلق والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":73,"ayah":5,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"سَنُلْقِى","translation":"will cast","transliteration":"sanul'qī"},{"position":3,"arabic":"عَلَيْكَ","translation":"upon you","transliteration":"ʿalayka"},{"position":4,"arabic":"قَوْلًۭا","translation":"a Word","transliteration":"qawlan"},{"position":5,"arabic":"ثَقِيلًا","translation":"heavy","transliteration":"thaqīlan"}],"e3rab":"(إِنَّا) إن واسمها (سَنُلْقِي) السين للاستقبال ومضارع فاعله مستتر و(عَلَيْكَ) متعلقان بالفعل و(قَوْلًا) مفعول به (ثَقِيلًا) صفة والجملة الفعلية خبر إن والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"},{"sura":73,"ayah":6,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"نَاشِئَةَ","translation":"(the) rising","transliteration":"nāshi-ata"},{"position":3,"arabic":"ٱلَّيْلِ","translation":"(at) the night","transliteration":"al-layli"},{"position":4,"arabic":"هِىَ","translation":"it","transliteration":"hiya"},{"position":5,"arabic":"أَشَدُّ","translation":"(is) very hard","transliteration":"ashaddu"},{"position":6,"arabic":"وَطْـًۭٔا","translation":"and most potent","transliteration":"waṭan"},{"position":7,"arabic":"وَأَقْوَمُ","translation":"and more suitable","transliteration":"wa-aqwamu"},{"position":8,"arabic":"قِيلًا","translation":"(for) Word","transliteration":"qīlan"}],"e3rab":"(إِنَّ ناشِئَةَ اللَّيْلِ) إن واسمها المضاف إلى الليل و(هِيَ أَشَدُّ) مبتدأ وخبره والجملة خبر إن والجملة الاسمية إن ناشئة.. تعليل لا محل لها و(وَطْئاً) تمييز (أَقْوَمُ) معطوف على أشد و(قِيلًا) تمييز.\r\n\r\n"},{"sura":73,"ayah":7,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"لَكَ","translation":"for you","transliteration":"laka"},{"position":3,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":4,"arabic":"ٱلنَّهَارِ","translation":"the day","transliteration":"l-nahāri"},{"position":5,"arabic":"سَبْحًۭا","translation":"(is) occupation","transliteration":"sabḥan"},{"position":6,"arabic":"طَوِيلًۭا","translation":"prolonged","transliteration":"ṭawīlan"}],"e3rab":"(إِنَّ) حرف مشبه بالفعل (لَكَ) متعلقان بخبر محذوف (فِي النَّهارِ) حال (سَبْحاً) اسم إن المؤخر و(طَوِيلًا) صفة والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":73,"ayah":8,"words":[{"position":1,"arabic":"وَٱذْكُرِ","translation":"And remember","transliteration":"wa-udh'kuri"},{"position":2,"arabic":"ٱسْمَ","translation":"(the) name","transliteration":"is'ma"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"وَتَبَتَّلْ","translation":"and devote yourself","transliteration":"watabattal"},{"position":5,"arabic":"إِلَيْهِ","translation":"to Him","transliteration":"ilayhi"},{"position":6,"arabic":"تَبْتِيلًۭا","translation":"(with) devotion","transliteration":"tabtīlan"}],"e3rab":"(وَاذْكُرِ) أمر فاعله مستتر و(اسْمَ) مفعول به مضاف إلى (رَبِّكَ) والجملة معطوفة على ما قبلها (وَتَبَتَّلْ) أمر فاعله مستتر و(إِلَيْهِ) متعلقان بالفعل و(تَبْتِيلًا) مفعول مطلق والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":73,"ayah":9,"words":[{"position":1,"arabic":"رَّبُّ","translation":"(The) Lord","transliteration":"rabbu"},{"position":2,"arabic":"ٱلْمَشْرِقِ","translation":"(of) the east","transliteration":"l-mashriqi"},{"position":3,"arabic":"وَٱلْمَغْرِبِ","translation":"and the west","transliteration":"wal-maghribi"},{"position":4,"arabic":"لَآ","translation":"(there is) no","transliteration":"lā"},{"position":5,"arabic":"إِلَـٰهَ","translation":"god","transliteration":"ilāha"},{"position":6,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":7,"arabic":"هُوَ","translation":"Him","transliteration":"huwa"},{"position":8,"arabic":"فَٱتَّخِذْهُ","translation":"so take Him","transliteration":"fa-ittakhidh'hu"},{"position":9,"arabic":"وَكِيلًۭا","translation":"(as) Disposer of Affairs","transliteration":"wakīlan"}],"e3rab":"(رَبُّ) خبر لمبتدأ محذوف و(الْمَشْرِقِ) مضاف إليه (وَالْمَغْرِبِ) معطوف على المشرق والجملة مستأنفة لا محل لها و(لا) نافية للجنس و(إِلهَ) اسمها المبني على الفتح و(إِلَّا) حرف حصر و(هُوَ) بدل من الضمير المستتر في الخبر المحذوف والجملة حال (فَاتَّخِذْهُ) الفاء الفصيحة وأمر فاعله مستتر والهاء مفعول به أول (وَكِيلًا) مفعول به ثان والجملة جواب شرط مقدر لا محل لها.\r\n\r\n"},{"sura":73,"ayah":10,"words":[{"position":1,"arabic":"وَٱصْبِرْ","translation":"And be patient","transliteration":"wa-iṣ'bir"},{"position":2,"arabic":"عَلَىٰ","translation":"over","transliteration":"ʿalā"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"يَقُولُونَ","translation":"they say","transliteration":"yaqūlūna"},{"position":5,"arabic":"وَٱهْجُرْهُمْ","translation":"and avoid them","transliteration":"wa-uh'jur'hum"},{"position":6,"arabic":"هَجْرًۭا","translation":"an avoidance","transliteration":"hajran"},{"position":7,"arabic":"جَمِيلًۭا","translation":"gracious","transliteration":"jamīlan"}],"e3rab":"(وَاصْبِرْ) أمر فاعله مستتر و(عَلى ما) متعلقان بالفعل والجملة معطوفة على ما قبلها و(يَقُولُونَ) مضارع وفاعله والجملة صلة ما (وَاهْجُرْهُمْ) أمر ومفعوله والفاعل مستتر و(هَجْراً) مفعول مطلق (جَمِيلًا) صفة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":73,"ayah":11,"words":[{"position":1,"arabic":"وَذَرْنِى","translation":"And leave Me","transliteration":"wadharnī"},{"position":2,"arabic":"وَٱلْمُكَذِّبِينَ","translation":"and the deniers","transliteration":"wal-mukadhibīna"},{"position":3,"arabic":"أُو۟لِى","translation":"possessors","transliteration":"ulī"},{"position":4,"arabic":"ٱلنَّعْمَةِ","translation":"(of) the ease","transliteration":"l-naʿmati"},{"position":5,"arabic":"وَمَهِّلْهُمْ","translation":"and allow them respite ","transliteration":"wamahhil'hum"},{"position":6,"arabic":"قَلِيلًا","translation":"a little","transliteration":"qalīlan"}],"e3rab":"(وَذَرْنِي) أمر فاعله مستتر والنون للوقاية والياء مفعول به والجملة معطوفة على ما قبلها (وَالْمُكَذِّبِينَ) مفعول معه (أُولِي) صفة المكذبين و(النَّعْمَةِ) مضاف إليه (وَمَهِّلْهُمْ) أمر ومفعوله والفاعل مستتر و(قَلِيلًا) صفة مفعول مطلق محذوف والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":73,"ayah":12,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"لَدَيْنَآ","translation":"with Us","transliteration":"ladaynā"},{"position":3,"arabic":"أَنكَالًۭا","translation":"(are) shackles","transliteration":"ankālan"},{"position":4,"arabic":"وَجَحِيمًۭا","translation":"and burning fire","transliteration":"wajaḥīman"}],"e3rab":"(إِنَّ) حرف مشبه بالفعل و(لَدَيْنا) ظرف مكان متعلق بمحذوف خبر إن المقدم و(أَنْكالًا) اسم إن المؤخر (وَجَحِيماً) معطوف على أنكالا والجملة مستأنفة.\r\n\r\n"},{"sura":73,"ayah":13,"words":[{"position":1,"arabic":"وَطَعَامًۭا","translation":"And food","transliteration":"waṭaʿāman"},{"position":2,"arabic":"ذَا","translation":"that","transliteration":"dhā"},{"position":3,"arabic":"غُصَّةٍۢ","translation":"chokes","transliteration":"ghuṣṣatin"},{"position":4,"arabic":"وَعَذَابًا","translation":"and a punishment","transliteration":"waʿadhāban"},{"position":5,"arabic":"أَلِيمًۭا","translation":"painful","transliteration":"alīman"}],"e3rab":"(وَطَعاماً) معطوف على أنكالا و(ذا) صفة مضاف إلى (غُصَّةٍ) مضاف إليه (وَعَذاباً) معطوف أيضا و(أَلِيماً) صفة عذابا.\r\n\r\n"},{"sura":73,"ayah":14,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(On the) Day","transliteration":"yawma"},{"position":2,"arabic":"تَرْجُفُ","translation":"will quake","transliteration":"tarjufu"},{"position":3,"arabic":"ٱلْأَرْضُ","translation":"the earth","transliteration":"l-arḍu"},{"position":4,"arabic":"وَٱلْجِبَالُ","translation":"and the mountains","transliteration":"wal-jibālu"},{"position":5,"arabic":"وَكَانَتِ","translation":"and will become","transliteration":"wakānati"},{"position":6,"arabic":"ٱلْجِبَالُ","translation":"the mountains","transliteration":"l-jibālu"},{"position":7,"arabic":"كَثِيبًۭا","translation":"a heap of sand","transliteration":"kathīban"},{"position":8,"arabic":"مَّهِيلًا","translation":"pouring down","transliteration":"mahīlan"}],"e3rab":"(يَوْمَ تَرْجُفُ الْأَرْضُ) ظرف زمان ومضارع وفاعله (وَالْجِبالُ) معطوف على الأرض والجملة في محل جر بالإضافة (وَكانَتِ الْجِبالُ كَثِيباً) كان واسمها وخبرها و(مَهِيلًا) صفة كثيبا والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":73,"ayah":15,"words":[{"position":1,"arabic":"إِنَّآ","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"أَرْسَلْنَآ","translation":"[We] have sent","transliteration":"arsalnā"},{"position":3,"arabic":"إِلَيْكُمْ","translation":"to you","transliteration":"ilaykum"},{"position":4,"arabic":"رَسُولًۭا","translation":"a Messenger","transliteration":"rasūlan"},{"position":5,"arabic":"شَـٰهِدًا","translation":"(as) a witness","transliteration":"shāhidan"},{"position":6,"arabic":"عَلَيْكُمْ","translation":"upon you","transliteration":"ʿalaykum"},{"position":7,"arabic":"كَمَآ","translation":"as","transliteration":"kamā"},{"position":8,"arabic":"أَرْسَلْنَآ","translation":"We sent","transliteration":"arsalnā"},{"position":9,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":10,"arabic":"فِرْعَوْنَ","translation":"Firaun","transliteration":"fir'ʿawna"},{"position":11,"arabic":"رَسُولًۭا","translation":"a Messenger","transliteration":"rasūlan"}],"e3rab":"(إِنَّا) إن واسمها (أَرْسَلْنا) ماض وفاعله و(إِلَيْكُمْ) متعلقان بالفعل و(رَسُولًا) مفعول به و(شاهِداً) صفة رسولا والجملة الفعلية خبر إن والجملة الاسمية مستأنفة لا محل لها (عَلَيْكُمْ) متعلقان بشاهدا و(كَما) صفة مفعول مطلق محذوف (أَرْسَلْنا) ماض وفاعله و(إِلى فِرْعَوْنَ) متعلقان بالفعل و(رَسُولًا) مفعول به.\r\n\r\n"},{"sura":73,"ayah":16,"words":[{"position":1,"arabic":"فَعَصَىٰ","translation":"But disobeyed","transliteration":"faʿaṣā"},{"position":2,"arabic":"فِرْعَوْنُ","translation":"Firaun","transliteration":"fir'ʿawnu"},{"position":3,"arabic":"ٱلرَّسُولَ","translation":"the Messenger","transliteration":"l-rasūla"},{"position":4,"arabic":"فَأَخَذْنَـٰهُ","translation":"so We seized him","transliteration":"fa-akhadhnāhu"},{"position":5,"arabic":"أَخْذًۭا","translation":"(with) a seizure","transliteration":"akhdhan"},{"position":6,"arabic":"وَبِيلًۭا","translation":"ruinous","transliteration":"wabīlan"}],"e3rab":"(فَعَصى فِرْعَوْنُ الرَّسُولَ) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها (فَأَخَذْناهُ) ماض وفاعله ومفعوله و(أَخْذاً) مفعول مطلق (وَبِيلًا) صفة والجملة معطوفة على ما قبلها أيضا.\r\n\r\n"},{"sura":73,"ayah":17,"words":[{"position":1,"arabic":"فَكَيْفَ","translation":"Then how","transliteration":"fakayfa"},{"position":2,"arabic":"تَتَّقُونَ","translation":"will you guard yourselves","transliteration":"tattaqūna"},{"position":3,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":4,"arabic":"كَفَرْتُمْ","translation":"you disbelieve","transliteration":"kafartum"},{"position":5,"arabic":"يَوْمًۭا","translation":"a Day","transliteration":"yawman"},{"position":6,"arabic":"يَجْعَلُ","translation":"(that) will make","transliteration":"yajʿalu"},{"position":7,"arabic":"ٱلْوِلْدَٰنَ","translation":"the children","transliteration":"l-wil'dāna"},{"position":8,"arabic":"شِيبًا","translation":"gray-haired","transliteration":"shīban"}],"e3rab":"(فَكَيْفَ) اسم استفهام في محل نصب على الحال (تَتَّقُونَ) مضارع مرفوع والواو فاعله والجملة مستأنفة لا محل لها و(إِنْ) شرطية جازمة (كَفَرْتُمْ) ماض وفاعله والجملة ابتدائية لا محل لها وجواب الشرط محذوف و(يَوْماً) مفعول تتقون (يَجْعَلُ) مضارع فاعله مستتر و(الْوِلْدانَ) مفعول به أول (شِيباً) مفعول به ثان والجملة صفة يوما.\r\n\r\n"},{"sura":73,"ayah":18,"words":[{"position":1,"arabic":"ٱلسَّمَآءُ","translation":"The heaven","transliteration":"al-samāu"},{"position":2,"arabic":"مُنفَطِرٌۢ","translation":"(will) break apart","transliteration":"munfaṭirun"},{"position":3,"arabic":"بِهِۦ ۚ","translation":"therefrom","transliteration":"bihi"},{"position":4,"arabic":"كَانَ","translation":"is","transliteration":"kāna"},{"position":5,"arabic":"وَعْدُهُۥ","translation":"His Promise","transliteration":"waʿduhu"},{"position":6,"arabic":"مَفْعُولًا","translation":"to be fulfilled","transliteration":"mafʿūlan"}],"e3rab":"(السَّماءُ مُنْفَطِرٌ) مبتدأ وخبره و(بِهِ) متعلقان بمنفطر والجملة الاسمية صفة ثانية ليوما (كانَ وَعْدُهُ مَفْعُولًا) كان واسمها وخبرها والجملة تعليل لا محل لها.\r\n\r\n"},{"sura":73,"ayah":19,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"هَـٰذِهِۦ","translation":"this","transliteration":"hādhihi"},{"position":3,"arabic":"تَذْكِرَةٌۭ ۖ","translation":"(is) a Reminder","transliteration":"tadhkiratun"},{"position":4,"arabic":"فَمَن","translation":"then whoever","transliteration":"faman"},{"position":5,"arabic":"شَآءَ","translation":"wills","transliteration":"shāa"},{"position":6,"arabic":"ٱتَّخَذَ","translation":"(let him) take","transliteration":"ittakhadha"},{"position":7,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":8,"arabic":"رَبِّهِۦ","translation":"his Lord","transliteration":"rabbihi"},{"position":9,"arabic":"سَبِيلًا","translation":"a way","transliteration":"sabīlan"}],"e3rab":"(إِنَّ هذِهِ تَذْكِرَةٌ) إن واسمها وخبرها والجملة مستأنفة لا محل لها.\r\n\r\n(فَمَنْ) الفاء الفصيحة و(من) اسم شرط جازم مبتدأ (شاءَ) ماض فاعله مستتر وهو فعل الشرط (اتَّخَذَ) ماض فاعله مستتر وهو جواب الشرط و(إِلى رَبِّهِ) متعلقان بمحذوف حال و(سَبِيلًا) مفعول به وجملة اتخذ.. جواب الشرط لا محل لها وجملتا الشرط والجواب خبر من وجملة من جواب شرط مقدر لا محل لها.\r\n\r\n"},{"sura":73,"ayah":20,"words":[{"position":1,"arabic":"۞ إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"رَبَّكَ","translation":"your Lord","transliteration":"rabbaka"},{"position":3,"arabic":"يَعْلَمُ","translation":"knows","transliteration":"yaʿlamu"},{"position":4,"arabic":"أَنَّكَ","translation":"that you","transliteration":"annaka"},{"position":5,"arabic":"تَقُومُ","translation":"stand","transliteration":"taqūmu"},{"position":6,"arabic":"أَدْنَىٰ","translation":"(a little) less","transliteration":"adnā"},{"position":7,"arabic":"مِن","translation":"than","transliteration":"min"},{"position":8,"arabic":"ثُلُثَىِ","translation":"two-thirds","transliteration":"thuluthayi"},{"position":9,"arabic":"ٱلَّيْلِ","translation":"(of) the night","transliteration":"al-layli"},{"position":10,"arabic":"وَنِصْفَهُۥ","translation":"and half of it","transliteration":"waniṣ'fahu"},{"position":11,"arabic":"وَثُلُثَهُۥ","translation":"and a third of it","transliteration":"wathuluthahu"},{"position":12,"arabic":"وَطَآئِفَةٌۭ","translation":"and (so do) a group","transliteration":"waṭāifatun"},{"position":13,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":14,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":15,"arabic":"مَعَكَ ۚ","translation":"(are) with you","transliteration":"maʿaka"},{"position":16,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":17,"arabic":"يُقَدِّرُ","translation":"determines","transliteration":"yuqaddiru"},{"position":18,"arabic":"ٱلَّيْلَ","translation":"the night","transliteration":"al-layla"},{"position":19,"arabic":"وَٱلنَّهَارَ ۚ","translation":"and the day","transliteration":"wal-nahāra"},{"position":20,"arabic":"عَلِمَ","translation":"He knows","transliteration":"ʿalima"},{"position":21,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":22,"arabic":"لَّن","translation":"not","transliteration":"lan"},{"position":23,"arabic":"تُحْصُوهُ","translation":"you count it","transliteration":"tuḥ'ṣūhu"},{"position":24,"arabic":"فَتَابَ","translation":"so He has turned","transliteration":"fatāba"},{"position":25,"arabic":"عَلَيْكُمْ ۖ","translation":"to you","transliteration":"ʿalaykum"},{"position":26,"arabic":"فَٱقْرَءُوا۟","translation":"so recite","transliteration":"fa-iq'raū"},{"position":27,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":28,"arabic":"تَيَسَّرَ","translation":"is easy","transliteration":"tayassara"},{"position":29,"arabic":"مِنَ","translation":"of","transliteration":"mina"},{"position":30,"arabic":"ٱلْقُرْءَانِ ۚ","translation":"the Quran","transliteration":"l-qur'āni"},{"position":31,"arabic":"عَلِمَ","translation":"He knows","transliteration":"ʿalima"},{"position":32,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":33,"arabic":"سَيَكُونُ","translation":"there will be","transliteration":"sayakūnu"},{"position":34,"arabic":"مِنكُم","translation":"among you","transliteration":"minkum"},{"position":35,"arabic":"مَّرْضَىٰ ۙ","translation":"sick","transliteration":"marḍā"},{"position":36,"arabic":"وَءَاخَرُونَ","translation":"and others","transliteration":"waākharūna"},{"position":37,"arabic":"يَضْرِبُونَ","translation":"traveling","transliteration":"yaḍribūna"},{"position":38,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":39,"arabic":"ٱلْأَرْضِ","translation":"the land","transliteration":"l-arḍi"},{"position":40,"arabic":"يَبْتَغُونَ","translation":"seeking","transliteration":"yabtaghūna"},{"position":41,"arabic":"مِن","translation":"of","transliteration":"min"},{"position":42,"arabic":"فَضْلِ","translation":"(the) Bounty","transliteration":"faḍli"},{"position":43,"arabic":"ٱللَّهِ ۙ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":44,"arabic":"وَءَاخَرُونَ","translation":"and others","transliteration":"waākharūna"},{"position":45,"arabic":"يُقَـٰتِلُونَ","translation":"fighting","transliteration":"yuqātilūna"},{"position":46,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":47,"arabic":"سَبِيلِ","translation":"(the) way","transliteration":"sabīli"},{"position":48,"arabic":"ٱللَّهِ ۖ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":49,"arabic":"فَٱقْرَءُوا۟","translation":"So recite","transliteration":"fa-iq'raū"},{"position":50,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":51,"arabic":"تَيَسَّرَ","translation":"is easy","transliteration":"tayassara"},{"position":52,"arabic":"مِنْهُ ۚ","translation":"of it","transliteration":"min'hu"},{"position":53,"arabic":"وَأَقِيمُوا۟","translation":"and establish","transliteration":"wa-aqīmū"},{"position":54,"arabic":"ٱلصَّلَوٰةَ","translation":"the prayer","transliteration":"l-ṣalata"},{"position":55,"arabic":"وَءَاتُوا۟","translation":"and give","transliteration":"waātū"},{"position":56,"arabic":"ٱلزَّكَوٰةَ","translation":"the zakah","transliteration":"l-zakata"},{"position":57,"arabic":"وَأَقْرِضُوا۟","translation":"and loan","transliteration":"wa-aqriḍū"},{"position":58,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":59,"arabic":"قَرْضًا","translation":"a loan","transliteration":"qarḍan"},{"position":60,"arabic":"حَسَنًۭا ۚ","translation":"goodly","transliteration":"ḥasanan"},{"position":61,"arabic":"وَمَا","translation":"And whatever","transliteration":"wamā"},{"position":62,"arabic":"تُقَدِّمُوا۟","translation":"you send forth","transliteration":"tuqaddimū"},{"position":63,"arabic":"لِأَنفُسِكُم","translation":"for yourselves","transliteration":"li-anfusikum"},{"position":64,"arabic":"مِّنْ","translation":"of","transliteration":"min"},{"position":65,"arabic":"خَيْرٍۢ","translation":"good","transliteration":"khayrin"},{"position":66,"arabic":"تَجِدُوهُ","translation":"you will find it","transliteration":"tajidūhu"},{"position":67,"arabic":"عِندَ","translation":"with","transliteration":"ʿinda"},{"position":68,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":69,"arabic":"هُوَ","translation":"It","transliteration":"huwa"},{"position":70,"arabic":"خَيْرًۭا","translation":"(will be) better","transliteration":"khayran"},{"position":71,"arabic":"وَأَعْظَمَ","translation":"and greater","transliteration":"wa-aʿẓama"},{"position":72,"arabic":"أَجْرًۭا ۚ","translation":"(in) reward","transliteration":"ajran"},{"position":73,"arabic":"وَٱسْتَغْفِرُوا۟","translation":"And seek forgiveness","transliteration":"wa-is'taghfirū"},{"position":74,"arabic":"ٱللَّهَ ۖ","translation":"(of) Allah","transliteration":"l-laha"},{"position":75,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":76,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":77,"arabic":"غَفُورٌۭ","translation":"(is) Oft-Forgiving","transliteration":"ghafūrun"},{"position":78,"arabic":"رَّحِيمٌۢ","translation":"Most Merciful","transliteration":"raḥīmun"}],"e3rab":"(إِنَّ رَبَّكَ) إن واسمها (يَعْلَمُ) مضارع فاعله مستتر والجملة الفعلية خبر إن والجملة الاسمية مستأنفة لا محل لها (أَنَّكَ) أن واسمها (تَقُومُ) مضارع فاعله مستتر و(أَدْنى) ظرف زمان والجملة الفعلية خبر أنك والمصدر المؤول من أن وما بعدها سد مسد مفعولي يعلم و(مِنْ ثُلُثَيِ) متعلقان بأدنى و(اللَّيْلِ) مضاف إليه (وَنِصْفَهُ وَثُلُثَهُ) معطوفان على أدنى (وَطائِفَةٌ) معطوف على فاعل تقوم المستتر و(مِنَ الَّذِينَ) متعلقان بمحذوف صفة طائفة و(مَعَكَ) ظرف مكان (وَاللَّهُ يُقَدِّرُ) الواو حرف استئناف ولفظ الجلالة مبتدأ ومضارع فاعله مستتر و(اللَّيْلِ) مفعول به (وَالنَّهارَ) معطوف عليه والجملة الفعلية خبر المبتدأ، والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n(عَلِمَ) ماض فاعله مستتر (إِنَّ) مخففة من الثقيلة واسمها ضمير الشأن محذوف (لَنْ تُحْصُوهُ) مضارع منصوب بلن والواو فاعله والهاء مفعوله والجملة خبر أن المخففة والمصدر المؤول من أن المخففة وما بعدها سد مسد مفعولي علم وجملة علم مستأنفة لا محل لها (فَتابَ) ماض فاعله مستتر و(عَلَيْكُمْ) متعلقان بالفعل والجملة معطوفة على ما قبلها.\r\n\r\n(فَاقْرَؤُا) الفاء حرف عطف وأمر وفاعله و(ما) مفعول به والجملة معطوفة على ما قبلها و(تَيَسَّرَ) ماض فاعله مستتر و(مِنَ الْقُرْآنِ) متعلقان بالفعل والجملة صلة ما (عَلِمَ) ماض فاعله مستتر و(إِنَّ) مخففة من الثقيلة واسمها ضمير الشأن محذوف (سَيَكُونُ) السين للاستقبال ومضارع ناقص و(مِنْكُمْ) خبر يكون المقدم و(مَرْضى) اسمه المؤخر والجملة خبر أن المخففة والمصدر المؤول من أن وما بعدها سد مسد مفعولي علم والجملة مستأنفة لا محل لها.\r\n\r\n(وَآخَرُونَ) معطوف على مرضى (يَضْرِبُونَ) مضارع مرفوع والواو فاعله والجملة حال و(فِي الْأَرْضِ) متعلقان بالفعل (يَبْتَغُونَ) مضارع وفاعله و(مِنْ فَضْلِ اللَّهِ) متعلقان بالفعل ولفظ الجلالة مضاف إليه والجملة حال.\r\n\r\n(وَآخَرُونَ يُقاتِلُونَ فِي سَبِيلِ اللَّهِ) معطوف على آخرون يضربون في الأرض (فَاقْرَؤُا ما تَيَسَّرَ مِنْهُ) سبق إعراب مثيله.\r\n\r\n(أَقِيمُوا الصَّلاةَ) أمر وفاعله ومفعوله والجملة معطوفة على ما قبلها (وَآتُوا الزَّكاةَ) معطوف على ما قبله (وَأَقْرِضُوا اللَّهَ) معطوف أيضا (قَرْضاً) مفعول مطلق و(حَسَناً) صفة.\r\n\r\nوالواو حرف استئناف (وَما) اسم شرط جازم مفعول به مقدم (تُقَدِّمُوا) ومضارع مجزوم لأنه فعل الشرط والواو فاعله و(لِأَنْفُسِكُمْ) متعلقان بالفعل و(مِنْ خَيْرٍ) حال (تَجِدُوهُ) مضارع مجزوم لأنه جواب الشرط والواو فاعله والهاء مفعول به أول والجملة جواب الشرط لا محل لها (عِنْدَ اللَّهِ) ظرف مكان مضاف إلى لفظ الجلالة و(هُوَ) ضمير فصل و(خَيْراً) مفعول به ثان (وَأَعْظَمَ) معطوف على خيرا و(أَجْراً) تمييز (وَاسْتَغْفِرُوا اللَّهَ) أمر وفاعله ومفعوله والجملة معطوفة على ما قبلها (إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ) إن واسمها وخبراها والجملة الاسمية تعليلية لا محل لها.\r\n\r\n"}]