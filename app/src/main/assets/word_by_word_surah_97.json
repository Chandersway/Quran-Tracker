[{"sura":97,"ayah":1,"words":[{"position":1,"arabic":"إِنَّآ","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"أَنزَلْنَـٰهُ","translation":"revealed it","transliteration":"anzalnāhu"},{"position":3,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":4,"arabic":"لَيْلَةِ","translation":"(the) Night","transliteration":"laylati"},{"position":5,"arabic":"ٱلْقَدْرِ","translation":"(of) Power","transliteration":"l-qadri"}],"e3rab":"(إِنَّا) إن واسمها (أَنْزَلْناهُ) ماض وفاعله ومفعوله والجملة الفعلية خبر إن والجملة الاسمية ابتدائية لا محل لها (فِي لَيْلَةِ) متعلقان بالفعل (الْقَدْرِ) مضاف إليه.\r\n\r\n"},{"sura":97,"ayah":2,"words":[{"position":1,"arabic":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"arabic":"أَدْرَىٰكَ","translation":"can make you know","transliteration":"adrāka"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"لَيْلَةُ","translation":"(the) Night","transliteration":"laylatu"},{"position":5,"arabic":"ٱلْقَدْرِ","translation":"(of) Power (is)","transliteration":"l-qadri"}],"e3rab":"(وَما) الواو حرف استئناف (وَما) اسم استفهام مبتدأ (أَدْراكَ) ماض ومفعوله والفاعل مستتر والجملة خبر ما والجملة الاسمية مستأنفة (ما لَيْلَةُ) مبتدأ وخبره (الْقَدْرِ) مضاف إليه والجملة الاسمية سدت مسد مفعول أدراك الثاني.\r\n\r\n"},{"sura":97,"ayah":3,"words":[{"position":1,"arabic":"لَيْلَةُ","translation":"(The) Night","transliteration":"laylatu"},{"position":2,"arabic":"ٱلْقَدْرِ","translation":"(of) Power","transliteration":"l-qadri"},{"position":3,"arabic":"خَيْرٌۭ","translation":"(is) better","transliteration":"khayrun"},{"position":4,"arabic":"مِّنْ","translation":"than","transliteration":"min"},{"position":5,"arabic":"أَلْفِ","translation":"a thousand","transliteration":"alfi"},{"position":6,"arabic":"شَهْرٍۢ","translation":"month(s)","transliteration":"shahrin"}],"e3rab":"(لَيْلَةُ الْقَدْرِ) مبتدأ مضاف إلى القدر (خَيْرٌ) خبر والجملة مستأنفة لا محل لها (مِنْ أَلْفِ) متعلقان بخير (شَهْرٍ) مضاف إليه.\r\n\r\n"},{"sura":97,"ayah":4,"words":[{"position":1,"arabic":"تَنَزَّلُ","translation":"Descend","transliteration":"tanazzalu"},{"position":2,"arabic":"ٱلْمَلَـٰٓئِكَةُ","translation":"the Angels","transliteration":"l-malāikatu"},{"position":3,"arabic":"وَٱلرُّوحُ","translation":"and the Spirit","transliteration":"wal-rūḥu"},{"position":4,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":5,"arabic":"بِإِذْنِ","translation":"by (the) permission","transliteration":"bi-idh'ni"},{"position":6,"arabic":"رَبِّهِم","translation":"(of) their Lord","transliteration":"rabbihim"},{"position":7,"arabic":"مِّن","translation":"for","transliteration":"min"},{"position":8,"arabic":"كُلِّ","translation":"every","transliteration":"kulli"},{"position":9,"arabic":"أَمْرٍۢ","translation":"affair","transliteration":"amrin"}],"e3rab":"(تَنَزَّلُ الْمَلائِكَةُ) مضارع وفاعله والجملة مستأنفة (وَالرُّوحُ) معطوف على الملائكة (فِيها) متعلقان بالفعل (بِإِذْنِ) متعلقان بالفعل أيضا (رَبِّهِمْ) مضاف إليه (مِنْ كُلِّ) متعلقان بالفعل (أَمْرٍ) مضاف إليه.\r\n\r\n"},{"sura":97,"ayah":5,"words":[{"position":1,"arabic":"سَلَـٰمٌ","translation":"Peace","transliteration":"salāmun"},{"position":2,"arabic":"هِىَ","translation":"it (is)","transliteration":"hiya"},{"position":3,"arabic":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":4,"arabic":"مَطْلَعِ","translation":"(the) emergence","transliteration":"maṭlaʿi"},{"position":5,"arabic":"ٱلْفَجْرِ","translation":"(of) the dawn","transliteration":"l-fajri"}],"e3rab":"(سَلامٌ هِيَ) خبر مقدم ومبتدأ مؤخر والجملة مستأنفة (حَتَّى مَطْلَعِ) متعلقان بسلام (الْفَجْرِ) مضاف إليه.\r\n\r\n"}]