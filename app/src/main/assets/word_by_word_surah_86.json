[{"sura":86,"ayah":1,"words":[{"position":1,"arabic":"وَٱلسَّمَآءِ","translation":"By the sky","transliteration":"wal-samāi"},{"position":2,"arabic":"وَٱلطَّارِقِ","translation":"and the night comer","transliteration":"wal-ṭāriqi"}],"e3rab":"(وَالسَّماءِ) جار ومجرور متعلقان بفعل محذوف تقديره أقسم (وَالطَّارِقِ) معطوف على السماء.\r\n\r\n"},{"sura":86,"ayah":2,"words":[{"position":1,"arabic":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"arabic":"أَدْرَىٰكَ","translation":"can make you know","transliteration":"adrāka"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"ٱلطَّارِقُ","translation":"the night comer (is)","transliteration":"l-ṭāriqu"}],"e3rab":"(وَما) الواو حرف عطف (ما) اسم استفهام مبتدأ (أَدْراكَ) ماض ومفعوله والفاعل مستتر والجملة الفعلية خبر المبتدأ وجملة ما أدراك.. معطوفة على ما قبلها (مَا الطَّارِقُ) مبتدأ وخبره والجملة سدت مسد مفعول أدراك الثاني.\r\n\r\n"},{"sura":86,"ayah":3,"words":[{"position":1,"arabic":"ٱلنَّجْمُ","translation":"(It is) the star","transliteration":"al-najmu"},{"position":2,"arabic":"ٱلثَّاقِبُ","translation":"the piercing","transliteration":"l-thāqibu"}],"e3rab":"(النَّجْمُ) خبر لمبتدأ محذوف تقديره هو (الثَّاقِبُ) صفة والجملة الاسمية حال.\r\n\r\n"},{"sura":86,"ayah":4,"words":[{"position":1,"arabic":"إِن","translation":"Not","transliteration":"in"},{"position":2,"arabic":"كُلُّ","translation":"(is) every","transliteration":"kullu"},{"position":3,"arabic":"نَفْسٍۢ","translation":"soul","transliteration":"nafsin"},{"position":4,"arabic":"لَّمَّا","translation":"but","transliteration":"lammā"},{"position":5,"arabic":"عَلَيْهَا","translation":"over it","transliteration":"ʿalayhā"},{"position":6,"arabic":"حَافِظٌۭ","translation":"(is) a protector","transliteration":"ḥāfiẓun"}],"e3rab":"(إِنْ) حرف نفي (كُلُّ نَفْسٍ) مبتدأ مضاف إلى نفس (لَمَّا) حرف حصر (عَلَيْها حافِظٌ) خبر مقدم ومبتدأ مؤخر والجملة الاسمية خبر كل وجملة إن.. جواب القسم لا محل لها.\r\n\r\n"},{"sura":86,"ayah":5,"words":[{"position":1,"arabic":"فَلْيَنظُرِ","translation":"So let see","transliteration":"falyanẓuri"},{"position":2,"arabic":"ٱلْإِنسَـٰنُ","translation":"man","transliteration":"l-insānu"},{"position":3,"arabic":"مِمَّ","translation":"from what","transliteration":"mimma"},{"position":4,"arabic":"خُلِقَ","translation":"he is created","transliteration":"khuliqa"}],"e3rab":"(فَلْيَنْظُرِ) الفاء حرف استئناف ومضارع مجزوم بلام الأمر (الْإِنْسانُ) فاعل والجملة مستأنفة (مِمَّ) متعلقان بما بعدهما (خُلِقَ) ماض مبني للمجهول ونائب الفاعل مستتر والجملة مفعول به.\r\n\r\n"},{"sura":86,"ayah":6,"words":[{"position":1,"arabic":"خُلِقَ","translation":"He is created","transliteration":"khuliqa"},{"position":2,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":3,"arabic":"مَّآءٍۢ","translation":"a water","transliteration":"māin"},{"position":4,"arabic":"دَافِقٍۢ","translation":"ejected","transliteration":"dāfiqin"}],"e3rab":"(خُلِقَ) ماض مبني للمجهول ونائب الفاعل مستتر (مِنْ ماءٍ) متعلقان بالفعل (دافِقٍ) صفة ماء والجملة مستأنفة.\r\n\r\n"},{"sura":86,"ayah":7,"words":[{"position":1,"arabic":"يَخْرُجُ","translation":"Coming forth","transliteration":"yakhruju"},{"position":2,"arabic":"مِنۢ","translation":"from","transliteration":"min"},{"position":3,"arabic":"بَيْنِ","translation":"between","transliteration":"bayni"},{"position":4,"arabic":"ٱلصُّلْبِ","translation":"the backbone","transliteration":"l-ṣul'bi"},{"position":5,"arabic":"وَٱلتَّرَآئِبِ","translation":"and the ribs","transliteration":"wal-tarāibi"}],"e3rab":"(يَخْرُجُ) مضارع فاعله مستتر والجملة صفة ثانية لماء (مِنْ بَيْنِ) متعلقان بالفعل (الصُّلْبِ) مضاف إليه (وَالتَّرائِبِ) معطوف عليه.\r\n\r\n"},{"sura":86,"ayah":8,"words":[{"position":1,"arabic":"إِنَّهُۥ","translation":"Indeed, He","transliteration":"innahu"},{"position":2,"arabic":"عَلَىٰ","translation":"to","transliteration":"ʿalā"},{"position":3,"arabic":"رَجْعِهِۦ","translation":"return him","transliteration":"rajʿihi"},{"position":4,"arabic":"لَقَادِرٌۭ","translation":"(is) Able","transliteration":"laqādirun"}],"e3rab":"(إِنَّهُ) إن واسمها (عَلى رَجْعِهِ) متعلقان بما بعدهما (لَقادِرٌ) اللام المزحلقة وقادر خبر إن والجملة الاسمية تعليلية لا محل لها.\r\n\r\n"},{"sura":86,"ayah":9,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"تُبْلَى","translation":"will be tested","transliteration":"tub'lā"},{"position":3,"arabic":"ٱلسَّرَآئِرُ","translation":"the secrets","transliteration":"l-sarāiru"}],"e3rab":"(يَوْمَ) ظرف زمان (تُبْلَى) مضارع مبني للمجهول (السَّرائِرُ) نائب فاعل، والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":86,"ayah":10,"words":[{"position":1,"arabic":"فَمَا","translation":"Then not","transliteration":"famā"},{"position":2,"arabic":"لَهُۥ","translation":"(is) for him","transliteration":"lahu"},{"position":3,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":4,"arabic":"قُوَّةٍۢ","translation":"power","transliteration":"quwwatin"},{"position":5,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":6,"arabic":"نَاصِرٍۢ","translation":"any helper","transliteration":"nāṣirin"}],"e3rab":"(فَما) الفاء حرف عطف (ما) نافية (لَهُ) خبر مقدم (مِنْ) حرف جر زائد (قُوَّةٍ) مجرور لفظا مرفوع محلا مبتدأ مؤخر والجملة معطوفة على ما قبلها، (وَلا) الواو حرف عطف (لا) نافية (ناصِرٍ) معطوف على ما قبله.\r\n\r\n"},{"sura":86,"ayah":11,"words":[{"position":1,"arabic":"وَٱلسَّمَآءِ","translation":"By the sky","transliteration":"wal-samāi"},{"position":2,"arabic":"ذَاتِ","translation":"which","transliteration":"dhāti"},{"position":3,"arabic":"ٱلرَّجْعِ","translation":"returns","transliteration":"l-rajʿi"}],"e3rab":"(وَالسَّماءِ) جار ومجرور متعلقان بفعل محذوف تقديره أقسم (ذاتِ) صفة السماء (الرَّجْعِ) مضاف إليه.\r\n\r\n"},{"sura":86,"ayah":12,"words":[{"position":1,"arabic":"وَٱلْأَرْضِ","translation":"And the earth","transliteration":"wal-arḍi"},{"position":2,"arabic":"ذَاتِ","translation":"which","transliteration":"dhāti"},{"position":3,"arabic":"ٱلصَّدْعِ","translation":"cracks open","transliteration":"l-ṣadʿi"}],"e3rab":"الجملة معطوفة على ما قبلها والإعراب واحد.\r\n\r\n"},{"sura":86,"ayah":13,"words":[{"position":1,"arabic":"إِنَّهُۥ","translation":"Indeed, it","transliteration":"innahu"},{"position":2,"arabic":"لَقَوْلٌۭ","translation":"(is) surely a Word","transliteration":"laqawlun"},{"position":3,"arabic":"فَصْلٌۭ","translation":"decisive","transliteration":"faṣlun"}],"e3rab":"(إِنَّهُ) إن واسمها (لَقَوْلٌ) اللام المزحلقة (قول) خبرها (فَصْلٌ) صفة والجملة جواب القسم لا محل لها.\r\n\r\n"},{"sura":86,"ayah":14,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"هُوَ","translation":"it","transliteration":"huwa"},{"position":3,"arabic":"بِٱلْهَزْلِ","translation":"(is) for amusement","transliteration":"bil-hazli"}],"e3rab":"(وَما) الواو حرف عطف (ما) نافية حجازية تعمل عمل ليس (هُوَ) اسمها (بِالْهَزْلِ) الباء حرف جر زائد (الهزل) مجرور لفظا منصوب محلا خبر ما والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":86,"ayah":15,"words":[{"position":1,"arabic":"إِنَّهُمْ","translation":"Indeed, they","transliteration":"innahum"},{"position":2,"arabic":"يَكِيدُونَ","translation":"are plotting","transliteration":"yakīdūna"},{"position":3,"arabic":"كَيْدًۭا","translation":"a plot","transliteration":"kaydan"}],"e3rab":"(إِنَّهُمْ) إن واسمها (يَكِيدُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر إن (كَيْداً) مفعول مطلق والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"},{"sura":86,"ayah":16,"words":[{"position":1,"arabic":"وَأَكِيدُ","translation":"But I am planning","transliteration":"wa-akīdu"},{"position":2,"arabic":"كَيْدًۭا","translation":"a plan","transliteration":"kaydan"}],"e3rab":"(وَأَكِيدُ) مضارع فاعله مستتر (كَيْداً) مفعول مطلق والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":86,"ayah":17,"words":[{"position":1,"arabic":"فَمَهِّلِ","translation":"So give respite","transliteration":"famahhili"},{"position":2,"arabic":"ٱلْكَـٰفِرِينَ","translation":"(to) the disbelievers","transliteration":"l-kāfirīna"},{"position":3,"arabic":"أَمْهِلْهُمْ","translation":"Give respite to them ","transliteration":"amhil'hum"},{"position":4,"arabic":"رُوَيْدًۢا","translation":"little","transliteration":"ruwaydan"}],"e3rab":"(فَمَهِّلِ) الفاء الفصيحة وأمر فاعله مستتر (الْكافِرِينَ) مفعول به والجملة جواب شرط لا محل لها (أَمْهِلْهُمْ) أمر ومفعوله والفاعل مستتر (رُوَيْداً) صفة مفعول مطلق محذوف والجملة توكيد لما قبلها.\r\n\r\n"}]