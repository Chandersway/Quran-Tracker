[{"sura":93,"ayah":1,"words":[{"position":1,"arabic":"وَٱلضُّحَىٰ","translation":"By the morning brightness","transliteration":"wal-ḍuḥā"}],"e3rab":"«وَالضُّحى » جار ومجرور متعلقان بفعل قسم محذوف\r\n\r\n"},{"sura":93,"ayah":2,"words":[{"position":1,"arabic":"وَٱلَّيْلِ","translation":"And the night","transliteration":"wa-al-layli"},{"position":2,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"arabic":"سَجَىٰ","translation":"it covers with darkness","transliteration":"sajā"}],"e3rab":"(وَاللَّيْلِ) معطوف على الضحى (إِذا) ظرف زمان (سَجى) ماض فاعله مستتر والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":93,"ayah":3,"words":[{"position":1,"arabic":"مَا","translation":"Not","transliteration":"mā"},{"position":2,"arabic":"وَدَّعَكَ","translation":"has forsaken you","transliteration":"waddaʿaka"},{"position":3,"arabic":"رَبُّكَ","translation":"your Lord","transliteration":"rabbuka"},{"position":4,"arabic":"وَمَا","translation":"and not","transliteration":"wamā"},{"position":5,"arabic":"قَلَىٰ","translation":"He is displeased","transliteration":"qalā"}],"e3rab":"(ما) نافية (وَدَّعَكَ) ماض ومفعوله (رَبُّكَ) فاعل والجملة جواب القسم لا محل لها (وَما قَلى) معطوفة على ما قبلها.\r\n\r\n"},{"sura":93,"ayah":4,"words":[{"position":1,"arabic":"وَلَلْـَٔاخِرَةُ","translation":"And surely the Hereafter","transliteration":"walalākhiratu"},{"position":2,"arabic":"خَيْرٌۭ","translation":"(is) better","transliteration":"khayrun"},{"position":3,"arabic":"لَّكَ","translation":"for you","transliteration":"laka"},{"position":4,"arabic":"مِنَ","translation":"than","transliteration":"mina"},{"position":5,"arabic":"ٱلْأُولَىٰ","translation":"the first","transliteration":"l-ūlā"}],"e3rab":"(وَلَلْآخِرَةُ خَيْرٌ) الواو حرف عطف واللام لام الابتداء والآخرة خير مبتدأ وخبره والجملة معطوفة على ما قبلها (لَكَ) متعلقان بخير (مِنَ الْأُولى) متعلقان بخير.\r\n\r\n"},{"sura":93,"ayah":5,"words":[{"position":1,"arabic":"وَلَسَوْفَ","translation":"And soon","transliteration":"walasawfa"},{"position":2,"arabic":"يُعْطِيكَ","translation":"will give you","transliteration":"yuʿ'ṭīka"},{"position":3,"arabic":"رَبُّكَ","translation":"your Lord","transliteration":"rabbuka"},{"position":4,"arabic":"فَتَرْضَىٰٓ","translation":"then you will be satisfied","transliteration":"fatarḍā"}],"e3rab":"(وَلَسَوْفَ) اللام لام الابتداء وسوف حرف استقبال (يُعْطِيكَ) مضارع ومفعوله (رَبُّكَ) فاعل والجملة معطوفة على ما قبلها (فَتَرْضى) الفاء حرف عطف ومضارع فاعله مستتر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":93,"ayah":6,"words":[{"position":1,"arabic":"أَلَمْ","translation":"Did not","transliteration":"alam"},{"position":2,"arabic":"يَجِدْكَ","translation":"He find you","transliteration":"yajid'ka"},{"position":3,"arabic":"يَتِيمًۭا","translation":"an orphan","transliteration":"yatīman"},{"position":4,"arabic":"فَـَٔاوَىٰ","translation":"and give shelter","transliteration":"faāwā"}],"e3rab":"(أَلَمْ يَجِدْكَ) الهمزة حرف استفهام وتقرير ومضارع مجزوم بلم والكاف مفعول به أول والفاعل مستتر (يَتِيماً) مفعول به ثان والجملة مستأنفة (فَآوى) ماض فاعله مستتر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":93,"ayah":7,"words":[{"position":1,"arabic":"وَوَجَدَكَ","translation":"And He found you","transliteration":"wawajadaka"},{"position":2,"arabic":"ضَآلًّۭا","translation":"lost","transliteration":"ḍāllan"},{"position":3,"arabic":"فَهَدَىٰ","translation":"so He guided","transliteration":"fahadā"}],"e3rab":"(وَوَجَدَكَ) ماض ومفعوله الأول والفاعل مستتر (ضَالًّا) مفعول به ثان والجملة معطوفة على ما قبلها (فَهَدى) معطوفة على ما قبلها.\r\n\r\n"},{"sura":93,"ayah":8,"words":[{"position":1,"arabic":"وَوَجَدَكَ","translation":"And He found you","transliteration":"wawajadaka"},{"position":2,"arabic":"عَآئِلًۭا","translation":"in need","transliteration":"ʿāilan"},{"position":3,"arabic":"فَأَغْنَىٰ","translation":"so He made self-sufficient","transliteration":"fa-aghnā"}],"e3rab":"معطوفة على ما قبلها.\r\n\r\n"},{"sura":93,"ayah":9,"words":[{"position":1,"arabic":"فَأَمَّا","translation":"So as for","transliteration":"fa-ammā"},{"position":2,"arabic":"ٱلْيَتِيمَ","translation":"the orphan","transliteration":"l-yatīma"},{"position":3,"arabic":"فَلَا","translation":"then (do) not","transliteration":"falā"},{"position":4,"arabic":"تَقْهَرْ","translation":"oppress","transliteration":"taqhar"}],"e3rab":"(فَأَمَّا) الفاء الفصيحة (أما) حرف شرط وتفصيل (الْيَتِيمَ) مفعول به مقدم (فَلا تَقْهَرْ) الفاء رابطة ومضارع مجزوم بلا الناهية والفاعل مستتر والجملة الفعلية جواب الشرط لا محل لها.\r\n\r\n"},{"sura":93,"ayah":10,"words":[{"position":1,"arabic":"وَأَمَّا","translation":"And as for","transliteration":"wa-ammā"},{"position":2,"arabic":"ٱلسَّآئِلَ","translation":"one who asks","transliteration":"l-sāila"},{"position":3,"arabic":"فَلَا","translation":"then (do) not","transliteration":"falā"},{"position":4,"arabic":"تَنْهَرْ","translation":"repel","transliteration":"tanhar"}],"e3rab":"معطوفة على ما قبلها والإعراب واضح.\r\n\r\n"},{"sura":93,"ayah":11,"words":[{"position":1,"arabic":"وَأَمَّا","translation":"But as for","transliteration":"wa-ammā"},{"position":2,"arabic":"بِنِعْمَةِ","translation":"(the) Favor","transliteration":"biniʿ'mati"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"فَحَدِّثْ","translation":"narrate","transliteration":"faḥaddith"}],"e3rab":"(وَأَمَّا) الواو حرف عطف (أَمَّا) حرف شرط وتفصيل (بِنِعْمَةِ) متعلقان بحدث (رَبِّكَ) مضاف إليه (فَحَدِّثْ) الفاء زائدة وأمر فاعله مستتر.\r\n\r\n"}]