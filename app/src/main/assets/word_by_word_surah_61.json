[{"sura":61,"ayah":1,"words":[{"position":1,"arabic":"سَبَّحَ","translation":"Glorifies","transliteration":"sabbaḥa"},{"position":2,"arabic":"لِلَّهِ","translation":"Allah","transliteration":"lillahi"},{"position":3,"arabic":"مَا","translation":"whatever","transliteration":"mā"},{"position":4,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":5,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":6,"arabic":"وَمَا","translation":"and whatever","transliteration":"wamā"},{"position":7,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":8,"arabic":"ٱلْأَرْضِ ۖ","translation":"the earth","transliteration":"l-arḍi"},{"position":9,"arabic":"وَهُوَ","translation":"And He","transliteration":"wahuwa"},{"position":10,"arabic":"ٱلْعَزِيزُ","translation":"(is) the All-Mighty","transliteration":"l-ʿazīzu"},{"position":11,"arabic":"ٱلْحَكِيمُ","translation":"the All-Wise","transliteration":"l-ḥakīmu"}],"e3rab":"(سَبَّحَ) ماض (لِلَّهِ) متعلقان بالفعل (ما) اسم موصول فاعل (فِي السَّماواتِ) متعلقان بمحذوف صلة الموصول والجملة ابتدائية لا محل لها و(ما فِي الْأَرْضِ) معطوف على ما في السموات (وَ) الواو حالية (هُوَ الْعَزِيزُ الْحَكِيمُ) مبتدأ وخبران والجملة حال.\r\n\r\n"},{"sura":61,"ayah":2,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"(you) who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"لِمَ","translation":"Why","transliteration":"lima"},{"position":5,"arabic":"تَقُولُونَ","translation":"(do) you say","transliteration":"taqūlūna"},{"position":6,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":7,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":8,"arabic":"تَفْعَلُونَ","translation":"you do","transliteration":"tafʿalūna"}],"e3rab":"(يا أَيُّهَا) أي منادى نكرة مقصودة مبنية على الضم في محل نصب (الَّذِينَ) بدل من أيها (آمَنُوا) ماض وفاعله والجملة صلة (لِمَ) ما اسم استفهام في محل جر باللام والجار والمجرور متعلقان بما بعدهما (تَقُولُونَ) مضارع وفاعله (ما) مفعول به والجملة ابتدائية لا محل لها (لا تَفْعَلُونَ) نافية ومضارع مرفوع والواو فاعله والجملة صلة.\r\n\r\n"},{"sura":61,"ayah":3,"words":[{"position":1,"arabic":"كَبُرَ","translation":"Great is","transliteration":"kabura"},{"position":2,"arabic":"مَقْتًا","translation":"hatred","transliteration":"maqtan"},{"position":3,"arabic":"عِندَ","translation":"with","transliteration":"ʿinda"},{"position":4,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":5,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":6,"arabic":"تَقُولُوا۟","translation":"you say","transliteration":"taqūlū"},{"position":7,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":8,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":9,"arabic":"تَفْعَلُونَ","translation":"you do","transliteration":"tafʿalūna"}],"e3rab":"(كَبُرَ) ماض (مَقْتاً) تمييز (عِنْدَ اللَّهِ) ظرف مكان مضاف إلى لفظ الجلالة (أَنْ تَقُولُوا) مضارع منصوب بأن والواو فاعله والمصدر المؤول من أن والفعل في محل رفع مبتدأ مؤخر وجملة كبر.. خبره المقدم (ما) مفعول به (لا تَفْعَلُونَ) نافية ومضارع مرفوع والواو فاعله والجملة صلة.\r\n\r\n"},{"sura":61,"ayah":4,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":3,"arabic":"يُحِبُّ","translation":"loves","transliteration":"yuḥibbu"},{"position":4,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":5,"arabic":"يُقَـٰتِلُونَ","translation":"fight","transliteration":"yuqātilūna"},{"position":6,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":7,"arabic":"سَبِيلِهِۦ","translation":"His Way","transliteration":"sabīlihi"},{"position":8,"arabic":"صَفًّۭا","translation":"(in) a row","transliteration":"ṣaffan"},{"position":9,"arabic":"كَأَنَّهُم","translation":"as if they","transliteration":"ka-annahum"},{"position":10,"arabic":"بُنْيَـٰنٌۭ","translation":"(were) a structure","transliteration":"bun'yānun"},{"position":11,"arabic":"مَّرْصُوصٌۭ","translation":"joined firmly","transliteration":"marṣūṣun"}],"e3rab":"(إِنَّ اللَّهَ) إن واسمها (يُحِبُّ) مضارع مرفوع فاعله مستتر (الَّذِينَ) اسم الموصول مفعوله والجملة خبر إن والجملة الاسمية استئنافية لا محل لها (يُقاتِلُونَ) مضارع وفاعله والجملة صلة (فِي سَبِيلِهِ) متعلقان بالفعل (صَفًّا) حال (كَأَنَّهُمْ بُنْيانٌ) كأن واسمها وخبرها (مَرْصُوصٌ) صفة والجملة حال.\r\n\r\n"},{"sura":61,"ayah":5,"words":[{"position":1,"arabic":"وَإِذْ","translation":"And when","transliteration":"wa-idh"},{"position":2,"arabic":"قَالَ","translation":"said","transliteration":"qāla"},{"position":3,"arabic":"مُوسَىٰ","translation":"Musa","transliteration":"mūsā"},{"position":4,"arabic":"لِقَوْمِهِۦ","translation":"to his people","transliteration":"liqawmihi"},{"position":5,"arabic":"يَـٰقَوْمِ","translation":"O my people","transliteration":"yāqawmi"},{"position":6,"arabic":"لِمَ","translation":"Why","transliteration":"lima"},{"position":7,"arabic":"تُؤْذُونَنِى","translation":"do you hurt me","transliteration":"tu'dhūnanī"},{"position":8,"arabic":"وَقَد","translation":"while certainly","transliteration":"waqad"},{"position":9,"arabic":"تَّعْلَمُونَ","translation":"you know","transliteration":"taʿlamūna"},{"position":10,"arabic":"أَنِّى","translation":"that I am","transliteration":"annī"},{"position":11,"arabic":"رَسُولُ","translation":"(the) Messenger","transliteration":"rasūlu"},{"position":12,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":13,"arabic":"إِلَيْكُمْ ۖ","translation":"to you","transliteration":"ilaykum"},{"position":14,"arabic":"فَلَمَّا","translation":"Then when","transliteration":"falammā"},{"position":15,"arabic":"زَاغُوٓا۟","translation":"they deviated","transliteration":"zāghū"},{"position":16,"arabic":"أَزَاغَ","translation":"(was caused to) deviate","transliteration":"azāgha"},{"position":17,"arabic":"ٱللَّهُ","translation":"(by) Allah","transliteration":"l-lahu"},{"position":18,"arabic":"قُلُوبَهُمْ ۚ","translation":"their hearts","transliteration":"qulūbahum"},{"position":19,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":20,"arabic":"لَا","translation":"(does) not","transliteration":"lā"},{"position":21,"arabic":"يَهْدِى","translation":"guide","transliteration":"yahdī"},{"position":22,"arabic":"ٱلْقَوْمَ","translation":"the people","transliteration":"l-qawma"},{"position":23,"arabic":"ٱلْفَـٰسِقِينَ","translation":"the defiantly disobedient","transliteration":"l-fāsiqīna"}],"e3rab":"(وَإِذْ قالَ) الواو استئنافية وإذ ظرف زمان وماض (مُوسى) فاعله (لِقَوْمِهِ) متعلقان بالفعل والجملة في محل جر بالإضافة (يا قَوْمِ) منادى منصوب بالفتحة المقدرة على ما قبل ياء المتكلم المحذوفة للتخفيف (لِمَ) جار ومجرور متعلقان بما بعدهما والجملة مقول القول (تُؤْذُونَنِي) مضارع مرفوع بثبوت النون والواو فاعله والنون للوقاية والياء مفعول به والجملة مقول القول (وَ) الواو حالية (قَدْ تَعْلَمُونَ) حرف تحقيق ومضارع مرفوع والواو فاعله والجملة حال (أَنِّي) أن واسمها (رَسُولُ اللَّهِ) خبرها المضاف إلى لفظ الجلالة (إِلَيْكُمْ) متعلقان برسول والمصدر المؤول من أن وما بعدها سد مسد مفعولي تعلمون. والفاء حرف استئناف (لما) ظرفية حينية (زاغُوا) ماض وفاعله والجملة في محل جر بالإضافة (أَزاغَ اللَّهُ قُلُوبَهُمْ) ماض ولفظ الجلالة فاعله (قُلُوبَهُمْ) مفعوله وجملة فلما.. استئنافية لا محل لها والواو حرف استئناف (اللَّهِ) لفظ الجلالة مبتدأ (لا يَهْدِي) نافية ومضارع فاعله مستتر والجملة الفعلية خبر المبتدأ (الْقَوْمَ) مفعول به (الْفاسِقِينَ) صفة والجملة الاسمية استئنافية لا محل لها.\r\n\r\n"},{"sura":61,"ayah":6,"words":[{"position":1,"arabic":"وَإِذْ","translation":"And when","transliteration":"wa-idh"},{"position":2,"arabic":"قَالَ","translation":"said","transliteration":"qāla"},{"position":3,"arabic":"عِيسَى","translation":"Isa","transliteration":"ʿīsā"},{"position":4,"arabic":"ٱبْنُ","translation":"son","transliteration":"ub'nu"},{"position":5,"arabic":"مَرْيَمَ","translation":"(of) Maryam","transliteration":"maryama"},{"position":6,"arabic":"يَـٰبَنِىٓ","translation":"O Children","transliteration":"yābanī"},{"position":7,"arabic":"إِسْرَٰٓءِيلَ","translation":"(of) Israel","transliteration":"is'rāīla"},{"position":8,"arabic":"إِنِّى","translation":"Indeed, I am","transliteration":"innī"},{"position":9,"arabic":"رَسُولُ","translation":"(the) Messenger","transliteration":"rasūlu"},{"position":10,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":11,"arabic":"إِلَيْكُم","translation":"to you","transliteration":"ilaykum"},{"position":12,"arabic":"مُّصَدِّقًۭا","translation":"confirming","transliteration":"muṣaddiqan"},{"position":13,"arabic":"لِّمَا","translation":"that which","transliteration":"limā"},{"position":14,"arabic":"بَيْنَ","translation":"(was) between","transliteration":"bayna"},{"position":15,"arabic":"يَدَىَّ","translation":"my hands","transliteration":"yadayya"},{"position":16,"arabic":"مِنَ","translation":"of","transliteration":"mina"},{"position":17,"arabic":"ٱلتَّوْرَىٰةِ","translation":"the Taurat","transliteration":"l-tawrāti"},{"position":18,"arabic":"وَمُبَشِّرًۢا","translation":"and bringing glad tidings","transliteration":"wamubashiran"},{"position":19,"arabic":"بِرَسُولٍۢ","translation":"(of) a Messenger","transliteration":"birasūlin"},{"position":20,"arabic":"يَأْتِى","translation":"to come","transliteration":"yatī"},{"position":21,"arabic":"مِنۢ","translation":"from","transliteration":"min"},{"position":22,"arabic":"بَعْدِى","translation":"after me","transliteration":"baʿdī"},{"position":23,"arabic":"ٱسْمُهُۥٓ","translation":"whose name (will be)","transliteration":"us'muhu"},{"position":24,"arabic":"أَحْمَدُ ۖ","translation":"Ahmad","transliteration":"aḥmadu"},{"position":25,"arabic":"فَلَمَّا","translation":"But when","transliteration":"falammā"},{"position":26,"arabic":"جَآءَهُم","translation":"he came to them","transliteration":"jāahum"},{"position":27,"arabic":"بِٱلْبَيِّنَـٰتِ","translation":"with clear proofs","transliteration":"bil-bayināti"},{"position":28,"arabic":"قَالُوا۟","translation":"they said","transliteration":"qālū"},{"position":29,"arabic":"هَـٰذَا","translation":"This","transliteration":"hādhā"},{"position":30,"arabic":"سِحْرٌۭ","translation":"(is) a magic","transliteration":"siḥ'run"},{"position":31,"arabic":"مُّبِينٌۭ","translation":"clear","transliteration":"mubīnun"}],"e3rab":"(وَإِذْ قالَ عِيسَى) سبق إعراب مثيلها (ابْنُ) بدل من عيسى و(مَرْيَمَ) مضاف إليه (يا بَنِي إِسْرائِيلَ) منادى مضاف إلى إسرائيل منصوب بالياء وجملة النداء مقول القول (إِنِّي رَسُولُ اللَّهِ) إن واسمها وخبرها المضاف إلى لفظ الجلالة (إِلَيْكُمْ) متعلقان برسول والجملة الاسمية مقول القول (مُصَدِّقاً) حال (لِما) متعلقان بمصدقا (بَيْنَ) ظرف مكان مضاف إلى (يَدَيَّ) (مِنَ التَّوْراةِ) متعلقان بمحذوف حال (وَمُبَشِّراً) معطوف على مصدقا (بِرَسُولٍ) متعلقان بمبشرا (يَأْتِي) مضارع فاعله مستتر والجملة صفة رسول (مِنْ بَعْدِي) متعلقان بالفعل (اسْمُهُ أَحْمَدُ) مبتدأ وخبره والجملة صفة ثانية لرسول (فَلَمَّا) الفاء حرف استئناف (لِما) ظرفية حينية (جاءَهُمْ) ماض ومفعوله والفاعل مستتر والجملة في محل جر بالإضافة (بِالْبَيِّناتِ) متعلقان بالفعل (قالُوا) ماض وفاعله (هذا سِحْرٌ) مبتدأ وخبره (مُبِينٌ) صفة والجملة الاسمية مقول القول وجملة قالوا.. جواب لما لا محل لها.\r\n\r\n"},{"sura":61,"ayah":7,"words":[{"position":1,"arabic":"وَمَنْ","translation":"And who","transliteration":"waman"},{"position":2,"arabic":"أَظْلَمُ","translation":"(is) more wrong","transliteration":"aẓlamu"},{"position":3,"arabic":"مِمَّنِ","translation":"than (one) who","transliteration":"mimmani"},{"position":4,"arabic":"ٱفْتَرَىٰ","translation":"invents","transliteration":"if'tarā"},{"position":5,"arabic":"عَلَى","translation":"upon","transliteration":"ʿalā"},{"position":6,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":7,"arabic":"ٱلْكَذِبَ","translation":"the lie","transliteration":"l-kadhiba"},{"position":8,"arabic":"وَهُوَ","translation":"while he","transliteration":"wahuwa"},{"position":9,"arabic":"يُدْعَىٰٓ","translation":"is invited","transliteration":"yud'ʿā"},{"position":10,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":11,"arabic":"ٱلْإِسْلَـٰمِ ۚ","translation":"Islam","transliteration":"l-is'lāmi"},{"position":12,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":13,"arabic":"لَا","translation":"(does) not","transliteration":"lā"},{"position":14,"arabic":"يَهْدِى","translation":"guide","transliteration":"yahdī"},{"position":15,"arabic":"ٱلْقَوْمَ","translation":"the people","transliteration":"l-qawma"},{"position":16,"arabic":"ٱلظَّـٰلِمِينَ","translation":"[the] wrongdoers","transliteration":"l-ẓālimīna"}],"e3rab":"(وَ) الواو حرف استئناف (مَنْ أَظْلَمُ) مبتدأ وخبره والجملة استئنافية لا محل لها (مِمَّنِ) متعلقان بأظلم (افْتَرى) ماض فاعله مستتر والجملة صلة (عَلَى اللَّهِ) متعلقان بالفعل (الْكَذِبَ) مفعول به (وَهُوَ) مبتدأ (يُدْعى) مضارع مبني للمجهول ونائب الفاعل مستتر (إِلَى الْإِسْلامِ) متعلقان بالفعل والجملة الفعلية خبر هو والجملة الاسمية حال.\r\n\r\n(وَاللَّهُ لا يَهْدِي الْقَوْمَ الظَّالِمِينَ) سبق إعراب مثيلها.\r\n\r\n"},{"sura":61,"ayah":8,"words":[{"position":1,"arabic":"يُرِيدُونَ","translation":"They intend","transliteration":"yurīdūna"},{"position":2,"arabic":"لِيُطْفِـُٔوا۟","translation":"to put out","transliteration":"liyuṭ'fiū"},{"position":3,"arabic":"نُورَ","translation":"(the) light","transliteration":"nūra"},{"position":4,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":5,"arabic":"بِأَفْوَٰهِهِمْ","translation":"with their mouths","transliteration":"bi-afwāhihim"},{"position":6,"arabic":"وَٱللَّهُ","translation":"but Allah","transliteration":"wal-lahu"},{"position":7,"arabic":"مُتِمُّ","translation":"will perfect","transliteration":"mutimmu"},{"position":8,"arabic":"نُورِهِۦ","translation":"His Light","transliteration":"nūrihi"},{"position":9,"arabic":"وَلَوْ","translation":"although","transliteration":"walaw"},{"position":10,"arabic":"كَرِهَ","translation":"dislike","transliteration":"kariha"},{"position":11,"arabic":"ٱلْكَـٰفِرُونَ","translation":"the disbelievers","transliteration":"l-kāfirūna"}],"e3rab":"(يُرِيدُونَ) مضارع مرفوع بثبوت النون والواو فاعله والجملة استئنافية لا محل لها (لِيُطْفِؤُا) مضارع منصوب بأن مضمرة بعد لام التعليل والواو فاعله (نُورَ اللَّهِ) مفعوله مضاف إلى لفظ الجلالة والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بالفعل (بِأَفْواهِهِمْ) متعلقان بالفعل (وَ) الواو حالية (اللَّهُ مُتِمُّ) مبتدأ وخبره (نُورِهِ) مضاف إليه والجملة حال (وَ) الواو حرف عطف (لَوْ كَرِهَ الْكافِرُونَ) لو وصلية وماض وفاعله والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":61,"ayah":9,"words":[{"position":1,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":2,"arabic":"ٱلَّذِىٓ","translation":"(is) the One Who","transliteration":"alladhī"},{"position":3,"arabic":"أَرْسَلَ","translation":"sent","transliteration":"arsala"},{"position":4,"arabic":"رَسُولَهُۥ","translation":"His Messenger","transliteration":"rasūlahu"},{"position":5,"arabic":"بِٱلْهُدَىٰ","translation":"with guidance","transliteration":"bil-hudā"},{"position":6,"arabic":"وَدِينِ","translation":"and (the) religion","transliteration":"wadīni"},{"position":7,"arabic":"ٱلْحَقِّ","translation":"(of) the truth","transliteration":"l-ḥaqi"},{"position":8,"arabic":"لِيُظْهِرَهُۥ","translation":"to make it prevail","transliteration":"liyuẓ'hirahu"},{"position":9,"arabic":"عَلَى","translation":"over","transliteration":"ʿalā"},{"position":10,"arabic":"ٱلدِّينِ","translation":"the religion","transliteration":"l-dīni"},{"position":11,"arabic":"كُلِّهِۦ","translation":"all of them","transliteration":"kullihi"},{"position":12,"arabic":"وَلَوْ","translation":"although","transliteration":"walaw"},{"position":13,"arabic":"كَرِهَ","translation":"dislike (it)","transliteration":"kariha"},{"position":14,"arabic":"ٱلْمُشْرِكُونَ","translation":"the polytheists","transliteration":"l-mush'rikūna"}],"e3rab":"(هُوَ الَّذِي) مبتدأ وخبره والجملة استئنافية لا محل لها (أَرْسَلَ) ماض فاعله مستتر (رَسُولَهُ) مفعول به والجملة صلة لا محل لها (بِالْهُدى) متعلقان بالفعل (وَدِينِ) معطوف على الهدى (الْحَقِّ) مضاف إليه (لِيُظْهِرَهُ) مضارع منصوب بأن مضمرة بعد لام التعليل والهاء مفعوله والفاعل مستتر والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بأرسل (عَلَى الدِّينِ) متعلقان بالفعل (كُلِّهِ) توكيد (وَ) الواو حالية (لَوْ كَرِهَ الْمُشْرِكُونَ) لو وصلية وماض وفاعله والجملة حال.\r\n\r\n"},{"sura":61,"ayah":10,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"(you) who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"هَلْ","translation":"Shall","transliteration":"hal"},{"position":5,"arabic":"أَدُلُّكُمْ","translation":"I guide you","transliteration":"adullukum"},{"position":6,"arabic":"عَلَىٰ","translation":"to","transliteration":"ʿalā"},{"position":7,"arabic":"تِجَـٰرَةٍۢ","translation":"a transaction","transliteration":"tijāratin"},{"position":8,"arabic":"تُنجِيكُم","translation":"(that) will save you","transliteration":"tunjīkum"},{"position":9,"arabic":"مِّنْ","translation":"from","transliteration":"min"},{"position":10,"arabic":"عَذَابٍ","translation":"a punishment","transliteration":"ʿadhābin"},{"position":11,"arabic":"أَلِيمٍۢ","translation":"painful","transliteration":"alīmin"}],"e3rab":"(يا أَيُّهَا الَّذِينَ آمَنُوا) سبق إعرابها و(هَلْ أَدُلُّكُمْ) هل حرف استفهام ومضارع ومفعوله والفاعل مستتر والجملة الفعلية ابتدائية لا محل لها (عَلى تِجارَةٍ) متعلقان بالفعل (تُنْجِيكُمْ) مضارع ومفعوله والفاعل مستتر والجملة صفة تجارة (مِنْ عَذابٍ) متعلقان بالفعل (أَلِيمٍ) صفة عذاب.\r\n\r\n"},{"sura":61,"ayah":11,"words":[{"position":1,"arabic":"تُؤْمِنُونَ","translation":"Believe","transliteration":"tu'minūna"},{"position":2,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":3,"arabic":"وَرَسُولِهِۦ","translation":"and His Messenger","transliteration":"warasūlihi"},{"position":4,"arabic":"وَتُجَـٰهِدُونَ","translation":"and strive","transliteration":"watujāhidūna"},{"position":5,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":6,"arabic":"سَبِيلِ","translation":"(the) way","transliteration":"sabīli"},{"position":7,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":8,"arabic":"بِأَمْوَٰلِكُمْ","translation":"with your wealth","transliteration":"bi-amwālikum"},{"position":9,"arabic":"وَأَنفُسِكُمْ ۚ","translation":"and your lives","transliteration":"wa-anfusikum"},{"position":10,"arabic":"ذَٰلِكُمْ","translation":"That","transliteration":"dhālikum"},{"position":11,"arabic":"خَيْرٌۭ","translation":"(is) better","transliteration":"khayrun"},{"position":12,"arabic":"لَّكُمْ","translation":"for you","transliteration":"lakum"},{"position":13,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":14,"arabic":"كُنتُمْ","translation":"you","transliteration":"kuntum"},{"position":15,"arabic":"تَعْلَمُونَ","translation":"know","transliteration":"taʿlamūna"}],"e3rab":"(تُؤْمِنُونَ) مضارع وفاعله (بِاللَّهِ) متعلقان بالفعل (وَرَسُولِهِ) معطوف على لفظ الجلالة والجملة استئنافية لا محل لها (وَتُجاهِدُونَ) معطوف على تؤمنون (فِي سَبِيلِ اللَّهِ) متعلقان بالفعل ولفظ الجلالة مضاف إليه (بِأَمْوالِكُمْ) متعلقان بالفعل أيضا (وَأَنْفُسِكُمْ) معطوف على أموالكم (ذلِكُمْ خَيْرٌ) مبتدأ وخبره والجملة استئنافية لا محل لها (لَكُمْ) متعلقان بخير (إِنْ كُنْتُمْ) إن شرطية جازمة وماض ناقص في محل جزم والتاء اسمه (تَعْلَمُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر كنتم وجواب الشرط محذوف.\r\n\r\n"},{"sura":61,"ayah":12,"words":[{"position":1,"arabic":"يَغْفِرْ","translation":"He will forgive","transliteration":"yaghfir"},{"position":2,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":3,"arabic":"ذُنُوبَكُمْ","translation":"your sins","transliteration":"dhunūbakum"},{"position":4,"arabic":"وَيُدْخِلْكُمْ","translation":"and admit you","transliteration":"wayud'khil'kum"},{"position":5,"arabic":"جَنَّـٰتٍۢ","translation":"(in) Gardens","transliteration":"jannātin"},{"position":6,"arabic":"تَجْرِى","translation":"flow","transliteration":"tajrī"},{"position":7,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":8,"arabic":"تَحْتِهَا","translation":"underneath it","transliteration":"taḥtihā"},{"position":9,"arabic":"ٱلْأَنْهَـٰرُ","translation":"the rivers","transliteration":"l-anhāru"},{"position":10,"arabic":"وَمَسَـٰكِنَ","translation":"and dwellings","transliteration":"wamasākina"},{"position":11,"arabic":"طَيِّبَةًۭ","translation":"pleasant","transliteration":"ṭayyibatan"},{"position":12,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":13,"arabic":"جَنَّـٰتِ","translation":"Gardens","transliteration":"jannāti"},{"position":14,"arabic":"عَدْنٍۢ ۚ","translation":"(of) Eternity","transliteration":"ʿadnin"},{"position":15,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":16,"arabic":"ٱلْفَوْزُ","translation":"(is) the success","transliteration":"l-fawzu"},{"position":17,"arabic":"ٱلْعَظِيمُ","translation":"the great","transliteration":"l-ʿaẓīmu"}],"e3rab":"(يَغْفِرْ) مضارع مجزوم لوقوعه جوابا للأمر المفهوم من قوله تؤمنون باللّه والفاعل مستتر (لَكُمْ) متعلقان بالفعل (ذُنُوبَكُمْ) مفعول به والجملة لا محل لها (وَيُدْخِلْكُمْ) معطوف على يغفر لكم (جَنَّاتٍ) مفعول به ثان ومضارع (مِنْ تَحْتِهَا) متعلقان بالفعل (الْأَنْهارُ) فاعل والجملة صفة جنات (وَمَساكِنَ) معطوف على جنات (طَيِّبَةً) صفة مساكن (فِي جَنَّاتِ) متعلقان بمحذوف حال (عَدْنٍ) مضاف إليه (ذلِكَ الْفَوْزُ) مبتدأ وخبره (الْعَظِيمُ) صفة والجملة الاسمية استئنافية لا محل لها.\r\n\r\n"},{"sura":61,"ayah":13,"words":[{"position":1,"arabic":"وَأُخْرَىٰ","translation":"And another","transliteration":"wa-ukh'rā"},{"position":2,"arabic":"تُحِبُّونَهَا ۖ","translation":"that you love ","transliteration":"tuḥibbūnahā"},{"position":3,"arabic":"نَصْرٌۭ","translation":"a help","transliteration":"naṣrun"},{"position":4,"arabic":"مِّنَ","translation":"from","transliteration":"mina"},{"position":5,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":6,"arabic":"وَفَتْحٌۭ","translation":"and a victory","transliteration":"wafatḥun"},{"position":7,"arabic":"قَرِيبٌۭ ۗ","translation":"near","transliteration":"qarībun"},{"position":8,"arabic":"وَبَشِّرِ","translation":"and give glad tidings","transliteration":"wabashiri"},{"position":9,"arabic":"ٱلْمُؤْمِنِينَ","translation":"(to) the believers","transliteration":"l-mu'minīna"}],"e3rab":"(وَأُخْرى) مبتدأ مؤخر والخبر مقدم محذوف (تُحِبُّونَها) مضارع وفاعله ومفعوله والجملة صفة أخرى (نَصْرٌ) خبر لمبتدأ محذوف والجملة مفسرة لا محل لها (مِنَ اللَّهِ) متعلقان بنصر (وَفَتْحٌ) معطوف على نصر (قَرِيبٌ) صفة فتح (وَبَشِّرِ الْمُؤْمِنِينَ) الواو حرف عطف وأمر فاعله مستتر والجملة معطوفة على ما قبلها (الْمُؤْمِنِينَ) مفعول به.\r\n\r\n"},{"sura":61,"ayah":14,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"كُونُوٓا۟","translation":"Be","transliteration":"kūnū"},{"position":5,"arabic":"أَنصَارَ","translation":"helpers","transliteration":"anṣāra"},{"position":6,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":7,"arabic":"كَمَا","translation":"as","transliteration":"kamā"},{"position":8,"arabic":"قَالَ","translation":"said","transliteration":"qāla"},{"position":9,"arabic":"عِيسَى","translation":"Isa","transliteration":"ʿīsā"},{"position":10,"arabic":"ٱبْنُ","translation":"son","transliteration":"ub'nu"},{"position":11,"arabic":"مَرْيَمَ","translation":"(of) Maryam","transliteration":"maryama"},{"position":12,"arabic":"لِلْحَوَارِيِّـۧنَ","translation":"to the disciples","transliteration":"lil'ḥawāriyyīna"},{"position":13,"arabic":"مَنْ","translation":"Who","transliteration":"man"},{"position":14,"arabic":"أَنصَارِىٓ","translation":"(are) my helpers","transliteration":"anṣārī"},{"position":15,"arabic":"إِلَى","translation":"for","transliteration":"ilā"},{"position":16,"arabic":"ٱللَّهِ ۖ","translation":"Allah","transliteration":"l-lahi"},{"position":17,"arabic":"قَالَ","translation":"Said","transliteration":"qāla"},{"position":18,"arabic":"ٱلْحَوَارِيُّونَ","translation":"the disciples","transliteration":"l-ḥawāriyūna"},{"position":19,"arabic":"نَحْنُ","translation":"We","transliteration":"naḥnu"},{"position":20,"arabic":"أَنصَارُ","translation":"(are) the helpers","transliteration":"anṣāru"},{"position":21,"arabic":"ٱللَّهِ ۖ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":22,"arabic":"فَـَٔامَنَت","translation":"Then believed","transliteration":"faāmanat"},{"position":23,"arabic":"طَّآئِفَةٌۭ","translation":"a group","transliteration":"ṭāifatun"},{"position":24,"arabic":"مِّنۢ","translation":"of","transliteration":"min"},{"position":25,"arabic":"بَنِىٓ","translation":"Children","transliteration":"banī"},{"position":26,"arabic":"إِسْرَٰٓءِيلَ","translation":"(of) Israel","transliteration":"is'rāīla"},{"position":27,"arabic":"وَكَفَرَت","translation":"and disbelieved","transliteration":"wakafarat"},{"position":28,"arabic":"طَّآئِفَةٌۭ ۖ","translation":"a group","transliteration":"ṭāifatun"},{"position":29,"arabic":"فَأَيَّدْنَا","translation":"So We supported","transliteration":"fa-ayyadnā"},{"position":30,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":31,"arabic":"ءَامَنُوا۟","translation":"believed","transliteration":"āmanū"},{"position":32,"arabic":"عَلَىٰ","translation":"against","transliteration":"ʿalā"},{"position":33,"arabic":"عَدُوِّهِمْ","translation":"their enemy","transliteration":"ʿaduwwihim"},{"position":34,"arabic":"فَأَصْبَحُوا۟","translation":"and they became","transliteration":"fa-aṣbaḥū"},{"position":35,"arabic":"ظَـٰهِرِينَ","translation":"dominant","transliteration":"ẓāhirīna"}],"e3rab":"(يا أَيُّهَا الَّذِينَ آمَنُوا) سبق إعرابها.\r\n\r\n(كُونُوا) فعل أمر ناقص والواو اسمه (أَنْصارَ اللَّهِ) خبره مضاف إلى لفظ الجلالة والجملة ابتدائية لا محل لها (كَما) صفة مفعول مطلق محذوف (قالَ عِيسَى) ماض وفاعله (ابْنُ) بدل من عيسى (مَرْيَمَ) مضاف إليه (لِلْحَوارِيِّينَ) متعلقان بالفعل والمصدر المؤول من ما والفعل في محل جر بالكاف (مَنْ) اسم استفهام مبتدأ (أَنْصارِي) خبر (إِلَى اللَّهِ) متعلقان بمحذوف حال والجملة مقول القول (قالَ الْحَوارِيُّونَ) ماض وفاعله والجملة استئنافية لا محل لها (نَحْنُ أَنْصارُ اللَّهِ) مبتدأ وخبره ولفظ الجلالة مضاف إليه والجملة مقول القول، (فَآمَنَتْ طائِفَةٌ) الفاء حرف عطف وماض وفاعله والجملة معطوفة على ما قبلها (مِنْ بَنِي) متعلقان بمحذوف صفة طائفة (إِسْرائِيلَ) مضاف إليه وجملة (وَكَفَرَتْ طائِفَةٌ) معطوفة على ما قبلها.\r\n\r\n(فَأَيَّدْنَا الَّذِينَ) الفاء حرف استئناف وماض وفاعله واسم الموصول مفعوله والجملة استئنافية لا محل له (آمَنُوا) ماض وفاعله والجملة صلة.\r\n\r\n(عَلى عَدُوِّهِمْ) متعلقان بالفعل (فَأَصْبَحُوا ظاهِرِينَ) الفاء حرف عطف وأصبح واسمها وخبرها والجملة معطوفة على ما قبلها.\r\n\r\n"}]