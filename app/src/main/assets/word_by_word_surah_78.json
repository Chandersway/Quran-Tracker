ds":[{"position":1,"arabic":"إِنَّهُمْ","translation":"Indeed, they","transliteration":"innahum"},{"position":2,"arabic":"كَانُوا۟","translation":"were","transliteration":"kānū"},{"position":3,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":4,"arabic":"يَرْجُونَ","translation":"expecting","transliteration":"yarjūna"},{"position":5,"arabic":"حِسَابًۭا","translation":"an account","transliteration":"ḥisāban"}],"e3rab":"(إِنَّهُمْ) إن واسمها و(كانُوا) كان واسمها و(لا) نافية و(يَرْجُونَ) مضارع مرفوع والواو فاعله و(حِساباً) مفعول به والجملة الفعلية خبر كانوا وجملة كانوا خبر إن والجملة الاسمية تعليل\r\n\r\n"},{"sura":78,"ayah":28,"words":[{"position":1,"arabic":"وَكَذَّبُوا۟","translation":"And they denied","transliteration":"wakadhabū"},{"position":2,"arabic":"بِـَٔايَـٰتِنَا","translation":"Our Signs","transliteration":"biāyātinā"},{"position":3,"arabic":"كِذَّابًۭا","translation":"(with) denial","transliteration":"kidhāban"}],"e3rab":"(وَكَذَّبُوا) ماض وفاعله و(بِآياتِنا) متعلقان بالفعل و(كِذَّاباً) مفعول مطلق والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":78,"ayah":29,"words":[{"position":1,"arabic":"وَكُلَّ","translation":"And every","transliteration":"wakulla"},{"position":2,"arabic":"شَىْءٍ","translation":"thing","transliteration":"shayin"},{"position":3,"arabic":"أَحْصَيْنَـٰهُ","translation":"We have enumerated it","transliteration":"aḥṣaynāhu"},{"position":4,"arabic":"كِتَـٰبًۭا","translation":"(in) a Book","transliteration":"kitāban"}],"e3rab":"(وَ) الواو حرف عطف (كُلَّ) منصوب على الاشتغال و(شَيْءٍ) مضاف إليه و(أَحْصَيْناهُ) ماض وفاعله ومفعوله و(كِتاباً) حال والجملة مفسرة للمحذوفة والجملة المحذوفة معترضة.\r\n\r\n"},{"sura":78,"ayah":30,"words":[{"position":1,"arabic":"فَذُوقُوا۟","translation":"So taste","transliteration":"fadhūqū"},{"position":2,"arabic":"فَلَن","translation":"and never","transliteration":"falan"},{"position":3,"arabic":"نَّزِيدَكُمْ","translation":"We will increase you","transliteration":"nazīdakum"},{"position":4,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":5,"arabic":"عَذَابًا","translation":"(in) punishment","transliteration":"ʿadhāban"}],"e3rab":"(فَذُوقُوا) الفاء حرف عطف وأمر وفاعله والجملة معطوفة على ما قبلها (فَلَنْ) الفاء حرف تعليل و(نَزِيدَكُمْ) مضارع منصوب بلن فاعله مستتر والكاف مفعول به أول و(إِلَّا) حرف حصر و(عَذاباً) مفعول به ثان والجملة الفعلية تعليل لا محل لها.\r\n\r\n"},{"sura":78,"ayah":31,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"لِلْمُتَّقِينَ","translation":"for the righteous","transliteration":"lil'muttaqīna"},{"position":3,"arabic":"مَفَازًا","translation":"(is) success","transliteration":"mafāzan"}],"e3rab":"(إِنَّ) حرف مشبه بالفعل و(لِلْمُتَّقِينَ) خبر إن المقدم و(مَفازاً) اسمها المؤخر والجملة مستأنفة\r\n\r\n"},{"sura":78,"ayah":32,"words":[{"position":1,"arabic":"حَدَآئِقَ","translation":"Gardens","transliteration":"ḥadāiqa"},{"position":2,"arabic":"وَأَعْنَـٰبًۭا","translation":"and grapevines","transliteration":"wa-aʿnāban"}],"e3rab":"(حَدائِقَ) بدل من مفازا و(أَعْناباً) معطوف على حدائق\r\n\r\n"},{"sura":78,"ayah":33,"words":[{"position":1,"arabic":"وَكَوَاعِبَ","translation":"And splendid companions","transliteration":"wakawāʿiba"},{"position":2,"arabic":"أَتْرَابًۭا","translation":"well-matched","transliteration":"atrāban"}],"e3rab":"(وَكَواعِبَ) معطوف على ما قبله و(أَتْراباً) صفة كواعب\r\n\r\n"},{"sura":78,"ayah":34,"words":[{"position":1,"arabic":"وَكَأْسًۭا","translation":"And a cup","transliteration":"wakasan"},{"position":2,"arabic":"دِهَاقًۭا","translation":"full","transliteration":"dihāqan"}],"e3rab":"(وَكَأْساً دِهاقاً) معطوفان على ما قبلهما.\r\n\r\n"},{"sura":78,"ayah":35,"words":[{"position":1,"arabic":"لَّا","translation":"Not","transliteration":"lā"},{"position":2,"arabic":"يَسْمَعُونَ","translation":"they will hear","transliteration":"yasmaʿūna"},{"position":3,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":4,"arabic":"لَغْوًۭا","translation":"any vain talk","transliteration":"laghwan"},{"position":5,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":6,"arabic":"كِذَّٰبًۭا","translation":"any falsehood","transliteration":"kidhāban"}],"e3rab":"(لا) نافية (يَسْمَعُونَ) مضارع مرفوع والواو فاعله و(فِيها) متعلقان بالفعل و(لَغْواً) مفعول به (وَلا) الواو حرف عطف و(لا) نافية و(كِذَّاباً) معطوف على لغوا والجملة حال\r\n\r\n"},{"sura":78,"ayah":36,"words":[{"position":1,"arabic":"جَزَآءًۭ","translation":"(As) a reward","transliteration":"jazāan"},{"position":2,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":3,"arabic":"رَّبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":4,"arabic":"عَطَآءً","translation":"a gift","transliteration":"ʿaṭāan"},{"position":5,"arabic":"حِسَابًۭا","translation":"(according to) account","transliteration":"ḥisāban"}],"e3rab":"و(جَزاءً) مفعول مطلق و(مِنْ رَبِّكَ) متعلقان بجزاء و(عَطاءً) بدل من جزاء و(حِساباً) صفة عطاء.\r\n\r\n"},{"sura":78,"ayah":37,"words":[{"position":1,"arabic":"رَّبِّ","translation":"Lord","transliteration":"rabbi"},{"position":2,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"(of) the heavens","transliteration":"l-samāwāti"},{"position":3,"arabic":"وَٱلْأَرْضِ","translation":"and the earth","transliteration":"wal-arḍi"},{"position":4,"arabic":"وَمَا","translation":"and whatever","transliteration":"wamā"},{"position":5,"arabic":"بَيْنَهُمَا","translation":"(is) between both of them","transliteration":"baynahumā"},{"position":6,"arabic":"ٱلرَّحْمَـٰنِ ۖ","translation":"the Most Gracious","transliteration":"l-raḥmāni"},{"position":7,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":8,"arabic":"يَمْلِكُونَ","translation":"they have power","transliteration":"yamlikūna"},{"position":9,"arabic":"مِنْهُ","translation":"from Him","transliteration":"min'hu"},{"position":10,"arabic":"خِطَابًۭا","translation":"(to) address","transliteration":"khiṭāban"}],"e3rab":"(رَبِّ السَّماواتِ) بدل من ربك مضاف إلى السموات (وَالْأَرْضِ) معطوف على السموات (وَما) معطوف على السموات و(بَيْنَهُمَا) ظرف مكان و(الرَّحْمنِ) بدل من رب و(لا) نافية و(يَمْلِكُونَ) مضارع مرفوع والواو فاعله و(مِنْهُ) متعلقان بالفعل و(خِطاباً) مفعول به والجملة مستأنفة.\r\n\r\n"},{"sura":78,"ayah":38,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"يَقُومُ","translation":"will stand","transliteration":"yaqūmu"},{"position":3,"arabic":"ٱلرُّوحُ","translation":"the Spirit","transliteration":"l-rūḥu"},{"position":4,"arabic":"وَٱلْمَلَـٰٓئِكَةُ","translation":"and the Angels","transliteration":"wal-malāikatu"},{"position":5,"arabic":"صَفًّۭا ۖ","translation":"(in) rows","transliteration":"ṣaffan"},{"position":6,"arabic":"لَّا","translation":"not","transliteration":"lā"},{"position":7,"arabic":"يَتَكَلَّمُونَ","translation":"they will speak","transliteration":"yatakallamūna"},{"position":8,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":9,"arabic":"مَنْ","translation":"(one) who ","transliteration":"man"},{"position":10,"arabic":"أَذِنَ","translation":"permits","transliteration":"adhina"},{"position":11,"arabic":"لَهُ","translation":"[for] him","transliteration":"lahu"},{"position":12,"arabic":"ٱلرَّحْمَـٰنُ","translation":"the Most Gracious","transliteration":"l-raḥmānu"},{"position":13,"arabic":"وَقَالَ","translation":"and he (will) say","transliteration":"waqāla"},{"position":14,"arabic":"صَوَابًۭا","translation":"(what is) correct","transliteration":"ṣawāban"}],"e3rab":"(يَوْمَ يَقُومُ الرُّوحُ) ظرف زمان ومضارع وفاعله (وَالْمَلائِكَةُ) معطوف على الروح والجملة في محل جر بالإضافة و(صَفًّا) حال و(لا) نافية (يَتَكَلَّمُونَ) مضارع مرفوع والواو فاعله والجملة حال و(إِلَّا) حرف حصر و(مَنْ) بدل من الواو في يتكلمون (أَذِنَ) ماض و(لَهُ) متعلقان بالفعل و(الرَّحْمنُ) فاعل والجملة صلة من (وَقالَ) ماض فاعله مستتر و(صَواباً) صفة مفعول مطلق محذوف والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":78,"ayah":39,"words":[{"position":1,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":2,"arabic":"ٱلْيَوْمُ","translation":"(is) the Day","transliteration":"l-yawmu"},{"position":3,"arabic":"ٱلْحَقُّ ۖ","translation":"the True","transliteration":"l-ḥaqu"},{"position":4,"arabic":"فَمَن","translation":"So whoever","transliteration":"faman"},{"position":5,"arabic":"شَآءَ","translation":"wills","transliteration":"shāa"},{"position":6,"arabic":"ٱتَّخَذَ","translation":"let him take","transliteration":"ittakhadha"},{"position":7,"arabic":"إِلَىٰ","translation":"towards","transliteration":"ilā"},{"position":8,"arabic":"رَبِّهِۦ","translation":"his Lord","transliteration":"rabbihi"},{"position":9,"arabic":"مَـَٔابًا","translation":"a return","transliteration":"maāban"}],"e3rab":"(ذلِكَ) مبتدأ و(الْيَوْمُ) خبره و(الْحَقُّ) صفة اليوم والجملة مستأنفة و(فَمَنْ) الفاء الفصيحة و(من) اسم شرط مبتدأ (شاءَ) ماض في محل جزم فعل الشرط و(اتَّخَذَ) ماض فاعله مستتر و(إِلى رَبِّهِ) متعلقان بالمفعول به (مَآباً) والجملة جواب الشرط لا محل لها وجملتا الشرط والجواب خبر المبتدأ من.\r\n\r\n"},{"sura":78,"ayah":40,"words":[{"position":1,"arabic":"إِنَّآ","translation":"Indeed We","transliteration":"innā"},{"position":2,"arabic":"أَنذَرْنَـٰكُمْ","translation":"[We] have warned you","transliteration":"andharnākum"},{"position":3,"arabic":"عَذَابًۭا","translation":"(of) a punishment","transliteration":"ʿadhāban"},{"position":4,"arabic":"قَرِيبًۭا","translation":"near","transliteration":"qarīban"},{"position":5,"arabic":"يَوْمَ","translation":"(the) Day","transliteration":"yawma"},{"position":6,"arabic":"يَنظُرُ","translation":"will see","transliteration":"yanẓuru"},{"position":7,"arabic":"ٱلْمَرْءُ","translation":"the man","transliteration":"l-maru"},{"position":8,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":9,"arabic":"قَدَّمَتْ","translation":"have sent forth","transliteration":"qaddamat"},{"position":10,"arabic":"يَدَاهُ","translation":"his hands","transliteration":"yadāhu"},{"position":11,"arabic":"وَيَقُولُ","translation":"and will say","transliteration":"wayaqūlu"},{"position":12,"arabic":"ٱلْكَافِرُ","translation":"the disbeliever","transliteration":"l-kāfiru"},{"position":13,"arabic":"يَـٰلَيْتَنِى","translation":"O I wish","transliteration":"yālaytanī"},{"position":14,"arabic":"كُنتُ","translation":"I were","transliteration":"kuntu"},{"position":15,"arabic":"تُرَٰبًۢا","translation":"dust","transliteration":"turāban"}],"e3rab":"(إِنَّا) إن واسمها.\r\n\r\n(أَنْذَرْناكُمْ) ماض وفاعله ومفعوله الأول. و(عَذاباً) مفعول به ثان. و(قَرِيباً) صفة والجملة خبر إنا والجملة الاسمية مستأنفة. و(يَوْمَ) ظرف زمان.\r\n\r\n(يَنْظُرُ) مضارع. و(الْمَرْءُ) فاعله و(ما) مفعول به والجملة في محل جر بالإضافة و(قَدَّمَتْ يَداهُ) ماض وفاعله والجملة صلة ما.\r\n\r\n(وَيَقُولُ الْكافِرُ) مضارع وفاعله والجملة معطوفة على ما قبلها و(يا) حرف تنبيه و(لَيْتَنِي) حرف مشبه بالفعل والنون للوقاية والياء اسمها و(كُنْتُ) كان واسمها، (تُراباً) خبرها والجملة الفعلية خبر ليت والجملة الاسمية مقول القول.\r\n\r\n"}]