n":"yasmaʿūna"},{"position":3,"arabic":"ٱلصَّيْحَةَ","translation":"the Blast","transliteration":"l-ṣayḥata"},{"position":4,"arabic":"بِٱلْحَقِّ ۚ","translation":"in truth","transliteration":"bil-ḥaqi"},{"position":5,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":6,"arabic":"يَوْمُ","translation":"(is the) Day","transliteration":"yawmu"},{"position":7,"arabic":"ٱلْخُرُوجِ","translation":"(of) coming forth","transliteration":"l-khurūji"}],"e3rab":"(يَوْمَ) بدل من يوم (يَسْمَعُونَ) مضارع مرفوع والواو فاعله (الصَّيْحَةَ) مفعول به والجملة في محل جر بالإضافة (بِالْحَقِّ) حال (ذلِكَ يَوْمُ) مبتدأ وخبره (الْخُرُوجِ) مضاف إليه والجملة الاسمية مستأنفة\r\n\r\n"},{"sura":50,"ayah":43,"words":[{"position":1,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"arabic":"نَحْنُ","translation":"[We]","transliteration":"naḥnu"},{"position":3,"arabic":"نُحْىِۦ","translation":"[We] give life","transliteration":"nuḥ'yī"},{"position":4,"arabic":"وَنُمِيتُ","translation":"and [We] cause death","transliteration":"wanumītu"},{"position":5,"arabic":"وَإِلَيْنَا","translation":"and to Us","transliteration":"wa-ilaynā"},{"position":6,"arabic":"ٱلْمَصِيرُ","translation":"(is) the final return","transliteration":"l-maṣīru"}],"e3rab":"(إِنَّا) إن واسمها (نَحْنُ) ضمير فصل (نُحْيِي) مضارع والفاعل مستتر والجملة خبر إن (وَنُمِيتُ) معطوف على نحيي (وَإِلَيْنَا) الواو حرف عطف وإلينا خبر مقدم (الْمَصِيرُ) مبتدأ مؤخر\r\n\r\n"},{"sura":50,"ayah":44,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"تَشَقَّقُ","translation":"will split","transliteration":"tashaqqaqu"},{"position":3,"arabic":"ٱلْأَرْضُ","translation":"the earth","transliteration":"l-arḍu"},{"position":4,"arabic":"عَنْهُمْ","translation":"from them","transliteration":"ʿanhum"},{"position":5,"arabic":"سِرَاعًۭا ۚ","translation":"hurrying","transliteration":"sirāʿan"},{"position":6,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":7,"arabic":"حَشْرٌ","translation":"(is) a gathering","transliteration":"ḥashrun"},{"position":8,"arabic":"عَلَيْنَا","translation":"for Us","transliteration":"ʿalaynā"},{"position":9,"arabic":"يَسِيرٌۭ","translation":"easy","transliteration":"yasīrun"}],"e3rab":"(يَوْمَ) بدل من يوم يسمعون (تَشَقَّقُ) مضارع (الْأَرْضُ) فاعله والجملة في محل جر بالإضافة (عَنْهُمْ) متعلقان بالفعل (سِراعاً) حال (ذلِكَ حَشْرٌ) مبتدأ وخبره (عَلَيْنا) متعلقان بما بعدهما (يَسِيرٌ) صفة حشر والجملة الاسمية مستأنفة\r\n\r\n"},{"sura":50,"ayah":45,"words":[{"position":1,"arabic":"نَّحْنُ","translation":"We","transliteration":"naḥnu"},{"position":2,"arabic":"أَعْلَمُ","translation":"know best","transliteration":"aʿlamu"},{"position":3,"arabic":"بِمَا","translation":"[of] what","transliteration":"bimā"},{"position":4,"arabic":"يَقُولُونَ ۖ","translation":"they say","transliteration":"yaqūlūna"},{"position":5,"arabic":"وَمَآ","translation":"and not","transliteration":"wamā"},{"position":6,"arabic":"أَنتَ","translation":"(are) you","transliteration":"anta"},{"position":7,"arabic":"عَلَيْهِم","translation":"over them","transliteration":"ʿalayhim"},{"position":8,"arabic":"بِجَبَّارٍۢ ۖ","translation":"the one to compel","transliteration":"bijabbārin"},{"position":9,"arabic":"فَذَكِّرْ","translation":"But remind","transliteration":"fadhakkir"},{"position":10,"arabic":"بِٱلْقُرْءَانِ","translation":"with the Quran","transliteration":"bil-qur'āni"},{"position":11,"arabic":"مَن","translation":"whoever","transliteration":"man"},{"position":12,"arabic":"يَخَافُ","translation":"fears","transliteration":"yakhāfu"},{"position":13,"arabic":"وَعِيدِ","translation":"My threat","transliteration":"waʿīdi"}],"e3rab":"(نَحْنُ أَعْلَمُ) مبتدأ وخبره والجملة مستأنفة لا محل لها (بِما) متعلقان بأعلم (يَقُولُونَ) مضارع مرفوع والواو فاعله والجملة صلة ما (وَما) الواو حالية وما نافية عاملة عمل ليس (أَنْتَ) اسمها (عَلَيْهِمْ) متعلقان بما بعدهما (بِجَبَّارٍ) الباء حرف جر زائد وجبار مجرور لفظا منصوب محلا خبر ما والجملة حالية (فَذَكِّرْ) الفاء الفصيحة وأمر فاعله مستتر (بِالْقُرْآنِ) متعلقان بالفعل (مَنْ) مفعول به (يَخافُ) مضارع فاعله مستتر (وَعِيدِ) مفعول به وياء المتكلم المحذوفة مضاف إليه والجملة صلة من وجملة ذكر جواب شرط مقدر لا محل لها.\r\n\r\n"}]