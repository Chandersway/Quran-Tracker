[{"sura":100,"ayah":1,"words":[{"position":1,"arabic":"وَٱلْعَـٰدِيَـٰتِ","translation":"By the racers","transliteration":"wal-ʿādiyāti"},{"position":2,"arabic":"ضَبْحًۭا","translation":"panting","transliteration":"ḍabḥan"}],"e3rab":"(وَالْعادِياتِ) جار ومجرور متعلقان بفعل قسم محذوف (ضَبْحاً) مفعول مطلق لفعل محذوف.\r\n\r\nوالجملة الفعلية في محل نصب حال.\r\n\r\n"},{"sura":100,"ayah":2,"words":[{"position":1,"arabic":"فَٱلْمُورِيَـٰتِ","translation":"And the producers of sparks","transliteration":"fal-mūriyāti"},{"position":2,"arabic":"قَدْحًۭا","translation":"striking","transliteration":"qadḥan"}],"e3rab":"«فَالْمُورِياتِ» معطوف على العاديات «قَدْحاً» حال.\r\n\r\n"},{"sura":100,"ayah":3,"words":[{"position":1,"arabic":"فَٱلْمُغِيرَٰتِ","translation":"And the chargers","transliteration":"fal-mughīrāti"},{"position":2,"arabic":"صُبْحًۭا","translation":"(at) dawn","transliteration":"ṣub'ḥan"}],"e3rab":"«فَالْمُغِيراتِ» معطوف على العاديات «صُبْحاً» ظرف زمان\r\n\r\n"},{"sura":100,"ayah":4,"words":[{"position":1,"arabic":"فَأَثَرْنَ","translation":"Then raise","transliteration":"fa-atharna"},{"position":2,"arabic":"بِهِۦ","translation":"thereby","transliteration":"bihi"},{"position":3,"arabic":"نَقْعًۭا","translation":"dust","transliteration":"naqʿan"}],"e3rab":"(فَأَثَرْنَ) ماض مبني على السكون والنون فاعله (بِهِ) متعلقان بالفعل (نَقْعاً) مفعول به والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":100,"ayah":5,"words":[{"position":1,"arabic":"فَوَسَطْنَ","translation":"Then penetrate (in the) center","transliteration":"fawasaṭna"},{"position":2,"arabic":"بِهِۦ","translation":"thereby","transliteration":"bihi"},{"position":3,"arabic":"جَمْعًا","translation":"collectively","transliteration":"jamʿan"}],"e3rab":"معطوفة على ما قبلها وإعرابها مثله.\r\n\r\n"},{"sura":100,"ayah":6,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلْإِنسَـٰنَ","translation":"mankind","transliteration":"l-insāna"},{"position":3,"arabic":"لِرَبِّهِۦ","translation":"to his Lord","transliteration":"lirabbihi"},{"position":4,"arabic":"لَكَنُودٌۭ","translation":"(is) surely ungrateful","transliteration":"lakanūdun"}],"e3rab":"(إِنَّ الْإِنْسانَ) إن واسمها (لِرَبِّهِ) متعلقان بما بعدهما (لَكَنُودٌ) اللام المزحلقة (كنود) خبر إن والجملة الاسمية جواب قسم لا محل لها.\r\n\r\n"},{"sura":100,"ayah":7,"words":[{"position":1,"arabic":"وَإِنَّهُۥ","translation":"And indeed, he","transliteration":"wa-innahu"},{"position":2,"arabic":"عَلَىٰ","translation":"on","transliteration":"ʿalā"},{"position":3,"arabic":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":4,"arabic":"لَشَهِيدٌۭ","translation":"surely (is) a witness","transliteration":"lashahīdun"}],"e3rab":"(وَإِنَّهُ) إن واسمها (عَلى ذلِكَ) متعلقان بما بعدهما (لَشَهِيدٌ) اللام المزحلقة (شهيد) خبر إن والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":100,"ayah":8,"words":[{"position":1,"arabic":"وَإِنَّهُۥ","translation":"And indeed he","transliteration":"wa-innahu"},{"position":2,"arabic":"لِحُبِّ","translation":"in (the) love","transliteration":"liḥubbi"},{"position":3,"arabic":"ٱلْخَيْرِ","translation":"(of) wealth","transliteration":"l-khayri"},{"position":4,"arabic":"لَشَدِيدٌ","translation":"(is) surely intense","transliteration":"lashadīdun"}],"e3rab":"(وَإِنَّهُ) إن واسمها (لِحُبِّ) متعلقان بشديد (الْخَيْرِ) مضاف إليه (لَشَدِيدٌ) اللام المزحلقة (شديد) خبر إن. والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":100,"ayah":9,"words":[{"position":1,"arabic":"۞ أَفَلَا","translation":"But does not","transliteration":"afalā"},{"position":2,"arabic":"يَعْلَمُ","translation":"he know","transliteration":"yaʿlamu"},{"position":3,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":4,"arabic":"بُعْثِرَ","translation":"will be scattered","transliteration":"buʿ'thira"},{"position":5,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":6,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":7,"arabic":"ٱلْقُبُورِ","translation":"the graves","transliteration":"l-qubūri"}],"e3rab":"(أَفَلا) الهمزة حرف استفهام إنكاري والفاء حرف عطف عطفت على محذوف مقدر ولا نافية (يَعْلَمُ) مضارع فاعله مستتر والجملة مستأنفة لا محل لها (إِذا) ظرف زمان (بُعْثِرَ) ماض مبني للمجهول (ما) نائب فاعل (فِي الْقُبُورِ) متعلقان بمحذوف صلة الموصول والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":100,"ayah":10,"words":[{"position":1,"arabic":"وَحُصِّلَ","translation":"And is made apparent","transliteration":"waḥuṣṣila"},{"position":2,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":3,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":4,"arabic":"ٱلصُّدُورِ","translation":"the breasts","transliteration":"l-ṣudūri"}],"e3rab":"(وَحُصِّلَ ما) ماض مبني للمجهول وما نائب فاعل (فِي الصُّدُورِ) متعلقان بمحذوف صلة الموصول.\r\n\r\nوالجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":100,"ayah":11,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"رَبَّهُم","translation":"their Lord","transliteration":"rabbahum"},{"position":3,"arabic":"بِهِمْ","translation":"about them","transliteration":"bihim"},{"position":4,"arabic":"يَوْمَئِذٍۢ","translation":"that Day","transliteration":"yawma-idhin"},{"position":5,"arabic":"لَّخَبِيرٌۢ","translation":"(is) surely All-Aware","transliteration":"lakhabīrun"}],"e3rab":"(إِنَّ رَبَّهُمْ) إن واسمها (بِهِمْ) متعلقان بخبير (يَوْمَئِذٍ) ظرف مضاف إلى مثله (لَخَبِيرٌ) اللام المزحلقة (خبير) خبر إن والجملة مستأنفة لا محل لها.\r\n\r\n"}]