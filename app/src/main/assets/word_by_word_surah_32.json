لد والجملة مقول قول محذوف (بِما) متعلقان بالفعل (كُنْتُمْ) كان واسمها (تَعْمَلُونَ) مضارع وفاعله وجملة كنتم صلة ما لا محل لها.\r\n\r\n"},{"sura":32,"ayah":15,"words":[{"position":1,"arabic":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"position":2,"arabic":"يُؤْمِنُ","translation":"believe","transliteration":"yu'minu"},{"position":3,"arabic":"بِـَٔايَـٰتِنَا","translation":"in Our Verses","transliteration":"biāyātinā"},{"position":4,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":5,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":6,"arabic":"ذُكِّرُوا۟","translation":"they are reminded","transliteration":"dhukkirū"},{"position":7,"arabic":"بِهَا","translation":"of them","transliteration":"bihā"},{"position":8,"arabic":"خَرُّوا۟","translation":"fall down","transliteration":"kharrū"},{"position":9,"arabic":"سُجَّدًۭا","translation":"prostrating","transliteration":"sujjadan"},{"position":10,"arabic":"وَسَبَّحُوا۟","translation":"and glorify","transliteration":"wasabbaḥū"},{"position":11,"arabic":"بِحَمْدِ","translation":"(the) praises","transliteration":"biḥamdi"},{"position":12,"arabic":"رَبِّهِمْ","translation":"(of) their Lord","transliteration":"rabbihim"},{"position":13,"arabic":"وَهُمْ","translation":"and they","transliteration":"wahum"},{"position":14,"arabic":"لَا","translation":"are not arrogant","transliteration":"lā"},{"position":15,"arabic":"يَسْتَكْبِرُونَ ۩","translation":"are not arrogant","transliteration":"yastakbirūna"}],"e3rab":"(إِنَّما) كافة ومكفوفة (يُؤْمِنُ) مضارع مرفوع (بِآياتِنَا) متعلقان بالفعل (الَّذِينَ) فاعل والجملة مستأنفة لا محل لها (إِذا) ظرفية شرطية غير جازمة (ذُكِّرُوا) ماض مبني للمجهول والواو نائب فاعل (بِها) متعلقان بالفعل والجملة في محل جر بالإضافة.\r\n\r\n(خَرُّوا) ماض وفاعله والجملة جواب الشرط لا محل لها (سُجَّداً) حال (وَسَبَّحُوا) معطوف على خروا (بِحَمْدِ) متعلقان بالفعل (رَبِّهِمْ) مضاف إليه (وَهُمْ) الواو حالية وهم مبتدأ (لا) نافية (يَسْتَكْبِرُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر هم والجملة الاسمية حال.\r\n\r\n"},{"sura":32,"ayah":16,"words":[{"position":1,"arabic":"تَتَجَافَىٰ","translation":"Forsake","transliteration":"tatajāfā"},{"position":2,"arabic":"جُنُوبُهُمْ","translation":"their sides","transliteration":"junūbuhum"},{"position":3,"arabic":"عَنِ","translation":"from","transliteration":"ʿani"},{"position":4,"arabic":"ٱلْمَضَاجِعِ","translation":"(their) beds","transliteration":"l-maḍājiʿi"},{"position":5,"arabic":"يَدْعُونَ","translation":"they call","transliteration":"yadʿūna"},{"position":6,"arabic":"رَبَّهُمْ","translation":"their Lord","transliteration":"rabbahum"},{"position":7,"arabic":"خَوْفًۭا","translation":"(in) fear","transliteration":"khawfan"},{"position":8,"arabic":"وَطَمَعًۭا","translation":"and hope","transliteration":"waṭamaʿan"},{"position":9,"arabic":"وَمِمَّا","translation":"and out of what","transliteration":"wamimmā"},{"position":10,"arabic":"رَزَقْنَـٰهُمْ","translation":"We have provided them","transliteration":"razaqnāhum"},{"position":11,"arabic":"يُنفِقُونَ","translation":"they spend","transliteration":"yunfiqūna"}],"e3rab":"(تَتَجافى جُنُوبُهُمْ) مضارع وفاعله والجملة حال (عَنِ الْمَضاجِعِ) متعلقان بالفعل (يَدْعُونَ) مضارع مرفوع والواو فاعله (رَبَّهُمْ) مفعول به (خَوْفاً) مفعول لأجله (وَطَمَعاً) معطوف على خوفا والجملة حال أيضا والواو حرف عطف (وَمِمَّا) متعلقان بالفعل بعدهما (رَزَقْناهُمْ) ماض وفاعله ومفعوله والجملة صلة ما (يُنْفِقُونَ) مضارع مرفوع والواو فاعله والجملة معطوفة على جملة يدعون.\r\n\r\n"},{"sura":32,"ayah":17,"words":[{"position":1,"arabic":"فَلَا","translation":"And not","transliteration":"falā"},{"position":2,"arabic":"تَعْلَمُ","translation":"knows","transliteration":"taʿlamu"},{"position":3,"arabic":"نَفْسٌۭ","translation":"a soul","transliteration":"nafsun"},{"position":4,"arabic":"مَّآ","translation":"what","transliteration":"mā"},{"position":5,"arabic":"أُخْفِىَ","translation":"is hidden","transliteration":"ukh'fiya"},{"position":6,"arabic":"لَهُم","translation":"for them","transliteration":"lahum"},{"position":7,"arabic":"مِّن","translation":"of","transliteration":"min"},{"position":8,"arabic":"قُرَّةِ","translation":"(the) comfort","transliteration":"qurrati"},{"position":9,"arabic":"أَعْيُنٍۢ","translation":"(for) the eyes","transliteration":"aʿyunin"},{"position":10,"arabic":"جَزَآءًۢ","translation":"(as) a reward","transliteration":"jazāan"},{"position":11,"arabic":"بِمَا","translation":"for what","transliteration":"bimā"},{"position":12,"arabic":"كَانُوا۟","translation":"they used (to)","transliteration":"kānū"},{"position":13,"arabic":"يَعْمَلُونَ","translation":"do","transliteration":"yaʿmalūna"}],"e3rab":"(فَلا) الفاء حرف استئناف (لا) نافية (تَعْلَمُ نَفْسٌ) مضارع وفاعله والجملة مستأنفة لا محل لها (ما) مفعول به (أُخْفِيَ) ماض مبني للمجهول ونائب الفاعل مستتر والجملة صلة ما (لَهُمْ) متعلقان بالفعل (مِنْ قُرَّةِ) حال (أَعْيُنٍ) مضاف إليه (جَزاءً) مفعول مطلق لفعل محذوف (بِما) متعلقان بجزاء (كانُوا) كان واسمها (يَعْمَلُونَ) مضارع مرفوع والواو فاعله والجملة خبر كانوا وجملة كانوا.. صلة ما لا محل لها.\r\n\r\n"},{"sura":32,"ayah":18,"words":[{"position":1,"arabic":"أَفَمَن","translation":"Then is one who","transliteration":"afaman"},{"position":2,"arabic":"كَانَ","translation":"is","transliteration":"kāna"},{"position":3,"arabic":"مُؤْمِنًۭا","translation":"a believer","transliteration":"mu'minan"},{"position":4,"arabic":"كَمَن","translation":"like (him) who","transliteration":"kaman"},{"position":5,"arabic":"كَانَ","translation":"is","transliteration":"kāna"},{"position":6,"arabic":"فَاسِقًۭا ۚ","translation":"defiantly disobedient","transliteration":"fāsiqan"},{"position":7,"arabic":"لَّا","translation":"Not","transliteration":"lā"},{"position":8,"arabic":"يَسْتَوُۥنَ","translation":"they are equal","transliteration":"yastawūna"}],"e3rab":"(أَفَمَنْ) الهمزة حرف استفهام والفاء حرف عطف ومن اسم موصول مبتدأ (كانَ) ماض ناقص اسمه مستتر (مُؤْمِناً) خبره والجملة صلة من (كَمَنْ) خبر المبتدأ من.\r\n\r\n(كانَ) ماض ناقص اسمه مستتر (فاسِقاً) خبره والجملة صلة من (لا يَسْتَوُونَ) لا نافية ومضارع مرفوع والواو فاعله والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":32,"ayah":19,"words":[{"position":1,"arabic":"أَمَّا","translation":"As for","transliteration":"ammā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"وَعَمِلُوا۟","translation":"and do","transliteration":"waʿamilū"},{"position":5,"arabic":"ٱلصَّـٰلِحَـٰتِ","translation":"righteous deeds","transliteration":"l-ṣāliḥāti"},{"position":6,"arabic":"فَلَهُمْ","translation":"then for them","transliteration":"falahum"},{"position":7,"arabic":"جَنَّـٰتُ","translation":"(are) Gardens","transliteration":"jannātu"},{"position":8,"arabic":"ٱلْمَأْوَىٰ","translation":"(of) Refuge","transliteration":"l-mawā"},{"position":9,"arabic":"نُزُلًۢا","translation":"(as) hospitality","transliteration":"nuzulan"},{"position":10,"arabic":"بِمَا","translation":"for what","transliteration":"bimā"},{"position":11,"arabic":"كَانُوا۟","translation":"they used (to)","transliteration":"kānū"},{"position":12,"arabic":"يَعْمَلُونَ","translation":"do","transliteration":"yaʿmalūna"}],"e3rab":"(أَمَّا) حرف شرط وتفصيل (الَّذِينَ)، مبتدأ (آمَنُوا) ماض وفاعله (وَعَمِلُوا) معطوف على آمنوا (الصَّالِحاتِ) مفعول به والجملة صلة الذين، (فَلَهُمْ) الفاء رابطة (لهم) متعلقان بخبر مقدم (جَنَّاتُ الْمَأْوى) مبتدأ مؤخر مضاف إلى المأوى والجملة الاسمية خبر الذين وجملة أما الذين.. مستأنفة لا محل لها (نُزُلًا) حال (بِما) متعلقان بنزلا (كانُوا) كان واسمها (يَعْمَلُونَ) مضارع مرفوع والواو فاعله والجملة خبر كانوا.. وجملة كانوا.. صلة ما لا محل لها.\r\n\r\n"},{"sura":32,"ayah":20,"words":[{"position":1,"arabic":"وَأَمَّا","translation":"But as for","transliteration":"wa-ammā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"فَسَقُوا۟","translation":"are defiantly disobedient","transliteration":"fasaqū"},{"position":4,"arabic":"فَمَأْوَىٰهُمُ","translation":"then their refuge","transliteration":"famawāhumu"},{"position":5,"arabic":"ٱلنَّارُ ۖ","translation":"(is) the Fire","transliteration":"l-nāru"},{"position":6,"arabic":"كُلَّمَآ","translation":"Every time","transliteration":"kullamā"},{"position":7,"arabic":"أَرَادُوٓا۟","translation":"they wish","transliteration":"arādū"},{"position":8,"arabic":"أَن","translation":"to","transliteration":"an"},{"position":9,"arabic":"يَخْرُجُوا۟","translation":"come out","transliteration":"yakhrujū"},{"position":10,"arabic":"مِنْهَآ","translation":"from it","transliteration":"min'hā"},{"position":11,"arabic":"أُعِيدُوا۟","translation":"they (will) be returned","transliteration":"uʿīdū"},{"position":12,"arabic":"فِيهَا","translation":"in it","transliteration":"fīhā"},{"position":13,"arabic":"وَقِيلَ","translation":"and it (will) be said","transliteration":"waqīla"},{"position":14,"arabic":"لَهُمْ","translation":"to them","transliteration":"lahum"},{"position":15,"arabic":"ذُوقُوا۟","translation":"Taste","transliteration":"dhūqū"},{"position":16,"arabic":"عَذَابَ","translation":"(the) punishment","transliteration":"ʿadhāba"},{"position":17,"arabic":"ٱلنَّارِ","translation":"(of) the Fire","transliteration":"l-nāri"},{"position":18,"arabic":"ٱلَّذِى","translation":"which","transliteration":"alladhī"},{"position":19,"arabic":"كُنتُم","translation":"you used (to)","transliteration":"kuntum"},{"position":20,"arabic":"بِهِۦ","translation":"[in it]","transliteration":"bihi"},{"position":21,"arabic":"تُكَذِّبُونَ","translation":"deny","transliteration":"tukadhibūna"}],"e3rab":"(وَأَمَّا) الواو حرف عطف (أَمَّا) حرف شرط وتفصيل (الَّذِينَ) مبتدأ (فَسَقُوا) ماض وفاعله والجملة صلة الذين (فَمَأْواهُمُ) الفاء رابطة.\r\n\r\n(مأواهم النَّارُ) مبتدأ وخبره والجملة الاسمية خبر الذين وجملة أما الذين معطوفة على ما قبلها (كُلَّما) ظرف زمان متضمن معنى الشرط (أَرادُوا) ماض وفاعله (أَنْ يَخْرُجُوا) مضارع منصوب بأن والواو فاعله والمصدر المؤول من أن والفعل في محل نصب مفعول به لأرادوا (مِنْها) متعلقان بالفعل (أُعِيدُوا) ماض مبني للمجهول والواو نائب فاعل والجملة جواب الشرط لا محل لها.\r\n\r\n(فِيها) متعلقان بالفعل (وَقِيلَ) معطوف على أعيدوا (لَهُمْ) متعلقان بقيل (ذُوقُوا) أمر وفاعله (عَذابَ النَّارِ) مفعول به مضاف إلى النار والجملة نائب فاعل لقيل.\r\n\r\n(الَّذِي) صفة عذاب (كُنْتُمْ) كان واسمها (بِهِ) متعلقان بما بعدهما (تُكَذِّبُونَ) مضارع مرفوع والواو فاعله والجملة خبر كنتم وجملة كنتم.. صلة الذي لا محل لها.\r\n\r\n"},{"sura":32,"ayah":21,"words":[{"position":1,"arabic":"وَلَنُذِيقَنَّهُم","translation":"And surely, We will let them taste","transliteration":"walanudhīqannahum"},{"position":2,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":3,"arabic":"ٱلْعَذَابِ","translation":"the punishment","transliteration":"l-ʿadhābi"},{"position":4,"arabic":"ٱلْأَدْنَىٰ","translation":"the nearer","transliteration":"l-adnā"},{"position":5,"arabic":"دُونَ","translation":"before","transliteration":"dūna"},{"position":6,"arabic":"ٱلْعَذَابِ","translation":"the punishment","transliteration":"l-ʿadhābi"},{"position":7,"arabic":"ٱلْأَكْبَرِ","translation":"the greater","transliteration":"l-akbari"},{"position":8,"arabic":"لَعَلَّهُمْ","translation":"so that they may","transliteration":"laʿallahum"},{"position":9,"arabic":"يَرْجِعُونَ","translation":"return","transliteration":"yarjiʿūna"}],"e3rab":"(وَلَنُذِيقَنَّهُمْ) الواو حرف قسم وجر والمقسم به محذوف واللام واقعة في جواب القسم ومضارع مبني على الفتح لاتصاله بنون التوكيد الثقيلة والهاء مفعول به والفاعل مستتر والجملة جواب القسم لا محل لها (مِنَ الْعَذابِ) متعلقان بالفعل (الْأَدْنى) صفة العذاب (دُونَ الْعَذابِ) ظرف مكان مضاف إلى العذاب (الْأَكْبَرِ) صفة العذاب.\r\n\r\n(لَعَلَّهُمْ) لعل واسمها (يَرْجِعُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر لعل والجملة الاسمية تعليل.\r\n\r\n"},{"sura":32,"ayah":22,"words":[{"position":1,"arabic":"وَمَنْ","translation":"And who","transliteration":"waman"},{"position":2,"arabic":"أَظْلَمُ","translation":"(is) more unjust","transliteration":"aẓlamu"},{"position":3,"arabic":"مِمَّن","translation":"than (he) who","transliteration":"mimman"},{"position":4,"arabic":"ذُكِّرَ","translation":"is reminded","transliteration":"dhukkira"},{"position":5,"arabic":"بِـَٔايَـٰتِ","translation":"of (the) Verses","transliteration":"biāyāti"},{"position":6,"arabic":"رَبِّهِۦ","translation":"(of) his Lord","transliteration":"rabbihi"},{"position":7,"arabic":"ثُمَّ","translation":"then","transliteration":"thumma"},{"position":8,"arabic":"أَعْرَضَ","translation":"he turns away","transliteration":"aʿraḍa"},{"position":9,"arabic":"عَنْهَآ ۚ","translation":"from them","transliteration":"ʿanhā"},{"position":10,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":11,"arabic":"مِنَ","translation":"from","transliteration":"mina"},{"position":12,"arabic":"ٱلْمُجْرِمِينَ","translation":"the criminals","transliteration":"l-muj'rimīna"},{"position":13,"arabic":"مُنتَقِمُونَ","translation":"(will) take retribution","transliteration":"muntaqimūna"}],"e3rab":"(وَمَنْ) الواو حرف استئناف (مَنْ أَظْلَمُ) مبتدأ وخبره والجملة مستأنفة لا محل لها (مِمَّنْ) متعلقان بأظلم (ذُكِّرَ) ماض مبني للمجهول ونائب الفاعل مستتر (بِآياتِ) متعلقان بالفعل (رَبِّهِ) مضاف إليه والجملة صلة من.\r\n\r\n(ثُمَّ) حرف عطف (أَعْرَضَ) ماض فاعله مستتر (عَنْها) متعلقان بالفعل والجملة معطوفة على ما قبلها.\r\n\r\n(إِنَّا) إن واسمها (مِنَ الْمُجْرِمِينَ) متعلقان بالخبر (مُنْتَقِمُونَ) والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"},{"sura":32,"ayah":23,"words":[{"position":1,"arabic":"وَلَقَدْ","translation":"And certainly","transliteration":"walaqad"},{"position":2,"arabic":"ءَاتَيْنَا","translation":"We gave","transliteration":"ātaynā"},{"position":3,"arabic":"مُوسَى","translation":"Musa","transliteration":"mūsā"},{"position":4,"arabic":"ٱلْكِتَـٰبَ","translation":"the Scripture","transliteration":"l-kitāba"},{"position":5,"arabic":"فَلَا","translation":"so (do) not","transliteration":"falā"},{"position":6,"arabic":"تَكُن","translation":"be","transliteration":"takun"},{"position":7,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":8,"arabic":"مِرْيَةٍۢ","translation":"doubt","transliteration":"mir'yatin"},{"position":9,"arabic":"مِّن","translation":"about","transliteration":"min"},{"position":10,"arabic":"لِّقَآئِهِۦ ۖ","translation":"receiving it","transliteration":"liqāihi"},{"position":11,"arabic":"وَجَعَلْنَـٰهُ","translation":"And We made it","transliteration":"wajaʿalnāhu"},{"position":12,"arabic":"هُدًۭى","translation":"a guide","transliteration":"hudan"},{"position":13,"arabic":"لِّبَنِىٓ","translation":"for the Children of Israel","transliteration":"libanī"},{"position":14,"arabic":"إِسْرَٰٓءِيلَ","translation":"for the Children of Israel","transliteration":"is'rāīla"}],"e3rab":"(وَلَقَدْ) الواو حرف قسم وجر والمقسم به محذوف واللام واقعة في جواب القسم وقد حرف تحقيق (آتَيْنا) ماض وفاعله (مُوسَى) مفعول به أول (الْكِتابَ) مفعول به ثان والجملة جواب القسم لا محل لها.\r\n\r\n(فَلا تَكُنْ) الفاء الفصيحة ومضارع ناقص مجزوم بلا الناهية واسمه مستتر (فِي مِرْيَةٍ) خبر تكن والجملة جواب شرط مقدر لا محل لها (مِنْ لِقائِهِ) متعلقان بمرية (وَجَعَلْناهُ) ماض وفاعله ومفعوله الأول (هُدىً) مفعوله الثاني والجملة معطوفة على ما قبلها (لِبَنِي) جار ومجرور متعلقان بهدى وعلامة الجر الياء لأنه ملحق بجمع المذكر السالم (إِسْرائِيلَ) مضاف إليه.\r\n\r\n"},{"sura":32,"ayah":24,"words":[{"position":1,"arabic":"وَجَعَلْنَا","translation":"And We made","transliteration":"wajaʿalnā"},{"position":2,"arabic":"مِنْهُمْ","translation":"from them","transliteration":"min'hum"},{"position":3,"arabic":"أَئِمَّةًۭ","translation":"leaders","transliteration":"a-immatan"},{"position":4,"arabic":"يَهْدُونَ","translation":"guiding","transliteration":"yahdūna"},{"position":5,"arabic":"بِأَمْرِنَا","translation":"by Our Command","transliteration":"bi-amrinā"},{"position":6,"arabic":"لَمَّا","translation":"when","transliteration":"lammā"},{"position":7,"arabic":"صَبَرُوا۟ ۖ","translation":"they were patient","transliteration":"ṣabarū"},{"position":8,"arabic":"وَكَانُوا۟","translation":"and they were","transliteration":"wakānū"},{"position":9,"arabic":"بِـَٔايَـٰتِنَا","translation":"of Our Verses","transliteration":"biāyātinā"},{"position":10,"arabic":"يُوقِنُونَ","translation":"certain","transliteration":"yūqinūna"}],"e3rab":"(وَجَعَلْنا) ماض وفاعله (مِنْهُمْ) متعلقان بالفعل (أَئِمَّةً) مفعول به والجملة معطوفة على ما قبلها (يَهْدُونَ) مضارع مرفوع والواو فاعله والجملة صفة أئمة (بِأَمْرِنا) متعلقان بالفعل (لَمَّا) ظرفية حينية (صَبَرُوا) ماض وفاعله والجملة في محل جر بالإضافة (وَكانُوا) كان واسمها (بِآياتِنا) متعلقان بما بعدهما (يُوقِنُونَ) مضارع مرفوع والواو فاعله والجملة خبر كانوا وجملة كانوا.. معطوفة على ما قبلها.\r\n\r\n"},{"sura":32,"ayah":25,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"رَبَّكَ","translation":"your Lord","transliteration":"rabbaka"},{"position":3,"arabic":"هُوَ","translation":"[He]","transliteration":"huwa"},{"position":4,"arabic":"يَفْصِلُ","translation":"will judge","transliteration":"yafṣilu"},{"position":5,"arabic":"بَيْنَهُمْ","translation":"between them","transliteration":"baynahum"},{"position":6,"arabic":"يَوْمَ","translation":"(on the) Day","transliteration":"yawma"},{"position":7,"arabic":"ٱلْقِيَـٰمَةِ","translation":"(of) Resurrection","transliteration":"l-qiyāmati"},{"position":8,"arabic":"فِيمَا","translation":"in what","transliteration":"fīmā"},{"position":9,"arabic":"كَانُوا۟","translation":"they used (to)","transliteration":"kānū"},{"position":10,"arabic":"فِيهِ","translation":"[in it]","transliteration":"fīhi"},{"position":11,"arabic":"يَخْتَلِفُونَ","translation":"differ","transliteration":"yakhtalifūna"}],"e3rab":"(إِنَّ رَبَّكَ) إن واسمها (هُوَ) ضمير فصل (يَفْصِلُ) مضارع فاعله مستتر والجملة الفعلية خبر إن والجملة الاسمية مستأنفة لا محل لها (بَيْنَهُمْ) ظرف مكان (يَوْمَ الْقِيامَةِ) ظرف زمان مضاف إلى القيامة (فِيما) متعلقان بالفعل يفصل (كانُوا) كان واسمها (فِيهِ) متعلقان بما بعدهما (يَخْتَلِفُونَ) مضارع مرفوع والواو فاعله والجملة خبر كانوا وجملة كانوا.. صلة لا محل لها.\r\n\r\n"},{"sura":32,"ayah":26,"words":[{"position":1,"arabic":"أَوَلَمْ","translation":"Does it not","transliteration":"awalam"},{"position":2,"arabic":"يَهْدِ","translation":"guide","transliteration":"yahdi"},{"position":3,"arabic":"لَهُمْ","translation":"[for] them","transliteration":"lahum"},{"position":4,"arabic":"كَمْ","translation":"(that) how many","transliteration":"kam"},{"position":5,"arabic":"أَهْلَكْنَا","translation":"We have destroyed","transliteration":"ahlaknā"},{"position":6,"arabic":"مِن","translation":"before them","transliteration":"min"},{"position":7,"arabic":"قَبْلِهِم","translation":"before them","transliteration":"qablihim"},{"position":8,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":9,"arabic":"ٱلْقُرُونِ","translation":"the generations","transliteration":"l-qurūni"},{"position":10,"arabic":"يَمْشُونَ","translation":"they walk about","transliteration":"yamshūna"},{"position":11,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":12,"arabic":"مَسَـٰكِنِهِمْ ۚ","translation":"their dwellings","transliteration":"masākinihim"},{"position":13,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":14,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":15,"arabic":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":16,"arabic":"لَـَٔايَـٰتٍ ۖ","translation":"surely, are Signs","transliteration":"laāyātin"},{"position":17,"arabic":"أَفَلَا","translation":"Then do not","transliteration":"afalā"},{"position":18,"arabic":"يَسْمَعُونَ","translation":"they hear","transliteration":"yasmaʿūna"}],"e3rab":"(أَوَلَمْ يَهْدِ) الهمزة حرف استفهام إنكاري والواو حرف عطف ومضارع مجزوم بلم (لَهُمْ) متعلقان بالفعل (كَمْ) خبرية في محل نصب مفعول به مقدم لأهلكنا (أَهْلَكْنا) ماض وفاعله والجملة فاعل يهد (مِنْ قَبْلِهِمْ) متعلقان بمحذوف حال (مِنَ الْقُرُونِ) متعلقان بمحذوف حال أيضا (يَمْشُونَ) مضارع وفاعله والجملة حال (فِي مَساكِنِهِمْ) متعلقان بالفعل.\r\n\r\n(إِنَّ) حرف مشبه بالفعل (فِي ذلِكَ) خبره المقدم (لَآياتٍ) اللام المزحلقة واسم إن المؤخر والجملة الاسمية مستأنفة لا محل لها، (أَفَلا) الهمزة حرف استفهام توبيخي والفاء حرف استئناف ولا نافية (يَسْمَعُونَ) مضارع مرفوع والواو فاعله والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":32,"ayah":27,"words":[{"position":1,"arabic":"أَوَلَمْ","translation":"Do not","transliteration":"awalam"},{"position":2,"arabic":"يَرَوْا۟","translation":"they see","transliteration":"yaraw"},{"position":3,"arabic":"أَنَّا","translation":"that We","transliteration":"annā"},{"position":4,"arabic":"نَسُوقُ","translation":"drive","transliteration":"nasūqu"},{"position":5,"arabic":"ٱلْمَآءَ","translation":"water","transliteration":"l-māa"},{"position":6,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":7,"arabic":"ٱلْأَرْضِ","translation":"the land","transliteration":"l-arḍi"},{"position":8,"arabic":"ٱلْجُرُزِ","translation":"[the] barren","transliteration":"l-juruzi"},{"position":9,"arabic":"فَنُخْرِجُ","translation":"then We bring forth","transliteration":"fanukh'riju"},{"position":10,"arabic":"بِهِۦ","translation":"thereby","transliteration":"bihi"},{"position":11,"arabic":"زَرْعًۭا","translation":"crops","transliteration":"zarʿan"},{"position":12,"arabic":"تَأْكُلُ","translation":"eat","transliteration":"takulu"},{"position":13,"arabic":"مِنْهُ","translation":"from it","transliteration":"min'hu"},{"position":14,"arabic":"أَنْعَـٰمُهُمْ","translation":"their cattle","transliteration":"anʿāmuhum"},{"position":15,"arabic":"وَأَنفُسُهُمْ ۖ","translation":"and they themselves","transliteration":"wa-anfusuhum"},{"position":16,"arabic":"أَفَلَا","translation":"Then do not","transliteration":"afalā"},{"position":17,"arabic":"يُبْصِرُونَ","translation":"they see","transliteration":"yub'ṣirūna"}],"e3rab":"(أَوَلَمْ يَرَوْا) الهمزة حرف استفهام توبيخي والواو حرف استئناف ومضارع مجزوم بلم والواو فاعله والجملة مستأنفة لا محل لها.\r\n\r\n(أَنَّا) أن واسمها (نَسُوقُ) مضارع فاعله مستتر (الْماءَ) مفعول به والجملة الفعلية خبر أن والمصدر المؤول من أن وما بعدها مفعول يروا (إِلَى الْأَرْضِ) متعلقان بالفعل (الْجُرُزِ) صفة الأرض (فَنُخْرِجُ) الفاء حرف عطف ومضارع فاعله مستتر (بِهِ) متعلقان بالفعل (زَرْعاً) مفعول به والجملة معطوفة على ما قبلها (تَأْكُلُ) مضارع مرفوع (مِنْهُ) متعلقان بالفعل (أَنْعامُهُمْ) فاعل (وَأَنْفُسُهُمْ) معطوف على أنعامهم والجملة صفة زرعا.\r\n\r\n(أَفَلا) الهمزة حرف استفهام إنكاري والفاء حرف استئناف (لا) نافية (يُبْصِرُونَ) مضارع مرفوع والواو فاعله والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":32,"ayah":28,"words":[{"position":1,"arabic":"وَيَقُولُونَ","translation":"And they say","transliteration":"wayaqūlūna"},{"position":2,"arabic":"مَتَىٰ","translation":"When (will be)","transliteration":"matā"},{"position":3,"arabic":"هَـٰذَا","translation":"this","transliteration":"hādhā"},{"position":4,"arabic":"ٱلْفَتْحُ","translation":"decision","transliteration":"l-fatḥu"},{"position":5,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":6,"arabic":"كُنتُمْ","translation":"you are","transliteration":"kuntum"},{"position":7,"arabic":"صَـٰدِقِينَ","translation":"truthful","transliteration":"ṣādiqīna"}],"e3rab":"(وَيَقُولُونَ) الواو حرف استئناف ومضارع مرفوع بثبوت النون والواو فاعله والجملة مستأنفة لا محل لها (مَتى) اسم استفهام متعلق بمحذوف خبر مقدم (هذَا) مبتدأ مؤخر والجملة مقول القول (الْفَتْحُ) بدل من اسم الإشارة.\r\n\r\n(إِنْ) حرف شرط جازم (كُنْتُمْ صادِقِينَ) كان واسمها وخبرها والجملة ابتدائية لا محل لها وجواب الشرط محذوف.\r\n\r\n"},{"sura":32,"ayah":29,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"يَوْمَ","translation":"(On the) Day","transliteration":"yawma"},{"position":3,"arabic":"ٱلْفَتْحِ","translation":"(of) the Decision","transliteration":"l-fatḥi"},{"position":4,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":5,"arabic":"يَنفَعُ","translation":"will benefit","transliteration":"yanfaʿu"},{"position":6,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":7,"arabic":"كَفَرُوٓا۟","translation":"disbelieve","transliteration":"kafarū"},{"position":8,"arabic":"إِيمَـٰنُهُمْ","translation":"their belief","transliteration":"īmānuhum"},{"position":9,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":10,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":11,"arabic":"يُنظَرُونَ","translation":"will be granted respite","transliteration":"yunẓarūna"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة مستأنفة لا محل لها.\r\n\r\n(يَوْمَ الْفَتْحِ) ظرف زمان مضاف إلى الفتح (لا) نافية (يَنْفَعُ) مضارع مرفوع (الَّذِينَ) مفعول به مقدم (كَفَرُوا) ماض وفاعله والجملة صلة الذين (إِيمانُهُمْ) فاعل ينفع والواو حرف عطف (وَلا) نافية (هُمْ) مبتدأ (يُنْظَرُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة الفعلية خبر المبتدأ. والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":32,"ayah":30,"words":[{"position":1,"arabic":"فَأَعْرِضْ","translation":"So turn away","transliteration":"fa-aʿriḍ"},{"position":2,"arabic":"عَنْهُمْ","translation":"from them","transliteration":"ʿanhum"},{"position":3,"arabic":"وَٱنتَظِرْ","translation":"and wait","transliteration":"wa-intaẓir"},{"position":4,"arabic":"إِنَّهُم","translation":"Indeed, they","transliteration":"innahum"},{"position":5,"arabic":"مُّنتَظِرُونَ","translation":"(are) waiting","transliteration":"muntaẓirūna"}],"e3rab":"(فَأَعْرِضْ) الفاء الفصيحة وأمر فاعله مستتر (عَنْهُمْ) متعلقان بالفعل والجملة جواب شرط مقدر لا محل لها (وَانْتَظِرْ) معطوف على اعرض.\r\n\r\n(إِنَّهُمْ مُنْتَظِرُونَ) إن واسمها وخبرها والجملة الاسمية تعليل.\r\n\r\n"}]