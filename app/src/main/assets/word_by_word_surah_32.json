[{"sura":32,"ayah":1,"words":[{"position":1,"arabic":"الٓمٓ","translation":"Alif Lam Meem","transliteration":"alif-lam-meem"}],"e3rab":"«الم» حروف لا محل لها من الإعراب\r\n\r\n"},{"sura":32,"ayah":2,"words":[{"position":1,"arabic":"تَنزِيلُ","translation":"(The) revelation","transliteration":"tanzīlu"},{"position":2,"arabic":"ٱلْكِتَـٰبِ","translation":"(of) the Book","transliteration":"l-kitābi"},{"position":3,"arabic":"لَا","translation":"(there is) no","transliteration":"lā"},{"position":4,"arabic":"رَيْبَ","translation":"doubt","transliteration":"rayba"},{"position":5,"arabic":"فِيهِ","translation":"about it","transliteration":"fīhi"},{"position":6,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":7,"arabic":"رَّبِّ","translation":"(the) Lord","transliteration":"rabbi"},{"position":8,"arabic":"ٱلْعَـٰلَمِينَ","translation":"(of) the worlds","transliteration":"l-ʿālamīna"}],"e3rab":"(تَنْزِيلُ الْكِتابِ) مبتدأ مضاف إلى الكتاب (لا) نافية للجنس (رَيْبَ) اسمها المبني على الفتح (فِيهِ) خبر لا والجملة حال (مِنْ رَبِّ) خبر تنزيل (الْعالَمِينَ) مضاف إليه.\r\n\r\n"},{"sura":32,"ayah":3,"words":[{"position":1,"arabic":"أَمْ","translation":"Or","transliteration":"am"},{"position":2,"arabic":"يَقُولُونَ","translation":"(do) they say","transliteration":"yaqūlūna"},{"position":3,"arabic":"ٱفْتَرَىٰهُ ۚ","translation":"He invented it","transliteration":"if'tarāhu"},{"position":4,"arabic":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":5,"arabic":"هُوَ","translation":"it","transliteration":"huwa"},{"position":6,"arabic":"ٱلْحَقُّ","translation":"(is) the truth","transliteration":"l-ḥaqu"},{"position":7,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":8,"arabic":"رَّبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":9,"arabic":"لِتُنذِرَ","translation":"that you may warn","transliteration":"litundhira"},{"position":10,"arabic":"قَوْمًۭا","translation":"a people","transliteration":"qawman"},{"position":11,"arabic":"مَّآ","translation":"not","transliteration":"mā"},{"position":12,"arabic":"أَتَىٰهُم","translation":"has come to them","transliteration":"atāhum"},{"position":13,"arabic":"مِّن","translation":"any","transliteration":"min"},{"position":14,"arabic":"نَّذِيرٍۢ","translation":"warner","transliteration":"nadhīrin"},{"position":15,"arabic":"مِّن","translation":"before you","transliteration":"min"},{"position":16,"arabic":"قَبْلِكَ","translation":"before you","transliteration":"qablika"},{"position":17,"arabic":"لَعَلَّهُمْ","translation":"so that they may","transliteration":"laʿallahum"},{"position":18,"arabic":"يَهْتَدُونَ","translation":"be guided","transliteration":"yahtadūna"}],"e3rab":"(أَمْ) حرف عطف (يَقُولُونَ) مضارع مرفوع والواو فاعله والجملة مستأنفة لا محل لها.\r\n\r\n(افْتَراهُ) ماض ومفعوله والفاعل مستتر والجملة مقول القول.\r\n\r\n(بَلْ) حرف عطف وإضراب (هُوَ الْحَقُّ) مبتدأ وخبره والجملة مستأنفة لا محل لها (مِنْ رَبِّكَ) حال (لِتُنْذِرَ) مضارع منصوب بأن مضمرة بعد لام التعليل والفاعل مستتر (قَوْماً) مفعول به والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بمحذوف حال ثانية (ما أَتاهُمْ) ما نافية وماض ومفعوله (مِنْ) حرف جر زائد (نَذِيرٍ) مجرور لفظا مرفوع محلا فاعل أتاهم والجملة صفة قوما (مِنْ قَبْلِكَ) متعلقان بنذير (لَعَلَّهُمْ) لعل واسمها (يَهْتَدُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر لعل والجملة الاسمية تعليل.\r\n\r\n"},{"sura":32,"ayah":4,"words":[{"position":1,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"al-lahu"},{"position":2,"arabic":"ٱلَّذِى","translation":"(is) the One Who","transliteration":"alladhī"},{"position":3,"arabic":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":4,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":5,"arabic":"وَٱلْأَرْضَ","translation":"and the earth","transliteration":"wal-arḍa"},{"position":6,"arabic":"وَمَا","translation":"and whatever","transliteration":"wamā"},{"position":7,"arabic":"بَيْنَهُمَا","translation":"(is) between them","transliteration":"baynahumā"},{"position":8,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":9,"arabic":"سِتَّةِ","translation":"six","transliteration":"sittati"},{"position":10,"arabic":"أَيَّامٍۢ","translation":"periods","transliteration":"ayyāmin"},{"position":11,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":12,"arabic":"ٱسْتَوَىٰ","translation":"established Himself","transliteration":"is'tawā"},{"position":13,"arabic":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":14,"arabic":"ٱلْعَرْشِ ۖ","translation":"the Throne","transliteration":"l-ʿarshi"},{"position":15,"arabic":"مَا","translation":"Not","transliteration":"mā"},{"position":16,"arabic":"لَكُم","translation":"for you","transliteration":"lakum"},{"position":17,"arabic":"مِّن","translation":"besides Him","transliteration":"min"},{"position":18,"arabic":"دُونِهِۦ","translation":"besides Him","transliteration":"dūnihi"},{"position":19,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":20,"arabic":"وَلِىٍّۢ","translation":"protector","transliteration":"waliyyin"},{"position":21,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":22,"arabic":"شَفِيعٍ ۚ","translation":"any intercessor","transliteration":"shafīʿin"},{"position":23,"arabic":"أَفَلَا","translation":"Then will not","transliteration":"afalā"},{"position":24,"arabic":"تَتَذَكَّرُونَ","translation":"you take heed","transliteration":"tatadhakkarūna"}],"e3rab":"(اللَّهُ الَّذِي) لفظ الجلالة مبتدأ واسم الموصول خبره والجملة مستأنفة لا محل لها (خَلَقَ) ماض فاعله مستتر (السَّماواتِ) مفعول به (وَالْأَرْضَ) معطوف على السموات والجملة صلة.\r\n\r\n(وَ) الواو حرف عطف (ما) معطوف على السموات والأرض (بَيْنَهُما) ظرف مكان (فِي سِتَّةِ) متعلقان بخلق (أَيَّامٍ) مضاف إليه (ثُمَّ) حرف عطف (اسْتَوى) ماض فاعله مستتر (عَلَى الْعَرْشِ) متعلقان بالفعل والجملة معطوفة على ما قبلها. و(ما) نافية (لَكُمْ) خبر مقدم (مِنْ دُونِهِ) حال (مِنْ) حرف جر زائد (وَلِيٍّ) اسم مجرور لفظا مرفوع محلا مبتدأ مؤخر والجملة مستأنفة لا محل لها (وَ) الواو حرف عطف (لا) نافية (شَفِيعٍ) معطوف على ولي (أَفَلا تَتَذَكَّرُونَ) الهمزة حرف استفهام وتوبيخ والفاء حرف استئناف ولا نافية ومضارع مرفوع والواو فاعله والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":32,"ayah":5,"words":[{"position":1,"arabic":"يُدَبِّرُ","translation":"He regulates","transliteration":"yudabbiru"},{"position":2,"arabic":"ٱلْأَمْرَ","translation":"the affair","transliteration":"l-amra"},{"position":3,"arabic":"مِنَ","translation":"of","transliteration":"mina"},{"position":4,"arabic":"ٱلسَّمَآءِ","translation":"the heaven","transliteration":"l-samāi"},{"position":5,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":6,"arabic":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":7,"arabic":"ثُمَّ","translation":"then","transliteration":"thumma"},{"position":8,"arabic":"يَعْرُجُ","translation":"it will ascend","transliteration":"yaʿruju"},{"position":9,"arabic":"إِلَيْهِ","translation":"to Him","transliteration":"ilayhi"},{"position":10,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":11,"arabic":"يَوْمٍۢ","translation":"a Day","transliteration":"yawmin"},{"position":12,"arabic":"كَانَ","translation":"(the) measure of which is","transliteration":"kāna"},{"position":13,"arabic":"مِقْدَارُهُۥٓ","translation":"(the) measure of which is","transliteration":"miq'dāruhu"},{"position":14,"arabic":"أَلْفَ","translation":"a thousand","transliteration":"alfa"},{"position":15,"arabic":"سَنَةٍۢ","translation":"years","transliteration":"sanatin"},{"position":16,"arabic":"مِّمَّا","translation":"of what","transliteration":"mimmā"},{"position":17,"arabic":"تَعُدُّونَ","translation":"you count","transliteration":"taʿuddūna"}],"e3rab":"(يُدَبِّرُ) مضارع فاعله مستتر (الْأَمْرَ) مفعول به والجملة حال (مِنَ السَّماءِ) متعلقان بالفعل (إِلَى الْأَرْضِ) متعلقان بالفعل أيضا (ثُمَّ) حرف عطف (يَعْرُجُ) مضارع فاعله مستتر (إِلَيْهِ) متعلقان بالفعل (فِي يَوْمٍ) حال (كانَ مِقْدارُهُ) كان واسمها (أَلْفَ) خبرها المضاف (سَنَةٍ) مضاف إليه والجملة صفة يوم (مِمَّا) متعلقان بمحذوف صفة ألف (تَعُدُّونَ) مضارع مرفوع والواو فاعله والجملة صلة لا محل لها.\r\n\r\n"},{"sura":32,"ayah":6,"words":[{"position":1,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":2,"arabic":"عَـٰلِمُ","translation":"(is the) Knower","transliteration":"ʿālimu"},{"position":3,"arabic":"ٱلْغَيْبِ","translation":"(of) the hidden","transliteration":"l-ghaybi"},{"position":4,"arabic":"وَٱلشَّهَـٰدَةِ","translation":"and the witnessed","transliteration":"wal-shahādati"},{"position":5,"arabic":"ٱلْعَزِيزُ","translation":"the All-Mighty","transliteration":"l-ʿazīzu"},{"position":6,"arabic":"ٱلرَّحِيمُ","translation":"the Most Merciful","transliteration":"l-raḥīmu"}],"e3rab":"(ذلِكَ عالِمُ) مبتدأ وخبره والجملة مستأنفة لا محل لها (الْغَيْبِ) مضاف إليه (وَالشَّهادَةِ) معطوفة على الغيب (الْعَزِيزُ الرَّحِيمُ) خبران أيضا.\r\n\r\n"},{"sura":32,"ayah":7,"words":[{"position":1,"arabic":"ٱلَّذِىٓ","translation":"The One Who","transliteration":"alladhī"},{"position":2,"arabic":"أَحْسَنَ","translation":"made good","transliteration":"aḥsana"},{"position":3,"arabic":"كُلَّ","translation":"every","transliteration":"kulla"},{"position":4,"arabic":"شَىْءٍ","translation":"thing","transliteration":"shayin"},{"position":5,"arabic":"خَلَقَهُۥ ۖ","translation":"He created","transliteration":"khalaqahu"},{"position":6,"arabic":"وَبَدَأَ","translation":"and He began","transliteration":"wabada-a"},{"position":7,"arabic":"خَلْقَ","translation":"(the) creation","transliteration":"khalqa"},{"position":8,"arabic":"ٱلْإِنسَـٰنِ","translation":"(of) man","transliteration":"l-insāni"},{"position":9,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":10,"arabic":"طِينٍۢ","translation":"clay","transliteration":"ṭīnin"}],"e3rab":"(الَّذِي) الاسم الموصول خبر رابع (أَحْسَنَ) ماض فاعله مستتر والجملة صلة (كُلَّ شَيْءٍ) مفعول به مضاف إلى شيء (خَلَقَهُ) ماض ومفعوله والفاعل مستتر والجملة صفة شيء (وَبَدَأَ) الواو حرف عطف وماض معطوف على أحسن (خَلْقَ الْإِنْسانِ) مفعول به مضاف إلى الإنسان (مِنْ طِينٍ) متعلقان بخلق.\r\n\r\n"},{"sura":32,"ayah":8,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"جَعَلَ","translation":"He made","transliteration":"jaʿala"},{"position":3,"arabic":"نَسْلَهُۥ","translation":"his progeny","transliteration":"naslahu"},{"position":4,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":5,"arabic":"سُلَـٰلَةٍۢ","translation":"an extract","transliteration":"sulālatin"},{"position":6,"arabic":"مِّن","translation":"of","transliteration":"min"},{"position":7,"arabic":"مَّآءٍۢ","translation":"water","transliteration":"māin"},{"position":8,"arabic":"مَّهِينٍۢ","translation":"despised","transliteration":"mahīnin"}],"e3rab":"(ثُمَّ) حرف عطف (جَعَلَ) ماض فاعله مستتر (نَسْلَهُ) مفعول به والجملة معطوفة على ما قبلها.\r\n\r\n(مِنْ سُلالَةٍ) متعلقان بالفعل (مِنْ ماءٍ) صفة سلالة (مَهِينٍ) صفة ماء.\r\n\r\n"},{"sura":32,"ayah":9,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"سَوَّىٰهُ","translation":"He fashioned him","transliteration":"sawwāhu"},{"position":3,"arabic":"وَنَفَخَ","translation":"and breathed","transliteration":"wanafakha"},{"position":4,"arabic":"فِيهِ","translation":"into him","transliteration":"fīhi"},{"position":5,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":6,"arabic":"رُّوحِهِۦ ۖ","translation":"His spirit","transliteration":"rūḥihi"},{"position":7,"arabic":"وَجَعَلَ","translation":"and made","transliteration":"wajaʿala"},{"position":8,"arabic":"لَكُمُ","translation":"for you","transliteration":"lakumu"},{"position":9,"arabic":"ٱلسَّمْعَ","translation":"the hearing","transliteration":"l-samʿa"},{"position":10,"arabic":"وَٱلْأَبْصَـٰرَ","translation":"and the sight","transliteration":"wal-abṣāra"},{"position":11,"arabic":"وَٱلْأَفْـِٔدَةَ ۚ","translation":"and feelings","transliteration":"wal-afidata"},{"position":12,"arabic":"قَلِيلًۭا","translation":"little","transliteration":"qalīlan"},{"position":13,"arabic":"مَّا","translation":"[what]","transliteration":"mā"},{"position":14,"arabic":"تَشْكُرُونَ","translation":"thanks you give","transliteration":"tashkurūna"}],"e3rab":"(ثُمَّ) حرف عطف (سَوَّاهُ) ماض ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها والواو حرف عطف (نَفَخَ) معطوف على سواه (فِيهِ) متعلقان بالفعل (مِنْ رُوحِهِ) متعلقان بالفعل أيضا (وَجَعَلَ) معطوف على نفخ (لَكُمُ) متعلقان بالفعل (السَّمْعَ) مفعول به (وَالْأَبْصارَ وَالْأَفْئِدَةَ) معطوفان على السمع (قَلِيلًا) صفة مفعول مطلق (ما) زائدة (تَشْكُرُونَ) مضارع مرفوع والواو فاعله والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":32,"ayah":10,"words":[{"position":1,"arabic":"وَقَالُوٓا۟","translation":"And they say","transliteration":"waqālū"},{"position":2,"arabic":"أَءِذَا","translation":"Is (it) when","transliteration":"a-idhā"},{"position":3,"arabic":"ضَلَلْنَا","translation":"we are lost","transliteration":"ḍalalnā"},{"position":4,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":5,"arabic":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":6,"arabic":"أَءِنَّا","translation":"will we","transliteration":"a-innā"},{"position":7,"arabic":"لَفِى","translation":"certainly be in","transliteration":"lafī"},{"position":8,"arabic":"خَلْقٍۢ","translation":"a creation","transliteration":"khalqin"},{"position":9,"arabic":"جَدِيدٍۭ ۚ","translation":"new","transliteration":"jadīdin"},{"position":10,"arabic":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":11,"arabic":"هُم","translation":"they","transliteration":"hum"},{"position":12,"arabic":"بِلِقَآءِ","translation":"in (the) meeting","transliteration":"biliqāi"},{"position":13,"arabic":"رَبِّهِمْ","translation":"(of) their Lord","transliteration":"rabbihim"},{"position":14,"arabic":"كَـٰفِرُونَ","translation":"(are) disbelievers","transliteration":"kāfirūna"}],"e3rab":"(وَقالُوا) الواو حرف استئناف وماض وفاعله والجملة مستأنفة (أَإِذا ضَلَلْنا) الهمزة للاستفهام وإذا ظرفية شرطية غير جازمة وماض وفاعله والجملة في محل جر بالإضافة (فِي الْأَرْضِ) متعلقان بالفعل (أَإِنَّا) الهمزة حرف استفهام وإن واسمها (لَفِي) اللام المزحلقة (في خَلْقٍ) متعلقان بمحذوف خبر إن (جَدِيدٍ) صفة خلق والجملة مؤكدة لما قبلها (بَلْ) حرف إضراب (هُمْ) مبتدأ (بِلِقاءِ) متعلقان بالخبر (رَبِّهِمْ) مضاف إليه والجملة الاسمية مستأنفة لا محل لها (كافِرُونَ) خبر.\r\n\r\n"},{"sura":32,"ayah":11,"words":[{"position":1,"arabic":"۞ قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"يَتَوَفَّىٰكُم","translation":"Will take your soul","transliteration":"yatawaffākum"},{"position":3,"arabic":"مَّلَكُ","translation":"(the) Angel","transliteration":"malaku"},{"position":4,"arabic":"ٱلْمَوْتِ","translation":"(of) the death","transliteration":"l-mawti"},{"position":5,"arabic":"ٱلَّذِى","translation":"the one who","transliteration":"alladhī"},{"position":6,"arabic":"وُكِّلَ","translation":"has been put in charge","transliteration":"wukkila"},{"position":7,"arabic":"بِكُمْ","translation":"of you","transliteration":"bikum"},{"position":8,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":9,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":10,"arabic":"رَبِّكُمْ","translation":"your Lord","transliteration":"rabbikum"},{"position":11,"arabic":"تُرْجَعُونَ","translation":"you will be returned","transliteration":"tur'jaʿūna"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة مستأنفة لا محل لها.\r\n\r\n(يَتَوَفَّاكُمْ) مضارع ومفعوله (مَلَكُ الْمَوْتِ) فاعل مضاف إلى الموت والجملة مقول القول (الَّذِي) صفة ملك (وُكِّلَ) ماض مبني للمجهول ونائب الفاعل مستتر (بِكُمْ) متعلقان بالفعل والجملة صلة (ثُمَّ) حرف عطف (إِلى رَبِّكُمْ) متعلقان بما بعدهما (تُرْجَعُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":32,"ayah":12,"words":[{"position":1,"arabic":"وَلَوْ","translation":"And if","transliteration":"walaw"},{"position":2,"arabic":"تَرَىٰٓ","translation":"you (could) see","transliteration":"tarā"},{"position":3,"arabic":"إِذِ","translation":"when","transliteration":"idhi"},{"position":4,"arabic":"ٱلْمُجْرِمُونَ","translation":"the criminals","transliteration":"l-muj'rimūna"},{"position":5,"arabic":"نَاكِسُوا۟","translation":"(will) hang","transliteration":"nākisū"},{"position":6,"arabic":"رُءُوسِهِمْ","translation":"their heads","transliteration":"ruūsihim"},{"position":7,"arabic":"عِندَ","translation":"before","transliteration":"ʿinda"},{"position":8,"arabic":"رَبِّهِمْ","translation":"their Lord","transliteration":"rabbihim"},{"position":9,"arabic":"رَبَّنَآ","translation":"Our Lord","transliteration":"rabbanā"},{"position":10,"arabic":"أَبْصَرْنَا","translation":"we have seen","transliteration":"abṣarnā"},{"position":11,"arabic":"وَسَمِعْنَا","translation":"and we have heard","transliteration":"wasamiʿ'nā"},{"position":12,"arabic":"فَٱرْجِعْنَا","translation":"so return us","transliteration":"fa-ir'jiʿ'nā"},{"position":13,"arabic":"نَعْمَلْ","translation":"we will do","transliteration":"naʿmal"},{"position":14,"arabic":"صَـٰلِحًا","translation":"righteous (deeds)","transliteration":"ṣāliḥan"},{"position":15,"arabic":"إِنَّا","translation":"Indeed, we","transliteration":"innā"},{"position":16,"arabic":"مُوقِنُونَ","translation":"(are now) certain","transliteration":"mūqinūna"}],"e3rab":"(وَلَوْ) الواو حرف استئناف (لَوْ) شرطية غير جازمة (تَرى) مضارع فاعله مستتر والجملة ابتدائية لا محل لها (إِذِ) ظرف زمان (الْمُجْرِمُونَ) مبتدأ (ناكِسُوا رُؤُسِهِمْ) خبر مضاف إلى رؤوسهم والجملة في محل جر بالإضافة (عِنْدَ) ظرف مكان (رَبِّهِمْ) مضاف إليه وجواب لو محذوف تقديره لرأيت أمرا فظيعا.\r\n\r\n(رَبَّنا) منادى مضاف (أَبْصَرْنا) ماض وفاعله والجملة الفعلية كالجملة الندائية مقول قول محذوف (وَسَمِعْنا) معطوف على أبصرنا (فَارْجِعْنا) الفاء الفصيحة وفعل دعاء ومفعوله والجملة 