[{"sura":114,"ayah":1,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"أَعُوذُ","translation":"I seek refuge","transliteration":"aʿūdhu"},{"position":3,"arabic":"بِرَبِّ","translation":"in (the) Lord","transliteration":"birabbi"},{"position":4,"arabic":"ٱلنَّاسِ","translation":"(of) mankind","transliteration":"l-nāsi"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة ابتدائية لا محل لها (أَعُوذُ) مضارع فاعله مستتر (بِرَبِّ) متعلقان بالفعل (النَّاسِ) مضاف إليه والجملة مقول القول.\r\n\r\n"},{"sura":114,"ayah":2,"words":[{"position":1,"arabic":"مَلِكِ","translation":"(The) King","transliteration":"maliki"},{"position":2,"arabic":"ٱلنَّاسِ","translation":"(of) mankind","transliteration":"l-nāsi"}],"e3rab":"(مَلِكِ) بدل من رب (النَّاسِ) مضاف إليه.\r\n\r\n"},{"sura":114,"ayah":3,"words":[{"position":1,"arabic":"إِلَـٰهِ","translation":"(The) God","transliteration":"ilāhi"},{"position":2,"arabic":"ٱلنَّاسِ","translation":"(of) mankind","transliteration":"l-nāsi"}],"e3rab":"(إِلهِ) بدل من رب (النَّاسِ) مضاف إليه.\r\n\r\n"},{"sura":114,"ayah":4,"words":[{"position":1,"arabic":"مِن","translation":"From","transliteration":"min"},{"position":2,"arabic":"شَرِّ","translation":"(the) evil","transliteration":"sharri"},{"position":3,"arabic":"ٱلْوَسْوَاسِ","translation":"(of) the whisperer","transliteration":"l-waswāsi"},{"position":4,"arabic":"ٱلْخَنَّاسِ","translation":"the one who withdraws","transliteration":"l-khanāsi"}],"e3rab":"(مِنْ شَرِّ) الجار والمجرور متعلقان بأعوذ (الْوَسْواسِ) مضاف إليه (الْخَنَّاسِ) بدل من الوسواس.\r\n\r\n"},{"sura":114,"ayah":5,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"The one who","transliteration":"alladhī"},{"position":2,"arabic":"يُوَسْوِسُ","translation":"whispers","transliteration":"yuwaswisu"},{"position":3,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":4,"arabic":"صُدُورِ","translation":"(the) breasts","transliteration":"ṣudūri"},{"position":5,"arabic":"ٱلنَّاسِ","translation":"(of) mankind","transliteration":"l-nāsi"}],"e3rab":"(الَّذِي) اسم موصول صفة الوسواس (يُوَسْوِسُ) مضارع فاعله مستتر والجملة صلة (فِي صُدُورِ) متعلقان بالفعل (النَّاسِ) مضاف إليه.\r\n\r\n"},{"sura":114,"ayah":6,"words":[{"position":1,"arabic":"مِنَ","translation":"From","transliteration":"mina"},{"position":2,"arabic":"ٱلْجِنَّةِ","translation":"the jinn","transliteration":"l-jinati"},{"position":3,"arabic":"وَٱلنَّاسِ","translation":"and men","transliteration":"wal-nāsi"}],"e3rab":"(مِنَ الْجِنَّةِ) الجار والمجرور متعلقان بمحذوف حال من فاعل يوسوس (وَالنَّاسِ) معطوف على الجنة.\r\n\r\nتم بعون اللّه تعالى هذا الكتاب والحمد للّه رب العالمين.\r\n\r\n"}]