[{"sura":94,"ayah":1,"words":[{"position":1,"arabic":"أَلَمْ","translation":"Have not","transliteration":"alam"},{"position":2,"arabic":"نَشْرَحْ","translation":"We expanded","transliteration":"nashraḥ"},{"position":3,"arabic":"لَكَ","translation":"for you","transliteration":"laka"},{"position":4,"arabic":"صَدْرَكَ","translation":"your breast","transliteration":"ṣadraka"}],"e3rab":"(أَلَمْ نَشْرَحْ) الهمزة حرف استفهام وتقرير ومضارع مجزوم بلم والفاعل مستتر (لَكَ) متعلقان بالفعل (صَدْرَكَ) مفعول به والجملة ابتدائية لا محل لها.\r\n\r\n"},{"sura":94,"ayah":2,"words":[{"position":1,"arabic":"وَوَضَعْنَا","translation":"And We removed","transliteration":"wawaḍaʿnā"},{"position":2,"arabic":"عَنكَ","translation":"from you","transliteration":"ʿanka"},{"position":3,"arabic":"وِزْرَكَ","translation":"your burden","transliteration":"wiz'raka"}],"e3rab":"(وَوَضَعْنا) ماض وفاعله (عَنْكَ) متعلقان بالفعل (وِزْرَكَ) مفعول به. والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":94,"ayah":3,"words":[{"position":1,"arabic":"ٱلَّذِىٓ","translation":"Which","transliteration":"alladhī"},{"position":2,"arabic":"أَنقَضَ","translation":"weighed upon","transliteration":"anqaḍa"},{"position":3,"arabic":"ظَهْرَكَ","translation":"your back","transliteration":"ẓahraka"}],"e3rab":"(الَّذِي) اسم موصول صفة وزرك (أَنْقَضَ) ماض فاعله مستتر (ظَهْرَكَ) مفعول به والجملة صلة.\r\n\r\n"},{"sura":94,"ayah":4,"words":[{"position":1,"arabic":"وَرَفَعْنَا","translation":"And We raised high","transliteration":"warafaʿnā"},{"position":2,"arabic":"لَكَ","translation":"for you","transliteration":"laka"},{"position":3,"arabic":"ذِكْرَكَ","translation":"your reputation","transliteration":"dhik'raka"}],"e3rab":"(وَرَفَعْنا) ماض وفاعله (لَكَ) متعلقان بالفعل (ذِكْرَكَ) مفعول به. والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":94,"ayah":5,"words":[{"position":1,"arabic":"فَإِنَّ","translation":"So indeed","transliteration":"fa-inna"},{"position":2,"arabic":"مَعَ","translation":"with","transliteration":"maʿa"},{"position":3,"arabic":"ٱلْعُسْرِ","translation":"the hardship","transliteration":"l-ʿus'ri"},{"position":4,"arabic":"يُسْرًا","translation":"(is) ease","transliteration":"yus'ran"}],"e3rab":"(فَإِنَّ) الفاء حرف استئناف و(إن) حرف مشبه بالفعل (مَعَ) ظرف مكان متعلق بمحذوف خبر إن المقدم (الْعُسْرِ) مضاف إليه (يُسْراً) اسم إن المؤخر والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":94,"ayah":6,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"مَعَ","translation":"with","transliteration":"maʿa"},{"position":3,"arabic":"ٱلْعُسْرِ","translation":"the hardship","transliteration":"l-ʿus'ri"},{"position":4,"arabic":"يُسْرًۭا","translation":"(is) ease","transliteration":"yus'ran"}],"e3rab":"توكيد للآية السابقة.\r\n\r\n"},{"sura":94,"ayah":7,"words":[{"position":1,"arabic":"فَإِذَا","translation":"So when","transliteration":"fa-idhā"},{"position":2,"arabic":"فَرَغْتَ","translation":"you have finished","transliteration":"faraghta"},{"position":3,"arabic":"فَٱنصَبْ","translation":"then labor hard","transliteration":"fa-inṣab"}],"e3rab":"(فَإِذا) الفاء حرف استئناف (إذا) ظرفية شرطية غير جازمة (فَرَغْتَ) ماض وفاعله والجملة في محل جر بالإضافة (فَانْصَبْ) الفاء رابطة وأمر فاعله مستتر والجملة جواب الشرط لا محل لها وجملة إذا.. مستأنفة.\r\n\r\n"},{"sura":94,"ayah":8,"words":[{"position":1,"arabic":"وَإِلَىٰ","translation":"And to","transliteration":"wa-ilā"},{"position":2,"arabic":"رَبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":3,"arabic":"فَٱرْغَب","translation":"turn your attention","transliteration":"fa-ir'ghab"}],"e3rab":"(وَإِلى رَبِّكَ) جار ومجرور متعلقان بما بعدهما (فَارْغَبْ) الفاء زائدة وأمر فاعله مستتر والجملة معطوفة على ما قبلها.\r\n\r\n"}]