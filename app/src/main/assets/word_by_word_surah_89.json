":"the earth","transliteration":"l-arḍu"},{"position":5,"arabic":"دَكًّۭا","translation":"pounded","transliteration":"dakkan"},{"position":6,"arabic":"دَكًّۭا","translation":"(and) crushed","transliteration":"dakkan"}],"e3rab":"(كَلَّا) حرف ردع وزجر (إِذا) ظرفية شرطية غير جازمة (دُكَّتِ) ماض مبني للمجهول (الْأَرْضُ) نائب فاعل والجملة في محل جر بالإضافة (دَكًّا) مفعول مطلق (دَكًّا) مفعول مطلق توكيد لما قبله.\r\n\r\n"},{"sura":89,"ayah":22,"words":[{"position":1,"arabic":"وَجَآءَ","translation":"And comes","transliteration":"wajāa"},{"position":2,"arabic":"رَبُّكَ","translation":"your Lord","transliteration":"rabbuka"},{"position":3,"arabic":"وَٱلْمَلَكُ","translation":"and the Angels","transliteration":"wal-malaku"},{"position":4,"arabic":"صَفًّۭا","translation":"rank","transliteration":"ṣaffan"},{"position":5,"arabic":"صَفًّۭا","translation":"(upon) rank","transliteration":"ṣaffan"}],"e3rab":"(وَجاءَ رَبُّكَ) ماض وفاعله والجملة معطوفة على قبلها (وَالْمَلَكُ) معطوف على ربك (صَفًّا صَفًّا) حالان.\r\n\r\n"},{"sura":89,"ayah":23,"words":[{"position":1,"arabic":"وَجِا۟ىٓءَ","translation":"And is brought","transliteration":"wajīa"},{"position":2,"arabic":"يَوْمَئِذٍۭ","translation":"that Day","transliteration":"yawma-idhin"},{"position":3,"arabic":"بِجَهَنَّمَ ۚ","translation":"Hell","transliteration":"bijahannama"},{"position":4,"arabic":"يَوْمَئِذٍۢ","translation":"That Day","transliteration":"yawma-idhin"},{"position":5,"arabic":"يَتَذَكَّرُ","translation":"will remember","transliteration":"yatadhakkaru"},{"position":6,"arabic":"ٱلْإِنسَـٰنُ","translation":"man","transliteration":"l-insānu"},{"position":7,"arabic":"وَأَنَّىٰ","translation":"but how","transliteration":"wa-annā"},{"position":8,"arabic":"لَهُ","translation":"(will be) for him","transliteration":"lahu"},{"position":9,"arabic":"ٱلذِّكْرَىٰ","translation":"the remembrance","transliteration":"l-dhik'rā"}],"e3rab":"(وَجِي ءَ) ماض مبني للمجهول (يَوْمَئِذٍ) ظرف زمان مضاف إلى مثله (بِجَهَنَّمَ) متعلقان بالفعل وهما في موضع نائب الفاعل والجملة معطوفة على ما قبلها.\r\n\r\n(يَوْمَئِذٍ) ظرف زمان مضاف إلى مثله (يَتَذَكَّرُ الْإِنْسانُ) مضارع وفاعله والجملة الفعلية جواب الشرط لا محل لها، (وَ) الواو حرف استئناف (أَنَّى) اسم استفهام في محل رفع خبر مقدم (لَهُ) متعلقان بالخبر المحذوف (الذِّكْرى) مبتدأ مؤخر، والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"},{"sura":89,"ayah":24,"words":[{"position":1,"arabic":"يَقُولُ","translation":"He will say","transliteration":"yaqūlu"},{"position":2,"arabic":"يَـٰلَيْتَنِى","translation":"O I wish","transliteration":"yālaytanī"},{"position":3,"arabic":"قَدَّمْتُ","translation":"I had sent forth","transliteration":"qaddamtu"},{"position":4,"arabic":"لِحَيَاتِى","translation":"for my life","transliteration":"liḥayātī"}],"e3rab":"(يَقُولُ) مضارع فاعله مستتر والجملة مستأنفة لا محل لها (يا) حرف تنبيه (لَيْتَنِي) حرف مشبه بالفعل والنون للوقاية والياء اسمها (قَدَّمْتُ) ماض وفاعله والجملة الفعلية خبر ليت والجملة الاسمية مقول القول (لِحَياتِي) متعلقان بالفعل.\r\n\r\n"},{"sura":89,"ayah":25,"words":[{"position":1,"arabic":"فَيَوْمَئِذٍۢ","translation":"So that Day","transliteration":"fayawma-idhin"},{"position":2,"arabic":"لَّا","translation":"not","transliteration":"lā"},{"position":3,"arabic":"يُعَذِّبُ","translation":"will punish","transliteration":"yuʿadhibu"},{"position":4,"arabic":"عَذَابَهُۥٓ","translation":"(as) His punishment","transliteration":"ʿadhābahu"},{"position":5,"arabic":"أَحَدٌۭ","translation":"anyone","transliteration":"aḥadun"}],"e3rab":"(فَيَوْمَئِذٍ) الفاء حرف استئناف ويومئذ ظرف مضاف إلى مثله (لا) نافية (يُعَذِّبُ) مضارع (عَذابَهُ) مفعول به (أَحَدٌ) فاعل والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":89,"ayah":26,"words":[{"position":1,"arabic":"وَلَا","translation":"And not","transliteration":"walā"},{"position":2,"arabic":"يُوثِقُ","translation":"will bind","transliteration":"yūthiqu"},{"position":3,"arabic":"وَثَاقَهُۥٓ","translation":"(as) His binding","transliteration":"wathāqahu"},{"position":4,"arabic":"أَحَدٌۭ","translation":"anyone","transliteration":"aḥadun"}],"e3rab":"الجملة معطوفة على ما قبلها والإعراب واضح.\r\n\r\n"},{"sura":89,"ayah":27,"words":[{"position":1,"arabic":"يَـٰٓأَيَّتُهَا","translation":"O","transliteration":"yāayyatuhā"},{"position":2,"arabic":"ٱلنَّفْسُ","translation":"soul","transliteration":"l-nafsu"},{"position":3,"arabic":"ٱلْمُطْمَئِنَّةُ","translation":"who is satisfied","transliteration":"l-muṭ'ma-inatu"}],"e3rab":"(يا أَيَّتُهَا) يا حرف نداء ومنادى نكرة مقصودة وها للتنبيه (النَّفْسُ) بدل (الْمُطْمَئِنَّةُ) صفة وجملة النداء مقول قول محذوف.\r\n\r\n"},{"sura":89,"ayah":28,"words":[{"position":1,"arabic":"ٱرْجِعِىٓ","translation":"Return","transliteration":"ir'jiʿī"},{"position":2,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":3,"arabic":"رَبِّكِ","translation":"your Lord","transliteration":"rabbiki"},{"position":4,"arabic":"رَاضِيَةًۭ","translation":"well pleased","transliteration":"rāḍiyatan"},{"position":5,"arabic":"مَّرْضِيَّةًۭ","translation":"and pleasing","transliteration":"marḍiyyatan"}],"e3rab":"(ارْجِعِي) أمر مبني على حذف النون والياء فاعل (إِلى رَبِّكِ) متعلقان بالفعل (راضِيَةً مَرْضِيَّةً) حالان والجملة مقول قول محذوف أيضا.\r\n\r\n"},{"sura":89,"ayah":29,"words":[{"position":1,"arabic":"فَٱدْخُلِى","translation":"So enter","transliteration":"fa-ud'khulī"},{"position":2,"arabic":"فِى","translation":"among","transliteration":"fī"},{"position":3,"arabic":"عِبَـٰدِى","translation":"My slaves","transliteration":"ʿibādī"}],"e3rab":"(فَادْخُلِي) أمر مبني على حذف النون والياء فاعل (فِي عِبادِي) متعلقان بالفعل والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":89,"ayah":30,"words":[{"position":1,"arabic":"وَٱدْخُلِى","translation":"And enter","transliteration":"wa-ud'khulī"},{"position":2,"arabic":"جَنَّتِى","translation":"My Paradise","transliteration":"jannatī"}],"e3rab":"(وَادْخُلِي) أمر وفاعله (جَنَّتِي) مفعول به والجملة معطوفة على ما قبلها.\r\n\r\n"}]