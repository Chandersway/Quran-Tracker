[{"sura":102,"ayah":1,"words":[{"position":1,"arabic":"أَلْهَىٰكُمُ","translation":"Diverts you","transliteration":"alhākumu"},{"position":2,"arabic":"ٱلتَّكَاثُرُ","translation":"the competition to increase","transliteration":"l-takāthuru"}],"e3rab":"«أَلْهاكُمُ» ماض ومفعوله «التَّكاثُرُ» فاعل والجملة ابتدائية لا محل لها.\r\n\r\n"},{"sura":102,"ayah":2,"words":[{"position":1,"arabic":"حَتَّىٰ","translation":"Until","transliteration":"ḥattā"},{"position":2,"arabic":"زُرْتُمُ","translation":"you visit","transliteration":"zur'tumu"},{"position":3,"arabic":"ٱلْمَقَابِرَ","translation":"the graves","transliteration":"l-maqābira"}],"e3rab":"(حَتَّى) حرف غاية وجر (زُرْتُمُ) ماض وفاعله (الْمَقابِرَ) مفعول به والمصدر المؤول من أن المضمرة بعد حتى وما بعدها في محل جر بحتى والجار والمجرور متعلقان بالفعل قبلهما.\r\n\r\n"},{"sura":102,"ayah":3,"words":[{"position":1,"arabic":"كَلَّا","translation":"Nay","transliteration":"kallā"},{"position":2,"arabic":"سَوْفَ","translation":"Soon","transliteration":"sawfa"},{"position":3,"arabic":"تَعْلَمُونَ","translation":"you will know","transliteration":"taʿlamūna"}],"e3rab":"(كَلَّا سَوْفَ) حرف ردع وزجر وسوف للاستقبال (تَعْلَمُونَ) مضارع مرفوع والواو فاعله والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":102,"ayah":4,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"كَلَّا","translation":"nay","transliteration":"kallā"},{"position":3,"arabic":"سَوْفَ","translation":"Soon","transliteration":"sawfa"},{"position":4,"arabic":"تَعْلَمُونَ","translation":"you will know","transliteration":"taʿlamūna"}],"e3rab":"معطوفة على ما قبلها.\r\n\r\n"},{"sura":102,"ayah":5,"words":[{"position":1,"arabic":"كَلَّا","translation":"Nay","transliteration":"kallā"},{"position":2,"arabic":"لَوْ","translation":"If","transliteration":"law"},{"position":3,"arabic":"تَعْلَمُونَ","translation":"you know","transliteration":"taʿlamūna"},{"position":4,"arabic":"عِلْمَ","translation":"(with) a knowledge","transliteration":"ʿil'ma"},{"position":5,"arabic":"ٱلْيَقِينِ","translation":"(of) certainty","transliteration":"l-yaqīni"}],"e3rab":"(كَلَّا) حرف ردع وزجر (لَوْ) حرف شرط غير جازم (تَعْلَمُونَ) مضارع مرفوع والواو فاعله (عِلْمَ الْيَقِينِ) مفعول به مضاف إلى اليقين والجملة ابتدائية لا محل لها.\r\n\r\n"},{"sura":102,"ayah":6,"words":[{"position":1,"arabic":"لَتَرَوُنَّ","translation":"Surely you will see","transliteration":"latarawunna"},{"position":2,"arabic":"ٱلْجَحِيمَ","translation":"the Hellfire","transliteration":"l-jaḥīma"}],"e3rab":"(لَتَرَوُنَّ) اللام واقعة في جواب قسم محذوف ومضارع مرفوع بثبوت النون المحذوفة لتوالي الأمثال والواو فاعله (الْجَحِيمَ) مفعول به والجملة جواب للقسم المحذوف لا محل لها.\r\n\r\n"},{"sura":102,"ayah":7,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"لَتَرَوُنَّهَا","translation":"surely you will see it","transliteration":"latarawunnahā"},{"position":3,"arabic":"عَيْنَ","translation":"(with the) eye","transliteration":"ʿayna"},{"position":4,"arabic":"ٱلْيَقِينِ","translation":"(of) certainty","transliteration":"l-yaqīni"}],"e3rab":"(ثُمَّ) حرف عطف (لَتَرَوُنَّها) اللام واقعة في جواب قسم محذوف ومضارع مرفوع بثبوت النون المحذوفة لتوالي الأمثال والواو فاعله وها مفعول به (عَيْنَ الْيَقِينِ) عين صفة مفعول مطلق محذوف أي رؤية عين وهو مضاف إلى اليقين والجملة جواب للقسم المحذوف لا محل لها.\r\n\r\n"},{"sura":102,"ayah":8,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"لَتُسْـَٔلُنَّ","translation":"surely you will be asked","transliteration":"latus'alunna"},{"position":3,"arabic":"يَوْمَئِذٍ","translation":"that Day","transliteration":"yawma-idhin"},{"position":4,"arabic":"عَنِ","translation":"about","transliteration":"ʿani"},{"position":5,"arabic":"ٱلنَّعِيمِ","translation":"the pleasures","transliteration":"l-naʿīmi"}],"e3rab":"(ثُمَّ) حرف عطف (لَتُسْئَلُنَّ) اللام واقعة في جواب قسم محذوف ومضارع مرفوع بثبوت النون المحذوفة والواو المحذوفة لالتقاء الساكنين فاعله والنون نون التوكيد الثقيلة والجملة معطوفة على ما قبلها (يَوْمَئِذٍ) ظرف أضيف إلى مثله (عَنِ النَّعِيمِ) متعلقان بالفعل.\r\n\r\n"}]