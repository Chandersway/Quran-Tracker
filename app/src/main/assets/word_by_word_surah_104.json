[{"sura":104,"ayah":1,"words":[{"position":1,"arabic":"وَيْلٌۭ","translation":"Woe","transliteration":"waylun"},{"position":2,"arabic":"لِّكُلِّ","translation":"to every","transliteration":"likulli"},{"position":3,"arabic":"هُمَزَةٍۢ","translation":"slanderer","transliteration":"humazatin"},{"position":4,"arabic":"لُّمَزَةٍ","translation":"backbiter","transliteration":"lumazatin"}],"e3rab":"(وَيْلٌ) مبتدأ مرفوع (لِكُلِّ) خبره (هُمَزَةٍ) مضاف إليه (لُمَزَةٍ) بدل منه والجملة ابتدائية لا محل لها.\r\n\r\n"},{"sura":104,"ayah":2,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"The one who","transliteration":"alladhī"},{"position":2,"arabic":"جَمَعَ","translation":"collects","transliteration":"jamaʿa"},{"position":3,"arabic":"مَالًۭا","translation":"wealth","transliteration":"mālan"},{"position":4,"arabic":"وَعَدَّدَهُۥ","translation":"and counts it","transliteration":"waʿaddadahu"}],"e3rab":"(الَّذِي) اسم موصول بدل كل من كل (جَمَعَ) ماض فاعله مستتر (مالًا) مفعول به والجملة صلة (وَعَدَّدَهُ) معطوف على ما قبله.\r\n\r\n"},{"sura":104,"ayah":3,"words":[{"position":1,"arabic":"يَحْسَبُ","translation":"Thinking","transliteration":"yaḥsabu"},{"position":2,"arabic":"أَنَّ","translation":"that","transliteration":"anna"},{"position":3,"arabic":"مَالَهُۥٓ","translation":"his wealth","transliteration":"mālahu"},{"position":4,"arabic":"أَخْلَدَهُۥ","translation":"will make him immortal","transliteration":"akhladahu"}],"e3rab":"(يَحْسَبُ) مضارع فاعله مستتر (أَنَّ مالَهُ) أن واسمها (أَخْلَدَهُ) ماض ومفعوله والفاعل مستتر والجملة خبر أن والمصدر المؤول من أن وما بعدها سد مسد مفعولي يحسب وجملة يحسب.. حال.\r\n\r\n"},{"sura":104,"ayah":4,"words":[{"position":1,"arabic":"كَلَّا ۖ","translation":"Nay","transliteration":"kallā"},{"position":2,"arabic":"لَيُنۢبَذَنَّ","translation":"Surely he will be thrown","transliteration":"layunbadhanna"},{"position":3,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":4,"arabic":"ٱلْحُطَمَةِ","translation":"the Crusher","transliteration":"l-ḥuṭamati"}],"e3rab":"(كَلَّا) حرف ردع وزجر (لَيُنْبَذَنَّ) اللام واقعة في جواب قسم محذوف ومضارع مبني للمجهول مبني على الفتح لاتصاله بنون التوكيد الثقيلة ونائب الفاعل مستتر والجملة جواب القسم لا محل لها (فِي الْحُطَمَةِ) متعلقان بما قبلهما.\r\n\r\n"},{"sura":104,"ayah":5,"words":[{"position":1,"arabic":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"arabic":"أَدْرَىٰكَ","translation":"will make you know","transliteration":"adrāka"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"ٱلْحُطَمَةُ","translation":"the Crusher (is)","transliteration":"l-ḥuṭamatu"}],"e3rab":"انظر سورة القارعة الآية رقم - 3 - .\r\n\r\n"},{"sura":104,"ayah":6,"words":[{"position":1,"arabic":"نَارُ","translation":"A Fire","transliteration":"nāru"},{"position":2,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":3,"arabic":"ٱلْمُوقَدَةُ","translation":"kindled","transliteration":"l-mūqadatu"}],"e3rab":"(نارُ اللَّهِ) خبر لمبتدأ محذوف ولفظ الجلالة مضاف إليه (الْمُوقَدَةُ) صفة نار والجملة بدل من الحطمة.\r\n\r\n"},{"sura":104,"ayah":7,"words":[{"position":1,"arabic":"ٱلَّتِى","translation":"Which","transliteration":"allatī"},{"position":2,"arabic":"تَطَّلِعُ","translation":"mounts up","transliteration":"taṭṭaliʿu"},{"position":3,"arabic":"عَلَى","translation":"to","transliteration":"ʿalā"},{"position":4,"arabic":"ٱلْأَفْـِٔدَةِ","translation":"the hearts","transliteration":"l-afidati"}],"e3rab":"(الَّتِي) اسم موصول صفة نار (تَطَّلِعُ) مضارع فاعله مستتر والجملة صلة (عَلَى الْأَفْئِدَةِ) متعلقان بالفعل.\r\n\r\n"},{"sura":104,"ayah":8,"words":[{"position":1,"arabic":"إِنَّهَا","translation":"Indeed, it","transliteration":"innahā"},{"position":2,"arabic":"عَلَيْهِم","translation":"(will be) upon them","transliteration":"ʿalayhim"},{"position":3,"arabic":"مُّؤْصَدَةٌۭ","translation":"closed over","transliteration":"mu'ṣadatun"}],"e3rab":"(إِنَّها) إن واسمها (عَلَيْهِمْ) متعلقان بالخبر (مُؤْصَدَةٌ) خبر والجملة الاسمية حال.\r\n\r\n"},{"sura":104,"ayah":9,"words":[{"position":1,"arabic":"فِى","translation":"In","transliteration":"fī"},{"position":2,"arabic":"عَمَدٍۢ","translation":"columns","transliteration":"ʿamadin"},{"position":3,"arabic":"مُّمَدَّدَةٍۭ","translation":"extended","transliteration":"mumaddadatin"}],"e3rab":"(فِي عَمَدٍ) الجار والمجرور صفة مؤصدة (مُمَدَّدَةٍ) صفة عمد.\r\n\r\n"}]