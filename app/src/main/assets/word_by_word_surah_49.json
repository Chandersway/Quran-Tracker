[{"sura":49,"ayah":1,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you who believe","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"O you who believe","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"O you who believe","transliteration":"āmanū"},{"position":4,"arabic":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"arabic":"تُقَدِّمُوا۟","translation":"put (yourselves) forward ","transliteration":"tuqaddimū"},{"position":6,"arabic":"بَيْنَ","translation":"before Allah","transliteration":"bayna"},{"position":7,"arabic":"يَدَىِ","translation":"before Allah","transliteration":"yadayi"},{"position":8,"arabic":"ٱللَّهِ","translation":"before Allah","transliteration":"l-lahi"},{"position":9,"arabic":"وَرَسُولِهِۦ ۖ","translation":"and His Messenger","transliteration":"warasūlihi"},{"position":10,"arabic":"وَٱتَّقُوا۟","translation":"and fear Allah","transliteration":"wa-ittaqū"},{"position":11,"arabic":"ٱللَّهَ ۚ","translation":"and fear Allah","transliteration":"l-laha"},{"position":12,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":13,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":14,"arabic":"سَمِيعٌ","translation":"(is) All-Hearer","transliteration":"samīʿun"},{"position":15,"arabic":"عَلِيمٌۭ","translation":"All-Knower","transliteration":"ʿalīmun"}],"e3rab":"(يا أَيُّهَا) منادى نكرة مقصودة وها للتنبيه (الَّذِينَ) بدل من أيها (آمَنُوا) ماض وفاعله والجملة صلة وجملة النداء ابتدائية (لا تُقَدِّمُوا) مضارع مجزوم بلا الناهية والواو فاعله والجملة ابتدائية لا محل لها (بَيْنَ) ظرف مكان (يَدَيِ) مضاف إليه مجرور بالياء (اللَّهِ) لفظ الجلالة مضاف إليه (وَرَسُولِهِ) معطوف على ما سبق (وَاتَّقُوا) الواو حرف عطف وأمر مبني على حذف النون والواو فاعله (اللَّهِ) لفظ الجلالة مفعول به (إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ) إن واسمها وخبراها والجملة تعليل\r\n\r\n"},{"sura":49,"ayah":2,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you who believe","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"O you who believe","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"O you who believe","transliteration":"āmanū"},{"position":4,"arabic":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"arabic":"تَرْفَعُوٓا۟","translation":"raise","transliteration":"tarfaʿū"},{"position":6,"arabic":"أَصْوَٰتَكُمْ","translation":"your voices","transliteration":"aṣwātakum"},{"position":7,"arabic":"فَوْقَ","translation":"above","transliteration":"fawqa"},{"position":8,"arabic":"صَوْتِ","translation":"(the) voice","transliteration":"ṣawti"},{"position":9,"arabic":"ٱلنَّبِىِّ","translation":"(of) the Prophet","transliteration":"l-nabiyi"},{"position":10,"arabic":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":11,"arabic":"تَجْهَرُوا۟","translation":"be loud","transliteration":"tajharū"},{"position":12,"arabic":"لَهُۥ","translation":"to him","transliteration":"lahu"},{"position":13,"arabic":"بِٱلْقَوْلِ","translation":"in speech","transliteration":"bil-qawli"},{"position":14,"arabic":"كَجَهْرِ","translation":"like (the) loudness","transliteration":"kajahri"},{"position":15,"arabic":"بَعْضِكُمْ","translation":"(of) some of you","transliteration":"baʿḍikum"},{"position":16,"arabic":"لِبَعْضٍ","translation":"to others","transliteration":"libaʿḍin"},{"position":17,"arabic":"أَن","translation":"lest","transliteration":"an"},{"position":18,"arabic":"تَحْبَطَ","translation":"become worthless","transliteration":"taḥbaṭa"},{"position":19,"arabic":"أَعْمَـٰلُكُمْ","translation":"your deeds","transliteration":"aʿmālukum"},{"position":20,"arabic":"وَأَنتُمْ","translation":"while you","transliteration":"wa-antum"},{"position":21,"arabic":"لَا","translation":"(do) not","transliteration":"lā"},{"position":22,"arabic":"تَشْعُرُونَ","translation":"perceive","transliteration":"tashʿurūna"}],"e3rab":"(يا أَيُّهَا الَّذِينَ آمَنُوا لا تَرْفَعُوا) إعرابها كسابقتها (أَصْواتَكُمْ) مفعول به (فَوْقَ) ظرف مكان (صَوْتِ) مضاف إليه (النَّبِيِّ) مضاف إليه (وَلا) الواو حرف عطف ولا ناهية (تَجْهَرُوا) مضارع مجزوم بلا وعلامة جزمه حذف النون والواو فاعله (لَهُ) متعلقان بالفعل (بِالْقَوْلِ) متعلقان بالفعل أيضا (كَجَهْرِ) متعلقان بمحذوف صفة لمفعول مطلق محذوف (بَعْضِكُمْ) مضاف إليه (لِبَعْضٍ) متعلقان بجهر (أَنْ تَحْبَطَ) مضارع منصوب بأن (أَعْمالُكُمْ) فاعل والمصدر المؤول من أن والفعل في محل جر بالإضافة لمفعول لأجله محذوف (وَأَنْتُمْ) مبتدأ والواو حالية (لا) نافية (تَشْعُرُونَ) مضارع مرفوع بثبوت النون والواو فاعله والجملة خبر والجملة الاسمية حال\r\n\r\n"},{"sura":49,"ayah":3,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"يَغُضُّونَ","translation":"lower","transliteration":"yaghuḍḍūna"},{"position":4,"arabic":"أَصْوَٰتَهُمْ","translation":"their voices","transliteration":"aṣwātahum"},{"position":5,"arabic":"عِندَ","translation":"(in) presence","transliteration":"ʿinda"},{"position":6,"arabic":"رَسُولِ","translation":"(of the) Messenger of Allah ","transliteration":"rasūli"},{"position":7,"arabic":"ٱللَّهِ","translation":"(of the) Messenger of Allah ","transliteration":"l-lahi"},{"position":8,"arabic":"أُو۟لَـٰٓئِكَ","translation":"those","transliteration":"ulāika"},{"position":9,"arabic":"ٱلَّذِينَ","translation":"(are) the ones","transliteration":"alladhīna"},{"position":10,"arabic":"ٱمْتَحَنَ","translation":"Allah has tested","transliteration":"im'taḥana"},{"position":11,"arabic":"ٱللَّهُ","translation":"Allah has tested","transliteration":"l-lahu"},{"position":12,"arabic":"قُلُوبَهُمْ","translation":"their hearts","transliteration":"qulūbahum"},{"position":13,"arabic":"لِلتَّقْوَىٰ ۚ","translation":"for righteousness","transliteration":"lilttaqwā"},{"position":14,"arabic":"لَهُم","translation":"For them","transliteration":"lahum"},{"position":15,"arabic":"مَّغْفِرَةٌۭ","translation":"(is) forgiveness","transliteration":"maghfiratun"},{"position":16,"arabic":"وَأَجْرٌ","translation":"and a reward","transliteration":"wa-ajrun"},{"position":17,"arabic":"عَظِيمٌ","translation":"great","transliteration":"ʿaẓīmun"}],"e3rab":"(إِنَّ الَّذِينَ) إن واسمها (يَغُضُّونَ) مضارع مرفوع بثبوت النون والواو فاعله والجملة صلة (أَصْواتَهُمْ) مفعول به (عِنْدَ) ظرف مكان (رَسُولِ) مضاف إليه (اللَّهِ) لفظ الجلالة مضاف إليه (أُولئِكَ الَّذِينَ) مبتدأ وخبره والجملة الاسمية خبر إن وجملة إن مستأنفة (امْتَحَنَ اللَّهُ) ماض ولفظ الجلالة فاعله (قُلُوبَهُمْ) مفعول به (لِلتَّقْوى) متعلقان بالفعل والجملة صلة الذين (لَهُمْ) جار ومجرور خبر مقدم (مَغْفِرَةٌ) مبتدأ مؤخر (وَأَجْرٌ) معطوف على مغفرة (عَظِيمٌ) صفة والجملة الاسمية مستأنفة\r\n\r\n"},{"sura":49,"ayah":4,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"يُنَادُونَكَ","translation":"call you","transliteration":"yunādūnaka"},{"position":4,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":5,"arabic":"وَرَآءِ","translation":"behind","transliteration":"warāi"},{"position":6,"arabic":"ٱلْحُجُرَٰتِ","translation":"the private chambers","transliteration":"l-ḥujurāti"},{"position":7,"arabic":"أَكْثَرُهُمْ","translation":"most of them","transliteration":"aktharuhum"},{"position":8,"arabic":"لَا","translation":"(do) not","transliteration":"lā"},{"position":9,"arabic":"يَعْقِلُونَ","translation":"understand","transliteration":"yaʿqilūna"}],"e3rab":"(إِنَّ الَّذِينَ) إن واسمها (يُنادُونَكَ) مضارع مرفوع بثبوت النون والواو فاعله والكاف مفعول به والجملة صلة (مِنْ وَراءِ) متعلقان بالفعل (الْحُجُراتِ) مضاف إليه (أَكْثَرُهُمْ) مبتدأ (لا) نافية (يَعْقِلُونَ) مضارع وفاعله والجملة خبر المبتدأ والجملة الاسمية خبر إن وجملة إن مستأنفة.\r\n\r\n"},{"sura":49,"ayah":5,"words":[{"position":1,"arabic":"وَلَوْ","translation":"And if","transliteration":"walaw"},{"position":2,"arabic":"أَنَّهُمْ","translation":"they","transliteration":"annahum"},{"position":3,"arabic":"صَبَرُوا۟","translation":"had been patient","transliteration":"ṣabarū"},{"position":4,"arabic":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":5,"arabic":"تَخْرُجَ","translation":"you came out","transliteration":"takhruja"},{"position":6,"arabic":"إِلَيْهِمْ","translation":"to them","transliteration":"ilayhim"},{"position":7,"arabic":"لَكَانَ","translation":"certainly it would be","transliteration":"lakāna"},{"position":8,"arabic":"خَيْرًۭا","translation":"better","transliteration":"khayran"},{"position":9,"arabic":"لَّهُمْ ۚ","translation":"for them","transliteration":"lahum"},{"position":10,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":11,"arabic":"غَفُورٌۭ","translation":"(is) Oft-Forgiving","transliteration":"ghafūrun"},{"position":12,"arabic":"رَّحِيمٌۭ","translation":"Most Merciful","transliteration":"raḥīmun"}],"e3rab":"(وَلَوْ) الواو حرف استئناف ولو شرطية غير جازمة (أَنَّهُمْ) أن واسمها (صَبَرُوا) ماض وفاعله والجملة الفعلية خبر أن والمصدر المؤول من أن وما بعدها في محل رفع فاعل لفعل محذوف (حَتَّى) حرف غاية وجر (تَخْرُجَ) مضارع منصوب بأن مضمرة بعد حتى (إِلَيْهِمْ) متعلقان بالفعل والمصدر المؤول من أن والفعل في محل جر بحتى والجار والمجرور متعلقان بصبروا (لَكانَ) اللام واقعة في جواب لو (كان) ماض ناقص (خَيْراً) خبرها واسم كان مستتر (لَهُمْ) متعلقان بخيرا والجملة الفعلية جواب الشرط لا محل لها (وَاللَّهُ غَفُورٌ رَحِيمٌ) الواو حرف استئناف ومبتدأ وخبراه والجملة مستأنفة\r\n\r\n"},{"sura":49,"ayah":6,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you who believe","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"O you who believe","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوٓا۟","translation":"O you who believe","transliteration":"āmanū"},{"position":4,"arabic":"إِن","translation":"If","transliteration":"in"},{"position":5,"arabic":"جَآءَكُمْ","translation":"comes to you","transliteration":"jāakum"},{"position":6,"arabic":"فَاسِقٌۢ","translation":"a wicked person","transliteration":"fāsiqun"},{"position":7,"arabic":"بِنَبَإٍۢ","translation":"with information","transliteration":"binaba-in"},{"position":8,"arabic":"فَتَبَيَّنُوٓا۟","translation":"investigate","transliteration":"fatabayyanū"},{"position":9,"arabic":"أَن","translation":"lest","transliteration":"an"},{"position":10,"arabic":"تُصِيبُوا۟","translation":"you harm","transliteration":"tuṣībū"},{"position":11,"arabic":"قَوْمًۢا","translation":"a people","transliteration":"qawman"},{"position":12,"arabic":"بِجَهَـٰلَةٍۢ","translation":"in ignorance","transliteration":"bijahālatin"},{"position":13,"arabic":"فَتُصْبِحُوا۟","translation":"then you become","transliteration":"fatuṣ'biḥū"},{"position":14,"arabic":"عَلَىٰ","translation":"over","transliteration":"ʿalā"},{"position":15,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":16,"arabic":"فَعَلْتُمْ","translation":"you have done","transliteration":"faʿaltum"},{"position":17,"arabic":"نَـٰدِمِينَ","translation":"regretful","transliteration":"nādimīna"}],"e3rab":"(يا أَيُّهَا الَّذِينَ آمَنُوا) سبق إعرابها (إِنْ) حرف شرط جازم (جاءَكُمْ) ماض في محل جزم فعل الشرط والكاف مفعول به (فاسِقٌ) فاعل والجملة ابتدائية لا محل لها (بِنَبَإٍ) متعلقان بالفعل (فَتَبَيَّنُوا) الفاء واقعة في جواب الشرط وأمر مبني على حذف النون والواو فاعل والجملة في محل جزم جواب الشرط (أَنْ تُصِيبُوا) مضارع منصوب بأن والواو فاعل (قَوْماً) مفعول به والمصدر المؤول من أن وما بعدها في محل جر بالإضافة إلى مفعول لأجله محذوف والتقدير كراهة إصابتكم (بِجَهالَةٍ) حال (فَتُصْبِحُوا) الفاء حرف عطف ومضارع ناقص منصوب وعلامة نصبه حذف النون والواو اسمه (عَلى ما) متعلقان بنادمين (فَعَلْتُمْ) ماض وفاعله والجملة صلة ما (نادِمِينَ) خبر منصوب بالياء\r\n\r\n"},{"sura":49,"ayah":7,"words":[{"position":1,"arabic":"وَٱعْلَمُوٓا۟","translation":"And know","transliteration":"wa-iʿ'lamū"},{"position":2,"arabic":"أَنَّ","translation":"that","transliteration":"anna"},{"position":3,"arabic":"فِيكُمْ","translation":"among you","transliteration":"fīkum"},{"position":4,"arabic":"رَسُولَ","translation":"(is the) Messenger of Allah","transliteration":"rasūla"},{"position":5,"arabic":"ٱللَّهِ ۚ","translation":"(is the) Messenger of Allah","transliteration":"l-lahi"},{"position":6,"arabic":"لَوْ","translation":"If","transliteration":"law"},{"position":7,"arabic":"يُطِيعُكُمْ","translation":"he were to obey you","transliteration":"yuṭīʿukum"},{"position":8,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":9,"arabic":"كَثِيرٍۢ","translation":"much","transliteration":"kathīrin"},{"position":10,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":11,"arabic":"ٱلْأَمْرِ","translation":"the matter","transliteration":"l-amri"},{"position":12,"arabic":"لَعَنِتُّمْ","translation":"surely you would be in difficulty","transliteration":"laʿanittum"},{"position":13,"arabic":"وَلَـٰكِنَّ","translation":"but","transliteration":"walākinna"},{"position":14,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":15,"arabic":"حَبَّبَ","translation":"has endeared","transliteration":"ḥabbaba"},{"position":16,"arabic":"إِلَيْكُمُ","translation":"to you","transliteration":"ilaykumu"},{"position":17,"arabic":"ٱلْإِيمَـٰنَ","translation":"the Faith","transliteration":"l-īmāna"},{"position":18,"arabic":"وَزَيَّنَهُۥ","translation":"and has made it pleasing","transliteration":"wazayyanahu"},{"position":19,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":20,"arabic":"قُلُوبِكُمْ","translation":"your hearts","transliteration":"qulūbikum"},{"position":21,"arabic":"وَكَرَّهَ","translation":"and has made hateful","transliteration":"wakarraha"},{"position":22,"arabic":"إِلَيْكُمُ","translation":"to you","transliteration":"ilaykumu"},{"position":23,"arabic":"ٱلْكُفْرَ","translation":"disbelief","transliteration":"l-kuf'ra"},{"position":24,"arabic":"وَٱلْفُسُوقَ","translation":"and defiance","transliteration":"wal-fusūqa"},{"position":25,"arabic":"وَٱلْعِصْيَانَ ۚ","translation":"and disobedience","transliteration":"wal-ʿiṣ'yāna"},{"position":26,"arabic":"أُو۟لَـٰٓئِكَ","translation":"Those","transliteration":"ulāika"},{"position":27,"arabic":"هُمُ","translation":"(are) they ","transliteration":"humu"},{"position":28,"arabic":"ٱلرَّٰشِدُونَ","translation":"the guided ones","transliteration":"l-rāshidūna"}],"e3rab":"(وَاعْلَمُوا) الواو حرف عطف وأمر مبني على حذف النون والواو فاعل (أَنَّ) حرف مشبه بالفعل (فِيكُمْ) متعلقان بخبر مقدم محذوف (رَسُولَ) اسم أن المؤخر (اللَّهِ) لفظ الجلالة مضاف إليه والمصدر المؤول من أن وما بعدها سد مسد مفعولي اعلموا (لَوْ) شرطية غير جازمة (يُطِيعُكُمْ) مضارع ومفعوله والفاعل مستتر والجملة ابتدائية لا محل لها (فِي كَثِيرٍ) متعلقان بالفعل (مِنَ الْأَمْرِ) متعلقان بكثير (لَعَنِتُّمْ) اللام واقعة في جواب الشرط وماض وفاعله والجملة جواب الشرط لا محل لها (وَلكِنَّ) الواو حرف عطف ولكن حرف مشبه بالفعل (اللَّهِ) لفظ الجلالة اسمها (حَبَّبَ) ماض فاعله مستتر والجملة خبر لكن (إِلَيْكُمُ) متعلقان بالفعل (الْإِيمانَ) مفعول به والجملة الاسمية معطوفة على ما قبلها (وَزَيَّنَهُ) معطوف على حبب (فِي قُلُوبِكُمْ) متعلقان بالفعل (وَكَرَّهَ) معطوف على زين (إِلَيْكُمُ) متعلقان بالفعل (الْكُفْرَ) مفعول به (وَالْفُسُوقَ) معطوف على ما قبله (وَالْعِصْيانَ) معطوفة على ما سبق (أُولئِكَ) مبتدأ (هُمُ) ضمير فصل (الرَّاشِدُونَ) خبر والجملة مستأنفة.\r\n\r\n"},{"sura":49,"ayah":8,"words":[{"position":1,"arabic":"فَضْلًۭا","translation":"A Bounty","transliteration":"faḍlan"},{"position":2,"arabic":"مِّنَ","translation":"from Allah","transliteration":"mina"},{"position":3,"arabic":"ٱللَّهِ","translation":"from Allah","transliteration":"l-lahi"},{"position":4,"arabic":"وَنِعْمَةًۭ ۚ","translation":"and favor","transliteration":"waniʿ'matan"},{"position":5,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":6,"arabic":"عَلِيمٌ","translation":"(is) All-Knower","transliteration":"ʿalīmun"},{"position":7,"arabic":"حَكِيمٌۭ","translation":"All-Wise","transliteration":"ḥakīmun"}],"e3rab":"(فَضْلًا) مفعول لأجله (مِنَ اللَّهِ) متعلقان بفضلا (وَنِعْمَةً) معطوف على فضلا (وَاللَّهُ) الواو استئنافية ولفظ الجلالة مبتدأ (عَلِيمٌ حَكِيمٌ) خبران والجملة مستأنفة\r\n\r\n"},{"sura":49,"ayah":9,"words":[{"position":1,"arabic":"وَإِن","translation":"And if","transliteration":"wa-in"},{"position":2,"arabic":"طَآئِفَتَانِ","translation":"two parties","transliteration":"ṭāifatāni"},{"position":3,"arabic":"مِنَ","translation":"among","transliteration":"mina"},{"position":4,"arabic":"ٱلْمُؤْمِنِينَ","translation":"the believers","transliteration":"l-mu'minīna"},{"position":5,"arabic":"ٱقْتَتَلُوا۟","translation":"fight","transliteration":"iq'tatalū"},{"position":6,"arabic":"فَأَصْلِحُوا۟","translation":"then make peace","transliteration":"fa-aṣliḥū"},{"position":7,"arabic":"بَيْنَهُمَا ۖ","translation":"between both of them","transliteration":"baynahumā"},{"position":8,"arabic":"فَإِنۢ","translation":"But if","transliteration":"fa-in"},{"position":9,"arabic":"بَغَتْ","translation":"oppresses","transliteration":"baghat"},{"position":10,"arabic":"إِحْدَىٰهُمَا","translation":"one of them","transliteration":"iḥ'dāhumā"},{"position":11,"arabic":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":12,"arabic":"ٱلْأُخْرَىٰ","translation":"the other","transliteration":"l-ukh'rā"},{"position":13,"arabic":"فَقَـٰتِلُوا۟","translation":"then fight","transliteration":"faqātilū"},{"position":14,"arabic":"ٱلَّتِى","translation":"one which","transliteration":"allatī"},{"position":15,"arabic":"تَبْغِى","translation":"oppresses","transliteration":"tabghī"},{"position":16,"arabic":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":17,"arabic":"تَفِىٓءَ","translation":"it returns","transliteration":"tafīa"},{"position":18,"arabic":"إِلَىٰٓ","translation":"to","transliteration":"ilā"},{"position":19,"arabic":"أَمْرِ","translation":"(the) command","transliteration":"amri"},{"position":20,"arabic":"ٱللَّهِ ۚ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":21,"arabic":"فَإِن","translation":"Then if","transliteration":"fa-in"},{"position":22,"arabic":"فَآءَتْ","translation":"it returns","transliteration":"fāat"},{"position":23,"arabic":"فَأَصْلِحُوا۟","translation":"then make peace","transliteration":"fa-aṣliḥū"},{"position":24,"arabic":"بَيْنَهُمَا","translation":"between them","transliteration":"baynahumā"},{"position":25,"arabic":"بِٱلْعَدْلِ","translation":"with justice","transliteration":"bil-ʿadli"},{"position":26,"arabic":"وَأَقْسِطُوٓا۟ ۖ","translation":"and act justly","transliteration":"wa-aqsiṭū"},{"position":27,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":28,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":29,"arabic":"يُحِبُّ","translation":"loves","transliteration":"yuḥibbu"},{"position":30,"arabic":"ٱلْمُقْسِطِينَ","translation":"those who act justly","transliteration":"l-muq'siṭīna"}],"e3rab":"(وَإِنْ) الواو حرف استئناف وإن شرطية (طائِفَتانِ) فاعل مرفوع بالألف لفعل محذوف (مِنَ الْمُؤْمِنِينَ) صفة طائفتان (اقْتَتَلُوا) ماض وفاعله والجملة تفسيرية وجملة الشرط المحذوفة ابتدائية لا محل لها (فَأَصْلِحُوا) الفاء واقعة في جواب الشرط وأمر مبني على حذف النون والواو فاعله (بَيْنَهُما) ظرف مكان والجملة في محل جزم جواب الشرط (فَإِنْ بَغَتْ) الفاء حرف عطف وإن شرطية وماض (إِحْداهُما) فاعل (عَلَى الْأُخْرى) متعلقان بالفعل والجملة ابتدائية (فَقاتِلُوا) الفاء واقعة في جواب الشرط وأمر مبني على حذف النون والواو فاعله (الَّتِي) مفعول به والجملة في محل جزم جواب الشرط (تَبْغِي) مضارع فاعله مستتر والجملة صلة (حَتَّى تَفِي ءَ) حرف غاية وجر ومضارع منصوب بأن مضمرة بعد حتى فاعله مستتر (إِلى أَمْرِ) متعلقان بالفعل (اللَّهِ) لفظ الجلالة مضاف إليه والمصدر المؤول من أن والفعل في محل جر بحتى والجار والمجرور متعلقان بقاتلوا (فَإِنْ) حرف عطف وإن شرطية جازمة (فاءَتْ) ماض في محل جزم فعل الشرط (فَأَصْلِحُوا) الفاء واقعة في جواب الشرط وأمر والواو فاعله والجملة في محل جزم جواب الشرط (بَيْنَهُما) ظرف مكان (بِالْعَدْلِ) متعلقان بالفعل (وَأَقْسِطُوا) معطوف على أصلحوا (إِنَّ اللَّهَ) إن واسمها (يُحِبُّ الْمُقْسِطِينَ) مضارع ومفعوله والفاعل مستتر والجملة خبر إن والجملة الاسمية تعليل\r\n\r\n"},{"sura":49,"ayah":10,"words":[{"position":1,"arabic":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"position":2,"arabic":"ٱلْمُؤْمِنُونَ","translation":"the believers","transliteration":"l-mu'minūna"},{"position":3,"arabic":"إِخْوَةٌۭ","translation":"(are) brothers","transliteration":"ikh'watun"},{"position":4,"arabic":"فَأَصْلِحُوا۟","translation":"so make peace","transliteration":"fa-aṣliḥū"},{"position":5,"arabic":"بَيْنَ","translation":"between","transliteration":"bayna"},{"position":6,"arabic":"أَخَوَيْكُمْ ۚ","translation":"your brothers","transliteration":"akhawaykum"},{"position":7,"arabic":"وَٱتَّقُوا۟","translation":"and fear Allah","transliteration":"wa-ittaqū"},{"position":8,"arabic":"ٱللَّهَ","translation":"and fear Allah","transliteration":"l-laha"},{"position":9,"arabic":"لَعَلَّكُمْ","translation":"so that you may","transliteration":"laʿallakum"},{"position":10,"arabic":"تُرْحَمُونَ","translation":"receive mercy","transliteration":"tur'ḥamūna"}],"e3rab":"(إِنَّمَا) كافة ومكفوفة (الْمُؤْمِنُونَ إِخْوَةٌ) مبتدأ وخبره والجملة مستأنفة (فَأَصْلِحُوا) الفاء الفصيحة وأمر مبني على حذف النون والواو فاعله (بَيْنَ) ظرف مكان (أَخَوَيْكُمْ) مضاف إليه مجرور بالياء والجملة جواب شرط لا محل لها (وَاتَّقُوا) الواو حرف عطف وأمر مبني على حذف النون والواو فاعله (اللَّهَ) لفظ الجلالة مفعوله (لَعَلَّكُمْ) لعل واسمها (تُرْحَمُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة خبر لعل والجملة الاسمية تعليل.\r\n\r\n"},{"sura":49,"ayah":11,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you who believe","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"O you who believe","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"O you who believe","transliteration":"āmanū"},{"position":4,"arabic":"لَا","translation":"(Let) not","transliteration":"lā"},{"position":5,"arabic":"يَسْخَرْ","translation":"ridicule","transliteration":"yaskhar"},{"position":6,"arabic":"قَوْمٌۭ","translation":"a people","transliteration":"qawmun"},{"position":7,"arabic":"مِّن","translation":"[of]","transliteration":"min"},{"position":8,"arabic":"قَوْمٍ","translation":"(another) people","transliteration":"qawmin"},{"position":9,"arabic":"عَسَىٰٓ","translation":"perhaps","transliteration":"ʿasā"},{"position":10,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":11,"arabic":"يَكُونُوا۟","translation":"they may be","transliteration":"yakūnū"},{"position":12,"arabic":"خَيْرًۭا","translation":"better","transliteration":"khayran"},{"position":13,"arabic":"مِّنْهُمْ","translation":"than them","transliteration":"min'hum"},{"position":14,"arabic":"وَلَا","translation":"and (let) not","transliteration":"walā"},{"position":15,"arabic":"نِسَآءٌۭ","translation":"women","transliteration":"nisāon"},{"position":16,"arabic":"مِّن","translation":"[of]","transliteration":"min"},{"position":17,"arabic":"نِّسَآءٍ","translation":"(other) women","transliteration":"nisāin"},{"position":18,"arabic":"عَسَىٰٓ","translation":"perhaps","transliteration":"ʿasā"},{"position":19,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":20,"arabic":"يَكُنَّ","translation":"they may be","transliteration":"yakunna"},{"position":21,"arabic":"خَيْرًۭا","translation":"better","transliteration":"khayran"},{"position":22,"arabic":"مِّنْهُنَّ ۖ","translation":"than them","transliteration":"min'hunna"},{"position":23,"arabic":"وَلَا","translation":"And (do) not","transliteration":"walā"},{"position":24,"arabic":"تَلْمِزُوٓا۟","translation":"insult","transliteration":"talmizū"},{"position":25,"arabic":"أَنفُسَكُمْ","translation":"yourselves","transliteration":"anfusakum"},{"position":26,"arabic":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":27,"arabic":"تَنَابَزُوا۟","translation":"call each other","transliteration":"tanābazū"},{"position":28,"arabic":"بِٱلْأَلْقَـٰبِ ۖ","translation":"by nicknames","transliteration":"bil-alqābi"},{"position":29,"arabic":"بِئْسَ","translation":"Wretched is","transliteration":"bi'sa"},{"position":30,"arabic":"ٱلِٱسْمُ","translation":"the name","transliteration":"l-s'mu"},{"position":31,"arabic":"ٱلْفُسُوقُ","translation":"(of) disobedience","transliteration":"l-fusūqu"},{"position":32,"arabic":"بَعْدَ","translation":"after","transliteration":"baʿda"},{"position":33,"arabic":"ٱلْإِيمَـٰنِ ۚ","translation":"the faith","transliteration":"l-īmāni"},{"position":34,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":35,"arabic":"لَّمْ","translation":"(does) not","transliteration":"lam"},{"position":36,"arabic":"يَتُبْ","translation":"repent","transliteration":"yatub"},{"position":37,"arabic":"فَأُو۟لَـٰٓئِكَ","translation":"then those ","transliteration":"fa-ulāika"},{"position":38,"arabic":"هُمُ","translation":"they","transliteration":"humu"},{"position":39,"arabic":"ٱلظَّـٰلِمُونَ","translation":"(are) the wrongdoers","transliteration":"l-ẓālimūna"}],"e3rab":"(يا أَيُّهَا الَّذِينَ آمَنُوا) سبق إعرابها (لا يَسْخَرْ) مضارع مجزوم بلا الناهية (قَوْمٌ) فاعل والجملة ابتدائية (مِنْ قَوْمٍ) متعلقان بالفعل (عَسى) ماض تام (أَنْ يَكُونُوا خَيْراً) مضارع ناقص منصوب بأن والواو اسمه وخيرا خبره (مِنْهُمْ) متعلقان بخيرا والمصدر المؤول من أن وما بعدها فاعل عسى (وَلا نِساءٌ مِنْ نِساءٍ عَسى أَنْ يَكُنَّ خَيْراً مِنْهُنَّ) معطوف على ما قبله وجملة عسى مستأنفة (وَلا تَلْمِزُوا أَنْفُسَكُمْ) مضارع مجزوم بلا الناهية والواو فاعله وأنفسكم مفعوله (وَلا تَنابَزُوا) معطوف على ما قبله (بِالْأَلْقابِ) متعلقان بالفعل (بِئْسَ الِاسْمُ) ماض جامد للذم وفاعله (الْفُسُوقُ) مبتدأ وجملة بئس خبره (بَعْدَ) ظرف زمان (الْإِيمانِ) مضاف إليه (وَمَنْ) الواو حرف استئناف ومن اسم شرط جازم مبتدأ (لَمْ يَتُبْ) مضارع مجزوم بلم وهو فعل الشرط والفاعل مستتر (فَأُولئِكَ) الفاء واقعة في جواب الشرط ومبتدأ (هُمُ) ضمير فصل (الظَّالِمُونَ) خبر والجملة الاسمية في محل جزم جواب الشرط وجملتا الشرط والجواب خبر وجملة من مستأنفة.\r\n\r\n"},{"sura":49,"ayah":12,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O you who believe","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"O you who believe","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"O you who believe","transliteration":"āmanū"},{"position":4,"arabic":"ٱجْتَنِبُوا۟","translation":"Avoid","transliteration":"ij'tanibū"},{"position":5,"arabic":"كَثِيرًۭا","translation":"much","transliteration":"kathīran"},{"position":6,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":7,"arabic":"ٱلظَّنِّ","translation":"the assumption","transliteration":"l-ẓani"},{"position":8,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":9,"arabic":"بَعْضَ","translation":"some","transliteration":"baʿḍa"},{"position":10,"arabic":"ٱلظَّنِّ","translation":"assumption","transliteration":"l-ẓani"},{"position":11,"arabic":"إِثْمٌۭ ۖ","translation":"(is) sin","transliteration":"ith'mun"},{"position":12,"arabic":"وَلَا","translation":"And (do) not","transliteration":"walā"},{"position":13,"arabic":"تَجَسَّسُوا۟","translation":"spy","transliteration":"tajassasū"},{"position":14,"arabic":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":15,"arabic":"يَغْتَب","translation":"backbite","transliteration":"yaghtab"},{"position":16,"arabic":"بَّعْضُكُم","translation":"some of you","transliteration":"baʿḍukum"},{"position":17,"arabic":"بَعْضًا ۚ","translation":"(to) others","transliteration":"baʿḍan"},{"position":18,"arabic":"أَيُحِبُّ","translation":"Would like","transliteration":"ayuḥibbu"},{"position":19,"arabic":"أَحَدُكُمْ","translation":"one of you","transliteration":"aḥadukum"},{"position":20,"arabic":"أَن","translation":"to","transliteration":"an"},{"position":21,"arabic":"يَأْكُلَ","translation":"eat","transliteration":"yakula"},{"position":22,"arabic":"لَحْمَ","translation":"(the) flesh","transliteration":"laḥma"},{"position":23,"arabic":"أَخِيهِ","translation":"(of) his brother","transliteration":"akhīhi"},{"position":24,"arabic":"مَيْتًۭا","translation":"dead","transliteration":"maytan"},{"position":25,"arabic":"فَكَرِهْتُمُوهُ ۚ","translation":"Nay, you would hate it","transliteration":"fakarih'tumūhu"},{"position":26,"arabic":"وَٱتَّقُوا۟","translation":"And fear Allah","transliteration":"wa-ittaqū"},{"position":27,"arabic":"ٱللَّهَ ۚ","translation":"And fear Allah","transliteration":"l-laha"},{"position":28,"arabic":"إِنَّ","translation":"indeed","transliteration":"inna"},{"position":29,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":30,"arabic":"تَوَّابٌۭ","translation":"(is) Oft-Returning","transliteration":"tawwābun"},{"position":31,"arabic":"رَّحِيمٌۭ","translation":"Most Merciful","transliteration":"raḥīmun"}],"e3rab":"(يا أَيُّهَا الَّذِينَ آمَنُوا اجْتَنِبُوا كَثِيراً) سبق إعرابها (مِنَ الظَّنِّ) متعلقان بكثيرا (إِنَّ بَعْضَ) إن واسمها (الظَّنِّ) مضاف إليه (إِثْمٌ) خبرها والجملة الاسمية تعليل (وَلا تَجَسَّسُوا) مضارع مجزوم بلا الناهية والواو فاعله والجملة معطوفة على ما قبلها (وَلا يَغْتَبْ) مضارع مجزوم بلا الناهية (بَعْضُكُمْ) فاعله (بَعْضاً) مفعوله والجملة معطوفة على ما قبلها (أَيُحِبُّ) الهمزة حرف استفهام وتوبيخ ومضارع مرفوع (أَحَدُكُمْ) فاعل والجملة مستأنفة (أَنْ يَأْكُلَ لَحْمَ) مضارع منصوب بأن ومفعوله والفاعل مستتر (أَخِيهِ) مضاف إليه مجرور بالياء (مَيْتاً) حال والمصدر المؤول من أن والفعل في محل نصب مفعول به (فَكَرِهْتُمُوهُ) الفاء الفصيحة وماض وفاعله ومفعوله والواو للإشباع والجملة الفعلية جواب شرط مقدر لا محل لها (وَاتَّقُوا) حرف استئناف وأمر مبني على حذف النون والواو فاعله (اللَّهَ) لفظ الجلالة مفعوله والجملة مستأنفة (إِنَّ اللَّهَ تَوَّابٌ رَحِيمٌ) إن واسمها وخبراها والجملة الاسمية تعليل لا محل لها\r\n\r\n"},{"sura":49,"ayah":13,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O mankind","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلنَّاسُ","translation":"O mankind","transliteration":"l-nāsu"},{"position":3,"arabic":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":4,"arabic":"خَلَقْنَـٰكُم","translation":"created you","transliteration":"khalaqnākum"},{"position":5,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":6,"arabic":"ذَكَرٍۢ","translation":"a male","transliteration":"dhakarin"},{"position":7,"arabic":"وَأُنثَىٰ","translation":"and a female","transliteration":"wa-unthā"},{"position":8,"arabic":"وَجَعَلْنَـٰكُمْ","translation":"and We made you","transliteration":"wajaʿalnākum"},{"position":9,"arabic":"شُعُوبًۭا","translation":"nations","transliteration":"shuʿūban"},{"position":10,"arabic":"وَقَبَآئِلَ","translation":"and tribes","transliteration":"waqabāila"},{"position":11,"arabic":"لِتَعَارَفُوٓا۟ ۚ","translation":"that you may know one another","transliteration":"litaʿārafū"},{"position":12,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":13,"arabic":"أَكْرَمَكُمْ","translation":"(the) most noble of you","transliteration":"akramakum"},{"position":14,"arabic":"عِندَ","translation":"near","transliteration":"ʿinda"},{"position":15,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":16,"arabic":"أَتْقَىٰكُمْ ۚ","translation":"(is the) most righteous of you","transliteration":"atqākum"},{"position":17,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":18,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":19,"arabic":"عَلِيمٌ","translation":"(is) All-Knower","transliteration":"ʿalīmun"},{"position":20,"arabic":"خَبِيرٌۭ","translation":"All-Aware","transliteration":"khabīrun"}],"e3rab":"(يا أَيُّهَا النَّاسُ) سبق إعراب مثيلها (إِنَّا) إن واسمها (خَلَقْناكُمْ) ماض وفاعله ومفعوله والجملة خبر إن (مِنْ ذَكَرٍ) متعلقان بالفعل (وَأُنْثى) معطوف على ذكر والجملة الاسمية ابتدائية (وَجَعَلْناكُمْ) ماض وفاعله ومفعوله الأول والجملة معطوفة على ما قبلها (شُعُوباً) مفعوله الثاني (وَقَبائِلَ) معطوفة على شعوبا (لِتَعارَفُوا) مضارع منصوب بأن مضمرة بعد لام التعليل والواو فاعله والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بجعلناكم (إِنَّ أَكْرَمَكُمْ) إن واسمها (عِنْدَ) ظرف مكان (اللَّهِ) لفظ الجلالة مضاف إليه (أَتْقاكُمْ) خبر إن والجملة الاسمية تعليلية (إِنَّ اللَّهَ عَلِيمٌ خَبِيرٌ) إن واسمها وخبراها والجملة الاسمية مستأنفة.\r\n\r\n"},{"sura":49,"ayah":14,"words":[{"position":1,"arabic":"۞ قَالَتِ","translation":"Say","transliteration":"qālati"},{"position":2,"arabic":"ٱلْأَعْرَابُ","translation":"the Bedouins","transliteration":"l-aʿrābu"},{"position":3,"arabic":"ءَامَنَّا ۖ","translation":"We believe","transliteration":"āmannā"},{"position":4,"arabic":"قُل","translation":"Say","transliteration":"qul"},{"position":5,"arabic":"لَّمْ","translation":"Not","transliteration":"lam"},{"position":6,"arabic":"تُؤْمِنُوا۟","translation":"you believe","transliteration":"tu'minū"},{"position":7,"arabic":"وَلَـٰكِن","translation":"but","transliteration":"walākin"},{"position":8,"arabic":"قُولُوٓا۟","translation":"say","transliteration":"qūlū"},{"position":9,"arabic":"أَسْلَمْنَا","translation":"We have submitted","transliteration":"aslamnā"},{"position":10,"arabic":"وَلَمَّا","translation":"and has not yet","transliteration":"walammā"},{"position":11,"arabic":"يَدْخُلِ","translation":"entered","transliteration":"yadkhuli"},{"position":12,"arabic":"ٱلْإِيمَـٰنُ","translation":"the faith","transliteration":"l-īmānu"},{"position":13,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":14,"arabic":"قُلُوبِكُمْ ۖ","translation":"your hearts","transliteration":"qulūbikum"},{"position":15,"arabic":"وَإِن","translation":"But if","transliteration":"wa-in"},{"position":16,"arabic":"تُطِيعُوا۟","translation":"you obey","transliteration":"tuṭīʿū"},{"position":17,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":18,"arabic":"وَرَسُولَهُۥ","translation":"and His Messenger","transliteration":"warasūlahu"},{"position":19,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":20,"arabic":"يَلِتْكُم","translation":"He will deprive you","transliteration":"yalit'kum"},{"position":21,"arabic":"مِّنْ","translation":"of","transliteration":"min"},{"position":22,"arabic":"أَعْمَـٰلِكُمْ","translation":"your deeds","transliteration":"aʿmālikum"},{"position":23,"arabic":"شَيْـًٔا ۚ","translation":"anything","transliteration":"shayan"},{"position":24,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":25,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":26,"arabic":"غَفُورٌۭ","translation":"(is) Oft-Forgiving","transliteration":"ghafūrun"},{"position":27,"arabic":"رَّحِيمٌ","translation":"Most Merciful","transliteration":"raḥīmun"}],"e3rab":"(قالَتِ) ماض (الْأَعْرابُ) فاعل والجملة مستأنفة (آمَنَّا) ماض وفاعله والجملة مقول القول (قُلْ) أمر فاعله مستتر والجملة مستأنفة (لَمْ تُؤْمِنُوا) مضارع مجزوم بلم والواو فاعله والجملة مقول القول (وَلكِنْ) حرف استدراك (قُولُوا) أمر مبني على حذف النون والواو فاعله والجملة معطوفة على ما قبلها (أَسْلَمْنا) ماض وفاعله والجملة مقول القول (وَلَمَّا يَدْخُلِ) الواو حالية ومضارع مجزوم بلما (الْإِيمانُ) فاعله (فِي قُلُوبِكُمْ) متعلقان بالفعل والجملة حالية (وَإِنْ) الواو حرف استئناف وإن شرطية جازمة (تُطِيعُوا) مضارع مجزوم لأنه فعل الشرط والواو فاعله وجملة تطيعوا ابتدائية لا محل لها (اللَّهَ) لفظ الجلالة مفعول به (وَرَسُولَهُ) معطوف عليه (لا يَلِتْكُمْ) لا نافية ومضارع مجزوم لأنه جواب الشرط والكاف مفعوله والفاعل مستتر والجملة جواب الشرط لا محل لها (مِنْ أَعْمالِكُمْ) متعلقان بالفعل (شَيْئاً) مفعول به ثان (إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ) إن واسمها وخبراها والجملة تعليل لا محل لها\r\n\r\n"},{"sura":49,"ayah":15,"words":[{"position":1,"arabic":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"position":2,"arabic":"ٱلْمُؤْمِنُونَ","translation":"the believers","transliteration":"l-mu'minūna"},{"position":3,"arabic":"ٱلَّذِينَ","translation":"(are) those who","transliteration":"alladhīna"},{"position":4,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":5,"arabic":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":6,"arabic":"وَرَسُولِهِۦ","translation":"and His Messenger","transliteration":"warasūlihi"},{"position":7,"arabic":"ثُمَّ","translation":"then","transliteration":"thumma"},{"position":8,"arabic":"لَمْ","translation":"(do) not","transliteration":"lam"},{"position":9,"arabic":"يَرْتَابُوا۟","translation":"doubt","transliteration":"yartābū"},{"position":10,"arabic":"وَجَـٰهَدُوا۟","translation":"but strive","transliteration":"wajāhadū"},{"position":11,"arabic":"بِأَمْوَٰلِهِمْ","translation":"with their wealth","transliteration":"bi-amwālihim"},{"position":12,"arabic":"وَأَنفُسِهِمْ","translation":"and their lives","transliteration":"wa-anfusihim"},{"position":13,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":14,"arabic":"سَبِيلِ","translation":"(the) way","transliteration":"sabīli"},{"position":15,"arabic":"ٱللَّهِ ۚ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":16,"arabic":"أُو۟لَـٰٓئِكَ","translation":"Those","transliteration":"ulāika"},{"position":17,"arabic":"هُمُ","translation":"[they]","transliteration":"humu"},{"position":18,"arabic":"ٱلصَّـٰدِقُونَ","translation":"(are) the truthful","transliteration":"l-ṣādiqūna"}],"e3rab":"(إِنَّمَا) كافة ومكفوفة (الْمُؤْمِنُونَ) مبتدأ (الَّذِينَ) خبره (آمَنُوا) ماض وفاعله والجملة صلة (بِاللَّهِ) متعلقان بالفعل (وَرَسُولِهِ) معطوف (ثُمَّ) حرف عطف (لَمْ يَرْتابُوا) مضارع مجزوم بلم والواو فاعله والجملة معطوفة على ما قبلها (وَجاهَدُوا) معطوف على آمنوا (بِأَمْوالِهِمْ) متعلقان بالفعل (وَأَنْفُسِهِمْ) معطوف على أموالهم (فِي سَبِيلِ) متعلقان بالفعل أيضا (اللَّهِ) لفظ الجلالة مضاف إليه (أُولئِكَ) مبتدأ (هُمُ) ضمير فصل (الصَّادِقُونَ) خبر والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":49,"ayah":16,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"أَتُعَلِّمُونَ","translation":"Will you acquaint","transliteration":"atuʿallimūna"},{"position":3,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":4,"arabic":"بِدِينِكُمْ","translation":"with your religion","transliteration":"bidīnikum"},{"position":5,"arabic":"وَٱللَّهُ","translation":"while Allah","transliteration":"wal-lahu"},{"position":6,"arabic":"يَعْلَمُ","translation":"knows","transliteration":"yaʿlamu"},{"position":7,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":8,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":9,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":10,"arabic":"وَمَا","translation":"and what","transliteration":"wamā"},{"position":11,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":12,"arabic":"ٱلْأَرْضِ ۚ","translation":"the earth","transliteration":"l-arḍi"},{"position":13,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":14,"arabic":"بِكُلِّ","translation":"of every","transliteration":"bikulli"},{"position":15,"arabic":"شَىْءٍ","translation":"thing","transliteration":"shayin"},{"position":16,"arabic":"عَلِيمٌۭ","translation":"(is) All-Knower","transliteration":"ʿalīmun"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة مستأنفة لا محل لها (أَتُعَلِّمُونَ) الهمزة حرف استفهام توبيخي ومضارع مرفوع بثبوت النون والواو فاعله (اللَّهَ) لفظ الجلالة مفعول به (بِدِينِكُمْ) متعلقان بالفعل والجملة مقول القول (وَاللَّهُ) الواو حالية ومبتدأ (يَعْلَمُ) مضارع فاعله مستتر والجملة خبر المبتدأ والجملة الاسمية حال (ما) مفعول به (فِي السَّماواتِ) متعلقان بمحذوف صلة الموصول (وَما فِي الْأَرْضِ) عطف على ما قبله (وَاللَّهُ) لفظ الجلالة مبتدأ (بِكُلِّ) متعلقان بعليم (شَيْءٍ) مضاف إليه (عَلِيمٌ) خبر والجملة معطوفة على ما قبلها\r\n\r\n"},{"sura":49,"ayah":17,"words":[{"position":1,"arabic":"يَمُنُّونَ","translation":"They consider (it) a favor","transliteration":"yamunnūna"},{"position":2,"arabic":"عَلَيْكَ","translation":"to you","transliteration":"ʿalayka"},{"position":3,"arabic":"أَنْ","translation":"that","transliteration":"an"},{"position":4,"arabic":"أَسْلَمُوا۟ ۖ","translation":"they have accepted Islam","transliteration":"aslamū"},{"position":5,"arabic":"قُل","translation":"Say","transliteration":"qul"},{"position":6,"arabic":"لَّا","translation":"(Do) not","transliteration":"lā"},{"position":7,"arabic":"تَمُنُّوا۟","translation":"consider a favor","transliteration":"tamunnū"},{"position":8,"arabic":"عَلَىَّ","translation":"on me ","transliteration":"ʿalayya"},{"position":9,"arabic":"إِسْلَـٰمَكُم ۖ","translation":"your Islam","transliteration":"is'lāmakum"},{"position":10,"arabic":"بَلِ","translation":"Nay","transliteration":"bali"},{"position":11,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":12,"arabic":"يَمُنُّ","translation":"has conferred a favor","transliteration":"yamunnu"},{"position":13,"arabic":"عَلَيْكُمْ","translation":"upon you","transliteration":"ʿalaykum"},{"position":14,"arabic":"أَنْ","translation":"that","transliteration":"an"},{"position":15,"arabic":"هَدَىٰكُمْ","translation":"He has guided you","transliteration":"hadākum"},{"position":16,"arabic":"لِلْإِيمَـٰنِ","translation":"to the faith","transliteration":"lil'īmāni"},{"position":17,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":18,"arabic":"كُنتُمْ","translation":"you are","transliteration":"kuntum"},{"position":19,"arabic":"صَـٰدِقِينَ","translation":"truthful","transliteration":"ṣādiqīna"}],"e3rab":"(يَمُنُّونَ) مضارع مرفوع بثبوت النون والواو فاعله والجملة مستأنفة (عَلَيْكَ) متعلقان بالفعل (أَنْ) حرف مصدري ونصب (أَسْلَمُوا) ماض وفاعله والمصدر المؤول من أن والفعل منصوب بنزع الخافض (قُلْ) أمر فاعله مستتر والجملة مستأنفة (لا تَمُنُّوا) مضارع مجزوم بلا الناهية والواو فاعله (عَلَيَّ) متعلقان بالفعل (إِسْلامَكُمْ) مفعول به والجملة مقول القول (بَلِ) حرف عطف وإضراب (اللَّهُ) لفظ الجلالة مبتدأ (يَمُنُّ) مضارع فاعله مستتر والجملة خبر (عَلَيْكُمْ) متعلقان بيمن (أَنْ) حرف مصدري ونصب (هَداكُمْ) ماض ومفعوله والفاعل مستتر (لِلْإِيمانِ) متعلقان بالفعل والمصدر المؤول من أن وما بعدها منصوب بنزع الخافض (أَنْ) شرطية جازمة (كُنْتُمْ) ماض ناقص واسمه (صادِقِينَ) خبره والجملة الفعلية ابتدائية لا محل لها وجواب الشرط محذوف لدلالة ما قبله عليه\r\n\r\n"},{"sura":49,"ayah":18,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":3,"arabic":"يَعْلَمُ","translation":"knows","transliteration":"yaʿlamu"},{"position":4,"arabic":"غَيْبَ","translation":"(the) unseen","transliteration":"ghayba"},{"position":5,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"(of) the heavens","transliteration":"l-samāwāti"},{"position":6,"arabic":"وَٱلْأَرْضِ ۚ","translation":"and the earth","transliteration":"wal-arḍi"},{"position":7,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":8,"arabic":"بَصِيرٌۢ","translation":"(is) All-Seer","transliteration":"baṣīrun"},{"position":9,"arabic":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":10,"arabic":"تَعْمَلُونَ","translation":"you do","transliteration":"taʿmalūna"}],"e3rab":"(إِنَّ اللَّهَ) إن ولفظ الجلالة اسمها (يَعْلَمُ) مضارع فاعله مستتر (غَيْبَ) مفعوله (السَّماواتِ) مضاف إليه (وَالْأَرْضِ) معطوف والجملة الفعلية خبر إن والجملة الاسمية مستأنفة (وَاللَّهُ بَصِيرٌ) الواو حرف استئناف ومبتدأ وخبره (بِما) متعلقان بما بعدهما (تَعْمَلُونَ) مضارع مرفوع بثبوت النون والواو فاعله والجملة صلة والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"}]