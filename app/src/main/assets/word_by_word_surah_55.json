[{"sura":55,"ayah":1,"words":[{"position":1,"arabic":"ٱلرَّحْمَـٰنُ","translation":"The Most Gracious","transliteration":"al-raḥmānu"}],"e3rab":"«الرَّحْمنُ» مبتدأ\r\n\r\n"},{"sura":55,"ayah":2,"words":[{"position":1,"arabic":"عَلَّمَ","translation":"He taught","transliteration":"ʿallama"},{"position":2,"arabic":"ٱلْقُرْءَانَ","translation":"the Quran","transliteration":"l-qur'āna"}],"e3rab":"«عَلَّمَ الْقُرْآنَ» ماض ومفعوله والفاعل مستتر والجملة خبر المبتدأ\r\n\r\n"},{"sura":55,"ayah":3,"words":[{"position":1,"arabic":"خَلَقَ","translation":"He created","transliteration":"khalaqa"},{"position":2,"arabic":"ٱلْإِنسَـٰنَ","translation":"[the] man","transliteration":"l-insāna"}],"e3rab":"«خَلَقَ الْإِنْسانَ» ماض ومفعوله والفاعل مستتر والجملة خبر ثان\r\n\r\n"},{"sura":55,"ayah":4,"words":[{"position":1,"arabic":"عَلَّمَهُ","translation":"He taught him","transliteration":"ʿallamahu"},{"position":2,"arabic":"ٱلْبَيَانَ","translation":"[the] speech","transliteration":"l-bayāna"}],"e3rab":"«عَلَّمَهُ الْبَيانَ» ماض ومفعوله والفاعل مستتر والبيان مفعوله الثاني والجملة خبر ثالث.\r\n\r\n"},{"sura":55,"ayah":5,"words":[{"position":1,"arabic":"ٱلشَّمْسُ","translation":"The sun","transliteration":"al-shamsu"},{"position":2,"arabic":"وَٱلْقَمَرُ","translation":"and the moon","transliteration":"wal-qamaru"},{"position":3,"arabic":"بِحُسْبَانٍۢ","translation":"by (precise) calculation","transliteration":"biḥus'bānin"}],"e3rab":"(الشَّمْسُ) مبتدأ (وَالْقَمَرُ) معطوف عليه (بِحُسْبانٍ) خبر المبتدأ والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":55,"ayah":6,"words":[{"position":1,"arabic":"وَٱلنَّجْمُ","translation":"And the stars","transliteration":"wal-najmu"},{"position":2,"arabic":"وَٱلشَّجَرُ","translation":"and the trees","transliteration":"wal-shajaru"},{"position":3,"arabic":"يَسْجُدَانِ","translation":"both prostrate","transliteration":"yasjudāni"}],"e3rab":"(وَالنَّجْمُ) مبتدأ (وَالشَّجَرُ) معطوف عليه (يَسْجُدانِ) مضارع مرفوع والألف فاعله والجملة الفعلية خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":55,"ayah":7,"words":[{"position":1,"arabic":"وَٱلسَّمَآءَ","translation":"And the heaven","transliteration":"wal-samāa"},{"position":2,"arabic":"رَفَعَهَا","translation":"He raised it","transliteration":"rafaʿahā"},{"position":3,"arabic":"وَوَضَعَ","translation":"and He has set up","transliteration":"wawaḍaʿa"},{"position":4,"arabic":"ٱلْمِيزَانَ","translation":"the balance","transliteration":"l-mīzāna"}],"e3rab":"(وَالسَّماءَ) حرف عطف ومفعول به لفعل محذوف يفسره المذكور (رَفَعَها) ماض ومفعوله والفاعل مستتر والجملة الفعلية تفسيرية لا محل لها والجملة المقدرة معطوفة على ما قبلها (وَوَضَعَ الْمِيزانَ) معطوف على ما قبله.\r\n\r\n"},{"sura":55,"ayah":8,"words":[{"position":1,"arabic":"أَلَّا","translation":"That not","transliteration":"allā"},{"position":2,"arabic":"تَطْغَوْا۟","translation":"you may transgress","transliteration":"taṭghaw"},{"position":3,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":4,"arabic":"ٱلْمِيزَانِ","translation":"the balance","transliteration":"l-mīzāni"}],"e3rab":"(أَلَّا) أن حرف مصدري ونصب ولا نافية، (تَطْغَوْا) مضارع منصوب بأن والواو فاعله (فِي الْمِيزانِ) متعلقان بالفعل وأن وما بعدها في تأويل مصدر في محل جر بحرف جر مقدر والجار والمجرور متعلقان بوضع.\r\n\r\n"},{"sura":55,"ayah":9,"words":[{"position":1,"arabic":"وَأَقِيمُوا۟","translation":"And establish","transliteration":"wa-aqīmū"},{"position":2,"arabic":"ٱلْوَزْنَ","translation":"the weight","transliteration":"l-wazna"},{"position":3,"arabic":"بِٱلْقِسْطِ","translation":"in justice","transliteration":"bil-qis'ṭi"},{"position":4,"arabic":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":5,"arabic":"تُخْسِرُوا۟","translation":"make deficient","transliteration":"tukh'sirū"},{"position":6,"arabic":"ٱلْمِيزَانَ","translation":"the balance","transliteration":"l-mīzāna"}],"e3rab":"(وَأَقِيمُوا) أمر مبني على حذف النون والواو فاعله (الْوَزْنَ) مفعول به (بِالْقِسْطِ) متعلقان بالفعل والجملة معطوفة على ما قبلها (وَلا تُخْسِرُوا) الواو حرف عطف ومضارع مجزوم بلا الناهية والواو فاعله (الْمِيزانَ) مفعول به والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":55,"ayah":10,"words":[{"position":1,"arabic":"وَٱلْأَرْضَ","translation":"And the earth","transliteration":"wal-arḍa"},{"position":2,"arabic":"وَضَعَهَا","translation":"He laid it","transliteration":"waḍaʿahā"},{"position":3,"arabic":"لِلْأَنَامِ","translation":"for the creatures","transliteration":"lil'anāmi"}],"e3rab":"(وَالْأَرْضَ) مفعول به لفعل محذوف يفسره المذكور والجملة المقدرة معطوفة على ما قبلها (وَضَعَها) ماض ومفعوله والفاعل مستتر (لِلْأَنامِ) متعلقان بالفعل والجملة تفسيرية لا محل لها.\r\n\r\n"},{"sura":55,"ayah":11,"words":[{"position":1,"arabic":"فِيهَا","translation":"Therein","transliteration":"fīhā"},{"position":2,"arabic":"فَـٰكِهَةٌۭ","translation":"(is) fruit","transliteration":"fākihatun"},{"position":3,"arabic":"وَٱلنَّخْلُ","translation":"and date-palms","transliteration":"wal-nakhlu"},{"position":4,"arabic":"ذَاتُ","translation":"having","transliteration":"dhātu"},{"position":5,"arabic":"ٱلْأَكْمَامِ","translation":"sheaths","transliteration":"l-akmāmi"}],"e3rab":"(فِيها) خبر مقدم (فاكِهَةٌ) مبتدأ مؤخر والجملة استئنافية لا محل لها (وَالنَّخْلُ) معطوف على فاكهة (ذاتُ) صفة (الْأَكْمامِ) مضاف إليه.\r\n\r\n"},{"sura":55,"ayah":12,"words":[{"position":1,"arabic":"وَٱلْحَبُّ","translation":"And the grain","transliteration":"wal-ḥabu"},{"position":2,"arabic":"ذُو","translation":"having","transliteration":"dhū"},{"position":3,"arabic":"ٱلْعَصْفِ","translation":"husk","transliteration":"l-ʿaṣfi"},{"position":4,"arabic":"وَٱلرَّيْحَانُ","translation":"and scented plants","transliteration":"wal-rayḥānu"}],"e3rab":"(وَالْحَبُّ) معطوف على فاكهة (ذُو) صفة (الْعَصْفِ) مضاف إليه (وَالرَّيْحانُ) معطوف على ما قبله.\r\n\r\n"},{"sura":55,"ayah":13,"words":[{"position":1,"arabic":"فَبِأَىِّ","translation":"So which","transliteration":"fabi-ayyi"},{"position":2,"arabic":"ءَالَآءِ","translation":"(of the) favors","transliteration":"ālāi"},{"position":3,"arabic":"رَبِّكُمَا","translation":"(of) your Lord","transliteration":"rabbikumā"},{"position":4,"arabic":"تُكَذِّبَانِ","translation":"will you both deny","transliteration":"tukadhibāni"}],"e3rab":"(فَبِأَيِّ) الفاء الفصيحة وبأي متعلقان بتكذبان (آلاءِ) مضاف إليه (رَبِّكُما) مضاف إليه (تُكَذِّبانِ) مضارع مرفوع والألف فاعله والجملة جواب شرط مقدر لا محل لها.\r\n\r\n"},{"sura":55,"ayah":14,"words":[{"position":1,"arabic":"خَلَقَ","translation":"He created","transliteration":"khalaqa"},{"position":2,"arabic":"ٱلْإِنسَـٰنَ","translation":"the man","transliteration":"l-insāna"},{"position":3,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":4,"arabic":"صَلْصَـٰلٍۢ","translation":"clay","transliteration":"ṣalṣālin"},{"position":5,"arabic":"كَٱلْفَخَّارِ","translation":"like the pottery","transliteration":"kal-fakhāri"}],"e3rab":"(خَلَقَ الْإِنْسانَ) ماض ومفعوله والفاعل مستتر والجملة استئنافية لا محل لها (مِنْ صَلْصالٍ) متعلقان بالفعل (كَالْفَخَّارِ) متعلقان بمحذوف صفة صلصال.\r\n\r\n"},{"sura":55,"ayah":15,"words":[{"position":1,"arabic":"وَخَلَقَ","translation":"And He created","transliteration":"wakhalaqa"},{"position":2,"arabic":"ٱلْجَآنَّ","translation":"the jinn","transliteration":"l-jāna"},{"position":3,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":4,"arabic":"مَّارِجٍۢ","translation":"a smokeless flame","transliteration":"mārijin"},{"position":5,"arabic":"مِّن","translation":"of","transliteration":"min"},{"position":6,"arabic":"نَّارٍۢ","translation":"fire","transliteration":"nārin"}],"e3rab":"(وَخَلَقَ الْجَانَّ مِنْ مارِجٍ) إعرابها كسابقتها (مِنْ نارٍ) صفة مارج والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":55,"ayah":16,"words":[{"position":1,"arabic":"فَبِأَىِّ","translation":"So which","transliteration":"fabi-ayyi"},{"position":2,"arabic":"ءَالَآءِ","translation":"(of the) favors","transliteration":"ālāi"},{"position":3,"arabic":"رَبِّكُمَا","translation":"(of) your Lord","transliteration":"rabbikumā"},{"position":4,"arabic":"تُكَذِّبَانِ","translation":"will you both deny","transliteration":"tukadhibāni"}],"e3rab":"انظر الآية - 13 - .\r\n\r\n"},{"sura":55,"ayah":17,"words":[{"position":1,"arabic":"رَبُّ","translation":"Lord","transliteration":"rabbu"},{"position":2,"arabic":"ٱلْمَشْرِقَيْنِ","translation":"(of) the two Easts","transliteration":"l-mashriqayni"},{"position":3,"arabic":"وَرَبُّ","translation":"and Lord","transliteration":"warabbu"},{"position":4,"arabic":"ٱلْمَغْرِبَيْنِ","translation":"(of) the two Wests","transliteration":"l-maghribayni"}],"e3rab":"(رَبُّ) خبر لمبتدأ محذوف مضاف إلى المشرقين (الْمَشْرِقَيْنِ) مضاف إليه (وَرَبُّ الْمَغْرِبَيْنِ) معطوف على ما قبله والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":55,"ayah":18,"words":[{"position":1,"arabic":"فَبِأَىِّ","translation":"So which","transliteration":"fabi-ayyi"},{"position":2,"arabic":"ءَالَآءِ","translation":"(of the) favors","transliteration":"ālāi"},{"position":3,"arabic":"رَبِّكُمَا","translation":"(of) your Lord","transliteration":"rabbikumā"},{"position":4,"arabic":"تُكَذِّبَانِ","translation":"will you both deny","transliteration":"tukadhibāni"}],"e3rab":"انظر الآية - 13 - .\r\n\r\n"},{"sura":55,"ayah":19,"words":[{"position":1,"arabic":"مَرَجَ","translation":"He released","transliteration":"maraja"},{"position":2,"arabic":"ٱلْبَحْرَيْنِ","translation":"the two seas","transliteration":"l-baḥrayni"},{"position":3,"arabic":"يَلْتَقِيَانِ","translation":"meeting","transliteration":"yaltaqiyāni"}],"e3rab":"(مَرَجَ الْبَحْرَيْنِ) ماض ومفعوله والفاعل مستتر والجملة استئنافية (يَلْتَقِيانِ) مضارع مرفوع والألف فاعله والجملة حال.\r\n\r\n"},{"sura":55,"ayah":20,"words":[{"position":1,"arabic":"بَيْنَهُمَا","translation":"Between both of them","transliteration":"baynahumā"},{"position":2,"arabic":"بَرْزَخٌۭ","translation":"(is) a barrier","transliteration":"barzakhun"},{"position":3,"arabic":"لَّا","translation":"not","transliteration":"lā"},{"position":4,"arabic":"يَبْغِيَانِ","translation":"they transgress","transliteration":"yabghiyāni"}],"e3rab":"(مَرَجَ الْبَحْرَيْنِ) ماض ومفعوله والفاعل مستتر والجملة استئنافية (يَلْتَقِيانِ) مضارع مرفوع والألف فاعله والجملة حال.\r\n\r\n"},{"sura":55,"ayah":21,"words":[{"position":1,"arabic":"فَبِأَىِّ","translation":"So which","transliteration":"fabi-ayyi"},{"position":2,"arabic":"ءَالَآءِ","translation":"(of the) favors","transliteration":"ālāi"},{"position":3,"arabic":"رَبِّكُمَا","translation":"(of) your Lord","transliteration":"rabbikumā"},{"position":4,"arabic":"تُكَذِّبَانِ","translation":"will you both deny","transliteration":"tukadhibāni"}],"e3rab":"انظر الآية - 13 - .\r\n\r\n"},{"sura":55,"ayah":22,"words":[{"position":1,"arabic":"يَخْرُجُ","translation":"Come forth","transliteration":"yakhruju"},{"position":2,"arabic":"مِنْهُمَا","translation":"from both of them","transliteration":"min'humā"},{"position":3,"arabic":"ٱللُّؤْلُؤُ","translation":"the pearl","transliteration":"l-lu'lu-u"},{"position":4,"arabic":"وَٱلْمَرْجَانُ","translation":"and the coral","transliteration":"wal-marjānu"}],"e3rab":"(يَخْرُجُ) مضارع مرفوع (مِنْهُمَا) متعلقان بالفعل (اللُّؤْلُؤُ) فاعل مرفوع (وَالْمَرْجانُ) معطوف على اللؤلؤ والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":55,"ayah":23,"words":[{"position":1,"arabic":"فَبِأَىِّ","translation":"So which","transliteration":"fabi-ayyi"},{"position":2,"arabic":"ءَالَآءِ","translation":"(of the) favors","transliteration":"ālāi"},{"position":3,"arabic":"رَبِّكُمَا","translation":"(of) your Lord","transliteration":"rabbikumā"},{"position":4,"arabic":"تُكَذِّبَانِ","translation":"will you both deny","transliteration":"tukadhibāni"}],"e3rab":"انظر الآية - 13 - .\r\n\r\n"},{"sura":55,"ayah":24,"words":[{"position":1,"arabic":"وَلَهُ","translation":"And for Him","transliteration":"walahu"},{"position":2,"arabic":"ٱلْجَوَارِ","translation":"(are) the ships","transliteration":"l-jawāri"},{"position":3,"arabic":"ٱلْمُنشَـَٔاتُ","translation":"elevated","transliteration":"l-mu