[{"sura":106,"ayah":1,"words":[{"position":1,"arabic":"لِإِيلَـٰفِ","translation":"For (the) familiarity","transliteration":"liīlāfi"},{"position":2,"arabic":"قُرَيْشٍ","translation":"(of the) Quraish","transliteration":"qurayshin"}],"e3rab":"(لِإِيلافِ) الجار والمجرور متعلقان بالفعل المتأخر ليعبدوا (قُرَيْشٍ) مضاف إليه.\r\n\r\n"},{"sura":106,"ayah":2,"words":[{"position":1,"arabic":"إِۦلَـٰفِهِمْ","translation":"Their familiarity","transliteration":"īlāfihim"},{"position":2,"arabic":"رِحْلَةَ","translation":"(with the) journey","transliteration":"riḥ'lata"},{"position":3,"arabic":"ٱلشِّتَآءِ","translation":"(of) winter","transliteration":"l-shitāi"},{"position":4,"arabic":"وَٱلصَّيْفِ","translation":"and summer","transliteration":"wal-ṣayfi"}],"e3rab":"(إِيلافِهِمْ) بدل مما قبله (رِحْلَةَ) مفعول به للمصدر (الشِّتاءِ) مضاف إليه (وَالصَّيْفِ) معطوف على الشتاء.\r\n\r\n"},{"sura":106,"ayah":3,"words":[{"position":1,"arabic":"فَلْيَعْبُدُوا۟","translation":"So let them worship","transliteration":"falyaʿbudū"},{"position":2,"arabic":"رَبَّ","translation":"(the) Lord","transliteration":"rabba"},{"position":3,"arabic":"هَـٰذَا","translation":"(of) this","transliteration":"hādhā"},{"position":4,"arabic":"ٱلْبَيْتِ","translation":"House","transliteration":"l-bayti"}],"e3rab":"(فَلْيَعْبُدُوا) الفاء الفصيحة ومضارع مجزوم باللام والواو فاعله.\r\n\r\n(رَبَّ هذَا) مفعول به مضاف إلى اسم الإشارة.\r\n\r\n(الْبَيْتِ) بدل من اسم الإشارة والجملة جواب شرط مقدر لا محل لها.\r\n\r\n"},{"sura":106,"ayah":4,"words":[{"position":1,"arabic":"ٱلَّذِىٓ","translation":"The One Who","transliteration":"alladhī"},{"position":2,"arabic":"أَطْعَمَهُم","translation":"feeds them","transliteration":"aṭʿamahum"},{"position":3,"arabic":"مِّن","translation":"[from]","transliteration":"min"},{"position":4,"arabic":"جُوعٍۢ","translation":"(against) hunger","transliteration":"jūʿin"},{"position":5,"arabic":"وَءَامَنَهُم","translation":"and gives them security","transliteration":"waāmanahum"},{"position":6,"arabic":"مِّنْ","translation":"from","transliteration":"min"},{"position":7,"arabic":"خَوْفٍۭ","translation":"fear","transliteration":"khawfin"}],"e3rab":"(الَّذِي) اسم موصول بدل من رب (أَطْعَمَهُمْ) ماض ومفعوله والفاعل مستتر والجملة صلة (مِنْ جُوعٍ) متعلقان بالفعل (وَآمَنَهُمْ مِنْ خَوْفٍ) معطوف على ما قبله.\r\n\r\n"}]