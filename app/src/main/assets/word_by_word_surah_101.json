[{"sura":101,"ayah":1,"words":[{"position":1,"arabic":"ٱلْقَارِعَةُ","translation":"The Striking Calamity","transliteration":"al-qāriʿatu"}],"e3rab":"«الْقارِعَةُ» مبتدأ مرفوع\r\n\r\n"},{"sura":101,"ayah":2,"words":[{"position":1,"arabic":"مَا","translation":"What","transliteration":"mā"},{"position":2,"arabic":"ٱلْقَارِعَةُ","translation":"(is) the Striking Calamity","transliteration":"l-qāriʿatu"}],"e3rab":"«مَا الْقارِعَةُ» مبتدأ وخبره والجملة خبر القارعة والجملة الاسمية ابتدائية لا محل لها.\r\n\r\n"},{"sura":101,"ayah":3,"words":[{"position":1,"arabic":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"arabic":"أَدْرَىٰكَ","translation":"will make you know","transliteration":"adrāka"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"ٱلْقَارِعَةُ","translation":"(is) the Striking Calamity","transliteration":"l-qāriʿatu"}],"e3rab":"(وَما) الواو حرف استئناف (ما) اسم استفهام مبتدأ (أَدْراكَ) ماض ومفعوله والفاعل مستتر والجملة الفعلية خبر ما والجملة الاسمية مستأنفة لا محل لها (مَا الْقارِعَةُ) مبتدأ وخبره والجملة سدت مسد مفعول أدراك الثاني.\r\n\r\n"},{"sura":101,"ayah":4,"words":[{"position":1,"arabic":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"arabic":"يَكُونُ","translation":"will be","transliteration":"yakūnu"},{"position":3,"arabic":"ٱلنَّاسُ","translation":"the mankind","transliteration":"l-nāsu"},{"position":4,"arabic":"كَٱلْفَرَاشِ","translation":"like moths","transliteration":"kal-farāshi"},{"position":5,"arabic":"ٱلْمَبْثُوثِ","translation":"scattered","transliteration":"l-mabthūthi"}],"e3rab":"(يَوْمَ) ظرف زمان (يَكُونُ النَّاسُ) مضارع ناقص واسمه (كَالْفَراشِ) خبر يكون (الْمَبْثُوثِ) صفة الفراش. والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":101,"ayah":5,"words":[{"position":1,"arabic":"وَتَكُونُ","translation":"And will be","transliteration":"watakūnu"},{"position":2,"arabic":"ٱلْجِبَالُ","translation":"the mountains","transliteration":"l-jibālu"},{"position":3,"arabic":"كَٱلْعِهْنِ","translation":"like wool","transliteration":"kal-ʿih'ni"},{"position":4,"arabic":"ٱلْمَنفُوشِ","translation":"fluffed up","transliteration":"l-manfūshi"}],"e3rab":"معطوفة على ما قبلها والإعراب واضح.\r\n\r\n"},{"sura":101,"ayah":6,"words":[{"position":1,"arabic":"فَأَمَّا","translation":"Then as for","transliteration":"fa-ammā"},{"position":2,"arabic":"مَن","translation":"(him) whose","transliteration":"man"},{"position":3,"arabic":"ثَقُلَتْ","translation":"(are) heavy","transliteration":"thaqulat"},{"position":4,"arabic":"مَوَٰزِينُهُۥ","translation":"his scales","transliteration":"mawāzīnuhu"}],"e3rab":"(فَأَمَّا) الفاء حرف استئناف (أما) حرف شرط وتفصيل (مَنْ) اسم موصول مبتدأ (ثَقُلَتْ مَوازِينُهُ) ماض وفاعله والجملة صلة.\r\n\r\n"},{"sura":101,"ayah":7,"words":[{"position":1,"arabic":"فَهُوَ","translation":"Then he","transliteration":"fahuwa"},{"position":2,"arabic":"فِى","translation":"(will be) in","transliteration":"fī"},{"position":3,"arabic":"عِيشَةٍۢ","translation":"a life","transliteration":"ʿīshatin"},{"position":4,"arabic":"رَّاضِيَةٍۢ","translation":"pleasant","transliteration":"rāḍiyatin"}],"e3rab":"(فَهُوَ) الفاء رابطة لأن الموصول يشبه الشرط (هو) مبتدأ (فِي عِيشَةٍ) خبر (راضِيَةٍ) صفة والجملة الاسمية خبر المبتدأ من.\r\n\r\n"},{"sura":101,"ayah":8,"words":[{"position":1,"arabic":"وَأَمَّا","translation":"But as for","transliteration":"wa-ammā"},{"position":2,"arabic":"مَنْ","translation":"(him) whose","transliteration":"man"},{"position":3,"arabic":"خَفَّتْ","translation":"(are) light","transliteration":"khaffat"},{"position":4,"arabic":"مَوَٰزِينُهُۥ","translation":"his scales","transliteration":"mawāzīnuhu"}],"e3rab":"معطوفة على ما قبلها والإعراب واضح.\r\n\r\n"},{"sura":101,"ayah":9,"words":[{"position":1,"arabic":"فَأُمُّهُۥ","translation":"His abode","transliteration":"fa-ummuhu"},{"position":2,"arabic":"هَاوِيَةٌۭ","translation":"(will be the) Pit","transliteration":"hāwiyatun"}],"e3rab":"(فَأُمُّهُ هاوِيَةٌ) الفاء رابطة ومبتدأ وخبره والجملة الاسمية خبر المبتدأ من.\r\n\r\n"},{"sura":101,"ayah":10,"words":[{"position":1,"arabic":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"arabic":"أَدْرَىٰكَ","translation":"will make you know","transliteration":"adrāka"},{"position":3,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":4,"arabic":"هِيَهْ","translation":"it is","transliteration":"hiyah"}],"e3rab":"مثل إعراب الآية - 3 - والهاء للسكت.\r\n\r\n"},{"sura":101,"ayah":11,"words":[{"position":1,"arabic":"نَارٌ","translation":"A Fire","transliteration":"nārun"},{"position":2,"arabic":"حَامِيَةٌۢ","translation":"intensely hot","transliteration":"ḥāmiyatun"}],"e3rab":"(نارٌ) خبر لمبتدأ محذوف (حامِيَةٌ) صفة والجملة مفسرة.\r\n\r\n"}]