[{"sura":99,"ayah":1,"words":[{"position":1,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":2,"arabic":"زُلْزِلَتِ","translation":"is shaken","transliteration":"zul'zilati"},{"position":3,"arabic":"ٱلْأَرْضُ","translation":"the earth","transliteration":"l-arḍu"},{"position":4,"arabic":"زِلْزَالَهَا","translation":"(with) its earthquake","transliteration":"zil'zālahā"}],"e3rab":"(إِذا زُلْزِلَتِ) إذا ظرفية شرطية غير جازمة وماض مبني للمجهول (الْأَرْضُ) نائب فاعل (زِلْزالَها) مفعول مطلق والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":99,"ayah":2,"words":[{"position":1,"arabic":"وَأَخْرَجَتِ","translation":"And brings forth","transliteration":"wa-akhrajati"},{"position":2,"arabic":"ٱلْأَرْضُ","translation":"the earth","transliteration":"l-arḍu"},{"position":3,"arabic":"أَثْقَالَهَا","translation":"its burdens","transliteration":"athqālahā"}],"e3rab":"(وَأَخْرَجَتِ الْأَرْضُ أَثْقالَها) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":99,"ayah":3,"words":[{"position":1,"arabic":"وَقَالَ","translation":"And says","transliteration":"waqāla"},{"position":2,"arabic":"ٱلْإِنسَـٰنُ","translation":"man","transliteration":"l-insānu"},{"position":3,"arabic":"مَا","translation":"What","transliteration":"mā"},{"position":4,"arabic":"لَهَا","translation":"(is) with it","transliteration":"lahā"}],"e3rab":"(وَقالَ الْإِنْسانُ) ماض وفاعله والجملة معطوفة على ما قبلها (ما) اسم استفهام مبتدأ (لَها) متعلقان بمحذوف خبر المبتدأ والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":99,"ayah":4,"words":[{"position":1,"arabic":"يَوْمَئِذٍۢ","translation":"That Day","transliteration":"yawma-idhin"},{"position":2,"arabic":"تُحَدِّثُ","translation":"it will report","transliteration":"tuḥaddithu"},{"position":3,"arabic":"أَخْبَارَهَا","translation":"its news","transliteration":"akhbārahā"}],"e3rab":"(يَوْمَئِذٍ) ظرف مضاف إلى مثله وهو بدل من إذا (تُحَدِّثُ) مضارع فاعله مستتر (أَخْبارَها) مفعول به والجملة جواب إذا لا محل لها.\r\n\r\n"},{"sura":99,"ayah":5,"words":[{"position":1,"arabic":"بِأَنَّ","translation":"Because","transliteration":"bi-anna"},{"position":2,"arabic":"رَبَّكَ","translation":"your Lord","transliteration":"rabbaka"},{"position":3,"arabic":"أَوْحَىٰ","translation":"inspired","transliteration":"awḥā"},{"position":4,"arabic":"لَهَا","translation":"[to] it","transliteration":"lahā"}],"e3rab":"(بِأَنَّ رَبَّكَ) الباء حرف جر وأن واسمها (أَوْحى) ماض فاعله مستتر (لَها) متعلقان بالفعل والجملة خبر أن والمصدر المؤول من أن وما بعدها في محل جر بالباء والجار والمجرور متعلقان بتحدث.\r\n\r\n"},{"sura":99,"ayah":6,"words":[{"position":1,"arabic":"يَوْمَئِذٍۢ","translation":"That Day","transliteration":"yawma-idhin"},{"position":2,"arabic":"يَصْدُرُ","translation":"will proceed","transliteration":"yaṣduru"},{"position":3,"arabic":"ٱلنَّاسُ","translation":"the mankind","transliteration":"l-nāsu"},{"position":4,"arabic":"أَشْتَاتًۭا","translation":"(in) scattered groups","transliteration":"ashtātan"},{"position":5,"arabic":"لِّيُرَوْا۟","translation":"to be shown","transliteration":"liyuraw"},{"position":6,"arabic":"أَعْمَـٰلَهُمْ","translation":"their deeds","transliteration":"aʿmālahum"}],"e3rab":"(يَوْمَئِذٍ) ظرف مضاف إلى مثله وهو بدل من سابقه (يَصْدُرُ النَّاسُ) مضارع وفاعله (أَشْتاتاً) حال (لِيُرَوْا) مضارع مبني للمجهول منصوب بأن مضمرة بعد لام التعليل والواو نائب فاعل (أَعْمالَهُمْ) مفعول به، والمصدر المؤول من أن وما بعدها في محل جر باللام والجار والمجرور متعلقان بالفعل يصدر.\r\n\r\n"},{"sura":99,"ayah":7,"words":[{"position":1,"arabic":"فَمَن","translation":"So whoever","transliteration":"faman"},{"position":2,"arabic":"يَعْمَلْ","translation":"does","transliteration":"yaʿmal"},{"position":3,"arabic":"مِثْقَالَ","translation":"(equal to the) weight","transliteration":"mith'qāla"},{"position":4,"arabic":"ذَرَّةٍ","translation":"(of) an atom","transliteration":"dharratin"},{"position":5,"arabic":"خَيْرًۭا","translation":"good","transliteration":"khayran"},{"position":6,"arabic":"يَرَهُۥ","translation":"will see it","transliteration":"yarahu"}],"e3rab":"(فَمَنْ) الفاء حرف استئناف (من) اسم شرط جازم مبتدأ (يَعْمَلْ) مضارع مجزوم لأنه فعل الشرط والفاعل مستتر (مِثْقالَ ذَرَّةٍ) مفعول به مضاف إلى ذرة (خَيْراً) تمييز (يَرَهُ) مضارع مجزوم لأنه جواب الشرط والهاء مفعول به والفاعل مستتر والجملة جواب الشرط لا محل لها وجملتا الشرط والجواب خبر المبتدأ من وجملة من.. مستأنفة لا محل لها.\r\n\r\n"},{"sura":99,"ayah":8,"words":[{"position":1,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":2,"arabic":"يَعْمَلْ","translation":"does","transliteration":"yaʿmal"},{"position":3,"arabic":"مِثْقَالَ","translation":"(equal to the) weight","transliteration":"mith'qāla"},{"position":4,"arabic":"ذَرَّةٍۢ","translation":"(of) an atom","transliteration":"dharratin"},{"position":5,"arabic":"شَرًّۭا","translation":"evil","transliteration":"sharran"},{"position":6,"arabic":"يَرَهُۥ","translation":"will see it","transliteration":"yarahu"}],"e3rab":"معطوفة على ما قبلها والإعراب واضح.\r\n\r\n"}]