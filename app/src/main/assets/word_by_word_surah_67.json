[{"sura":67,"ayah":1,"words":[{"position":1,"arabic":"تَبَـٰرَكَ","translation":"Blessed is","transliteration":"tabāraka"},{"position":2,"arabic":"ٱلَّذِى","translation":"He","transliteration":"alladhī"},{"position":3,"arabic":"بِيَدِهِ","translation":"in Whose Hand","transliteration":"biyadihi"},{"position":4,"arabic":"ٱلْمُلْكُ","translation":"(is) the Dominion","transliteration":"l-mul'ku"},{"position":5,"arabic":"وَهُوَ","translation":"and He","transliteration":"wahuwa"},{"position":6,"arabic":"عَلَىٰ","translation":"(is) over","transliteration":"ʿalā"},{"position":7,"arabic":"كُلِّ","translation":"every","transliteration":"kulli"},{"position":8,"arabic":"شَىْءٍۢ","translation":"thing","transliteration":"shayin"},{"position":9,"arabic":"قَدِيرٌ","translation":"All-Powerful","transliteration":"qadīrun"}],"e3rab":"(تَبارَكَ الَّذِي) ماض وفاعله والجملة ابتدائية لا محل لها (بِيَدِهِ) خبر مقدم (الْمُلْكُ) مبتدأ مؤخر والجملة صلة الموصول (وَهُوَ) مبتدأ (عَلى كُلِّ) متعلقان بقدير (شَيْءٍ) مضاف إليه (قَدِيرٌ) خبر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":67,"ayah":2,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"The One Who","transliteration":"alladhī"},{"position":2,"arabic":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":3,"arabic":"ٱلْمَوْتَ","translation":"death","transliteration":"l-mawta"},{"position":4,"arabic":"وَٱلْحَيَوٰةَ","translation":"and life","transliteration":"wal-ḥayata"},{"position":5,"arabic":"لِيَبْلُوَكُمْ","translation":"that He may test you","transliteration":"liyabluwakum"},{"position":6,"arabic":"أَيُّكُمْ","translation":"which of you","transliteration":"ayyukum"},{"position":7,"arabic":"أَحْسَنُ","translation":"(is) best","transliteration":"aḥsanu"},{"position":8,"arabic":"عَمَلًۭا ۚ","translation":"(in) deed","transliteration":"ʿamalan"},{"position":9,"arabic":"وَهُوَ","translation":"And He","transliteration":"wahuwa"},{"position":10,"arabic":"ٱلْعَزِيزُ","translation":"(is) the All-Mighty","transliteration":"l-ʿazīzu"},{"position":11,"arabic":"ٱلْغَفُورُ","translation":"the Oft-Forgiving","transliteration":"l-ghafūru"}],"e3rab":"(الَّذِي) بدل (خَلَقَ) ماض وفاعله مستتر (الْمَوْتَ) مفعول به والجملة صلة (وَالْحَياةَ) معطوفة على الموت.\r\n\r\n(لِيَبْلُوَكُمْ) مضارع منصوب بأن مضمرة بعد لام التعليل والفاعل مستتر والكاف مفعول به والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بخلق (أَيُّكُمْ) اسم استفهام مبتدأ (أَحْسَنُ) خبره (عَمَلًا) تمييز والجملة الاسمية مفعول به ثان ليبلوكم (وَهُوَ الْعَزِيزُ الْغَفُورُ) مبتدأ وخبراه والجملة حال.\r\n\r\n"},{"sura":67,"ayah":3,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"The One Who","transliteration":"alladhī"},{"position":2,"arabic":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":3,"arabic":"سَبْعَ","translation":"seven","transliteration":"sabʿa"},{"position":4,"arabic":"سَمَـٰوَٰتٍۢ","translation":"heavens","transliteration":"samāwātin"},{"position":5,"arabic":"طِبَاقًۭا ۖ","translation":"one above another","transliteration":"ṭibāqan"},{"position":6,"arabic":"مَّا","translation":"Not","transliteration":"mā"},{"position":7,"arabic":"تَرَىٰ","translation":"you see","transliteration":"tarā"},{"position":8,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":9,"arabic":"خَلْقِ","translation":"(the) creation","transliteration":"khalqi"},{"position":10,"arabic":"ٱلرَّحْمَـٰنِ","translation":"(of) the Most Gracious","transliteration":"l-raḥmāni"},{"position":11,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":12,"arabic":"تَفَـٰوُتٍۢ ۖ","translation":"fault","transliteration":"tafāwutin"},{"position":13,"arabic":"فَٱرْجِعِ","translation":"So return","transliteration":"fa-ir'jiʿi"},{"position":14,"arabic":"ٱلْبَصَرَ","translation":"the vision","transliteration":"l-baṣara"},{"position":15,"arabic":"هَلْ","translation":"can","transliteration":"hal"},{"position":16,"arabic":"تَرَىٰ","translation":"you see","transliteration":"tarā"},{"position":17,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":18,"arabic":"فُطُورٍۢ","translation":"flaw","transliteration":"fuṭūrin"}],"e3rab":"(الَّذِي) بدل ثان من اسم الموصول (خَلَقَ) ماض فاعله مستتر (سَبْعَ سَماواتٍ) مفعول به مضاف إلى سموات والجملة صلة (طِباقاً) صفة سبع (ما تَرى) ما نافية ومضارع فاعله مستتر (فِي خَلْقِ) متعلقان بالفعل (الرَّحْمنِ) مضاف إليه (مِنْ تَفاوُتٍ) مجرور لفظا بمن الزائدة منصوب محلا مفعول ترى والجملة استئنافية لا محل لها (فَارْجِعِ) الفاء الفصيحة وأمر فاعله مستتر (الْبَصَرَ) مفعول به والجملة جواب شرط مقدر لا محل لها (هَلْ تَرى) هل حرف استفهام ومضارع فاعله مستتر (مِنْ فُطُورٍ) فطور مجرور لفظا بمن الزائدة منصوب محلا مفعول ترى والجملة في محل نصب بفعل محذوف.\r\n\r\n"},{"sura":67,"ayah":4,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"ٱرْجِعِ","translation":"return","transliteration":"ir'jiʿi"},{"position":3,"arabic":"ٱلْبَصَرَ","translation":"the vision","transliteration":"l-baṣara"},{"position":4,"arabic":"كَرَّتَيْنِ","translation":"twice (again)","transliteration":"karratayni"},{"position":5,"arabic":"يَنقَلِبْ","translation":"Will return","transliteration":"yanqalib"},{"position":6,"arabic":"إِلَيْكَ","translation":"to you","transliteration":"ilayka"},{"position":7,"arabic":"ٱلْبَصَرُ","translation":"the vision","transliteration":"l-baṣaru"},{"position":8,"arabic":"خَاسِئًۭا","translation":"humbled","transliteration":"khāsi-an"},{"position":9,"arabic":"وَهُوَ","translation":"while it","transliteration":"wahuwa"},{"position":10,"arabic":"حَسِيرٌۭ","translation":"(is) fatigued","transliteration":"ḥasīrun"}],"e3rab":"(ثُمَّ ارْجِعِ الْبَصَرَ) ثم حرف عطف وأمر ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها (كَرَّتَيْنِ) نائب مفعول مطلق (يَنْقَلِبْ) مضارع مجزوم لأنه جواب الطلب (إِلَيْكَ) متعلقان بالفعل (الْبَصَرَ) فاعل (خاسِئاً) حال والجملة جواب شرط مقدر لا محل لها (وَهُوَ حَسِيرٌ) مبتدأ وخبره والجملة حال.\r\n\r\n"},{"sura":67,"ayah":5,"words":[{"position":1,"arabic":"وَلَقَدْ","translation":"And certainly","transliteration":"walaqad"},{"position":2,"arabic":"زَيَّنَّا","translation":"We have beautified","transliteration":"zayyannā"},{"position":3,"arabic":"ٱلسَّمَآءَ","translation":"the heaven","transliteration":"l-samāa"},{"position":4,"arabic":"ٱلدُّنْيَا","translation":"nearest","transliteration":"l-dun'yā"},{"position":5,"arabic":"بِمَصَـٰبِيحَ","translation":"with lamps","transliteration":"bimaṣābīḥa"},{"position":6,"arabic":"وَجَعَلْنَـٰهَا","translation":"and We have made them","transliteration":"wajaʿalnāhā"},{"position":7,"arabic":"رُجُومًۭا","translation":"(as) missiles","transliteration":"rujūman"},{"position":8,"arabic":"لِّلشَّيَـٰطِينِ ۖ","translation":"for the devils","transliteration":"lilshayāṭīni"},{"position":9,"arabic":"وَأَعْتَدْنَا","translation":"and We have prepared","transliteration":"wa-aʿtadnā"},{"position":10,"arabic":"لَهُمْ","translation":"for them","transliteration":"lahum"},{"position":11,"arabic":"عَذَابَ","translation":"punishment","transliteration":"ʿadhāba"},{"position":12,"arabic":"ٱلسَّعِيرِ","translation":"(of) the Blaze","transliteration":"l-saʿīri"}],"e3rab":"(وَلَقَدْ زَيَّنَّا السَّماءَ) الواو واو القسم واللام واقعة في جواب القسم المحذوف (قد) حرف تحقيق وماض وفاعله ومفعوله (الدُّنْيا) صفة (بِمَصابِيحَ) متعلقان بزيّنا والجملة جواب القسم لا محل لها (وَجَعَلْناها) ماض وفاعله ومفعوله الأول (رُجُوماً) مفعوله الثاني (لِلشَّياطِينِ) متعلقان برجوما والجملة معطوفة على ما قبلها.\r\n\r\n(وَأَعْتَدْنا) ماض وفاعله والجملة معطوفة على جملة زيّنا لا محل لها (لَهُمْ) متعلقان بالفعل (عَذابَ) مفعول به مضاف إلى (السَّعِيرِ) مضاف إليه.\r\n\r\n"},{"sura":67,"ayah":6,"words":[{"position":1,"arabic":"وَلِلَّذِينَ","translation":"And for those who","transliteration":"walilladhīna"},{"position":2,"arabic":"كَفَرُوا۟","translation":"disbelieved","transliteration":"kafarū"},{"position":3,"arabic":"بِرَبِّهِمْ","translation":"in their Lord","transliteration":"birabbihim"},{"position":4,"arabic":"عَذَابُ","translation":"(is the) punishment","transliteration":"ʿadhābu"},{"position":5,"arabic":"جَهَنَّمَ ۖ","translation":"(of) Hell","transliteration":"jahannama"},{"position":6,"arabic":"وَبِئْسَ","translation":"and wretched is","transliteration":"wabi'sa"},{"position":7,"arabic":"ٱلْمَصِيرُ","translation":"the destination","transliteration":"l-maṣīru"}],"e3rab":"(وَلِلَّذِينَ) خبر مقدم (كَفَرُوا) ماض وفاعله (بِرَبِّهِمْ) متعلقان بالفعل والجملة صلة الذين (عَذابُ) مبتدأ مؤخر (جَهَنَّمَ) مضاف إليه والجملة الاسمية معطوفة على ما قبلها (وَبِئْسَ الْمَصِيرُ) ماض جامد وفاعله والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":67,"ayah":7,"words":[{"position":1,"arabic":"إِذَآ","translation":"When","transliteration":"idhā"},{"position":2,"arabic":"أُلْقُوا۟","translation":"they are thrown","transliteration":"ul'qū"},{"position":3,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":4,"arabic":"سَمِعُوا۟","translation":"they will hear","transliteration":"samiʿū"},{"position":5,"arabic":"لَهَا","translation":"from it","transliteration":"lahā"},{"position":6,"arabic":"شَهِيقًۭا","translation":"an inhaling","transliteration":"shahīqan"},{"position":7,"arabic":"وَهِىَ","translation":"while it","transliteration":"wahiya"},{"position":8,"arabic":"تَفُورُ","translation":"boils up","transliteration":"tafūru"}],"e3rab":"(إِذا أُلْقُوا) إذا ظرفية شرطية غير جازمة وماض مبني للمجهول والواو نائب فاعل والجملة في محل جر بالإضافة (فِيها) متعلقان بالفعل (سَمِعُوا) ماض وفاعله والجملة جواب الشرط لا محل لها (لَها) متعلقان بالفعل (شَهِيقاً) مفعول به (وَهِيَ تَفُورُ) مبتدأ ومضارع فاعله مستتر والجملة خبر المبتدأ والجملة الاسمية حال.\r\n\r\n"},{"sura":67,"ayah":8,"words":[{"position":1,"arabic":"تَكَادُ","translation":"It almost","transliteration":"takādu"},{"position":2,"arabic":"تَمَيَّزُ","translation":"bursts","transliteration":"tamayyazu"},{"position":3,"arabic":"مِنَ","translation":"from","transliteration":"mina"},{"position":4,"arabic":"ٱلْغَيْظِ ۖ","translation":"rage","transliteration":"l-ghayẓi"},{"position":5,"arabic":"كُلَّمَآ","translation":"Every time","transliteration":"kullamā"},{"position":6,"arabic":"أُلْقِىَ","translation":"is thrown","transliteration":"ul'qiya"},{"position":7,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":8,"arabic":"فَوْجٌۭ","translation":"a group","transliteration":"fawjun"},{"position":9,"arabic":"سَأَلَهُمْ","translation":"(will) ask them","transliteration":"sa-alahum"},{"position":10,"arabic":"خَزَنَتُهَآ","translation":"its keepers","transliteration":"khazanatuhā"},{"position":11,"arabic":"أَلَمْ","translation":"Did not","transliteration":"alam"},{"position":12,"arabic":"يَأْتِكُمْ","translation":"come to you","transliteration":"yatikum"},{"position":13,"arabic":"نَذِيرٌۭ","translation":"a warner","transliteration":"nadhīrun"}],"e3rab":"(تَكادُ) مضارع ناقص اسمه مستتر (تَمَيَّزُ) مضارع فاعله مستتر والجملة خبر تكاد وجملة تكاد..\r\n\r\nاستئنافية لا محل لها (مِنَ الْغَيْظِ) متعلقان بالفعل (كُلَّما): أداة شرط غير جازمة (أُلْقِيَ) ماض مبني للمجهول (فِيها) متعلقان بالفعل (فَوْجٌ) نائب فاعل والجملة في محل جر بالإضافة (سَأَلَهُمْ) ماض ومفعوله (خَزَنَتُها) فاعله والجملة جواب الشرط لا محل لها (أَلَمْ يَأْتِكُمْ) الهمزة للاستفهام التوبيخي ومضارع مجزوم بلم والكاف مفعول به (نَذِيرٌ) فاعل والجملة مفعول به ثان لسأل.\r\n\r\n"},{"sura":67,"ayah":9,"words":[{"position":1,"arabic":"قَالُوا۟","translation":"They will say","transliteration":"qālū"},{"position":2,"arabic":"بَلَىٰ","translation":"Yes","transliteration":"balā"},{"position":3,"arabic":"قَدْ","translation":"indeed","transliteration":"qad"},{"position":4,"arabic":"جَآءَنَا","translation":"came to us","transliteration":"jāanā"},{"position":5,"arabic":"نَذِيرٌۭ","translation":"a warner","transliteration":"nadhīrun"},{"position":6,"arabic":"فَكَذَّبْنَا","translation":"but we denied","transliteration":"fakadhabnā"},{"position":7,"arabic":"وَقُلْنَا","translation":"and we said","transliteration":"waqul'nā"},{"position":8,"arabic":"مَا","translation":"Not","transliteration":"mā"},{"position":9,"arabic":"نَزَّلَ","translation":"has sent down","transliteration":"nazzala"},{"position":10,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":11,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":12,"arabic":"شَىْءٍ","translation":"thing","transliteration":"shayin"},{"position":13,"arabic":"إِنْ","translation":"Not","transliteration":"in"},{"position":14,"arabic":"أَنتُمْ","translation":"you (are)","transliteration":"antum"},{"position":15,"arabic":"إِلَّا","translation":"but","transliteration":"illā"},{"position":16,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":17,"arabic":"ضَلَـٰلٍۢ","translation":"error","transliteration":"ḍalālin"},{"position":18,"arabic":"كَبِيرٍۢ","translation":"great","transliteration":"kabīrin"}],"e3rab":"(قالُوا) ماض وفاعله والجملة استئنافية لا محل لها (بَلى) حرف جواب (قَدْ جاءَنا نَذِيرٌ) قد حرف تحقيق وماض ومفعوله وفاعله والجملة مقول القول (فَكَذَّبْنا) ماض وفاعله والجملة معطوفة على ما قبلها (وَقُلْنا) معطوف على كذبنا (ما نَزَّلَ اللَّهُ) ما نافية وماض وفاعله (مِنْ شَيْءٍ) شيء مجرور لفظا بمن الزائدة منصوب محلا مفعول به والجملة مقول القول (إِنْ) نافية (أَنْتُمْ) مبتدأ (إِلَّا) حرف حصر (فِي ضَلالٍ) خبر المبتدأ (كَبِيرٍ) صفة والجملة مقول القول.\r\n\r\n"},{"sura":67,"ayah":10,"words":[{"position":1,"arabic":"وَقَالُوا۟","translation":"And they will say","transliteration":"waqālū"},{"position":2,"arabic":"لَوْ","translation":"If","transliteration":"law"},{"position":3,"arabic":"كُنَّا","translation":"we had","transliteration":"kunnā"},{"position":4,"arabic":"نَسْمَعُ","translation":"listened","transliteration":"nasmaʿu"},{"position":5,"arabic":"أَوْ","translation":"or","transliteration":"aw"},{"position":6,"arabic":"نَعْقِلُ","translation":"reasoned","transliteration":"naʿqilu"},{"position":7,"arabic":"مَا","translation":"not","transliteration":"mā"},{"position":8,"arabic":"كُنَّا","translation":"we (would) have been","transliteration":"kunnā"},{"position":9,"arabic":"فِىٓ","translation":"among","transliteration":"fī"},{"position":10,"arabic":"أَصْحَـٰبِ","translation":"(the) companions","transliteration":"aṣḥābi"},{"position":11,"arabic":"ٱلسَّعِيرِ","translation":"(of) the Blaze","transliteration":"l-saʿīri"}],"e3rab":"(وَقالُوا) ماض وفاعله والجملة معطوفة على ما قبلها (لَوْ) شرطية غير جازمة (كُنَّا نَسْمَعُ) كان واسمها ومضارع فاعله مستتر والجملة خبر كنا وجملة كنا.. ابتدائية لا محل لها (أَوْ) عاطفة (نَعْقِلُ) معطوف على نسمع (ما) نافية (كُنَّا) كان واسمها (فِي أَصْحابِ) خبر كنا (السَّعِيرِ) مضاف إليه وجملة ما كنا.،. جواب الشرط لا محل لها. وجملة لووما بعدها مقول القول.\r\n\r\n"},{"sura":67,"ayah":11,"words":[{"position":1,"arabic":"فَٱعْتَرَفُوا۟","translation":"Then they (will) confess","transliteration":"fa-iʿ'tarafū"},{"position":2,"arabic":"بِذَنۢبِهِمْ","translation":"their sins","transliteration":"bidhanbihim"},{"position":3,"arabic":"فَسُحْقًۭا","translation":"so away with","transliteration":"fasuḥ'qan"},{"position":4,"arabic":"لِّأَصْحَـٰبِ","translation":"(the) companions","transliteration":"li-aṣḥābi"},{"position":5,"arabic":"ٱلسَّعِيرِ","translation":"(of) the Blaze","transliteration":"l-saʿīri"}],"e3rab":"(فَاعْتَرَفُوا) ماض وفاعله (بِذَنْبِهِمْ) متعلقان بالفعل والجملة استئنافية لا محل لها.\r\n\r\n(فَسُحْقاً) الفاء حرف عطف (سحقا) مفعول مطلق لفعل محذوف (لِأَصْحابِ) متعلقان بسحقا (السَّعِيرِ) مضاف إليه.\r\n\r\n"},{"sura":67,"ayah":12,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"يَخْشَوْنَ","translation":"fear","transliteration":"yakhshawna"},{"position":4,"arabic":"رَبَّهُم","translation":"their Lord","transliteration":"rabbahum"},{"position":5,"arabic":"بِٱلْغَيْبِ","translation":"unseen","transliteration":"bil-ghaybi"},{"position":6,"arabic":"لَهُم","translation":"for them","transliteration":"lahum"},{"position":7,"arabic":"مَّغْفِرَةٌۭ","translation":"(is) forgiveness","transliteration":"maghfiratun"},{"position":8,"arabic":"وَأَجْرٌۭ","translation":"and a reward","transliteration":"wa-ajrun"},{"position":9,"arabic":"كَبِيرٌۭ","translation":"great","transliteration":"kabīrun"}],"e3rab":"(إِنَّ الَّذِينَ) إن واسمها (يَخْشَوْنَ) مضارع مرفوع والواو فاعله والجملة الفعلية صلة (رَبَّهُمْ) مفعول به (بِالْغَيْبِ) متعلقان بالفعل (لَهُمْ) خبر مقدم (مَغْفِرَةٌ) مبتدأ مؤخر والجملة الاسمية خبر إن وجملة إن استئنافية لا محل لها (وَأَجْرٌ) معطوف على مغفرة (كَبِيرٌ) صفة.\r\n\r\n"},{"sura":67,"ayah":13,"words":[{"position":1,"arabic":"وَأَسِرُّوا۟","translation":"And conceal","transliteration":"wa-asirrū"},{"position":2,"arabic":"قَوْلَكُمْ","translation":"your speech","transliteration":"qawlakum"},{"position":3,"arabic":"أَوِ","translation":"or","transliteration":"awi"},{"position":4,"arabic":"ٱجْهَرُوا۟","translation":"proclaim","transliteration":"ij'harū"},{"position":5,"arabic":"بِهِۦٓ ۖ","translation":"it","transliteration":"bihi"},{"position":6,"arabic":"إِنَّهُۥ","translation":"Indeed, He","transliteration":"innahu"},{"position":7,"arabic":"عَلِيمٌۢ","translation":"(is the) All-Knower","transliteration":"ʿalīmun"},{"position":8,"arabic":"بِذَاتِ","translation":"of what (is in)","transliteration":"bidhāti"},{"position":9,"arabic":"ٱلصُّدُورِ","translation":"the breasts","transliteration":"l-ṣudūri"}],"e3rab":"(وَأَسِرُّوا قَوْلَكُمْ) أمر وفاعله ومفعوله والجملة استئنافية لا محل لها (أَوِ) عاطفة (اجْهَرُوا) معطوف على أسروا (بِهِ) متعلقان بالفعل (إِنَّهُ عَلِيمٌ) إن واسمها وخبرها والجملة الاسمية تعليلية لا محل لها (بِذاتِ) متعلقان بعليم (الصُّدُورِ) مضاف إليه.\r\n\r\n"},{"sura":67,"ayah":14,"words":[{"position":1,"arabic":"أَلَا","translation":"Does not","transliteration":"alā"},{"position":2,"arabic":"يَعْلَمُ","translation":"know","transliteration":"yaʿlamu"},{"position":3,"arabic":"مَنْ","translation":"(the One) Who","transliteration":"man"},{"position":4,"arabic":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":5,"arabic":"وَهُوَ","translation":"And He","transliteration":"wahuwa"},{"position":6,"arabic":"ٱللَّطِيفُ","translation":"(is) the Subtle","transliteration":"l-laṭīfu"},{"position":7,"arabic":"ٱلْخَبِيرُ","translation":"the All-Aware","transliteration":"l-khabīru"}],"e3rab":"(أَلا يَعْلَمُ مَنْ) ألا حرف استفتاح ومضارع وفاعله (خَلَقَ) ماض فاعله مستتر والجملة صلة.\r\n\r\n(وَهُوَ اللَّطِيفُ الْخَبِيرُ) مبتدأ وخبراه والجملة حال.\r\n\r\n"},{"sura":67,"ayah":15,"words":[{"position":1,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":2,"arabic":"ٱلَّذِى","translation":"(is) the One Who","transliteration":"alladhī"},{"position":3,"arabic":"جَعَلَ","translation":"made","transliteration":"jaʿala"},{"position":4,"arabic":"لَكُمُ","translation":"for you","transliteration":"lakumu"},{"position":5,"arabic":"ٱلْأَرْضَ","translation":"the earth","transliteration":"l-arḍa"},{"position":6,"arabic":"ذَلُولًۭا","translation":"subservient","transliteration":"dhalūlan"},{"position":7,"arabic":"فَٱمْشُوا۟","translation":"so walk","transliteration":"fa-im'shū"},{"position":8,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":9,"arabic":"مَنَاكِبِهَا","translation":"(the) paths thereof","transliteration":"manākibihā"},{"position":10,"arabic":"وَكُلُوا۟","translation":"and eat","transliteration":"wakulū"},{"position":11,"arabic":"مِن","translation":"of","transliteration":"min"},{"position":12,"arabic":"رِّزْقِهِۦ ۖ","translation":"His provision","transliteration":"riz'qihi"},{"position":13,"arabic":"وَإِلَيْهِ","translation":"and to Him","transliteration":"wa-ilayhi"},{"position":14,"arabic":"ٱلنُّشُورُ","translation":"(is) the Resurrection","transliteration":"l-nushūru"}],"e3rab":"(هُوَ الَّذِي) مبتدأ وخبره والجملة استئنافية لا محل لها (جَعَلَ) ماض فاعله مستتر (لَكُمُ) متعلقان بالفعل (الْأَرْضَ) مفعول به أول (ذَلُولًا) مفعول به ثان والجملة صلة (فَامْشُوا) الفاء الفصيحة وأمر وفاعله (فِي مَناكِبِها) متعلقان بالفعل والجملة جواب شرط مقدر لا محل لها (وَكُلُوا مِنْ رِزْقِهِ) معطوف على ما قبله (وَإِلَيْهِ النُّشُورُ) خبر مقدم ومبتدأ مؤخر والجملة حال.\r\n\r\n"},{"sura":67,"ayah":16,"words":[{"position":1,"arabic":"ءَأَمِنتُم","translation":"Do you feel secure","transliteration":"a-amintum"},{"position":2,"arabic":"مَّن","translation":"(from Him) Who","transliteration":"man"},{"position":3,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":4,"arabic":"ٱلسَّمَآءِ","translation":"the heaven","transliteration":"l-samāi"},{"position":5,"arabic":"أَن","translation":"not","transliteration":"an"},{"position":6,"arabic":"يَخْسِفَ","translation":"He will cause to swallow","transliteration":"yakhsifa"},{"position":7,"arabic":"بِكُمُ","translation":"you","transliteration":"bikumu"},{"position":8,"arabic":"ٱلْأَرْضَ","translation":"the earth","transliteration":"l-arḍa"},{"position":9,"arabic":"فَإِذَا","translation":"when","transliteration":"fa-idhā"},{"position":10,"arabic":"هِىَ","translation":"it","transliteration":"hiya"},{"position":11,"arabic":"تَمُورُ","translation":"sways","transliteration":"tamūru"}],"e3rab":"(أَأَمِنْتُمْ) الهمزة للاستفهام وماض وفاعله والجملة استئنافية لا محل لها (مَنْ) مفعول به (فِي السَّماءِ) متعلقان بمحذوف صلة الموصول (أَنْ يَخْسِفَ) مضارع منصوب بأن (بِكُمُ) متعلقان بالفعل (الْأَرْضَ) مفعول به والمصدر المؤول من أن والفعل في محل نصب بدل من اسم الموصول.\r\n\r\n(فَإِذا) الفاء حرف عطف (إذا) الفجائية (هِيَ) مبتدأ (تَمُورُ) مضارع فاعله مستتر والجملة خبر والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":67,"ayah":17,"words":[{"position":1,"arabic":"أَمْ","translation":"Or","transliteration":"am"},{"position":2,"arabic":"أَمِنتُم","translation":"do you feel secure","transliteration":"amintum"},{"position":3,"arabic":"مَّن","translation":"(from Him) Who","transliteration":"man"},{"position":4,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":5,"arabic":"ٱلسَّمَآءِ","translation":"the heaven","transliteration":"l-samāi"},{"position":6,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":7,"arabic":"يُرْسِلَ","translation":"He will send","transliteration":"yur'sila"},{"position":8,"arabic":"عَلَيْكُمْ","translation":"against you","transliteration":"ʿalaykum"},{"position":9,"arabic":"حَاصِبًۭا ۖ","translation":"a storm of stones","transliteration":"ḥāṣiban"},{"position":10,"arabic":"فَسَتَعْلَمُونَ","translation":"Then you would know","transliteration":"fasataʿlamūna"},{"position":11,"arabic":"كَيْفَ","translation":"how","transliteration":"kayfa"},{"position":12,"arabic":"نَذِيرِ","translation":"(was) My warning","transliteration":"nadhīri"}],"e3rab":"(أَمْ أَمِنْتُمْ) أم حرف عطف بمعنى بل وماض وفاعله (مَنْ) مفعوله (فِي السَّماءِ) متعلقان بمحذوف صلة الموصول (أَنْ يُرْسِلَ) مضارع منصوب بأن (عَلَيْكُمْ) متعلقان بالفعل (حاصِباً) مفعول به والمصدر المؤول من أن والفعل في محل نصب بدل من اسم الموصول (فَسَتَعْلَمُونَ) الفاء حرف استئناف والسين للاستقبال ومضارع مرفوع والواو فاعله والجملة استئنافية لا محل لها (كَيْفَ) اسم استفهام خبر مقدم (نَذِيرِ) مبتدأ مؤخر مرفوع بضمة مقدرة على ما قبل ياء المتكلم المحذوفة للتخفيف والجملة الاسمية سدت مسد مفعول تعلمون.\r\n\r\n"},{"sura":67,"ayah":18,"words":[{"position":1,"arabic":"وَلَقَدْ","translation":"And indeed","transliteration":"walaqad"},{"position":2,"arabic":"كَذَّبَ","translation":"denied","transliteration":"kadhaba"},{"position":3,"arabic":"ٱلَّذِينَ","translation":"those","transliteration":"alladhīna"},{"position":4,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":5,"arabic":"قَبْلِهِمْ","translation":"before them","transliteration":"qablihim"},{"position":6,"arabic":"فَكَيْفَ","translation":"and how","transliteration":"fakayfa"},{"position":7,"arabic":"كَانَ","translation":"was","transliteration":"kāna"},{"position":8,"arabic":"نَكِيرِ","translation":"My rejection","transliteration":"nakīri"}],"e3rab":"(وَلَقَدْ) الواو حرف قسم وجر واللام واقعة في جواب القسم وقد حرف تحقيق (كَذَّبَ الَّذِينَ) ماض وفاعله والجملة جواب القسم لا محل لها (مِنْ قَبْلِهِمْ) متعلقان بمحذوف صلة الموصول (فَكَيْفَ) الفاء الفصيحة (كيف) اسم استفهام خبر كان المقدم (كانَ) كان ماض ناقص (نَكِيرِ) اسمها مرفوع بالضمة المقدرة على ما قبل الياء المحذوفة للتخفيف والجملة جواب الشرط المقدر لا محل لها.\r\n\r\n"},{"sura":67,"ayah":19,"words":[{"position":1,"arabic":"أَوَلَمْ","translation":"Do not","transliteration":"awalam"},{"position":2,"arabic":"يَرَوْا۟","translation":"they see","transliteration":"yaraw"},{"position":3,"arabic":"إِلَى","translation":"[to]","transliteration":"ilā"},{"position":4,"arabic":"ٱلطَّيْرِ","translation":"the birds","transliteration":"l-ṭayri"},{"position":5,"arabic":"فَوْقَهُمْ","translation":"above them","transliteration":"fawqahum"},{"position":6,"arabic":"صَـٰٓفَّـٰتٍۢ","translation":"spreading (their wings)","transliteration":"ṣāffātin"},{"position":7,"arabic":"وَيَقْبِضْنَ ۚ","translation":"and folding","transliteration":"wayaqbiḍ'na"},{"position":8,"arabic":"مَا","translation":"Not","transliteration":"mā"},{"position":9,"arabic":"يُمْسِكُهُنَّ","translation":"holds them","transliteration":"yum'sikuhunna"},{"position":10,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":11,"arabic":"ٱلرَّحْمَـٰنُ ۚ","translation":"the Most Gracious","transliteration":"l-raḥmānu"},{"position":12,"arabic":"إِنَّهُۥ","translation":"Indeed, He","transliteration":"innahu"},{"position":13,"arabic":"بِكُلِّ","translation":"(is) of every","transliteration":"bikulli"},{"position":14,"arabic":"شَىْءٍۭ","translation":"thing","transliteration":"shayin"},{"position":15,"arabic":"بَصِيرٌ","translation":"All-Seer","transliteration":"baṣīrun"}],"e3rab":"(أَوَلَمْ) الهمزة حرف استفهام والواو استئنافية (يَرَوْا) مضارع مجزوم بلم والواو فاعله والكلام مستأنف لا محل له (إِلَى الطَّيْرِ) متعلقان بالفعل (فَوْقَهُمْ) ظرف مكان (صافَّاتٍ) حال (وَ) الواو حرف عطف (يَقْبِضْنَ) مضارع مبني على السكون ونون النسوة فاعله والجملة معطوفة على ما قبلها (ما يُمْسِكُهُنَّ) ما نافية ومضارع ومفعوله (إِلَّا) حرف حصر (الرَّحْمنُ) فاعل والجملة استئنافية لا محل لها (إِنَّهُ) إن واسمها (بِكُلِّ) متعلقان ببصير (شَيْءٍ) مضاف إليه (بَصِيرٌ) خبر والجملة تعليل.\r\n\r\n"},{"sura":67,"ayah":20,"words":[{"position":1,"arabic":"أَمَّنْ","translation":"Who is","transliteration":"amman"},{"position":2,"arabic":"هَـٰذَا","translation":"this","transliteration":"hādhā"},{"position":3,"arabic":"ٱلَّذِى","translation":"the one","transliteration":"alladhī"},{"position":4,"arabic":"هُوَ","translation":"he","transliteration":"huwa"},{"position":5,"arabic":"جُندٌۭ","translation":"(is) an army","transliteration":"jundun"},{"position":6,"arabic":"لَّكُمْ","translation":"for you","transliteration":"lakum"},{"position":7,"arabic":"يَنصُرُكُم","translation":"to help you","transliteration":"yanṣurukum"},{"position":8,"arabic":"مِّن","translation":"from","transliteration":"min"},{"position":9,"arabic":"دُونِ","translation":"besides","transliteration":"dūni"},{"position":10,"arabic":"ٱلرَّحْمَـٰنِ ۚ","translation":"the Most Gracious","transliteration":"l-raḥmāni"},{"position":11,"arabic":"إِنِ","translation":"Not","transliteration":"ini"},{"position":12,"arabic":"ٱلْكَـٰفِرُونَ","translation":"(are) the disbelievers","transliteration":"l-kāfirūna"},{"position":13,"arabic":"إِلَّا","translation":"but","transliteration":"illā"},{"position":14,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":15,"arabic":"غُرُورٍ","translation":"delusion","transliteration":"ghurūrin"}],"e3rab":"(أَمَّنْ) أم حرف عطف بمعنى بل ومن اسم استفهام مبتدأ (هذَا) اسم الإشارة خبر (الَّذِي) اسم الموصول بدل من هذا (هُوَ جُنْدٌ) مبتدأ وخبره والجملة صلة (لَكُمْ) صفة جند (يَنْصُرُكُمْ) مضارع ومفعوله والفاعل مستتر والجملة صفة ثانية لجند (مِنْ دُونِ) متعلقان بالفعل (الرَّحْمنِ) مضاف إليه.\r\n\r\n(إِنِ) نافية (الْكافِرُونَ) مبتدأ (إِلَّا) حرف حصر (فِي غُرُورٍ) خبر والجملة اعتراضية لا محل لها.\r\n\r\n"},{"sura":67,"ayah":21,"words":[{"position":1,"arabic":"أَمَّنْ","translation":"Who is","tra