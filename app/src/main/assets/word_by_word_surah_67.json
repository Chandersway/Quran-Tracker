فاعله مستتر والجملة استئنافية لا محل لها (هُوَ الَّذِي) مبتدأ وخبره والجملة مقول القول (أَنْشَأَكُمْ) ماض ومفعوله والفاعل مستتر والجملة صلة الموصول (وَجَعَلَ) ماض فاعله مستتر (لَكُمُ) متعلقان بالفعل (السَّمْعَ) مفعول به (وَالْأَبْصارَ وَالْأَفْئِدَةَ) معطوفان على السمع والجملة معطوفة على ما قبلها (قَلِيلًا) صفة مفعول مطلق محذوف (ما) زائدة (تَشْكُرُونَ) مضارع مرفوع والواو فاعله والجملة التعليلية لا محل لها.\r\n\r\n"},{"sura":67,"ayah":24,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":3,"arabic":"ٱلَّذِى","translation":"(is) the One Who","transliteration":"alladhī"},{"position":4,"arabic":"ذَرَأَكُمْ","translation":"multiplied you","transliteration":"dhara-akum"},{"position":5,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":6,"arabic":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":7,"arabic":"وَإِلَيْهِ","translation":"and to Him","transliteration":"wa-ilayhi"},{"position":8,"arabic":"تُحْشَرُونَ","translation":"you will be gathered","transliteration":"tuḥ'sharūna"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة استئنافية لا محل لها (هُوَ الَّذِي) مبتدأ وخبره والجملة مقول القول (ذَرَأَكُمْ) ماض ومفعوله والفاعل مستتر (فِي الْأَرْضِ) متعلقان بالفعل والجملة صلة الموصول (وَإِلَيْهِ) متعلقان بتحشرون (تُحْشَرُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة معطوفة على ما قبلها لا محل لها.\r\n\r\n"},{"sura":67,"ayah":25,"words":[{"position":1,"arabic":"وَيَقُولُونَ","translation":"And they say","transliteration":"wayaqūlūna"},{"position":2,"arabic":"مَتَىٰ","translation":"When","transliteration":"matā"},{"position":3,"arabic":"هَـٰذَا","translation":"(is) this","transliteration":"hādhā"},{"position":4,"arabic":"ٱلْوَعْدُ","translation":"promise","transliteration":"l-waʿdu"},{"position":5,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":6,"arabic":"كُنتُمْ","translation":"you are","transliteration":"kuntum"},{"position":7,"arabic":"صَـٰدِقِينَ","translation":"truthful","transliteration":"ṣādiqīna"}],"e3rab":"(وَيَقُولُونَ) الواو حرف استئناف ومضارع وفاعله والجملة استئنافية لا محل لها (مَتى) اسم استفهام خبر مقدم (هذَا) مبتدأ مؤخر (الْوَعْدُ) بدل من اسم الإشارة والجملة الاسمية مقول القول (إِنْ كُنْتُمْ) شرطية جازمة وكان واسمها (صادِقِينَ) خبرها والجملة ابتدائية لا محل لها وجواب الشرط محذوف والجملة الشرطية مقول القول.\r\n\r\n"},{"sura":67,"ayah":26,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"position":3,"arabic":"ٱلْعِلْمُ","translation":"the knowledge","transliteration":"l-ʿil'mu"},{"position":4,"arabic":"عِندَ","translation":"(is) with","transliteration":"ʿinda"},{"position":5,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":6,"arabic":"وَإِنَّمَآ","translation":"and only","transliteration":"wa-innamā"},{"position":7,"arabic":"أَنَا۠","translation":"I am","transliteration":"anā"},{"position":8,"arabic":"نَذِيرٌۭ","translation":"a warner","transliteration":"nadhīrun"},{"position":9,"arabic":"مُّبِينٌۭ","translation":"clear","transliteration":"mubīnun"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة استئنافية لا محل لها (إِنَّمَا) كافة مكفوفة (الْعِلْمُ) مبتدأ (عِنْدَ) ظرف مكان متعلق بمحذوف خبر المبتدأ (اللَّهِ) لفظ الجلالة مضاف إليه والجملة الاسمية مقول القول (وَإِنَّما) والواو حرف عطف (إِنَّما أَنَا نَذِيرٌ) إنما كافة ومكفوفة ومبتدأ وخبره (مُبِينٌ) صفة نذير والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":67,"ayah":27,"words":[{"position":1,"arabic":"فَلَمَّا","translation":"But when","transliteration":"falammā"},{"position":2,"arabic":"رَأَوْهُ","translation":"they (will) see it","transliteration":"ra-awhu"},{"position":3,"arabic":"زُلْفَةًۭ","translation":"approaching","transliteration":"zul'fatan"},{"position":4,"arabic":"سِيٓـَٔتْ","translation":"(will be) distressed","transliteration":"sīat"},{"position":5,"arabic":"وُجُوهُ","translation":"(the) faces","transliteration":"wujūhu"},{"position":6,"arabic":"ٱلَّذِينَ","translation":"(of) those who","transliteration":"alladhīna"},{"position":7,"arabic":"كَفَرُوا۟","translation":"disbelieved","transliteration":"kafarū"},{"position":8,"arabic":"وَقِيلَ","translation":"and it will be said","transliteration":"waqīla"},{"position":9,"arabic":"هَـٰذَا","translation":"This","transliteration":"hādhā"},{"position":10,"arabic":"ٱلَّذِى","translation":"(is) that which","transliteration":"alladhī"},{"position":11,"arabic":"كُنتُم","translation":"you used to","transliteration":"kuntum"},{"position":12,"arabic":"بِهِۦ","translation":"for it","transliteration":"bihi"},{"position":13,"arabic":"تَدَّعُونَ","translation":"call","transliteration":"taddaʿūna"}],"e3rab":"(فَلَمَّا) الفاء حرف استئناف (لما) ظرفية شرطية غير جازمة (رَأَوْهُ) ماض وفاعله ومفعوله والجملة في محل جر بالإضافة (زُلْفَةً) حال (سِيئَتْ) ماض مبني للمجهول (وُجُوهُ) نائب فاعل والجملة جواب الشرط لا محل لها (الَّذِينَ) مضاف إليه (كَفَرُوا) ماض وفاعله والجملة صلة (وَقِيلَ) الواو حرف عطف وماض مبني للمجهول (هذَا الَّذِي) مبتدأ وخبره والجملة الاسمية مقول القول (كُنْتُمْ) كان واسمها (بِهِ) متعلقان بتدعون (تَدَّعُونَ) مضارع مرفوع والواو فاعله والجملة خبر كنتم وجملة كنتم..\r\n\r\nصلة الموصول وجملة قيل.. معطوفة على ما قبلها.\r\n\r\n"},{"sura":67,"ayah":28,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"أَرَءَيْتُمْ","translation":"Have you seen","transliteration":"ara-aytum"},{"position":3,"arabic":"إِنْ","translation":"if","transliteration":"in"},{"position":4,"arabic":"أَهْلَكَنِىَ","translation":"destroys me","transliteration":"ahlakaniya"},{"position":5,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":6,"arabic":"وَمَن","translation":"and whoever","transliteration":"waman"},{"position":7,"arabic":"مَّعِىَ","translation":"(is) with me","transliteration":"maʿiya"},{"position":8,"arabic":"أَوْ","translation":"or","transliteration":"aw"},{"position":9,"arabic":"رَحِمَنَا","translation":"has mercy upon us","transliteration":"raḥimanā"},{"position":10,"arabic":"فَمَن","translation":"then who","transliteration":"faman"},{"position":11,"arabic":"يُجِيرُ","translation":"(can) protect","transliteration":"yujīru"},{"position":12,"arabic":"ٱلْكَـٰفِرِينَ","translation":"the disbelievers","transliteration":"l-kāfirīna"},{"position":13,"arabic":"مِنْ","translation":"from","transliteration":"min"},{"position":14,"arabic":"عَذَابٍ","translation":"a punishment","transliteration":"ʿadhābin"},{"position":15,"arabic":"أَلِيمٍۢ","translation":"painful","transliteration":"alīmin"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة استئنافية لا محل لها (أَرَأَيْتُمْ) الهمزة للاستفهام الإنكاري وماض وفاعله والجملة مقول القول (إِنْ) شرطية جازمة (أَهْلَكَنِيَ اللَّهُ) ماض ومفعوله ولفظ الجلالة فاعله والجملة ابتدائية لا محل لها (وَمَنْ) معطوفة على ياء المتكلم (مَعِيَ) ظرف مكان (أَوْ) حرف عطف (رَحِمَنا) ماض ومفعوله والفاعل مستتر والجملة معطوفة على ما قبلها (فَمَنْ) الفاء واقعة في جواب الشرط (مَنْ) اسم استفهام مبتدأ (يُجِيرُ) مضارع فاعله مستتر (الْكافِرِينَ) مفعوله (مِنْ عَذابٍ) متعلقان بالفعل (أَلِيمٍ) صفة عذاب والجملة الفعلية خبر المبتدأ والجملة الاسمية في محل جزم جواب الشرط وجملة الشرط سدت مسد مفعولي أرأيتم.\r\n\r\n"},{"sura":67,"ayah":29,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":3,"arabic":"ٱلرَّحْمَـٰنُ","translation":"(is) the Most Gracious","transliteration":"l-raḥmānu"},{"position":4,"arabic":"ءَامَنَّا","translation":"we believe","transliteration":"āmannā"},{"position":5,"arabic":"بِهِۦ","translation":"in Him","transliteration":"bihi"},{"position":6,"arabic":"وَعَلَيْهِ","translation":"and upon Him","transliteration":"waʿalayhi"},{"position":7,"arabic":"تَوَكَّلْنَا ۖ","translation":"we put (our) trust","transliteration":"tawakkalnā"},{"position":8,"arabic":"فَسَتَعْلَمُونَ","translation":"So you will know","transliteration":"fasataʿlamūna"},{"position":9,"arabic":"مَنْ","translation":"who","transliteration":"man"},{"position":10,"arabic":"هُوَ","translation":"(is) it","transliteration":"huwa"},{"position":11,"arabic":"فِى","translation":"(that is) in","transliteration":"fī"},{"position":12,"arabic":"ضَلَـٰلٍۢ","translation":"error","transliteration":"ḍalālin"},{"position":13,"arabic":"مُّبِينٍۢ","translation":"clear","transliteration":"mubīnin"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة استئنافية لا محل لها (هُوَ الرَّحْمنُ) مبتدأ وخبره والجملة مقول القول (آمَنَّا) ماض وفاعله (بِهِ) متعلقان بالفعل والجملة حال (وَعَلَيْهِ) متعلقان بتوكلنا (تَوَكَّلْنا) ماض وفاعله والجملة معطوفة على ما قبلها (فَسَتَعْلَمُونَ) الفاء حرف استئناف والسين للاستقبال ومضارع وفاعله والجملة استئنافية لا محل لها (مَنْ) مبتدأ (هُوَ) ضمير فصل (فِي ضَلالٍ) جار ومجرور خبر المبتدأ (مُبِينٍ) صفة والجملة الاسمية سدت مسد مفعولى تعلمون وجملة ستعلمون.. استئنافية لا محل لها.\r\n\r\n"},{"sura":67,"ayah":30,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"أَرَءَيْتُمْ","translation":"Have you seen","transliteration":"ara-aytum"},{"position":3,"arabic":"إِنْ","translation":"if","transliteration":"in"},{"position":4,"arabic":"أَصْبَحَ","translation":"becomes","transliteration":"aṣbaḥa"},{"position":5,"arabic":"مَآؤُكُمْ","translation":"your water","transliteration":"māukum"},{"position":6,"arabic":"غَوْرًۭا","translation":"sunken","transliteration":"ghawran"},{"position":7,"arabic":"فَمَن","translation":"then who","transliteration":"faman"},{"position":8,"arabic":"يَأْتِيكُم","translation":"could bring you","transliteration":"yatīkum"},{"position":9,"arabic":"بِمَآءٍۢ","translation":"water","transliteration":"bimāin"},{"position":10,"arabic":"مَّعِينٍۭ","translation":"flowing","transliteration":"maʿīnin"}],"e3rab":"(قُلْ أَرَأَيْتُمْ) سبق إعرابها (إِنْ) شرطية جازمة (أَصْبَحَ ماؤُكُمْ غَوْراً) أصبح واسمها وخبرها والجملة ابتدائية لا محل لها (فَمَنْ) الفاء واقعة في جواب الشرط (من) اسم استفهام مبتدأ (يَأْتِيكُمْ) مضارع ومفعوله والفاعل مستتر والجملة الفعلية خبر المبتدأ والجملة الاسمية في محل جزم جواب الشرط (بِماءٍ) متعلقان بالفعل (مَعِينٍ) صفة ماء.\r\n\r\n"}]