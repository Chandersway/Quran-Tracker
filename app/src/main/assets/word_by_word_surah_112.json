[{"sura":112,"ayah":1,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":3,"arabic":"ٱللَّهُ","translation":"(is) Allah","transliteration":"l-lahu"},{"position":4,"arabic":"أَحَدٌ","translation":"the One","transliteration":"aḥadun"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة ابتدائية لا محل لها (هُوَ) ضمير الشأن مبتدأ (اللَّهُ أَحَدٌ) مبتدأ وخبره والجملة خبر هو وجملة هو.. مقول القول.\r\n\r\n"},{"sura":112,"ayah":2,"words":[{"position":1,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"al-lahu"},{"position":2,"arabic":"ٱلصَّمَدُ","translation":"the Eternal, the Absolute","transliteration":"l-ṣamadu"}],"e3rab":"(اللَّهُ الصَّمَدُ) مبتدأ وخبره والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":112,"ayah":3,"words":[{"position":1,"arabic":"لَمْ","translation":"Not","transliteration":"lam"},{"position":2,"arabic":"يَلِدْ","translation":"He begets","transliteration":"yalid"},{"position":3,"arabic":"وَلَمْ","translation":"and not","transliteration":"walam"},{"position":4,"arabic":"يُولَدْ","translation":"He is begotten","transliteration":"yūlad"}],"e3rab":"(لَمْ يَلِدْ) مضارع مجزوم بلم والفاعل مستتر والجملة مستأنفة لا محل لها (وَلَمْ يُولَدْ) الواو حرف عطف ومضارع مبني للمجهول مجزوم بلم ونائب الفاعل مستتر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":112,"ayah":4,"words":[{"position":1,"arabic":"وَلَمْ","translation":"And not","transliteration":"walam"},{"position":2,"arabic":"يَكُن","translation":"is","transliteration":"yakun"},{"position":3,"arabic":"لَّهُۥ","translation":"for Him","transliteration":"lahu"},{"position":4,"arabic":"كُفُوًا","translation":"equivalent","transliteration":"kufuwan"},{"position":5,"arabic":"أَحَدٌۢ","translation":"any [one]","transliteration":"aḥadun"}],"e3rab":"(وَلَمْ يَكُنْ) الواو حرف عطف ومضارع ناقص مجزوم بلم (لَهُ) متعلقان بكفوا (كُفُواً) خبر يكن مقدم (أَحَدٌ) اسمه المؤخر. والجملة معطوفة على ما قبلها.\r\n\r\n"}]