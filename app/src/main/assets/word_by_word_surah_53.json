"arabic":"أَجِنَّةٌۭ","translation":"fetuses","transliteration":"ajinnatun"},{"position":22,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":23,"arabic":"بُطُونِ","translation":"(the) wombs","transliteration":"buṭūni"},{"position":24,"arabic":"أُمَّهَـٰتِكُمْ ۖ","translation":"(of) your mothers","transliteration":"ummahātikum"},{"position":25,"arabic":"فَلَا","translation":"So (do) not","transliteration":"falā"},{"position":26,"arabic":"تُزَكُّوٓا۟","translation":"ascribe purity","transliteration":"tuzakkū"},{"position":27,"arabic":"أَنفُسَكُمْ ۖ","translation":"(to) yourselves","transliteration":"anfusakum"},{"position":28,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":29,"arabic":"أَعْلَمُ","translation":"knows best","transliteration":"aʿlamu"},{"position":30,"arabic":"بِمَنِ","translation":"(he) who","transliteration":"bimani"},{"position":31,"arabic":"ٱتَّقَىٰٓ","translation":"fears","transliteration":"ittaqā"}],"e3rab":"(الَّذِينَ يَجْتَنِبُونَ كَبائِرَ الْإِثْمِ) الذين بدل من سابقه ومضارع مرفوع والواو فاعله والجملة صلة وكبائر مفعول به مضاف إلى الإثم (وَالْفَواحِشَ) معطوف (إِلَّا) حرف حصر (اللَّمَمَ) منصوب على الاستثناء المنقطع، (إِنَّ رَبَّكَ واسِعُ الْمَغْفِرَةِ) إن واسمها وخبرها والمغفرة مضاف إليه والجملة تعليلية (هُوَ) مبتدأ (أَعْلَمُ) خبره (بِكُمْ) متعلقان بأعلم والجملة الاسمية استئنافية لا محل لها (إِذْ) ظرف لما مضى من الزمن (أَنْشَأَكُمْ) ماض ومفعوله والفاعل مستتر والجملة في محل جر بالإضافة (مِنَ الْأَرْضِ) متعلقان بالفعل (وَإِذْ) معطوفة على سابقتها (أَنْتُمْ أَجِنَّةٌ) مبتدأ وخبره (فِي بُطُونِ) صفة أجنة (أُمَّهاتِكُمْ) مضاف إليه والجملة الاسمية في محل جر بالإضافة، (فَلا تُزَكُّوا) الفاء الفصيحة ومضارع مجزوم بلا الناهية والواو فاعله (أَنْفُسَكُمْ) مفعوله والجملة الفعلية جواب شرط مقدر لا محل لها (هُوَ أَعْلَمُ) مبتدأ وخبره والجملة تعليلية (بِمَنِ) متعلقان بأعلم (اتَّقى) ماض فاعله مستتر والجملة صلة من.\r\n\r\n"},{"sura":53,"ayah":33,"words":[{"position":1,"arabic":"أَفَرَءَيْتَ","translation":"Did you see","transliteration":"afara-ayta"},{"position":2,"arabic":"ٱلَّذِى","translation":"the one who","transliteration":"alladhī"},{"position":3,"arabic":"تَوَلَّىٰ","translation":"turned away","transliteration":"tawallā"}],"e3rab":"(أَفَرَأَيْتَ) الهمزة حرف استفهام والفاء حرف استئناف وماض وفاعله (الَّذِي) مفعوله والجملة استئنافية لا محل لها، (تَوَلَّى) ماض فاعله مستتر والجملة صلة الذي.\r\n\r\n"},{"sura":53,"ayah":34,"words":[{"position":1,"arabic":"وَأَعْطَىٰ","translation":"And gave","transliteration":"wa-aʿṭā"},{"position":2,"arabic":"قَلِيلًۭا","translation":"a little","transliteration":"qalīlan"},{"position":3,"arabic":"وَأَكْدَىٰٓ","translation":"and withheld","transliteration":"wa-akdā"}],"e3rab":"(وَأَعْطى) معطوف على تولى (قَلِيلًا) مفعول به (وَأَكْدى) معطوف على أعطى.\r\n\r\n"},{"sura":53,"ayah":35,"words":[{"position":1,"arabic":"أَعِندَهُۥ","translation":"Is with him","transliteration":"aʿindahu"},{"position":2,"arabic":"عِلْمُ","translation":"(the) knowledge","transliteration":"ʿil'mu"},{"position":3,"arabic":"ٱلْغَيْبِ","translation":"(of) the unseen","transliteration":"l-ghaybi"},{"position":4,"arabic":"فَهُوَ","translation":"so he","transliteration":"fahuwa"},{"position":5,"arabic":"يَرَىٰٓ","translation":"sees","transliteration":"yarā"}],"e3rab":"(أَعِنْدَهُ) الهمزة حرف استفهام إنكاري وظرف مكان متعلق بمحذوف خبر مقدم (عِلْمُ) مبتدأ مؤخر والجملة الاسمية مفعول به ثان لرأيت (الْغَيْبِ) مضاف إليه (فَهُوَ) الفاء حرف عطف وهو مبتدأ (يَرى) مضارع مرفوع فاعله مستتر والجملة الفعلية خبر المبتدأ والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":53,"ayah":36,"words":[{"position":1,"arabic":"أَمْ","translation":"Or","transliteration":"am"},{"position":2,"arabic":"لَمْ","translation":"not","transliteration":"lam"},{"position":3,"arabic":"يُنَبَّأْ","translation":"he was informed","transliteration":"yunabba"},{"position":4,"arabic":"بِمَا","translation":"with what","transliteration":"bimā"},{"position":5,"arabic":"فِى","translation":"(was) in","transliteration":"fī"},{"positi