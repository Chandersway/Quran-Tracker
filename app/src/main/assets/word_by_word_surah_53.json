,"translation":"he strives (for)","transliteration":"saʿā"}],"e3rab":"(وَأَنْ) الواو حرف عطف وأن معطوف على أن المخففة (لَيْسَ لِلْإِنْسانِ) ماض ناقص وللإنسان خبر مقدم (إِلَّا) حرف حصر (ما) مصدرية (سَعى) ماض فاعله مستتر والمصدر المؤول من ما والفعل في محل رفع اسم ليس.\r\n\r\n"},{"sura":53,"ayah":40,"words":[{"position":1,"arabic":"وَأَنَّ","translation":"And that","transliteration":"wa-anna"},{"position":2,"arabic":"سَعْيَهُۥ","translation":"his striving","transliteration":"saʿyahu"},{"position":3,"arabic":"سَوْفَ","translation":"will soon","transliteration":"sawfa"},{"position":4,"arabic":"يُرَىٰ","translation":"be seen","transliteration":"yurā"}],"e3rab":"(وَأَنَّ سَعْيَهُ) أن واسمها (سَوْفَ) حرف استقبال (يُرى) مضارع مبني للمجهول والجملة خبر أن والمصدر المؤول من أن وما بعدها معطوف على المصدر المؤول السابق.\r\n\r\n"},{"sura":53,"ayah":41,"words":[{"position":1,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"arabic":"يُجْزَىٰهُ","translation":"he will be recompensed for it","transliteration":"yuj'zāhu"},{"position":3,"arabic":"ٱلْجَزَآءَ","translation":"the recompense","transliteration":"l-jazāa"},{"position":4,"arabic":"ٱلْأَوْفَىٰ","translation":"the fullest","transliteration":"l-awfā"}],"e3rab":"(ثُمَّ) حرف عطف (يُجْزاهُ) مضارع مبني للمجهول ونائب الفاعل مستتر والهاء مفعوله الثاني (الْجَزاءَ) مفعول مطلق (الْأَوْفى) صفة.\r\n\r\n"},{"sura":53,"ayah":42,"words":[{"position":1,"arabic":"وَأَنَّ","translation":"And that","transliteration":"wa-anna"},{"position":2,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":3,"arabic":"رَبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":4,"arabic":"ٱلْمُنتَهَىٰ","translation":"(is) the final goal","transliteration":"l-muntahā"}],"e3rab":"(وَأَنَّ) حرف مشبه بالفعل (إِلى رَبِّكَ) خبرها المقدم (الْمُنْتَهى) اسمها المؤخر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":53,"ayah":43,"words":[{"position":1,"arabic":"وَأَنَّهُۥ","translation":"And that He","transliteration":"wa-annahu"},{"position":2,"arabic":"هُوَ","translation":"[He]","transliteration":"huwa"},{"position":3,"arabic":"أَضْحَكَ","translation":"makes (one) laugh","transliteration":"aḍḥaka"},{"position":4,"arabic":"وَأَبْكَىٰ","translation":"and makes (one) weep","transliteration":"wa-abkā"}],"e3rab":"(وَأَنَّهُ) أن واسمها (هُوَ) مبتدأ (أَضْحَكَ) ماض فاعله مستتر والجملة الفعلية خبر هو وجملة هو أضحك خبر أن (وَأَبْكى) معطوف على أضحك.\r\n\r\n"},{"sura":53,"ayah":44,"words":[{"position":1,"arabic":"وَأَنَّهُۥ","translation":"And that He","transliteration":"wa-annahu"},{"position":2,"arabic":"هُوَ","translation":"[He]","transliteration":"huwa"},{"position":3,"arabic":"أَمَاتَ","translation":"causes death","transliteration":"amāta"},{"position":4,"arabic":"وَأَحْيَا","translation":"and gives life","transliteration":"wa-aḥyā"}],"e3rab":"عطف على الآية السابقة والإعراب واحد.\r\n\r\n"},{"sura":53,"ayah":45,"words":[{"position":1,"arabic":"وَأَنَّهُۥ","translation":"And that He","transliteration":"wa-annahu"},{"position":2,"arabic":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":3,"arabic":"ٱلزَّوْجَيْنِ","translation":"the pairs","transliteration":"l-zawjayni"},{"position":4,"arabic":"ٱلذَّكَرَ","translation":"the male","transliteration":"l-dhakara"},{"position":5,"arabic":"وَٱلْأُنثَىٰ","translation":"and the female","transliteration":"wal-unthā"}],"e3rab":"(وَأَنَّهُ خَلَقَ) معطوف على ما قبله (الزَّوْجَيْنِ) مفعول به (الذَّكَرَ) بدل (وَالْأُنْثى) معطوف.\r\n\r\n"},{"sura":53,"ayah":46,"words":[{"position":1,"arabic":"مِن","translation":"From","transliteration":"min"},{"position":2,"arabic":"نُّطْفَةٍ","translation":"a semen-drop","transliteration":"nuṭ'fatin"},{"position":3,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":4,"arabic":"تُمْنَىٰ","translation":"it is emitted","transliteration":"tum'nā"}],"e3rab":"(مِنْ نُطْفَةٍ) متعلقان بخلق (إِذا) ظرفية شرطية غير جازمة (تُمْنى) مضارع مبني للمجهول ونائب الفاعل مستتر والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":53,"ayah":47,"words":[{"position":1,"arabic":"وَأَنَّ","translation":"And that","transliteration":"wa-anna"},{"position":2,"arabic":"عَلَيْهِ","translation":"upon Him","transliteration":"ʿalayhi"},{"position":3,"arabic":"ٱلنَّشْأَةَ","translation":"(is) the bringing forth","transliteration":"l-nashata"},{"position":4,"arabic":"ٱلْأُخْرَىٰ","translation":"another","transliteration":"l-ukh'rā"}],"e3rab":"(وَأَنَّ) حرف مشبه بالفعل (عَلَيْهِ) خبر مقدم (النَّشْأَةَ) اسم أن المؤخر (الْأُخْرى) صفة.\r\n\r\n"},{"sura":53,"ayah":48,"words":[{"position":1,"arabic":"وَأَنَّهُۥ","translation":"And that He","transliteration":"wa-annahu"},{"position":2,"arabic":"هُوَ","translation":"[He]","transliteration":"huwa"},{"position":3,"arabic":"أَغْنَىٰ","translation":"enriches","transliteration":"aghnā"},{"position":4,"arabic":"وَأَقْنَىٰ","translation":"and suffices","transliteration":"wa-aqnā"}],"e3rab":"سبق إعراب مثيلها.\r\n\r\n"},{"sura":53,"ayah":49,"words":[{"position":1,"arabic":"وَأَنَّهُۥ","translation":"And that He","transliteration":"wa-annahu"},{"position":2,"arabic":"هُوَ","translation":"[He]","transliteration":"huwa"},{"position":3,"arabic":"رَبُّ","translation":"(is the) Lord","transliteration":"rabbu"},{"position":4,"arabic":"ٱلشِّعْرَىٰ","translation":"(of) Sirius","transliteration":"l-shiʿ'rā"}],"e3rab":"(وَأَنَّهُ) أن واسمها (هُوَ رَبُّ) مبتدأ وخبره (الشِّعْرى) مضاف إليه والجملة الاسمية خبر أن وجملة أنه معطوفة على ما قبلها.\r\n\r\n"},{"sura":53,"ayah":50,"words":[{"position":1,"arabic":"وَأَنَّهُۥٓ","translation":"And that He","transliteration":"wa-annahu"},{"position":2,"arabic":"أَهْلَكَ","translation":"destroyed","transliteration":"ahlaka"},{"position":3,"arabic":"عَادًا","translation":"Aad","transliteration":"ʿādan"},{"position":4,"arabic":"ٱلْأُولَىٰ","translation":"the first","transliteration":"l-ūlā"}],"e3rab":"(وَأَنَّهُ أَهْلَكَ عاداً) أن واسمها وماض ومفعوله والفاعل مستتر (الْأُولى) صفة والجملة الفعلية خبر أنه والجملة الاسمية معطوفة على ما قبلها.\r\n\r\n"},{"sura":53,"ayah":51,"words":[{"position":1,"arabic":"وَثَمُودَا۟","translation":"And Thamud","transliteration":"wathamūdā"},{"position":2,"arabic":"فَمَآ","translation":"so not","transliteration":"famā"},{"position":3,"arabic":"أَبْقَىٰ","translation":"He spared","transliteration":"abqā"}],"e3rab":"(وَثَمُودَ) معطوف على عاد (فَما أَبْقى) الفاء حرف عطف وما نافية وماض فاعله مستتر والجملة الفعلية معطوفة على أهلك.\r\n\r\n"},{"sura":53,"ayah":52,"words":[{"position":1,"arabic":"وَقَوْمَ","translation":"And (the) people","transliteration":"waqawma"},{"position":2,"arabic":"نُوحٍۢ","translation":"(of) Nuh","transliteration":"nūḥin"},{"position":3,"arabic":"مِّن","translation":"before","transliteration":"min"},{"position":4,"arabic":"قَبْلُ ۖ","translation":"before","transliteration":"qablu"},{"position":5,"arabic":"إِنَّهُمْ","translation":"Indeed, they","transliteration":"innahum"},{"position":6,"arabic":"كَانُوا۟","translation":"they were","transliteration":"kānū"},{"position":7,"arabic":"هُمْ","translation":"they were","transliteration":"hum"},{"position":8,"arabic":"أَظْلَمَ","translation":"more unjust","transliteration":"aẓlama"},{"position":9,"arabic":"وَأَطْغَىٰ","translation":"and more rebellious","transliteration":"wa-aṭghā"}],"e3rab":"(وَقَوْمَ) معطوف على ثمود (نُوحٍ) مضاف إليه (مِنْ قَبْلُ) متعلقان بفعل تقديره أهلك (إِنَّهُمْ كانُوا) إن واسمها وكان واسمها وهم ضمير فصل (أَظْلَمَ) خبر وجملة كانوا.. خبر إن وجملة إنهم.. تعليل (وَأَطْغى) معطوف على أظلم.\r\n\r\n"},{"sura":53,"ayah":53,"words":[{"position":1,"arabic":"وَٱلْمُؤْتَفِكَةَ","translation":"And the overturned cities","transliteration":"wal-mu'tafikata"},{"position":2,"arabic":"أَهْوَىٰ","translation":"He overthrew","transliteration":"ahwā"}],"e3rab":"(وَالْمُؤْتَفِكَةَ) مفعول به مقدم (أَهْوى) ماض فاعله مستتر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":53,"ayah":54,"words":[{"position":1,"arabic":"فَغَشَّىٰهَا","translation":"So covered them","transliteration":"faghashāhā"},{"position":2,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":3,"arabic":"غَشَّىٰ","translation":"covered","transliteration":"ghashā"}],"e3rab":"(فَغَشَّاها) ماض ومفعوله الأول والفاعل مستتر (ما) مفعوله الثاني والجملة معطوفة على ما قبلها (غَشَّى) ماض فاعله مستتر والجملة صلة ما.\r\n\r\n"},{"sura":53,"ayah":55,"words":[{"position":1,"arabic":"فَبِأَىِّ","translation":"Then which (of)","transliteration":"fabi-ayyi"},{"position":2,"arabic":"ءَالَآءِ","translation":"the Favors","transliteration":"ālāi"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"تَتَمَارَىٰ","translation":"will you doubt","transliteration":"tatamārā"}],"e3rab":"(فَبِأَيِّ) الفاء الفصيحة وبأي متعلقان بتتمارى (آلاءِ) مضاف إليه، (رَبِّكَ) مضاف إليه (تَتَمارى) مضارع فاعله مستتر والجملة جواب شرط مقدر.\r\n\r\n"},{"sura":53,"ayah":56,"words":[{"position":1,"arabic":"هَـٰذَا","translation":"This","transliteration":"hādhā"},{"position":2,"arabic":"نَذِيرٌۭ","translation":"(is) a warner","transliteration":"nadhīrun"},{"position":3,"arabic":"مِّنَ","translation":"from","transliteration":"mina"},{"position":4,"arabic":"ٱلنُّذُرِ","translation":"the warners","transliteration":"l-nudhuri"},{"position":5,"arabic":"ٱلْأُولَىٰٓ","translation":"the former","transliteration":"l-ūlā"}],"e3rab":"(هذا نَذِيرٌ) مبتدأ وخبره والجملة الاسمية استئنافية لا محل لها (مِنَ النُّذُرِ) متعلقان بنذير (الْأُولى) صفة النذر.\r\n\r\n"},{"sura":53,"ayah":57,"words":[{"position":1,"arabic":"أَزِفَتِ","translation":"Has approached","transliteration":"azifati"},{"position":2,"arabic":"ٱلْـَٔازِفَةُ","translation":"the Approaching Day","transliteration":"l-āzifatu"}],"e3rab":"(أَزِفَتِ الْآزِفَةُ) ماض وفاعله والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":53,"ayah":58,"words":[{"position":1,"arabic":"لَيْسَ","translation":"Not is","transliteration":"laysa"},{"position":2,"arabic":"لَهَا","translation":"for it","transliteration":"lahā"},{"position":3,"arabic":"مِن","translation":"besides","transliteration":"min"},{"position":4,"arabic":"دُونِ","translation":"besides","transliteration":"dūni"},{"position":5,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":6,"arabic":"كَاشِفَةٌ","translation":"any remover","transliteration":"kāshifatun"}],"e3rab":"(لَيْسَ) ماض ناقص (لَها) خبر مقدم (مِنْ دُونِ) متعلقان بكاشفة- (اللَّهِ) ولفظ الجلالة مضاف إليه (كاشِفَةٌ) اسم ليس والجملة حال.\r\n\r\n"},{"sura":53,"ayah":59,"words":[{"position":1,"arabic":"أَفَمِنْ","translation":"Then of","transliteration":"afamin"},{"position":2,"arabic":"هَـٰذَا","translation":"this","transliteration":"hādhā"},{"position":3,"arabic":"ٱلْحَدِيثِ","translation":"statement","transliteration":"l-ḥadīthi"},{"position":4,"arabic":"تَعْجَبُونَ","translation":"you wonder","transliteration":"taʿjabūna"}],"e3rab":"(أَفَمِنْ) الهمزة حرف استفهام إنكاري والفاء حرف استئناف (من هذَا) متعلقان بتعجبون (الْحَدِيثِ) بدل من اسم الإشارة (تَعْجَبُونَ) مضارع مرفوع بثبوت النون والواو فاعل والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":53,"ayah":60,"words":[{"position":1,"arabic":"وَتَضْحَكُونَ","translation":"And you laugh","transliteration":"wataḍḥakūna"},{"position":2,"arabic":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":3,"arabic":"تَبْكُونَ","translation":"weep","transliteration":"tabkūna"}],"e3rab":"(وَتَضْحَكُونَ وَلا تَبْكُونَ) معطوف على ما قبله.\r\n\r\n"},{"sura":53,"ayah":61,"words":[{"position":1,"arabic":"وَأَنتُمْ","translation":"While you","transliteration":"wa-antum"},{"position":2,"arabic":"سَـٰمِدُونَ","translation":"amuse (yourselves)","transliteration":"sāmidūna"}],"e3rab":"(وَأَنْتُمْ سامِدُونَ) الواو حالية ومبتدأ وخبره والجملة حالية.\r\n\r\n"},{"sura":53,"ayah":62,"words":[{"position":1,"arabic":"فَٱسْجُدُوا۟","translation":"So prostrate","transliteration":"fa-us'judū"},{"position":2,"arabic":"لِلَّهِ","translation":"to Allah","transliteration":"lillahi"},{"position":3,"arabic":"وَٱعْبُدُوا۟ ۩","translation":"and worship (Him)","transliteration":"wa-uʿ'budū"}],"e3rab":"(فَاسْجُدُوا) الفاء الفصيحة وأمر مبني على حذف النون والواو فاعله والجملة جواب شرط مقدر لا محل لها (لِلَّهِ) متعلقان بالفعل (وَاعْبُدُوا) معطوف على اسجدوا.\r\n\r\n"}]