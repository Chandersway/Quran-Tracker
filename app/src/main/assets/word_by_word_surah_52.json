\r\n"},{"sura":52,"ayah":21,"words":[{"position":1,"arabic":"وَٱلَّذِينَ","translation":"And those who","transliteration":"wa-alladhīna"},{"position":2,"arabic":"ءَامَنُوا۟","translation":"believed","transliteration":"āmanū"},{"position":3,"arabic":"وَٱتَّبَعَتْهُمْ","translation":"and followed them","transliteration":"wa-ittabaʿathum"},{"position":4,"arabic":"ذُرِّيَّتُهُم","translation":"their offspring","transliteration":"dhurriyyatuhum"},{"position":5,"arabic":"بِإِيمَـٰنٍ","translation":"in faith","transliteration":"biīmānin"},{"position":6,"arabic":"أَلْحَقْنَا","translation":"We will join","transliteration":"alḥaqnā"},{"position":7,"arabic":"بِهِمْ","translation":"with them","transliteration":"bihim"},{"position":8,"arabic":"ذُرِّيَّتَهُمْ","translation":"their offspring","transliteration":"dhurriyyatahum"},{"position":9,"arabic":"وَمَآ","translation":"and not","transliteration":"wamā"},{"position":10,"arabic":"أَلَتْنَـٰهُم","translation":"We will deprive them","transliteration":"alatnāhum"},{"position":11,"arabic":"مِّنْ","translation":"of","transliteration":"min"},{"position":12,"arabic":"عَمَلِهِم","translation":"their deeds","transliteration":"ʿamalihim"},{"position":13,"arabic":"مِّن","translation":"(in) any","transliteration":"min"},{"position":14,"arabic":"شَىْءٍۢ ۚ","translation":"thing","transliteration":"shayin"},{"position":15,"arabic":"كُلُّ","translation":"Every","transliteration":"kullu"},{"position":16,"arabic":"ٱمْرِئٍۭ","translation":"person","transliteration":"im'ri-in"},{"position":17,"arabic":"بِمَا","translation":"for what","transliteration":"bimā"},{"position":18,"arabic":"كَسَبَ","translation":"he earned","transliteration":"kasaba"},{"position":19,"arabic":"رَهِينٌۭ","translation":"(is) pledged","transliteration":"rahīnun"}],"e3rab":"(وَالَّذِينَ) مبتدأ (آمَنُوا) ماض وفاعله والجملة صلة الذين (وَاتَّبَعَتْهُمْ ذُرِّيَّتُهُمْ) ماض ومفعوله وفاعل مؤخر والجملة معطوفة على ما قبلها (بِإِيمانٍ) متعلقان بالفعل (أَلْحَقْنا) ماض وفاعله (بِهِمْ) متعلقان بالفعل (ذُرِّيَّتُهُمْ) مفعول به والجملة خبر الذين (وَما) الواو حرف عطف وما نافية (أَلَتْناهُمْ) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها (مِنْ عَمَلِهِمْ) متعلقان بمحذوف حال (مِنْ شَيْءٍ) من زائدة شيء مجرور لفظا منصوب محلا مفعول به ثان (كُلُّ) مبتدأ (امْرِئٍ) مضاف إليه (بِما) متعلقان برهين (كَسَبَ) ماض فاعله مستتر (رَهِينٌ) خبر كل والجملة الفعلية صلة ما والجملة الاسمية مستأنفة\r\n\r\n"},{"sura":52,"ayah":22,"words":[{"position":1,"arabic":"وَأَمْدَدْنَـٰهُم","translation":"And We will provide them","transliteration":"wa-amdadnāhum"},{"position":2,"arabic":"بِفَـٰكِهَةٍۢ","translation":"with fruit","transliteration":"bifākihatin"},{"position":3,"arabic":"وَلَحْمٍۢ","translation":"and meat","transliteration":"walaḥmin"},{"position":4,"arabic":"مِّمَّا","translation":"from what","transliteration":"mimmā"},{"position":5,"arabic":"يَشْتَهُونَ","translation":"they desire","transliteration":"yashtahūna"}],"e3rab":"(وَأَمْدَدْناهُمْ) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها (بِفاكِهَةٍ) متعلقان بالفعل (وَلَحْمٍ) معطوف على ما قبله (مِمَّا) متعلقان بمحذوف صفة لحم (يَشْتَهُونَ) مضارع مرفوع والواو فاعله والجملة صلة\r\n\r\n"},{"sura":52,"ayah":23,"words":[{"position":1,"arabic":"يَتَنَـٰزَعُونَ","translation":"They will pass to one another","transliteration":"yatanāzaʿūna"},{"position":2,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":3,"arabic":"كَأْسًۭا","translation":"a cup","transliteration":"kasan"},{"position":4,"arabic":"لَّا","translation":"no","transliteration":"lā"},{"position":5,"arabic":"لَغْوٌۭ","translation":"ill speech","transliteration":"laghwun"},{"position":6,"arabic":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":7,"arabic":"وَلَا","translation":"and no","transliteration":"walā"},{"position":8,"arabic":"تَأْثِيمٌۭ","translation":"sin","transliteration":"tathīmun"}],"e3rab":"(يَتَنازَعُونَ) مضارع مرفوع والواو فاعله والجملة حال (فِيها) متعلقان بالفعل (كَأْساً) مفعول به (لا) نافية مهملة 