nslation":"their plotting","transliteration":"kayduhum"},{"position":6,"arabic":"شَيْـًۭٔا","translation":"(in) anything","transliteration":"shayan"},{"position":7,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":8,"arabic":"هُمْ","translation":"they","transliteration":"hum"},{"position":9,"arabic":"يُنصَرُونَ","translation":"will be helped","transliteration":"yunṣarūna"}],"e3rab":"(يَوْمَ) بدل من يومهم (لا) نافية (يُغْنِي) مضارع مرفوع (عَنْهُمْ) متعلقان بالفعل (كَيْدُهُمْ) فاعل (شَيْئاً) مفعول به والجملة في محل جر بالإضافة (وَلا) حرف عطف ولا نافية (هُمْ) مبتدأ (يُنْصَرُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة الفعلية خبر هم والجملة الاسمية معطوفة على ما قبلها\r\n\r\n"},{"sura":52,"ayah":47,"words":[{"position":1,"arabic":"وَإِنَّ","translation":"And indeed","transliteration":"wa-inna"},{"position":2,"arabic":"لِلَّذِينَ","translation":"for those who","transliteration":"lilladhīna"},{"position":3,"arabic":"ظَلَمُوا۟","translation":"do wrong","transliteration":"ẓalamū"},{"position":4,"arabic":"عَذَابًۭا","translation":"(is) a punishment","transliteration":"ʿadhāban"},{"position":5,"arabic":"دُونَ","translation":"before","transliteration":"dūna"},{"position":6,"arabic":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":7,"arabic":"وَلَـٰكِنَّ","translation":"but","transliteration":"walākinna"},{"position":8,"arabic":"أَكْثَرَهُمْ","translation":"most of them","transliteration":"aktharahum"},{"position":9,"arabic":"لَا","translation":"(do) not","transliteration":"lā"},{"position":10,"arabic":"يَعْلَمُونَ","translation":"know","transliteration":"yaʿlamūna"}],"e3rab":"(وَإِنَّ) الواو حرف استئناف وإن حرف مشبه بالفعل (لِلَّذِينَ) خبر مقدم (ظَلَمُوا) ماض وفاعله والجملة صلة (عَذاباً) اسم إن المؤخر (دُونَ) ظرف مكان (ذلِكَ) مضاف إليه (وَلكِنَّ أَكْثَرَهُمْ) لكن واسمها (لا) نافية (يَعْلَمُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر لكن والجملة الاسمية معطوفة على ما قبلها\r\n\r\n"},{"sura":52,"ayah":48,"words":[{"position":1,"arabic":"وَٱصْبِرْ","translation":"So be patient","transliteration":"wa-iṣ'bir"},{"position":2,"arabic":"لِحُكْمِ","translation":"for (the) Command","transliteration":"liḥuk'mi"},{"position":3,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"arabic":"فَإِنَّكَ","translation":"for indeed, you","transliteration":"fa-innaka"},{"position":5,"arabic":"بِأَعْيُنِنَا ۖ","translation":"(are) in Our Eyes","transliteration":"bi-aʿyuninā"},{"position":6,"arabic":"وَسَبِّحْ","translation":"And glorify","transliteration":"wasabbiḥ"},{"position":7,"arabic":"بِحَمْدِ","translation":"(the) praise","transliteration":"biḥamdi"},{"position":8,"arabic":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":9,"arabic":"حِينَ","translation":"when","transliteration":"ḥīna"},{"position":10,"arabic":"تَقُومُ","translation":"you arise","transliteration":"taqūmu"}],"e3rab":"(وَاصْبِرْ) الواو حرف استئناف وأمر فاعله مستتر والجملة مستأنفة (لِحُكْمِ) متعلقان بالفعل (رَبِّكَ) مضاف إليه (فَإِنَّكَ) الفاء حرف تعليل وإن واسمها (بِأَعْيُنِنا) متعلقان بمحذوف خبر إن والجملة الاسمية تعليل (وَسَبِّحْ) حرف عطف وأمر فاعله مستتر (بِحَمْدِ) متعلقان بالفعل (رَبِّكَ) مضاف إليه والجملة معطوفة على ما قبلها (حِينَ) ظرف زمان (تَقُومُ) مضارع فاعله مستتر والجملة في محل جر بالإضافة\r\n\r\n"},{"sura":52,"ayah":49,"words":[{"position":1,"arabic":"وَمِنَ","translation":"And of","transliteration":"wamina"},{"position":2,"arabic":"ٱلَّيْلِ","translation":"the night","transliteration":"al-layli"},{"position":3,"arabic":"فَسَبِّحْهُ","translation":"glorify Him","transliteration":"fasabbiḥ'hu"},{"position":4,"arabic":"وَإِدْبَـٰرَ","translation":"and after","transliteration":"wa-id'bāra"},{"position":5,"arabic":"ٱلنُّجُومِ","translation":"the stars","transliteration":"l-nujūmi"}],"e3rab":"(وَمِنَ اللَّيْلِ) حرف عطف وجار ومجرور متعلقان بما بعدهما (فَسَبِّحْهُ) الفاء زائدة وأمر ومفعوله والفاعل مستتر (وَإِدْبارَ) حرف عطف وإدبار منصوب بنزع الخافض (النُّجُومِ) مضاف إليه.\r\n\r\n"}]