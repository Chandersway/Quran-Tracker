[{"sura":111,"ayah":1,"words":[{"position":1,"arabic":"تَبَّتْ","translation":"Perish","transliteration":"tabbat"},{"position":2,"arabic":"يَدَآ","translation":"(the) hands","transliteration":"yadā"},{"position":3,"arabic":"أَبِى","translation":"(of) Abu","transliteration":"abī"},{"position":4,"arabic":"لَهَبٍۢ","translation":"Lahab","transliteration":"lahabin"},{"position":5,"arabic":"وَتَبَّ","translation":"and perish he","transliteration":"watabba"}],"e3rab":"(تَبَّتْ) ماض والتاء للتأنيث (يَدا) فاعل مرفوع بالألف لأنه مثنى (أَبِي) مضاف إليه (لَهَبٍ) مضاف إليه أيضا والجملة ابتدائية لا محل لها (وَتَبَّ) ماض فاعله مستتر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":111,"ayah":2,"words":[{"position":1,"arabic":"مَآ","translation":"Not","transliteration":"mā"},{"position":2,"arabic":"أَغْنَىٰ","translation":"(will) avail","transliteration":"aghnā"},{"position":3,"arabic":"عَنْهُ","translation":"him","transliteration":"ʿanhu"},{"position":4,"arabic":"مَالُهُۥ","translation":"his wealth","transliteration":"māluhu"},{"position":5,"arabic":"وَمَا","translation":"and what","transliteration":"wamā"},{"position":6,"arabic":"كَسَبَ","translation":"he earned","transliteration":"kasaba"}],"e3rab":"(ما) نافية (أَغْنى) ماض (عَنْهُ) متعلقان بالفعل (مالُهُ) فاعل والجملة مستأنفة لا محل لها (وَما) اسم موصول معطوف على ماله (كَسَبَ) ماض فاعله مستتر والجملة صلة.\r\n\r\n"},{"sura":111,"ayah":3,"words":[{"position":1,"arabic":"سَيَصْلَىٰ","translation":"He will be burnt","transliteration":"sayaṣlā"},{"position":2,"arabic":"نَارًۭا","translation":"(in) a Fire","transliteration":"nāran"},{"position":3,"arabic":"ذَاتَ","translation":"of","transliteration":"dhāta"},{"position":4,"arabic":"لَهَبٍۢ","translation":"Blazing Flames","transliteration":"lahabin"}],"e3rab":"(سَيَصْلى) السين للاستقبال ومضارع فاعله مستتر (ناراً) مفعول به (ذاتَ) صفة نارا (لَهَبٍ) مضاف إليه. والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":111,"ayah":4,"words":[{"position":1,"arabic":"وَٱمْرَأَتُهُۥ","translation":"And his wife","transliteration":"wa-im'ra-atuhu"},{"position":2,"arabic":"حَمَّالَةَ","translation":"(the) carrier","transliteration":"ḥammālata"},{"position":3,"arabic":"ٱلْحَطَبِ","translation":"(of) firewood","transliteration":"l-ḥaṭabi"}],"e3rab":"(وَامْرَأَتُهُ) الواو حرف استئناف ومبتدأ (حَمَّالَةَ) مفعول به لفعل محذوف تقديره: أذم حمالة (الْحَطَبِ) مضاف إليه.\r\n\r\n"},{"sura":111,"ayah":5,"words":[{"position":1,"arabic":"فِى","translation":"In","transliteration":"fī"},{"position":2,"arabic":"جِيدِهَا","translation":"her neck","transliteration":"jīdihā"},{"position":3,"arabic":"حَبْلٌۭ","translation":"(will be) a rope","transliteration":"ḥablun"},{"position":4,"arabic":"مِّن","translation":"of","transliteration":"min"},{"position":5,"arabic":"مَّسَدٍۭ","translation":"palm-fiber","transliteration":"masadin"}],"e3rab":"(فِي جِيدِها) الجار والمجرور خبر مقدم (حَبْلٌ) مبتدأ مؤخر والجملة الاسمية خبر المبتدأ (مِنْ مَسَدٍ) صفة حبل وجملة امرأته.. مستأنفة لا محل لها. والجملة الفعلية (أذم حمالة الحطب) معترضة لا محل لها.\r\n\r\n"}]