[{"sura":84,"ayah":1,"words":[{"position":1,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":2,"arabic":"ٱلسَّمَآءُ","translation":"the sky","transliteration":"l-samāu"},{"position":3,"arabic":"ٱنشَقَّتْ","translation":"is split asunder","transliteration":"inshaqqat"}],"e3rab":"(إِذَا) ظرفية شرطية غير جازمة (السَّماءُ) فاعل لفعل محذوف يفسره المذكور بعده (انْشَقَّتْ) ماض فاعله مستتر والجملة مفسرة والجملة المقدرة في محل جر بالإضافة.\r\n\r\n"},{"sura":84,"ayah":2,"words":[{"position":1,"arabic":"وَأَذِنَتْ","translation":"And has listened","transliteration":"wa-adhinat"},{"position":2,"arabic":"لِرَبِّهَا","translation":"to its Lord","transliteration":"lirabbihā"},{"position":3,"arabic":"وَحُقَّتْ","translation":"and was obligated","transliteration":"waḥuqqat"}],"e3rab":"(وَأَذِنَتْ) ماض فاعله مستتر والجملة معطوفة على ما قبلها (لِرَبِّها) متعلقان بالفعل (وَحُقَّتْ) ماض مبني للمجهول ونائب الفاعل مستتر والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":84,"ayah":3,"words":[{"position":1,"arabic":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"arabic":"ٱلْأَرْضُ","translation":"the earth","transliteration":"l-arḍu"},{"position":3,"arabic":"مُدَّتْ","translation":"is spread","transliteration":"muddat"}],"e3rab":"(وَإِذَا) الواو حرف عطف والكلام معطوف على ما قبله وإعرابه واضح.\r\n\r\n"},{"sura":84,"ayah":4,"words":[{"position":1,"arabic":"وَأَلْقَتْ","translation":"And has cast out","transliteration":"wa-alqat"},{"position":2,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":3,"arabic":"فِيهَا","translation":"(is) in it","transliteration":"fīhā"},{"position":4,"arabic":"وَتَخَلَّتْ","translation":"and becomes empty","transliteration":"watakhallat"}],"e3rab":"الجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":84,"ayah":5,"words":[{"position":1,"arabic":"وَأَذِنَتْ","translation":"And has listened","transliteration":"wa-adhinat"},{"position":2,"arabic":"لِرَبِّهَا","translation":"to its Lord","transliteration":"lirabbihā"},{"position":3,"arabic":"وَحُقَّتْ","translation":"and was obligated","transliteration":"waḥuqqat"}],"e3rab":"سبق إعرابها.\r\n\r\n"},{"sura":84,"ayah":6,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلْإِنسَـٰنُ","translation":"mankind","transliteration":"l-insānu"},{"position":3,"arabic":"إِنَّكَ","translation":"Indeed, you","transliteration":"innaka"},{"position":4,"arabic":"كَادِحٌ","translation":"(are) laboring","transliteration":"kādiḥun"},{"position":5,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":6,"arabic":"رَبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":7,"arabic":"كَدْحًۭا","translation":"(with) exertion","transliteration":"kadḥan"},{"position":8,"arabic":"فَمُلَـٰقِيهِ","translation":"and you (will) meet Him","transliteration":"famulāqīhi"}],"e3rab":"(يا أَيُّهَا) يا حرف نداء ومنادى مبني على الضم (الْإِنْسانُ) بدل (إِنَّكَ) إن واسمها (كادِحٌ) خبرها والجملتان الاسمية والندائية ابتدائيتان لا محل لهما (إِلى رَبِّكَ) متعلقان بكادح (كَدْحاً) مفعول مطلق (فَمُلاقِيهِ) الفاء حرف عطف (ملاقيه) معطوف على كادح.\r\n\r\n"},{"sura":84,"ayah":7,"words":[{"position":1,"arabic":"فَأَمَّا","translation":"Then as for","transliteration":"fa-ammā"},{"position":2,"arabic":"مَنْ","translation":"(him) who","transliteration":"man"},{"position":3,"arabic":"أُوتِىَ","translation":"is given","transliteration":"ūtiya"},{"position":4,"arabic":"كِتَـٰبَهُۥ","translation":"his record","transliteration":"kitābahu"},{"position":5,"arabic":"بِيَمِينِهِۦ","translation":"in his right (hand)","transliteration":"biyamīnihi"}],"e3rab":"(فَأَمَّا) الفاء حرف استئناف (أما) حرف شرط وتفصيل (مَنْ) اسم موصول مبتدأ (أُوتِيَ) ماض مبني للمجهول ونائب الفاعل مستتر والجملة صلة من (كِتابَهُ) مفعول به ثان (بِيَمِينِهِ) متعلقان بالفعل.\r\n\r\n"},{"sura":84,"ayah":8,"words":[{"position":1,"arabic":"فَسَوْفَ","translation":"Then soon","transliteration":"fasawfa"},{"position":2,"arabic":"يُحَاسَبُ","translation":"his account will be taken","transliteration":"yuḥāsabu"},{"position":3,"arabic":"حِسَابًۭا","translation":"an account","transliteration":"ḥisāban"},{"position":4,"arabic":"يَسِيرًۭا","translation":"easy","transliteration":"yasīran"}],"e3rab":"(فَسَوْفَ) الفاء واقعة في جواب الشرط (سوف) للاستقبال (يُحاسَبُ) مضارع مبني للمجهول ونائب الفاعل مستتر (حِساباً) مفعول مطلق (يَسِيراً) صفة والجملة الفعلية خبر من.\r\n\r\n"},{"sura":84,"ayah":9,"words":[{"position":1,"arabic":"وَيَنقَلِبُ","translation":"And he will return","transliteration":"wayanqalibu"},{"position":2,"arabic":"إِلَىٰٓ","translation":"to","transliteration":"ilā"},{"position":3,"arabic":"أَهْلِهِۦ","translation":"his people","transliteration":"ahlihi"},{"position":4,"arabic":"مَسْرُورًۭا","translation":"happily","transliteration":"masrūran"}],"e3rab":"(وَيَنْقَلِبُ) مضارع فاعله مستتر (إِلى أَهْلِهِ) متعلقان بالفعل (مَسْرُوراً) حال والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":84,"ayah":10,"words":[{"position":1,"arabic":"وَأَمَّا","translation":"But as for","transliteration":"wa-ammā"},{"position":2,"arabic":"مَنْ","translation":"(him) who","transliteration":"man"},{"position":3,"arabic":"أُوتِىَ","translation":"is given","transliteration":"ūtiya"},{"position":4,"arabic":"كِتَـٰبَهُۥ","translation":"his record","transliteration":"kitābahu"},{"position":5,"arabic":"وَرَآءَ","translation":"behind","transliteration":"warāa"},{"position":6,"arabic":"ظَهْرِهِۦ","translation":"his back","transliteration":"ẓahrihi"}],"e3rab":"(وَأَمَّا) الواو حرف عطف (أَمَّا مَنْ أُوتِيَ) سبق إعرابه (كِتابَهُ) مفعول به ثان (وَراءَ) منصوب بنزع الخافض (ظَهْرِهِ) مضاف إليه\r\n\r\n"},{"sura":84,"ayah":11,"words":[{"position":1,"arabic":"فَسَوْفَ","translation":"Then soon","transliteration":"fasawfa"},{"position":2,"arabic":"يَدْعُوا۟","translation":"he will call","transliteration":"yadʿū"},{"position":3,"arabic":"ثُبُورًۭا","translation":"(for) destruction","transliteration":"thubūran"}],"e3rab":"(فَسَوْفَ) الفاء رابطة (سوف يَدْعُوا) سوف للاستقبال ومضارع فاعله مستتر والجملة خبر من (ثُبُوراً) مفعول به.\r\n\r\n"},{"sura":84,"ayah":12,"words":[{"position":1,"arabic":"وَيَصْلَىٰ","translation":"And he will burn","transliteration":"wayaṣlā"},{"position":2,"arabic":"سَعِيرًا","translation":"(in) a Blaze","transliteration":"saʿīran"}],"e3rab":"(وَيَصْلى) مضارع فاعله مستتر (سَعِيراً) مفعول به والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":84,"ayah":13,"words":[{"position":1,"arabic":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":2,"arabic":"كَانَ","translation":"had been","transliteration":"kāna"},{"position":3,"arabic":"فِىٓ","translation":"among","transliteration":"fī"},{"position":4,"arabic":"أَهْلِهِۦ","translation":"his people","transliteration":"ahlihi"},{"position":5,"arabic":"مَسْرُورًا","translation":"happy","transliteration":"masrūran"}],"e3rab":"(إِنَّهُ) إن واسمها (كانَ) ماض ناقص اسمه مستتر (فِي أَهْلِهِ) متعلقان بما بعدهما (مَسْرُوراً) خبر كان والجملة الفعلية خبر إن والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"},{"sura":84,"ayah":14,"words":[{"position":1,"arabic":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":2,"arabic":"ظَنَّ","translation":"(had) thought","transliteration":"ẓanna"},{"position":3,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":4,"arabic":"لَّن","translation":"never","transliteration":"lan"},{"position":5,"arabic":"يَحُورَ","translation":"he would return","transliteration":"yaḥūra"}],"e3rab":"(إِنَّهُ) إن واسمها (ظَنَّ) ماض فاعله مستتر والجملة خبر إن والجملة الاسمية بدل من سابقتها (أَنْ) مخففة من الثقيلة واسمها ضمير الشأن محذوف (لَنْ يَحُورَ) مضارع منصوب بلن والجملة الفعلية خبر أن المخففة والمصدر المؤول من أن وما بعدها سد مسد مفعولي ظن.\r\n\r\n"},{"sura":84,"ayah":15,"words":[{"position":1,"arabic":"بَلَىٰٓ","translation":"Yes","transliteration":"balā"},{"position":2,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":3,"arabic":"رَبَّهُۥ","translation":"his Lord","transliteration":"rabbahu"},{"position":4,"arabic":"كَانَ","translation":"was","transliteration":"kāna"},{"position":5,"arabic":"بِهِۦ","translation":"of him","transliteration":"bihi"},{"position":6,"arabic":"بَصِيرًۭا","translation":"All-Seer","transliteration":"baṣīran"}],"e3rab":"(بَلى) حرف جواب (إِنَّ رَبَّهُ) إن واسمها (كانَ) ماض ناقص اسمه مستتر (بِهِ) متعلقان بما بعدهما (بَصِيراً) خبر كان والجملة الفعلية خبر إن والجملة الاسمية جواب قسم مقدر.\r\n\r\n"},{"sura":84,"ayah":16,"words":[{"position":1,"arabic":"فَلَآ","translation":"But nay","transliteration":"falā"},{"position":2,"arabic":"أُقْسِمُ","translation":"I swear","transliteration":"uq'simu"},{"position":3,"arabic":"بِٱلشَّفَقِ","translation":"by the twilight glow","transliteration":"bil-shafaqi"}],"e3rab":"(فَلا) الفاء حرف استئناف (لا) زائدة (أُقْسِمُ) مضارع فاعله مستتر (بِالشَّفَقِ) متعلقان بالفعل والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":84,"ayah":17,"words":[{"position":1,"arabic":"وَٱلَّيْلِ","translation":"And the night","transliteration":"wa-al-layli"},{"position":2,"arabic":"وَمَا","translation":"and what","transliteration":"wamā"},{"position":3,"arabic":"وَسَقَ","translation":"it envelops","transliteration":"wasaqa"}],"e3rab":"(وَاللَّيْلِ) معطوف على الشفق (وَما) اسم موصول معطوف على الليل (وَسَقَ) ماض فاعله مستتر والجملة صلة ما.\r\n\r\n"},{"sura":84,"ayah":18,"words":[{"position":1,"arabic":"وَٱلْقَمَرِ","translation":"And the moon","transliteration":"wal-qamari"},{"position":2,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"arabic":"ٱتَّسَقَ","translation":"it becomes full","transliteration":"ittasaqa"}],"e3rab":"(وَالْقَمَرِ) معطوف على ما قبله (إِذَا) ظرف زمان (اتَّسَقَ) ماض فاعله مستتر والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":84,"ayah":19,"words":[{"position":1,"arabic":"لَتَرْكَبُنَّ","translation":"You will surely embark","transliteration":"latarkabunna"},{"position":2,"arabic":"طَبَقًا","translation":"(to) stage","transliteration":"ṭabaqan"},{"position":3,"arabic":"عَن","translation":"from","transliteration":"ʿan"},{"position":4,"arabic":"طَبَقٍۢ","translation":"stage","transliteration":"ṭabaqin"}],"e3rab":"(لَتَرْكَبُنَّ) اللام واقعة في جواب القسم ومضارع مرفوع بثبوت النون المحذوفة لتوالي الأمثال والواو المحذوفة لالتقاء الساكنين فاعل والنون المذكورة للتوكيد (طَبَقاً) مفعول به (عَنْ طَبَقٍ) متعلقان بمحذوف صفة طبقا.\r\n\r\n"},{"sura":84,"ayah":20,"words":[{"position":1,"arabic":"فَمَا","translation":"So what","transliteration":"famā"},{"position":2,"arabic":"لَهُمْ","translation":"(is) for them","transliteration":"lahum"},{"position":3,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":4,"arabic":"يُؤْمِنُونَ","translation":"they believe","transliteration":"yu'minūna"}],"e3rab":"(فَما) الفاء حرف استئناف (ما) اسم استفهام مبتدأ (لَهُمْ) خبر المبتدأ والجملة الاسمية مستأنفة (لا) نافية (يُؤْمِنُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية حال.\r\n\r\n"},{"sura":84,"ayah":21,"words":[{"position":1,"arabic":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"arabic":"قُرِئَ","translation":"is recited","transliteration":"quri-a"},{"position":3,"arabic":"عَلَيْهِمُ","translation":"to them","transliteration":"ʿalayhimu"},{"position":4,"arabic":"ٱلْقُرْءَانُ","translation":"the Quran","transliteration":"l-qur'ānu"},{"position":5,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":6,"arabic":"يَسْجُدُونَ ۩","translation":"they prostrate","transliteration":"yasjudūna"}],"e3rab":"(وَإِذا) الواو حرف عطف (إِذا) ظرفية شرطية غير جازمة (قُرِئَ) ماض مبني للمجهول (عَلَيْهِمُ) متعلقان بالفعل (الْقُرْآنُ) نائب فاعل والجملة في محل جر بالإضافة (لا) نافية (يَسْجُدُونَ) مضارع مرفوع والواو فاعله والجملة جواب الشرط لا محل لها. وجملة إذا.. معطوفة على ما قبلها.\r\n\r\n"},{"sura":84,"ayah":22,"words":[{"position":1,"arabic":"بَلِ","translation":"Nay","transliteration":"bali"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"Those who","transliteration":"alladhīna"},{"position":3,"arabic":"كَفَرُوا۟","translation":"disbelieved","transliteration":"kafarū"},{"position":4,"arabic":"يُكَذِّبُونَ","translation":"deny","transliteration":"yukadhibūna"}],"e3rab":"(بَلِ) حرف إضراب وانتقال (الَّذِينَ) اسم موصول مبتدأ (كَفَرُوا) ماض وفاعله والجملة صلة (يُكَذِّبُونَ) مضارع مرفوع بثبوت النون والواو فاعله والجملة خبر المبتدأ والجملة الاسمية مستأنفة لا محل لها.\r\n\r\n"},{"sura":84,"ayah":23,"words":[{"position":1,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":2,"arabic":"أَعْلَمُ","translation":"(is) most knowing","transliteration":"aʿlamu"},{"position":3,"arabic":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":4,"arabic":"يُوعُونَ","translation":"they keep within themselves","transliteration":"yūʿūna"}],"e3rab":"(وَاللَّهُ أَعْلَمُ) مبتدأ وخبره والجملة معطوفة على ما قبلها (بِما) متعلقان بما قبلهما (يُوعُونَ) مضارع مرفوع بثبوت النون والواو فاعله، معنى يوعون: يجمعون في صحفهم الذنوب، والجملة صلة ما.\r\n\r\n"},{"sura":84,"ayah":24,"words":[{"position":1,"arabic":"فَبَشِّرْهُم","translation":"so give them tidings","transliteration":"fabashir'hum"},{"position":2,"arabic":"بِعَذَابٍ","translation":"of a punishment","transliteration":"biʿadhābin"},{"position":3,"arabic":"أَلِيمٍ","translation":"painful","transliteration":"alīmin"}],"e3rab":"(فَبَشِّرْهُمْ) الفاء الفصيحة وأمر ومفعوله والفاعل مستتر (بِعَذابٍ) متعلقان بالفعل (أَلِيمٍ) صفة والجملة جواب شرط مقدر لا محل لها.\r\n\r\n"},{"sura":84,"ayah":25,"words":[{"position":1,"arabic":"إِلَّا","translation":"Except","transliteration":"illā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"وَعَمِلُوا۟","translation":"and do","transliteration":"waʿamilū"},{"position":5,"arabic":"ٱلصَّـٰلِحَـٰتِ","translation":"righteous deeds","transliteration":"l-ṣāliḥāti"},{"position":6,"arabic":"لَهُمْ","translation":"For them","transliteration":"lahum"},{"position":7,"arabic":"أَجْرٌ","translation":"(is) a reward","transliteration":"ajrun"},{"position":8,"arabic":"غَيْرُ","translation":"never","transliteration":"ghayru"},{"position":9,"arabic":"مَمْنُونٍۭ","translation":"ending","transliteration":"mamnūnin"}],"e3rab":"(إِلَّا) حرف استثناء (الَّذِينَ) مستثنى منصوب (آمَنُوا) ماض وفاعله والجملة صلة (وَعَمِلُوا) معطوف على آمنوا (الصَّالِحاتِ) مفعول به (لَهُمْ أَجْرٌ) خبر مقدم ومبتدأ مؤخر (غَيْرُ مَمْنُونٍ) صفة مضاف إلى ممنون والجملة مستأنفة.\r\n\r\n"}]