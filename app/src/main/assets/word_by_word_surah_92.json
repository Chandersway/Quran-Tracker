[{"sura":92,"ayah":1,"words":[{"position":1,"arabic":"وَٱلَّيْلِ","translation":"By the night","transliteration":"wa-al-layli"},{"position":2,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"arabic":"يَغْشَىٰ","translation":"it covers","transliteration":"yaghshā"}],"e3rab":"(وَاللَّيْلِ) جار ومجرور متعلقان بفعل قسم محذوف (إِذا) ظرف زمان (يَغْشى) مضارع فاعله مستتر والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":92,"ayah":2,"words":[{"position":1,"arabic":"وَٱلنَّهَارِ","translation":"And the day","transliteration":"wal-nahāri"},{"position":2,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"arabic":"تَجَلَّىٰ","translation":"it shines in brightness","transliteration":"tajallā"}],"e3rab":"معطوفة على ما قبلها والإعراب مماثل.\r\n\r\n"},{"sura":92,"ayah":3,"words":[{"position":1,"arabic":"وَمَا","translation":"And He Who","transliteration":"wamā"},{"position":2,"arabic":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":3,"arabic":"ٱلذَّكَرَ","translation":"the male","transliteration":"l-dhakara"},{"position":4,"arabic":"وَٱلْأُنثَىٰٓ","translation":"and the female","transliteration":"wal-unthā"}],"e3rab":"(وَما) اسم موصول معطوف على ما قبله (خَلَقَ) ماض فاعله مستتر (الذَّكَرَ) مفعول به (وَالْأُنْثى) معطوف على الذكر والجملة صلة.\r\n\r\n"},{"sura":92,"ayah":4,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"سَعْيَكُمْ","translation":"your efforts","transliteration":"saʿyakum"},{"position":3,"arabic":"لَشَتَّىٰ","translation":"(are) surely diverse","transliteration":"lashattā"}],"e3rab":"(إِنَّ سَعْيَكُمْ) إن واسمها واللام المزحلقة (لَشَتَّى) خبرها والجملة جواب القسم لا محل لها.\r\n\r\n"},{"sura":92,"ayah":5,"words":[{"position":1,"arabic":"فَأَمَّا","translation":"Then as for","transliteration":"fa-ammā"},{"position":2,"arabic":"مَنْ","translation":"(him) who","transliteration":"man"},{"position":3,"arabic":"أَعْطَىٰ","translation":"gives","transliteration":"aʿṭā"},{"position":4,"arabic":"وَٱتَّقَىٰ","translation":"and fears","transliteration":"wa-ittaqā"}],"e3rab":"(فَأَمَّا) الفاء حرف تفريع واستئناف (أما) حرف شرط وتفصيل (مَنْ) مبتدأ (أَعْطى) ماض والفاعل مستتر (وَاتَّقى) معطوف على أعطى. وجملة أعطى صلة.\r\n\r\n"},{"sura":92,"ayah":6,"words":[{"position":1,"arabic":"وَصَدَّقَ","translation":"And believes","transliteration":"waṣaddaqa"},{"position":2,"arabic":"بِٱلْحُسْنَىٰ","translation":"in the best","transliteration":"bil-ḥus'nā"}],"e3rab":"معطوفة على ما قبلها.\r\n\r\n"},{"sura":92,"ayah":7,"words":[{"position":1,"arabic":"فَسَنُيَسِّرُهُۥ","translation":"Then We will ease him","transliteration":"fasanuyassiruhu"},{"position":2,"arabic":"لِلْيُسْرَىٰ","translation":"towards [the] ease","transliteration":"lil'yus'rā"}],"e3rab":"(فَسَنُيَسِّرُهُ) الفاء واقعة في جواب من والسين للاستقبال ومضارع ومفعوله والفاعل مستتر (لِلْيُسْرى) متعلقان بالفعل والجملة خبر المبتدأ من.\r\n\r\n"},{"sura":92,"ayah":8,"words":[{"position":1,"arabic":"وَأَمَّا","translation":"But as for","transliteration":"wa-ammā"},{"position":2,"arabic":"مَنۢ","translation":"(him) who","transliteration":"man"},{"position":3,"arabic":"بَخِلَ","translation":"withholds","transliteration":"bakhila"},{"position":4,"arabic":"وَٱسْتَغْنَىٰ","translation":"and considers himself free from need","transliteration":"wa-is'taghnā"}],"e3rab":"معطوفة على ما قبلها والإعراب واحد.\r\n\r\n"},{"sura":92,"ayah":9,"words":[{"position":1,"arabic":"وَكَذَّبَ","translation":"And denies","transliteration":"wakadhaba"},{"position":2,"arabic":"بِٱلْحُسْنَىٰ","translation":"the best","transliteration":"bil-ḥus'nā"}],"e3rab":"معطوفة أيضا على ما قبلها وإعرابه مثل سابقه.\r\n\r\n"},{"sura":92,"ayah":10,"words":[{"position":1,"arabic":"فَسَنُيَسِّرُهُۥ","translation":"Then We will ease him","transliteration":"fasanuyassiruhu"},{"position":2,"arabic":"لِلْعُسْرَىٰ","translation":"towards [the] difficulty","transliteration":"lil'ʿus'rā"}],"e3rab":"انظر الآية رقم - 7 - .\r\n\r\n"},{"sura":92,"ayah":11,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"يُغْنِى","translation":"will avail","transliteration":"yugh'nī"},{"position":3,"arabic":"عَنْهُ","translation":"him","transliteration":"ʿanhu"},{"position":4,"arabic":"مَالُهُۥٓ","translation":"his wealth","transliteration":"māluhu"},{"position":5,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":6,"arabic":"تَرَدَّىٰٓ","translation":"he falls","transliteration":"taraddā"}],"e3rab":"(وَما) الواو حرف استئناف (وَما) نافية (يُغْنِي) مضارع مرفوع (عَنْهُ) متعلقان بالفعل (مالُهُ) فاعل والجملة مستأنفة لا محل لها.\r\n\r\n(إِذا) ظرف زمان (تَرَدَّى) ماض فاعله مستتر والجملة في محل جر بالإضافة.\r\n\r\n"},{"sura":92,"ayah":12,"words":[{"position":1,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"arabic":"عَلَيْنَا","translation":"upon Us","transliteration":"ʿalaynā"},{"position":3,"arabic":"لَلْهُدَىٰ","translation":"(is) the guidance","transliteration":"lalhudā"}],"e3rab":"(إِنَّ) حرف مشبه بالفعل (عَلَيْنا) متعلقان بمحذوف خبر إن المقدم (لَلْهُدى) اللام لام المزحلقة (الهدى) اسم إن المؤخر، والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":92,"ayah":13,"words":[{"position":1,"arabic":"وَإِنَّ","translation":"And indeed","transliteration":"wa-inna"},{"position":2,"arabic":"لَنَا","translation":"for Us","transliteration":"lanā"},{"position":3,"arabic":"لَلْـَٔاخِرَةَ","translation":"(is) the Hereafter","transliteration":"lalākhirata"},{"position":4,"arabic":"وَٱلْأُولَىٰ","translation":"and the first (life)","transliteration":"wal-ūlā"}],"e3rab":"معطوفة على ما قبلها وإعرابها مثلها.\r\n\r\n"},{"sura":92,"ayah":14,"words":[{"position":1,"arabic":"فَأَنذَرْتُكُمْ","translation":"So I warn you","transliteration":"fa-andhartukum"},{"position":2,"arabic":"نَارًۭا","translation":"(of) a Fire","transliteration":"nāran"},{"position":3,"arabic":"تَلَظَّىٰ","translation":"blazing","transliteration":"talaẓẓā"}],"e3rab":"(فَأَنْذَرْتُكُمْ) الفاء حرف استئناف وماض وفاعله ومفعوله الأول (ناراً) مفعول به ثان والجملة مستأنفة لا محل لها.\r\n\r\n(تَلَظَّى) مضارع فاعله مستتر والجملة صفة نارا.\r\n\r\n"},{"sura":92,"ayah":15,"words":[{"position":1,"arabic":"لَا","translation":"Not","transliteration":"lā"},{"position":2,"arabic":"يَصْلَىٰهَآ","translation":"will burn (in) it","transliteration":"yaṣlāhā"},{"position":3,"arabic":"إِلَّا","translation":"except","transliteration":"illā"},{"position":4,"arabic":"ٱلْأَشْقَى","translation":"the most wretched","transliteration":"l-ashqā"}],"e3rab":"(لا يَصْلاها) لا نافية ومضارع ومفعوله (إِلَّا) حرف حصر (الْأَشْقَى) فاعل والجملة صفة ثانية لنارا.\r\n\r\n"},{"sura":92,"ayah":16,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"The one who","transliteration":"alladhī"},{"position":2,"arabic":"كَذَّبَ","translation":"denied","transliteration":"kadhaba"},{"position":3,"arabic":"وَتَوَلَّىٰ","translation":"and turned away","transliteration":"watawallā"}],"e3rab":"(الَّذِي) اسم موصول صفة للأشقى (كَذَّبَ) ماض فاعله مستتر والجملة صلة (وَتَوَلَّى) معطوف على كذب.\r\n\r\n"},{"sura":92,"ayah":17,"words":[{"position":1,"arabic":"وَسَيُجَنَّبُهَا","translation":"But will be removed from it","transliteration":"wasayujannabuhā"},{"position":2,"arabic":"ٱلْأَتْقَى","translation":"the righteous","transliteration":"l-atqā"}],"e3rab":"(وَسَيُجَنَّبُهَا) الواو حرف عطف والسين للاستقبال ومضارع مبني للمجهول وها مفعول به (الْأَتْقَى) نائب فاعل. والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":92,"ayah":18,"words":[{"position":1,"arabic":"ٱلَّذِى","translation":"The one who","transliteration":"alladhī"},{"position":2,"arabic":"يُؤْتِى","translation":"gives","transliteration":"yu'tī"},{"position":3,"arabic":"مَالَهُۥ","translation":"his wealth","transliteration":"mālahu"},{"position":4,"arabic":"يَتَزَكَّىٰ","translation":"(to) purify himself","transliteration":"yatazakkā"}],"e3rab":"(الَّذِي) اسم موصول صفة الأتقى (يُؤْتِي) مضارع فاعله مستتر (مالَهُ) مفعول به والجملة صلة (يَتَزَكَّى) مضارع فاعله مستتر والجملة حال.\r\n\r\n"},{"sura":92,"ayah":19,"words":[{"position":1,"arabic":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"arabic":"لِأَحَدٍ","translation":"for anyone","transliteration":"li-aḥadin"},{"position":3,"arabic":"عِندَهُۥ","translation":"with him","transliteration":"ʿindahu"},{"position":4,"arabic":"مِن","translation":"any","transliteration":"min"},{"position":5,"arabic":"نِّعْمَةٍۢ","translation":"favor","transliteration":"niʿ'matin"},{"position":6,"arabic":"تُجْزَىٰٓ","translation":"to be recompensed","transliteration":"tuj'zā"}],"e3rab":"(وَما) الواو حرف عطف (ما) نافية (لِأَحَدٍ) خبر مقدم (عِنْدَهُ) ظرف مكان (مِنْ) حرف جر زائد (نِعْمَةٍ) مجرور لفظا مرفوع محلا مبتدأ مؤخر والجملة معطوفة على ما قبلها (تُجْزى) مضارع مبني للمجهول ونائب الفاعل مستتر والجملة صفة نعمة.\r\n\r\n"},{"sura":92,"ayah":20,"words":[{"position":1,"arabic":"إِلَّا","translation":"Except","transliteration":"illā"},{"position":2,"arabic":"ٱبْتِغَآءَ","translation":"seeking","transliteration":"ib'tighāa"},{"position":3,"arabic":"وَجْهِ","translation":"(the) Countenance","transliteration":"wajhi"},{"position":4,"arabic":"رَبِّهِ","translation":"(of) his Lord","transliteration":"rabbihi"},{"position":5,"arabic":"ٱلْأَعْلَىٰ","translation":"the Most High","transliteration":"l-aʿlā"}],"e3rab":"(إِلَّا) حرف استثناء (ابْتِغاءَ) مستثنى منصوب (وَجْهِ) مضاف إليه (رَبِّهِ) مضاف إليه أيضا (الْأَعْلى) صفة وجه.\r\n\r\n"},{"sura":92,"ayah":21,"words":[{"position":1,"arabic":"وَلَسَوْفَ","translation":"And soon, surely","transliteration":"walasawfa"},{"position":2,"arabic":"يَرْضَىٰ","translation":"he will be pleased","transliteration":"yarḍā"}],"e3rab":"(وَلَسَوْفَ) الواو حرف قسم وجر واللام واقعة في جواب القسم (سوف) حرف تسويف واستقبال (يَرْضى) مضارع فاعله مستتر والجملة جواب القسم لا محل لها.\r\n\r\n"}]