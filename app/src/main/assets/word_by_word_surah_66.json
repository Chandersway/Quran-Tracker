ُكَفِّرَ) مضارع منصوب بأن والمصدر المؤول من أن والفعل في محل نصب خبر عسى (عَنْكُمْ) متعلقان بالفعل (سَيِّئاتِكُمْ) مفعول به (وَيُدْخِلَكُمْ) مضارع ومفعوله الأول والفاعل مستتر والجملة معطوفة على يكفر (جَنَّاتٍ) مفعول به ثان (تَجْرِي) مضارع (مِنْ تَحْتِهَا) متعلقان بالفعل (الْأَنْهارُ) فاعل والجملة صفة جنات (يَوْمَ) ظرف زمان (لا) نافية (يُخْزِي اللَّهُ النَّبِيَّ) مضارع وفاعله ومفعوله والجملة في محل جر بالإضافة (وَالَّذِينَ) معطوف على النبي (آمَنُوا) ماض وفاعله والجملة صلة.\r\n\r\n(مَعَهُ) ظرف مكان (نُورُهُمْ) مبتدأ (يَسْعى) مضارع فاعله مستتر والجملة الفعلية خبر المبتدأ والجملة الاسمية حال (بَيْنَ أَيْدِيهِمْ) ظرف مكان مضاف إلى أيديهم (وَبِأَيْمانِهِمْ) معطوفان على الظرف (يَقُولُونَ) مضارع وفاعله والجملة حال (رَبَّنا) منادى مضاف (أَتْمِمْ) فعل دعاء فاعله مستتر (لَنا) متعلقان بالفعل (نُورَنا) مفعول به والجملتان مقول القول (وَاغْفِرْ لَنا) معطوف على ما قبله، (إِنَّكَ) إن واسمها (عَلى كُلِّ) متعلقان بقدير (شَيْءٍ) مضاف إليه (قَدِيرٌ) خبر إنّ والجملة الاسمية تعليلية.\r\n\r\n"},{"sura":66,"ayah":9,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلنَّبِىُّ","translation":"Prophet","transliteration":"l-nabiyu"},{"position":3,"arabic":"جَـٰهِدِ","translation":"Strive","transliteration":"jāhidi"},{"position":4,"arabic":"ٱلْكُفَّارَ","translation":"(against) the disbelievers","transliteration":"l-kufāra"},{"position":5,"arabic":"وَٱلْمُنَـٰفِقِينَ","translation":"and the hypocrites","transliteration":"wal-munāfiqīna"},{"position":6,"arabic":"وَٱغْلُظْ","translation":"and be stern","transliteration":"wa-ugh'luẓ"},{"position":7,"arabic":"عَلَيْهِمْ ۚ","translation":"with them","transliteration":"ʿalayhim"},{"position":8,"arabic":"وَمَأْوَىٰهُمْ","translation":"And their abode","transliteration":"wamawāhum"},{"position":9,"arabic":"جَهَنَّمُ ۖ","translation":"(is) Hell","transliteration":"jahannamu"},{"position":10,"arabic":"وَبِئْسَ","translation":"and wretched is","transliteration":"wabi'sa"},{"position":11,"arabic":"ٱلْمَصِيرُ","translation":"the destination","transliteration":"l-maṣīru"}],"e3rab":"(يا أَيُّهَا النَّبِيُّ) سبق إعرابها.\r\n\r\n(جاهِدِ الْكُفَّارَ) فعل أمر والكفار مفعوله (وَالْمُنافِقِينَ) معطوف على الكفار (وَاغْلُظْ) أمر فاعله مستتر (عَلَيْهِمْ) متعلقان بالفعل والجملة معطوفة على ما قبلها.\r\n\r\n(وَمَأْواهُمْ جَهَنَّمُ) مبتدأ وخبره والجملة حالية (وَبِئْسَ الْمَصِيرُ) ماض وفاعله والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":66,"ayah":10,"words":[{"position":1,"arabic":"ضَرَبَ","translation":"Presents","transliteration":"ḍaraba"},{"position":2,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":3,"arabic":"مَثَلًۭا","translation":"an example","transliteration":"mathalan"},{"position":4,"arabic":"لِّلَّذِينَ","translation":"for those who","transliteration":"lilladhīna"},{"position":5,"arabic":"كَفَرُوا۟","translation":"disbelieved ","transliteration":"kafarū"},{"position":6,"arabic":"ٱمْرَأَتَ","translation":"(the) wife","transliteration":"im'ra-ata"},{"position":7,"arabic":"نُوحٍۢ","translation":"(of) Nuh","transliteration":"nūḥin"},{"position":8,"arabic":"وَٱمْرَأَتَ","translation":"(and the) wife","transliteration":"wa-im'ra-ata"},{"position":9,"arabic":"لُوطٍۢ ۖ","translation":"(of) Lut","transliteration":"lūṭin"},{"position":10,"arabic":"كَانَتَا","translation":"They were","transliteration":"kānatā"},{"position":11,"arabic":"تَحْتَ","translation":"under","transliteration":"taḥta"},{"position":12,"arabic":"عَبْدَيْنِ","translation":"two [slaves]","transliteration":"ʿabdayni"},{"position":13,"arabic":"مِنْ","translation":"of","transliteration":"min"},{"position":14,"arabic":"عِبَادِنَا","translation":"Our slaves","transliteration":"ʿibādinā"},{"position":15,"arabic":"صَـٰلِحَيْنِ","translation":"righteous","transliteration":"ṣāliḥayni"},{"position":16,"arabic":"فَخَانَتَاهُمَا","translation":"but they both betrayed them","transliteration":"fakhānatāhumā"},{"position":17,"arabic":"فَلَمْ","translation":"so not","transliteration":"falam"},{"position":18,"arabic":"يُغْنِيَا","translation":"they availed","transliteration":"yugh'niyā"},{"position":19,"arabic":"عَنْهُمَا","translation":"both of them","transliteration":"ʿanhumā"},{"position":20,"arabic":"مِنَ","translation":"from","transliteration":"mina"},{"position":21,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":22,"arabic":"شَيْـًۭٔا","translation":"(in) anything","transliteration":"shayan"},{"position":23,"arabic":"وَقِيلَ","translation":"and it was said","transliteration":"waqīla"},{"position":24,"arabic":"ٱدْخُلَا","translation":"Enter","transliteration":"ud'khulā"},{"position":25,"arabic":"ٱلنَّارَ","translation":"the Fire","transliteration":"l-nāra"},{"position":26,"arabic":"مَعَ","translation":"with","transliteration":"maʿa"},{"position":27,"arabic":"ٱلدَّٰخِلِينَ","translation":"those who enter","transliteration":"l-dākhilīna"}],"e3rab":"(ضَرَبَ اللَّهُ مَثَلًا) ماض وفاعله ومفعوله والجملة استئنافية لا محل لها (لِلَّذِينَ) متعلقان بالفعل (كَفَرُوا) ماض وفاعله والجملة صلة (امْرَأَتَ نُوحٍ) بدل مضاف إلى نوح (وَامْرَأَتَ لُوطٍ) معطوف على ما قبله.\r\n\r\n(كانَتا) كان واسمها (تَحْتَ) ظرف مكان متعلق بمحذوف خبر كان (عَبْدَيْنِ) مضاف إليه (مِنْ) (عِبادِنا) متعلقان بمحذوف صفة عبدين (صالِحَيْنِ) صفة عبدين والجملة حال.\r\n\r\n(فَخانَتاهُما) الفاء حرف عطف وماض وفاعله ومفعوله والجملة معطوفة على ما قبلها.\r\n\r\n(فَلَمْ يُغْنِيا) مضارع مجزوم بلم والألف فاعله والجملة معطوفة على ما قبلها (عَنْهُما) متعلقان بالفعل (مِنَ اللَّهِ) حال (شَيْئاً) مفعول به (وَقِيلَ) ماض مبني للمجهول والجملة معطوفة على ما قبلها (ادْخُلَا) أمر وفاعله والجملة مقول القول (النَّارَ) مفعول به (مَعَ) ظرف مكان (الدَّاخِلِينَ) مضاف إليه.\r\n\r\n"},{"sura":66,"ayah":11,"words":[{"position":1,"arabic":"وَضَرَبَ","translation":"And presents","transliteration":"waḍaraba"},{"position":2,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":3,"arabic":"مَثَلًۭا","translation":"an example","transliteration":"mathalan"},{"position":4,"arabic":"لِّلَّذِينَ","translation":"for those who","transliteration":"lilladhīna"},{"position":5,"arabic":"ءَامَنُوا۟","translation":"believed ","transliteration":"āmanū"},{"position":6,"arabic":"ٱمْرَأَتَ","translation":"(the) wife","transliteration":"im'ra-ata"},{"position":7,"arabic":"فِرْعَوْنَ","translation":"(of) Firaun","transliteration":"fir'ʿawna"},{"position":8,"arabic":"إِذْ","translation":"when","transliteration":"idh"},{"position":9,"arabic":"قَالَتْ","translation":"she said","transliteration":"qālat"},{"position":10,"arabic":"رَبِّ","translation":"My Lord","transliteration":"rabbi"},{"position":11,"arabic":"ٱبْنِ","translation":"Build","transliteration":"ib'ni"},{"position":12,"arabic":"لِى","translation":"for me","transliteration":"lī"},{"position":13,"arabic":"عِندَكَ","translation":"near You","transliteration":"ʿindaka"},{"position":14,"arabic":"بَيْتًۭا","translation":"a house","transliteration":"baytan"},{"position":15,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":16,"arabic":"ٱلْجَنَّةِ","translation":"Paradise","transliteration":"l-janati"},{"position":17,"arabic":"وَنَجِّنِى","translation":"and save me","transliteration":"wanajjinī"},{"position":18,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":19,"arabic":"فِرْعَوْنَ","translation":"Firaun","transliteration":"fir'ʿawna"},{"position":20,"arabic":"وَعَمَلِهِۦ","translation":"and his deeds","transliteration":"waʿamalihi"},{"position":21,"arabic":"وَنَجِّنِى","translation":"and save me","transliteration":"wanajjinī"},{"position":22,"arabic":"مِنَ","translation":"from","transliteration":"mina"},{"position":23,"arabic":"ٱلْقَوْمِ","translation":"the people","transliteration":"l-qawmi"},{"position":24,"arabic":"ٱلظَّـٰلِمِينَ","translation":"the wrongdoers","transliteration":"l-ẓālimīna"}],"e3rab":"(وَضَرَبَ اللَّهُ مَثَلًا لِلَّذِينَ آمَنُوا امْرَأَتَ فِرْعَوْنَ): سبق إعراب مثيله.\r\n\r\n(إِذْ) ظرف زمان (قالَتْ رَبِّ) ماض فاعله مستتر ومنادى مضاف إلى ياء المتكلم المحذوفة (ابْنِ) فعل دعاء مبني على حذف حرف العلة والفاعل مستتر والجملتان مقول القول وجملة قالت في محل جر بالإضافة (لِي) متعلقان بابن (عِنْدَكَ) ظرف مكان (بَيْتاً) مفعول به (فِي الْجَنَّةِ) متعلقان بمحذوف صفة (وَنَجِّنِي) فعل دعاء ومفعوله والفاعل مستتر (مِنْ فِرْعَوْنَ) متعلقان بالفعل والجملة معطوفة على ما قبلها (وَعَمَلِهِ) معطوف على ما قبله (وَنَجِّنِي مِنَ الْقَوْمِ) معطوف على ما قبله (الظَّالِمِينَ) صفة القوم.\r\n\r\n"},{"sura":66,"ayah":12,"words":[{"position":1,"arabic":"وَمَرْيَمَ","translation":"And Maryam","transliteration":"wamaryama"},{"position":2,"arabic":"ٱبْنَتَ","translation":"(the) daughter","transliteration":"ib'nata"},{"position":3,"arabic":"عِمْرَٰنَ","translation":"(of) Imran","transliteration":"ʿim'rāna"},{"position":4,"arabic":"ٱلَّتِىٓ","translation":"who","transliteration":"allatī"},{"position":5,"arabic":"أَحْصَنَتْ","translation":"guarded","transliteration":"aḥṣanat"},{"position":6,"arabic":"فَرْجَهَا","translation":"her chastity","transliteration":"farjahā"},{"position":7,"arabic":"فَنَفَخْنَا","translation":"so We breathed","transliteration":"fanafakhnā"},{"position":8,"arabic":"فِيهِ","translation":"into it","transliteration":"fīhi"},{"position":9,"arabic":"مِن","translation":"of","transliteration":"min"},{"position":10,"arabic":"رُّوحِنَا","translation":"Our Spirit","transliteration":"rūḥinā"},{"position":11,"arabic":"وَصَدَّقَتْ","translation":"And she believed","transliteration":"waṣaddaqat"},{"position":12,"arabic":"بِكَلِمَـٰتِ","translation":"(in the) Words","transliteration":"bikalimāti"},{"position":13,"arabic":"رَبِّهَا","translation":"(of) her Lord","transliteration":"rabbihā"},{"position":14,"arabic":"وَكُتُبِهِۦ","translation":"and His Books","transliteration":"wakutubihi"},{"position":15,"arabic":"وَكَانَتْ","translation":"and she was","transliteration":"wakānat"},{"position":16,"arabic":"مِنَ","translation":"of","transliteration":"mina"},{"position":17,"arabic":"ٱلْقَـٰنِتِينَ","translation":"the devoutly obedient","transliteration":"l-qānitīna"}],"e3rab":"(وَمَرْيَمَ) معطوف على امرأة فرعون (ابْنَتَ عِمْرانَ) صفة مريم مضاف إلى عمران (الَّتِي) صفة مريم أيضا (أَحْصَنَتْ) ماض فاعله مستتر (فَرْجَها) مفعول به والجملة صلة.\r\n\r\n(فَنَفَخْنا) ماض وفاعله والجملة معطوفة على ما قبلها (فِيهِ) متعلقان بالفعل (مِنْ رُوحِنا) متعلقان بالفعل أيضا، (وَصَدَّقَتْ) فعل ماض فاعله مستتر والجملة معطوفة على ما قبلها (بِكَلِماتِ) متعلقان بالفعل (رَبِّها) مضاف إليه (وَكُتُبِهِ) معطوف على ما قبله (وَكانَتْ) ماض ناقص واسمه مستتر (مِنَ الْقانِتِينَ) خبر كانت والجملة معطوفة على ما قبلها.\r\n\r\n"}]