[{"sura":66,"ayah":1,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلنَّبِىُّ","translation":"Prophet","transliteration":"l-nabiyu"},{"position":3,"arabic":"لِمَ","translation":"Why (do)","transliteration":"lima"},{"position":4,"arabic":"تُحَرِّمُ","translation":"you prohibit","transliteration":"tuḥarrimu"},{"position":5,"arabic":"مَآ","translation":"what","transliteration":"mā"},{"position":6,"arabic":"أَحَلَّ","translation":"has made lawful","transliteration":"aḥalla"},{"position":7,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":8,"arabic":"لَكَ ۖ","translation":"for you","transliteration":"laka"},{"position":9,"arabic":"تَبْتَغِى","translation":"seeking","transliteration":"tabtaghī"},{"position":10,"arabic":"مَرْضَاتَ","translation":"(to) please","transliteration":"marḍāta"},{"position":11,"arabic":"أَزْوَٰجِكَ ۚ","translation":"your wives","transliteration":"azwājika"},{"position":12,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":13,"arabic":"غَفُورٌۭ","translation":"(is) Oft-Forgiving","transliteration":"ghafūrun"},{"position":14,"arabic":"رَّحِيمٌۭ","translation":"Most Merciful","transliteration":"raḥīmun"}],"e3rab":"(يا أَيُّهَا) يا حرف نداء ومنادى نكرة مقصودة وها للتنبيه (النَّبِيُّ) بدل من أيّها (لِمَ) اللام حرف جر وما: اسم استفهام في محل جر باللام وهما متعلقان بالفعل بعدهما (تُحَرِّمُ) مضارع فاعله مستتر (ما) مفعول به والجملة ابتدائية لا محل لها (أَحَلَّ اللَّهُ) ماض وفاعله (لَكَ) متعلقان بالفعل والجملة صلة.\r\n\r\n(تَبْتَغِي مَرْضاتَ) مضارع ومفعوله والفاعل مستتر والجملة حالية.\r\n\r\n(أَزْواجِكَ) مضاف إليه.\r\n\r\n(وَاللَّهُ غَفُورٌ رَحِيمٌ) مبتدأ وخبراه والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":66,"ayah":2,"words":[{"position":1,"arabic":"قَدْ","translation":"Indeed","transliteration":"qad"},{"position":2,"arabic":"فَرَضَ","translation":"has ordained","transliteration":"faraḍa"},{"position":3,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":4,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":5,"arabic":"تَحِلَّةَ","translation":"(the) dissolution","transliteration":"taḥillata"},{"position":6,"arabic":"أَيْمَـٰنِكُمْ ۚ","translation":"(of) your oaths","transliteration":"aymānikum"},{"position":7,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":8,"arabic":"مَوْلَىٰكُمْ ۖ","translation":"(is) your Protector","transliteration":"mawlākum"},{"position":9,"arabic":"وَهُوَ","translation":"and He","transliteration":"wahuwa"},{"position":10,"arabic":"ٱلْعَلِيمُ","translation":"(is) the All-Knower","transliteration":"l-ʿalīmu"},{"position":11,"arabic":"ٱلْحَكِيمُ","translation":"the All-Wise","transliteration":"l-ḥakīmu"}],"e3rab":"(قَدْ فَرَضَ اللَّهُ) قد حرف تحقيق وماض وفاعله والجملة استئنافية لا محل لها (لَكُمْ) متعلقان بالفعل (تَحِلَّةَ أَيْمانِكُمْ) مفعول به مضاف وأيمانكم مضاف إليه (وَ) الواو حالية (اللَّهُ مَوْلاكُمْ) مبتدأ وخبره والجملة حال.\r\n\r\n(وَهُوَ الْعَلِيمُ الْحَكِيمُ) معطوف على ما قبله.\r\n\r\n"},{"sura":66,"ayah":3,"words":[{"position":1,"arabic":"وَإِذْ","translation":"And when","transliteration":"wa-idh"},{"position":2,"arabic":"أَسَرَّ","translation":"confided","transliteration":"asarra"},{"position":3,"arabic":"ٱلنَّبِىُّ","translation":"the Prophet","transliteration":"l-nabiyu"},{"position":4,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":5,"arabic":"بَعْضِ","translation":"one","transliteration":"baʿḍi"},{"position":6,"arabic":"أَزْوَٰجِهِۦ","translation":"(of) his wives","transliteration":"azwājihi"},{"position":7,"arabic":"حَدِيثًۭا","translation":"a statement","transliteration":"ḥadīthan"},{"position":8,"arabic":"فَلَمَّا","translation":"and when","transliteration":"falammā"},{"position":9,"arabic":"نَبَّأَتْ","translation":"she informed","transliteration":"nabba-at"},{"position":10,"arabic":"بِهِۦ","translation":"about it","transliteration":"bihi"},{"position":11,"arabic":"وَأَظْهَرَهُ","translation":"and made it apparent","transliteration":"wa-aẓharahu"},{"position":12,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":13,"arabic":"عَلَيْهِ","translation":"to him","transliteration":"ʿalayhi"},{"position":14,"arabic":"عَرَّفَ","translation":"he made known","transliteration":"ʿarrafa"},{"position":15,"arabic":"بَعْضَهُۥ","translation":"a part of it","transliteration":"baʿḍahu"},{"position":16,"arabic":"وَأَعْرَضَ","translation":"and avoided","transliteration":"wa-aʿraḍa"},{"position":17,"arabic":"عَنۢ","translation":"[of]","transliteration":"ʿan"},{"position":18,"arabic":"بَعْضٍۢ ۖ","translation":"a part","transliteration":"baʿḍin"},{"position":19,"arabic":"فَلَمَّا","translation":"Then when","transliteration":"falammā"},{"position":20,"arabic":"نَبَّأَهَا","translation":"he informed her","transliteration":"nabba-ahā"},{"position":21,"arabic":"بِهِۦ","translation":"about it","transliteration":"bihi"},{"position":22,"arabic":"قَالَتْ","translation":"she said","transliteration":"qālat"},{"position":23,"arabic":"مَنْ","translation":"Who","transliteration":"man"},{"position":24,"arabic":"أَنۢبَأَكَ","translation":"informed you","transliteration":"anba-aka"},{"position":25,"arabic":"هَـٰذَا ۖ","translation":"this","transliteration":"hādhā"},{"position":26,"arabic":"قَالَ","translation":"He said","transliteration":"qāla"},{"position":27,"arabic":"نَبَّأَنِىَ","translation":"Has informed me","transliteration":"nabba-aniya"},{"position":28,"arabic":"ٱلْعَلِيمُ","translation":"the All-Knower","transliteration":"l-ʿalīmu"},{"position":29,"arabic":"ٱلْخَبِيرُ","translation":"the All-Aware","transliteration":"l-khabīru"}],"e3rab":"(وَ) الواو حرف استئناف (إِذْ) ظرف زمان (أَسَرَّ النَّبِيُّ) ماض وفاعله والجملة في محل جر بالإضافة (إِلى بَعْضِ) متعلقان بالفعل (أَزْواجِهِ) مضاف إليه (حَدِيثاً) مفعول به (فَلَمَّا) الفاء حرف استئناف (لما) ظرفية شرطية غير جازمة (نَبَّأَتْ) ماض فاعله مستتر (بِهِ) متعلقان بالفعل والجملة في محل جر بالإضافة (وَأَظْهَرَهُ اللَّهُ) ماض ومفعوله ولفظ الجلالة فاعله (عَلَيْهِ) متعلقان بالفعل والجملة معطوفة على ما قبلها.\r\n\r\n(عَرَّفَ) ماض فاعله مستتر والجملة جواب الشرط لا محل لها (بَعْضَهُ) مفعول به (وَأَعْرَضَ) معطوف على عرف (عَنْ بَعْضٍ) متعلقان بالفعل (فَلَمَّا) الفاء حرف استئناف (لما) سبق إعرابها (نَبَّأَها) ماض ومفعوله والفاعل مستتر (بِهِ) متعلقان بالفعل والجملة في محل جر بالإضافة.\r\n\r\n(قالَتْ) ماض فاعله مستتر والجملة جواب الشرط لا محل لها.\r\n\r\n(مَنْ) اسم استفهام مبتدأ (أَنْبَأَكَ) ماض ومفعوله الأول والفاعل مستتر (هذا) مفعول به ثان والجملة الفعلية خبر من والجملة الاسمية مقول القول (قالَ) ماض فاعله مستتر والجملة استئنافية لا محل لها (نَبَّأَنِيَ الْعَلِيمُ) ماض ومفعوله والعليم فاعله (الْخَبِيرُ) صفة والجملة مقول القول.\r\n\r\n"},{"sura":66,"ayah":4,"words":[{"position":1,"arabic":"إِن","translation":"If","transliteration":"in"},{"position":2,"arabic":"تَتُوبَآ","translation":"you both turn","transliteration":"tatūbā"},{"position":3,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":4,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":5,"arabic":"فَقَدْ","translation":"so indeed","transliteration":"faqad"},{"position":6,"arabic":"صَغَتْ","translation":"(are) inclined","transliteration":"ṣaghat"},{"position":7,"arabic":"قُلُوبُكُمَا ۖ","translation":"your hearts","transliteration":"qulūbukumā"},{"position":8,"arabic":"وَإِن","translation":"but if","transliteration":"wa-in"},{"position":9,"arabic":"تَظَـٰهَرَا","translation":"you backup each other","transliteration":"taẓāharā"},{"position":10,"arabic":"عَلَيْهِ","translation":"against him","transliteration":"ʿalayhi"},{"position":11,"arabic":"فَإِنَّ","translation":"then indeed","transliteration":"fa-inna"},{"position":12,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":13,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":14,"arabic":"مَوْلَىٰهُ","translation":"(is) his Protector","transliteration":"mawlāhu"},{"position":15,"arabic":"وَجِبْرِيلُ","translation":"and Jibreel","transliteration":"wajib'rīlu"},{"position":16,"arabic":"وَصَـٰلِحُ","translation":"and (the) righteous","transliteration":"waṣāliḥu"},{"position":17,"arabic":"ٱلْمُؤْمِنِينَ ۖ","translation":"believers","transliteration":"l-mu'minīna"},{"position":18,"arabic":"وَٱلْمَلَـٰٓئِكَةُ","translation":"and the Angels","transliteration":"wal-malāikatu"},{"position":19,"arabic":"بَعْدَ","translation":"after","transliteration":"baʿda"},{"position":20,"arabic":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":21,"arabic":"ظَهِيرٌ","translation":"(are his) assistants","transliteration":"ẓahīrun"}],"e3rab":"(إِنْ تَتُوبا) حرف شرط جازم ومضارع مجزوم لأنه فعل الشرط وعلامة جزمه حذف النون والألف فاعل (إِلَى اللَّهِ) متعلقان بالفعل والجملة ابتدائية لا محل لها (فَقَدْ) الفاء حرف تعليل (قد صَغَتْ) حرف تحقيق وماض (قُلُوبُكُما) فاعله وجواب الشرط محذوف وجملة صغت تعليل لا محل لها ومعنى صغت: مالت (وَإِنْ) الواو حرف عطف (إِنْ تَظاهَرا) معطوف على إن تتوبا وجواب الشرط محذوف تقديره يجد ناصرا (عَلَيْهِ) متعلقان بالفعل، (فَإِنَّ) الفاء حرف تعليل (إن اللَّهِ) إن واسمها (هُوَ) ضمير فصل (مَوْلاهُ) خبر إن والجملة الاسمية تعليلية لا محل لها، (وَجِبْرِيلُ) مبتدأ (وَصالِحُ) معطوف على جبريل (الْمُؤْمِنِينَ) مضاف إليه (وَالْمَلائِكَةُ) مبتدأ (بَعْدَ ذلِكَ) ظرف زمان مضاف إلى اسم الإشارة (ظَهِيرٌ) خبر لما سبق.\r\n\r\n"},{"sura":66,"ayah":5,"words":[{"position":1,"arabic":"عَسَىٰ","translation":"Perhaps","transliteration":"ʿasā"},{"position":2,"arabic":"رَبُّهُۥٓ","translation":"his Lord","transliteration":"rabbuhu"},{"position":3,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":4,"arabic":"طَلَّقَكُنَّ","translation":"he divorced you","transliteration":"ṭallaqakunna"},{"position":5,"arabic":"أَن","translation":"[that]","transliteration":"an"},{"position":6,"arabic":"يُبْدِلَهُۥٓ","translation":"He will substitute for him","transliteration":"yub'dilahu"},{"position":7,"arabic":"أَزْوَٰجًا","translation":"wives","transliteration":"azwājan"},{"position":8,"arabic":"خَيْرًۭا","translation":"better","transliteration":"khayran"},{"position":9,"arabic":"مِّنكُنَّ","translation":"than you","transliteration":"minkunna"},{"position":10,"arabic":"مُسْلِمَـٰتٍۢ","translation":"submissive","transliteration":"mus'limātin"},{"position":11,"arabic":"مُّؤْمِنَـٰتٍۢ","translation":"faithful","transliteration":"mu'minātin"},{"position":12,"arabic":"قَـٰنِتَـٰتٍۢ","translation":"obedient","transliteration":"qānitātin"},{"position":13,"arabic":"تَـٰٓئِبَـٰتٍ","translation":"repentant","transliteration":"tāibātin"},{"position":14,"arabic":"عَـٰبِدَٰتٍۢ","translation":"who worship","transliteration":"ʿābidātin"},{"position":15,"arabic":"سَـٰٓئِحَـٰتٍۢ","translation":"who fast","transliteration":"sāiḥātin"},{"position":16,"arabic":"ثَيِّبَـٰتٍۢ","translation":"previously married","transliteration":"thayyibātin"},{"position":17,"arabic":"وَأَبْكَارًۭا","translation":"and virgins","transliteration":"wa-abkāran"}],"e3rab":"(عَسى) ماض جامد من أفعال الرجاء (رَبُّهُ) اسمه (إِنْ طَلَّقَكُنَّ) إن شرطية جازمة وماض ومفعوله والفاعل مستتر والجملة ابتدائية لا محل لها وجواب الشرط محذوف (أَنْ يُبْدِلَهُ) مضارع منصوب بأن والهاء مفعول به أول والمصدر المؤول من أن وما بعدها خبر عسى (أَزْواجاً) مفعول به ثان (خَيْراً) صفة أزواجا (مِنْكُنَّ) متعلقان بخيرا (مُسْلِماتٍ مُؤْمِناتٍ قانِتاتٍ تائِباتٍ عابِداتٍ سائِحاتٍ ثَيِّباتٍ) صفات متعددة لأزواجا (وَأَبْكاراً) معطوف على ما قبله.\r\n\r\n"},{"sura":66,"ayah":6,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"(you) who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"قُوٓا۟","translation":"Protect","transliteration":"qū"},{"position":5,"arabic":"أَنفُسَكُمْ","translation":"yourselves","transliteration":"anfusakum"},{"position":6,"arabic":"وَأَهْلِيكُمْ","translation":"and your families","transliteration":"wa-ahlīkum"},{"position":7,"arabic":"نَارًۭا","translation":"(from) a Fire","transliteration":"nāran"},{"position":8,"arabic":"وَقُودُهَا","translation":"whose fuel","transliteration":"waqūduhā"},{"position":9,"arabic":"ٱلنَّاسُ","translation":"(is) people","transliteration":"l-nāsu"},{"position":10,"arabic":"وَٱلْحِجَارَةُ","translation":"and stones","transliteration":"wal-ḥijāratu"},{"position":11,"arabic":"عَلَيْهَا","translation":"over it","transliteration":"ʿalayhā"},{"position":12,"arabic":"مَلَـٰٓئِكَةٌ","translation":"(are) Angels","transliteration":"malāikatun"},{"position":13,"arabic":"غِلَاظٌۭ","translation":"stern","transliteration":"ghilāẓun"},{"position":14,"arabic":"شِدَادٌۭ","translation":"severe","transliteration":"shidādun"},{"position":15,"arabic":"لَّا","translation":"not","transliteration":"lā"},{"position":16,"arabic":"يَعْصُونَ","translation":"they disobey","transliteration":"yaʿṣūna"},{"position":17,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":18,"arabic":"مَآ","translation":"(in) what","transliteration":"mā"},{"position":19,"arabic":"أَمَرَهُمْ","translation":"He Commands them","transliteration":"amarahum"},{"position":20,"arabic":"وَيَفْعَلُونَ","translation":"but they do","transliteration":"wayafʿalūna"},{"position":21,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":22,"arabic":"يُؤْمَرُونَ","translation":"they are commanded","transliteration":"yu'marūna"}],"e3rab":"(يا أَيُّهَا الَّذِينَ) سبق إعرابها (آمَنُوا) ماض وفاعله والجملة صلة وجملة النداء ابتدائية لا محل لها (قُوا) أمر مبني على حذف النون والواو فاعله (أَنْفُسَكُمْ) مفعول به (وَأَهْلِيكُمْ) معطوف على أنفسكم (ناراً) مفعول به ثان (وَقُودُهَا النَّاسُ) مبتدأ وخبره والجملة صفة نارا (وَالْحِجارَةُ) معطوف على الناس (عَلَيْها) خبر مقدم (مَلائِكَةٌ) مبتدأ مؤخر والجملة صفة ثانية لنارا (غِلاظٌ شِدادٌ) صفتان لملائكة (لا) نافية (يَعْصُونَ اللَّهَ) مضارع مرفوع والواو فاعله ولفظ الجلالة مفعوله (ما) بدل من لفظ الجلالة والجملة صفة ثالثة (أَمَرَهُمْ) ماض ومفعوله والفاعل مستتر والجملة صلة.\r\n\r\n(وَيَفْعَلُونَ) مضارع وفاعله والجملة معطوفة على ما قبلها (ما) مفعول به (يُؤْمَرُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة صلة ما.\r\n\r\n"},{"sura":66,"ayah":7,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"(you) who","transliteration":"alladhīna"},{"position":3,"arabic":"كَفَرُوا۟","translation":"disbelieve","transliteration":"kafarū"},{"position":4,"arabic":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"arabic":"تَعْتَذِرُوا۟","translation":"make excuses","transliteration":"taʿtadhirū"},{"position":6,"arabic":"ٱلْيَوْمَ ۖ","translation":"today","transliteration":"l-yawma"},{"position":7,"arabic":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"position":8,"arabic":"تُجْزَوْنَ","translation":"you will be recompensed","transliteration":"tuj'zawna"},{"position":9,"arabic":"مَا","translation":"(for) what","transliteration":"mā"},{"position":10,"arabic":"كُنتُمْ","translation":"you used to","transliteration":"kuntum"},{"position":11,"arabic":"تَعْمَلُونَ","translation":"do","transliteration":"taʿmalūna"}],"e3rab":"(يا أَيُّهَا الَّذِينَ) سبق إعرابها (كَفَرُوا) ماض وفاعله والجملة صلة الذين (لا تَعْتَذِرُوا) مضارع مجزوم بلا الناهية والواو فاعله والجملة مقول قول محذوف.\r\n\r\n(الْيَوْمَ) ظرف زمان (إِنَّما) كافة ومكفوفة (تُجْزَوْنَ) مضارع مبني للمجهول والواو نائب فاعل (ما) مفعول به ثان (كُنْتُمْ) كان واسمها والجملة صلة (تَعْمَلُونَ) مضارع مرفوع والواو فاعله والجملة خبر كنتم.\r\n\r\n"},{"sura":66,"ayah":8,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"(you) who believe","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوا۟","translation":"believe","transliteration":"āman