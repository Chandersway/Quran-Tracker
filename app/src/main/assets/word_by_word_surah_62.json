[{"sura":62,"ayah":1,"words":[{"position":1,"arabic":"يُسَبِّحُ","translation":"Glorifies","transliteration":"yusabbiḥu"},{"position":2,"arabic":"لِلَّهِ","translation":"Allah","transliteration":"lillahi"},{"position":3,"arabic":"مَا","translation":"whatever","transliteration":"mā"},{"position":4,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":5,"arabic":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":6,"arabic":"وَمَا","translation":"and whatever","transliteration":"wamā"},{"position":7,"arabic":"فِى","translation":"(is) in","transliteration":"fī"},{"position":8,"arabic":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":9,"arabic":"ٱلْمَلِكِ","translation":"the Sovereign","transliteration":"l-maliki"},{"position":10,"arabic":"ٱلْقُدُّوسِ","translation":"the Holy","transliteration":"l-qudūsi"},{"position":11,"arabic":"ٱلْعَزِيزِ","translation":"the All-Mighty","transliteration":"l-ʿazīzi"},{"position":12,"arabic":"ٱلْحَكِيمِ","translation":"the All-Wise","transliteration":"l-ḥakīmi"}],"e3rab":"(يُسَبِّحُ) مضارع (لِلَّهِ) متعلقان بالفعل (ما) فاعل والجملة ابتدائية لا محل لها من الإعراب (فِي السَّماواتِ) متعلقان بمحذوف صلة الموصول (وَما فِي الْأَرْضِ) معطوف على ما في السموات (الْمَلِكِ الْقُدُّوسِ الْعَزِيزِ الْحَكِيمِ) بدل من لفظ الجلالة.\r\n\r\n"},{"sura":62,"ayah":2,"words":[{"position":1,"arabic":"هُوَ","translation":"He","transliteration":"huwa"},{"position":2,"arabic":"ٱلَّذِى","translation":"(is) the One Who","transliteration":"alladhī"},{"position":3,"arabic":"بَعَثَ","translation":"sent","transliteration":"baʿatha"},{"position":4,"arabic":"فِى","translation":"among","transliteration":"fī"},{"position":5,"arabic":"ٱلْأُمِّيِّـۧنَ","translation":"the unlettered","transliteration":"l-umiyīna"},{"position":6,"arabic":"رَسُولًۭا","translation":"a Messenger","transliteration":"rasūlan"},{"position":7,"arabic":"مِّنْهُمْ","translation":"from themselves","transliteration":"min'hum"},{"position":8,"arabic":"يَتْلُوا۟","translation":"reciting","transliteration":"yatlū"},{"position":9,"arabic":"عَلَيْهِمْ","translation":"to them","transliteration":"ʿalayhim"},{"position":10,"arabic":"ءَايَـٰتِهِۦ","translation":"His Verses","transliteration":"āyātihi"},{"position":11,"arabic":"وَيُزَكِّيهِمْ","translation":"and purifying them","transliteration":"wayuzakkīhim"},{"position":12,"arabic":"وَيُعَلِّمُهُمُ","translation":"and teaching them","transliteration":"wayuʿallimuhumu"},{"position":13,"arabic":"ٱلْكِتَـٰبَ","translation":"the Book","transliteration":"l-kitāba"},{"position":14,"arabic":"وَٱلْحِكْمَةَ","translation":"and the wisdom","transliteration":"wal-ḥik'mata"},{"position":15,"arabic":"وَإِن","translation":"although","transliteration":"wa-in"},{"position":16,"arabic":"كَانُوا۟","translation":"they were","transliteration":"kānū"},{"position":17,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":18,"arabic":"قَبْلُ","translation":"before","transliteration":"qablu"},{"position":19,"arabic":"لَفِى","translation":"surely in","transliteration":"lafī"},{"position":20,"arabic":"ضَلَـٰلٍۢ","translation":"an error","transliteration":"ḍalālin"},{"position":21,"arabic":"مُّبِينٍۢ","translation":"clear","transliteration":"mubīnin"}],"e3rab":"(هُوَ الَّذِي) مبتدأ وخبره والجملة استئنافية لا محل لها (بَعَثَ) ماض وفاعله مستتر (فِي الْأُمِّيِّينَ) متعلقان بالفعل (رَسُولًا) مفعول به والجملة صلة (مِنْهُمْ) صفة رسولا (يَتْلُوا) مضارع فاعله مستتر والجملة صفة (عَلَيْهِمْ) متعلقان بالفعل (آياتِهِ) مفعول به (وَيُزَكِّيهِمْ) معطوف على يتلو (وَيُعَلِّمُهُمُ) مضارع ومفعوله الأول والفاعل مستتر (الْكِتابَ) مفعوله الثاني (وَالْحِكْمَةَ) معطوف على الكتاب (وَ) الواو حالية (إِنْ كانُوا) إن مخففة وماض ناقص واسمه (مِنْ قَبْلُ) متعلقان بمحذوف حال واللام فارقة (في ضَلالٍ) خبر كانوا (مُبِينٍ) صفة والجملة حال.\r\n\r\n"},{"sura":62,"ayah":3,"words":[{"position":1,"arabic":"وَءَاخَرِينَ","translation":"And others","transliteration":"waākharīna"},{"position":2,"arabic":"مِنْهُمْ","translation":"among them","transliteration":"min'hum"},{"position":3,"arabic":"لَمَّا","translation":"who have not yet","transliteration":"lammā"},{"position":4,"arabic":"يَلْحَقُوا۟","translation":"joined","transliteration":"yalḥaqū"},{"position":5,"arabic":"بِهِمْ ۚ","translation":"them","transliteration":"bihim"},{"position":6,"arabic":"وَهُوَ","translation":"and He","transliteration":"wahuwa"},{"position":7,"arabic":"ٱلْعَزِيزُ","translation":"(is) the All-Mighty","transliteration":"l-ʿazīzu"},{"position":8,"arabic":"ٱلْحَكِيمُ","translation":"the All-Wise","transliteration":"l-ḥakīmu"}],"e3rab":"(وَآخَرِينَ) معطوف على الأميين (مِنْهُمْ) متعلقان بمحذوف صفة آخرين (لَمَّا يَلْحَقُوا) مضارع مجزوم بلمّا والواو فاعله والجملة صفة ثانية لآخرين (بِهِمْ) متعلقان بالفعل (وَهُوَ الْعَزِيزُ الْحَكِيمُ) مبتدأ وخبران والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":62,"ayah":4,"words":[{"position":1,"arabic":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":2,"arabic":"فَضْلُ","translation":"(is the) Bounty","transliteration":"faḍlu"},{"position":3,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":4,"arabic":"يُؤْتِيهِ","translation":"He gives it","transliteration":"yu'tīhi"},{"position":5,"arabic":"مَن","translation":"(to) whom","transliteration":"man"},{"position":6,"arabic":"يَشَآءُ ۚ","translation":"He wills","transliteration":"yashāu"},{"position":7,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":8,"arabic":"ذُو","translation":"(is the) Possessor","transliteration":"dhū"},{"position":9,"arabic":"ٱلْفَضْلِ","translation":"(of) Bounty","transliteration":"l-faḍli"},{"position":10,"arabic":"ٱلْعَظِيمِ","translation":"the Great","transliteration":"l-ʿaẓīmi"}],"e3rab":"(ذلِكَ فَضْلُ) مبتدأ وخبره والجملة استئنافية لا محل لها (اللَّهِ) لفظ الجلالة مضاف إليه (يُؤْتِيهِ) مضارع ومفعوله الأول والفاعل مستتر (مَنْ) مفعول به ثان والجملة حال (يَشاءُ) مضارع فاعله مستتر والجملة صلة (وَاللَّهُ ذُو) مبتدأ وخبره (الْفَضْلِ) مضاف إليه (الْعَظِيمِ) صفة والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":62,"ayah":5,"words":[{"position":1,"arabic":"مَثَلُ","translation":"(The) likeness","transliteration":"mathalu"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"(of) those who","transliteration":"alladhīna"},{"position":3,"arabic":"حُمِّلُوا۟","translation":"were entrusted","transliteration":"ḥummilū"},{"position":4,"arabic":"ٱلتَّوْرَىٰةَ","translation":"(with) the Taurat","transliteration":"l-tawrāta"},{"position":5,"arabic":"ثُمَّ","translation":"then","transliteration":"thumma"},{"position":6,"arabic":"لَمْ","translation":"not","transliteration":"lam"},{"position":7,"arabic":"يَحْمِلُوهَا","translation":"they bore it","transliteration":"yaḥmilūhā"},{"position":8,"arabic":"كَمَثَلِ","translation":"(is) like","transliteration":"kamathali"},{"position":9,"arabic":"ٱلْحِمَارِ","translation":"the donkey","transliteration":"l-ḥimāri"},{"position":10,"arabic":"يَحْمِلُ","translation":"who carries","transliteration":"yaḥmilu"},{"position":11,"arabic":"أَسْفَارًۢا ۚ","translation":"books","transliteration":"asfāran"},{"position":12,"arabic":"بِئْسَ","translation":"Wretched is","transliteration":"bi'sa"},{"position":13,"arabic":"مَثَلُ","translation":"(the) example","transliteration":"mathalu"},{"position":14,"arabic":"ٱلْقَوْمِ","translation":"(of) the people","transliteration":"l-qawmi"},{"position":15,"arabic":"ٱلَّذِينَ","translation":"who","transliteration":"alladhīna"},{"position":16,"arabic":"كَذَّبُوا۟","translation":"deny","transliteration":"kadhabū"},{"position":17,"arabic":"بِـَٔايَـٰتِ","translation":"(the) Signs","transliteration":"biāyāti"},{"position":18,"arabic":"ٱللَّهِ ۚ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":19,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":20,"arabic":"لَا","translation":"(does) not","transliteration":"lā"},{"position":21,"arabic":"يَهْدِى","translation":"guide","transliteration":"yahdī"},{"position":22,"arabic":"ٱلْقَوْمَ","translation":"the people","transliteration":"l-qawma"},{"position":23,"arabic":"ٱلظَّـٰلِمِينَ","translation":"the wrongdoers","transliteration":"l-ẓālimīna"}],"e3rab":"(مَثَلُ الَّذِينَ) مبتدأ مضاف إلى اسم الموصول (حُمِّلُوا) ماض مبني للمجهول والواو نائب فاعل (التَّوْراةَ) مفعول به ثان والجملة صلة (ثُمَّ) حرف عطف (لَمْ يَحْمِلُوها) مضارع مجزوم بلم والواو فاعله والهاء مفعوله والجملة معطوفة على ما قبلها (كَمَثَلِ) خبر المبتدأ (الْحِمارِ) مضاف إليه وجملة مثل.. استئنافية لا محل لها.\r\n\r\n(يَحْمِلُ) مضارع فاعله مستتر (أَسْفاراً) مفعول به والجملة حال (بِئْسَ) ماض جامد (مَثَلُ الْقَوْمِ) فاعل مضاف إلى القوم (الَّذِينَ) صفة القوم (كَذَّبُوا) ماض وفاعله والجملة صلة (بِآياتِ اللَّهِ) متعلقان بالفعل ولفظ الجلالة مضاف إليه (وَاللَّهُ) لفظ الجلالة مبتدأ (لا) نافية (يَهْدِي) مضارع فاعله مستتر والجملة خبر المبتدأ (الْقَوْمِ) مفعول به (الظَّالِمِينَ) صفة القوم والجملة الاسمية استئنافية لا محل لها.\r\n\r\n"},{"sura":62,"ayah":6,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":3,"arabic":"ٱلَّذِينَ","translation":"you (who)","transliteration":"alladhīna"},{"position":4,"arabic":"هَادُوٓا۟","translation":"(are) Jews","transliteration":"hādū"},{"position":5,"arabic":"إِن","translation":"If","transliteration":"in"},{"position":6,"arabic":"زَعَمْتُمْ","translation":"you claim","transliteration":"zaʿamtum"},{"position":7,"arabic":"أَنَّكُمْ","translation":"that you","transliteration":"annakum"},{"position":8,"arabic":"أَوْلِيَآءُ","translation":"(are) allies","transliteration":"awliyāu"},{"position":9,"arabic":"لِلَّهِ","translation":"of Allah","transliteration":"lillahi"},{"position":10,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":11,"arabic":"دُونِ","translation":"excluding","transliteration":"dūni"},{"position":12,"arabic":"ٱلنَّاسِ","translation":"the people","transliteration":"l-nāsi"},{"position":13,"arabic":"فَتَمَنَّوُا۟","translation":"then wish","transliteration":"fatamannawū"},{"position":14,"arabic":"ٱلْمَوْتَ","translation":"(for) the death","transliteration":"l-mawta"},{"position":15,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":16,"arabic":"كُنتُمْ","translation":"you are","transliteration":"kuntum"},{"position":17,"arabic":"صَـٰدِقِينَ","translation":"truthful","transliteration":"ṣādiqīna"}],"e3rab":"(قُلْ) أمر فاعله مستتر (يا أَيُّهَا) منادى نكرة مقصودة وها للتنبيه (الَّذِينَ) اسم الموصول بدل من أيّها والجملة استئنافية لا محل لها وجملة النداء مقول القول (هادُوا) ماض وفاعله والجملة صلة (إِنْ) شرطية جازمة (زَعَمْتُمْ) ماض وفاعله والجملة ابتدائية لا محل لها (أَنَّكُمْ أَوْلِياءُ) أن واسمها وخبرها والمصدر المؤول من أن وما بعدها سد مسد مفعولي زعمتم (لِلَّهِ) متعلقان بأولياء (مِنْ دُونِ) متعلقان بأولياء أيضا (النَّاسِ) مضاف إليه (فَتَمَنَّوُا) الفاء رابطة وأمر وفاعله (الْمَوْتَ) مفعول به والجملة في محل جزم جواب الشرط (إِنْ) شرطية جازمة (كُنْتُمْ صادِقِينَ) كان واسمها وخبرها والجملة ابتدائية لا محل لها. وجواب الشرط محذوف.\r\n\r\n"},{"sura":62,"ayah":7,"words":[{"position":1,"arabic":"وَلَا","translation":"But not","transliteration":"walā"},{"position":2,"arabic":"يَتَمَنَّوْنَهُۥٓ","translation":"they will wish for it","transliteration":"yatamannawnahu"},{"position":3,"arabic":"أَبَدًۢا","translation":"ever","transliteration":"abadan"},{"position":4,"arabic":"بِمَا","translation":"for what","transliteration":"bimā"},{"position":5,"arabic":"قَدَّمَتْ","translation":"(have) sent forth","transliteration":"qaddamat"},{"position":6,"arabic":"أَيْدِيهِمْ ۚ","translation":"their hands","transliteration":"aydīhim"},{"position":7,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":8,"arabic":"عَلِيمٌۢ","translation":"(is) All-Knowing","transliteration":"ʿalīmun"},{"position":9,"arabic":"بِٱلظَّـٰلِمِينَ","translation":"of the wrongdoers","transliteration":"bil-ẓālimīna"}],"e3rab":"(وَ) الواو حرف استئناف (لا يَتَمَنَّوْنَهُ) لا نافية ومضارع وفاعله ومفعوله والجملة استئنافية لا محل لها (أَبَداً) ظرف زمان (بِما) متعلقان بالفعل (قَدَّمَتْ) ماض (أَيْدِيهِمْ) فاعله والجملة صلة (وَاللَّهُ عَلِيمٌ) مبتدأ وخبره (بِالظَّالِمِينَ) متعلقان بعليم والجملة استئنافية لا محل لها.\r\n\r\n"},{"sura":62,"ayah":8,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":3,"arabic":"ٱلْمَوْتَ","translation":"the death","transliteration":"l-mawta"},{"position":4,"arabic":"ٱلَّذِى","translation":"which","transliteration":"alladhī"},{"position":5,"arabic":"تَفِرُّونَ","translation":"you flee","transliteration":"tafirrūna"},{"position":6,"arabic":"مِنْهُ","translation":"from it","transliteration":"min'hu"},{"position":7,"arabic":"فَإِنَّهُۥ","translation":"then surely it","transliteration":"fa-innahu"},{"position":8,"arabic":"مُلَـٰقِيكُمْ ۖ","translation":"(will) meet you","transliteration":"mulāqīkum"},{"position":9,"arabic":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":10,"arabic":"تُرَدُّونَ","translation":"you will be sent back","transliteration":"turaddūna"},{"position":11,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":12,"arabic":"عَـٰلِمِ","translation":"(the) All-Knower","transliteration":"ʿālimi"},{"position":13,"arabic":"ٱلْغَيْبِ","translation":"(of) the unseen","transliteration":"l-ghaybi"},{"position":14,"arabic":"وَٱلشَّهَـٰدَةِ","translation":"and the witnessed","transliteration":"wal-shahādati"},{"position":15,"arabic":"فَيُنَبِّئُكُم","translation":"and He will inform you","transliteration":"fayunabbi-ukum"},{"position":16,"arabic":"بِمَا","translation":"[of] what","transliteration":"bimā"},{"position":17,"arabic":"كُنتُمْ","translation":"you used to","transliteration":"kuntum"},{"position":18,"arabic":"تَعْمَلُونَ","translation":"do","transliteration":"taʿmalūna"}],"e3rab":"(قُلْ) أمر فاعله مستتر (إِنَّ الْمَوْتَ) إن واسمها (الَّذِي) صفة الموت (تَفِرُّونَ) مضارع وفاعله (مِنْهُ) متعلقان بالفعل والجملة صلة الذي (فَإِنَّهُ) الفاء زائدة وإن واسمها (مُلاقِيكُمْ) خبرها والجملة الاسمية خبر إن وجملة إن الموت.. مقول القول (ثُمَّ) حرف عطف (تُرَدُّونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة معطوفة على ما قبلها (إِلى عالِمِ) متعلقان بالفعل (الْغَيْبِ) مضاف إليه (وَالشَّهادَةِ) معطوف على الغيب.\r\n\r\n(فَيُنَبِّئُكُمْ) معطوف على تردون (بِما) متعلقان بالفعل (كُنْتُمْ) كان واسمها (تَعْمَلُونَ) مضارع مرفوع والواو فاعله والجملة خبر كنتم وجملة كنتم.. صلة ما.\r\n\r\n"},{"sura":62,"ayah":9,"words":[{"position":1,"arabic":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"arabic":"ٱلَّذِينَ","translation":"(you) who","transliteration":"alladhīna"},{"position":3,"arabic":"ءَامَنُوٓا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"arabic":"إِذَا","translation":"When","transliteration":"idhā"},{"position":5,"arabic":"نُودِىَ","translation":"(the) call is made","transliteration":"nūdiya"},{"position":6,"arabic":"لِلصَّلَوٰةِ","translation":"for (the) prayer","transliteration":"lilṣṣalati"},{"position":7,"arabic":"مِن","translation":"on","transliteration":"min"},{"position":8,"arabic":"يَوْمِ","translation":"(the) day","transliteration":"yawmi"},{"position":9,"arabic":"ٱلْجُمُعَةِ","translation":"(of) Friday","transliteration":"l-jumuʿati"},{"position":10,"arabic":"فَٱسْعَوْا۟","translation":"then hasten","transliteration":"fa-is'ʿaw"},{"position":11,"arabic":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":12,"arabic":"ذِكْرِ","translation":"(the) remembrance","transliteration":"dhik'ri"},{"position":13,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":14,"arabic":"وَذَرُوا۟","translation":"and leave","transliteration":"wadharū"},{"position":15,"arabic":"ٱلْبَيْعَ ۚ","translation":"the business","transliteration":"l-bayʿa"},{"position":16,"arabic":"ذَٰلِكُمْ","translation":"That","transliteration":"dhālikum"},{"position":17,"arabic":"خَيْرٌۭ","translation":"(is) better","transliteration":"khayrun"},{"position":18,"arabic":"لَّكُمْ","translation":"for you","transliteration":"lakum"},{"position":19,"arabic":"إِن","translation":"if","transliteration":"in"},{"position":20,"arabic":"كُنتُمْ","translation":"you","transliteration":"kuntum"},{"position":21,"arabic":"تَعْلَمُونَ","translation":"know","transliteration":"taʿlamūna"}],"e3rab":"(يا أَيُّهَا الَّذِينَ آمَنُوا) سبق إعرابها.\r\n\r\n(إِذا) ظرفية شرطية غير جازمة (نُودِيَ) ماض مبني للمجهول (لِلصَّلاةِ) متعلقان بالفعل والجملة في محل جر بالإضافة (مِنْ يَوْمِ) متعلقان بالفعل أيضا (الْجُمُعَةِ) مضاف إليه، (فَاسْعَوْا) الفاء رابطة وأمر وفاعله والجملة جواب إذا لا محل لها (إِلى ذِكْرِ) متعلقان بالفعل ولفظ الجلالة مضاف إليه (وَذَرُوا) معطوف على فاسعوا (الْبَيْعَ) مفعول به.\r\n\r\n(ذلِكُمْ خَيْرٌ) مبتدأ وخبره والجملة استئنافية لا محل لها (لَكُمْ) متعلقان بخير (إِنْ) شرطية جازمة (كُنْتُمْ) كان واسمها (تَعْلَمُونَ) مضارع مرفوع والواو فاعله والجملة الفعلية خبر كنتم وجملة كنتم.. ابتدائية لا محل لها.\r\n\r\nوجواب الشرط محذوف.\r\n\r\n"},{"sura":62,"ayah":10,"words":[{"position":1,"arabic":"فَإِذَا","translation":"Then when","transliteration":"fa-idhā"},{"position":2,"arabic":"قُضِيَتِ","translation":"is concluded","transliteration":"quḍiyati"},{"position":3,"arabic":"ٱلصَّلَوٰةُ","translation":"the prayer","transliteration":"l-ṣalatu"},{"position":4,"arabic":"فَٱنتَشِرُوا۟","translation":"then disperse","transliteration":"fa-intashirū"},{"position":5,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":6,"arabic":"ٱلْأَرْضِ","translation":"the land","transliteration":"l-arḍi"},{"position":7,"arabic":"وَٱبْتَغُوا۟","translation":"and seek","transliteration":"wa-ib'taghū"},{"position":8,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":9,"arabic":"فَضْلِ","translation":"(the) Bounty","transliteration":"faḍli"},{"position":10,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":11,"arabic":"وَٱذْكُرُوا۟","translation":"and remember","transliteration":"wa-udh'kurū"},{"position":12,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":13,"arabic":"كَثِيرًۭا","translation":"much","transliteration":"kathīran"},{"position":14,"arabic":"لَّعَلَّكُمْ","translation":"so that you may","transliteration":"laʿallakum"},{"position":15,"arabic":"تُفْلِحُونَ","translation":"succeed","transliteration":"tuf'liḥūna"}],"e3rab":"(فَإِذا) الفاء حرف استئناف (إذا قُضِيَتِ) إذا ظرفية شرطية غير جازمة وماض مبني للمجهول (الصَّلاةُ) نائب فاعل والجملة في محل جر بالإضافة، (فَانْتَشِرُوا) الفاء رابطة وأمر وفاعله (فِي الْأَرْضِ) متعلقان بالفعل والجملة جواب الشرط لا محل لها.\r\n\r\n(وَابْتَغُوا) معطوف على فانتشروا (مِنْ فَضْلِ اللَّهِ) متعلقان بالفعل ولفظ الجلالة مضاف إليه (وَاذْكُرُوا اللَّهَ) معطوف على فانتشروا ولفظ الجلالة مفعول به (كَثِيراً) نائب مفعول مطلق (لَعَلَّكُمْ تُفْلِحُونَ) لعل واسمها ومضارع مرفوع والواو فاعله والجملة الفعلية خبر لعل والجملة الاسمية تعليل لا محل لها.\r\n\r\n"},{"sura":62,"ayah":11,"words":[{"position":1,"arabic":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"arabic":"رَأَوْا۟","translation":"they saw","transliteration":"ra-aw"},{"position":3,"arabic":"تِجَـٰرَةً","translation":"a transaction","transliteration":"tijāratan"},{"position":4,"arabic":"أَوْ","translation":"or","transliteration":"aw"},{"position":5,"arabic":"لَهْوًا","translation":"a sport","transliteration":"lahwan"},{"position":6,"arabic":"ٱنفَضُّوٓا۟","translation":"they rushed","transliteration":"infaḍḍū"},{"position":7,"arabic":"إِلَيْهَا","translation":"to it","transliteration":"ilayhā"},{"position":8,"arabic":"وَتَرَكُوكَ","translation":"and left you","transliteration":"watarakūka"},{"position":9,"arabic":"قَآئِمًۭا ۚ","translation":"standing","transliteration":"qāiman"},{"position":10,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":11,"arabic":"مَا","translation":"What","transliteration":"mā"},{"position":12,"arabic":"عِندَ","translation":"(is) with","transliteration":"ʿinda"},{"position":13,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":14,"arabic":"خَيْرٌۭ","translation":"(is) better","transliteration":"khayrun"},{"position":15,"arabic":"مِّنَ","translation":"than","transliteration":"mina"},{"position":16,"arabic":"ٱللَّهْوِ","translation":"the sport","transliteration":"l-lahwi"},{"position":17,"arabic":"وَمِنَ","translation":"and from","transliteration":"wamina"},{"position":18,"arabic":"ٱلتِّجَـٰرَةِ ۚ","translation":"(any) transaction","transliteration":"l-tijārati"},{"position":19,"arabic":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":20,"arabic":"خَيْرُ","translation":"(is the) Best","transliteration":"khayru"},{"position":21,"arabic":"ٱلرَّٰزِقِينَ","translation":"(of) the Providers","transliteration":"l-rāziqīna"}],"e3rab":"(وَإِذا رَأَوْا) الواو حرف عطف وإذا ظرفية شرطية غير جازمة وماض وفاعله (تِجارَةً) مفعول به والجملة في محل جر بالإضافة (أَوْ) حرف عطف (لَهْواً) معطوف على تجارة (انْفَضُّوا) ماض وفاعله (إِلَيْها) متعلقان بالفعل والجملة جواب الشرط لا محل لها.\r\n\r\n(وَتَرَكُوكَ قائِماً) ماض وفاعله ومفعولاه والجملة معطوفة على ما قبلها (قُلْ) أمر فاعله مستتر (ما) مبتدأ (عِنْدَ اللَّهِ) ظرف مكان مضاف إلى لفظ الجلالة (خَيْرٌ) خبر (مِنَ اللَّهْوِ) متعلقان بالخبر (وَمِنَ التِّجارَةِ) معطوف على من اللهو والجملة الاسمية مقول القول وجملة قل..\r\n\r\nاستئنافية لا محل لها.\r\n\r\n(وَاللَّهُ خَيْرُ) الواو حالية ومبتدأ وخبره (الرَّازِقِينَ) مضاف إليه والجملة حال.\r\n\r\n"}]