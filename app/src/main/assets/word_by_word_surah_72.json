[{"sura":72,"ayah":1,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"أُوحِىَ","translation":"It has been revealed","transliteration":"ūḥiya"},{"position":3,"arabic":"إِلَىَّ","translation":"to me","transliteration":"ilayya"},{"position":4,"arabic":"أَنَّهُ","translation":"that","transliteration":"annahu"},{"position":5,"arabic":"ٱسْتَمَعَ","translation":"listened","transliteration":"is'tamaʿa"},{"position":6,"arabic":"نَفَرٌۭ","translation":"a group","transliteration":"nafarun"},{"position":7,"arabic":"مِّنَ","translation":"of","transliteration":"mina"},{"position":8,"arabic":"ٱلْجِنِّ","translation":"the jinn","transliteration":"l-jini"},{"position":9,"arabic":"فَقَالُوٓا۟","translation":"and they said","transliteration":"faqālū"},{"position":10,"arabic":"إِنَّا","translation":"Indeed, we","transliteration":"innā"},{"position":11,"arabic":"سَمِعْنَا","translation":"heard","transliteration":"samiʿ'nā"},{"position":12,"arabic":"قُرْءَانًا","translation":"a Quran","transliteration":"qur'ānan"},{"position":13,"arabic":"عَجَبًۭا","translation":"amazing","transliteration":"ʿajaban"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة ابتدائية لا محل لها (أُوحِيَ) ماض مبني للمجهول (إِلَيَّ) متعلقان بالفعل (أَنَّهُ اسْتَمَعَ) أن واسمها وماض (نَفَرٌ) فاعله (مِنَ الْجِنِّ) صفة نفر والجملة الفعلية خبر أن والمصدر المؤول من أن واسمها وخبرها نائب فاعل أوحي وجملة أوحي.. مقول القول (فَقالُوا) الفاء حرف عطف وماض وفاعله والجملة معطوفة على جملة استمع (إِنَّا) إن واسمها (سَمِعْنا قُرْآناً) ماض وفاعله ومفعوله (عَجَباً) صفة والجملة الفعلية خبر إن والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":72,"ayah":2,"words":[{"position":1,"arabic":"يَهْدِىٓ","translation":"It guides","transliteration":"yahdī"},{"position":2,"arabic":"إِلَى","translation":"to","transliteration":"ilā"},{"position":3,"arabic":"ٱلرُّشْدِ","translation":"the right way","transliteration":"l-rush'di"},{"position":4,"arabic":"فَـَٔامَنَّا","translation":"so we believe","transliteration":"faāmannā"},{"position":5,"arabic":"بِهِۦ ۖ","translation":"in it","transliteration":"bihi"},{"position":6,"arabic":"وَلَن","translation":"and never","transliteration":"walan"},{"position":7,"arabic":"نُّشْرِكَ","translation":"we will associate","transliteration":"nush'rika"},{"position":8,"arabic":"بِرَبِّنَآ","translation":"with our Lord","transliteration":"birabbinā"},{"position":9,"arabic":"أَحَدًۭا","translation":"anyone","transliteration":"aḥadan"}],"e3rab":"(يَهْدِي) مضارع فاعله مستتر (إِلَى الرُّشْدِ) متعلقان بالفعل والجملة صفة ثانية لقرآنا (فَآمَنَّا) ماض وفاعله (بِهِ) متعلقان بالفعل والجملة معطوفة على ما قبلها (وَلَنْ نُشْرِكَ) مضارع منصوب بلن فاعله مستتر (بِرَبِّنا) متعلقان بالفعل (أَحَداً) مفعول به والجملة معطوفة على ما قبلها أيضا.\r\n\r\n"},{"sura":72,"ayah":3,"words":[{"position":1,"arabic":"وَأَنَّهُۥ","translation":"And that He ","transliteration":"wa-annahu"},{"position":2,"arabic":"تَعَـٰلَىٰ","translation":"Exalted is","transliteration":"taʿālā"},{"position":3,"arabic":"جَدُّ","translation":"(the) Majesty","transliteration":"jaddu"},{"position":4,"arabic":"رَبِّنَا","translation":"(of) our Lord ","transliteration":"rabbinā"},{"position":5,"arabic":"مَا","translation":"not","transliteration":"mā"},{"position":6,"arabic":"ٱتَّخَذَ","translation":"He has taken","transliteration":"ittakhadha"},{"position":7,"arabic":"صَـٰحِبَةًۭ","translation":"a wife","transliteration":"ṣāḥibatan"},{"position":8,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":9,"arabic":"وَلَدًۭا","translation":"a son","transliteration":"waladan"}],"e3rab":"(وَأَنَّهُ) الواو حرف عطف وأن واسمها (تَعالى جَدُّ) ماض وفاعله، أي تنزه عما نسب إليه.\r\n\r\n(رَبِّنا) مضاف إليه والجملة الفعلية خبر أن والجملة الاسمية معطوفة على ما قبلها (مَا اتَّخَذَ) ما نافية وماض فاعله مستتر (صاحِبَةً) مفعول به (وَلا وَلَداً) معطوف على صاحبة والجملة حال.\r\n\r\n"},{"sura":72,"ayah":4,"words":[{"position":1,"arabic":"وَأَنَّهُۥ","translation":"And that he","transliteration":"wa-annahu"},{"position":2,"arabic":"كَانَ","translation":"used to","transliteration":"kāna"},{"position":3,"arabic":"يَقُولُ","translation":"speak ","transliteration":"yaqūlu"},{"position":4,"arabic":"سَفِيهُنَا","translation":"the foolish among us","transliteration":"safīhunā"},{"position":5,"arabic":"عَلَى","translation":"against","transliteration":"ʿalā"},{"position":6,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":7,"arabic":"شَطَطًۭا","translation":"an excessive transgression","transliteration":"shaṭaṭan"}],"e3rab":"(وَأَنَّهُ كانَ) أن واسمها وماض ناقص اسمه مستتر (يَقُولُ سَفِيهُنا) مضارع وفاعله والجملة خبر كان وجملة كان خبر أن وجملة أنه معطوفة على ما قبلها (عَلَى اللَّهِ) متعلقان بيقول (شَطَطاً) صفة مفعول مطلق محذوف.\r\n\r\n"},{"sura":72,"ayah":5,"words":[{"position":1,"arabic":"وَأَنَّا","translation":"And that we","transliteration":"wa-annā"},{"position":2,"arabic":"ظَنَنَّآ","translation":"thought","transliteration":"ẓanannā"},{"position":3,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":4,"arabic":"لَّن","translation":"never","transliteration":"lan"},{"position":5,"arabic":"تَقُولَ","translation":"will say","transliteration":"taqūla"},{"position":6,"arabic":"ٱلْإِنسُ","translation":"the men","transliteration":"l-insu"},{"position":7,"arabic":"وَٱلْجِنُّ","translation":"and the jinn","transliteration":"wal-jinu"},{"position":8,"arabic":"عَلَى","translation":"against","transliteration":"ʿalā"},{"position":9,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":10,"arabic":"كَذِبًۭا","translation":"any lie","transliteration":"kadhiban"}],"e3rab":"(وَأَنَّا ظَنَنَّا) أن واسمها وماض وفاعله والجملة خبر أن والجملة الاسمية معطوفة على ما قبلها (أَنْ لَنْ تَقُولَ) أن مخففة واسمها ضمير الشأن محذوف ومضارع منصوب بلن (الْإِنْسُ) فاعل (وَالْجِنُّ) معطوف على الإنس (عَلَى اللَّهِ) متعلقان بالفعل (كَذِباً) مفعول به وجملة لن تقول خبر أن المخففة والمصدر المؤول من أن المخففة واسمها وخبرها سدت مسد مفعولي ظننا.\r\n\r\n"},{"sura":72,"ayah":6,"words":[{"position":1,"arabic":"وَأَنَّهُۥ","translation":"And that","transliteration":"wa-annahu"},{"position":2,"arabic":"كَانَ","translation":"(there) were","transliteration":"kāna"},{"position":3,"arabic":"رِجَالٌۭ","translation":"men","transliteration":"rijālun"},{"position":4,"arabic":"مِّنَ","translation":"among","transliteration":"mina"},{"position":5,"arabic":"ٱلْإِنسِ","translation":"mankind","transliteration":"l-insi"},{"position":6,"arabic":"يَعُوذُونَ","translation":"who sought refuge","transliteration":"yaʿūdhūna"},{"position":7,"arabic":"بِرِجَالٍۢ","translation":"in (the) men","transliteration":"birijālin"},{"position":8,"arabic":"مِّنَ","translation":"from","transliteration":"mina"},{"position":9,"arabic":"ٱلْجِنِّ","translation":"the jinn","transliteration":"l-jini"},{"position":10,"arabic":"فَزَادُوهُمْ","translation":"so they increased them","transliteration":"fazādūhum"},{"position":11,"arabic":"رَهَقًۭا","translation":"(in) burden","transliteration":"rahaqan"}],"e3rab":"(وَأَنَّهُ كانَ رِجالٌ) أن واسمها وماض ناقص واسمه (مِنَ الْإِنْسِ) صفة رجال (يَعُوذُونَ) مضارع مرفوع والواو فاعله والجملة خبر كان وجملة كان خبر أنه وجملة أنه معطوفة على ما قبلها (بِرِجالٍ) متعلقان بيعوذون (مِنَ الْجِنِّ) صفة رجال (فَزادُوهُمْ) ماض وفاعله ومفعوله الأول (رَهَقاً) مفعول به ثان والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":72,"ayah":7,"words":[{"position":1,"arabic":"وَأَنَّهُمْ","translation":"And that they","transliteration":"wa-annahum"},{"position":2,"arabic":"ظَنُّوا۟","translation":"thought","transliteration":"ẓannū"},{"position":3,"arabic":"كَمَا","translation":"as","transliteration":"kamā"},{"position":4,"arabic":"ظَنَنتُمْ","translation":"you thought","transliteration":"ẓanantum"},{"position":5,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":6,"arabic":"لَّن","translation":"never","transliteration":"lan"},{"position":7,"arabic":"يَبْعَثَ","translation":"will raise","transliteration":"yabʿatha"},{"position":8,"arabic":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":9,"arabic":"أَحَدًۭا","translation":"anyone","transliteration":"aḥadan"}],"e3rab":"(وَأَنَّهُمْ ظَنُّوا) أن واسمها وماض وفاعله والجملة خبر أنهم والجملة الاسمية معطوفة على ما قبلها (كَما) صفة مفعول مطلق محذوف (ظَنَنْتُمْ) ماض وفاعله والجملة صلة الموصول (أَنْ) أن مخففة من الثقيلة واسمها ضمير الشأن محذوف (لَنْ يَبْعَثَ اللَّهُ) مضارع منصوب بلن ولفظ الجلالة فاعله (أَحَداً) مفعوله والجملة الفعلية خبر أن والمصدر من أن المخففة وما بعدها سد مسد مفعولي ظن.\r\n\r\n"},{"sura":72,"ayah":8,"words":[{"position":1,"arabic":"وَأَنَّا","translation":"And that we","transliteration":"wa-annā"},{"position":2,"arabic":"لَمَسْنَا","translation":"sought to touch","transliteration":"lamasnā"},{"position":3,"arabic":"ٱلسَّمَآءَ","translation":"the heaven","transliteration":"l-samāa"},{"position":4,"arabic":"فَوَجَدْنَـٰهَا","translation":"but we found it","transliteration":"fawajadnāhā"},{"position":5,"arabic":"مُلِئَتْ","translation":"filled (with)","transliteration":"muli-at"},{"position":6,"arabic":"حَرَسًۭا","translation":"guards","transliteration":"ḥarasan"},{"position":7,"arabic":"شَدِيدًۭا","translation":"severe","transliteration":"shadīdan"},{"position":8,"arabic":"وَشُهُبًۭا","translation":"and flaming fires","transliteration":"washuhuban"}],"e3rab":"(وَأَنَّا) أن واسمها (لَمَسْنَا السَّماءَ) ماض وفاعله ومفعوله والجملة الفعلية خبر أن والجملة الاسمية معطوفة على ما قبلها (فَوَجَدْناها) ماض وفاعله ومفعوله والجملة معطوفة على ما قبلها (مُلِئَتْ) ماض مبني للمجهول ونائب الفاعل مستتر (حَرَساً) تمييز (شَدِيداً) صفة حرسا (وَشُهُباً) معطوف على حرسا وجملة ملئت حال.\r\n\r\n"},{"sura":72,"ayah":9,"words":[{"position":1,"arabic":"وَأَنَّا","translation":"And that we","transliteration":"wa-annā"},{"position":2,"arabic":"كُنَّا","translation":"used to","transliteration":"kunnā"},{"position":3,"arabic":"نَقْعُدُ","translation":"sit","transliteration":"naqʿudu"},{"position":4,"arabic":"مِنْهَا","translation":"there in","transliteration":"min'hā"},{"position":5,"arabic":"مَقَـٰعِدَ","translation":"positions","transliteration":"maqāʿida"},{"position":6,"arabic":"لِلسَّمْعِ ۖ","translation":"for hearing","transliteration":"lilssamʿi"},{"position":7,"arabic":"فَمَن","translation":"but (he) who","transliteration":"faman"},{"position":8,"arabic":"يَسْتَمِعِ","translation":"listens","transliteration":"yastamiʿi"},{"position":9,"arabic":"ٱلْـَٔانَ","translation":"now","transliteration":"l-āna"},{"position":10,"arabic":"يَجِدْ","translation":"will find","transliteration":"yajid"},{"position":11,"arabic":"لَهُۥ","translation":"for him","transliteration":"lahu"},{"position":12,"arabic":"شِهَابًۭا","translation":"a flaming fire","transliteration":"shihāban"},{"position":13,"arabic":"رَّصَدًۭا","translation":"waiting","transliteration":"raṣadan"}],"e3rab":"(وَأَنَّا كُنَّا) أن واسمها وكان واسمها (نَقْعُدُ) مضارع فاعله مستتر والجملة خبر كنا وجملة كنا خبر أنا وجملة أنا معطوفة على ما قبلها (مِنْها) متعلقان بالفعل (مَقاعِدَ) ظرف مكان (لِلسَّمْعِ) متعلقان بالفعل نقعد (فَمَنْ يَسْتَمِعِ) من اسم شرط جازم مبتدأ ومضارع مجزوم لأنه فعل الشرط (الْآنَ) ظرف زمان (يَجِدْ) مضارع مجزوم لأنه جواب الشرط (لَهُ) جار ومجرور في محل نصب مفعول به ثان (شِهاباً) مفعول به أول (رَصَداً) صفة شهابا وجملة يجد جواب الشرط لا محل لها وجملتا الشرط والجواب خبر من وجملة من مستأنفة لا محل لها.\r\n\r\n"},{"sura":72,"ayah":10,"words":[{"position":1,"arabic":"وَأَنَّا","translation":"And that we ","transliteration":"wa-annā"},{"position":2,"arabic":"لَا","translation":"not","transliteration":"lā"},{"position":3,"arabic":"نَدْرِىٓ","translation":"we know","transliteration":"nadrī"},{"position":4,"arabic":"أَشَرٌّ","translation":"whether evil","transliteration":"asharrun"},{"position":5,"arabic":"أُرِيدَ","translation":"is intended","transliteration":"urīda"},{"position":6,"arabic":"بِمَن","translation":"for (those) who","transliteration":"biman"},{"position":7,"arabic":"فِى","translation":"(are) in","transliteration":"fī"},{"position":8,"arabic":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":9,"arabic":"أَمْ","translation":"or","transliteration":"am"},{"position":10,"arabic":"أَرَادَ","translation":"intends","transliteration":"arāda"},{"position":11,"arabic":"بِهِمْ","translation":"for them","transliteration":"bihim"},{"position":12,"arabic":"رَبُّهُمْ","translation":"their Lord","transliteration":"rabbuhum"},{"position":13,"arabic":"رَشَدًۭا","translation":"a right path","transliteration":"rashadan"}],"e3rab":"(وَأَنَّا) أن واسمها (لا نَدْرِي) لا نافية ومضارع فاعله مستتر والجملة خبر أنا وجملة أنا معطوفة على ما قبلها (أَشَرٌّ) الهمزة للاستفهام (شَرٌّ) نائب فاعل لفعل محذوف (أُرِيدَ) ماض مبني للمجهول ونائب الفاعل مستتر (بِمَنْ) متعلقان بالفعل (فِي الْأَرْضِ) متعلقان بمحذوف صلة الموصول وجملة أريد مفسرة لا محل لها وجملة أشر سدت مسد مفعولي ندري (أَمْ أَرادَ) حرف عطف وماض (بِهِمْ) متعلقان بالفعل (رَبُّهُمْ) فاعل (رَشَداً) مفعول به والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":72,"ayah":11,"words":[{"position":1,"arabic":"وَأَنَّا","translation":"And that [we]","transliteration":"wa-annā"},{"position":2,"arabic":"مِنَّا","translation":"among us","transliteration":"minnā"},{"position":3,"arabic":"ٱلصَّـٰلِحُونَ","translation":"(are) the righteous","transliteration":"l-ṣāliḥūna"},{"position":4,"arabic":"وَمِنَّا","translation":"and among us","transliteration":"waminnā"},{"position":5,"arabic":"دُونَ","translation":"(are) other than","transliteration":"dūna"},{"position":6,"arabic":"ذَٰلِكَ ۖ","translation":"that","transliteration":"dhālika"},{"position":7,"arabic":"كُنَّا","translation":"We","transliteration":"kunnā"},{"position":8,"arabic":"طَرَآئِقَ","translation":"(are on) ways","transliteration":"ṭarāiqa"},{"position":9,"arabic":"قِدَدًۭا","translation":"different","transliteration":"qidadan"}],"e3rab":"(وَأَنَّا) أن واسمها (مِنَّا) خبر مقدم (الصَّالِحُونَ) مبتدأ مؤخر والجملة الاسمية خبر أنا وجملة أنا معطوفة على ما قبلها (وَمِنَّا) خبر مقدم (دُونَ) ظرف متعلق بمبتدأ مؤخر حسب ابن هشام في الشذور (ذلِكَ) مضاف إليه والجملة الاسمية معطوفة على ما قبلها (كُنَّا) كان واسمها (طَرائِقَ) خبرها (قِدَداً) صفة طرائق والجملة حال.\r\n\r\n"},{"sura":72,"ayah":12,"words":[{"position":1,"arabic":"وَأَنَّا","translation":"And that we","transliteration":"wa-annā"},{"position":2,"arabic":"ظَنَنَّآ","translation":"[we] have become certain","transliteration":"ẓanannā"},{"position":3,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":4,"arabic":"لَّن","translation":"never","transliteration":"lan"},{"position":5,"arabic":"نُّعْجِزَ","translation":"we will cause failure","transliteration":"nuʿ'jiza"},{"position":6,"arabic":"ٱللَّهَ","translation":"(to) Allah","transliteration":"l-laha"},{"position":7,"arabic":"فِى","translation":"in","transliteration":"fī"},{"position":8,"arabic":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":9,"arabic":"وَلَن","translation":"and never","transliteration":"walan"},{"position":10,"arabic":"نُّعْجِزَهُۥ","translation":"we can escape Him","transliteration":"nuʿ'jizahu"},{"position":11,"arabic":"هَرَبًۭا","translation":"(by) flight","transliteration":"haraban"}],"e3rab":"(وَأَنَّا ظَنَنَّا) أن واسمها وماض وفاعله والجملة الفعلية خبر أنا وجملة أنا معطوفة على ما قبلها (أَنْ) أن مخففة من الثقيلة واسمها ضمير الشأن محذوف (لَنْ نُعْجِزَ اللَّهَ) مضارع منصوب بلن والفاعل مستتر ولفظ الجلالة مفعوله والجملة خبر أن المخففة (فِي الْأَرْضِ) متعلقان بمحذوف حال والمصدر المؤول من أن المخففة وما بعدها سد مسد مفعولي ظننا (وَلَنْ نُعْجِزَهُ) معطوف على ما قبله (هَرَباً) حال.\r\n\r\n"},{"sura":72,"ayah":13,"words":[{"position":1,"arabic":"وَأَنَّا","translation":"And that [we]","transliteration":"wa-annā"},{"position":2,"arabic":"لَمَّا","translation":"when","transliteration":"lammā"},{"position":3,"arabic":"سَمِعْنَا","translation":"we heard","transliteration":"samiʿ'nā"},{"position":4,"arabic":"ٱلْهُدَىٰٓ","translation":"the Guidance","transliteration":"l-hudā"},{"position":5,"arabic":"ءَامَنَّا","translation":"we believed","transliteration":"āmannā"},{"position":6,"arabic":"بِهِۦ ۖ","translation":"in it","transliteration":"bihi"},{"position":7,"arabic":"فَمَن","translation":"And whoever","transliteration":"faman"},{"position":8,"arabic":"يُؤْمِنۢ","translation":"believes","transliteration":"yu'min"},{"position":9,"arabic":"بِرَبِّهِۦ","translation":"in his Lord","transliteration":"birabbihi"},{"position":10,"arabic":"فَلَا","translation":"then not","transliteration":"falā"},{"position":11,"arabic":"يَخَافُ","translation":"he will fear","transliteration":"yakhāfu"},{"position":12,"arabic":"بَخْسًۭا","translation":"any loss","transliteration":"bakhsan"},{"position":13,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":14,"arabic":"رَهَقًۭا","translation":"any burden","transliteration":"rahaqan"}],"e3rab":"(وَأَنَّا) أن واسمها (لَمَّا) ظرفية شرطية غير جازمة (سَمِعْنَا) ماض وفاعله (الْهُدى) مفعوله والجملة في محل جر بالإضافة (آمَنَّا) ماض وفاعله (بِهِ) متعلقان بالفعل والجملة جواب الشرط لا محل لها ولما ومدخولها خبر أنا وجملة أنا معطوفة على ما قبلها (فَمَنْ) الفاء حرف استئناف (من) اسم شرط جازم مبتدأ (يُؤْمِنْ) مضارع مجزوم لأنه فعل الشرط فاعله مستتر (بِرَبِّهِ) متعلقان بالفعل (فَلا) الفاء رابطة (لا يَخافُ) لا نافية ومضارع فاعله مستتر والجملة في محل جزم جواب الشرط وجملتا الشرط والجواب خبر من وجملة من مستأنفة لا محل لها (بَخْساً) مفعول به (وَ) الواو حرف عطف (لا) نافية (رَهَقاً) معطوف على بخسا، ومعناها: ظلما.\r\n\r\n"},{"sura":72,"ayah":14,"words":[{"position":1,"arabic":"وَأَنَّا","translation":"And that we","transliteration":"wa-annā"},{"position":2,"arabic":"مِنَّا","translation":"among us","transliteration":"minnā"},{"position":3,"arabic":"ٱلْمُسْلِمُونَ","translation":"(are) Muslims","transliteration":"l-mus'limūna"},{"position":4,"arabic":"وَمِنَّا","translation":"and among us","transliteration":"waminnā"},{"position":5,"arabic":"ٱلْقَـٰسِطُونَ ۖ","translation":"(are) unjust","transliteration":"l-qāsiṭūna"},{"position":6,"arabic":"فَمَنْ","translation":"And whoever","transliteration":"faman"},{"position":7,"arabic":"أَسْلَمَ","translation":"submits","transliteration":"aslama"},{"position":8,"arabic":"فَأُو۟لَـٰٓئِكَ","translation":"then those","transliteration":"fa-ulāika"},{"position":9,"arabic":"تَحَرَّوْا۟","translation":"have sought","transliteration":"taḥarraw"},{"position":10,"arabic":"رَشَدًۭا","translation":"(the) right path","transliteration":"rashadan"}],"e3rab":"(وَأَنَّا) أن واسمها (مِنَّا) خبر مقدم (الْمُسْلِمُونَ) مبتدأ مؤخر والجملة الاسمية خبر أنا وجملة أنا معطوفة على ما قبلها (وَمِنَّا الْقاسِطُونَ) معطوف على مثيله، القاسطون: يعني الجائرون بكفرهم.\r\n\r\n(فَمَنْ) الفاء حرف استئناف (من) اسم شرط جازم مبتدأ (أَسْلَمَ) ماض في محل جزم فعل الشرط (فَأُولئِكَ تَحَرَّوْا) الفاء رابطة واسم إشارة مبتدأ وماض وفاعله والجملة خبر أولئك (رَشَداً) مفعول به وجملة أولئك في محل جزم جواب الشرط وجملتا الشرط والجواب خبر من وجملة من مستأنفة لا محل لها.\r\n\r\n"},{"sura":72,"ayah":15,"words":[{"position":1,"arabic":"وَأَمَّا","translation":"And as for","transliteration":"wa-ammā"},{"position":2,"arabic":"ٱلْقَـٰسِطُونَ","translation":"the unjust","transliteration":"l-qāsiṭūna"},{"position":3,"arabic":"فَكَانُوا۟","translation":"they will be","transliteration":"fakānū"},{"position":4,"arabic":"لِجَهَنَّمَ","translation":"for Hell","transliteration":"lijahannama"},{"position":5,"arabic":"حَطَبًۭا","translation":"firewood","transliteration":"ḥaṭaban"}],"e3rab":"(وَأَمَّا) الواو حرف استئناف. (أَمَّا) حرف شرط وتفصيل.\r\n\r\n(الْقاسِطُونَ) مبتدأ.\r\n\r\n(فَكانُوا) الفاء واقعة في جواب الشرط وكان واسمها.\r\n\r\n(لِجَهَنَّمَ) جار ومجرور حال.\r\n\r\n(حَطَباً) خبر كانوا وجملة كانوا خبر المبتدأ وجملة أما القاسطون مستأنفة لا محل لها.\r\n\r\n"},{"sura":72,"ayah":16,"words":[{"position":1,"arabic":"وَأَلَّوِ","translation":"And that if","transliteration":"wa-allawi"},{"position":2,"arabic":"ٱسْتَقَـٰمُوا۟","translation":"they had remained","transliteration":"is'taqāmū"},{"position":3,"arabic":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":4,"arabic":"ٱلطَّرِيقَةِ","translation":"the Way","transliteration":"l-ṭarīqati"},{"position":5,"arabic":"لَأَسْقَيْنَـٰهُم","translation":"surely We (would) have given them to drink","transliteration":"la-asqaynāhum"},{"position":6,"arabic":"مَّآءً","translation":"water","transliteration":"māan"},{"position":7,"arabic":"غَدَقًۭا","translation":"(in) abundance","transliteration":"ghadaqan"}],"e3rab":"(وَأَنْ لَوِ) أن مخففة من الثقيلة واسمها ضمير الشأن محذوف (لَوِ) شرطية غير جازمة (اسْتَقامُوا) ماض وفاعله (عَلَى الطَّرِيقَةِ) متعلقان بالفعل والجملة ابتدائية لا محل لها (لَأَسْقَيْناهُمْ) اللام واقعة في جواب الشرط وماض وفاعله ومفعوله الأول (ماءً) مفعول به ثان (غَدَقاً) صفة ماء، ومعناها: كثيرا.\r\n\r\nوالجملة جواب الشرط لا محل لها والشرط وجوابه خبر أن وجملة أن معطوفة على ما قبلها.\r\n\r\n"},{"sura":72,"ayah":17,"words":[{"position":1,"arabic":"لِّنَفْتِنَهُمْ","translation":"That We might test them","transliteration":"linaftinahum"},{"position":2,"arabic":"فِيهِ ۚ","translation":"therein","transliteration":"fīhi"},{"position":3,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":4,"arabic":"يُعْرِضْ","translation":"turns away","transliteration":"yuʿ'riḍ"},{"position":5,"arabic":"عَن","translation":"from","transliteration":"ʿan"},{"position":6,"arabic":"ذِكْرِ","translation":"the Remembrance","transliteration":"dhik'ri"},{"position":7,"arabic":"رَبِّهِۦ","translation":"(of) his Lord","transliteration":"rabbihi"},{"position":8,"arabic":"يَسْلُكْهُ","translation":"He will make him enter","transliteration":"yasluk'hu"},{"position":9,"arabic":"عَذَابًۭا","translation":"a punishment","transliteration":"ʿadhāban"},{"position":10,"arabic":"صَعَدًۭا","translation":"severe","transliteration":"ṣaʿadan"}],"e3rab":"(لِنَفْتِنَهُمْ) مضارع منصوب بأن مضمرة بعد لام التعليل والفاعل مستتر والهاء مفعول به والمصدر المؤول من أن المضمرة والفعل في محل جر باللام والجار والمجرور متعلقان بالفعل أسقيناهم (فِيهِ) متعلقان بالفعل (وَ) الواو حرف استئناف (مَنْ) اسم شرط جازم مبتدأ (يُعْرِضْ) مضارع مجزوم (عَنْ ذِكْرِ) متعلقان بيعرض (رَبِّهِ) مضاف إليه (يَسْلُكْهُ) مضارع مجزوم لأنه جواب الشرط والفاعل مستتر والهاء مفعول به أول (عَذاباً) مفعول به ثان (صَعَداً) صفة عذابا والجملة جواب الشرط لا محل لها وجملتا الشرط والجواب خبر من وجملة من.. استئنافية لا محل لها،.\r\n\r\n"},{"sura":72,"ayah":18,"words":[{"position":1,"arabic":"وَأَنَّ","translation":"And that","transliteration":"wa-anna"},{"position":2,"arabic":"ٱلْمَسَـٰجِدَ","translation":"the masjids","transliteration":"l-masājida"},{"position":3,"arabic":"لِلَّهِ","translation":"(are) for Allah","transliteration":"lillahi"},{"position":4,"arabic":"فَلَا","translation":"so (do) not","transliteration":"falā"},{"position":5,"arabic":"تَدْعُوا۟","translation":"call","transliteration":"tadʿū"},{"position":6,"arabic":"مَعَ","translation":"with","transliteration":"maʿa"},{"position":7,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":8,"arabic":"أَحَدًۭا","translation":"anyone","transliteration":"aḥadan"}],"e3rab":"(وَأَنَّ الْمَساجِدَ) أن واسمها و(لِلَّهِ) متعلقان بمحذوف خبر أن والجملة معطوفة على ما قبلها (فَلا) الفاء حرف استئناف ومضارع مجزوم بلا الناهية وعلامة جزمه حذف النون والواو فاعل و(مَعَ اللَّهِ) ظرف مكان مضاف إلى لفظ الجلالة و(أَحَداً) مفعول به والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":72,"ayah":19,"words":[{"position":1,"arabic":"وَأَنَّهُۥ","translation":"And that","transliteration":"wa-annahu"},{"position":2,"arabic":"لَمَّا","translation":"when","transliteration":"lammā"},{"position":3,"arabic":"قَامَ","translation":"stood up","transliteration":"qāma"},{"position":4,"arabic":"عَبْدُ","translation":"(the) slave","transliteration":"ʿabdu"},{"position":5,"arabic":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":6,"arabic":"يَدْعُوهُ","translation":"calling (upon) Him","transliteration":"yadʿūhu"},{"position":7,"arabic":"كَادُوا۟","translation":"they almost","transliteration":"kādū"},{"position":8,"arabic":"يَكُونُونَ","translation":"became","transliteration":"yakūnūna"},{"position":9,"arabic":"عَلَيْهِ","translation":"around him","transliteration":"ʿalayhi"},{"position":10,"arabic":"لِبَدًۭا","translation":"a compacted mass","transliteration":"libadan"}],"e3rab":"(وَأَنَّهُ) أن واسمها (لَمَّا قامَ عَبْدُ اللَّهِ) لما ظرفية شرطية غير جازمة وماض وفاعله ولفظ الجلالة مضاف إليه والجملة في محل جر بالإضافة (يَدْعُوهُ) مضارع وفاعله ومفعوله والجملة حال (كادُوا) كاد واسمها (يَكُونُونَ) مضارع ناقص مرفوع والواو اسمه (عَلَيْهِ) متعلقان بالخبر (لِبَداً) خبر وجملة يكونون خبر كاد وجملة كادوا جواب الشرط لا محل لها ولما ومدخولها خبر أنه وجملة أنه.. معطوفة على ما قبلها.\r\n\r\n"},{"sura":72,"ayah":20,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"إِنَّمَآ","translation":"Only","transliteration":"innamā"},{"position":3,"arabic":"أَدْعُوا۟","translation":"I call upon","transliteration":"adʿū"},{"position":4,"arabic":"رَبِّى","translation":"my Lord","transliteration":"rabbī"},{"position":5,"arabic":"وَلَآ","translation":"and not","transliteration":"walā"},{"position":6,"arabic":"أُشْرِكُ","translation":"I associate","transliteration":"ush'riku"},{"position":7,"arabic":"بِهِۦٓ","translation":"with Him","transliteration":"bihi"},{"position":8,"arabic":"أَحَدًۭا","translation":"anyone","transliteration":"aḥadan"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة مستأنفة لا محل لها (إِنَّما) كافة ومكفوفة (أَدْعُوا) مضارع فاعله مستتر (رَبِّي) مفعول به والجملة مقول القول (وَ) الواو حرف عطف (لا أُشْرِكُ) نافية ومضارع فاعله مستتر و(بِهِ) متعلقان بالفعل (أَحَداً) مفعول به والجملة معطوفة على أدعو.\r\n\r\n"},{"sura":72,"ayah":21,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"إِنِّى","translation":"Indeed, I","transliteration":"innī"},{"position":3,"arabic":"لَآ","translation":"(do) not","transliteration":"lā"},{"position":4,"arabic":"أَمْلِكُ","translation":"possess","transliteration":"amliku"},{"position":5,"arabic":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":6,"arabic":"ضَرًّۭا","translation":"any harm","transliteration":"ḍarran"},{"position":7,"arabic":"وَلَا","translation":"and not","transliteration":"walā"},{"position":8,"arabic":"رَشَدًۭا","translation":"right path","transliteration":"rashadan"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة مستأنفة لا محل لها (إِنِّي) إن واسمها و(لا) نافية (أَمْلِكُ) مضارع فاعله مستتر (لَكُمْ) متعلقان بالفعل (ضَرًّا) مفعول به (وَ) الواو حرف عطف (لا) نافية (رَشَداً) معطوف على ضرا وجملة لا أملك.. خبر إن والجملة الاسمية مقول القول.\r\n\r\n"},{"sura":72,"ayah":22,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"إِنِّى","translation":"Indeed I","transliteration":"innī"},{"position":3,"arabic":"لَن","translation":"never","transliteration":"lan"},{"position":4,"arabic":"يُجِيرَنِى","translation":"can protect me","transliteration":"yujīranī"},{"position":5,"arabic":"مِنَ","translation":"from","transliteration":"mina"},{"position":6,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":7,"arabic":"أَحَدٌۭ","translation":"anyone","transliteration":"aḥadun"},{"position":8,"arabic":"وَلَنْ","translation":"and never","transliteration":"walan"},{"position":9,"arabic":"أَجِدَ","translation":"can I find","transliteration":"ajida"},{"position":10,"arabic":"مِن","translation":"from","transliteration":"min"},{"position":11,"arabic":"دُونِهِۦ","translation":"besides Him","transliteration":"dūnihi"},{"position":12,"arabic":"مُلْتَحَدًا","translation":"any refuge","transliteration":"mul'taḥadan"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة مستأنفة لا محل لها (إِنِّي) إن واسمها (لَنْ يُجِيرَنِي) مضارع منصوب بلن والنون للوقاية وياء المتكلم مفعول به (مِنَ اللَّهِ) متعلقان بالفعل (أَحَدٌ) فاعل والجملة الفعلية خبر إن والجملة الاسمية مقول القول (وَلَنْ أَجِدَ) الواو حرف عطف ومضارع منصوب بلن والفاعل مستتر (مِنْ دُونِهِ) متعلقان بالفعل (مُلْتَحَداً) مفعول به والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":72,"ayah":23,"words":[{"position":1,"arabic":"إِلَّا","translation":"But","transliteration":"illā"},{"position":2,"arabic":"بَلَـٰغًۭا","translation":"(the) notification","transliteration":"balāghan"},{"position":3,"arabic":"مِّنَ","translation":"from","transliteration":"mina"},{"position":4,"arabic":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":5,"arabic":"وَرِسَـٰلَـٰتِهِۦ ۚ","translation":"and His Messages","transliteration":"warisālātihi"},{"position":6,"arabic":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":7,"arabic":"يَعْصِ","translation":"disobeys","transliteration":"yaʿṣi"},{"position":8,"arabic":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":9,"arabic":"وَرَسُولَهُۥ","translation":"and His Messenger","transliteration":"warasūlahu"},{"position":10,"arabic":"فَإِنَّ","translation":"then indeed","transliteration":"fa-inna"},{"position":11,"arabic":"لَهُۥ","translation":"for him","transliteration":"lahu"},{"position":12,"arabic":"نَارَ","translation":"(is the) Fire","transliteration":"nāra"},{"position":13,"arabic":"جَهَنَّمَ","translation":"(of) Hell","transliteration":"jahannama"},{"position":14,"arabic":"خَـٰلِدِينَ","translation":"(they will) abide","transliteration":"khālidīna"},{"position":15,"arabic":"فِيهَآ","translation":"therein","transliteration":"fīhā"},{"position":16,"arabic":"أَبَدًا","translation":"forever","transliteration":"abadan"}],"e3rab":"(إِلَّا) أداة استثناء (بَلاغاً) مستثنى منصوب (مِنَ اللَّهِ) متعلقان ببلاغا (وَرِسالاتِهِ) معطوفة على بلاغا (وَ) الواو حرف استئناف (مِنَ) اسم شرط جازم مبتدأ (يَعْصِ اللَّهَ) مضارع مجزوم لأنه فعل الشرط فاعله مستتر ولفظ الجلالة مفعول به (وَرَسُولَهُ) معطوف على لفظ الجلالة (فَإِنَّ) الفاء واقعة في جواب الشرط وحرف مشبه بالفعل (لَهُ) متعلقان بمحذوف خبر إن المقدم (نارَ) اسم إن المؤخر (جَهَنَّمَ) مضاف إليه (خالِدِينَ) حال (فِيها) متعلقان بخالدين (أَبَداً) ظرف زمان والجملة الاسمية في محل جزم جواب الشرط وجملتا الشرط والجواب خبر من وجملة من.. مستأنفة لا محل لها.\r\n\r\n"},{"sura":72,"ayah":24,"words":[{"position":1,"arabic":"حَتَّىٰٓ","translation":"Until","transliteration":"ḥattā"},{"position":2,"arabic":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"arabic":"رَأَوْا۟","translation":"they see","transliteration":"ra-aw"},{"position":4,"arabic":"مَا","translation":"what","transliteration":"mā"},{"position":5,"arabic":"يُوعَدُونَ","translation":"they are promised","transliteration":"yūʿadūna"},{"position":6,"arabic":"فَسَيَعْلَمُونَ","translation":"then they will know","transliteration":"fasayaʿlamūna"},{"position":7,"arabic":"مَنْ","translation":"who","transliteration":"man"},{"position":8,"arabic":"أَضْعَفُ","translation":"(is) weaker","transliteration":"aḍʿafu"},{"position":9,"arabic":"نَاصِرًۭا","translation":"(in) helpers","transliteration":"nāṣiran"},{"position":10,"arabic":"وَأَقَلُّ","translation":"and fewer","transliteration":"wa-aqallu"},{"position":11,"arabic":"عَدَدًۭا","translation":"(in) number","transliteration":"ʿadadan"}],"e3rab":"(حَتَّى) حرف ابتداء و(إِذا) ظرفية شرطية غير جازمة (رَأَوْا) ماض وفاعله والجملة في محل جر بالإضافة و(ما) مفعول به (يُوعَدُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة صلة ما (فَسَيَعْلَمُونَ) الفاء رابطة والسين للاستقبال ومضارع وفاعله و(مَنْ) اسم استفهام مبتدأ و(أَضْعَفُ) خبر والجملة الاسمية في محل نصب مفعول به وجملة سيعلمون.. جواب شرط لا محل لها (ناصِراً) تمييز (وَأَقَلُّ) معطوف على أضعف (عَدَداً) تمييز.\r\n\r\n"},{"sura":72,"ayah":25,"words":[{"position":1,"arabic":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"arabic":"إِنْ","translation":"Not","transliteration":"in"},{"position":3,"arabic":"أَدْرِىٓ","translation":"I know","transliteration":"adrī"},{"position":4,"arabic":"أَقَرِيبٌۭ","translation":"whether is near","transliteration":"aqarībun"},{"position":5,"arabic":"مَّا","translation":"what","transliteration":"mā"},{"position":6,"arabic":"تُوعَدُونَ","translation":"you are promised","transliteration":"tūʿadūna"},{"position":7,"arabic":"أَمْ","translation":"or (whether)","transliteration":"am"},{"position":8,"arabic":"يَجْعَلُ","translation":"will appoint","transliteration":"yajʿalu"},{"position":9,"arabic":"لَهُۥ","translation":"for it","transliteration":"lahu"},{"position":10,"arabic":"رَبِّىٓ","translation":"my Lord","transliteration":"rabbī"},{"position":11,"arabic":"أَمَدًا","translation":"a (distant) term","transliteration":"amadan"}],"e3rab":"(قُلْ) أمر فاعله مستتر والجملة مستأنفة لا محل لها (إِنْ) نافية (أَدْرِي) مضارع فاعله مستتر (أَقَرِيبٌ) الهمزة الاستفهام و(قَرِيبٌ) خبر مقدم و(ما) اسم موصول مبتدأ مؤخر والجملة الاسمية سدت مسد مفعولي أدري وجملة إن أدري.. مقول القول و(تُوعَدُونَ) مضارع مبني للمجهول والواو نائب فاعل والجملة صلة و(أَمْ) حرف عطف (يَجْعَلُ) مضارع مرفوع و(لَهُ) متعلقان بالفعل و(رَبِّي) فاعل و(أَمَداً) مفعول به والجملة معطوفة على ما قبلها.\r\n\r\n"},{"sura":72,"ayah":26,"words":[{"position":1,"arabic":"عَـٰلِمُ","translation":"(The) All-Knower","transliteration":"ʿālimu"},{"position":2,"arabic":"ٱلْغَيْبِ","translation":"(of) the unseen","transliteration":"l-ghaybi"},{"position":3,"arabic":"فَلَا","translation":"so not","transliteration":"falā"},{"position":4,"arabic":"يُظْهِرُ","translation":"He reveals","transliteration":"yuẓ'hiru"},{"position":5,"arabic":"عَلَىٰ","translation":"from","transliteration":"ʿalā"},{"position":6,"arabic":"غَيْبِهِۦٓ","translation":"His unseen","transliteration":"ghaybihi"},{"position":7,"arabic":"أَحَدًا","translation":"(to) anyone","transliteration":"aḥadan"}],"e3rab":"(عالِمُ) خبر لمبتدأ محذوف والجملة الاسمية هو عالم مستأنفة لا محل لها و(الْغَيْبِ) مضاف إليه (فَلا) الفاء حرف استئناف (لا) نافية (يُظْهِرُ) مضارع فاعله مستتر و(عَلى غَيْبِهِ) متعلقان بالفعل و(أَحَداً) مفعول به والجملة مستأنفة لا محل لها.\r\n\r\n"},{"sura":72,"ayah":27,"words":[{"position":1,"arabic":"إِلَّا","translation":"Except","transliteration":"illā"},{"position":2,"arabic":"مَنِ","translation":"whom","transliteration":"mani"},{"position":3,"arabic":"ٱرْتَضَىٰ","translation":"He has approved","transliteration":"ir'taḍā"},{"position":4,"arabic":"مِن","translation":"of","transliteration":"min"},{"position":5,"arabic":"رَّسُولٍۢ","translation":"a Messenger","transliteration":"rasūlin"},{"position":6,"arabic":"فَإِنَّهُۥ","translation":"and indeed, He","transliteration":"fa-innahu"},{"position":7,"arabic":"يَسْلُكُ","translation":"makes to march","transliteration":"yasluku"},{"position":8,"arabic":"مِنۢ","translation":"from","transliteration":"min"},{"position":9,"arabic":"بَيْنِ","translation":"before","transliteration":"bayni"},{"position":10,"arabic":"يَدَيْهِ","translation":"him","transliteration":"yadayhi"},{"position":11,"arabic":"وَمِنْ","translation":"and from","transliteration":"wamin"},{"position":12,"arabic":"خَلْفِهِۦ","translation":"behind him","transliteration":"khalfihi"},{"position":13,"arabic":"رَصَدًۭا","translation":"a guard","transliteration":"raṣadan"}],"e3rab":"(إِلَّا) حرف حصر و(مَنِ) مبتدأ (ارْتَضى) ماض فاعله مستتر و(مِنْ رَسُولٍ) متعلقان بمحذوف حال (فَإِنَّهُ) الفاء رابطة وإن واسمها (يَسْلُكُ) مضارع فاعله مستتر والجملة خبر إن والجملة الاسمية في محل جزم جواب الشرط و(مِنْ بَيْنِ) متعلقان بالفعل و(يَدَيْهِ) مضاف إليه (وَمِنْ خَلْفِهِ) معطوفان على ما قبلهما (رَصَداً) مفعول به وجملتا الشرط والجواب خبر من.\r\n\r\n"},{"sura":72,"ayah":28,"words":[{"position":1,"arabic":"لِّيَعْلَمَ","translation":"That He may make evident","transliteration":"liyaʿlama"},{"position":2,"arabic":"أَن","translation":"that","transliteration":"an"},{"position":3,"arabic":"قَدْ","translation":"indeed","transliteration":"qad"},{"position":4,"arabic":"أَبْلَغُوا۟","translation":"they have conveyed","transliteration":"ablaghū"},{"position":5,"arabic":"رِسَـٰلَـٰتِ","translation":"(the) Messages","transliteration":"risālāti"},{"position":6,"arabic":"رَبِّهِمْ","translation":"(of) their Lord","transliteration":"rabbihim"},{"position":7,"arabic":"وَأَحَاطَ","translation":"and He has encompassed","transliteration":"wa-aḥāṭa"},{"position":8,"arabic":"بِمَا","translation":"what","transliteration":"bimā"},{"position":9,"arabic":"لَدَيْهِمْ","translation":"(is) with them","transliteration":"ladayhim"},{"position":10,"arabic":"وَأَحْصَىٰ","translation":"and He takes account","transliteration":"wa-aḥṣā"},{"position":11,"arabic":"كُلَّ","translation":"(of) all","transliteration":"kulla"},{"position":12,"arabic":"شَىْءٍ","translation":"things","transliteration":"shayin"},{"position":13,"arabic":"عَدَدًۢا","translation":"(in) number","transliteration":"ʿadadan"}],"e3rab":"(لِيَعْلَمَ) مضارع منصوب بأن مضمرة بعد لام التعليل والفاعل مستتر والمصدر المؤول من أن والفعل في محل جر باللام والجار والمجرور متعلقان بالفعل يسلك و(أَنْ) مخففة من الثقيلة واسمها ضمير الشأن محذوف و(قَدْ) حرف تحقيق (أَبْلَغُوا رِسالاتِ) ماض وفاعله ومفعوله و(رَبِّهِمْ) مضاف إليه والجملة خبر أن المخففة والمصدر المؤول من أن المخففة وما بعدها سد مسد مفعولي يعلم (وَأَحاطَ) الواو حالية وماض فاعله مستتر (بِما) متعلقان بالفعل و(لَدَيْهِمْ) ظرف مكان والجملة حال (وَأَحْصى) معطوف على أحاط و(كُلَّ) مفعول به مضاف إلى (شَيْءٍ) مضاف إليه (عَدَداً) تمييز.\r\n\r\n"}]